diff --git a/src/ops/glm5_mlp/glm5_mlp.cu b/src/ops/glm5_mlp/glm5_mlp.cu
new file mode 100644
index 0000000000000000000000000000000000000000..e35f89931e683d39a1e5f4751ff9a554baa33c28
--- /dev/null
+++ b/src/ops/glm5_mlp/glm5_mlp.cu
@@ -0,0 +1,117 @@
+// ninfer::ops - GLM-5.3-Flash MLP launchers.
+#include "ninfer/ops/glm5_mlp.h"
+
+#include "ops/kernel/glm5_mlp.cuh"
+#include "core/device.h"
+
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::ops {
+
+namespace {
+
+void require_contiguous(const Tensor& tensor, const char* what) {
+    if (!tensor.is_contiguous()) { throw std::invalid_argument(std::string(what) + " must be contiguous"); }
+}
+
+void require_shape(const Tensor& tensor, DType dtype, std::initializer_list<std::int32_t> shape,
+                   const char* what) {
+    require_contiguous(tensor, what);
+    if (tensor.dtype != dtype) {
+        throw std::invalid_argument(std::string(what) + " has the wrong dtype");
+    }
+    int index = 0;
+    for (const auto extent : shape) {
+        if (tensor.ne[index] != extent) {
+            throw std::invalid_argument(std::string(what) + " has the wrong shape");
+        }
+        ++index;
+    }
+}
+
+void require_disjoint(const Tensor& a, const Tensor& b) {
+    const auto a_begin = reinterpret_cast<std::uintptr_t>(a.data);
+    const auto b_begin = reinterpret_cast<std::uintptr_t>(b.data);
+    const auto a_end = a_begin + a.bytes();
+    const auto b_end = b_begin + b.bytes();
+    if (a_begin < b_end && b_begin < a_end) {
+        throw std::invalid_argument("glm5_mlp operands must not overlap");
+    }
+}
+
+} // namespace
+
+void glm5_swiglu(const Tensor& gate, const Tensor& up, float limit, Tensor& out,
+                 cudaStream_t stream) {
+    const std::int32_t width = gate.ne[0];
+    const std::int32_t tokens = gate.ne[1];
+    if (width <= 0 || tokens <= 0) {
+        throw std::invalid_argument("glm5_swiglu: gate must be [W, T]");
+    }
+    require_shape(gate, DType::BF16, {width, tokens}, "glm5_swiglu: gate");
+    require_shape(up, DType::BF16, {width, tokens}, "glm5_swiglu: up");
+    require_shape(out, DType::BF16, {width, tokens}, "glm5_swiglu: out");
+    if (!(limit > 0.0f)) { throw std::invalid_argument("glm5_swiglu: limit must be positive"); }
+    require_disjoint(gate, out); require_disjoint(up, out);
+
+    const std::int64_t elements = static_cast<std::int64_t>(width) * tokens;
+    const auto blocks = static_cast<unsigned int>(
+        (elements + glm5_mlp_detail::kThreads - 1) / glm5_mlp_detail::kThreads);
+    glm5_mlp_detail::swiglu_kernel<<<blocks, glm5_mlp_detail::kThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(gate.data), static_cast<const __nv_bfloat16*>(up.data),
+        limit, elements, static_cast<__nv_bfloat16*>(out.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_moe_route(const Tensor& logits, const Tensor& correction_bias, std::int32_t top_k,
+                    float routed_scaling_factor, Tensor& weights, Tensor& indices,
+                    cudaStream_t stream) {
+    const std::int32_t experts = logits.ne[0];
+    if (experts <= 0 || top_k <= 0 || top_k > experts) {
+        throw std::invalid_argument("glm5_moe_route: bad expert geometry");
+    }
+    require_shape(logits, DType::BF16, {experts}, "glm5_moe_route: logits");
+    require_shape(correction_bias, DType::FP32, {experts}, "glm5_moe_route: correction_bias");
+    require_shape(weights, DType::FP32, {top_k}, "glm5_moe_route: weights");
+    require_shape(indices, DType::I32, {top_k}, "glm5_moe_route: indices");
+    if (!(routed_scaling_factor > 0.0f)) {
+        throw std::invalid_argument("glm5_moe_route: scaling must be positive");
+    }
+    require_disjoint(logits, weights); require_disjoint(logits, indices);
+
+    const std::size_t shared = sizeof(float) * static_cast<std::size_t>(experts);
+    if (shared > 48u * 1024u) {
+        throw std::invalid_argument("glm5_moe_route: expert count exceeds static shared memory");
+    }
+    glm5_mlp_detail::route_kernel<<<1, glm5_mlp_detail::kThreads, shared, stream>>>(
+        static_cast<const __nv_bfloat16*>(logits.data),
+        static_cast<const float*>(correction_bias.data), experts, top_k, routed_scaling_factor,
+        static_cast<float*>(weights.data), static_cast<std::int32_t*>(indices.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_moe_combine(const Tensor& experts, const Tensor& weights, const Tensor& shared,
+                      Tensor& out, cudaStream_t stream) {
+    const std::int32_t top_k = experts.ne[0];
+    const std::int32_t hidden = experts.ne[1];
+    if (top_k <= 0 || hidden <= 0) {
+        throw std::invalid_argument("glm5_moe_combine: experts must be [top_k, H]");
+    }
+    require_shape(experts, DType::BF16, {top_k, hidden}, "glm5_moe_combine: experts");
+    require_shape(weights, DType::FP32, {top_k}, "glm5_moe_combine: weights");
+    require_shape(shared, DType::BF16, {hidden}, "glm5_moe_combine: shared");
+    require_shape(out, DType::BF16, {hidden}, "glm5_moe_combine: out");
+    require_disjoint(experts, out); require_disjoint(shared, out);
+
+    const auto blocks = static_cast<unsigned int>(
+        (hidden + glm5_mlp_detail::kThreads - 1) / glm5_mlp_detail::kThreads);
+    glm5_mlp_detail::combine_kernel<<<blocks, glm5_mlp_detail::kThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(experts.data),
+        static_cast<const float*>(weights.data),
+        static_cast<const __nv_bfloat16*>(shared.data), hidden, top_k, hidden,
+        static_cast<__nv_bfloat16*>(out.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops
