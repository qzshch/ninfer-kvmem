+void dsa_lifecycle() {
+    constexpr std::uint32_t D = 32, K = 4, POOLS = 6, T = POOLS * K;
+    constexpr std::uint32_t IH = 4, LORA = 128, VH = 16, CACHE = 64, H = 4;
+    constexpr std::uint32_t TOP_POOLS = 3, W = TOP_POOLS * K + (K - 1);
+    constexpr std::uint32_t POSITION = T + 2;  // one tail pool visible
+    constexpr std::uint32_t VISIBLE = (POSITION + 1) / K;
+    {
+        Device device;
+        auto stream = device.create_stream();
+
+        DsaPool pool(device, {D, T, K}, 4096);
+        DsaScore score(device, {D, IH, VISIBLE}, 4096);
+        DsaSelect select(device, {VISIBLE, K, TOP_POOLS, W}, POSITION, true, 4096);
+        DsaAttention attend(device, {H, LORA, VH, CACHE, W}, 0.0625f, 4096);
+        DsaAbsorb absorb(device, {H, D, LORA}, 4096);
+        DsaScale scale(device, LORA * H, 1.5f, 4096);
+
+        PinnedBuffer h_ik = device.allocate_host(D * T * 2);
+        PinnedBuffer h_ig = device.allocate_host(D * T * 2);
+        PinnedBuffer h_ape = device.allocate_host(D * K * 4);
+        PinnedBuffer h_pooled = device.allocate_host(D * VISIBLE * 4);
+        PinnedBuffer h_iq = device.allocate_host(D * IH * 2);
+        PinnedBuffer h_weights = device.allocate_host(IH * 4);
+        PinnedBuffer h_score = device.allocate_host(VISIBLE * 4);
+        PinnedBuffer h_cells = device.allocate_host(W * 4);
+        PinnedBuffer h_q = device.allocate_host(D * H * 2);
+        PinnedBuffer h_wk = device.allocate_host(D * LORA * H * 2);
+        PinnedBuffer h_qabs = device.allocate_host(LORA * H * 4);
+        PinnedBuffer h_qabs_b = device.allocate_host(LORA * H * 2);
+        PinnedBuffer h_lat = device.allocate_host(LORA * CACHE * 2);
+        PinnedBuffer h_wv = device.allocate_host(LORA * VH * H * 2);
+        PinnedBuffer h_out = device.allocate_host(H * VH * 2);
+        PinnedBuffer h_scaled = device.allocate_host(LORA * H * 4);
+
+        DeviceBuffer d_ik = device.allocate_device(D * T * 2);
+        DeviceBuffer d_ig = device.allocate_device(D * T * 2);
+        DeviceBuffer d_ape = device.allocate_device(D * K * 4);
+        DeviceBuffer d_pooled = device.allocate_device(D * VISIBLE * 4);
+        DeviceBuffer d_iq = device.allocate_device(D * IH * 2);
+        DeviceBuffer d_weights = device.allocate_device(IH * 4);
+        DeviceBuffer d_score = device.allocate_device(VISIBLE * 4);
+        DeviceBuffer d_cells = device.allocate_device(W * 4);
+        DeviceBuffer d_q = device.allocate_device(D * H * 2);
+        DeviceBuffer d_wk = device.allocate_device(D * LORA * H * 2);
+        DeviceBuffer d_qabs = device.allocate_device(LORA * H * 4);
+        DeviceBuffer d_qabs_b = device.allocate_device(LORA * H * 2);
+        DeviceBuffer d_lat = device.allocate_device(LORA * CACHE * 2);
+        DeviceBuffer d_wv = device.allocate_device(LORA * VH * H * 2);
+        DeviceBuffer d_out = device.allocate_device(H * VH * 2);
+        DeviceBuffer d_scaled = device.allocate_device(LORA * H * 4);
+
+        auto up1 = stream.upload(d_ik, h_ik, h_ik.size()); up1.wait();
+        auto up2 = stream.upload(d_ig, h_ig, h_ig.size()); up2.wait();
+        auto up3 = stream.upload(d_ape, h_ape, h_ape.size()); up3.wait();
+        auto up4 = stream.upload(d_iq, h_iq, h_iq.size()); up4.wait();
+        auto up5 = stream.upload(d_weights, h_weights, h_weights.size()); up5.wait();
+        auto up6 = stream.upload(d_q, h_q, h_q.size()); up6.wait();
+        auto up7 = stream.upload(d_wk, h_wk, h_wk.size()); up7.wait();
+        auto up8 = stream.upload(d_lat, h_lat, h_lat.size()); up8.wait();
+        auto up9 = stream.upload(d_wv, h_wv, h_wv.size()); up9.wait();
+        auto up10 = stream.upload(d_qabs_b, h_qabs_b, h_qabs_b.size()); up10.wait();
+
+        auto c1 = pool.launch(stream, d_ik, d_ig, d_ape, d_pooled); c1.wait();
+        auto c2 = score.launch(stream, d_iq, d_pooled, d_weights, d_score); c2.wait();
+        auto c3 = select.launch(stream, d_score, d_cells); c3.wait();
+        auto c4 = absorb.launch(stream, d_q, d_wk, d_qabs); c4.wait();
+        auto c5 = scale.launch(stream, d_qabs, d_scaled); c5.wait();
+        auto c6 = attend.launch(stream, d_qabs_b, d_lat, d_cells, d_wv, d_out); c6.wait();
+
+        auto dn1 = stream.download(h_pooled, d_pooled, h_pooled.size()); dn1.wait();
+        auto dn2 = stream.download(h_cells, d_cells, h_cells.size()); dn2.wait();
+        auto dn3 = stream.download(h_qabs, d_qabs, h_qabs.size()); dn3.wait();
+        auto dn4 = stream.download(h_out, d_out, h_out.size()); dn4.wait();
+    }
+    fake_synapse::assert_clean();
+}
+
+void dsa_invalid_shapes_rejected() {
+    {
+        Device device;
+        try {
+            DsaPool p(device, {32, 10, 4}, 4096);  // 10 % 4 != 0
+            throw std::runtime_error("DsaPool non-multiple tokens accepted");
+        } catch (const std::invalid_argument&) {}
+        try {
+            DsaPool p(device, {32, 8, 20}, 4096);  // K > 16
+            throw std::runtime_error("DsaPool oversized K accepted");
+        } catch (const std::invalid_argument&) {}
+        try {
+            DsaSelect s(device, {8, 4, 20, 100}, 8, true, 4096);  // top > visible
+            throw std::runtime_error("DsaSelect top above visible accepted");
+        } catch (const std::invalid_argument&) {}
+        try {
+            DsaAttention a(device, {4, 100, 16, 64, 16}, 0.0625f, 4096);  // lora % 128
+            throw std::runtime_error("DsaAttention non-128 lora accepted");
+        } catch (const std::invalid_argument&) {}
+    }
+    fake_synapse::assert_clean();
+}
+
+} // namespace
+
+int main() {
+    try {
+        rms_norm_lifecycle();
+        clamp_swiglu_lifecycle();
+        kda_gate_lifecycle();
+        kda_scan_lifecycle();
+        invalid_shapes_rejected();
+        mhc_lifecycle();
+        mhc_invalid_shapes_rejected();
+        moe_lifecycle();
+        moe_invalid_shapes_rejected();
+        dsa_lifecycle();
+        dsa_invalid_shapes_rejected();
+        std::puts("GLM5 TPC kernel bridges (RMSNorm, clamp SwiGLU, KDA, mHC, MoE, DSA) pass lifecycle validation");
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
