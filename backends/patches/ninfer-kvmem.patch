@@ -0,0 +1,109 @@
+#include "ops/softmax_attention/dense/causal_cache/selective_int8/launch.h"
+#if defined(NINFER_SM120_NVFP4)
+#include "ops/softmax_attention/dense/causal_cache/selective_int8/ported/ops/softmax_attention/kernels/causal/int8/grouped_mma.cuh"
+#include "ops/softmax_attention/dense/causal_cache/selective_int8/ported/ops/softmax_attention/kernels/causal/merge.cuh"
+#include "ops/softmax_attention/dense/causal_cache/selective_int8/ported/ops/softmax_attention/dense/causal_cache/int8/instances.h"
+#include "core/layout.h"
+#include "core/device.h"
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <string_view>
+
+namespace ninfer::ops::detail {
+namespace {
+bool enabled() {
+    static const bool value=[] {
+        const char* raw=std::getenv("NINFER_SELECTIVE_INT8_PREFILL");
+        if (!raw || std::string_view(raw)=="1") return true;
+        if (std::string_view(raw)=="0") return false;
+        throw std::invalid_argument("NINFER_SELECTIVE_INT8_PREFILL must be 0 or 1");
+    }();
+    return value;
+}
+bool measured_device() {
+    static std::array<std::atomic<int>,64> known{};
+    int device=-1;
+    if (cudaGetDevice(&device)!=cudaSuccess || device<0 || device>=64) return false;
+    auto& slot=known[device];
+    int result=slot.load(std::memory_order_relaxed);
+    if (!result) {
+        int major=0,minor=0,sms=0;
+        if (cudaDeviceGetAttribute(&major,cudaDevAttrComputeCapabilityMajor,device)!=cudaSuccess ||
+            cudaDeviceGetAttribute(&minor,cudaDevAttrComputeCapabilityMinor,device)!=cudaSuccess ||
+            cudaDeviceGetAttribute(&sms,cudaDevAttrMultiProcessorCount,device)!=cudaSuccess)
+            return false;
+        result=(major==12 && minor==0 && sms==170) ? 1 : -1;
+        slot.store(result,std::memory_order_relaxed);
+    }
+    return result==1;
+}
+selective_i8::CausalKvPartition partition(int width,int visible) {
+    const int independent=4*((width+7)/8);
+    selective_i8::CausalKvPartition p{1,selective_i8::causal_partition_target(340,independent),8};
+    p.capacity=p.active(visible);
+    return p;
+}
+template<bool Masked>
+void launch(const selective_i8::CausalAttentionOperands& p, selective_i8::Int8KvReadView cache,
+            selective_i8::CausalKvPartition part, selective_i8::CausalPartialView partial,
+            cudaStream_t stream) {
+    using G=selective_i8::CausalD256H24Kv4;
+    using Instance=selective_i8::Int8KvGroupedInstance<G,8>;
+    using S=typename Instance::Schedule;
+    selective_i8::validate_quantized_causal_operands<G>(p,cache);
+    constexpr auto kernel=selective_i8::int8_kv_grouped_mma_kernel<
+        G,S,false,Masked,selective_i8::CausalCachedInput,true>;
+    constexpr int bytes=S::kDynamicArena ? S::kArenaBytes : 0;
+    if constexpr (bytes>0) configure_cuda_device_once([] {
+        return cudaFuncSetAttribute(kernel,cudaFuncAttributeMaxDynamicSharedMemorySize,bytes);
+    });
+    const dim3 grid(4*((p.width+7)/8),part.capacity,1);
+    kernel<<<grid,S::kThreads,bytes,stream>>>(p.q,{},p.positions,
+        cache.keys,cache.values,cache.key_scales,cache.value_scales,cache.tables,
+        cache.valid_columns,cache.table_rows,cache.table_stride,p.width,p.visible_capacity,
+        part,p.scale,partial.acc,partial.maximum,partial.sum);
+    CUDA_CHECK(cudaGetLastError());
+    selective_i8::launch_causal_natural_merge<G,typename Instance::Merge,false,Masked,false>(
+        p,cache.valid_columns,part,partial,stream);
+}
+}
+bool selective_int8_applies(AttentionHeadGeometry geometry,KvCacheStorage storage,
+                            CausalAttentionExecutionEnvelope envelope,int batch,int width) {
+    return geometry.head_dim==256 && geometry.query_heads==24 && geometry.kv_heads==4 &&
+        storage==KvCacheStorage::Int8Group64 && batch==1 && !envelope.fast_prompt_kernel &&
+        (width==224 || width==240 || width==246 || width==251) &&
+        envelope.max_visible_keys>=12288 && envelope.max_visible_keys<=53248 &&
+        enabled() && measured_device();
+}
+std::size_t selective_int8_workspace_bytes(int width,std::uint32_t visible) {
+    WorkspaceLayoutBuilder layout;
+    (void)selective_i8::allocate_causal_partials(layout,24,width,partition(width,visible).capacity,1);
+    return layout.peak_bytes(1);
+}
+void selective_int8_cached_launch(const Tensor& q,const Tensor& positions,
+                                  const Tensor* valid,const Tensor* rows,float scale,
+                                  PagedKVBatchLayerView cache,CausalAttentionExecutionEnvelope envelope,
+                                  WorkspaceArena& workspace,Tensor& out,cudaStream_t stream) {
+    auto scope=workspace.scope();
+    const auto part=partition(q.ne[2],envelope.max_visible_keys);
+    const auto partial=selective_i8::allocate_causal_partials(workspace,24,q.ne[2],part.capacity,1);
+    const auto p=selective_i8::make_causal_operands(q,positions,out,scale,envelope.max_visible_keys);
+    const auto view=selective_i8::make_quantized_causal_cache_view<selective_i8::Int8KvReadView>(cache,valid,rows);
+    if (view.valid_columns) launch<true>(p,view,part,partial.view(),stream);
+    else launch<false>(p,view,part,partial.view(),stream);
+}
+}
+#else
+#include <stdexcept>
+namespace ninfer::ops::detail {
+bool selective_int8_applies(AttentionHeadGeometry, KvCacheStorage,
+                            CausalAttentionExecutionEnvelope, int, int) { return false; }
+std::size_t selective_int8_workspace_bytes(int, std::uint32_t) { return 0; }
+void selective_int8_cached_launch(const Tensor&, const Tensor&, const Tensor*, const Tensor*,
+                                  float, PagedKVBatchLayerView, CausalAttentionExecutionEnvelope,
+                                  WorkspaceArena&, Tensor&, cudaStream_t) {
+    throw std::logic_error("selective INT8 prefill is unavailable in this build");
+}
+}
+#endif
