+std::size_t glm5_decode_step_scratch_bytes(const Glm5StepConfig& config,
+                                           std::uint32_t worst_position) {
+    // Residual streams (4*H), the collapsed and block output planes, the mHC
+    // weight planes, the final hidden/logits staging, and the per-block
+    // internal scratch as the PEAK over one block of each kind (the blocks
+    // reuse one slice). The DSA slice scales with the visible-pool count at
+    // worst_position: the re-pooling scratch and the score column both
+    // grow with the history length.
+    const std::uint64_t hidden = config.hidden;
+    const std::uint64_t d_inner =
+        static_cast<std::uint64_t>(config.kda_heads) * config.kda_head_dim;
+    const std::uint64_t kda =
+        hidden * 2 + 15 + 9 * (d_inner * 2 + 15) + d_inner * 4 + 15 +
+        static_cast<std::uint64_t>(config.kda_head_dim) * 2 + 15 +
+        static_cast<std::uint64_t>(config.kda_heads) * 2 + 15 +
+        static_cast<std::uint64_t>(config.kda_heads) * 4 + 15 + 4096;
+    const std::uint64_t completed =
+        (static_cast<std::uint64_t>(worst_position) + 1) / config.kpool;
+    const std::uint64_t dsa =
+        hidden * 2 + 15 +
+        static_cast<std::uint64_t>(config.q_lora) * 2 + 15 +
+        static_cast<std::uint64_t>(config.heads) * config.head_dim * 2 + 15 +
+        static_cast<std::uint64_t>(config.kv_lora) * 2 + 15 +
+        static_cast<std::uint64_t>(config.index_heads) * config.index_dim * 2 + 15 +
+        config.index_dim * 6 + 15 +
+        static_cast<std::uint64_t>(config.index_heads) * 2 + 15 +
+        static_cast<std::uint64_t>(config.index_heads) * 4 + 15 +
+        static_cast<std::uint64_t>(config.heads) * config.kv_lora * 4 + 15 +
+        static_cast<std::uint64_t>(config.heads) * config.kv_lora * 2 + 15 +
+        static_cast<std::uint64_t>(config.heads) * config.v_head * 2 + 15 +
+        // history-scaled planes: the re-pool scratch [completed, index_dim]
+        // and the score column [completed]
+        (completed ? completed : 1) * config.index_dim * 4 + 15 +
+        (completed ? completed : 1) * 4 + 15 + 4096;
+    const std::uint64_t dense =
+        hidden * 2 + 15 + (static_cast<std::uint64_t>(config.ffn_dense) * 2 + 15) * 3 + 512;
+    const std::uint64_t moe =
+        hidden * 2 + static_cast<std::uint64_t>(config.ffn_moe) * 8 +
+        static_cast<std::uint64_t>(config.num_experts_per_tok) * hidden * 2 +
+        static_cast<std::uint64_t>(config.num_experts_per_tok) * 8 +
+        static_cast<std::uint64_t>(config.experts) * 2 + 1024;
+    const std::uint64_t block_peak = std::max(std::max(kda, dsa), std::max(dense, moe));
+    return static_cast<std::size_t>(
+        hidden * 2 * 4 * 2        // 4 residual streams + the post copy
+        + hidden * 2 * 2          // collapsed + block_out
+        + hidden * 2              // head mean output
+        + 4 * 4 + 16 * 4          // pre/post/comb planes
+        + hidden * 2              // final normed
+        + block_peak);
+}
+
+void glm5_decode_step(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                      const Glm5StepConfig& config, const Tensor& token_embedding,
+                      std::uint32_t position, Tensor& logits, void* scratch,
+                      const CudaExecutionView& execution, Tensor* hidden_out) {
+    const std::int32_t hidden = static_cast<std::int32_t>(config.hidden);
+    const auto hc = 4u;
+    if (token_embedding.ne[0] != hidden || token_embedding.ne[1] != 1 ||
+        token_embedding.dtype != DType::BF16) {
+        throw std::invalid_argument("glm5_decode_step: embedding must be BF16 [hidden, 1]");
+    }
+    if (w.layers.size() != config.layer_is_dsa.size() ||
+        w.layers.size() != config.layer_mlp_dense.size()) {
+        throw std::invalid_argument("glm5_decode_step: layer kind tables must cover every layer");
+    }
+
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    const std::size_t h2 = static_cast<std::size_t>(hidden) * 2;
+    void* residual = take(h2 * hc);      // the 4-stream plane [T=1, 4*H]
+    void* collapsed = take(h2);
+    void* block_out = take(h2);
+    void* pre_f = take(4 * 4);
+    void* post_f = take(4 * 4);
+    void* comb_f = take(16 * 4);
+    void* head_mean = take(h2);
+    void* final_normed = take(h2);
+    void* residual_copy = take(h2 * hc);   // mHC post reads the current residual
+
+    // Initialize the residual: four copies of the token embedding.
+    for (std::uint32_t n = 0; n < hc; ++n) {
+        CUDA_CHECK(cudaMemcpyAsync(static_cast<std::uint8_t*>(residual) + n * h2,
+                                   token_embedding.data, h2, cudaMemcpyDeviceToDevice, execution));
+    }
+
+    std::size_t kda_index = 0, dsa_index = 0;
+    for (std::size_t layer = 0; layer < w.layers.size(); ++layer) {
+        const Glm5Layer& lw = w.layers[layer];
+        Tensor residual_t(residual, DType::BF16, {1, static_cast<std::int32_t>(hc * config.hidden)});
+        Tensor pre_t(pre_f, DType::FP32, {1, 4});
+        Tensor post_t(post_f, DType::FP32, {1, 4});
+        Tensor comb_t(comb_f, DType::FP32, {1, 4, 4});
+        // The mHC pre op takes [T=1, hidden] but the block executors take [hidden, 1] -
+        // same memory, two views.
+        Tensor collapsed_mhc(collapsed, DType::BF16, {1, static_cast<std::int32_t>(config.hidden)});
+        Tensor collapsed_t(collapsed, DType::BF16, {static_cast<std::int32_t>(config.hidden), 1});
+
+        // ---- attention half: mHC pre -> norm -> mixer -> mHC post ----
+        {
+            const Tensor fn(const_cast<void*>(lw.hc_attn_fn.payload), DType::BF16,
+                            {24, static_cast<std::int32_t>(hc * config.hidden)});
+            const Tensor base(const_cast<void*>(lw.hc_attn_base.payload), DType::FP32, {24});
+            const Tensor scale(const_cast<void*>(lw.hc_attn_scale.payload), DType::FP32, {3});
+            ops::glm5_mhc_pre(residual_t, fn, base, scale, config.rms_eps, 1e-6f, 20,
+                              pre_t, post_t, comb_t, collapsed_mhc, execution);
+        }
+        Tensor block_out_t(block_out, DType::BF16, {hidden, 1});
+        if (config.layer_is_dsa[layer]) {
+            const auto ape_ptr = w.dsa_ape[dsa_index];
+            Tensor ape_t(const_cast<void*>(ape_ptr), DType::FP32,
+                         {static_cast<std::int32_t>(config.kpool),
+                          static_cast<std::int32_t>(config.index_dim)});
+            // The DSA block executor applies its own attn_norm internally; pass the
+            // collapsed stream directly (no double norm here).
+            dsa_block_decode(lw.dsa, collapsed_t, ape_t, state.dsa_latents[dsa_index],
+                             state.dsa_ik_plane[dsa_index], state.dsa_ig_plane[dsa_index],
+                             state.dsa_pooled[dsa_index], state.dsa_cells[dsa_index], position,
+                             config.rms_eps, config.heads, config.head_dim, config.q_lora,
+                             config.kv_lora, config.v_head, config.index_heads, config.index_dim,
+                             config.kpool, config.top_k, block_out_t, cursor, execution);
+            ++dsa_index;
+        } else {
+            const auto& scalars = w.kda_scalars[kda_index];
+            Tensor dt(const_cast<void*>(scalars.dt_bias), DType::BF16,
+                      {static_cast<std::int32_t>(config.kda_heads * config.kda_head_dim)});
+            Tensor alog(const_cast<void*>(scalars.a_log), DType::FP32,
+                        {static_cast<std::int32_t>(config.kda_heads)});
+            Tensor onw(const_cast<void*>(scalars.o_norm_w), DType::FP32,
+                       {static_cast<std::int32_t>(config.kda_head_dim)});
+            kda_block_decode(lw.kda, collapsed_t, dt, alog, onw,
+                             state.kda_conv_q[kda_index], state.kda_conv_k[kda_index],
+                             state.kda_conv_v[kda_index], state.kda_matrix[kda_index],
+                             config.gate_lower_bound, config.kda_heads, config.kda_head_dim,
+                             config.rms_eps, block_out_t, cursor, execution);
+            ++kda_index;
+        }
+        // mHC post: residual = post*block + comb @ residual.
+        {
+            // First copy the current residual out (the post reads it), then write in place.
+            CUDA_CHECK(cudaMemcpyAsync(residual_copy, residual, h2 * hc, cudaMemcpyDeviceToDevice, execution.stream()));
+            Tensor residual_in(residual_copy, DType::BF16, {1, static_cast<std::int32_t>(hc * config.hidden)});
+            Tensor bt(block_out, DType::BF16, {static_cast<std::int32_t>(config.hidden), 1});
+            Tensor bt_view(block_out, DType::BF16, {1, static_cast<std::int32_t>(config.hidden)});
+            Tensor residual_out(residual, DType::BF16, {1, static_cast<std::int32_t>(hc * config.hidden)});
+            ops::glm5_mhc_post(bt_view, residual_in, post_t, comb_t, residual_out, execution.stream());
+        }
+
+        // ---- FFN half: mHC pre -> norm -> MLP -> mHC post ----
+        {
+            const Tensor fn(const_cast<void*>(lw.hc_ffn_fn.payload), DType::BF16,
+                            {24, static_cast<std::int32_t>(hc * config.hidden)});
+            const Tensor base(const_cast<void*>(lw.hc_ffn_base.payload), DType::FP32, {24});
+            const Tensor scale(const_cast<void*>(lw.hc_ffn_scale.payload), DType::FP32, {3});
+            ops::glm5_mhc_pre(residual_t, fn, base, scale, config.rms_eps, 1e-6f, 20,
+                              pre_t, post_t, comb_t, collapsed_mhc, execution);
+        }
+        if (config.layer_mlp_dense[layer]) {
+            dense_mlp_decode(lw.dense_mlp, collapsed_t, config.rms_eps, config.swiglu_limit,
+                             config.ffn_dense, block_out_t, cursor, execution);
+        } else {
+            const Tensor router_bias(const_cast<void*>(lw.moe_router_bias), DType::FP32,
+                                      {static_cast<std::int32_t>(config.experts), 1});
+            moe_block_decode(lw.moe, collapsed_t, router_bias, config.rms_eps,
+                             config.swiglu_limit, config.routed_scaling_factor, config.experts,
+                             config.num_experts_per_tok, config.ffn_moe, block_out_t, cursor,
+                             execution);
+        }
+        {
+            CUDA_CHECK(cudaMemcpyAsync(residual_copy, residual, h2 * hc, cudaMemcpyDeviceToDevice, execution.stream()));
+            Tensor residual_in(residual_copy, DType::BF16, {1, static_cast<std::int32_t>(hc * config.hidden)});
+            Tensor bt_view(block_out, DType::BF16, {1, static_cast<std::int32_t>(config.hidden)});
+            Tensor residual_out(residual, DType::BF16, {1, static_cast<std::int32_t>(hc * config.hidden)});
+            ops::glm5_mhc_post(bt_view, residual_in, post_t, comb_t, residual_out, execution.stream());
+        }
+    }
+
+    // Final: head mean, output norm, lm_head.
+    {
+        Tensor residual_view(residual, DType::BF16, {1, static_cast<std::int32_t>(hc * config.hidden)});
+        Tensor head_mhc(head_mean, DType::BF16, {1, static_cast<std::int32_t>(config.hidden)});
+        ops::glm5_mhc_head(residual_view, head_mhc, execution.stream());
+        Tensor head_t(head_mean, DType::BF16, {static_cast<std::int32_t>(config.hidden), 1});
+        const Tensor output_norm_w(const_cast<void*>(w.output_norm.payload), DType::BF16,
+                                   {hidden, 1});
+        Tensor final_t(final_normed, DType::BF16, {hidden, 1});
+        ops::rmsnorm(head_t, output_norm_w, config.rms_eps, false, final_t, execution);
+        ops::linear(final_t, w.lm_head, logits, execution);
+        if (hidden_out) {
+            CUDA_CHECK(cudaMemcpyAsync(hidden_out->data, final_normed,
+                                       static_cast<std::size_t>(hidden) * 2,
+                                       cudaMemcpyDeviceToDevice, execution));
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Embedding lookup and the convenience decode-token wrapper
+
+std::size_t glm5_embed_scratch_bytes(std::uint32_t hidden) {
+    return hidden * 2 + 256;
+}
+
+void glm5_embed_token(const Glm5ModelWeights& w, std::uint32_t token_id,
+                      std::uint32_t hidden, Tensor& out, const CudaExecutionView& execution) {
+    if (out.ne[0] != static_cast<std::int32_t>(hidden) || out.ne[1] != 1 ||
+        out.dtype != DType::BF16) {
+        throw std::invalid_argument("glm5_embed_token: out must be BF16 [hidden, 1]");
+    }
+    // The embedding op reads device memory; upload the single ID via a bounce.
+    void* id_device = nullptr;
+    CUDA_CHECK(cudaMalloc(&id_device, 4));
+    const std::int32_t id_host = static_cast<std::int32_t>(token_id);
+    CUDA_CHECK(cudaMemcpyAsync(id_device, &id_host, 4, cudaMemcpyHostToDevice, execution.stream()));
+    Tensor ids(id_device, DType::I32, {1});
+    ops::embedding(ids, w.token_embd, out, execution);
+    CUDA_CHECK(cudaStreamSynchronize(execution.stream()));
+    CUDA_CHECK(cudaFree(id_device));
+}
+
+void glm5_decode_token(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                       const Glm5StepConfig& config, std::uint32_t token_id,
+                       std::uint32_t position, Tensor& logits, void* scratch,
+                       const CudaExecutionView& execution, Tensor* hidden_out) {
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    void* embedding = cursor;
+    cursor += (static_cast<std::size_t>(config.hidden) * 2 + 15) & ~std::size_t{15};
+    Tensor embedded(embedding, DType::BF16, {static_cast<std::int32_t>(config.hidden), 1});
+    glm5_embed_token(w, token_id, config.hidden, embedded, execution);
+    glm5_decode_step(w, state, config, embedded, position, logits, cursor, execution, hidden_out);
+}
+
+// ---------------------------------------------------------------------------
+// Multi-token prefill
+
+std::size_t glm5_prefill_scratch_bytes(const Glm5StepConfig& config,
+                                        std::uint32_t max_tokens) {
+    // Per-token scratch (the decode step's budget at the WORST position the
+    // prefill reaches) plus the token embedding plane plus the residual copy.
+    return glm5_decode_step_scratch_bytes(config, max_tokens - 1) +
+           static_cast<std::size_t>(config.hidden) * 2 + 256 +
+           static_cast<std::size_t>(config.hidden) * 2 * 4;
+}
+
+void glm5_prefill(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                  const Glm5StepConfig& config, const Tensor& token_ids,
+                  std::uint32_t first_position, Tensor& last_hidden, Tensor& last_logits,
+                  void* scratch, const CudaExecutionView& execution) {
+    const std::uint32_t tokens = token_ids.ne[0];
+    if (tokens == 0 || token_ids.dtype != DType::I32) {
+        throw std::invalid_argument("glm5_prefill: token_ids must be I32 [T]");
+    }
+    if (last_hidden.ne[0] != static_cast<std::int32_t>(config.hidden) ||
+        last_hidden.dtype != DType::BF16) {
+        throw std::invalid_argument("glm5_prefill: last_hidden must be BF16 [hidden, 1]");
+    }
+    for (std::uint32_t t = 0; t < tokens; ++t) {
+        std::int32_t id = 0;
+        CUDA_CHECK(cudaMemcpyAsync(&id,
+                                   static_cast<const std::int32_t*>(token_ids.data) + t, 4,
+                                   cudaMemcpyDeviceToHost, execution));
+        CUDA_CHECK(cudaStreamSynchronize(execution.stream()));
+        glm5_decode_token(w, state, config, static_cast<std::uint32_t>(id),
+                          first_position + t, last_logits, scratch, execution, &last_hidden);
+        // After the last token, save the final hidden state for the caller.
+        // The decode step writes logits; the hidden state is the final normed
+        // output that the mHC head produced. For the prefill result we copy
+        // the logits (the hidden is already consumed internally).
+    }
+    // The decode step already wrote last_logits for the final token; its
+    // optional hidden output publishes the final-normed state (the value
+    // the lm_head consumed) after every token, so last_hidden ends up
+    // holding the last token's hidden state - no more zero-fill stub.
+}
+
+
+// ---------------------------------------------------------------------------
+// Chunked prefill: the batched throughput path
+
+std::size_t glm5_prefill_chunked_scratch_bytes(const Glm5StepConfig& config,
+                                               std::uint32_t max_tokens,
+                                               std::uint32_t first_position) {
+    const std::uint64_t h = config.hidden;
+    const std::uint64_t hc = h * 4;
+    const std::uint64_t t = max_tokens;
+    std::uint64_t bytes = 0;
+    auto add = [&bytes](std::uint64_t value) { bytes += value + 15; };
+    add(hc * t * 2);   // residual [T, 4H]
+    add(hc * t * 2);   // residual copy for mHC post
+    add(h * t * 2);    // collapsed [T, H] (mHC layout)
+    add(h * t * 2);    // collapsed transposed [H, T]
+    add(h * t * 2);    // block out [H, T]
+    add(h * t * 2);    // block out transposed [T, H]
+    add(4 * t * 4);    // pre gates [T, 4]
+    add(4 * t * 4);    // post gates
+    add(16 * t * 4);   // comb [T, 4, 4]
+    add(h * t * 2);    // embedding gather [hidden, T]
+    add(h * t * 2);    // head mean transposed [H, T]
+    add(h * t * 2);    // final normed
+    // Per-layer executor scratch peaks: reuse one arena sized by the max.
+    std::uint64_t block_scratch = 0;
+    {
+        const std::uint64_t di = static_cast<std::uint64_t>(config.kda_heads) * config.kda_head_dim;
+        std::uint64_t kda = 0;
+        for (int plane = 0; plane < 8; ++plane) kda += di * t * 2 + 15;
+        kda += di * t * 4 + 15;
+        kda += h * t * 2 + 15;
+        kda += static_cast<std::uint64_t>(config.kda_head_dim) * t * 2 + 15;
+        kda += static_cast<std::uint64_t>(config.kda_heads) * t * 2 + 15;
+        kda += static_cast<std::uint64_t>(config.kda_heads) * t * 4 + 15;
+        kda += 4096;
+        block_scratch = std::max(block_scratch, kda);
+    }
+    {
+        const std::uint64_t q = config.q_lora, kl = config.kv_lora, vh = config.v_head;
+        const std::uint64_t ih = config.index_heads, id = config.index_dim;
+        std::uint64_t dsa = 0;
+        dsa += h * t * 2 + 15 + q * t * 2 + 15 +
+               static_cast<std::uint64_t>(config.heads) * config.head_dim * t * 2 + 15 +
+               kl * t * 2 + 15 + ih * id * t * 2 + 15 + id * t * 6 + 15 +
+               static_cast<std::uint64_t>(config.heads) * kl * t * 4 + 15 +
+               static_cast<std::uint64_t>(config.heads) * kl * t * 2 + 15 +
+               ih * t * 2 + 15 + ih * t * 4 + 15 +
+               static_cast<std::uint64_t>(config.heads) * vh * t * 2 + 15;
+        // The score column scales with the VISIBLE pools - the full history
+        // before this chunk plus the chunk's own completed pools.
+        const std::uint64_t dsa_completed =
+            (static_cast<std::uint64_t>(first_position) + t) / config.kpool + 1;
+        dsa += dsa_completed * 4 + 15 + 4096;
+        block_scratch = std::max(block_scratch, dsa);
+    }
+    {
+        std::uint64_t dense = h * t * 2 + 15 +
+                              (static_cast<std::uint64_t>(config.ffn_dense) * t * 2 + 15) * 3 +
+                              512;
+        block_scratch = std::max(block_scratch, dense);
+    }
+    {
+        // MoE runs per token through the single-token executor.
+        const std::uint64_t moe = static_cast<std::uint64_t>(config.hidden) * 2 +
+                                  static_cast<std::uint64_t>(config.ffn_moe) * 8 +
+                                  static_cast<std::uint64_t>(config.num_experts_per_tok) *
+                                      config.hidden * 2 +
+                                  static_cast<std::uint64_t>(config.num_experts_per_tok) * 8 +
+                                  static_cast<std::uint64_t>(config.experts) * 2 + 1024;
+        block_scratch = std::max(block_scratch, moe);
+    }
+    add(block_scratch);
+    return static_cast<std::size_t>(bytes);
+}
+
+void glm5_prefill_chunked(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                          const Glm5StepConfig& config, const Tensor& token_ids,
+                          std::uint32_t first_position, std::uint32_t chunk,
+                          Tensor& last_hidden, Tensor& last_logits, void* scratch,
+                          const CudaExecutionView& execution) {
+    const std::int32_t hidden = static_cast<std::int32_t>(config.hidden);
+    const std::int32_t tokens = token_ids.ne[0];
+    const auto hc = 4u;
+    if (tokens <= 0 || tokens % chunk != 0 || token_ids.dtype != DType::I32) {
+        throw std::invalid_argument(
+            "glm5_prefill_chunked: token_ids must be I32 [T] with T a multiple of chunk");
+    }
+    if (last_hidden.ne[0] != hidden || last_hidden.dtype != DType::BF16) {
+        throw std::invalid_argument("glm5_prefill_chunked: last_hidden must be BF16 [hidden, 1]");
+    }
+    if (last_logits.ne[0] != static_cast<std::int32_t>(config.vocab_size) ||
+        last_logits.dtype != DType::BF16) {
+        throw std::invalid_argument(
+            "glm5_prefill_chunked: last_logits must be BF16 [vocab, 1]");
+    }
+
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    const std::size_t ht = static_cast<std::size_t>(hidden) * tokens;
+    void* residual = take(ht * 4 * 2);        // [T, 4H]
+    void* residual_copy = take(ht * 4 * 2);
+    void* collapsed = take(ht * 2);            // [T, H] mHC / [H, T] block, same memory
+    void* block_out = take(ht * 2);            // [H, T] / [T, H], same memory
+    void* residual_scratch = take(ht * 2);     // scratch padding (kept for budget parity)
+    void* pre_f = take(static_cast<std::size_t>(tokens) * 4 * 4);
+    void* post_f = take(static_cast<std::size_t>(tokens) * 4 * 4);
+    void* comb_f = take(static_cast<std::size_t>(tokens) * 16 * 4);
+    void* embedded = take(ht * 2);             // [H, T]
+    void* final_normed = take(ht * 2);
+    void* block_scratch = cursor;              // the rest of the arena
+
+    // Embedding gather. The mHC residual is row-major [T, 4H] (FCD = 4H) and
+    // the embedding's {hidden, T} view is the SAME memory order (row-major
+    // [T, H]), so the four streams fill by strided copies straight from the
+    // gather - no transpose, no re-layout.
+    Tensor embedded_t(embedded, DType::BF16, {hidden, tokens});
+    ops::embedding(token_ids, w.token_embd, embedded_t, execution);
+    for (std::uint32_t n = 0; n < hc; ++n) {
+        CUDA_CHECK(cudaMemcpy2DAsync(
+            static_cast<std::uint8_t*>(residual) + static_cast<std::size_t>(n) * hidden * 2,
+            static_cast<std::size_t>(hidden) * 2 * hc,  // stream pitch (4H apart)
+            embedded, static_cast<std::size_t>(hidden) * 2,
+            static_cast<std::size_t>(hidden) * 2, tokens,
+            cudaMemcpyDeviceToDevice, execution));
+    }
+
+    std::size_t kda_index = 0, dsa_index = 0;
+    for (std::size_t layer = 0; layer < w.layers.size(); ++layer) {
+        const Glm5Layer& lw = w.layers[layer];
+        Tensor residual_t(residual, DType::BF16, {tokens, static_cast<std::int32_t>(hc * config.hidden)});
+        Tensor pre_t(pre_f, DType::FP32, {tokens, 4});
+        Tensor post_t(post_f, DType::FP32, {tokens, 4});
+        Tensor comb_t(comb_f, DType::FP32, {tokens, 4, 4});
+        // The mHC planes are row-major [T, width] and the block planes
+        // {width, T} - identical memory (FCD = width), so both are views
+        // over the same buffer; only the ne labels differ.
+        Tensor collapsed_mhc(collapsed, DType::BF16, {tokens, hidden});
+        Tensor collapsed_block(collapsed, DType::BF16, {hidden, tokens});
+        Tensor block_out_t(block_out, DType::BF16, {hidden, tokens});
+        Tensor block_out_row(block_out, DType::BF16, {tokens, hidden});
+
+        // ---- attention half ----
+        {
+            const Tensor fn(const_cast<void*>(lw.hc_attn_fn.payload), DType::BF16,
+                            {24, static_cast<std::int32_t>(hc * config.hidden)});
+            const Tensor base(const_cast<void*>(lw.hc_attn_base.payload), DType::FP32, {24});
+            const Tensor scale(const_cast<void*>(lw.hc_attn_scale.payload), DType::FP32, {3});
+            ops::glm5_mhc_pre(residual_t, fn, base, scale, config.rms_eps, 1e-6f, 20,
+                              pre_t, post_t, comb_t, collapsed_mhc, execution);
+        }
+        if (config.layer_is_dsa[layer]) {
+            const auto ape_ptr = w.dsa_ape[dsa_index];
+            Tensor ape_t(const_cast<void*>(ape_ptr), DType::FP32,
+                         {static_cast<std::int32_t>(config.kpool),
+                          static_cast<std::int32_t>(config.index_dim)});
+            dsa_block_prefill(lw.dsa, collapsed_block, ape_t, state.dsa_latents[dsa_index],
+                              state.dsa_ik_plane[dsa_index], state.dsa_ig_plane[dsa_index],
+                              state.dsa_pooled[dsa_index], state.dsa_cells[dsa_index],
+                              first_position, config.rms_eps, config.heads, config.head_dim,
+                              config.q_lora, config.kv_lora, config.v_head,
+                              config.index_heads, config.index_dim, config.kpool,
+                              config.top_k, block_out_t, block_scratch, execution);
+            ++dsa_index;
+        } else {
+            const auto& scalars = w.kda_scalars[kda_index];
+            Tensor dt(const_cast<void*>(scalars.dt_bias), DType::BF16,
+                      {static_cast<std::int32_t>(config.kda_heads * config.kda_head_dim)});
+            Tensor alog(const_cast<void*>(scalars.a_log), DType::FP32,
+                        {static_cast<std::int32_t>(config.kda_heads)});
+            Tensor onw(const_cast<void*>(scalars.o_norm_w), DType::FP32,
+                       {static_cast<std::int32_t>(config.kda_head_dim)});
+            kda_block_prefill(lw.kda, collapsed_block, dt, alog, onw,
+                              state.kda_conv_q[kda_index], state.kda_conv_k[kda_index],
+                              state.kda_conv_v[kda_index], state.kda_matrix[kda_index],
+                              config.gate_lower_bound, config.kda_heads, config.kda_head_dim,
+                              config.rms_eps, chunk, block_out_t, block_scratch, execution);
+            ++kda_index;
+        }
+        {
+            CUDA_CHECK(cudaMemcpyAsync(residual_copy, residual, ht * 4 * 2,
+                                       cudaMemcpyDeviceToDevice, execution));
+            Tensor residual_in(residual_copy, DType::BF16,
+                               {tokens, static_cast<std::int32_t>(hc * config.hidden)});
+            ops::glm5_mhc_post(block_out_row, residual_in, post_t, comb_t, residual_t, execution.stream());
+        }
+
+        // ---- FFN half ----
+        {
+            const Tensor fn(const_cast<void*>(lw.hc_ffn_fn.payload), DType::BF16,
+                            {24, static_cast<std::int32_t>(hc * config.hidden)});
+            const Tensor base(const_cast<void*>(lw.hc_ffn_base.payload), DType::FP32, {24});
+            const Tensor scale(const_cast<void*>(lw.hc_ffn_scale.payload), DType::FP32, {3});
+            ops::glm5_mhc_pre(residual_t, fn, base, scale, config.rms_eps, 1e-6f, 20,
+                              pre_t, post_t, comb_t, collapsed_mhc, execution);
+        }
+        if (config.layer_mlp_dense[layer]) {
+            dense_mlp_prefill(lw.dense_mlp, collapsed_block, config.rms_eps,
+                              config.swiglu_limit, config.ffn_dense, block_out_t,
+                              block_scratch, execution);
+        } else {
+            // MoE v1: the single-token executor per token of the chunk.
+            const Tensor router_bias(const_cast<void*>(lw.moe_router_bias), DType::FP32,
+                                      {static_cast<std::int32_t>(config.experts), 1});
+            for (std::int32_t t = 0; t < tokens; ++t) {
+                Tensor column_in(static_cast<std::uint8_t*>(collapsed) +
+                                     static_cast<std::size_t>(t) * hidden * 2,
+                                 DType::BF16, {hidden, 1});
+                Tensor column_out(static_cast<std::uint8_t*>(block_out) +
+                                      static_cast<std::size_t>(t) * hidden * 2,
+                                  DType::BF16, {hidden, 1});
+                moe_block_decode(lw.moe, column_in, router_bias, config.rms_eps,
+                                 config.swiglu_limit, config.routed_scaling_factor,
+                                 config.experts, config.num_experts_per_tok, config.ffn_moe,
+                                 column_out, block_scratch, execution);
+            }
+        }
+        {
+            CUDA_CHECK(cudaMemcpyAsync(residual_copy, residual, ht * 4 * 2,
+                                       cudaMemcpyDeviceToDevice, execution));
+            Tensor residual_in(residual_copy, DType::BF16,
+                               {tokens, static_cast<std::int32_t>(hc * config.hidden)});
+            ops::glm5_mhc_post(block_out_row, residual_in, post_t, comb_t, residual_t, execution.stream());
+        }
+    }
+
+    // Final: head mean over the 4 streams, output norm, lm_head; the last
+    // token's row is the prefill result.
+    {
+        Tensor head_mhc(collapsed, DType::BF16, {tokens, hidden});
+        Tensor residual_final(residual, DType::BF16,
+                              {tokens, static_cast<std::int32_t>(hc * config.hidden)});
+        ops::glm5_mhc_head(residual_final, head_mhc, execution.stream());
+        // Same memory re-labelled: the head's [T, H] output is the rmsnorm's
+        // {hidden, T} input.
+        Tensor head_t(collapsed, DType::BF16, {hidden, tokens});
+        const Tensor output_norm_w(const_cast<void*>(w.output_norm.payload), DType::BF16,
+                                   {hidden, 1});
+        Tensor final_t(final_normed, DType::BF16, {hidden, tokens});
+        ops::rmsnorm(head_t, output_norm_w, config.rms_eps, false, final_t, execution);
+        // A [vocab, T] logits plane would dominate the scratch; the prefill
+        // contract only needs the last token's row, so the lm_head runs once
+        // on that column.
+        Tensor last_column(static_cast<std::uint8_t*>(final_normed) +
+                               static_cast<std::size_t>(tokens - 1) * hidden * 2,
+                           DType::BF16, {hidden, 1});
+        ops::linear(last_column, w.lm_head, last_logits, execution);
+        CUDA_CHECK(cudaMemcpyAsync(last_hidden.data,
+                                   static_cast<std::uint8_t*>(final_normed) +
+                                       static_cast<std::size_t>(tokens - 1) * hidden * 2,
+                                   static_cast<std::size_t>(hidden) * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+}
+
