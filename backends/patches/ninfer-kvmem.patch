+        PinnedBuffer h_postg = device.allocate_host(4 * T * 4);
+        PinnedBuffer h_collapsed = device.allocate_host(H * T * 2);
+        PinnedBuffer h_updated = device.allocate_host(W4 * T * 2);
+        PinnedBuffer h_head = device.allocate_host(H * T * 2);
+        DeviceBuffer d_streams = device.allocate_device(W4 * T * 2);
+        DeviceBuffer d_mixes = device.allocate_device(24 * T * 2);
+        DeviceBuffer d_base = device.allocate_device(24 * 4);
