+        4, 66, 90, 11, 29, 71, 45, 2, 99, 8, 60, 34, 76, 19, 52, 13,
+        40, 95, 27, 6, 81, 36, 15, 63, 108, 24, 47, 70, 3, 91, 58, 31,
+        110, 7, 84, 22, 49, 101, 16, 93};
+
+    auto plane = [&](std::uint32_t rows, std::uint32_t cols, std::uint32_t seed) {
