+    l0.kda.conv_v = execution::bf16_weight(d_cv.data(), 4 * DI, 1);
+    l0.kda.f_a = execution::bf16_weight(d_fa.data(), HD, H);
+    l0.kda.f_b = execution::bf16_weight(d_fb2.data(), DI, HD);
+    l0.kda.beta = execution::bf16_weight(d_bw.data(), HK, H);
+    l0.kda.g_a = execution::bf16_weight(d_ga.data(), HD, H);
+    l0.kda.g_b = execution::bf16_weight(d_gb.data(), DI, HD);
+    l0.kda.wo = execution::bf16_weight(d_kwo.data(), H, DI);
+    l0.moe.ffn_norm = l0.ffn_norm;
+    l0.moe.router = execution::bf16_weight(d_mrouter.data(), EXP, H);
+    l0.moe.gate_exps = execution::bf16_weight(d_mgate.data(), EXP * FFN_M, H);
+    l0.moe.up_exps = execution::bf16_weight(d_mup.data(), EXP * FFN_M, H);
+    l0.moe.down_exps = execution::bf16_weight(d_mdown.data(), EXP * H, FFN_M);
