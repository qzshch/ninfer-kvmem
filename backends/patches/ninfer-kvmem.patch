+// The GLM-5.3-Flash DSA block and the dense/MoE MLP blocks against chained host oracles
+// with BF16 rounding at every representation boundary (the pattern the verified KDA block
+// test established). Small probes pin the wiring; the audited geometry runs end to end.
+#include "models/glm5/execution/block.h"
+#include "models/glm5/reference/dsa_reference.h"
+
+#include "core/device.h"
+#include "ninfer/ops/linear.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <tuple>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
