@@ -0,0 +1,133 @@
+// ninfer::ops - GLM-5.3-Flash mHC launchers (decode path).
+#include "ninfer/ops/glm5_mhc.h"
+
+#include "ops/kernel/glm5_mhc.cuh"
+#include "core/device.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::ops {
+
+namespace {
+
+void require_contiguous(const Tensor& tensor, const char* what) {
+    if (!tensor.is_contiguous()) { throw std::invalid_argument(std::string(what) + " must be contiguous"); }
+}
+
+void require_shape(const Tensor& tensor, DType dtype, std::initializer_list<std::int32_t> shape,
+                   const char* what) {
+    require_contiguous(tensor, what);
+    if (tensor.dtype != dtype) {
+        throw std::invalid_argument(std::string(what) + " has the wrong dtype");
+    }
+    int index = 0;
+    for (const auto extent : shape) {
+        if (tensor.ne[index] != extent) {
+            throw std::invalid_argument(std::string(what) + " has the wrong shape");
+        }
+        ++index;
+    }
+}
+
+void require_positive_eps(float value, const char* what) {
+    if (!std::isfinite(value) || value <= 0) {
+        throw std::invalid_argument(std::string(what) + " must be positive finite");
+    }
+}
+
+void require_disjoint(const Tensor& a, const Tensor& b) {
+    const auto a_begin = reinterpret_cast<std::uintptr_t>(a.data);
+    const auto b_begin = reinterpret_cast<std::uintptr_t>(b.data);
+    const auto a_end = a_begin + a.bytes();
+    const auto b_end = b_begin + b.bytes();
+    if (a_begin < b_end && b_begin < a_end) {
+        throw std::invalid_argument("glm5_mhc operands must not overlap");
+    }
+}
+
+} // namespace
+
+void glm5_mhc_pre(const Tensor& streams, const Tensor& fn, const Tensor& base, const Tensor& scale,
+                  float rms_eps, float hc_eps, std::int32_t sinkhorn_iters, Tensor& pre,
+                  Tensor& post, Tensor& comb, Tensor& collapsed, cudaStream_t stream) {
+    const std::int32_t tokens = streams.ne[0];
+    const std::int32_t hc = 4;
+    const std::int32_t hidden = streams.ne[1] / hc;
+    if (streams.ne[1] % hc != 0 || hidden <= 0 || tokens <= 0) {
+        throw std::invalid_argument("glm5_mhc_pre: streams must be [T, 4*H]");
+    }
+    require_shape(streams, DType::BF16, {tokens, hc * hidden}, "glm5_mhc_pre: streams");
+    require_shape(fn, DType::BF16, {(2 + hc) * hc, hc * hidden}, "glm5_mhc_pre: fn");
+    require_shape(base, DType::FP32, {(2 + hc) * hc}, "glm5_mhc_pre: base");
+    require_shape(scale, DType::FP32, {3}, "glm5_mhc_pre: scale");
+    require_shape(pre, DType::FP32, {tokens, hc}, "glm5_mhc_pre: pre");
+    require_shape(post, DType::FP32, {tokens, hc}, "glm5_mhc_pre: post");
+    require_shape(comb, DType::FP32, {tokens, hc, hc}, "glm5_mhc_pre: comb");
+    require_shape(collapsed, DType::BF16, {tokens, hidden}, "glm5_mhc_pre: collapsed");
+    require_positive_eps(rms_eps, "glm5_mhc_pre: rms_eps");
+    require_positive_eps(hc_eps, "glm5_mhc_pre: hc_eps");
+    if (sinkhorn_iters < 1) {
+        throw std::invalid_argument("glm5_mhc_pre: sinkhorn_iters must be >= 1");
+    }
+    require_disjoint(streams, pre); require_disjoint(streams, post);
+    require_disjoint(streams, comb); require_disjoint(streams, collapsed);
+    require_disjoint(fn, collapsed);
+
+    glm5_mhc_detail::pre_kernel<<<static_cast<unsigned int>(tokens),
+                                  glm5_mhc_detail::kPreBlock, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(streams.data),
+        static_cast<const __nv_bfloat16*>(fn.data), static_cast<const float*>(base.data),
+        static_cast<const float*>(scale.data), rms_eps, hc_eps, sinkhorn_iters, hidden, hc,
+        static_cast<float*>(pre.data), static_cast<float*>(post.data),
+        static_cast<float*>(comb.data), static_cast<__nv_bfloat16*>(collapsed.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_mhc_post(const Tensor& block, const Tensor& residual, const Tensor& post,
+                   const Tensor& comb, Tensor& out, cudaStream_t stream) {
+    const std::int32_t tokens = residual.ne[0];
+    const std::int32_t hc = 4;
+    const std::int32_t hidden = residual.ne[1] / hc;
+    if (residual.ne[1] % hc != 0 || hidden <= 0 || tokens <= 0) {
+        throw std::invalid_argument("glm5_mhc_post: residual must be [T, 4*H]");
+    }
+    require_shape(residual, DType::BF16, {tokens, hc * hidden}, "glm5_mhc_post: residual");
+    require_shape(block, DType::BF16, {tokens, hidden}, "glm5_mhc_post: block");
+    require_shape(post, DType::FP32, {tokens, hc}, "glm5_mhc_post: post");
+    require_shape(comb, DType::FP32, {tokens, hc, hc}, "glm5_mhc_post: comb");
+    require_shape(out, DType::BF16, {tokens, hc * hidden}, "glm5_mhc_post: out");
+    require_disjoint(block, out);
+
+    const std::int64_t elements = static_cast<std::int64_t>(tokens) * hc * hidden;
+    constexpr std::int32_t threads = 256;
+    const auto blocks = static_cast<unsigned int>((elements + threads - 1) / threads);
+    glm5_mhc_detail::post_kernel<<<blocks, threads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(block.data),
+        static_cast<const __nv_bfloat16*>(residual.data), static_cast<const float*>(post.data),
+        static_cast<const float*>(comb.data), hidden, hc,
+        static_cast<__nv_bfloat16*>(out.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_mhc_head(const Tensor& streams, Tensor& out, cudaStream_t stream) {
+    const std::int32_t tokens = streams.ne[0];
+    const std::int32_t hc = 4;
+    const std::int32_t hidden = streams.ne[1] / hc;
+    if (streams.ne[1] % hc != 0 || hidden <= 0 || tokens <= 0) {
+        throw std::invalid_argument("glm5_mhc_head: streams must be [T, 4*H]");
+    }
+    require_shape(streams, DType::BF16, {tokens, hc * hidden}, "glm5_mhc_head: streams");
+    require_shape(out, DType::BF16, {tokens, hidden}, "glm5_mhc_head: out");
+
+    const std::int64_t elements = static_cast<std::int64_t>(tokens) * hidden;
+    constexpr std::int32_t threads = 256;
+    const auto blocks = static_cast<unsigned int>((elements + threads - 1) / threads);
+    glm5_mhc_detail::head_kernel<<<blocks, threads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(streams.data), hidden, hc,
+        static_cast<__nv_bfloat16*>(out.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops
