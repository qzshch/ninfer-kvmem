+#include "models/glm5/config.h"
+
+#include "artifact/schema.h"
+
+#include <cmath>
+#include <limits>
+#include <string>
+
+namespace ninfer::models::glm5 {
+namespace {
+
+using artifact::ArtifactError;
+using artifact::Json;
+
+std::uint32_t integer(const Json& config, const char* name, bool positive = true) {
+    const auto n = artifact::require_u64(config.at(name), name, positive);
+    if (n > std::numeric_limits<std::uint32_t>::max()) {
+        throw ArtifactError(std::string(name) + ": exceeds u32");
+    }
+    return static_cast<std::uint32_t>(n);
+}
+
+float positive_float(const Json& config, const char* name) {
+    const auto& value = config.at(name);
+    if (!value.is_number()) { throw ArtifactError(std::string(name) + " must be a real value"); }
+    const float result = value.get<float>();
+    if (!std::isfinite(result) || result <= 0) {
+        throw ArtifactError(std::string(name) + " must be positive finite FP32");
+    }
+    return result;
+}
+
+// The KDA gate lower bound is negative by construction (a safe lower bound on
+// a log-space decay); positive or zero would grow the state.
+float negative_float(const Json& config, const char* name) {
+    const auto& value = config.at(name);
+    if (!value.is_number()) { throw ArtifactError(std::string(name) + " must be a real value"); }
+    const float result = value.get<float>();
+    if (!std::isfinite(result) || result >= 0) {
+        throw ArtifactError(std::string(name) + " must be negative finite FP32");
+    }
+    return result;
+}
+
+void require_value(std::uint32_t actual, std::uint32_t implemented, const char* name) {
+    if (actual != implemented) {
+        throw ArtifactError(std::string(name) + " is " + std::to_string(actual) +
+                            "; this engine implements " + std::to_string(implemented));
+    }
+}
+
+void require_flag(const Json& config, const char* name, bool implemented) {
+    const auto& value = config.at(name);
+    if (!value.is_boolean() || value.get<bool>() != implemented) {
+        throw ArtifactError(std::string(name) + " must be " + (implemented ? "true" : "false") +
+                            " for the geometry this engine implements");
+    }
+}
+
+void require_string(const Json& config, const char* name, const char* implemented) {
+    if (config.at(name) != implemented) {
+        throw ArtifactError(std::string(name) + " must be \"" + implemented + '"');
+    }
+}
+
+} // namespace
+
+TextConfig parse_text_config(const Json& value) {
+    artifact::require_members(
+        value,
+        {"architectures", "model_type", "hidden_size", "vocab_size", "num_hidden_layers",
+         "max_position_embeddings", "tie_word_embeddings", "rms_norm_eps", "eos_token_id",
+         "layer_types", "first_k_dense_replace", "intermediate_size", "swiglu_limit",
+         "linear_attn_config", "num_attention_heads", "num_key_value_heads",
+         "qk_nope_head_dim", "qk_rope_head_dim", "v_head_dim", "q_lora_rank", "kv_lora_rank",
+         "attention_bias", "mla_use_nope", "index_n_heads", "index_head_dim", "index_kpool",
+         "index_top_k", "index_kpool_always_select_tail", "index_kpool_compress", "mhc",
+         "hc_mult", "hc_sinkhorn_iters", "hc_eps", "n_routed_experts", "num_experts_per_tok",
+         "moe_intermediate_size", "n_shared_experts", "routed_scaling_factor",
+         "norm_topk_prob", "scoring_func", "topk_method", "n_group", "topk_group",
+         "moe_router_dtype", "attention_dropout", "num_nextn_predict_layers"},
+        {}, "GLM5 text config");
+    const auto& architectures = value.at("architectures");
+    if (!architectures.is_array() || architectures.size() != 1 ||
+        architectures[0] != "Glm5NextForCausalLM" || value.at("model_type") != "glm5_next_text") {
+        throw ArtifactError("GLM5 text config: architecture/model_type mismatch");
+    }
+    TextConfig out;
+    out.hidden_size             = integer(value, "hidden_size");
+    out.vocab_size              = integer(value, "vocab_size");
+    out.num_hidden_layers       = integer(value, "num_hidden_layers");
+    out.max_position_embeddings = integer(value, "max_position_embeddings");
+    out.rms_norm_eps            = positive_float(value, "rms_norm_eps");
+    if (!value.at("tie_word_embeddings").is_boolean()) {
+        throw ArtifactError("tie_word_embeddings must be boolean");
+    }
+    out.tie_word_embeddings = value.at("tie_word_embeddings").get<bool>();
+
+    const auto& eos = value.at("eos_token_id");
+    if (eos.is_number()) {
+        const auto id = artifact::require_u64(eos, "eos_token_id", false);
+        if (id >= out.vocab_size) { throw ArtifactError("eos_token_id exceeds the vocabulary"); }
+        out.eos_token_ids.push_back(static_cast<std::int32_t>(id));
+    } else if (eos.is_array() && !eos.empty()) {
+        for (const auto& id : eos) {
+            const auto token = artifact::require_u64(id, "eos_token_id", false);
+            if (token >= out.vocab_size) {
+                throw ArtifactError("eos_token_id exceeds the vocabulary");
+            }
+            out.eos_token_ids.push_back(static_cast<std::int32_t>(token));
+        }
+    } else {
+        throw ArtifactError("eos_token_id must be one id or a non-empty list");
+    }
+
+    const auto& layers = value.at("layer_types");
+    if (!layers.is_array() || layers.size() != out.num_hidden_layers) {
+        throw ArtifactError("layer_types must describe every block");
+    }
+    for (const auto& layer : layers) {
+        if (layer == "linear_attention") {
+            out.layer_types.push_back(MixerKind::Kda);
+        } else if (layer == "deepseek_sparse_attention") {
+            out.layer_types.push_back(MixerKind::Dsa);
+        } else {
+            throw ArtifactError("unknown layer_type");
+        }
+    }
+
+    out.first_k_dense_replace = integer(value, "first_k_dense_replace", false);
+    if (out.first_k_dense_replace > out.num_hidden_layers) {
+        throw ArtifactError("first_k_dense_replace exceeds the block count");
+    }
+    out.intermediate_size = integer(value, "intermediate_size");
+    out.swiglu_limit      = positive_float(value, "swiglu_limit");
+
+    // KDA geometry: the audited profile only (64 heads of 128, 4-tap conv).
+    const auto& linear = value.at("linear_attn_config");
+    artifact::require_members(linear, {"num_heads", "head_dim", "short_conv_kernel_size",
+                                       "gate_lower_bound"},
+                              {}, "GLM5 linear_attn_config");
+    out.linear_num_heads   = integer(linear, "num_heads");
+    out.linear_head_dim    = integer(linear, "head_dim");
+    out.linear_conv_kernel = integer(linear, "short_conv_kernel_size");
+    out.linear_gate_lower_bound = negative_float(linear, "gate_lower_bound");
+    require_value(out.linear_conv_kernel, 4, "short_conv_kernel_size");
+    // d_inner = heads * head_dim (8192) legitimately exceeds the hidden size:
+    // the KDA q/k/v projections are 4096 -> 8192 each.
+
+    // MLA: NoPE-only, uniform heads, no attention bias.
+    out.num_attention_heads = integer(value, "num_attention_heads");
+    out.num_key_value_heads = integer(value, "num_key_value_heads");
+    out.qk_nope_head_dim    = integer(value, "qk_nope_head_dim");
+    out.qk_rope_head_dim    = integer(value, "qk_rope_head_dim", false);
+    out.v_head_dim          = integer(value, "v_head_dim");
+    out.q_lora_rank         = integer(value, "q_lora_rank");
+    out.kv_lora_rank        = integer(value, "kv_lora_rank");
+    require_value(out.qk_rope_head_dim, 0, "qk_rope_head_dim");
+    require_flag(value, "mla_use_nope", true);
+    require_flag(value, "attention_bias", false);
+    if (out.num_attention_heads != out.num_key_value_heads) {
+        throw ArtifactError("GLM5 MLA implements uniform query/key heads (no GQA)");
+    }
+
+    // Indexer: the audited 4-pool selection with its mandatory tail.
+    out.index_n_heads  = integer(value, "index_n_heads");
+    out.index_head_dim = integer(value, "index_head_dim");
+    out.index_kpool    = integer(value, "index_kpool");
+    out.index_top_k    = integer(value, "index_top_k");
+    require_value(out.index_kpool, 4, "index_kpool");
+    if (out.index_top_k % out.index_kpool != 0) {
+        throw ArtifactError("index_top_k must be a whole number of pools");
+    }
+    require_flag(value, "index_kpool_always_select_tail", true);
+    require_flag(value, "index_kpool_compress", true);
+    out.index_select_tail = true;
+
+    // mHC: 4 streams is what the kernels pin.
+    require_flag(value, "mhc", true);
+    out.hc_mult           = integer(value, "hc_mult");
+    out.hc_sinkhorn_iters = integer(value, "hc_sinkhorn_iters");
+    out.hc_eps            = positive_float(value, "hc_eps");
+    require_value(out.hc_mult, 4, "hc_mult");
+
+    // MoE: sigmoid + noaux_tc correction bias, single group, one shared
+    // expert of the routed width, FP32 router.
+    out.num_experts           = integer(value, "n_routed_experts");
+    out.num_experts_per_tok   = integer(value, "num_experts_per_tok");
+    out.moe_intermediate_size = integer(value, "moe_intermediate_size");
+    out.num_shared_experts    = integer(value, "n_shared_experts", false);
+    out.routed_scaling_factor = positive_float(value, "routed_scaling_factor");
+    if (!value.at("norm_topk_prob").is_boolean()) {
+        throw ArtifactError("norm_topk_prob must be boolean");
+    }
+    out.norm_topk_prob = value.at("norm_topk_prob").get<bool>();
+    require_string(value, "scoring_func", "sigmoid");
+    require_string(value, "topk_method", "noaux_tc");
+    require_value(integer(value, "n_group", false), 1, "n_group");
+    require_value(integer(value, "topk_group", false), 1, "topk_group");
+    require_string(value, "moe_router_dtype", "float32");
+    if (!out.norm_topk_prob) {
+        throw ArtifactError("GLM5 routing implements normalized top-k weights");
+    }
+    if (out.num_experts_per_tok > out.num_experts) {
+        throw ArtifactError("num_experts_per_tok exceeds the expert count");
+    }
+
+    const auto& dropout = value.at("attention_dropout");
+    if (!dropout.is_number() || dropout.get<double>() != 0.0) {
+        throw ArtifactError("attention_dropout must be zero for inference");
+    }
+    out.num_nextn_predict_layers = integer(value, "num_nextn_predict_layers", false);
+    return out;
+}
+
+} // namespace ninfer::models::glm5
diff --git a/src/models/glm5/config.h b/src/models/glm5/config.h
new file mode 100644
index 0000000..c1905f9
--- /dev/null
+++ b/src/models/glm5/config.h
@@ -0,0 +1,97 @@
+#pragma once
+
+// The text config of GLM-5.3-Flash (Glm5NextForCausalLM) as the converter will
+// write it into the artifact, parsed strictly: every field the mathematics
+// reads is required, and the shapes this engine implements are the only ones
+// accepted. The geometry mirrors the audited glm53-config evidence and the
+// reference stack (llama.cpp glm5-next, transformers glm5_next, Maya): 45
+// blocks of 34 KDA + 11 DSA, mHC residual streams, NoPE-only MLA with a
+// k-pool DSA indexer, and 3 dense + 42 sparse MLP blocks.
+
+#include "artifact/schema.h"
+#include "models/load_options.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace ninfer::models::glm5 {
+
+enum class MixerKind : std::uint8_t { Kda, Dsa };
+
+struct TextConfig {
+    std::uint32_t hidden_size             = 0;
+    std::uint32_t vocab_size              = 0;
+    std::uint32_t num_hidden_layers       = 0;
+    std::uint32_t max_position_embeddings = 0;
+    bool tie_word_embeddings              = false;
+    float rms_norm_eps                    = 0;
+    std::vector<std::int32_t> eos_token_ids;
+    std::vector<MixerKind> layer_types;
+    // The first first_k_dense_replace MLP blocks are dense; the rest are MoE.
+    std::uint32_t first_k_dense_replace   = 0;
+    std::uint32_t intermediate_size       = 0;  // dense FFN width
+    float swiglu_limit                    = 0;
+
+    // KDA (linear attention): per-channel decay gates with the safe lower
+    // bound in LOG space (a negative finite FP32 value, unlike the engine's
+    // other positive-epsilons-only fields).
+    std::uint32_t linear_num_heads    = 0;
+    std::uint32_t linear_head_dim     = 0;
+    std::uint32_t linear_conv_kernel  = 0;
+    float linear_gate_lower_bound     = 0;
+
+    // DSA blocks: NoPE-only MLA. qk_rope_head_dim is pinned to 0 by the
+    // engine; a rope component is a different model.
+    std::uint32_t num_attention_heads = 0;
+    std::uint32_t num_key_value_heads = 0;
+    std::uint32_t qk_nope_head_dim    = 0;
+    std::uint32_t qk_rope_head_dim    = 0;
+    std::uint32_t v_head_dim          = 0;
+    std::uint32_t q_lora_rank         = 0;
+    std::uint32_t kv_lora_rank        = 0;
+    bool attention_bias               = false;
+
+    // The k-pool indexer: pools of index_kpool tokens, index_topk selected
+    // token slots plus the always-selected incomplete tail.
+    std::uint32_t index_n_heads   = 0;
+    std::uint32_t index_head_dim  = 0;
+    std::uint32_t index_kpool     = 0;
+    std::uint32_t index_top_k     = 0;
+    bool index_select_tail        = false;
+
+    // mHC residual streams: sigmoid(+eps) pre, 2*sigmoid post, softmax(+eps)
+    // comb driven to doubly stochastic by hc_sinkhorn_iters rounds.
+    std::uint32_t hc_mult           = 0;
+    std::uint32_t hc_sinkhorn_iters = 0;
+    float hc_eps                    = 0;
+
+    // MoE: sigmoid router with the correction bias (noaux_tc), original
+    // scores normalized then scaled by routed_scaling_factor.
+    std::uint32_t num_experts             = 0;
+    std::uint32_t num_experts_per_tok     = 0;
+    std::uint32_t moe_intermediate_size   = 0;  // routed AND shared expert width
+    std::uint32_t num_shared_experts      = 0;
+    float routed_scaling_factor           = 0;
+    bool norm_topk_prob                   = false;
+
+    // Recorded for state layout; the engine's first GLM generation runs
+    // ordinary AR only (no MTP execution).
+    std::uint32_t num_nextn_predict_layers = 0;
+
+    [[nodiscard]] std::uint32_t index_top_pools() const noexcept {
+        return index_top_k / index_kpool;
+    }
+    [[nodiscard]] std::uint32_t index_selection_width() const noexcept {
+        return index_select_tail ? index_top_k + index_kpool - 1 : index_top_k;
+    }
+    [[nodiscard]] std::uint32_t linear_inner_width() const noexcept {
+        return linear_num_heads * linear_head_dim;
+    }
+    [[nodiscard]] bool mlp_is_sparse(std::uint32_t layer) const noexcept {
+        return layer >= first_k_dense_replace;
+    }
+};
+
+[[nodiscard]] TextConfig parse_text_config(const artifact::Json& value);
+
+} // namespace ninfer::models::glm5
diff --git a/src/models/glm5/execution/block.cpp b/src/models/glm5/execution/block.cpp
new file mode 100644
index 0000000..49d65d4
--- /dev/null
+++ b/src/models/glm5/execution/block.cpp
@@ -0,0 +1,935 @@
+#include "models/glm5/execution/block.h"
+// Opaque CUDA handles (forward-declared in block.h). Real builds include
+// the CUDA runtime through the ops headers below; only a prep-only build
+// that defines NINFER_PREP_CUDA_STUBS gets the extern declarations (they
+// clash with driver_types.h when the real header is in the include chain).
+#if defined(NINFER_PREP_CUDA_STUBS)
+using cudaError_t = int;
+constexpr cudaError_t cudaSuccess = 0;
+extern "C" {
+cudaError_t cudaMalloc(void** dev, unsigned long long size);
+cudaError_t cudaMemcpy(void* dest, const void* src, unsigned long long size, int kind);
+cudaError_t cudaMemcpyAsync(void* dest, const void* src, unsigned long long size,
+                           int kind, void* stream);
+cudaError_t cudaMemsetAsync(void* dest, int value, unsigned long long size, void* stream);
+cudaError_t cudaStreamSynchronize(void* stream);
+cudaError_t cudaGetLastError();
+const char* cudaGetErrorString(cudaError_t error);
+}
+constexpr int cudaMemcpyHostToDevice = 1;
+constexpr int cudaMemcpyDeviceToDevice = 3;
+#endif
+
+#include "ninfer/ops/add_bias.h"
+#include "ninfer/ops/glm5_kda.h"
+#include "ninfer/ops/glm5_dsa.h"
+#include "ninfer/ops/glm5_mlp.h"
+#include "ninfer/ops/layer_norm.h"
+#include "ninfer/ops/cast.h"
+#include "ninfer/ops/glm5_prefill.h"
+#include "ninfer/ops/linear.h"
+#include "ninfer/ops/rmsnorm.h"
+#include "core/device.h"
+
+#include <cmath>
+#include <stdexcept>
+#include <vector>
+#include <cuda_bf16.h>
+
+namespace ninfer::models::glm5::execution {
+// bf16_weight lives inline in block.h (the GGUF loader and both backend
+// entries construct it there).
+
+std::size_t kda_block_scratch_bytes(std::uint32_t hidden, std::uint32_t heads,
+                                    std::uint32_t head_dim) {
+    const std::uint64_t d_inner = static_cast<std::uint64_t>(heads) * head_dim;
+    // Nine BF16 d_inner planes (three raw projections, three conv outputs, gate pre, g2,
+    // the prefill output), two BF16 head_dim stages, the normed hidden, the BF16 beta
+    // logits, then the FP32 gate and beta planes the gating op writes; every plane is
+    // 16-byte aligned in the scratch, so add per-plane padding.
+    const std::uint64_t bf16_planes = 9;
+    const std::uint64_t bytes =
+        d_inner * 2 * bf16_planes + static_cast<std::uint64_t>(head_dim) * 2 * 2 +
+        static_cast<std::uint64_t>(hidden) * 2 + static_cast<std::uint64_t>(heads) * 2 +
+        d_inner * 4 + static_cast<std::uint64_t>(heads) * 4 +
+        16 * (bf16_planes + 5);
+    return static_cast<std::size_t>(bytes + 256);
+}
+
+void kda_block_decode(const KdaBlockWeights& w, const Tensor& hidden_in, const Tensor& dt_bias,
+                      const Tensor& a_log, const Tensor& o_norm_w, Tensor& conv_q_state,
+                      Tensor& conv_k_state, Tensor& conv_v_state, Tensor& matrix_state,
+                      float gate_lower_bound, std::uint32_t heads, std::uint32_t head_dim,
+                      float rms_eps, Tensor& block_out, void* scratch, const CudaExecutionView& execution,
+                      KdaBlockDebug* debug) {
+    const std::int32_t hidden = hidden_in.ne[0];
+    const std::int32_t d_inner =
+        static_cast<std::int32_t>(heads) * static_cast<std::int32_t>(head_dim);
+    if (hidden <= 0 || hidden_in.ne[1] != 1 || hidden_in.dtype != DType::BF16) {
+        throw std::invalid_argument("kda_block_decode: hidden_in must be BF16 [hidden, 1]");
+    }
+    if (dt_bias.ne[0] != d_inner || a_log.ne[0] != static_cast<std::int32_t>(heads) ||
+        o_norm_w.ne[0] != static_cast<std::int32_t>(head_dim)) {
+        throw std::invalid_argument("kda_block_decode: FP32 scalar plane mismatch");
+    }
+
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    void* normed = take(static_cast<std::size_t>(hidden) * 2);
+    const std::size_t inner_bf16 = static_cast<std::size_t>(d_inner) * 2;
+    void* q_raw = take(inner_bf16);
+    void* k_raw = take(inner_bf16);
+    void* v_raw = take(inner_bf16);
+    void* q_conv = take(inner_bf16);
+    void* k_conv = take(inner_bf16);
+    void* v_conv = take(inner_bf16);
+    void* stage = take(static_cast<std::size_t>(head_dim) * 2);
+    void* gate_pre = take(inner_bf16);
+    void* beta_logits = take(static_cast<std::size_t>(heads) * 2);
+    void* g2 = take(inner_bf16);
+    void* gate_log = take(static_cast<std::size_t>(d_inner) * 4);
+    void* beta_f32 = take(static_cast<std::size_t>(heads) * 4);
+    void* prefill_out = take(inner_bf16);
+
+    // norm(hidden), then the three projections and their causal convs. The ops take
+    // non-const output references, so every scratch plane gets a named Tensor.
+    const Tensor norm_weight(const_cast<void*>(w.attn_norm.payload), DType::BF16, {hidden, 1});
+    Tensor normed_t(normed, DType::BF16, {hidden, 1});
+    ops::rmsnorm(hidden_in, norm_weight, rms_eps, false, normed_t, execution);
+    if (debug && debug->normed) {
+        CUDA_CHECK(cudaMemcpyAsync(debug->normed->data, normed, hidden * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+    Tensor q_raw_t(q_raw, DType::BF16, {d_inner, 1});
+    Tensor k_raw_t(k_raw, DType::BF16, {d_inner, 1});
+    Tensor v_raw_t(v_raw, DType::BF16, {d_inner, 1});
+    ops::linear(normed_t, w.wq, q_raw_t, execution);
+    ops::linear(normed_t, w.wk, k_raw_t, execution);
+    ops::linear(normed_t, w.wv, v_raw_t, execution);
+    const Tensor conv_q_w(const_cast<void*>(w.conv_q.payload), DType::BF16, {4, d_inner});
+    const Tensor conv_k_w(const_cast<void*>(w.conv_k.payload), DType::BF16, {4, d_inner});
+    const Tensor conv_v_w(const_cast<void*>(w.conv_v.payload), DType::BF16, {4, d_inner});
+    Tensor q_raw_view(q_raw, DType::BF16, {1, d_inner});
+    Tensor k_raw_view(k_raw, DType::BF16, {1, d_inner});
+    Tensor v_raw_view(v_raw, DType::BF16, {1, d_inner});
+    Tensor q_conv_view(q_conv, DType::BF16, {1, d_inner});
+    Tensor k_conv_view(k_conv, DType::BF16, {1, d_inner});
+    Tensor v_conv_view(v_conv, DType::BF16, {1, d_inner});
+    ops::glm5_kda_conv(q_raw_view, conv_q_w, conv_q_state, q_conv_view, execution.stream());
+    ops::glm5_kda_conv(k_raw_view, conv_k_w, conv_k_state, k_conv_view, execution.stream());
+    ops::glm5_kda_conv(v_raw_view, conv_v_w, conv_v_state, v_conv_view, execution.stream());
+    if (debug && debug->q_conv) {
+        CUDA_CHECK(cudaMemcpyAsync(debug->q_conv->data, q_conv, d_inner * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+        CUDA_CHECK(cudaMemcpyAsync(debug->k_conv->data, k_conv, d_inner * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+        CUDA_CHECK(cudaMemcpyAsync(debug->v_conv->data, v_conv, d_inner * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+    // prefill reads the same conv planes in [D, T] order.
+    Tensor q_conv_t(q_conv, DType::BF16, {d_inner, 1});
+    Tensor k_conv_t(k_conv, DType::BF16, {d_inner, 1});
+    Tensor v_conv_t(v_conv, DType::BF16, {d_inner, 1});
+
+    // Two-stage decay gate with the dt bias, and beta.
+    const auto hd = static_cast<std::int32_t>(head_dim);
+    const auto hs = static_cast<std::int32_t>(heads);
+    Tensor stage_t(stage, DType::BF16, {hd, 1});
+    Tensor gate_pre_t(gate_pre, DType::BF16, {d_inner, 1});
+    Tensor beta_logits_t(beta_logits, DType::BF16, {hs, 1});
+    Tensor gate_t(gate_log, DType::FP32, {d_inner, 1});
+    Tensor beta_t(beta_f32, DType::FP32, {hs, 1});
+    ops::linear(normed_t, w.f_a, stage_t, execution);
+    ops::linear(stage_t, w.f_b, gate_pre_t, execution);
+    ops::add_bias(dt_bias, gate_pre_t, execution);
+    ops::linear(normed_t, w.beta, beta_logits_t, execution);
+    Tensor gate_pre_view(gate_pre, DType::BF16, {1, d_inner});
+    Tensor gate_view(gate_log, DType::FP32, {1, d_inner});
+    Tensor beta_view(beta_f32, DType::FP32, {1, hs});
+    Tensor beta_logits_view(beta_logits, DType::BF16, {1, hs});
+    if (debug && debug->gate_pre) {
+        CUDA_CHECK(cudaMemcpyAsync(debug->gate_pre->data, gate_pre, d_inner * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+    if (debug && debug->beta_logits) {
+        CUDA_CHECK(cudaMemcpyAsync(debug->beta_logits->data, beta_logits, heads * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+    ops::glm5_kda_gating(gate_pre_view, beta_logits_view, a_log, gate_lower_bound, gate_view,
+                         beta_view, execution);
+    if (debug && debug->gate) {
+        CUDA_CHECK(cudaMemcpyAsync(debug->gate->data, gate_log, static_cast<std::size_t>(d_inner) * 4,
+                                   cudaMemcpyDeviceToDevice, execution));
+        CUDA_CHECK(cudaMemcpyAsync(debug->beta->data, beta_f32, heads * 4,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+
+    // The output gate's two stages, then the single-token prefill and wo.
+    Tensor g2_t(g2, DType::BF16, {d_inner, 1});
+    Tensor prefill_t(prefill_out, DType::BF16, {d_inner, 1});
+    ops::linear(normed_t, w.g_a, stage_t, execution);
+    ops::linear(stage_t, w.g_b, g2_t, execution);
+    ops::glm5_kda_prefill(q_conv_t, k_conv_t, v_conv_t, gate_t, beta_t, g2_t, o_norm_w,
+                          matrix_state, prefill_t, execution);
+    if (debug && debug->prefill_out) {
+        CUDA_CHECK(cudaMemcpyAsync(debug->prefill_out->data, prefill_out, d_inner * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+    ops::linear(prefill_t, w.wo, block_out, execution);
+}
+
+
+// ---------------------------------------------------------------------------
+// DSA mixer block
+
+std::size_t dsa_block_scratch_bytes(std::uint32_t hidden, std::uint32_t heads,
+                                    std::uint32_t head_dim, std::uint32_t q_lora,
+                                    std::uint32_t kv_lora, std::uint32_t v_head,
+                                    std::uint32_t index_heads, std::uint32_t index_dim,
+                                    std::uint32_t kpool, std::uint32_t position) {
+    // History-scaled planes: the re-pool scratch [completed, index_dim] and
+    // the score column [completed] both grow with the visible-pool count at
+    // `position` (no more flat 4MB blanket).
+    const std::uint64_t completed =
+        (static_cast<std::uint64_t>(position) + 1) / kpool;
+    const std::uint64_t bytes =
+        static_cast<std::uint64_t>(hidden) * 2 + static_cast<std::uint64_t>(q_lora) * 2 +
+        static_cast<std::uint64_t>(heads) * head_dim * 2 + static_cast<std::uint64_t>(kv_lora) * 2 +
+        static_cast<std::uint64_t>(index_heads) * index_dim * 2 + index_dim * 2 * 3 +
+        static_cast<std::uint64_t>(index_heads) * 4 * 2 +
+        static_cast<std::uint64_t>(heads) * kv_lora * 4 +
+        static_cast<std::uint64_t>(heads) * kv_lora * 2 +
+        static_cast<std::uint64_t>(heads) * v_head * 2 +
+        (completed ? completed : 1) * index_dim * 4 + 15 +   // re-pool scratch
+        (completed ? completed : 1) * 4 + 15 +               // score column
+        16 * 16 + 1024;
+    return static_cast<std::size_t>(bytes);
+}
+
+void dsa_block_decode(const DsaBlockWeights& w, const Tensor& hidden_in, const Tensor& indexer_ape,
+                      Tensor& latents, Tensor& ik_plane, Tensor& ig_plane, Tensor& pooled,
+                      Tensor& cells, std::uint32_t position, float rms_eps, std::uint32_t heads,
+                      std::uint32_t head_dim, std::uint32_t q_lora, std::uint32_t kv_lora,
+                      std::uint32_t v_head, std::uint32_t index_heads, std::uint32_t index_dim,
+                      std::uint32_t kpool, std::uint32_t top_k, Tensor& block_out, void* scratch,
+                      const CudaExecutionView& execution) {
+    const std::int32_t hidden = hidden_in.ne[0];
+    if (hidden <= 0 || hidden_in.ne[1] != 1 || hidden_in.dtype != DType::BF16) {
+        throw std::invalid_argument("dsa_block_decode: hidden_in must be BF16 [hidden, 1]");
+    }
+    const std::uint32_t tokens = position + 1;
+    const std::uint32_t completed = tokens / kpool;
+
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    void* normed = take(hidden * 2);
+    void* q_latent = take(q_lora * 2);
+    void* q_heads = take(static_cast<std::size_t>(heads) * head_dim * 2);
+    void* latent = take(kv_lora * 2);
+    void* iq = take(static_cast<std::size_t>(index_heads) * index_dim * 2);
+    void* ik_raw = take(index_dim * 2);
+    void* ik_normed = take(index_dim * 2);
+    void* ig = take(index_dim * 2);
+    // One column: the decode path computes a single token's head weights
+    // (the [IH, T] sizing here was a leftover of the batched rework).
+    void* weights_bf = take(index_heads * 2);
+    void* weights_f32 = take(index_heads * 4);
+    void* q_abs = take(static_cast<std::size_t>(heads) * kv_lora * 4);
+    void* scores = take(static_cast<std::size_t>(completed ? completed : 1) * 4);
+    void* pool_scratch = take(static_cast<std::size_t>(completed ? completed : 1) * index_dim * 4);
+    void* attn_out = take(static_cast<std::size_t>(heads) * v_head * 2);
+
+    // norm(hidden) once; every projection reads it.
+    const Tensor norm_weight(const_cast<void*>(w.attn_norm.payload), DType::BF16, {hidden, 1});
+    Tensor normed_t(normed, DType::BF16, {hidden, 1});
+    ops::rmsnorm(hidden_in, norm_weight, rms_eps, false, normed_t, execution);
+
+    // q side: q_a -> norm -> q_b, then absorb W_K_B per head (FP32 out).
+    Tensor q_latent_t(q_latent, DType::BF16, {static_cast<std::int32_t>(q_lora), 1});
+    ops::linear(normed_t, w.q_a, q_latent_t, execution);
+    const Tensor q_norm_weight(const_cast<void*>(w.q_a_norm.payload), DType::BF16,
+                               {static_cast<std::int32_t>(q_lora), 1});
+    ops::rmsnorm(q_latent_t, q_norm_weight, rms_eps, false, q_latent_t, execution);
+    Tensor q_heads_t(q_heads, DType::BF16, {static_cast<std::int32_t>(heads * head_dim), 1});
+    ops::linear(q_latent_t, w.q_b, q_heads_t, execution);
+    Tensor q_heads_view(q_heads, DType::BF16,
+                        {static_cast<std::int32_t>(heads), static_cast<std::int32_t>(head_dim)});
+    Tensor q_abs_t(q_abs, DType::FP32,
+                   {static_cast<std::int32_t>(heads), static_cast<std::int32_t>(kv_lora)});
+    const Tensor wk_b_view(const_cast<void*>(w.wk_b.payload), DType::BF16,
+                           {static_cast<std::int32_t>(head_dim), static_cast<std::int32_t>(kv_lora),
+                            static_cast<std::int32_t>(heads)});
+    ops::glm5_dsa_absorb(q_heads_view, wk_b_view, q_abs_t, execution.stream());
+
+    // kv side: compress, norm, write this token's latent row.
+    Tensor latent_t(latent, DType::BF16, {static_cast<std::int32_t>(kv_lora), 1});
+    ops::linear(normed_t, w.kv_a, latent_t, execution);
+    const Tensor kv_norm_weight(const_cast<void*>(w.kv_a_norm.payload), DType::BF16,
+                                {static_cast<std::int32_t>(kv_lora), 1});
+    ops::rmsnorm(latent_t, kv_norm_weight, rms_eps, false, latent_t, execution);
+    CUDA_CHECK(cudaMemcpyAsync(static_cast<std::uint8_t*>(latents.data) +
+                                   static_cast<std::size_t>(position) * kv_lora * 2,
+                               latent, kv_lora * 2, cudaMemcpyDeviceToDevice, execution));
+
+    // Indexer planes: query from the q latent, LayerNorm'd key and gate from the hidden.
+    Tensor iq_t(iq, DType::BF16, {static_cast<std::int32_t>(index_heads * index_dim), 1});
+    ops::linear(q_latent_t, w.indexer_q_b, iq_t, execution);
+    Tensor ik_raw_t(ik_raw, DType::BF16, {static_cast<std::int32_t>(index_dim), 1});
+    ops::linear(normed_t, w.indexer_k, ik_raw_t, execution);
+    Tensor ik_normed_t(ik_normed, DType::BF16, {static_cast<std::int32_t>(index_dim), 1});
+    const Tensor ln_w(const_cast<void*>(w.indexer_k_norm_w.payload), DType::BF16,
+                      {static_cast<std::int32_t>(index_dim)});
+    const Tensor ln_b(const_cast<void*>(w.indexer_k_norm_b.payload), DType::BF16,
+                      {static_cast<std::int32_t>(index_dim)});
+    ops::layer_norm(ik_raw_t, ln_w, ln_b, 1e-6f, ik_normed_t, execution);
+    Tensor ig_t(ig, DType::BF16, {static_cast<std::int32_t>(index_dim), 1});
+    ops::linear(normed_t, w.indexer_gate, ig_t, execution);
+    CUDA_CHECK(cudaMemcpyAsync(static_cast<std::uint8_t*>(ik_plane.data) +
+                                   static_cast<std::size_t>(position) * index_dim * 2,
+                               ik_normed, index_dim * 2, cudaMemcpyDeviceToDevice, execution));
+    CUDA_CHECK(cudaMemcpyAsync(static_cast<std::uint8_t*>(ig_plane.data) +
+                                   static_cast<std::size_t>(position) * index_dim * 2,
+                               ig, index_dim * 2, cudaMemcpyDeviceToDevice, execution));
+
+    // Re-pool every completed pool (decode path; incremental re-pooling is a later
+    // optimization that the streaming protocol in the research notes describes).
+    if (completed > 0) {
+        const std::int32_t pool_tokens = static_cast<std::int32_t>(completed) * kpool;
+        // Only the completed prefix feeds the pool op; the history plane is [cache, dim]
+        // but tokens % kpool == 0 must hold for the slice, so build it via a fresh Tensor
+        // over the same storage with the completed-prefix geometry (rows are contiguous).
+        Tensor ik_history(ik_plane.data, DType::BF16,
+                          {pool_tokens, static_cast<std::int32_t>(index_dim)});
+        Tensor ig_history(ig_plane.data, DType::BF16,
+                          {pool_tokens, static_cast<std::int32_t>(index_dim)});
+        Tensor pooled_t(pool_scratch, DType::FP32,
+                        {static_cast<std::int32_t>(completed), static_cast<std::int32_t>(index_dim)});
+        ops::glm5_dsa_pool(ik_history, ig_history, indexer_ape, pooled_t, execution.stream());
+        CUDA_CHECK(cudaMemcpyAsync(pooled.data, pool_scratch,
+                                   static_cast<std::size_t>(completed) * index_dim * 4,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+
+    // Head weights: the linear op emits BF16; the score op wants FP32 pre-scaled by
+    // 1/sqrt(dim*heads). This decode path bridges through the host once per token (a
+    // [index_heads] plane); a fused cast kernel replaces it later.
+    {
+        Tensor weights_t(weights_bf, DType::BF16, {static_cast<std::int32_t>(index_heads), 1});
+        ops::linear(normed_t, w.indexer_proj, weights_t, execution);
+        std::vector<std::uint16_t> host_bf(index_heads);
+        CUDA_CHECK(cudaMemcpyAsync(host_bf.data(), weights_bf, index_heads * 2,
+                                   cudaMemcpyDeviceToHost, execution));
+        CUDA_CHECK(cudaStreamSynchronize(execution.stream()));
+        std::vector<float> host_f32(index_heads);
+        const float scale = std::sqrt(1.0f / (static_cast<float>(index_dim) * index_heads));
+        for (std::uint32_t h = 0; h < index_heads; ++h) {
+            host_f32[h] = __bfloat162float(*reinterpret_cast<__nv_bfloat16*>(&host_bf[h])) * scale;
+        }
+        CUDA_CHECK(cudaMemcpyAsync(weights_f32, host_f32.data(), index_heads * 4,
+                                   cudaMemcpyHostToDevice, execution));
+    }
+
+    // Score -> select -> attention. With no completed pool the selection is tail-only.
+    if (completed > 0) {
+        Tensor pooled_t(pooled.data, DType::FP32,
+                        {static_cast<std::int32_t>(completed), static_cast<std::int32_t>(index_dim)});
+        Tensor iq_view(iq, DType::BF16,
+                       {static_cast<std::int32_t>(index_heads), static_cast<std::int32_t>(index_dim)});
+        Tensor score_t(scores, DType::FP32, {static_cast<std::int32_t>(completed)});
+        Tensor w_view(weights_f32, DType::FP32, {static_cast<std::int32_t>(index_heads)});
+        ops::glm5_dsa_score(iq_view, pooled_t, w_view, score_t, execution.stream());
+        ops::glm5_dsa_select(score_t, position, static_cast<std::int32_t>(top_k / kpool), true,
+                             cells, execution);
+    } else {
+        std::vector<std::int32_t> tail_row(cells.ne[0], -1);
+        for (std::uint32_t m = 0; m + 1 < kpool; ++m) {
+            const std::uint32_t cell = m;
+            if (cell <= position) { tail_row[top_k + m] = static_cast<std::int32_t>(cell); }
+        }
+        CUDA_CHECK(cudaMemcpyAsync(cells.data, tail_row.data(),
+                                   static_cast<std::size_t>(cells.ne[0]) * 4,
+                                   cudaMemcpyHostToDevice, execution));
+    }
+
+    // The attention op takes BF16 queries; round the FP32 absorbed queries to BF16 (the
+    // same host bridge as the head weights: one [heads, kv_lora] plane per token).
+    {
+        std::vector<float> host_f32(static_cast<std::size_t>(heads) * kv_lora);
+        CUDA_CHECK(cudaMemcpyAsync(host_f32.data(), q_abs,
+                                   static_cast<std::size_t>(heads) * kv_lora * 4,
+                                   cudaMemcpyDeviceToHost, execution));
+        CUDA_CHECK(cudaStreamSynchronize(execution.stream()));
+        std::vector<std::uint16_t> host_bf(host_f32.size());
+        for (std::size_t i = 0; i < host_f32.size(); ++i) {
+            *reinterpret_cast<float*>(&host_f32[i]) = host_f32[i];
+            host_bf[i] = __bfloat16_as_ushort(__float2bfloat16(host_f32[i]));
+        }
+        CUDA_CHECK(cudaMemcpyAsync(q_abs, host_bf.data(), host_bf.size() * 2,
+                                   cudaMemcpyHostToDevice, execution));
+    }
+    Tensor q_abs_bf(q_abs, DType::BF16,
+                    {static_cast<std::int32_t>(heads), static_cast<std::int32_t>(kv_lora)});
+    const Tensor wv_b_view(const_cast<void*>(w.wv_b.payload), DType::BF16,
+                           {static_cast<std::int32_t>(kv_lora), static_cast<std::int32_t>(v_head),
+                            static_cast<std::int32_t>(heads)});
+    Tensor attn_t(attn_out, DType::BF16, {static_cast<std::int32_t>(heads * v_head), 1});
+    ops::glm5_dsa_attention(q_abs_bf, latents, cells, wv_b_view, attn_t,
+                            static_cast<std::int32_t>(head_dim), execution);
+    ops::linear(attn_t, w.wo, block_out, execution);
+}
+
+
+// ---------------------------------------------------------------------------
+// MLP blocks
+
+std::size_t dense_mlp_scratch_bytes(std::uint32_t hidden, std::uint32_t ffn) {
+    return static_cast<std::size_t>(hidden) * 2 + static_cast<std::size_t>(ffn) * 6 + 512;
+}
+
+void dense_mlp_decode(const DenseMlpWeights& w, const Tensor& hidden_in, float rms_eps,
+                      float swiglu_limit, std::uint32_t ffn, Tensor& out, void* scratch,
+                      const CudaExecutionView& execution) {
+    const std::int32_t hidden = hidden_in.ne[0];
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    void* normed = take(hidden * 2);
+    void* gate = take(ffn * 2);
+    void* up = take(ffn * 2);
+    void* activated = take(ffn * 2);
+
+    const Tensor norm_weight(const_cast<void*>(w.ffn_norm.payload), DType::BF16, {hidden, 1});
+    Tensor normed_t(normed, DType::BF16, {hidden, 1});
+    ops::rmsnorm(hidden_in, norm_weight, rms_eps, false, normed_t, execution);
+    Tensor gate_t(gate, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+    Tensor up_t(up, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+    ops::linear(normed_t, w.gate, gate_t, execution);
+    ops::linear(normed_t, w.up, up_t, execution);
+    Tensor gate_view(gate, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+    Tensor up_view(up, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+    Tensor act_view(activated, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+    ops::glm5_swiglu(gate_view, up_view, swiglu_limit, act_view, execution.stream());
+    Tensor act_t(activated, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+    ops::linear(act_t, w.down, out, execution);
+}
+
+std::size_t moe_block_scratch_bytes(std::uint32_t hidden, std::uint32_t ffn,
+                                    std::uint32_t experts, std::uint32_t top_k) {
+    return static_cast<std::size_t>(hidden) * 2 + static_cast<std::size_t>(ffn) * 8 +
+           static_cast<std::size_t>(top_k) * static_cast<std::size_t>(hidden) * 2 +
+           static_cast<std::size_t>(top_k) * 8 + static_cast<std::size_t>(experts) * 2 + 1024;
+}
+
+void moe_block_decode(const MoeBlockWeights& w, const Tensor& hidden_in, const Tensor& router_bias,
+                      float rms_eps, float swiglu_limit, float routed_scaling_factor,
+                      std::uint32_t experts, std::uint32_t top_k, std::uint32_t ffn, Tensor& out,
+                      void* scratch, const CudaExecutionView& execution) {
+    const std::int32_t hidden = hidden_in.ne[0];
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    void* normed = take(hidden * 2);
+    void* logits = take(experts * 2);
+    void* gate = take(ffn * 2);
+    void* up = take(ffn * 2);
+    void* activated = take(ffn * 2);
+    void* expert_down = take(hidden * 2);
+    void* stacked = take(static_cast<std::size_t>(top_k) * hidden * 2);
+    void* weights_f32 = take(top_k * 4);
+    void* indices = take(top_k * 4);
+    void* shared_out = take(hidden * 2);
+
+    const Tensor norm_weight(const_cast<void*>(w.ffn_norm.payload), DType::BF16, {hidden, 1});
+    Tensor normed_t(normed, DType::BF16, {hidden, 1});
+    ops::rmsnorm(hidden_in, norm_weight, rms_eps, false, normed_t, execution);
+
+    Tensor logits_t(logits, DType::BF16, {static_cast<std::int32_t>(experts), 1});
+    ops::linear(normed_t, w.router, logits_t, execution);
+    Tensor weights_t(weights_f32, DType::FP32, {static_cast<std::int32_t>(top_k)});
+    Tensor indices_t(indices, DType::I32, {static_cast<std::int32_t>(top_k)});
+    ops::glm5_moe_route(logits_t, router_bias, static_cast<std::int32_t>(top_k),
+                        routed_scaling_factor, weights_t, indices_t, execution);
+
+    // Selected experts sequentially; each expert's weights are its row block of the
+    // stacked planes, addressed by offsetting the base Weight.
+    for (std::uint32_t slot = 0; slot < top_k; ++slot) {
+        std::int32_t expert = -1;
+        CUDA_CHECK(cudaMemcpyAsync(&expert, static_cast<const void*>(indices) + slot * 4, 4,
+                                   cudaMemcpyDeviceToHost, execution));
+        CUDA_CHECK(cudaStreamSynchronize(execution.stream()));
+        if (expert < 0 || static_cast<std::uint32_t>(expert) >= experts) {
+            CUDA_CHECK(cudaMemsetAsync(static_cast<std::uint8_t*>(stacked) +
+                                           static_cast<std::size_t>(slot) * hidden * 2,
+                                       0, static_cast<std::size_t>(hidden) * 2, execution));
+            continue;
+        }
+        const auto base = static_cast<std::uint32_t>(expert);
+        Weight gate_w = w.gate_exps;
+        gate_w.payload = static_cast<const std::uint8_t*>(w.gate_exps.payload) +
+                         static_cast<std::size_t>(base) * ffn * hidden * 2;
+        gate_w.payload_bytes = static_cast<std::uint64_t>(ffn) * hidden * 2;
+        gate_w.qdata = gate_w.payload;
+        gate_w.shape[0] = static_cast<std::int32_t>(ffn);
+        gate_w.padded_shape[0] = gate_w.shape[0];
+        gate_w.n = gate_w.shape[0];
+        Weight up_w = w.up_exps;
+        up_w.payload = static_cast<const std::uint8_t*>(w.up_exps.payload) +
+                       static_cast<std::size_t>(base) * ffn * hidden * 2;
+        up_w.payload_bytes = static_cast<std::uint64_t>(ffn) * hidden * 2;
+        up_w.qdata = up_w.payload;
+        up_w.shape[0] = static_cast<std::int32_t>(ffn);
+        up_w.padded_shape[0] = up_w.shape[0];
+        up_w.n = up_w.shape[0];
+        Weight down_w = w.down_exps;
+        down_w.payload = static_cast<const std::uint8_t*>(w.down_exps.payload) +
+                         static_cast<std::size_t>(base) * hidden * ffn * 2;
+        down_w.payload_bytes = static_cast<std::uint64_t>(hidden) * ffn * 2;
+        down_w.qdata = down_w.payload;
+        down_w.shape[0] = hidden;
+        down_w.padded_shape[0] = hidden;
+        down_w.n = hidden;
+
+        Tensor gate_t(gate, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+        Tensor up_t(up, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+        ops::linear(normed_t, gate_w, gate_t, execution);
+        ops::linear(normed_t, up_w, up_t, execution);
+        Tensor gate_view(gate, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+        Tensor up_view(up, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+        Tensor act_view(activated, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+        ops::glm5_swiglu(gate_view, up_view, swiglu_limit, act_view, execution.stream());
+        Tensor act_t(activated, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+        Tensor down_t(expert_down, DType::BF16, {hidden, 1});
+        ops::linear(act_t, down_w, down_t, execution);
+        CUDA_CHECK(cudaMemcpyAsync(static_cast<std::uint8_t*>(stacked) +
+                                       static_cast<std::size_t>(slot) * hidden * 2,
+                                   expert_down, static_cast<std::size_t>(hidden) * 2,
+                                   cudaMemcpyDeviceToDevice, execution));
+    }
+
+    // Shared expert (unweighted) plus the weighted routed combine.
+    {
+        Tensor gate_t(gate, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+        Tensor up_t(up, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+        ops::linear(normed_t, w.gate_shexp, gate_t, execution);
+        ops::linear(normed_t, w.up_shexp, up_t, execution);
+        Tensor gate_view(gate, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+        Tensor up_view(up, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+        Tensor act_view(activated, DType::BF16, {1, static_cast<std::int32_t>(ffn)});
+        ops::glm5_swiglu(gate_view, up_view, swiglu_limit, act_view, execution.stream());
+        Tensor act_t(activated, DType::BF16, {static_cast<std::int32_t>(ffn), 1});
+        Tensor shared_t(shared_out, DType::BF16, {hidden, 1});
+        ops::linear(act_t, w.down_shexp, shared_t, execution);
+    }
+    Tensor stacked_t(stacked, DType::BF16, {static_cast<std::int32_t>(top_k), hidden});
+    Tensor shared_t2(shared_out, DType::BF16, {static_cast<std::int32_t>(hidden), 1});
+    ops::glm5_moe_combine(stacked_t, weights_t, shared_t2, out, execution.stream());
+}
+
+
+// ---------------------------------------------------------------------------
+// Batched (chunked) prefill executors
+
+std::size_t kda_block_prefill_scratch_bytes(std::uint32_t hidden, std::uint32_t heads,
+                                             std::uint32_t head_dim, std::uint32_t tokens) {
+    const std::uint64_t d_inner = static_cast<std::uint64_t>(heads) * head_dim;
+    // Nine BF16 d_inner planes (q/k/v raw, q/k/v conv, gate_pre, g2, and the
+    // chunk-scan OUTPUT plane), the FP32 gate plane, then the narrow planes;
+    // 16-byte alignment per plane plus headroom.
+    std::uint64_t bytes = 0;
+    for (int plane = 0; plane < 9; ++plane) bytes += d_inner * tokens * 2 + 15;
+    bytes += d_inner * tokens * 4 + 15;                                     // gate (FP32)
+    bytes += static_cast<std::uint64_t>(hidden) * tokens * 2 + 15;          // normed
+    bytes += static_cast<std::uint64_t>(head_dim) * tokens * 2 + 15;        // f_a/g_a stage
+    bytes += static_cast<std::uint64_t>(heads) * tokens * 2 + 15;           // beta logits
+    bytes += static_cast<std::uint64_t>(heads) * tokens * 4 + 15;           // beta F32
+    return static_cast<std::size_t>(bytes + 4096);
+}
+
+void kda_block_prefill(const KdaBlockWeights& w, const Tensor& hidden_in,
+                       const Tensor& dt_bias, const Tensor& a_log, const Tensor& o_norm_w,
+                       Tensor& conv_q_state, Tensor& conv_k_state, Tensor& conv_v_state,
+                       Tensor& matrix_state, float gate_lower_bound, std::uint32_t heads,
+                       std::uint32_t head_dim, float rms_eps, std::uint32_t chunk,
+                       Tensor& block_out, void* scratch, const CudaExecutionView& execution) {
+    const std::int32_t hidden = hidden_in.ne[0];
+    const std::int32_t tokens = hidden_in.ne[1];
+    const auto d_inner = static_cast<std::int32_t>(heads * head_dim);
+    if (hidden <= 0 || tokens <= 0 || hidden_in.dtype != DType::BF16 ||
+        tokens % chunk != 0) {
+        throw std::invalid_argument(
+            "kda_block_prefill: hidden_in must be BF16 [hidden, T] with T a multiple of chunk");
+    }
+
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    const std::size_t plane = static_cast<std::size_t>(d_inner) * tokens;
+    const std::size_t plane_b = plane * 2;
+    void* normed = take(static_cast<std::size_t>(hidden) * tokens * 2);
+    void* q_raw = take(plane_b);
+    void* k_raw = take(plane_b);
+    void* v_raw = take(plane_b);
+    void* q_conv = take(plane_b);
+    void* k_conv = take(plane_b);
+    void* v_conv = take(plane_b);
+    void* stage = take(static_cast<std::size_t>(head_dim) * tokens * 2);
+    void* gate_pre = take(plane_b);
+    void* beta_logits = take(static_cast<std::size_t>(heads) * tokens * 2);
+    void* g2 = take(plane_b);
+    void* gate_log = take(plane * 4);
+    void* beta_f32 = take(static_cast<std::size_t>(heads) * tokens * 4);
+    void* scan_out = take(plane_b);
+
+    const Tensor norm_weight(const_cast<void*>(w.attn_norm.payload), DType::BF16, {hidden, 1});
+    Tensor normed_t(normed, DType::BF16, {hidden, tokens});
+    ops::rmsnorm(hidden_in, norm_weight, rms_eps, false, normed_t, execution);
+
+    Tensor q_raw_t(q_raw, DType::BF16, {d_inner, tokens});
+    Tensor k_raw_t(k_raw, DType::BF16, {d_inner, tokens});
+    Tensor v_raw_t(v_raw, DType::BF16, {d_inner, tokens});
+    ops::linear(normed_t, w.wq, q_raw_t, execution);
+    ops::linear(normed_t, w.wk, k_raw_t, execution);
+    ops::linear(normed_t, w.wv, v_raw_t, execution);
+
+    // The conv kernel's memory order (channel fastest: t*d_inner + ch) is
+    // exactly the [d_inner, T] FCD layout of the linear outputs; the op's
+    // {tokens, d_inner} ne label just needs re-stickering on the same memory.
+    const Tensor conv_q_w(const_cast<void*>(w.conv_q.payload), DType::BF16, {4, d_inner});
+    const Tensor conv_k_w(const_cast<void*>(w.conv_k.payload), DType::BF16, {4, d_inner});
+    const Tensor conv_v_w(const_cast<void*>(w.conv_v.payload), DType::BF16, {4, d_inner});
+    Tensor q_raw_label(q_raw, DType::BF16, {tokens, d_inner});
+    Tensor k_raw_label(k_raw, DType::BF16, {tokens, d_inner});
+    Tensor v_raw_label(v_raw, DType::BF16, {tokens, d_inner});
+    Tensor q_conv_t(q_conv, DType::BF16, {d_inner, tokens});
+    Tensor k_conv_t(k_conv, DType::BF16, {d_inner, tokens});
+    Tensor v_conv_t(v_conv, DType::BF16, {d_inner, tokens});
+    Tensor q_conv_label(q_conv, DType::BF16, {tokens, d_inner});
+    Tensor k_conv_label(k_conv, DType::BF16, {tokens, d_inner});
+    Tensor v_conv_label(v_conv, DType::BF16, {tokens, d_inner});
+    ops::glm5_kda_conv(q_raw_label, conv_q_w, conv_q_state, q_conv_label, execution.stream());
+    ops::glm5_kda_conv(k_raw_label, conv_k_w, conv_k_state, k_conv_label, execution.stream());
+    ops::glm5_kda_conv(v_raw_label, conv_v_w, conv_v_state, v_conv_label, execution.stream());
+
+    // Decay gate and beta over the whole plane.
+    const auto hd = static_cast<std::int32_t>(head_dim);
+    const auto hs = static_cast<std::int32_t>(heads);
+    Tensor stage_t(stage, DType::BF16, {hd, tokens});
+    Tensor gate_pre_t(gate_pre, DType::BF16, {d_inner, tokens});
+    Tensor beta_logits_t(beta_logits, DType::BF16, {hs, tokens});
+    Tensor gate_t(gate_log, DType::FP32, {d_inner, tokens});
+    Tensor beta_t(beta_f32, DType::FP32, {hs, tokens});
+    ops::linear(normed_t, w.f_a, stage_t, execution);
+    ops::linear(stage_t, w.f_b, gate_pre_t, execution);
+    ops::add_bias(dt_bias, gate_pre_t, execution);
+    ops::linear(normed_t, w.beta, beta_logits_t, execution);
+    // Same memory-order story as the conv: the gating kernel indexes
+    // t*d_inner + ch, so the [·, T] FCD planes pass through with their ne
+    // labels swapped; its outputs land in the chunk scan's expected layout.
+    Tensor gate_pre_label(gate_pre, DType::BF16, {tokens, d_inner});
+    Tensor beta_logits_label(beta_logits, DType::BF16, {tokens, static_cast<std::int32_t>(heads)});
+    Tensor gate_label(gate_log, DType::FP32, {tokens, d_inner});
+    Tensor beta_label(beta_f32, DType::FP32, {tokens, static_cast<std::int32_t>(heads)});
+    ops::glm5_kda_gating(gate_pre_label, beta_logits_label, a_log, gate_lower_bound,
+                         gate_label, beta_label, execution);
+
+    // Output-gate projections, then the chunked scan and the batched gate.
+    Tensor g2_t(g2, DType::BF16, {d_inner, tokens});
+    ops::linear(normed_t, w.g_a, stage_t, execution);
+    ops::linear(stage_t, w.g_b, g2_t, execution);
+    Tensor scan_t(scan_out, DType::BF16, {d_inner, tokens});
+    ops::glm5_kda_chunk(q_conv_t, k_conv_t, v_conv_t, gate_t, beta_t, matrix_state,
+                        scan_t, chunk, execution);
+    ops::glm5_kda_outgate(scan_t, g2_t, o_norm_w, scan_t, execution.stream());
+    ops::linear(scan_t, w.wo, block_out, execution);
+}
+
+std::size_t dsa_block_prefill_scratch_bytes(std::uint32_t hidden, std::uint32_t heads,
+                                             std::uint32_t head_dim, std::uint32_t q_lora,
+                                             std::uint32_t kv_lora, std::uint32_t v_head,
+                                             std::uint32_t index_heads,
+                                             std::uint32_t index_dim, std::uint32_t kpool,
+                                             std::uint32_t selection_width,
+                                             std::uint32_t tokens,
+                                             std::uint32_t first_position) {
+    std::uint64_t bytes = 0;
+    auto add = [&bytes](std::uint64_t elements, std::uint64_t item) {
+        bytes += elements * item + 15;
+    };
+    add(static_cast<std::uint64_t>(hidden) * tokens, 2);                      // normed
+    add(static_cast<std::uint64_t>(q_lora) * tokens, 2);                      // q latent
+    add(static_cast<std::uint64_t>(heads) * head_dim * tokens, 2);            // q heads
+    add(static_cast<std::uint64_t>(kv_lora) * tokens, 2);                     // latents
+    add(static_cast<std::uint64_t>(index_heads) * index_dim * tokens, 2);     // iq
+    add(static_cast<std::uint64_t>(index_dim) * tokens, 6);                   // ik raw/normed + ig
+    add(static_cast<std::uint64_t>(heads) * kv_lora * tokens, 4);             // q_abs F32
+    add(static_cast<std::uint64_t>(heads) * kv_lora * tokens, 2);             // q_abs BF16
+    add(static_cast<std::uint64_t>(index_heads) * tokens, 2);                 // weights bf16 [IH, T]
+    add(static_cast<std::uint64_t>(index_heads) * tokens, 4);                 // weights f32 [IH, T]
+    add(static_cast<std::uint64_t>(heads) * v_head * tokens, 2);              // attention out
+    // One score column, reused per position; the visible-pool count follows
+    // the history length, so the budget must scale with first_position.
+    const std::uint64_t completed =
+        (static_cast<std::uint64_t>(first_position) + tokens) / kpool;
+    add(completed ? completed : 1, 4);                                        // score scratch
+    return static_cast<std::size_t>(bytes + 4096);
+}
+
+void dsa_block_prefill(const DsaBlockWeights& w, const Tensor& hidden_in,
+                       const Tensor& indexer_ape, Tensor& latents, Tensor& ik_plane,
+                       Tensor& ig_plane, Tensor& pooled, Tensor& cells,
+                       std::uint32_t first_position, float rms_eps, std::uint32_t heads,
+                       std::uint32_t head_dim, std::uint32_t q_lora, std::uint32_t kv_lora,
+                       std::uint32_t v_head, std::uint32_t index_heads,
+                       std::uint32_t index_dim, std::uint32_t kpool, std::uint32_t top_k,
+                       Tensor& block_out, void* scratch, const CudaExecutionView& execution) {
+    const std::int32_t hidden = hidden_in.ne[0];
+    const std::int32_t tokens = hidden_in.ne[1];
+    if (hidden <= 0 || tokens <= 0 || hidden_in.dtype != DType::BF16) {
+        throw std::invalid_argument("dsa_block_prefill: hidden_in must be BF16 [hidden, T]");
+    }
+
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    void* normed = take(static_cast<std::size_t>(hidden) * tokens * 2);
+    void* q_latent = take(static_cast<std::size_t>(q_lora) * tokens * 2);
+    void* q_heads = take(static_cast<std::size_t>(heads) * head_dim * tokens * 2);
+    void* latent = take(static_cast<std::size_t>(kv_lora) * tokens * 2);
+    void* iq = take(static_cast<std::size_t>(index_heads) * index_dim * tokens * 2);
+    void* ik_raw = take(static_cast<std::size_t>(index_dim) * tokens * 2);
+    void* ik_normed = take(static_cast<std::size_t>(index_dim) * tokens * 2);
+    void* ig = take(static_cast<std::size_t>(index_dim) * tokens * 2);
+    void* weights_bf = take(static_cast<std::size_t>(index_heads) * tokens * 2);
+    void* weights_f32 = take(static_cast<std::uint64_t>(index_heads) * tokens * 4);
+    void* q_abs = take(static_cast<std::size_t>(heads) * kv_lora * tokens * 4);
+    void* q_abs_bf = take(static_cast<std::size_t>(heads) * kv_lora * tokens * 2);
+    void* attn_out = take(static_cast<std::size_t>(heads) * v_head * tokens * 2);
+    const std::uint32_t completed_total = (first_position + static_cast<std::uint32_t>(tokens)) / kpool;
+    // One reusable score column (each position overwrites its visible prefix).
+    void* scores = take(static_cast<std::size_t>(completed_total ? completed_total : 1) * 4);
+
+    const Tensor norm_weight(const_cast<void*>(w.attn_norm.payload), DType::BF16, {hidden, 1});
+    Tensor normed_t(normed, DType::BF16, {hidden, tokens});
+    ops::rmsnorm(hidden_in, norm_weight, rms_eps, false, normed_t, execution);
+
+    // q side, batched.
+    Tensor q_latent_t(q_latent, DType::BF16, {static_cast<std::int32_t>(q_lora), tokens});
+    ops::linear(normed_t, w.q_a, q_latent_t, execution);
+    const Tensor q_norm_weight(const_cast<void*>(w.q_a_norm.payload), DType::BF16,
+                               {static_cast<std::int32_t>(q_lora), 1});
+    ops::rmsnorm(q_latent_t, q_norm_weight, rms_eps, false, q_latent_t, execution);
+    Tensor q_heads_t(q_heads, DType::BF16,
+                     {static_cast<std::int32_t>(heads * head_dim), tokens});
+    ops::linear(q_latent_t, w.q_b, q_heads_t, execution);
+
+    // kv side, batched; write every token's latent row into the cache.
+    Tensor latent_t(latent, DType::BF16, {static_cast<std::int32_t>(kv_lora), tokens});
+    ops::linear(normed_t, w.kv_a, latent_t, execution);
+    const Tensor kv_norm_weight(const_cast<void*>(w.kv_a_norm.payload), DType::BF16,
+                                {static_cast<std::int32_t>(kv_lora), 1});
+    ops::rmsnorm(latent_t, kv_norm_weight, rms_eps, false, latent_t, execution);
+    {
+        // Strided scatter: destination rows first_position..+T of the cache
+        // (FCD kv_lora), source the batched plane's columns.
+        CUDA_CHECK(cudaMemcpy2DAsync(static_cast<std::uint8_t*>(latents.data) +
+                                         static_cast<std::size_t>(first_position) * kv_lora * 2,
+                                     static_cast<std::size_t>(kv_lora) * 2,   // cache row pitch
+                                     latent, static_cast<std::size_t>(kv_lora) * 2,  // src pitch
+                                     static_cast<std::size_t>(kv_lora) * 2, tokens,
+                                     cudaMemcpyDeviceToDevice, execution));
+    }
+
+    // Indexer planes, batched, then the history scatter.
+    Tensor iq_t(iq, DType::BF16,
+                {static_cast<std::int32_t>(index_heads * index_dim), tokens});
+    ops::linear(q_latent_t, w.indexer_q_b, iq_t, execution);
+    Tensor ik_raw_t(ik_raw, DType::BF16, {static_cast<std::int32_t>(index_dim), tokens});
+    ops::linear(normed_t, w.indexer_k, ik_raw_t, execution);
+    Tensor ik_normed_t(ik_normed, DType::BF16, {static_cast<std::int32_t>(index_dim), tokens});
+    const Tensor ln_w(const_cast<void*>(w.indexer_k_norm_w.payload), DType::BF16,
+                      {static_cast<std::int32_t>(index_dim)});
+    const Tensor ln_b(const_cast<void*>(w.indexer_k_norm_b.payload), DType::BF16,
+                      {static_cast<std::int32_t>(index_dim)});
+    ops::layer_norm(ik_raw_t, ln_w, ln_b, 1e-6f, ik_normed_t, execution);
+    Tensor ig_t(ig, DType::BF16, {static_cast<std::int32_t>(index_dim), tokens});
+    ops::linear(normed_t, w.indexer_gate, ig_t, execution);
+    const std::pair<const void*, Tensor*> scatters[] = {{ik_normed, &ik_plane},
+                                                          {ig, &ig_plane}};
+    for (const auto& scatter : scatters) {
+        CUDA_CHECK(cudaMemcpy2DAsync(
+            static_cast<std::uint8_t*>(scatter.second->data) +
+                static_cast<std::size_t>(first_position) * index_dim * 2,
+            static_cast<std::size_t>(index_dim) * 2, scatter.first,
+            static_cast<std::size_t>(index_dim) * 2, static_cast<std::size_t>(index_dim) * 2,
+            tokens, cudaMemcpyDeviceToDevice, execution));
+    }
+
+    // Head weights are position-DEPENDENT (they project each token's own
+    // hidden), so the batched [IH, T] projection is cast and pre-scaled on
+    // the device; each position then reads its own column.
+    {
+        Tensor weights_t(weights_bf, DType::BF16,
+                         {static_cast<std::int32_t>(index_heads), tokens});
+        ops::linear(normed_t, w.indexer_proj, weights_t, execution);
+        Tensor weights_scaled(weights_f32, DType::FP32,
+                              {static_cast<std::int32_t>(index_heads), tokens});
+        const float scale =
+            std::sqrt(1.0f / (static_cast<float>(index_dim) * index_heads));
+        ops::glm5_cast_bf16_to_f32_scaled(weights_t, scale, weights_scaled, execution.stream());
+    }
+
+    // One pooling pass over every completed pool of the whole visible history.
+    const std::uint32_t total_tokens = first_position + static_cast<std::uint32_t>(tokens);
+    const std::uint32_t completed = total_tokens / kpool;
+    if (completed > 0) {
+        const std::int32_t pool_tokens = static_cast<std::int32_t>(completed) * kpool;
+        Tensor ik_history(ik_plane.data, DType::BF16,
+                          {pool_tokens, static_cast<std::int32_t>(index_dim)});
+        Tensor ig_history(ig_plane.data, DType::BF16,
+                          {pool_tokens, static_cast<std::int32_t>(index_dim)});
+        Tensor pooled_t(pooled.data, DType::FP32,
+                        {static_cast<std::int32_t>(completed),
+                         static_cast<std::int32_t>(index_dim)});
+        ops::glm5_dsa_pool(ik_history, ig_history, indexer_ape, pooled_t, execution.stream());
+    }
+
+    // Per-position selection chain: score over THIS position's visible pools.
+    // q_abs is absorbed batched first (per position it is the small [H, nope]
+    // slice), then cast once for the whole plane.
+    {
+        const auto hsi = static_cast<std::int32_t>(heads);
+        const auto kli = static_cast<std::int32_t>(kv_lora);
+        const auto nli = static_cast<std::int32_t>(head_dim);
+        Tensor q_abs_t(q_abs, DType::FP32, {hsi, kli, tokens});
+        Tensor q_heads_view(q_heads, DType::BF16,
+                            {hsi, nli, tokens});
+        const Tensor wk_b_view(const_cast<void*>(w.wk_b.payload), DType::BF16,
+                               {nli, kli, hsi});
+        ops::glm5_dsa_absorb_batch(q_heads_view, wk_b_view, q_abs_t, execution.stream());
+    }
+    Tensor q_abs_bf_t(q_abs_bf, DType::BF16,
+                      {static_cast<std::int32_t>(heads * kv_lora), tokens});
+    {
+        Tensor q_abs_f32_view(q_abs, DType::FP32,
+                              {static_cast<std::int32_t>(heads * kv_lora), tokens});
+        ops::cast_fp32_to_bf16(q_abs_f32_view, q_abs_bf_t, execution);
+    }
+    for (std::uint32_t t = 0; t < static_cast<std::uint32_t>(tokens); ++t) {
+        const std::uint32_t position = first_position + t;
+        const std::uint32_t visible = (position + 1) / kpool;
+        if (visible > 0) {
+            Tensor pooled_view(pooled.data, DType::FP32,
+                               {static_cast<std::int32_t>(visible),
+                                static_cast<std::int32_t>(index_dim)});
+            Tensor iq_view(static_cast<std::uint8_t*>(iq) +
+                               static_cast<std::size_t>(t) * index_heads * index_dim * 2,
+                           DType::BF16,
+                           {static_cast<std::int32_t>(index_heads),
+                            static_cast<std::int32_t>(index_dim)});
+            Tensor score_t(scores, DType::FP32, {static_cast<std::int32_t>(visible)});
+            Tensor w_view(static_cast<std::uint8_t*>(weights_f32) +
+                              static_cast<std::size_t>(t) * index_heads * 4,
+                          DType::FP32, {static_cast<std::int32_t>(index_heads)});
+            ops::glm5_dsa_score(iq_view, pooled_view, w_view, score_t, execution.stream());
+            ops::glm5_dsa_select(score_t, position, static_cast<std::int32_t>(top_k / kpool),
+                                 true, cells, execution);
+        } else {
+            std::vector<std::int32_t> tail_row(cells.ne[0], -1);
+            for (std::uint32_t m = 0; m + 1 < kpool; ++m) {
+                if (m <= position) { tail_row[top_k + m] = static_cast<std::int32_t>(m); }
+            }
+            CUDA_CHECK(cudaMemcpyAsync(cells.data, tail_row.data(),
+                                       static_cast<std::size_t>(cells.ne[0]) * 4,
+                                       cudaMemcpyHostToDevice, execution));
+        }
+        Tensor q_abs_col(static_cast<std::uint8_t*>(q_abs_bf) +
+                             static_cast<std::size_t>(t) * heads * kv_lora * 2,
+                         DType::BF16,
+                         {static_cast<std::int32_t>(heads),
+                          static_cast<std::int32_t>(kv_lora)});
+        const Tensor wv_b_view(const_cast<void*>(w.wv_b.payload), DType::BF16,
+                               {static_cast<std::int32_t>(kv_lora),
+                                static_cast<std::int32_t>(v_head),
+                                static_cast<std::int32_t>(heads)});
+        Tensor attn_col(static_cast<std::uint8_t*>(attn_out) +
+                            static_cast<std::size_t>(t) * heads * v_head * 2,
+                        DType::BF16, {static_cast<std::int32_t>(heads * v_head), 1});
+        ops::glm5_dsa_attention(q_abs_col, latents, cells, wv_b_view, attn_col,
+                                static_cast<std::int32_t>(head_dim), execution);
+    }
+    Tensor attn_t(attn_out, DType::BF16,
+                  {static_cast<std::int32_t>(heads * v_head), tokens});
+    ops::linear(attn_t, w.wo, block_out, execution);
+}
+
+std::size_t dense_mlp_prefill_scratch_bytes(std::uint32_t hidden, std::uint32_t ffn,
+                                             std::uint32_t tokens) {
+    std::uint64_t bytes = 0;
+    bytes += static_cast<std::uint64_t>(hidden) * tokens * 2 + 15;
+    bytes += (static_cast<std::uint64_t>(ffn) * tokens * 2 + 15) * 3;
+    return static_cast<std::size_t>(bytes + 512);
+}
+
+void dense_mlp_prefill(const DenseMlpWeights& w, const Tensor& hidden_in, float rms_eps,
+                       float swiglu_limit, std::uint32_t ffn, Tensor& out, void* scratch,
+                       const CudaExecutionView& execution) {
+    const std::int32_t hidden = hidden_in.ne[0];
+    const std::int32_t tokens = hidden_in.ne[1];
+    auto* cursor = static_cast<std::uint8_t*>(scratch);
+    auto take = [&](std::size_t bytes) {
+        cursor = reinterpret_cast<std::uint8_t*>(
+            (reinterpret_cast<std::uintptr_t>(cursor) + 15) & ~std::uintptr_t{15});
+        void* result = cursor;
+        cursor += bytes;
+        return result;
+    };
+    void* normed = take(static_cast<std::size_t>(hidden) * tokens * 2);
+    void* gate = take(static_cast<std::size_t>(ffn) * tokens * 2);
+    void* up = take(static_cast<std::size_t>(ffn) * tokens * 2);
+    void* activated = take(static_cast<std::size_t>(ffn) * tokens * 2);
+
+    const Tensor norm_weight(const_cast<void*>(w.ffn_norm.payload), DType::BF16, {hidden, 1});
+    Tensor normed_t(normed, DType::BF16, {hidden, tokens});
+    ops::rmsnorm(hidden_in, norm_weight, rms_eps, false, normed_t, execution);
+    Tensor gate_t(gate, DType::BF16, {static_cast<std::int32_t>(ffn), tokens});
+    Tensor up_t(up, DType::BF16, {static_cast<std::int32_t>(ffn), tokens});
+    ops::linear(normed_t, w.gate, gate_t, execution);
+    ops::linear(normed_t, w.up, up_t, execution);
+    Tensor act_t(activated, DType::BF16, {static_cast<std::int32_t>(ffn), tokens});
+    ops::glm5_swiglu(gate_t, up_t, swiglu_limit, act_t, execution.stream());
+    ops::linear(act_t, w.down, out, execution);
+}
+
+} // namespace ninfer::models::glm5::execution
diff --git a/src/models/glm5/execution/block.h b/src/models/glm5/execution/block.h
new file mode 100644
index 0000000..352e425
--- /dev/null
+++ b/src/models/glm5/execution/block.h
@@ -0,0 +1,217 @@
+#pragma once
+
+// GLM-5.3-Flash single-token block decode assemblies: the KDA mixer block (verified), the
+// DSA mixer block and the dense/MoE MLP blocks. Projections ride the engine's BF16 A16
+// linear path; every mixer piece is a verified ops/glm5_* kernel; each block has a device
+// test chaining the same ops as the oracle with BF16 rounding at every representation
+// boundary. Weight roles follow tools/convert/glm5_tensors.py. The caller owns all
+// persistent state planes.
+
+#include "core/tensor.h"
+#include "core/weight.h"
+
+#include <cstddef>
+#include <cstdint>
+
+// cudaStream_t is an opaque handle in these signatures (the execution
+// backend's stream); the CUDA translation units include the real header.
+
+namespace ninfer {
+// Opaque execution handle (defined in core/device.h); the CUDA
+// translation units include the real header.
+class CudaExecutionView;
+}
+
+namespace ninfer::models::glm5::execution {
+
+// A [N, K] BF16 row-major plane bound as the engine's contiguous A16 Weight.
+// Inline: the GGUF loader and both backend entry points construct it.
+[[nodiscard]] inline Weight bf16_weight(const void* payload, std::int32_t rows,
+                                        std::int32_t columns) {
+    Weight weight{};
+    weight.qtype = QType::BF16;
+    weight.layout = QuantLayout::Contiguous;
+    weight.payload = payload;
+    weight.qdata = payload;
+    weight.payload_bytes = static_cast<std::uint64_t>(rows) * columns * 2;
+    weight.ndim = 2;
+    weight.shape[0] = rows;
+    weight.shape[1] = columns;
+    weight.padded_shape[0] = rows;
+    weight.padded_shape[1] = columns;
+    weight.n = rows;
+    weight.k = columns;
+    return weight;
+}
+
+// ---------------------------------------------------------------------------
+// KDA mixer block
+
+struct KdaBlockWeights {
+    Weight attn_norm;               // [hidden] RMSNorm gamma
+    Weight wq, wk, wv;              // [d_inner, hidden]
+    Weight conv_q, conv_k, conv_v;  // [d_conv, d_inner] (GGUF taps-fastest layout)
+    Weight f_a;                     // [head_dim, hidden]
+    Weight f_b;                     // [d_inner, head_dim]
+    Weight beta;                    // [heads, hidden]
+    Weight g_a;                     // [head_dim, hidden]
+    Weight g_b;                     // [d_inner, head_dim]
+    Weight wo;                      // [hidden, d_inner]
+};
+
+[[nodiscard]] std::size_t kda_block_scratch_bytes(std::uint32_t hidden, std::uint32_t heads,
+                                                  std::uint32_t head_dim);
+
+// Optional test observability: intermediate planes copy out after each stage.
+struct KdaBlockDebug {
+    Tensor* normed = nullptr;
+    Tensor* q_conv = nullptr;
+    Tensor* k_conv = nullptr;
+    Tensor* v_conv = nullptr;
+    Tensor* gate = nullptr;          // FP32 [1, d_inner] log space
+    Tensor* beta = nullptr;          // FP32 [1, heads]
+    Tensor* prefill_out = nullptr;
+    Tensor* gate_pre = nullptr;      // BF16 [1, d_inner]
+    Tensor* beta_logits = nullptr;   // BF16 [1, heads]
+};
+
+void kda_block_decode(const KdaBlockWeights& w, const Tensor& hidden_in, const Tensor& dt_bias,
+                      const Tensor& a_log, const Tensor& o_norm_w, Tensor& conv_q_state,
+                      Tensor& conv_k_state, Tensor& conv_v_state, Tensor& matrix_state,
+                      float gate_lower_bound, std::uint32_t heads, std::uint32_t head_dim,
+                      float rms_eps, Tensor& block_out, void* scratch, const CudaExecutionView& execution,
+                      KdaBlockDebug* debug = nullptr);
+
+// ---------------------------------------------------------------------------
+// DSA mixer block (NoPE MLA + k-pool indexer, single token)
+
+struct DsaBlockWeights {
+    Weight attn_norm;        // [hidden] RMSNorm gamma
+    Weight q_a;              // [q_lora, hidden]
+    Weight q_a_norm;         // [q_lora] RMSNorm gamma
+    Weight q_b;              // [heads*qk_nope, q_lora]
+    Weight kv_a;             // [kv_lora, hidden]
+    Weight kv_a_norm;        // [kv_lora] RMSNorm gamma
+    Weight wk_b;             // GGUF {qk_nope, kv_lora, heads}
+    Weight wv_b;             // GGUF {kv_lora, v_head, heads}
+    Weight wo;               // [hidden, heads*v_head]
+    Weight indexer_q_b;      // [index_heads*index_dim, q_lora]
+    Weight indexer_k;        // [index_dim, hidden]
+    Weight indexer_k_norm_w; // [index_dim] LayerNorm gamma (BF16)
+    Weight indexer_k_norm_b; // [index_dim] LayerNorm beta (BF16)
+    Weight indexer_gate;     // [index_dim, hidden]
+    Weight indexer_proj;     // [index_heads, hidden]
+};
+
+[[nodiscard]] std::size_t dsa_block_scratch_bytes(std::uint32_t hidden, std::uint32_t heads,
+                                                  std::uint32_t head_dim, std::uint32_t q_lora,
+                                                  std::uint32_t kv_lora, std::uint32_t v_head,
+                                                  std::uint32_t index_heads,
+                                                  std::uint32_t index_dim,
+                                                  std::uint32_t kpool, std::uint32_t position);
+
+// One token: norm -> q_a/norm/q_b/absorb; kv_a/norm latent written to `latents` row
+// `position`; the indexer's LayerNorm'd key and pool gate appended to the [position+1,
+// index_dim] planes; pools recomputed over the whole plane (the decode path re-pools
+// every completed pool for correctness - incremental re-pooling is a later optimization);
+// score, select, absorbed attention, wo. `pooled` is FP32 [completed_pools, index_dim]
+// (fully rewritten), `cells` Int32 [selection_width] output. `index_scale` is the caller's
+// 1/sqrt(index_dim*index_heads) factor applied to the head weights before the score op.
+void dsa_block_decode(const DsaBlockWeights& w, const Tensor& hidden_in,
+                      const Tensor& indexer_ape, Tensor& latents, Tensor& ik_plane,
+                      Tensor& ig_plane, Tensor& pooled, Tensor& cells, std::uint32_t position,
+                      float rms_eps, std::uint32_t heads, std::uint32_t head_dim,
+                      std::uint32_t q_lora, std::uint32_t kv_lora, std::uint32_t v_head,
+                      std::uint32_t index_heads, std::uint32_t index_dim, std::uint32_t kpool,
+                      std::uint32_t top_k, Tensor& block_out, void* scratch, const CudaExecutionView& execution);
+
+// ---------------------------------------------------------------------------
+// MLP blocks
+
+struct DenseMlpWeights {
+    Weight ffn_norm;   // [hidden]
+    Weight gate;       // [ffn, hidden]
+    Weight up;         // [ffn, hidden]
+    Weight down;       // [hidden, ffn]
+};
+
+struct MoeBlockWeights {
+    Weight ffn_norm;      // [hidden]
+    Weight router;        // [experts, hidden]
+    Weight gate_exps;     // [experts*ffn, hidden]
+    Weight up_exps;       // [experts*ffn, hidden]
+    Weight down_exps;     // [experts*hidden, ffn] per-expert row blocks stacked
+    Weight gate_shexp;    // [ffn, hidden]
+    Weight up_shexp;      // [ffn, hidden]
+    Weight down_shexp;    // [hidden, ffn]
+};
+
+[[nodiscard]] std::size_t dense_mlp_scratch_bytes(std::uint32_t hidden, std::uint32_t ffn);
+[[nodiscard]] std::size_t moe_block_scratch_bytes(std::uint32_t hidden, std::uint32_t ffn,
+                                                  std::uint32_t experts, std::uint32_t top_k);
+
+// norm -> gate/up -> clamped SwiGLU -> down. `hidden_in` BF16 [hidden,1], `out` BF16 [hidden,1].
+void dense_mlp_decode(const DenseMlpWeights& w, const Tensor& hidden_in, float rms_eps,
+                      float swiglu_limit, std::uint32_t ffn, Tensor& out, void* scratch,
+                      const CudaExecutionView& execution);
+
+// norm -> router -> sigmoid/noaux_tc top-k -> per-expert gate/up/SwiGLU/down (the decode
+// path runs the selected experts sequentially through the plain linear op) -> weighted
+// combine plus the unweighted shared expert. `router_bias` is FP32 [experts].
+void moe_block_decode(const MoeBlockWeights& w, const Tensor& hidden_in, const Tensor& router_bias,
+                      float rms_eps, float swiglu_limit, float routed_scaling_factor,
+                      std::uint32_t experts, std::uint32_t top_k, std::uint32_t ffn, Tensor& out,
+                      void* scratch, const CudaExecutionView& execution);
+
+// ---------------------------------------------------------------------------
+// Batched (chunked) prefill executors: the same math as the decode path over
+// whole [*, T] planes. KDA runs conv/gating/chunk-scan/output-gate batched;
+// DSA batches the projections, latent/indexer writes, and pooling, then runs
+// the per-position selection/attention chain (its semantics depend on each
+// query's visible prefix). The MLP blocks: dense is fully batched, MoE
+// reuses the single-token executor per token (grouped expert GEMM is the
+// follow-up throughput path).
+
+[[nodiscard]] std::size_t kda_block_prefill_scratch_bytes(std::uint32_t hidden,
+                                                          std::uint32_t heads,
+                                                          std::uint32_t head_dim,
+                                                          std::uint32_t tokens);
+
+void kda_block_prefill(const KdaBlockWeights& w, const Tensor& hidden_in,
+                       const Tensor& dt_bias, const Tensor& a_log, const Tensor& o_norm_w,
+                       Tensor& conv_q_state, Tensor& conv_k_state, Tensor& conv_v_state,
+                       Tensor& matrix_state, float gate_lower_bound, std::uint32_t heads,
+                       std::uint32_t head_dim, float rms_eps, std::uint32_t chunk,
+                       Tensor& block_out, void* scratch, const CudaExecutionView& execution);
+
+[[nodiscard]] std::size_t dsa_block_prefill_scratch_bytes(std::uint32_t hidden, std::uint32_t heads,
+                                                          std::uint32_t head_dim,
+                                                          std::uint32_t q_lora,
+                                                          std::uint32_t kv_lora,
+                                                          std::uint32_t v_head,
+                                                          std::uint32_t index_heads,
+                                                          std::uint32_t index_dim,
+                                                          std::uint32_t kpool,
+                                                          std::uint32_t selection_width,
+                                                          std::uint32_t tokens,
+                                                          std::uint32_t first_position);
+
+void dsa_block_prefill(const DsaBlockWeights& w, const Tensor& hidden_in,
+                       const Tensor& indexer_ape, Tensor& latents, Tensor& ik_plane,
+                       Tensor& ig_plane, Tensor& pooled, Tensor& cells,
+                       std::uint32_t first_position, float rms_eps, std::uint32_t heads,
+                       std::uint32_t head_dim, std::uint32_t q_lora, std::uint32_t kv_lora,
+                       std::uint32_t v_head, std::uint32_t index_heads,
+                       std::uint32_t index_dim, std::uint32_t kpool, std::uint32_t top_k,
+                       Tensor& block_out, void* scratch, const CudaExecutionView& execution);
+
+[[nodiscard]] std::size_t dense_mlp_prefill_scratch_bytes(std::uint32_t hidden,
+                                                          std::uint32_t ffn,
+                                                          std::uint32_t tokens);
+
+void dense_mlp_prefill(const DenseMlpWeights& w, const Tensor& hidden_in, float rms_eps,
+                       float swiglu_limit, std::uint32_t ffn, Tensor& out, void* scratch,
+                       const CudaExecutionView& execution);
+
+
+} // namespace ninfer::models::glm5::execution
diff --git a/src/models/glm5/execution/gguf_file.cpp b/src/models/glm5/execution/gguf_file.cpp
new file mode 100644
index 0000000..b47148c
--- /dev/null
+++ b/src/models/glm5/execution/gguf_file.cpp
@@ -0,0 +1,248 @@
+// Minimal standalone GGUF reader — implementation. See gguf_file.h.
+#include "models/glm5/execution/gguf_file.h"
+
+#include <array>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+namespace ninfer::models::glm5::execution {
+namespace {
+
+// ggml_type codes (ggml.h); only the element types travel through this
+// reader — block quants stay on the device dequant path.
+constexpr std::uint32_t kTypeF32 = 0, kTypeF16 = 1, kTypeI8 = 24, kTypeI16 = 25,
+                         kTypeI32 = 26, kTypeF64 = 28, kTypeBF16 = 30;
+// gguf_metadata_value_type codes.
+constexpr std::uint32_t kMetaU32 = 4, kMetaString = 8, kMetaArray = 9, kMetaU64 = 10;
+
+[[nodiscard]] std::uint64_t element_size(std::uint32_t ggml_type) {
+    switch (ggml_type) {
+    case kTypeF32: return 4;
+    case kTypeF16: return 2;
+    case kTypeI8: return 1;
+    case kTypeI16: return 2;
+    case kTypeI32: return 4;
+    case kTypeF64: return 8;
+    case kTypeBF16: return 2;
+    default:
+        throw std::runtime_error("gguf_file: block-quant tensor needs the device dequant path");
+    }
+}
+
+float decode_f16(std::uint16_t bits) {
+    const std::uint32_t sign = (bits >> 15) & 1u, exponent = (bits >> 10) & 0x1fu,
+                       mantissa = bits & 0x3ffu;
+    if (exponent == 0) return (sign ? -1.0f : 1.0f) * 6.103515625e-05f * (mantissa / 1024.0f);
+    if (exponent == 31) return mantissa ? std::numeric_limits<float>::quiet_NaN()
+                                        : (sign ? -std::numeric_limits<float>::infinity()
+                                                : std::numeric_limits<float>::infinity());
+    const std::uint32_t assembled = (sign << 31) | ((exponent + 112) << 23) | (mantissa << 13);
+    float value;
+    std::memcpy(&value, &assembled, 4);
+    return value;
+}
+
+} // namespace
+
+std::uint16_t round_bf16_bits(float value) {
+    std::uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return static_cast<std::uint16_t>(bits >> 16);
+}
+
+GgufFile::GgufFile(const std::string& path) : file_(path, std::ios::binary) {
+    if (!file_) throw std::runtime_error("gguf_file: cannot open " + path);
+    parse_header();
+}
+
+void GgufFile::parse_header() {
+    std::array<char, 4> magic{};
+    file_.read(magic.data(), 4);
+    if (!file_ || std::memcmp(magic.data(), "GGUF", 4) != 0) {
+        throw std::runtime_error("gguf_file: bad magic");
+    }
+    std::uint32_t version = 0;
+    file_.read(reinterpret_cast<char*>(&version), 4);
+    if (!file_ || (version != 2 && version != 3)) {
+        throw std::runtime_error("gguf_file: unsupported version");
+    }
+    version_ = version;
+    std::uint64_t tensor_count = 0, kv_count = 0;
+    file_.read(reinterpret_cast<char*>(&tensor_count), 8);
+    file_.read(reinterpret_cast<char*>(&kv_count), 8);
+    if (!file_ || tensor_count > (1ull << 24) || kv_count > (1ull << 20)) {
+        throw std::runtime_error("gguf_file: implausible header counts");
+    }
+    for (std::uint64_t i = 0; i < kv_count; ++i) parse_metadata_entry();
+
+    infos_.resize(static_cast<std::size_t>(tensor_count));
+    for (auto& info : infos_) {
+        info.name = read_string();
+        file_.read(reinterpret_cast<char*>(&info.n_dims), 4);
+        if (!file_ || info.n_dims == 0 || info.n_dims > 4) {
+            throw std::runtime_error("gguf_file: bad dimension count for " + info.name);
+        }
+        for (std::uint32_t d = 0; d < info.n_dims; ++d)
+            file_.read(reinterpret_cast<char*>(&info.ne[d]), 8);
+        file_.read(reinterpret_cast<char*>(&info.ggml_type), 4);
+        file_.read(reinterpret_cast<char*>(&info.offset), 8);
+        if (!file_) throw std::runtime_error("gguf_file: truncated tensor info for " + info.name);
+        for (std::uint32_t d = 0; d < info.n_dims; ++d) {
+            if (info.ne[d] == 0) throw std::runtime_error("gguf_file: zero extent for " + info.name);
+        }
+    }
+    // The data section starts at the next alignment boundary after the directory.
+    const auto position = static_cast<std::uint64_t>(file_.tellg());
+    const std::uint64_t misalignment = position % alignment_;
+    data_start_ = misalignment ? position + (alignment_ - misalignment) : position;
+}
+
+void GgufFile::parse_metadata_entry() {
+    const std::string key = read_string();
+    std::uint32_t type = 0;
+    file_.read(reinterpret_cast<char*>(&type), 4);
+    if (!file_) throw std::runtime_error("gguf_file: truncated metadata entry");
+    const auto skip_scalar = [&](std::uint64_t bytes) { file_.ignore(static_cast<std::streamsize>(bytes)); };
+    switch (type) {
+    case 0: case 1: skip_scalar(1); break;               // u8 / i8
+    case 2: case 3: skip_scalar(2); break;               // u16 / i16
+    case 4: case 5: skip_scalar(4); break;               // u32 / i32
+    case 6: skip_scalar(4); break;                       // f32
+    case 7: skip_scalar(1); break;                       // bool
+    case 8: static_cast<void>(read_string()); break;     // string
+    case 10: case 11: skip_scalar(8); break;             // u64 / i64
+    case 12: skip_scalar(8); break;                      // f64
+    case kMetaArray: {
+        std::uint32_t element_type = 0;
+        std::uint64_t count = 0;
+        file_.read(reinterpret_cast<char*>(&element_type), 4);
+        file_.read(reinterpret_cast<char*>(&count), 8);
+        if (!file_ || count > (1ull << 28)) throw std::runtime_error("gguf_file: bad array size");
+        if (element_type == kMetaString) {
+            for (std::uint64_t i = 0; i < count; ++i) static_cast<void>(read_string());
+        } else if (element_type == kMetaArray) {
+            throw std::runtime_error("gguf_file: nested metadata arrays");
+        } else {
+            std::uint64_t width = 1;
+            if (element_type >= 2 && element_type <= 6) width = element_type == 2 || element_type == 3 ? 2 : 4;
+            else if (element_type >= 10) width = 8;
+            file_.ignore(static_cast<std::streamsize>(count * width));
+        }
+        break;
+    }
+    default:
+        throw std::runtime_error("gguf_file: unknown metadata value type");
+    }
+    if (!file_) throw std::runtime_error("gguf_file: truncated metadata value for " + key);
+    // The alignment key is the only metadata the reader itself needs.
+    if (key == "general.alignment" && type == kMetaU32) {
+        // Re-read: the scalar was skipped above; rewind over it.
+        file_.seekg(-4, std::ios::cur);
+        file_.read(reinterpret_cast<char*>(&alignment_), 4);
+        if (alignment_ == 0 || (alignment_ & (alignment_ - 1)) != 0) {
+            throw std::runtime_error("gguf_file: general.alignment must be a positive power of two");
+        }
+        // data_start_ is computed after the whole directory; the updated
+        // alignment applies from this file's data section onward.
+    }
+}
+
+std::string GgufFile::read_string() {
+    std::uint64_t length = 0;
+    file_.read(reinterpret_cast<char*>(&length), 8);
+    if (!file_ || length > (1ull << 22)) throw std::runtime_error("gguf_file: bad string length");
+    std::string value(static_cast<std::size_t>(length), '\0');
+    if (length) file_.read(value.data(), static_cast<std::streamsize>(length));
+    if (!file_) throw std::runtime_error("gguf_file: truncated string");
+    return value;
+}
+
+const GgufTensorInfo* GgufFile::find(const std::string& name) const {
+    for (const auto& info : infos_)
+        if (info.name == name) return &info;
+    return nullptr;
+}
+
+std::uint64_t GgufFile::tensor_bytes(const GgufTensorInfo& tensor) const {
+    std::uint64_t elements = 1;
+    for (std::uint32_t d = 0; d < tensor.n_dims; ++d) elements *= tensor.ne[d];
+    return elements * element_size(tensor.ggml_type);
+}
+
+void GgufFile::seek_tensor(const GgufTensorInfo& tensor, std::uint64_t bytes) {
+    file_.clear();
+    file_.seekg(static_cast<std::streamoff>(data_start_ + tensor.offset));
+    if (!file_) throw std::runtime_error("gguf_file: seek failed for " + tensor.name);
+    const auto usable = tensor_bytes(tensor);
+    if (bytes > usable) throw std::runtime_error("gguf_file: read past tensor end for " + tensor.name);
+}
+
+std::vector<std::uint16_t> GgufFile::read_bf16(const GgufTensorInfo& tensor) {
+    std::uint64_t elements = 1;
+    for (std::uint32_t d = 0; d < tensor.n_dims; ++d) elements *= tensor.ne[d];
+    std::vector<std::uint16_t> plane(static_cast<std::size_t>(elements));
+    seek_tensor(tensor, tensor_bytes(tensor));
+    switch (tensor.ggml_type) {
+    case kTypeBF16:
+        file_.read(reinterpret_cast<char*>(plane.data()),
+                   static_cast<std::streamsize>(elements * 2));
+        break;
+    case kTypeF32: {
+        std::vector<float> raw(static_cast<std::size_t>(elements));
+        file_.read(reinterpret_cast<char*>(raw.data()),
+                   static_cast<std::streamsize>(elements * 4));
+        for (std::size_t i = 0; i < raw.size(); ++i) plane[i] = round_bf16_bits(raw[i]);
+        break;
+    }
+    case kTypeF16: {
+        std::vector<std::uint16_t> raw(static_cast<std::size_t>(elements));
+        file_.read(reinterpret_cast<char*>(raw.data()),
+                   static_cast<std::streamsize>(elements * 2));
+        for (std::size_t i = 0; i < raw.size(); ++i) plane[i] = round_bf16_bits(decode_f16(raw[i]));
+        break;
+    }
+    case kTypeI8: {
+        std::vector<std::int8_t> raw(static_cast<std::size_t>(elements));
+        file_.read(reinterpret_cast<char*>(raw.data()), static_cast<std::streamsize>(elements));
+        for (std::size_t i = 0; i < raw.size(); ++i) plane[i] = round_bf16_bits(float(raw[i]));
+        break;
+    }
+    case kTypeI16: {
+        std::vector<std::int16_t> raw(static_cast<std::size_t>(elements));
+        file_.read(reinterpret_cast<char*>(raw.data()),
+                   static_cast<std::streamsize>(elements * 2));
+        for (std::size_t i = 0; i < raw.size(); ++i) plane[i] = round_bf16_bits(float(raw[i]));
+        break;
+    }
+    case kTypeI32: {
+        std::vector<std::int32_t> raw(static_cast<std::size_t>(elements));
+        file_.read(reinterpret_cast<char*>(raw.data()),
+                   static_cast<std::streamsize>(elements * 4));
+        for (std::size_t i = 0; i < raw.size(); ++i) plane[i] = round_bf16_bits(float(raw[i]));
+        break;
+    }
+    default:
+        throw std::runtime_error("gguf_file: unsupported source type for BF16 conversion");
+    }
+    if (!file_) throw std::runtime_error("gguf_file: truncated payload for " + tensor.name);
+    return plane;
+}
+
+std::vector<float> GgufFile::read_f32(const GgufTensorInfo& tensor) {
+    if (tensor.ggml_type != kTypeF32) {
+        throw std::runtime_error("gguf_file: read_f32 requires an F32 tensor");
+    }
+    std::uint64_t elements = 1;
+    for (std::uint32_t d = 0; d < tensor.n_dims; ++d) elements *= tensor.ne[d];
+    std::vector<float> plane(static_cast<std::size_t>(elements));
+    seek_tensor(tensor, elements * 4);
+    file_.read(reinterpret_cast<char*>(plane.data()),
+               static_cast<std::streamsize>(elements * 4));
+    if (!file_) throw std::runtime_error("gguf_file: truncated payload for " + tensor.name);
+    return plane;
+}
+
+} // namespace ninfer::models::glm5::execution
diff --git a/src/models/glm5/execution/gguf_file.h b/src/models/glm5/execution/gguf_file.h
new file mode 100644
index 0000000..ad43ce9
--- /dev/null
+++ b/src/models/glm5/execution/gguf_file.h
@@ -0,0 +1,69 @@
+#pragma once
+
+// Minimal standalone GGUF file reader for the GLM-5.3-Flash direct GGUF path
+// (no ggml/llama.cpp dependency): header, metadata keys the loader needs,
+// the tensor directory, and payload reads that convert supported element
+// types to BF16 host planes or raw FP32. Pure host code — no CUDA, no
+// SynapseAI — so it builds and tests everywhere the engine's host tests do.
+//
+// Format reference: ggml's gguf.h (v2/v3). ne[0] is the row width (innermost
+// axis); a [rows, cols] engine plane maps to ne[0] == cols, ne[1] == rows.
+
+#include <cstddef>
+#include <cstdint>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace ninfer::models::glm5::execution {
+
+struct GgufTensorInfo {
+    std::string name;
+    std::uint32_t n_dims = 0;
+    std::uint64_t ne[4] = {0, 1, 1, 1};  // GGUF order; ne[0] = row width
+    std::uint32_t ggml_type = 0;
+    std::uint64_t offset = 0;            // relative to the data section
+};
+
+class GgufFile {
+public:
+    // Parses the header, metadata, and tensor directory; validates magic,
+    // version (2|3), and the directory's self-consistency. Throws
+    // std::runtime_error on any structural problem.
+    explicit GgufFile(const std::string& path);
+
+    [[nodiscard]] const GgufTensorInfo* find(const std::string& name) const;
+    [[nodiscard]] const std::vector<GgufTensorInfo>& tensors() const noexcept { return infos_; }
+    [[nodiscard]] std::uint32_t alignment() const noexcept { return alignment_; }
+    [[nodiscard]] std::uint64_t version() const noexcept { return version_; }
+
+    // Bytes one tensor occupies in the file (valid for the element types
+    // element_size supports; throws for block-quant types).
+    [[nodiscard]] std::uint64_t tensor_bytes(const GgufTensorInfo& tensor) const;
+
+    // Reads the tensor payload and converts to a BF16 host plane,
+    // row-major [rows(), cols()] (rows = ne[1], cols = ne[0]). Supported
+    // source types: F32, BF16, F16, I8, I16, I32; block-quant types throw
+    // (the CUDA dequant bridge covers those on the device path).
+    [[nodiscard]] std::vector<std::uint16_t> read_bf16(const GgufTensorInfo& tensor);
+
+    // Reads a raw FP32 plane (F32 tensors only).
+    [[nodiscard]] std::vector<float> read_f32(const GgufTensorInfo& tensor);
+
+private:
+    void parse_header();
+    void parse_metadata_entry();
+    [[nodiscard]] std::string read_string();
+    void seek_tensor(const GgufTensorInfo& tensor, std::uint64_t bytes);
+
+    std::ifstream file_;
+    std::uint64_t version_ = 0;
+    std::uint32_t alignment_ = 32;
+    std::uint64_t data_start_ = 0;
+    std::vector<GgufTensorInfo> infos_;
+};
+
+// Round-to-nearest-even FP32 -> BF16 (the engine's boundary convention).
+[[nodiscard]] std::uint16_t round_bf16_bits(float value);
+
+} // namespace ninfer::models::glm5::execution
diff --git a/src/models/glm5/execution/gguf_loader.cpp b/src/models/glm5/execution/gguf_loader.cpp
new file mode 100644
index 0000000..9c0dd15
--- /dev/null
+++ b/src/models/glm5/execution/gguf_loader.cpp
@@ -0,0 +1,78 @@
+// GLM-5.3-Flash GGUF loader, CUDA backend: allocates every plane with
+// cudaMalloc, registers each success in the returned free list, and frees
+// everything that already landed if the walk fails mid-model (review R5).
+#include "models/glm5/execution/gguf_loader.h"
+
+// The CUDA runtime functions this TU calls arrive as extern declarations -
+// this file never includes the CUDA headers, so there is nothing to clash
+// with on either build.
+using cudaError_t = int;
+constexpr cudaError_t cudaSuccess = 0;
+extern "C" {
+cudaError_t cudaMalloc(void** dev, unsigned long long size);
+cudaError_t cudaMemcpy(void* dest, const void* src, unsigned long long size, int kind);
+cudaError_t cudaFree(void* dev);
+const char* cudaGetErrorString(cudaError_t error);
+}
+constexpr int cudaMemcpyHostToDevice = 1;
+
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ninfer::models::glm5::execution {
+namespace {
+
+void cuda_check(cudaError_t error, const char* what) {
+    if (error != cudaSuccess) {
+        throw std::runtime_error(std::string("gguf_loader: ") + what + ": " +
+                                 cudaGetErrorString(error));
+    }
+}
+
+[[nodiscard]] float bf16_to_f32(std::uint16_t bits) {
+    const std::uint32_t wide = static_cast<std::uint32_t>(bits) << 16;
+    float value;
+    std::memcpy(&value, &wide, 4);
+    return value;
+}
+
+} // namespace
+
+GgufWeightBuffers::~GgufWeightBuffers() {
+    for (void* plane : device_planes) (void)cudaFree(plane);
+}
+
+GgufWeightBuffers load_gguf_weights(const std::string& path, Glm5ModelWeights& weights,
+                                    const Glm5StepConfig& config) {
+    GgufFile gguf(path);
+    // Every successful allocation joins the free list the returned buffers
+    // own; a mid-walk failure frees what already landed before rethrowing,
+    // so neither path leaks.
+    std::vector<void*> planes;
+    auto cuda_upload = [&planes](const void* host, std::size_t bytes) -> void* {
+        void* device = nullptr;
+        cuda_check(cudaMalloc(&device, bytes), "cudaMalloc");
+        try {
+            cuda_check(cudaMemcpy(device, host, bytes, cudaMemcpyHostToDevice),
+                       "cudaMemcpy");
+        } catch (...) {
+            cudaFree(device);
+            throw;
+        }
+        planes.push_back(device);
+        return device;
+    };
+    try {
+        detail::load_gguf_walk(gguf, weights, config, cuda_upload);
+    } catch (...) {
+        for (void* plane : planes) cudaFree(plane);
+        throw;
+    }
+    GgufWeightBuffers buffers;
+    buffers.device_planes = std::move(planes);
+    return buffers;
+}
+
+} // namespace ninfer::models::glm5::execution
diff --git a/src/models/glm5/execution/gguf_loader.h b/src/models/glm5/execution/gguf_loader.h
new file mode 100644
index 0000000..8f3a225
--- /dev/null
+++ b/src/models/glm5/execution/gguf_loader.h
@@ -0,0 +1,88 @@
+#pragma once
+
+// GLM-5.3-Flash GGUF loader: reads a llama.cpp GGUF file and binds every tensor
+// to the Glm5ModelWeights structure, uploading BF16 planes to the device. This
+// is the direct GGUF→GPU path that bypasses the artifact format entirely; the
+// artifact converter (tools/convert/glm5_tensors.py) covers the same mapping
+// for the persistent format. The tensor role names are identical.
+//
+// Two device backends share the tensor-name binding and geometry validation:
+//   - CUDA (the original engine backend; cudaMalloc/cudaMemcpy)
+//   - Gaudi2 (pinned staging + DMA upload through the SynapseAI runtime
+//     adapter; gap-3's HPU weight residency)
+// The file reader itself is gguf_file.h (pure host, standalone-testable).
+
+#include "models/glm5/execution/gguf_file.h"
+#include "models/glm5/execution/model.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace ninfer::models::glm5::execution {
+
+// The owning device allocations behind a loaded model (keep alive as long as
+// the weights are used).
+struct GgufWeightBuffers {
+    std::vector<void*> device_planes;
+    ~GgufWeightBuffers();
+    GgufWeightBuffers() = default;
+    GgufWeightBuffers(const GgufWeightBuffers&) = delete;
+    GgufWeightBuffers& operator=(const GgufWeightBuffers&) = delete;
+    GgufWeightBuffers(GgufWeightBuffers&&) noexcept = default;
+    GgufWeightBuffers& operator=(GgufWeightBuffers&&) noexcept = default;
+};
+
+// Loads a GGUF file, validates every GLM5 tensor is present with the expected
+// geometry, converts to BF16 where needed, uploads to the CUDA device, and
+// binds into Glm5ModelWeights (BF16 planes) plus the FP32 scalar planes (KDA
+// dt_bias/a_log/o_norm, DSA ape, MoE router bias). `config` provides the
+// expected geometry and the per-layer mixer/MLP kinds. Throws
+// std::runtime_error on any mismatch; the state stays caller-owned.
+[[nodiscard]] GgufWeightBuffers load_gguf_weights(const std::string& path,
+                                                  Glm5ModelWeights& weights,
+                                                  const Glm5StepConfig& config);
+
+} // namespace ninfer::models::glm5::execution
+
+namespace ninfer::gaudi2 {
+class Device;
+class Stream;
+class Glm5HpuWeightPlanes;
+} // namespace ninfer::gaudi2
+
+namespace ninfer::models::glm5::execution {
+
+// The Gaudi2 HPU variant: identical binding, but every plane lands in HBM
+// exactly once through the caller's Glm5HpuWeightPlanes registry (pinned
+// staging + DMA). The registry owns the DeviceBuffers for the weights'
+// lifetime; block executors bind them by payload address. There is no
+// returned buffer set on this path.
+void load_gguf_weights_hpu(const std::string& path, Glm5ModelWeights& weights,
+                           const Glm5StepConfig& config, gaudi2::Device& device,
+                           gaudi2::Stream& stream,
+                           gaudi2::Glm5HpuWeightPlanes& planes);
+
+// The device-coupled step: allocate on the device, copy the host plane,
+// and register the allocation for teardown (returned pointer).
+using PlaneUploader = void* (*)(const void* host, std::size_t bytes,
+                                void* context);
+
+// One tensor walk shared by both backends: opens the file, validates
+// geometry, converts dtypes, uploads each plane through `upload`, and
+// binds into `weights`. The CUDA and Gaudi2 entry points below call this
+// with their own uploader; it lives in the header so both translation
+// units instantiate it with their lambda types.
+namespace detail {
+// Binds every tensor through `upload_plane`; returns nothing - the calling
+// backend owns its allocations (the CUDA entry's free list, the Gaudi2
+// registry).
+void load_gguf_walk(GgufFile& gguf, Glm5ModelWeights& weights,
+                    const Glm5StepConfig& config,
+                    const std::function<void*(const void*, std::size_t)>& upload_plane);
+} // namespace detail
+
+} // namespace ninfer::models::glm5::execution
diff --git a/src/models/glm5/execution/gguf_walk.cpp b/src/models/glm5/execution/gguf_walk.cpp
new file mode 100644
index 0000000..154b80b
--- /dev/null
+++ b/src/models/glm5/execution/gguf_walk.cpp
@@ -0,0 +1,215 @@
+// GLM-5.3-Flash GGUF tensor walk - the backend-neutral half of the loader.
+// This translation unit carries no CUDA declarations: both backends (CUDA
+// gguf_loader.cpp, Gaudi2 gguf_loader_hpu.cpp) drive detail::load_gguf_walk
+// through their own plane uploaders (review R1's shared-walk split).
+#include "models/glm5/execution/gguf_loader.h"
+
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ninfer::models::glm5::execution {
+namespace {
+
+[[nodiscard]] float bf16_to_f32(std::uint16_t bits) {
+    const std::uint32_t wide = static_cast<std::uint32_t>(bits) << 16;
+    float value;
+    std::memcpy(&value, &wide, 4);
+    return value;
+}
+
+// Binds one GGUF tensor as a BF16 Weight with the expected [rows, cols]
+// geometry (GGUF ne[0] == cols, ne[1] == rows; a vector is [rows, 1] with
+// ne[0] == rows).
+// The plane uploader is the only device-coupled step: CUDA allocates and
+// copies; the Gaudi2 path stages through pinned memory and a DMA stream.
+// Both return the device pointer and register it in the buffers.
+struct Binder {
+    GgufFile& gguf;
+    const std::function<void*(const void*, std::size_t)>& upload_plane;
+
+    [[nodiscard]] Weight bf16(const std::string& name, std::uint64_t rows, std::uint64_t cols) {
+        const GgufTensorInfo* tensor = gguf.find(name);
+        if (!tensor) throw std::runtime_error("gguf_loader: missing tensor " + name);
+        const bool vector_shape = rows == tensor->ne[0] && cols == 1 && tensor->ne[1] == 1;
+        if (!((tensor->ne[0] == cols && tensor->ne[1] == rows) || vector_shape)) {
+            throw std::runtime_error("gguf_loader: geometry mismatch for " + name);
+        }
+        std::vector<std::uint16_t> plane = gguf.read_bf16(*tensor);
+        void* device = upload_plane(plane.data(), plane.size() * 2);
+        // bf16_weight fills the full engine contract (layout, n/k, qdata,
+        // padded shapes); a bare payload+shape Weight is rejected by
+        // embedding/linear.
+        return bf16_weight(device, static_cast<std::int32_t>(rows),
+                           static_cast<std::int32_t>(vector_shape ? 1 : cols));
+    }
+
+    // Binds by the tensor's own stored geometry (higher-rank planes like
+    // wk_b {nope, lora, heads} and the conv taps whose kernel width the
+    // step config does not carry).
+    [[nodiscard]] Weight bf16_raw(const std::string& name) {
+        const GgufTensorInfo* tensor = gguf.find(name);
+        if (!tensor) throw std::runtime_error("gguf_loader: missing tensor " + name);
+        std::vector<std::uint16_t> plane = gguf.read_bf16(*tensor);
+        // GGUF ne[0] is the stored FCD (row width); bind row-major.
+        std::int64_t elements = 1;
+        std::int64_t width = static_cast<std::int64_t>(tensor->ne[0]);
+        for (std::uint32_t d = 0; d < tensor->n_dims; ++d) elements *= tensor->ne[d];
+        void* device = upload_plane(plane.data(), plane.size() * 2);
+        return bf16_weight(device, static_cast<std::int32_t>(elements / (width ? width : 1)),
+                           static_cast<std::int32_t>(width));
+    }
+
+    // FP32 scalar plane on the device (accepts F32 directly or a BF16 source
+    // widened losslessly).
+    [[nodiscard]] const void* f32(const std::string& name, std::uint64_t count) {
+        const GgufTensorInfo* tensor = gguf.find(name);
+        if (!tensor) throw std::runtime_error("gguf_loader: missing tensor " + name);
+        std::vector<float> plane;
+        if (tensor->ggml_type == 0 /*F32*/) {
+            plane = gguf.read_f32(*tensor);
+        } else if (tensor->ggml_type == 30 /*BF16*/) {
+            const auto raw = gguf.read_bf16(*tensor);
+            plane.reserve(raw.size());
+            for (const auto bits : raw) plane.push_back(bf16_to_f32(bits));
+        } else {
+            throw std::runtime_error("gguf_loader: scalar plane " + name + " is not F32/BF16");
+        }
+        if (plane.size() != count) {
+            throw std::runtime_error("gguf_loader: scalar count mismatch for " + name);
+        }
+        return upload_plane(plane.data(), plane.size() * 4);
+    }
+};
+
+} // namespace
+
+// Shared tensor walk (declared in the header): identical binding for both
+// backends.
+void detail::load_gguf_walk(GgufFile& gguf, Glm5ModelWeights& weights,
+                           const Glm5StepConfig& config,
+                           const std::function<void*(const void*, std::size_t)>& upload_plane) {
+    Binder binder{gguf, upload_plane};
+
+    const std::uint32_t layers = static_cast<std::uint32_t>(config.layer_is_dsa.size());
+    if (layers == 0 || config.layer_mlp_dense.size() != layers) {
+        throw std::runtime_error("gguf_loader: config layer kinds must be parallel and non-empty");
+    }
+    const std::uint32_t d_inner = config.kda_heads * config.kda_head_dim;
+    const std::uint32_t index_heads = config.index_heads, index_dim = config.index_dim;
+    const std::uint32_t heads = config.heads, nope = config.head_dim;
+    const std::uint32_t q_lora = config.q_lora, kv_lora = config.kv_lora, v_head = config.v_head;
+    const std::uint32_t hidden = config.hidden;
+
+    weights = Glm5ModelWeights{};
+    // FP32 scalar planes ride in Weight slots as raw carriers (the scheduler
+    // builds FP32 tensor views over these payloads).
+    auto scalar_weight = [](const void* payload, std::int32_t n) {
+        Weight weight{};
+        weight.payload = payload;
+        weight.qdata = payload;
+        weight.payload_bytes = static_cast<std::uint64_t>(n) * 4;
+        weight.n = n;
+        weight.k = 1;
+        weight.shape[0] = n;
+        weight.shape[1] = 1;
+        return weight;
+    };
+    weights.token_embd = binder.bf16("token_embd.weight", config.vocab_size, hidden);
+    weights.output_norm = binder.bf16("output_norm.weight", hidden, 1);
+    weights.lm_head = binder.bf16("output.weight", config.vocab_size, hidden);
+
+    weights.layers.resize(layers);
+    weights.kda_scalars.reserve(layers);
+    weights.dsa_ape.reserve(layers);
+    for (std::uint32_t layer = 0; layer < layers; ++layer) {
+        const std::string prefix = "blk." + std::to_string(layer) + ".";
+        Glm5Layer& block = weights.layers[layer];
+        block.is_dsa = config.layer_is_dsa[layer];
+        block.mlp_is_dense = config.layer_mlp_dense[layer];
+
+        block.attn_norm = binder.bf16(prefix + "attn_norm.weight", hidden, 1);
+        block.ffn_norm = binder.bf16(prefix + "ffn_norm.weight", hidden, 1);
+        // hc_*_fn feeds a BF16 view; the base/scale planes are read through
+        // FP32 views by the scheduler, so they must carry FP32 payloads (the
+        // f32 bridge widens a BF16-stored source without loss).
+        block.hc_attn_fn = binder.bf16(prefix + "hc_attn_fn.weight", 24, 4 * hidden);
+        block.hc_attn_base = scalar_weight(binder.f32(prefix + "hc_attn_base.weight", 24), 24);
+        block.hc_attn_scale = scalar_weight(binder.f32(prefix + "hc_attn_scale.weight", 3), 3);
+        block.hc_ffn_fn = binder.bf16(prefix + "hc_ffn_fn.weight", 24, 4 * hidden);
+        block.hc_ffn_base = scalar_weight(binder.f32(prefix + "hc_ffn_base.weight", 24), 24);
+        block.hc_ffn_scale = scalar_weight(binder.f32(prefix + "hc_ffn_scale.weight", 3), 3);
+
+        if (block.is_dsa) {
+            DsaBlockWeights& dsa = block.dsa;
+            dsa.attn_norm = block.attn_norm;
+            dsa.q_a = binder.bf16(prefix + "wq_a.weight", q_lora, hidden);
+            dsa.q_a_norm = binder.bf16(prefix + "wq_a_norm.weight", q_lora, 1);
+            dsa.q_b = binder.bf16(prefix + "wq_b.weight", heads * nope, q_lora);
+            dsa.kv_a = binder.bf16(prefix + "wkv_a_mqa.weight", kv_lora, hidden);
+            dsa.kv_a_norm = binder.bf16(prefix + "attn_kv_a_norm.weight", kv_lora, 1);
+            dsa.wk_b = binder.bf16_raw(prefix + "wk_b.weight");
+            dsa.wv_b = binder.bf16_raw(prefix + "wv_b.weight");
+            dsa.wo = binder.bf16(prefix + "wo.weight", hidden, heads * v_head);
+            dsa.indexer_q_b = binder.bf16(prefix + "indexer_attn_q_b.weight",
+                                          index_heads * index_dim, q_lora);
+            dsa.indexer_k = binder.bf16(prefix + "indexer_attn_k.weight", index_dim, hidden);
+            dsa.indexer_k_norm_w = binder.bf16(prefix + "indexer_k_norm.weight", index_dim, 1);
+            dsa.indexer_k_norm_b = binder.bf16(prefix + "indexer_k_norm_b.weight", index_dim, 1);
+            dsa.indexer_gate = binder.bf16(prefix + "indexer_kpool_gate.weight", index_dim, hidden);
+            // indexer_head_weights: [index_heads, index_dim] (the scorer's
+            // pre-scaled per-head vector stack).
+            dsa.indexer_proj = binder.bf16(prefix + "indexer_proj.weight", index_heads, hidden);
+            weights.dsa_ape.push_back(
+                binder.f32(prefix + "indexer_kpool_ape.weight", config.kpool * index_dim));
+        } else {
+            KdaBlockWeights& kda = block.kda;
+            kda.attn_norm = block.attn_norm;
+            kda.wq = binder.bf16(prefix + "wq.weight", d_inner, hidden);
+            kda.wk = binder.bf16(prefix + "wk.weight", d_inner, hidden);
+            kda.wv = binder.bf16(prefix + "wv.weight", d_inner, hidden);
+            kda.conv_q = binder.bf16_raw(prefix + "ssm_conv1d_q.weight");
+            kda.conv_k = binder.bf16_raw(prefix + "ssm_conv1d_k.weight");
+            kda.conv_v = binder.bf16_raw(prefix + "ssm_conv1d_v.weight");
+            kda.f_a = binder.bf16(prefix + "ssm_f_a.weight", config.kda_head_dim, hidden);
+            kda.f_b = binder.bf16(prefix + "ssm_f_b.weight", d_inner, config.kda_head_dim);
+            kda.beta = binder.bf16(prefix + "ssm_beta.weight", config.kda_heads, hidden);
+            kda.g_a = binder.bf16(prefix + "ssm_g_a.weight", config.kda_head_dim, hidden);
+            kda.g_b = binder.bf16(prefix + "ssm_g_b.weight", d_inner, config.kda_head_dim);
+            kda.wo = binder.bf16(prefix + "wo.weight", hidden, d_inner);
+            Glm5ModelWeights::KdaScalars scalars;
+            // The block executor reads dt_bias through a BF16 view (the
+            // add_bias operand) but a_log/o_norm_w through FP32 views.
+            scalars.dt_bias = binder.bf16(prefix + "ssm_dt.weight", d_inner, 1).payload;
+            scalars.a_log = binder.f32(prefix + "ssm_a_noscan.weight", config.kda_heads);
+            scalars.o_norm_w = binder.f32(prefix + "ssm_norm.weight", config.kda_head_dim);
+            weights.kda_scalars.push_back(scalars);
+        }
+
+        if (block.mlp_is_dense) {
+            DenseMlpWeights& dense = block.dense_mlp;
+            dense.ffn_norm = block.ffn_norm;
+            dense.gate = binder.bf16(prefix + "ffn_gate.weight", config.ffn_dense, hidden);
+            dense.up = binder.bf16(prefix + "ffn_up.weight", config.ffn_dense, hidden);
+            dense.down = binder.bf16(prefix + "ffn_down.weight", hidden, config.ffn_dense);
+        } else {
+            MoeBlockWeights& moe = block.moe;
+            moe.ffn_norm = block.ffn_norm;
+            moe.router = binder.bf16(prefix + "ffn_gate_inp.weight", config.experts, hidden);
+            moe.gate_exps = binder.bf16(prefix + "ffn_gate_exps.weight",
+                                        config.experts * config.ffn_moe, hidden);
+            moe.up_exps = binder.bf16(prefix + "ffn_up_exps.weight",
+                                      config.experts * config.ffn_moe, hidden);
+            moe.down_exps = binder.bf16(prefix + "ffn_down_exps.weight",
+                                        config.experts * hidden, config.ffn_moe);
+            moe.gate_shexp = binder.bf16(prefix + "ffn_gate_shexp.weight", config.ffn_moe, hidden);
+            moe.up_shexp = binder.bf16(prefix + "ffn_up_shexp.weight", config.ffn_moe, hidden);
+            moe.down_shexp = binder.bf16(prefix + "ffn_down_shexp.weight", hidden, config.ffn_moe);
+            block.moe_router_bias =
+                binder.f32(prefix + "ffn_exp_probs_b.weight", config.experts);
+        }
+    }
+}
+
