+void cleanup(synStatus status) noexcept { if (status != synSuccess) std::terminate(); }
+struct GraphBuilder {
+    synGraphHandle graph = nullptr;
+    std::array<synTensor, 3> tensors{};
+    std::array<synSectionHandle, 3> sections{};
+    GraphBuilder() { check(synGraphCreate(&graph, synDeviceGaudi2), "synGraphCreate(GEMM)"); }
+    GraphBuilder(const GraphBuilder&) = delete;
+    GraphBuilder& operator=(const GraphBuilder&) = delete;
+    ~GraphBuilder() {
+        // Synapse tensors are reference counted. Release our handles before
+        // GraphDestroy releases the graph's references; never destroy afterwards.
+        for (auto tensor : tensors) if (tensor) cleanup(synTensorDestroy(tensor));
+        for (auto section : sections) if (section) cleanup(synSectionDestroy(section));
+        cleanup(synGraphDestroy(graph));
+    }
+    void tensor(std::size_t index, const char* name, std::size_t fcd, std::size_t outer) {
+        check(synTensorHandleCreate(&tensors[index], graph, DATA_TENSOR, name), "synTensorHandleCreate(GEMM)");
+        synTensorGeometry geometry{};
+        geometry.dims = 2; geometry.sizes[0] = fcd; geometry.sizes[1] = outer;
+        check(synTensorSetGeometry(tensors[index], &geometry, synGeometrySizes), "synTensorSetGeometry(GEMM)");
+        check(synTensorSetDeviceDataType(tensors[index], syn_type_bf16), "synTensorSetDeviceDataType(GEMM)");
+        check(synTensorSetAllowPermutation(tensors[index], false), "synTensorSetAllowPermutation(GEMM)");
+        check(synSectionCreate(&sections[index], 0, graph), "synSectionCreate(GEMM)");
+        check(synSectionSetPersistent(sections[index], true), "synSectionSetPersistent(GEMM)");
+        check(synTensorAssignToSection(tensors[index], sections[index], 0), "synTensorAssignToSection(GEMM)");
+    }
+};
+}
+Bf16Gemm::Bf16Gemm(const Device& device, Bf16GemmShape shape, std::size_t max_workspace_bytes)
+    : shape_(shape) {
+    shape_.validate();
+    GraphBuilder builder;
+    builder.tensor(0, "A", shape.k, shape.m);
+    builder.tensor(1, "W", shape.k, shape.n);
+    builder.tensor(2, "Y", shape.n, shape.m);
+    const std::array<synTensor, 2> inputs{builder.tensors[0], builder.tensors[1]};
+    const synGEMMParams parameters{false, true};
+    synNodeId node = 0;
+    check(synNodeCreateWithId(builder.graph, inputs.data(), &builder.tensors[2], 2, 1,
+          &parameters, sizeof(parameters), "gemm", "ninfer_bf16_linear", &node, nullptr, nullptr),
+          "synNodeCreateWithId(GEMM)");
+    check(synNodeSetRoundingMode(builder.graph, node, synRoundToNearest), "synNodeSetRoundingMode(GEMM RNE)");
+    recipe_ = device.compile(builder.graph, "ninfer_gaudi2_bf16_gemm", max_workspace_bytes);
+    std::array<const char*, 3> names{"A", "W", "Y"};
+    recipe_.tensor_ids(names, tensor_ids_);
+}
+Compute Bf16Gemm::launch(Stream& stream, DeviceBuffer& a, DeviceBuffer& w, DeviceBuffer& y) {
+    if (a.size() != shape_.a_bytes() || w.size() != shape_.w_bytes() || y.size() != shape_.y_bytes())
+        throw std::invalid_argument("Gaudi2 BF16 GEMM buffer sizes do not match its static geometry");
+    // These accessors also reject pending uploads/compute. Initial AR preparation
+    // uses explicit host-observed completion, not implicit cross-stream chaining.
+    if (a.address() == w.address() || a.address() == y.address() || w.address() == y.address())
+        throw std::invalid_argument("Gaudi2 BF16 GEMM requires disjoint operand allocations");
+    const std::array<RecipeBinding, 3> bindings{{
+        {tensor_ids_[0], &a, {shape_.k, shape_.m}},
+        {tensor_ids_[1], &w, {shape_.k, shape_.n}},
+        {tensor_ids_[2], &y, {shape_.n, shape_.m}}}};
+    return stream.launch(recipe_, bindings);
+}
+} // namespace ninfer::gaudi2
