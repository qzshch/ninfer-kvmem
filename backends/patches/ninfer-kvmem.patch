diff --git a/src/core/gaudi2/tpc/glue/src/glm5_tpc_glue.cpp b/src/core/gaudi2/tpc/glue/src/glm5_tpc_glue.cpp
new file mode 100644
index 0000000..43c01e6
--- /dev/null
+++ b/src/core/gaudi2/tpc/glue/src/glm5_tpc_glue.cpp
@@ -0,0 +1,364 @@
+// GLM-5.3-Flash TPC kernel glue, FCD-row family (table-driven).
+//
+// Review R2/R3 corrections baked into this version:
+//  * Scalar parameters come from the node's UserParams (the host bridge in
+//    tpc/glm5_tpc.cpp is the ABI ground truth - every kernel's struct is
+//    byte-compared against it), never from baked defaults.
+//  * Index-space units are ELEMENT coordinates for every element-wise
+//    kernel ({width, tokens}), one slot per token for whole-row reductions
+//    ({1, tokens}), and {pools, width} for the dsa pool grid. The kernels
+//    read get_index_space_offset() in those same units; the access-pattern
+//    transforms are identity (a=1, b=0) so a slot's [begin, end) range maps
+//    straight onto the tensor elements it owns.
+//  * Whole-row reductions (rmsnorm, mhc_gates, moe_route, and the dsa
+//    select's rank loop) mark their FCD dimension allRequired - the graph
+//    compiler must not split a row's reduction across slots.
+#include "gc_interface.h"
+
+#include <cstring>
+
+namespace {
+
+extern "C" {
+#define BLOB(n) extern unsigned char _binary_glm5_##n##_gaudi2_o_start; \
+                extern unsigned char _binary_glm5_##n##_gaudi2_o_end
+BLOB(rmsnorm_bf16);
+BLOB(clamp_swiglu_bf16);
+BLOB(kda_gate_bf16);
+BLOB(mhc_gates_bf16);
+BLOB(mhc_collapse_bf16);
+BLOB(mhc_post_bf16);
+BLOB(mhc_head_bf16);
+BLOB(moe_combine_bf16);
+BLOB(dsa_pool_bf16);
+BLOB(dsa_scale_f32);
+#undef BLOB
+}
+
+gcapi::GlueCodeReturn_t publish_elf(gcapi::HabanaKernelInstantiation_t* out_defs,
+                                    const unsigned char* start, const unsigned char* end) {
+    const unsigned size = static_cast<unsigned>(end - start);
+    const unsigned given = out_defs->elfSize;
+    out_defs->elfSize = size;
+    if (given < size) return gcapi::GLUE_INSUFICIENT_ELF_BUFFER;
+    std::memcpy(out_defs->kernelElf, start, size);
+    return gcapi::GLUE_SUCCESS;
+}
+
+// Identity element mapping on one index-space dimension.
+void set_element_transform(gcapi::TensorAccessPattern_t& pattern,
+                           unsigned index_space_dim) {
+    pattern.dim[0].indexSpaceDim = index_space_dim;
+    pattern.dim[0].start_a = 1.0f;
+    pattern.dim[0].start_b = 0.0f;
+    pattern.dim[0].end_a = 1.0f;
+    pattern.dim[0].end_b = 0.0f;
+}
+
+// One scalar parameter block: memcpy from the node params after a byte-size
+// check against the host bridge's ABI struct.
+bool copy_params(unsigned* words, unsigned word_count, const void* node_params,
+                 unsigned params_bytes) {
+    if (node_params == nullptr || params_bytes != word_count * sizeof(unsigned)) {
+        return false;
+    }
+    std::memcpy(words, node_params, word_count * sizeof(unsigned));
+    return true;
+}
+
+enum class Layout {
+    ElementRows,   // {width elements, tokens}; per-128-element chunks
+    VectorSlots,   // {ceil(width/128) slots, tokens}; slot s owns elements
+                   // [s*128, s*128+127] - the layout per-head vector kernels
+                   // (kda_gate) require so no lane crosses a head boundary
+    TokenWholeRow, // {1, tokens}; the slot owns the token's whole FCD row
+    PoolGrid,      // {pools, width elements}; slot p owns K source rows
+};
+
+struct FcdRowKernel {
+    const char* guid;
+    unsigned inputs, outputs;
+    gcapi::TensorDataType_t in_types[5];
+    gcapi::TensorDataType_t out_types[1];
+    Layout layout;
+    unsigned scalar_words;
+    const unsigned char* elf_start;
+    const unsigned char* elf_end;
+};
+
+gcapi::GlueCodeReturn_t fcd_row_definitions(
+    const FcdRowKernel& k, gcapi::HabanaKernelParams_t* in_defs,
+    gcapi::HabanaKernelInstantiation_t* out_defs, const void* user_params,
+    unsigned params_size) {
+    if (in_defs->inputTensorNr != k.inputs) {
+        in_defs->inputTensorNr = k.inputs;
+        return gcapi::GLUE_INCOMPATIBLE_INPUT_COUNT;
+    }
+    if (in_defs->outputTensorNr != k.outputs) {
+        in_defs->outputTensorNr = k.outputs;
+        return gcapi::GLUE_INCOMPATIBLE_OUTPUT_COUNT;
+    }
+    for (unsigned i = 0; i < k.inputs; ++i) {
+        if (in_defs->inputTensors[i].dataType != k.in_types[i]) {
+            return gcapi::GLUE_INCOMPATIBLE_DATA_TYPE;
+        }
+    }
+    for (unsigned o = 0; o < k.outputs; ++o) {
+        if (in_defs->outputTensors[o].dataType != k.out_types[o]) {
+            return gcapi::GLUE_INCOMPATIBLE_DATA_TYPE;
+        }
+    }
+
+    const unsigned width = in_defs->outputTensors[0].geometry.sizes[0];
+    const unsigned tokens = in_defs->outputTensors[0].geometry.dims > 1
+                                ? in_defs->outputTensors[0].geometry.sizes[1]
+                                : 1;
+    if (width == 0 || tokens == 0) {
+        return gcapi::GLUE_INCOMPATIBLE_OUTPUT_SIZE;
+    }
+
+    // Scalar parameters: the host bridge's ABI struct arrives through
+    // user_params; a size mismatch is a hard error, not a default.
+    out_defs->kernel.paramsNr = k.scalar_words;
+    unsigned words[8] = {0};
+    if (k.scalar_words > 0) {
+        if (user_params == nullptr ||
+            params_size != k.scalar_words * sizeof(unsigned) ||
+            !copy_params(words, k.scalar_words, user_params, params_size)) {
+            return gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+        }
+    } else if (user_params != nullptr && params_size != 0) {
+        // A parameterless kernel must not be driven with parameters.
+        return gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+    }
+    if (k.scalar_words > 0) {
+        std::memcpy(&out_defs->kernel.scalarParams[0], words,
+                    k.scalar_words * sizeof(unsigned));
+    }
+
+    if (k.layout == Layout::PoolGrid) {
+        // dsa_pool: dim0 = pool index, dim1 = element column. The K-member
+        // softmax reduce runs inside one slot, so both dimensions may
+        // split freely. Requires the pool_k scalar (word 0 of the ABI).
+        // The pooled output is {dim, T/K}: its dim1 IS the pool count -
+        // dividing it by K again (the S1 bug) rejected the first legal
+        // pool of T=4/K=4 and scheduled T/16 pools instead of T/4. The
+        // source planes' dim1 is T; cross-check T == pool_k * pools.
+        const unsigned pool_k = words[0];
+        const unsigned pools = tokens;
+        const unsigned source_tokens =
+            in_defs->inputTensors[0].geometry.dims > 1
+                ? in_defs->inputTensors[0].geometry.sizes[1]
+                : 1;
+        if (pool_k == 0 || pools == 0 || source_tokens != pool_k * pools) {
+            return gcapi::GLUE_INCOMPATIBLE_INPUT_SIZE;
+        }
+        out_defs->indexSpaceGeometry.dims = 2;
+        out_defs->indexSpaceGeometry.sizes[0] = pools;
+        out_defs->indexSpaceGeometry.sizes[1] = width;
+        // ik/ig {width, pools*K}: tensor dim0 follows index dim1; tensor
+        // dim1 follows index dim0 with stride pool_k (slot p owns rows
+        // [p*K, p*K+K)).
+        for (unsigned t = 0; t < 2; ++t) {
+            out_defs->inputTensorAccessPattern[t].dim[0].indexSpaceDim = 1;
+            out_defs->inputTensorAccessPattern[t].dim[0].start_a = 1.0f;
+            out_defs->inputTensorAccessPattern[t].dim[0].start_b = 0.0f;
+            out_defs->inputTensorAccessPattern[t].dim[0].end_a = 1.0f;
+            out_defs->inputTensorAccessPattern[t].dim[0].end_b = 0.0f;
+            out_defs->inputTensorAccessPattern[t].dim[1].indexSpaceDim = 0;
+            out_defs->inputTensorAccessPattern[t].dim[1].start_a =
+                static_cast<float>(pool_k);
+            out_defs->inputTensorAccessPattern[t].dim[1].start_b = 0.0f;
+            out_defs->inputTensorAccessPattern[t].dim[1].end_a =
+                static_cast<float>(pool_k);
+            out_defs->inputTensorAccessPattern[t].dim[1].end_b =
+                static_cast<float>(pool_k - 1);
+        }
+        // ape {width, K}: fixed rows regardless of the pool slot.
+        for (unsigned d = 0; d < 2; ++d) {
+            out_defs->inputTensorAccessPattern[2].dim[d].indexSpaceDim =
+                d == 0 ? 1 : 0xffffffff;
+            out_defs->inputTensorAccessPattern[2].dim[d].start_a =
+                d == 0 ? 1.0f : 0.0f;
+            out_defs->inputTensorAccessPattern[2].dim[d].start_b = 0.0f;
+            out_defs->inputTensorAccessPattern[2].dim[d].end_a =
+                d == 0 ? 1.0f : 0.0f;
+            out_defs->inputTensorAccessPattern[2].dim[d].end_b =
+                d == 0 ? 0.0f : static_cast<float>(pool_k - 1);
+        }
+        // pooled {width, pools}: tensor dim1 follows index dim0, stride 1.
+        set_element_transform(out_defs->outputTensorAccessPattern[0], 1);
+        out_defs->outputTensorAccessPattern[0].dim[1].indexSpaceDim = 0;
+        out_defs->outputTensorAccessPattern[0].dim[1].start_a = 1.0f;
+        out_defs->outputTensorAccessPattern[0].dim[1].start_b = 0.0f;
+        out_defs->outputTensorAccessPattern[0].dim[1].end_a = 1.0f;
+        out_defs->outputTensorAccessPattern[0].dim[1].end_b = 0.0f;
+        return publish_elf(out_defs, k.elf_start, k.elf_end);
+    }
+
+    if (k.layout == Layout::VectorSlots) {
+        // One slot per 128 elements; the kda_gate kernel maps slot s onto
+        // [s*128, s*128+127] (one head's span, head_dim pinned to 128).
+        if (k.scalar_words >= 2 && words[1] != 128) {
+            return gcapi::GLUE_UNSUPPORTED_LAYER_CONFIGURATION;
+        }
+        out_defs->indexSpaceGeometry.dims = 2;
+        out_defs->indexSpaceGeometry.sizes[0] = (width + 127) / 128;
+        out_defs->indexSpaceGeometry.sizes[1] = tokens;
+        for (unsigned i = 0; i < k.inputs; ++i) {
+            // dim0: slot s owns elements [s*128, s*128+127]; dim1: the token
+            // axis follows index dim1 1:1. The earlier helper call only
+            // touched pattern dim[0] (immediately overwritten below) and
+            // left the TOKEN axis unmapped - review T1's {width, 2}
+            // descriptor exposed the unreachable second token row.
+            out_defs->inputTensorAccessPattern[i].dim[0].indexSpaceDim = 0;
+            out_defs->inputTensorAccessPattern[i].dim[0].start_a = 128.0f;
+            out_defs->inputTensorAccessPattern[i].dim[0].start_b = 0.0f;
+            out_defs->inputTensorAccessPattern[i].dim[0].end_a = 128.0f;
+            out_defs->inputTensorAccessPattern[i].dim[0].end_b = 127.0f;
+            out_defs->inputTensorAccessPattern[i].dim[1].indexSpaceDim = 1;
+            out_defs->inputTensorAccessPattern[i].dim[1].start_a = 1.0f;
+            out_defs->inputTensorAccessPattern[i].dim[1].start_b = 0.0f;
+            out_defs->inputTensorAccessPattern[i].dim[1].end_a = 1.0f;
+            out_defs->inputTensorAccessPattern[i].dim[1].end_b = 0.0f;
+        }
+        // a_log {heads, 1}: the head axis follows the slot index 1:1 (the
+        // kernel reads a_log[slot]); the 128-wide transform above would
+        // claim 128 heads per slot. Only the gate kernel is VectorSlots
+        // today - patch its per-head operand.
+        if (std::strcmp(k.guid, "glm5_kda_gate_bf16") == 0) {
+            out_defs->inputTensorAccessPattern[1].dim[0].start_a = 1.0f;
+            out_defs->inputTensorAccessPattern[1].dim[0].start_b = 0.0f;
+            out_defs->inputTensorAccessPattern[1].dim[0].end_a = 1.0f;
+            out_defs->inputTensorAccessPattern[1].dim[0].end_b = 0.0f;
+        }
+        for (unsigned o = 0; o < k.outputs; ++o) {
+            out_defs->outputTensorAccessPattern[o].dim[0].indexSpaceDim = 0;
+            out_defs->outputTensorAccessPattern[o].dim[0].start_a = 128.0f;
+            out_defs->outputTensorAccessPattern[o].dim[0].start_b = 0.0f;
+            out_defs->outputTensorAccessPattern[o].dim[0].end_a = 128.0f;
+            out_defs->outputTensorAccessPattern[o].dim[0].end_b = 127.0f;
+            out_defs->outputTensorAccessPattern[o].dim[1].indexSpaceDim = 1;
+            out_defs->outputTensorAccessPattern[o].dim[1].start_a = 1.0f;
+            out_defs->outputTensorAccessPattern[o].dim[1].start_b = 0.0f;
+            out_defs->outputTensorAccessPattern[o].dim[1].end_a = 1.0f;
+            out_defs->outputTensorAccessPattern[o].dim[1].end_b = 0.0f;
+        }
+        return publish_elf(out_defs, k.elf_start, k.elf_end);
+    }
+
+    // ElementRows / TokenWholeRow.
+    const bool whole_row = k.layout == Layout::TokenWholeRow;
+    out_defs->indexSpaceGeometry.dims = 2;
+    out_defs->indexSpaceGeometry.sizes[0] = whole_row ? 1 : width;
+    out_defs->indexSpaceGeometry.sizes[1] = tokens;
+
+    for (unsigned i = 0; i < k.inputs; ++i) {
+        // Every operand shares the {FCD, tokens} plane geometry; the FCD
+        // axis maps identity onto index dim0 for element kernels and the
+        // whole width rides the single slot for whole-row kernels.
+        out_defs->inputTensorAccessPattern[i].dim[0].indexSpaceDim = 0;
+        out_defs->inputTensorAccessPattern[i].dim[0].start_a =
+            whole_row ? static_cast<float>(width) : 1.0f;
+        out_defs->inputTensorAccessPattern[i].dim[0].start_b = 0.0f;
+        out_defs->inputTensorAccessPattern[i].dim[0].end_a =
+            whole_row ? static_cast<float>(width) : 1.0f;
+        out_defs->inputTensorAccessPattern[i].dim[0].end_b =
+            whole_row ? static_cast<float>(width - 1) : 0.0f;
+        out_defs->inputTensorAccessPattern[i].dim[1].indexSpaceDim = 1;
+        out_defs->inputTensorAccessPattern[i].dim[1].start_a = 1.0f;
+        out_defs->inputTensorAccessPattern[i].dim[1].start_b = 0.0f;
+        out_defs->inputTensorAccessPattern[i].dim[1].end_a = 1.0f;
+        out_defs->inputTensorAccessPattern[i].dim[1].end_b = 0.0f;
+    }
+    for (unsigned o = 0; o < k.outputs; ++o) {
+        out_defs->outputTensorAccessPattern[o].dim[0].indexSpaceDim = 0;
+        out_defs->outputTensorAccessPattern[o].dim[0].start_a =
+            whole_row ? static_cast<float>(width) : 1.0f;
+        out_defs->outputTensorAccessPattern[o].dim[0].start_b = 0.0f;
+        out_defs->outputTensorAccessPattern[o].dim[0].end_a =
+            whole_row ? static_cast<float>(width) : 1.0f;
+        out_defs->outputTensorAccessPattern[o].dim[0].end_b =
+            whole_row ? static_cast<float>(width - 1) : 0.0f;
+        out_defs->outputTensorAccessPattern[o].dim[1].indexSpaceDim = 1;
+        out_defs->outputTensorAccessPattern[o].dim[1].start_a = 1.0f;
+        out_defs->outputTensorAccessPattern[o].dim[1].start_b = 0.0f;
+        out_defs->outputTensorAccessPattern[o].dim[1].end_a = 1.0f;
+        out_defs->outputTensorAccessPattern[o].dim[1].end_b = 0.0f;
+    }
+
+    return publish_elf(out_defs, k.elf_start, k.elf_end);
+}
+
+using gcapi::DATA_BF16;
+using gcapi::DATA_F32;
+
+// Plain aggregate initializers (the preprocessor would split the braced
+// type lists across macro arguments).
+const FcdRowKernel kFcdRowKernels[] = {
+    {"glm5_rmsnorm_bf16", 2, 1, {DATA_BF16, DATA_BF16}, {DATA_BF16},
+     Layout::TokenWholeRow, 2,
+     &_binary_glm5_rmsnorm_bf16_gaudi2_o_start,
+     &_binary_glm5_rmsnorm_bf16_gaudi2_o_end},
+    {"glm5_clamp_swiglu_bf16", 1, 1, {DATA_BF16}, {DATA_BF16},
+     Layout::ElementRows, 1,
+     &_binary_glm5_clamp_swiglu_bf16_gaudi2_o_start,
+     &_binary_glm5_clamp_swiglu_bf16_gaudi2_o_end},
+    {"glm5_kda_gate_bf16", 2, 1, {DATA_BF16, DATA_F32}, {DATA_F32},
+     Layout::VectorSlots, 2,
+     &_binary_glm5_kda_gate_bf16_gaudi2_o_start,
+     &_binary_glm5_kda_gate_bf16_gaudi2_o_end},
+    {"glm5_mhc_gates_bf16", 4, 1,
+     {DATA_BF16, DATA_BF16, DATA_F32, DATA_F32}, {DATA_F32},
+     Layout::TokenWholeRow, 3,
+     &_binary_glm5_mhc_gates_bf16_gaudi2_o_start,
+     &_binary_glm5_mhc_gates_bf16_gaudi2_o_end},
+    {"glm5_mhc_collapse_bf16", 2, 1, {DATA_BF16, DATA_F32}, {DATA_BF16},
+     Layout::ElementRows, 0,
+     &_binary_glm5_mhc_collapse_bf16_gaudi2_o_start,
+     &_binary_glm5_mhc_collapse_bf16_gaudi2_o_end},
+    {"glm5_mhc_post_bf16", 4, 1,
+     {DATA_BF16, DATA_BF16, DATA_F32, DATA_F32}, {DATA_BF16},
+     Layout::ElementRows, 0,
+     &_binary_glm5_mhc_post_bf16_gaudi2_o_start,
+     &_binary_glm5_mhc_post_bf16_gaudi2_o_end},
+    {"glm5_mhc_head_bf16", 1, 1, {DATA_BF16}, {DATA_BF16},
+     Layout::ElementRows, 0,
+     &_binary_glm5_mhc_head_bf16_gaudi2_o_start,
+     &_binary_glm5_mhc_head_bf16_gaudi2_o_end},
+    {"glm5_moe_combine_bf16", 3, 1, {DATA_BF16, DATA_F32, DATA_BF16}, {DATA_BF16},
+     Layout::ElementRows, 1,
+     &_binary_glm5_moe_combine_bf16_gaudi2_o_start,
+     &_binary_glm5_moe_combine_bf16_gaudi2_o_end},
+    {"glm5_dsa_pool_bf16", 3, 1, {DATA_BF16, DATA_BF16, DATA_F32}, {DATA_F32},
+     Layout::PoolGrid, 1,
+     &_binary_glm5_dsa_pool_bf16_gaudi2_o_start,
+     &_binary_glm5_dsa_pool_bf16_gaudi2_o_end},
+    {"glm5_dsa_scale_f32", 1, 1, {DATA_F32}, {DATA_F32},
+     Layout::ElementRows, 1,
+     &_binary_glm5_dsa_scale_f32_gaudi2_o_start,
+     &_binary_glm5_dsa_scale_f32_gaudi2_o_end},
+};
+
+constexpr unsigned kFcdRowCount = sizeof(kFcdRowKernels) / sizeof(kFcdRowKernels[0]);
+
+} // namespace
+
+extern "C" {
+
+gcapi::GlueCodeReturn_t glm5_fcd_row_definitions(
+    unsigned index, gcapi::HabanaKernelParams_t* in_defs,
+    gcapi::HabanaKernelInstantiation_t* out_defs, const void* user_params,
+    unsigned params_size) {
+    if (index >= kFcdRowCount) return gcapi::GLUE_NODE_NOT_FOUND;
+    return fcd_row_definitions(kFcdRowKernels[index], in_defs, out_defs,
+                               user_params, params_size);
+}
+
+unsigned glm5_glue_kernel_count() { return kFcdRowCount; }
+
+const char* glm5_glue_kernel_name(unsigned index) {
+    return index < kFcdRowCount ? kFcdRowKernels[index].guid : nullptr;
+}
+
+} // extern "C"
diff --git a/src/core/gaudi2/tpc/glue/src/glm5_tpc_glue_special.cpp b/src/core/gaudi2/tpc/glue/src/glm5_tpc_glue_special.cpp
new file mode 100644
index 0000000..c3f9f19
--- /dev/null
+++ b/src/core/gaudi2/tpc/glue/src/glm5_tpc_glue_special.cpp
@@ -0,0 +1,318 @@
+// GLM-5.3-Flash TPC kernel glue, head/selection family. These kernels do
+// not share the FCD-row index space:
+//   kda_scan / dsa_absorb / dsa_attention / moe_route — one dim0 slot per
+//     head (or per token for moe_route), each slot owning its head's whole
+//     slice of every tensor.
+//   dsa_score — one dim0 slot per pool.
+//   dsa_select — a single slot (the rank loop runs inside the block).
+
+#include "gc_interface.h"
+
+#include <cstring>
+
+namespace {
+
+gcapi::GlueCodeReturn_t publish_elf(gcapi::HabanaKernelInstantiation_t* out_defs,
+                                    const unsigned char* start, const unsigned char* end) {
+    const unsigned size = static_cast<unsigned>(end - start);
+    const unsigned given = out_defs->elfSize;
+    out_defs->elfSize = size;
+    if (given < size) return gcapi::GLUE_INSUFICIENT_ELF_BUFFER;
+    std::memcpy(out_defs->kernelElf, start, size);
+    return gcapi::GLUE_SUCCESS;
+}
+
+void set_slot_transform(gcapi::TensorAccessPattern_t& pattern,
+                        unsigned index_space_dim, float stride) {
+    pattern.dim[0].indexSpaceDim = index_space_dim;
+    pattern.dim[0].start_a = stride;
+    pattern.dim[0].start_b = 0.0f;
+    pattern.dim[0].end_a = stride;
+    pattern.dim[0].end_b = stride > 1.0f ? stride - 1.0f : 0.0f;
+    // All higher tensor dims are contiguous inside the slot.
+    for (unsigned d = 1; d < gcapi::MAX_TENSOR_DIM; ++d) {
+        pattern.dim[d].indexSpaceDim = 0xffffffff;  // not index-space mapped
+        pattern.dim[d].start_a = 0.0f;
+        pattern.dim[d].start_b = 0.0f;
+        pattern.dim[d].end_a = 0.0f;
+        pattern.dim[d].end_b = 0.0f;
+    }
+}
+
+gcapi::GlueCodeReturn_t check_tensors(gcapi::HabanaKernelParams_t* in_defs,
+                                       unsigned inputs, unsigned outputs,
+                                       const gcapi::TensorDataType_t* in_types,
+                                       const gcapi::TensorDataType_t* out_types) {
+    if (in_defs->inputTensorNr != inputs) {
+        in_defs->inputTensorNr = inputs;
+        return gcapi::GLUE_INCOMPATIBLE_INPUT_COUNT;
+    }
+    if (in_defs->outputTensorNr != outputs) {
+        in_defs->outputTensorNr = outputs;
+        return gcapi::GLUE_INCOMPATIBLE_OUTPUT_COUNT;
+    }
+    for (unsigned i = 0; i < inputs; ++i) {
+        if (in_defs->inputTensors[i].dataType != in_types[i]) {
+            return gcapi::GLUE_INCOMPATIBLE_DATA_TYPE;
+        }
+    }
+    for (unsigned o = 0; o < outputs; ++o) {
+        if (in_defs->outputTensors[o].dataType != out_types[o]) {
+            return gcapi::GLUE_INCOMPATIBLE_DATA_TYPE;
+        }
+    }
+    return gcapi::GLUE_SUCCESS;
+}
+
+// Scalar parameters arrive through the node's UserParams (the host bridge
+// in tpc/glm5_tpc.cpp is the ABI ground truth); a byte-size mismatch is a
+// hard error, never a baked default (review R2).
+bool copy_params(unsigned* words, unsigned word_count, const void* node_params,
+                 unsigned params_bytes, gcapi::GlueCodeReturn_t* status) {
+    if (node_params == nullptr ||
+        params_bytes != word_count * sizeof(unsigned)) {
+        *status = gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+        return false;
+    }
+    std::memcpy(words, node_params, word_count * sizeof(unsigned));
+    *status = gcapi::GLUE_SUCCESS;
+    return true;
+}
+
+} // namespace
+
+extern "C" {
+#define BLOB(n) extern unsigned char _binary_glm5_##n##_gaudi2_o_start; \
+                extern unsigned char _binary_glm5_##n##_gaudi2_o_end
+BLOB(kda_scan_f32);
+BLOB(dsa_absorb_bf16);
+BLOB(dsa_score_f32);
+BLOB(dsa_select_f32);
+BLOB(dsa_attention_f32);
+BLOB(moe_route_bf16);
+#undef BLOB
+}
+
+// ---------------------------------------------------------------------------
+// glm5_kda_scan_f32: q,k,v BF16 [d_inner,1], gate F32 [d_inner,1], beta F32
+// [heads,1], state F32 [heads*D*D,1] in/out, out BF16 [d_inner,1]. One slot
+// per head; the slot owns its [D] q/k/v/gate rows and its [D,D] state slice.
+
+extern "C" gcapi::GlueCodeReturn_t glm5_kda_scan_get_gc_definitions(
+    gcapi::HabanaKernelParams_t* in_defs, gcapi::HabanaKernelInstantiation_t* out_defs,
+    const void* user_params, unsigned params_size) {
+    using gcapi::DATA_BF16;
+    using gcapi::DATA_F32;
+    const gcapi::TensorDataType_t in_types[] = {DATA_BF16, DATA_BF16, DATA_BF16,
+                                                DATA_F32, DATA_F32, DATA_F32};
+    const gcapi::TensorDataType_t out_types[] = {DATA_F32, DATA_BF16};
+    gcapi::GlueCodeReturn_t status = check_tensors(in_defs, 6, 2, in_types, out_types);
+    if (status != gcapi::GLUE_SUCCESS) return status;
+
+    // state is [heads*D*D, 1]; its dim0 extent IS the heads count scaled -
+    // take heads from beta (the per-head plane).
+    const unsigned heads = in_defs->inputTensors[4].geometry.sizes[0];
+    out_defs->indexSpaceGeometry.dims = 1;
+    out_defs->indexSpaceGeometry.sizes[0] = heads;
+
+    // q/k/v/gate: d_inner = heads * D contiguous rows; per-slot stride = D.
+    // beta: per-head stride 1. state: [D*D] per head. out: [D] per head.
+    // Strides need the head_dim - recover from q's extent / heads.
+    const unsigned d_inner = in_defs->inputTensors[0].geometry.sizes[0];
+    const float dk = static_cast<float>(d_inner / heads);
+    for (unsigned t = 0; t < 4; ++t) {  // q, k, v, gate
+        set_slot_transform(out_defs->inputTensorAccessPattern[t], 0, dk);
+    }
+    set_slot_transform(out_defs->inputTensorAccessPattern[4], 0, 1.0f);   // beta
+    set_slot_transform(out_defs->inputTensorAccessPattern[5], 0, dk * dk); // state
+    set_slot_transform(out_defs->outputTensorAccessPattern[0], 0, dk * dk); // state out
+    set_slot_transform(out_defs->outputTensorAccessPattern[1], 0, dk);     // out
+
+    unsigned words[4] = {0};
+    if (!copy_params(words, 1, user_params, params_size, &status)) {
+        return status;
+    }
+    // The scalar must agree with the geometry the strides were derived from.
+    if (words[0] != static_cast<unsigned>(dk)) {
+        return gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+    }
+    out_defs->kernel.paramsNr = 1;
+    std::memcpy(&out_defs->kernel.scalarParams[0], words, 4);
+
+    return publish_elf(out_defs, &_binary_glm5_kda_scan_f32_gaudi2_o_start,
+                       &_binary_glm5_kda_scan_f32_gaudi2_o_end);
+}
+
+// ---------------------------------------------------------------------------
+// glm5_dsa_absorb_bf16: q BF16 [nope, heads], wk_b BF16 [nope*lora*heads,1]
+// -> q_abs FP32 [lora, heads]. One slot per head.
+
+extern "C" gcapi::GlueCodeReturn_t glm5_dsa_absorb_get_gc_definitions(
+    gcapi::HabanaKernelParams_t* in_defs, gcapi::HabanaKernelInstantiation_t* out_defs,
+    const void* user_params, unsigned params_size) {
+    using gcapi::DATA_BF16;
+    using gcapi::DATA_F32;
+    const gcapi::TensorDataType_t in_types[] = {DATA_BF16, DATA_BF16};
+    const gcapi::TensorDataType_t out_types[] = {DATA_F32};
+    gcapi::GlueCodeReturn_t status = check_tensors(in_defs, 2, 1, in_types, out_types);
+    if (status != gcapi::GLUE_SUCCESS) return status;
+
+    const unsigned heads = in_defs->inputTensors[0].geometry.sizes[1];
+    out_defs->indexSpaceGeometry.dims = 1;
+    out_defs->indexSpaceGeometry.sizes[0] = heads;
+    set_slot_transform(out_defs->inputTensorAccessPattern[0], 0, 1.0f);
+    set_slot_transform(out_defs->inputTensorAccessPattern[1], 0, 1.0f);
+    set_slot_transform(out_defs->outputTensorAccessPattern[0], 0, 1.0f);
+
+    if (user_params != nullptr && params_size != 0) {
+        return gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+    }
+    out_defs->kernel.paramsNr = 0;
+    return publish_elf(out_defs, &_binary_glm5_dsa_absorb_bf16_gaudi2_o_start,
+                       &_binary_glm5_dsa_absorb_bf16_gaudi2_o_end);
+}
+
+// ---------------------------------------------------------------------------
+// glm5_dsa_score_f32: iq BF16 [dim, heads], pooled F32 [dim, pools], weights
+// F32 [heads,1] -> score F32 [pools,1]. One slot per pool.
+
+extern "C" gcapi::GlueCodeReturn_t glm5_dsa_score_get_gc_definitions(
+    gcapi::HabanaKernelParams_t* in_defs, gcapi::HabanaKernelInstantiation_t* out_defs,
+    const void* user_params, unsigned params_size) {
+    using gcapi::DATA_BF16;
+    using gcapi::DATA_F32;
+    const gcapi::TensorDataType_t in_types[] = {DATA_BF16, DATA_F32, DATA_F32};
+    const gcapi::TensorDataType_t out_types[] = {DATA_F32};
+    gcapi::GlueCodeReturn_t status = check_tensors(in_defs, 3, 1, in_types, out_types);
+    if (status != gcapi::GLUE_SUCCESS) return status;
+
+    const unsigned pools = in_defs->inputTensors[1].geometry.sizes[1];
+    out_defs->indexSpaceGeometry.dims = 1;
+    out_defs->indexSpaceGeometry.sizes[0] = pools;
+    set_slot_transform(out_defs->inputTensorAccessPattern[0], 0, 1.0f);
+    set_slot_transform(out_defs->inputTensorAccessPattern[1], 0, 1.0f);
+    set_slot_transform(out_defs->inputTensorAccessPattern[2], 0, 1.0f);
+    set_slot_transform(out_defs->outputTensorAccessPattern[0], 0, 1.0f);
+
+    if (user_params != nullptr && params_size != 0) {
+        return gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+    }
+    out_defs->kernel.paramsNr = 0;
+    return publish_elf(out_defs, &_binary_glm5_dsa_score_f32_gaudi2_o_start,
+                       &_binary_glm5_dsa_score_f32_gaudi2_o_end);
+}
+
+// ---------------------------------------------------------------------------
+// glm5_dsa_select_f32: score F32 [pools,1] -> cells INT32 [width,1]. A
+// single slot: the rank loop and cell fills run inside one block.
+
+extern "C" gcapi::GlueCodeReturn_t glm5_dsa_select_get_gc_definitions(
+    gcapi::HabanaKernelParams_t* in_defs, gcapi::HabanaKernelInstantiation_t* out_defs,
+    const void* user_params, unsigned params_size) {
+    using gcapi::DATA_F32;
+    using gcapi::DATA_I32;
+    const gcapi::TensorDataType_t in_types[] = {DATA_F32};
+    const gcapi::TensorDataType_t out_types[] = {DATA_I32};
+    gcapi::GlueCodeReturn_t status = check_tensors(in_defs, 1, 1, in_types, out_types);
+    if (status != gcapi::GLUE_SUCCESS) return status;
+
+    out_defs->indexSpaceGeometry.dims = 1;
+    out_defs->indexSpaceGeometry.sizes[0] = 1;
+    set_slot_transform(out_defs->inputTensorAccessPattern[0], 0, 1.0f);
+    set_slot_transform(out_defs->outputTensorAccessPattern[0], 0, 1.0f);
+
+    unsigned words[4] = {0};
+    if (!copy_params(words, 4, user_params, params_size, &status)) {
+        return status;
+    }
+    // The kernel now walks the whole cells width inside its slot (the
+    // production W = 2051 spans 33 lane runs); what must hold instead is
+    // the width identity W = top_pools*K + K-1 (tail on) or top_pools*K.
+    {
+        const unsigned width = in_defs->outputTensors[0].geometry.sizes[0];
+        const unsigned k = words[1], top_pools = words[2], tail = words[3];
+        const unsigned expect = top_pools * k + (tail ? k - 1 : 0);
+        if (width != expect) {
+            return gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+        }
+    }
+    out_defs->kernel.paramsNr = 4;
+    std::memcpy(&out_defs->kernel.scalarParams[0], words, sizeof(words));
+
+    return publish_elf(out_defs, &_binary_glm5_dsa_select_f32_gaudi2_o_start,
+                       &_binary_glm5_dsa_select_f32_gaudi2_o_end);
+}
+
+// ---------------------------------------------------------------------------
+// glm5_dsa_attention_f32: q_abs BF16 [lora, heads], latents BF16 [lora,
+// cache], cells INT32 [slots,1], wv_b BF16 [lora*v_head*heads,1] -> out
+// BF16 [heads*v_head,1]. One slot per head.
+
+extern "C" gcapi::GlueCodeReturn_t glm5_dsa_attention_get_gc_definitions(
+    gcapi::HabanaKernelParams_t* in_defs, gcapi::HabanaKernelInstantiation_t* out_defs,
+    const void* user_params, unsigned params_size) {
+    using gcapi::DATA_BF16;
+    using gcapi::DATA_I32;
+    const gcapi::TensorDataType_t in_types[] = {DATA_BF16, DATA_BF16, DATA_I32,
+                                                DATA_BF16};
+    const gcapi::TensorDataType_t out_types[] = {DATA_BF16};
+    gcapi::GlueCodeReturn_t status = check_tensors(in_defs, 4, 1, in_types, out_types);
+    if (status != gcapi::GLUE_SUCCESS) return status;
+
+    const unsigned heads = in_defs->inputTensors[0].geometry.sizes[1];
+    out_defs->indexSpaceGeometry.dims = 1;
+    out_defs->indexSpaceGeometry.sizes[0] = heads;
+    for (unsigned t = 0; t < 4; ++t) {
+        set_slot_transform(out_defs->inputTensorAccessPattern[t], 0, 1.0f);
+    }
+    set_slot_transform(out_defs->outputTensorAccessPattern[0], 0, 1.0f);
+
+    unsigned words[4] = {0};
+    if (!copy_params(words, 1, user_params, params_size, &status)) {
+        return status;
+    }
+    out_defs->kernel.paramsNr = 1;
+    std::memcpy(&out_defs->kernel.scalarParams[0], words, 4);
+
+    return publish_elf(out_defs, &_binary_glm5_dsa_attention_f32_gaudi2_o_start,
+                       &_binary_glm5_dsa_attention_f32_gaudi2_o_end);
+}
+
+// ---------------------------------------------------------------------------
+// glm5_moe_route_bf16: logits BF16 [experts, tokens], correction_bias F32
+// [experts,1] -> weights F32 [top_k, tokens], indices INT32 [top_k, tokens].
+// One slot per token; the slot scans the whole expert axis.
+
+extern "C" gcapi::GlueCodeReturn_t glm5_moe_route_get_gc_definitions(
+    gcapi::HabanaKernelParams_t* in_defs, gcapi::HabanaKernelInstantiation_t* out_defs,
+    const void* user_params, unsigned params_size) {
+    using gcapi::DATA_BF16;
+    using gcapi::DATA_F32;
+    using gcapi::DATA_I32;
+    const gcapi::TensorDataType_t in_types[] = {DATA_BF16, DATA_F32};
+    const gcapi::TensorDataType_t out_types[] = {DATA_F32, DATA_I32};
+    gcapi::GlueCodeReturn_t status = check_tensors(in_defs, 2, 2, in_types, out_types);
+    if (status != gcapi::GLUE_SUCCESS) return status;
+
+    const unsigned tokens = in_defs->inputTensors[0].geometry.sizes[1];
+    out_defs->indexSpaceGeometry.dims = 1;
+    out_defs->indexSpaceGeometry.sizes[0] = tokens;
+    set_slot_transform(out_defs->inputTensorAccessPattern[0], 0, 1.0f);
+    set_slot_transform(out_defs->inputTensorAccessPattern[1], 0, 1.0f);
+    set_slot_transform(out_defs->outputTensorAccessPattern[0], 0, 1.0f);
+    set_slot_transform(out_defs->outputTensorAccessPattern[1], 0, 1.0f);
+
+    unsigned words[4] = {0};
+    if (!copy_params(words, 2, user_params, params_size, &status)) {
+        return status;
+    }
+    // The routed outputs are [top_k, tokens]; their extent must match.
+    if (words[0] != in_defs->outputTensors[0].geometry.sizes[0]) {
+        return gcapi::GLUE_KERNEL_INVALID_SCALAR_ARGUMENT;
+    }
+    out_defs->kernel.paramsNr = 2;
+    std::memcpy(&out_defs->kernel.scalarParams[0], words, 8);
+
+    return publish_elf(out_defs, &_binary_glm5_moe_route_bf16_gaudi2_o_start,
+                       &_binary_glm5_moe_route_bf16_gaudi2_o_end);
+}
diff --git a/src/core/gaudi2/tpc/glue/tests/glue_check.c b/src/core/gaudi2/tpc/glue/tests/glue_check.c
new file mode 100644
index 0000000..2cb875d
--- /dev/null
+++ b/src/core/gaudi2/tpc/glue/tests/glue_check.c
@@ -0,0 +1,183 @@
+// Offline descriptor round-trip: call GetGcDefinitions for every GUID with
+// well-formed HabanaKernelParams_t descriptors and verify each returns a
+// non-empty ELF, a sane index space, and its scalar params.
+#include "gc_interface.h"
+
+#include <cstdio>
+#include <cstring>
+#include <dlfcn.h>
+
+typedef gcapi::GlueCodeReturn_t (*defs_fn)(const char*, gcapi::DeviceId_t,
+                                           const void*, unsigned,
+                                           gcapi::HabanaKernelParams_t*,
+                                           gcapi::HabanaKernelInstantiation_t*);
+typedef gcapi::GlueCodeReturn_t (*names_fn)(char**, unsigned*, gcapi::DeviceId_t);
+
+struct Case {
+    const char* name;
+    unsigned in_nr, out_nr;
+    gcapi::TensorDataType_t in_types[6];
+    gcapi::TensorDataType_t out_types[2];
+    unsigned out_width;   // first output FCD
+    unsigned out_tokens;  // dim1 (0 = 1-D)
+    unsigned scalar_words[4];  // the host bridge's ABI block
+    unsigned scalar_count;
+    unsigned ispace0, ispace1;  // the EXACT expected index space
+};
+
+int main() {
+    void* so = dlopen("/tmp/glm5-tpc-glue/libglm5_tpc.so", RTLD_NOW);
+    if (!so) { std::printf("dlopen: %s\n", dlerror()); return 1; }
+    defs_fn get_defs = (defs_fn)dlsym(so, "GetGcDefinitions");
+    names_fn get_names = (names_fn)dlsym(so, "GetKernelNames");
+    if (!get_defs || !get_names) { std::printf("entries missing\n"); return 1; }
+
+    using gcapi::DATA_BF16;
+    using gcapi::DATA_F32;
+    using gcapi::DATA_I32;
+    // Geometry per case: the pooled output of dsa_pool is {512, pools} while
+    // its sources are {512, T} and the ape {512, K}; dsa_select runs the
+    // production width W=2051 (top_pools 512, K 4, tail) from a [512] score;
+    // kda_scan's beta carries heads=64; every row pins its EXACT index space.
+    const Case cases[] = {
+        {"glm5_rmsnorm_bf16", 2, 1, {DATA_BF16, DATA_BF16}, {DATA_BF16}, 512, 1,
+         {0x3727c5acu, 0x3a000000u}, 2, 1, 1},
+        {"glm5_clamp_swiglu_bf16", 1, 1, {DATA_BF16}, {DATA_BF16}, 512, 1,
+         {0x41200000u}, 1, 512, 1},
+        {"glm5_kda_gate_bf16", 2, 1, {DATA_BF16, DATA_F32}, {DATA_F32}, 512, 1,
+         {0xc0a00000u, 128u}, 2, 4, 1},
+        {"glm5_mhc_gates_bf16", 4, 1,
+         {DATA_BF16, DATA_BF16, DATA_F32, DATA_F32}, {DATA_F32}, 24, 1,
+         {0x358637bdu, 0x358637bdu, 20u}, 3, 1, 1},
+        {"glm5_mhc_collapse_bf16", 2, 1, {DATA_BF16, DATA_F32}, {DATA_BF16}, 512, 1,
+         {0u}, 0, 512, 1},
+        {"glm5_mhc_post_bf16", 4, 1,
+         {DATA_BF16, DATA_BF16, DATA_F32, DATA_F32}, {DATA_BF16}, 512, 1,
+         {0u}, 0, 512, 1},
+        {"glm5_mhc_head_bf16", 1, 1, {DATA_BF16}, {DATA_BF16}, 512, 1,
+         {0u}, 0, 512, 1},
+        {"glm5_moe_route_bf16", 2, 2, {DATA_BF16, DATA_F32}, {DATA_F32, DATA_I32},
+         8, 1, {8u, 0x40200000u}, 2, 1, 1},
+        {"glm5_moe_combine_bf16", 3, 1, {DATA_BF16, DATA_F32, DATA_BF16},
+         {DATA_BF16}, 512, 1, {8u}, 1, 512, 1},
+        {"glm5_dsa_pool_bf16", 3, 1, {DATA_BF16, DATA_BF16, DATA_F32},
+         {DATA_F32}, 512, 4, {4u}, 1, 4, 512},
+        {"glm5_dsa_score_f32", 3, 1, {DATA_BF16, DATA_F32, DATA_F32},
+         {DATA_F32}, 4, 1, {0u}, 0, 1, 1},
+        {"glm5_dsa_select_f32", 1, 1, {DATA_F32}, {DATA_I32}, 2051, 0,
+         {2047u, 4u, 512u, 1u}, 4, 1, 1},
+        {"glm5_dsa_attention_f32", 4, 1,
+         {DATA_BF16, DATA_BF16, DATA_I32, DATA_BF16}, {DATA_BF16}, 512, 2,
+         {0x3d800000u}, 1, 2, 1},
+        {"glm5_dsa_absorb_bf16", 2, 1, {DATA_BF16, DATA_BF16}, {DATA_F32}, 512, 2,
+         {0u}, 0, 2, 1},
+        {"glm5_kda_scan_f32", 6, 2,
+         {DATA_BF16, DATA_BF16, DATA_BF16, DATA_F32, DATA_F32, DATA_F32},
+         {DATA_F32, DATA_BF16}, 8192, 1, {128u}, 1, 64, 1},
+        {"glm5_dsa_scale_f32", 1, 1, {DATA_F32}, {DATA_F32}, 512, 1,
+         {0x3f000000u}, 1, 512, 1},
+    };
+    const unsigned count = sizeof(cases) / sizeof(cases[0]);
+
+    // Name-list round-trip first.
+    unsigned listed = 0;
+    if (get_names(nullptr, &listed, gcapi::DEVICE_ID_GAUDI2) != gcapi::GLUE_SUCCESS ||
+        listed != count) {
+        std::printf("FAIL name count: %u vs %u\n", listed, count);
+        return 1;
+    }
+
+    int failures = 0;
+    for (unsigned c = 0; c < count; ++c) {
+        const Case& k = cases[c];
+        gcapi::HabanaKernelParams_t params{};
+        params.inputTensorNr = k.in_nr;
+        params.outputTensorNr = k.out_nr;
+        for (unsigned i = 0; i < k.in_nr; ++i) {
+            params.inputTensors[i].dataType = k.in_types[i];
+            params.inputTensors[i].geometry.dims = 2;
+            params.inputTensors[i].geometry.sizes[0] = k.out_width;
+            params.inputTensors[i].geometry.sizes[1] = k.out_tokens ? k.out_tokens : 1;
+        }
+        for (unsigned o = 0; o < k.out_nr; ++o) {
+            params.outputTensors[o].dataType = k.out_types[o];
+            params.outputTensors[o].geometry.dims = 2;
+            params.outputTensors[o].geometry.sizes[0] = k.out_width;
+            params.outputTensors[o].geometry.sizes[1] = k.out_tokens ? k.out_tokens : 1;
+        }
+
+        // Per-case real geometries the blanket fill cannot express.
+        if (std::strcmp(k.name, "glm5_kda_scan_f32") == 0) {
+            params.inputTensors[4].geometry.sizes[0] = 64;  // beta: heads
+        }
+        if (std::strcmp(k.name, "glm5_dsa_pool_bf16") == 0) {
+            // Sources {dim, T=16}, ape {dim, K=4}, pooled {dim, pools=4}.
+            params.inputTensors[0].geometry.sizes[1] = 16;
+            params.inputTensors[1].geometry.sizes[1] = 16;
+            params.inputTensors[2].geometry.sizes[1] = 4;
+        }
+        if (std::strcmp(k.name, "glm5_dsa_select_f32") == 0) {
+            // The production selection: score [512], cells W = 2051.
+            params.inputTensors[0].geometry.sizes[0] = 512;
+        }
+
+        gcapi::HabanaKernelInstantiation_t inst{};
+        static unsigned char elf[65536];
+        inst.kernelElf = elf;
+        inst.elfSize = sizeof(elf);
+
+        const gcapi::GlueCodeReturn_t status =
+            get_defs(k.name, gcapi::DEVICE_ID_GAUDI2, k.scalar_words,
+                     k.scalar_count * sizeof(unsigned), &params, &inst);
+        if (status != gcapi::GLUE_SUCCESS) {
+            std::printf("FAIL %s: glue returned %d\n", k.name, status);
+            ++failures;
+            continue;
+        }
+        if (inst.elfSize == 0 || inst.elfSize >= sizeof(elf)) {
+            std::printf("FAIL %s: bad elf size %u\n", k.name, inst.elfSize);
+            ++failures;
+            continue;
+        }
+        if (inst.indexSpaceGeometry.dims == 0 ||
+            inst.indexSpaceGeometry.sizes[0] == 0) {
+            std::printf("FAIL %s: empty index space\n", k.name);
+            ++failures;
+            continue;
+        }
+        // The EXACT scheduling: a wrong unit (slots vs elements) or a
+        // double division produces a non-zero but wrong space.
+        const unsigned got1 = inst.indexSpaceGeometry.dims > 1
+                                  ? inst.indexSpaceGeometry.sizes[1] : 1;
+        // Access-pattern audit for the vector-slot kernel: BOTH tensor axes
+        // must map (dim0 -> slots at stride 128, dim1 -> tokens 1:1). The
+        // unmapped token axis of review T1 left multi-token descriptors
+        // half-unreachable while the index space still looked right.
+        if (std::strcmp(k.name, "glm5_kda_gate_bf16") == 0) {
+            const gcapi::TensorAccessPattern_t* pat =
+                inst.inputTensorAccessPattern;
+            if (!pat || pat[0].dim[0].indexSpaceDim != 0 ||
+                pat[0].dim[0].start_a != 128.0f ||
+                pat[0].dim[1].indexSpaceDim != 1 ||
+                pat[0].dim[1].start_a != 1.0f) {
+                std::printf("FAIL %s: access pattern axes unmapped
+", k.name);
+                ++failures;
+                continue;
+            }
+        }
+        if (inst.indexSpaceGeometry.sizes[0] != k.ispace0 || got1 != k.ispace1) {
+            std::printf("FAIL %s: ispace %ux%u, expected %ux%u\n", k.name,
+                        inst.indexSpaceGeometry.sizes[0], got1,
+                        k.ispace0, k.ispace1);
+            ++failures;
+            continue;
+        }
+        std::printf("ok %s: elf %u B, ispace %ux%u\n", k.name, inst.elfSize,
+                    inst.indexSpaceGeometry.sizes[0], got1);
+    }
+    dlclose(so);
+    if (failures) { std::printf("%d failures\n", failures); return 1; }
+    std::printf("all %u glue descriptors round-trip\n", count);
+    return 0;
+}
diff --git a/src/core/gaudi2/tpc/include/glm5_tpc.h b/src/core/gaudi2/tpc/include/glm5_tpc.h
new file mode 100644
index 0000000..4890ea2
--- /dev/null
+++ b/src/core/gaudi2/tpc/include/glm5_tpc.h
@@ -0,0 +1,395 @@
+#pragma once
+// GLM-5.3-Flash TPC kernel wrappers: build SynapseAI graphs that compose TPC
+// custom kernels with the closed Bf16Gemm MME recipe. Each wrapper compiles
+// a static graph once and launches it per token through the runtime adapter's
+// DMA lease model.
+//
+// The TPC-C device kernel sources live in tpc/kernels/*.c (compiled by the
+// HabanaTools GC when targeting real hardware). The host bridges here create
+// tensor descriptors, instantiate the graph, and manage launch through the
+// existing Device/Stream/Recipe/Compute contract from core/gaudi2/runtime.h.
+//
+// Offline testing: the fake_synapse test double validates graph construction,
+// resource ownership, and DMA lifetimes. Kernel math is verified by the CUDA
+// executor tests against the same host reference implementations.
+
+#include "core/gaudi2/runtime.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace ninfer::gaudi2::tpc {
+
+// ---------------------------------------------------------------------------
+// RMSNorm: out[d,t] = x[d,t] * rsqrt(mean(x[_,t]^2) + eps) * weight[d]
+// BF16 input/output, FP32 internal accumulation.
+
+struct RmsNormShape {
+    std::uint32_t width;   // D (fastest dimension)
+    std::uint32_t tokens;  // T
+};
+
+class RmsNorm {
+public:
+    RmsNorm(const Device& device, RmsNormShape shape, float epsilon,
+            std::size_t max_workspace_bytes);
+    // Launches the kernel. x: BF16 [D, T], weight: BF16 [D], out: BF16 [D, T].
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& x, DeviceBuffer& weight,
+                                 DeviceBuffer& out);
+    [[nodiscard]] RmsNormShape shape() const noexcept { return shape_; }
+    [[nodiscard]] std::size_t workspace_bytes() const noexcept { return recipe_.workspace_bytes(); }
+private:
+    RmsNormShape shape_;
+    float epsilon_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 3> tensor_ids_{};
+};
+
+// ---------------------------------------------------------------------------
+// clamp SwiGLU: out[i,t] = silu(min(gate[i,t], limit)) * clamp(up[i,t], -limit, limit)
+// Input h: BF16 [2*I, T] (gate in rows [0,I), up in rows [I,2I)).
+// Output out: BF16 [I, T]. FP32 internal, single BF16 round at output.
+
+struct ClampSwigluShape {
+    std::uint32_t inner;  // I (half of input width)
+    std::uint32_t tokens;
+};
+
+class ClampSwiglu {
+public:
+    ClampSwiglu(const Device& device, ClampSwigluShape shape, float limit,
+                std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& h, DeviceBuffer& out);
+    [[nodiscard]] ClampSwigluShape shape() const noexcept { return shape_; }
+private:
+    ClampSwigluShape shape_;
+    float limit_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 2> tensor_ids_{};
+};
+
+// ---------------------------------------------------------------------------
+// KDA decay gate: gate[i] = lower_bound * sigmoid(exp(A_log[h]) * a[i])
+// Input a: BF16 [d_inner, T], A_log: FP32 [heads].
+// Output gate: FP32 [d_inner, T] (log space, ready for exp in the recurrence).
+
+struct KdaGateShape {
+    std::uint32_t d_inner;
+    std::uint32_t heads;
+    std::uint32_t head_dim;
+    std::uint32_t tokens;
+};
+
+class KdaGate {
+public:
+    KdaGate(const Device& device, KdaGateShape shape, float lower_bound,
+            std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& a, DeviceBuffer& a_log,
+                                 DeviceBuffer& gate);
+    [[nodiscard]] KdaGateShape shape() const noexcept { return shape_; }
+private:
+    KdaGateShape shape_;
+    float lower_bound_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 3> tensor_ids_{};
+};
+
+// ---------------------------------------------------------------------------
+// KDA delta recurrence (single token, all heads): the sequential scan.
+// q,k,v: BF16 [d_inner] (one token), gate: FP32 [d_inner] (log space),
+// beta: FP32 [heads], state: FP32 [heads, head_dim, head_dim] (row = key axis,
+// updated in place). out: BF16 [d_inner]. The l2norm and scale are inside.
+
+struct KdaScanShape {
+    std::uint32_t heads;
+    std::uint32_t head_dim;
+};
+
+class KdaScan {
+public:
+    KdaScan(const Device& device, KdaScanShape shape,
+            std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& q, DeviceBuffer& k,
+                                 DeviceBuffer& v, DeviceBuffer& gate, DeviceBuffer& beta,
+                                 DeviceBuffer& state, DeviceBuffer& out);
+    [[nodiscard]] KdaScanShape shape() const noexcept { return shape_; }
+private:
+    KdaScanShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 7> tensor_ids_{};
+};
+
+// ---------------------------------------------------------------------------
+// mHC gates: the 24-lane weight generation for one mHC site. The raw fn
+// projections arrive as BF16 [24, T] (MME GEMM output); the kernel scans the
+// four streams for the RMS, applies the sigmoid/scale/base gates, and runs
+// the 4x4 Sinkhorn. gates out: FP32 [24, T] = pre[0:4] | post[4:8] |
+// comb[8:24] with comb entry (src, dst) at 8 + 4*src + dst.
+
+struct MhcGatesShape {
+    std::uint32_t hidden;  // H (one stream's width; streams are [4H, T])
+    std::uint32_t tokens;
+};
+
+class MhcGates {
+public:
+    MhcGates(const Device& device, MhcGatesShape shape, float rms_eps,
+             float hc_eps, std::uint32_t sinkhorn_iters,
+             std::size_t max_workspace_bytes);
+    // streams: BF16 [4H, T], mixes: BF16 [24, T], base: FP32 [24, 1],
+    // scale: FP32 [3, 1], gates: FP32 [24, T].
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& streams,
+                                 DeviceBuffer& mixes, DeviceBuffer& base,
+                                 DeviceBuffer& scale, DeviceBuffer& gates);
+    [[nodiscard]] MhcGatesShape shape() const noexcept { return shape_; }
+private:
+    MhcGatesShape shape_;
+    float rms_eps_, hc_eps_;
+    std::uint32_t sinkhorn_iters_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 5> tensor_ids_{};
+};
+
+// mHC collapse: collapsed[t, :] = Σ_n pre[t,n] * streams[t, n*H + :].
+// pre: FP32 [4, T]; streams: BF16 [4H, T]; out: BF16 [H, T].
+
+class MhcCollapse {
+public:
+    MhcCollapse(const Device& device, MhcGatesShape shape,
+                std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& streams,
+                                 DeviceBuffer& pre, DeviceBuffer& out);
+    [[nodiscard]] MhcGatesShape shape() const noexcept { return shape_; }
+private:
+    MhcGatesShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 3> tensor_ids_{};
+};
+
+// mHC post-block stream update: out[t,dst,:] = post[t,dst]*block[t,:] +
+// Σ_src comb[t,src,dst]*residual[t,src,:]. block: BF16 [H, T];
+// residual: BF16 [4H, T]; post: FP32 [4, T]; comb: FP32 [16, T] (row
+// 4*src+dst); out: BF16 [4H, T].
+
+class MhcPost {
+public:
+    MhcPost(const Device& device, MhcGatesShape shape,
+            std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& block,
+                                 DeviceBuffer& residual, DeviceBuffer& post,
+                                 DeviceBuffer& comb, DeviceBuffer& out);
+    [[nodiscard]] MhcGatesShape shape() const noexcept { return shape_; }
+private:
+    MhcGatesShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 5> tensor_ids_{};
+};
+
+// mHC head: out[t, :] = (1/4) Σ_n streams[t, n*H + :].
+// streams: BF16 [4H, T]; out: BF16 [H, T].
+
+class MhcHead {
+public:
+    MhcHead(const Device& device, MhcGatesShape shape,
+            std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& streams,
+                                 DeviceBuffer& out);
+    [[nodiscard]] MhcGatesShape shape() const noexcept { return shape_; }
+private:
+    MhcGatesShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 2> tensor_ids_{};
+};
+
+// ---------------------------------------------------------------------------
+// MoE sigmoid router with noaux_tc: score = sigmoid(logits); top_k ranked by
+// score + correction_bias (stable descending, ties by lower expert); weights
+// are the ORIGINAL scores normalized (sum + 1e-20) and scaled by
+// routed_scaling_factor. logits: BF16 [E, T]; correction_bias: FP32 [E, 1];
+// weights: FP32 [top_k, T]; indices: Int32 [top_k, T].
+
+struct MoeRouteShape {
+    std::uint32_t experts;  // E (<= 512)
+    std::uint32_t top_k;
+    std::uint32_t tokens;
+};
+
+class MoeRoute {
+public:
+    MoeRoute(const Device& device, MoeRouteShape shape, float routed_scaling_factor,
+             std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& logits,
+                                 DeviceBuffer& correction_bias, DeviceBuffer& weights,
+                                 DeviceBuffer& indices);
+    [[nodiscard]] MoeRouteShape shape() const noexcept { return shape_; }
+private:
+    MoeRouteShape shape_;
+    float routed_scaling_factor_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 4> tensor_ids_{};
+};
+
+// ---------------------------------------------------------------------------
+// DSA indexer pooling: pooled[p, e] = Σ_m softmax_m(ig[p*K+m, e] + ape[m, e])
+// * ik[p*K+m, e], the softmax running per key-dim element over the K pool
+// members. ik/ig: BF16 [D, T] (T a multiple of K); ape: FP32 [D, K];
+// pooled: FP32 [D, T/K].
+
+struct DsaPoolShape {
+    std::uint32_t dim;    // D (key-dim width)
+    std::uint32_t tokens; // T = pools * K
+    std::uint32_t pool_k; // K (<= 16)
+};
+
+class DsaPool {
+public:
+    DsaPool(const Device& device, DsaPoolShape shape, std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& ik, DeviceBuffer& ig,
+                                 DeviceBuffer& ape, DeviceBuffer& pooled);
+    [[nodiscard]] DsaPoolShape shape() const noexcept { return shape_; }
+private:
+    DsaPoolShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 4> tensor_ids_{};
+};
+
+// DSA indexer scoring: score[p] = Σ_h relu(iq[h, :] . pooled[p, :]) *
+// weights[h] (weights pre-scaled by 1/sqrt(D*H) by the caller).
+// iq: BF16 [D, H]; pooled: FP32 [D, P]; weights: FP32 [H, 1]; score: FP32 [P, 1].
+
+struct DsaScoreShape {
+    std::uint32_t dim;   // D
+    std::uint32_t heads; // H (index heads)
+    std::uint32_t pools; // P
+};
+
+class DsaScore {
+public:
+    DsaScore(const Device& device, DsaScoreShape shape, std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& iq, DeviceBuffer& pooled,
+                                 DeviceBuffer& weights, DeviceBuffer& score);
+    [[nodiscard]] DsaScoreShape shape() const noexcept { return shape_; }
+private:
+    DsaScoreShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 4> tensor_ids_{};
+};
+
+// DSA pool selection: ranks the visible pools stable-descending (ties by
+// lower index), writes the top_pools runs of K cells plus the optional
+// incomplete tail; unused slots of W = top_pools*K + (K-1) stay -1.
+// score: FP32 [P, 1] (P <= 512); cells: Int32 [W, 1].
+
+struct DsaSelectShape {
+    std::uint32_t pools;     // P
+    std::uint32_t pool_k;    // K
+    std::uint32_t top_pools; // ranked pools emitted as K-cell runs
+    std::uint32_t slots;     // W = top_pools*K + (K-1) fixed width
+};
+
+class DsaSelect {
+public:
+    DsaSelect(const Device& device, DsaSelectShape shape, std::uint32_t position,
+              bool select_tail, std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& score, DeviceBuffer& cells);
+    [[nodiscard]] DsaSelectShape shape() const noexcept { return shape_; }
+private:
+    DsaSelectShape shape_;
+    std::uint32_t position_;
+    std::int32_t select_tail_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 2> tensor_ids_{};
+};
+
+// DSA absorbed sparse attention over one token's selection row (decode).
+// q_abs: BF16 [lora, H]; latents: BF16 [lora, cache]; cells: Int32 [W, 1];
+// wv_b: BF16 [lora*v_head*H, 1] (GGUF {lora, v_head, H} layout);
+// out: BF16 [H*v_head, 1]; qk_scale precomputed (the 256^-0.5 constant).
+
+struct DsaAttentionShape {
+    std::uint32_t heads;   // H
+    std::uint32_t lora;    // kv_lora (<= 1024, 128-multiple register blocks)
+    std::uint32_t v_head;  // value width per head
+    std::uint32_t cache;   // latent cache rows
+    std::uint32_t slots;   // W (selection row width)
+};
+
+class DsaAttention {
+public:
+    DsaAttention(const Device& device, DsaAttentionShape shape, float qk_scale,
+                 std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& q_abs, DeviceBuffer& latents,
+                                 DeviceBuffer& cells, DeviceBuffer& wv_b, DeviceBuffer& out);
+    [[nodiscard]] DsaAttentionShape shape() const noexcept { return shape_; }
+private:
+    DsaAttentionShape shape_;
+    float qk_scale_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 5> tensor_ids_{};
+};
+
+// DSA query absorption: q_abs[h, e] = Σ_d q[h, d] * wk_b[d + nope*e +
+// nope*lora*h]. q: BF16 [nope, H]; wk_b: BF16 [nope*lora*H, 1];
+// q_abs: FP32 [lora, H].
+
+struct DsaAbsorbShape {
+    std::uint32_t heads; // H
+    std::uint32_t nope;  // qk_nope head dim
+    std::uint32_t lora;  // kv_lora rank
+};
+
+class DsaAbsorb {
+public:
+    DsaAbsorb(const Device& device, DsaAbsorbShape shape, std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& q, DeviceBuffer& wk_b,
+                                 DeviceBuffer& q_abs);
+    [[nodiscard]] DsaAbsorbShape shape() const noexcept { return shape_; }
+private:
+    DsaAbsorbShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 3> tensor_ids_{};
+};
+
+// Elementwise FP32 scaling: out = values * factor ([N, 1] planes).
+
+class DsaScale {
+public:
+    DsaScale(const Device& device, std::uint32_t width, float factor,
+             std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& values, DeviceBuffer& out);
+    [[nodiscard]] std::uint32_t width() const noexcept { return width_; }
+private:
+    std::uint32_t width_;
+    float factor_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 2> tensor_ids_{};
+};
+
+// MoE expert combination: out[t,:] = Σ_i weights[t,i] * experts[t,i,:]
+// + shared[t,:]. experts: BF16 [top_k*H, T]; weights: FP32 [top_k, T];
+// shared: BF16 [H, T]; out: BF16 [H, T].
+
+struct MoeCombineShape {
+    std::uint32_t hidden;  // H
+    std::uint32_t top_k;
+    std::uint32_t tokens;
+};
+
+class MoeCombine {
+public:
+    MoeCombine(const Device& device, MoeCombineShape shape,
+               std::size_t max_workspace_bytes);
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& experts,
+                                 DeviceBuffer& weights, DeviceBuffer& shared,
+                                 DeviceBuffer& out);
+    [[nodiscard]] MoeCombineShape shape() const noexcept { return shape_; }
+private:
+    MoeCombineShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 4> tensor_ids_{};
+};
+
+} // namespace ninfer::gaudi2::tpc
