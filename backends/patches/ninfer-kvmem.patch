+enum synTensorType { DATA_TENSOR = 0 };
+enum synDataType { syn_type_bf16 = 2 };
+enum synGeometryType { synGeometrySizes = 1 };
+enum synRoundingMode { synRoundToNearest = 1 };
+struct synTensorGeometry { std::uint64_t sizes[25]; std::uint32_t dims; };
+struct synGEMMParams {
+    synGEMMParams(bool a = false, bool b = false) : transpose_a(a), transpose_b(b) {}
+    bool transpose_a; bool transpose_b;
+};
+struct synLaunchTensorInfoExt {
+    const char* tensorName; std::uint64_t pTensorAddress; synTensorType tensorType;
+    std::uint64_t tensorSize[25]; std::uint64_t tensorId;
+};
+extern "C" {
+synStatus synInitialize();
+synStatus synDestroy();
+synStatus synDeviceAcquireByDeviceType(synDeviceId*, synDeviceType);
+synStatus synDeviceRelease(synDeviceId);
+synStatus synDeviceGetMemoryInfo(synDeviceId, std::uint64_t*, std::uint64_t*);
+synStatus synDeviceMalloc(synDeviceId, std::uint64_t, std::uint64_t, std::uint32_t, std::uint64_t*);
+synStatus synDeviceFree(synDeviceId, std::uint64_t, std::uint32_t);
+synStatus synHostMalloc(synDeviceId, std::uint64_t, std::uint32_t, void**);
+synStatus synHostFree(synDeviceId, const void*, std::uint32_t);
+synStatus synStreamCreateGeneric(synStreamHandle*, synDeviceId, std::uint32_t);
+synStatus synStreamDestroy(synStreamHandle);
+synStatus synStreamSynchronize(synStreamHandle);
+synStatus synEventCreate(synEventHandle*, synDeviceId, std::uint32_t);
+synStatus synEventDestroy(synEventHandle);
+synStatus synEventRecord(synEventHandle, synStreamHandle);
+synStatus synEventQuery(synEventHandle);
+synStatus synEventSynchronize(synEventHandle);
+synStatus synMemCopyAsync(synStreamHandle, std::uint64_t, std::uint64_t, std::uint64_t, synDmaDir);
