new file mode 100644
index 0000000000000000000000000000000000000000..fde36e5495bf70e084def8c4d7b4536f5d95ffa0
--- /dev/null
+++ b/include/ninfer/ops/glm5_kda.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h> // cudaStream_t
+
+namespace ninfer::ops {
+
+/**
+ * Prepares GLM-5.3-Flash KDA gates for T tokens (the safe path):
+ *
+ *   gate[t, h*D+i] = lower_bound * sigmoid(exp(A_log[h]) * a[t, h*D+i])   (LOG space, <= 0)
+ *   beta[t, h]     = sigmoid(b[t, h]).
+ *
+ * `a` is the already-summed f_b(f_a(x)) + dt_bias plane as contiguous BF16 [D_inner, T]
+ * (fastest dimension the inner width), `b` contiguous BF16 [H, T], `A_log` contiguous FP32 [H]
+ * and `lower_bound` negative finite FP32. `gate` is contiguous FP32 [D_inner, T] and `beta`
+ * contiguous FP32 [H, T]. The oracle evaluates the formula naively in FP64 from the represented
+ * input; transcendental implementation and intermediate precision are private kernel choices.
+ * Inputs and outputs must be mutually non-overlapping. No workspace or persistent state.
+ */
+void glm5_kda_gating(const Tensor& a, const Tensor& b, const Tensor& A_log, float lower_bound,
+                     Tensor& gate, Tensor& beta, cudaStream_t stream);
+
+/**
+ * One KDA block's causal per-channel short conv followed by SiLU, over T tokens:
+ *
+ *   out[t, c] = silu(sum_tap w[c, tap] * window(t - (K-1) + tap, c))
+ *
+ * with the window reading the [K-1, D_inner] FP32 conv_state (oldest tap first) before the
+ * token plane, and conv_state advanced to the last K-1 columns of [conv_state | x]. `x` and
+ * `out` are contiguous BF16 [D_inner, T], `w` is the GGUF layout contiguous BF16 [K, D_inner]
+ * (fastest dimension the taps: w[c*K + tap]), `conv_state` is contiguous FP32 [D_inner, K-1]
+ * and is updated in place only after the whole plane computes. Padding-free: T >= 1.
+ */
+void glm5_kda_conv(const Tensor& x, const Tensor& w, Tensor& conv_state, Tensor& out,
+                   cudaStream_t stream);
+
+/**
+ * One single-token KDA decode step over every head at once (the recurrent
+ * algorithm; chunk prefill is a separate future op):
+ *
+ *   qh = l2norm(q_h) * dk^-0.5 ; kh = l2norm(k_h)                  (eps 1e-6)
+ *   S[i, :] *= exp(gate_h[i])                                       (key-axis rows)
+ *   u[j]    = sum_i S[i, j] * kh[i]
+ *   delta[j]= beta_h * (v_h[j] - u[j])
+ *   S[i, j]+= kh[i] * delta[j]
+ *   o_h[j]  = sum_i S[i, j] * qh[i]
+ *   out_h   = rms(o_h) * o_norm_w * sigmoid(g2_h)                   (eps 1e-6, FP32)
+ *
+ * `q`, `k`, `v`, `g2` are contiguous BF16 [D_inner] (head h at h*D..h*D+D), `gate` is
+ * contiguous FP32 [D_inner] in LOG space, `beta` contiguous FP32 [H], `o_norm_w` contiguous
+ * FP32 [D], and `state` is contiguous FP32 [H, D, D] (row = key axis), updated in place.
+ * `out` is contiguous BF16 [D_inner]. D must be <= 256. The oracle is the host reference
+ * (models/glm5/reference/kda_reference) in FP32; kernel reduction order is a private choice.
+ */
+void glm5_kda_decode_step(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                          const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                          Tensor& state, Tensor& out, cudaStream_t stream);
+
+/**
+ * The prefill companion: the SAME recurrent math as glm5_kda_decode_step applied to T tokens
+ * in a loop, one head per block (state resident in global memory, the head slice never
+ * leaves registers/shared). Numerically one decode_step per token; the chunked prefill
+ * algorithm is a future throughput path, not a different result. `q`/`k`/`v` are BF16
+ * [D_inner, T] (the conv output plane), `gate` FP32 [D_inner, T] log space, `beta` FP32
+ * [H, T], `g2` BF16 [D_inner, T]; `state` FP32 [H, D, D] carries in and out; `out` is BF16
+ * [D_inner, T].
+ */
+void glm5_kda_prefill(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                      const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                      Tensor& state, Tensor& out, cudaStream_t stream);
+
+} // namespace ninfer::ops
