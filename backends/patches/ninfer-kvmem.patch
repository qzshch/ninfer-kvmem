+    mw.dsa_ape[0] = d_ape.data();
+
+    auto& l0 = mw.layers[0];
+    l0.is_dsa = false; l0.mlp_is_dense = false;
+    l0.hc_attn_fn = execution::bf16_weight(d_hcfn[0].data(), 24, 4 * H);
+    l0.hc_attn_base = execution::bf16_weight(d_hcbase[0].data(), 24, 1);
+    l0.hc_attn_scale = execution::bf16_weight(d_hcscale[0].data(), 3, 1);
+    l0.hc_ffn_fn = execution::bf16_weight(d_hcfn[1].data(), 24, 4 * H);
+    l0.hc_ffn_base = execution::bf16_weight(d_hcbase[1].data(), 24, 1);
+    l0.hc_ffn_scale = execution::bf16_weight(d_hcscale[1].data(), 3, 1);
+    l0.attn_norm = execution::bf16_weight(d_anorm[0].data(), H, 1);
+    l0.ffn_norm = execution::bf16_weight(d_fnorm[0].data(), H, 1);
+    l0.kda.attn_norm = l0.attn_norm;
