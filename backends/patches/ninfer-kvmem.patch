+"""GLM-5.3-Flash GGUF tensor inventory: the llama.cpp names (fixed upstream commit
+e1e3b2c4, audited 2026-10-25) mapped to the engine's per-block parameter roles, with the
+geometry each role carries in the audited 45-block profile. This is the mapping table the
+weight importer walks; it does not read or write tensor payloads.
+
+Layout notes cross-checked against llama.cpp's create_tensor shapes and Maya's kernels:
+- KDA q/k/v keep SEPARATE projections and SEPARATE causal convs (three wq/wk/wv and three
+  ssm_conv1d_{q,k,v}); the conv weight is GGUF {d_conv, 1, d_inner} (taps fastest).
+- The decay gate is the two-stage low-rank f_a (hidden -> head_dim) then f_b
+  (head_dim -> d_inner) plus the dt bias; A is the per-head negative rate
+  (-exp(A_log), stored as ssm_a_noscan without scanning it as a sequence).
+- beta is a per-head projection with sigmoid; the output gate is g_a (hidden -> head_dim)
+  then g_b (head_dim -> d_inner) with the RMS-normed o_norm weight.
+- DSA blocks are NoPE-only MLA: q_a/q_a_norm/q_b, kv_a_mqa/kv_a_norm, the ABSORBED k_b and
+  v_b (v applied after attention), and the k-pool indexer set (attn_q_b from the q latent,
+  attn_k + LayerNorm weight AND bias, kpool_gate, proj, kpool_ape {head_dim, kpool}).
+- mHC keeps two full sites per block (attn and ffn), each fn {hc*hidden, 24} / base {24} /
+  scale {3}, laid out pre|post|comb with comb[dst + hc*src].
+- The MoE router is gate_inp + the correction bias (ffn_exp_probs_b); shared experts are
+  the shexp triple at the routed width; dense blocks (first three) use the plain FFN triple.
+"""
+
+from __future__ import annotations
+
+# (gguf tensor base name, role, present-in) per block; "all" covers KDA and DSA both.
+_BLOCK_TENSORS = [
+    # mixer-agnostic tails
+    ("attn_norm", "input_layernorm", "all"),
+    ("ffn_norm", "post_attention_layernorm", "all"),
+    ("hc_attn_fn", "mhc_attn_mix", "all"),
+    ("hc_attn_base", "mhc_attn_base", "all"),
+    ("hc_attn_scale", "mhc_attn_scale", "all"),
+    ("hc_ffn_fn", "mhc_ffn_mix", "all"),
+    ("hc_ffn_base", "mhc_ffn_base", "all"),
+    ("hc_ffn_scale", "mhc_ffn_scale", "all"),
+    # KDA mixer (linear_attention blocks)
+    ("wq", "kda_q_projection", "kda"),
+    ("wk", "kda_k_projection", "kda"),
+    ("wv", "kda_v_projection", "kda"),
+    ("wo", "mixer_output", "all"),
+    ("ssm_conv1d_q", "kda_q_conv", "kda"),
+    ("ssm_conv1d_k", "kda_k_conv", "kda"),
+    ("ssm_conv1d_v", "kda_v_conv", "kda"),
+    ("ssm_f_a", "kda_gate_stage_a", "kda"),
+    ("ssm_f_b", "kda_gate_stage_b", "kda"),
+    ("ssm_dt", "kda_gate_bias", "kda"),
+    ("ssm_a_noscan", "kda_a_log_rate", "kda"),
+    ("ssm_beta", "kda_beta_projection", "kda"),
+    ("ssm_g_a", "kda_out_gate_stage_a", "kda"),
+    ("ssm_g_b", "kda_out_gate_stage_b", "kda"),
+    ("ssm_norm", "kda_output_norm_weight", "kda"),
+    # DSA mixer (deepseek_sparse_attention blocks)
+    ("wq_a", "mla_q_lowrank_a", "dsa"),
+    ("wq_a_norm", "mla_q_latent_norm", "dsa"),
+    ("wq_b", "mla_q_lowrank_b", "dsa"),
+    ("wkv_a_mqa", "mla_kv_compress", "dsa"),
+    ("wk_b", "mla_absorbed_key_b", "dsa"),
+    ("wv_b", "mla_absorbed_value_b", "dsa"),
+    ("attn_kv_a_norm", "mla_latent_norm", "dsa"),
+    ("indexer_attn_q_b", "indexer_query_from_q_latent", "dsa"),
+    ("indexer_attn_k", "indexer_key_projection", "dsa"),
+    ("indexer_k_norm", "indexer_key_layernorm_weight", "dsa"),
+    ("indexer_k_norm_b", "indexer_key_layernorm_bias", "dsa"),
+    ("indexer_kpool_gate", "indexer_pool_gate", "dsa"),
+    ("indexer_proj", "indexer_head_weights", "dsa"),
+    ("indexer_kpool_ape", "indexer_pool_position_embedding", "dsa"),
+    # MLP: dense lead blocks vs sparse MoE
+    ("ffn_gate", "dense_gate", "dense"),
+    ("ffn_up", "dense_up", "dense"),
+    ("ffn_down", "dense_down", "dense"),
+    ("ffn_gate_inp", "moe_router", "sparse"),
+    ("ffn_exp_probs_b", "moe_correction_bias", "sparse"),
+    ("ffn_gate_exps", "moe_routed_gate", "sparse"),
+    ("ffn_up_exps", "moe_routed_up", "sparse"),
+    ("ffn_down_exps", "moe_routed_down", "sparse"),
+    ("ffn_gate_shexp", "moe_shared_gate", "sparse"),
+    ("ffn_up_shexp", "moe_shared_up", "sparse"),
+    ("ffn_down_shexp", "moe_shared_down", "sparse"),
+]
+
+_GLOBAL_TENSORS = [
+    ("token_embd", "token_embedding"),
+    ("output_norm", "final_norm"),
+    ("output", "lm_head"),
+]
+
+
+def block_tensor_names(blk: int, layer_type: str, mlp_kind: str = "sparse") -> dict[str, str]:
+    """The GGUF tensor names one block contributes: {role: 'blk.<n>.<base>.weight'}.
+    `layer_type` is 'linear_attention'/'deepseek_sparse_attention'; `mlp_kind` is
+    'dense'/'sparse'."""
+    kind = "kda" if layer_type == "linear_attention" else "dsa"
+    return {
+        role: f"blk.{blk}.{base}.weight"
+        for base, role, where in _BLOCK_TENSORS
+        if where == "all" or where == kind or where == mlp_kind
+    }
+
+
+def expected_tensors(layer_types: list[str], first_k_dense_replace: int) -> dict[str, set[str]]:
+    """Every GGUF tensor name the checkpoint holds, grouped by role. `layer_types` carries
+    'linear_attention'/'deepseek_sparse_attention' per block; the MLP kind is dense before
+    first_k_dense_replace and sparse after."""
+    result: dict[str, set[str]] = {}
+    def add(role: str, name: str) -> None:
+        result.setdefault(role, set()).add(name)
+
+    for base, role in _GLOBAL_TENSORS:
+        add(role, base + ".weight")
+    for blk, layer_type in enumerate(layer_types):
+        kind = "kda" if layer_type == "linear_attention" else "dsa"
+        mlp = "dense" if blk < first_k_dense_replace else "sparse"
+        for base, role, where in _BLOCK_TENSORS:
+            if where == "all" or where == kind or where == mlp:
+                add(role, f"blk.{blk}.{base}.weight")
+    return result
+
+
+def refused_reasons(layer_types: list[str], first_k_dense_replace: int,
+                    present: set[str]) -> list[str]:
+    """Why a checkpoint's tensor inventory cannot serve this engine: missing required
+    tensors per role. Extra tensors are ignored (vision towers, MTP blocks)."""
+    problems: list[str] = []
+    for role, names in expected_tensors(layer_types, first_k_dense_replace).items():
+        missing = sorted(names - present)
+        if missing:
+            problems.append(f"{role}: missing {missing[:4]}{'...' if len(missing) > 4 else ''}")
+    return problems
