+// GLM-5.3-Flash chunked prefill vs the per-token decode path, end to end on
+// the device: the same weights and token sequence run twice — T sequential
+// glm5_decode_token calls against one glm5_prefill_chunked call (chunk < T,
+// so the chunk-boundary state carry is exercised) — and the final logits
+// plus every persistent state plane must agree within the batched kernels'
+// reduction tolerance. Weight construction mirrors test_decode_step (KDA+MoE
+// layer, DSA+dense layer).
+#include "models/glm5/execution/model.h"
+
+#include "core/device.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
