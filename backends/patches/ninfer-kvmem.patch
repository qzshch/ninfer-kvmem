new file mode 100644
index 0000000000000000000000000000000000000000..2079ed017fd90b48c6af359914d70fa647d4e0c2
--- /dev/null
+++ b/src/ops/kernel/glm5_mhc.cuh
@@ -0,0 +1,202 @@
+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash mHC kernels: the fused weight generation + collapse for one
+// hyper-connection site (decode path: one block per token, correctness over latency), the
+// post-block stream update, and the final head mean. Math follows models/glm5/reference.
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_mhc_detail {
+
+constexpr int kPreBlock = 256;
+constexpr int kMaxLanes = 24;   // (2 + hc) * hc with hc = 4
+
+__device__ __forceinline__ float sigmoid_f(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+// One token per block. Phase order: unweighted RMS norm over the flattened streams, the
+// 24 mix dots (each thread strides the plane, one accumulator per lane), the gates and
+// Sinkhorn on thread 0 (a 4x4 in registers), then the pre-weighted collapse.
+__global__ void pre_kernel(const __nv_bfloat16* __restrict__ streams,
+                           const __nv_bfloat16* __restrict__ fn, const float* __restrict__ base,
+                           const float* __restrict__ scale, float rms_eps, float hc_eps,
+                           std::int32_t sinkhorn_iters, std::int32_t hidden, std::int32_t hc,
+                           float* __restrict__ pre, float* __restrict__ post,
+                           float* __restrict__ comb, __nv_bfloat16* __restrict__ collapsed) {
+    const std::int64_t token = blockIdx.x;
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const std::int32_t threads = blockDim.x;
+    const std::int64_t plane = static_cast<std::int64_t>(hc) * hidden;
+    const __nv_bfloat16* row = streams + token * plane;
+    const std::int32_t lanes = (2 + hc) * hc;
+
+    __shared__ float s_reduce[kPreBlock];
+    __shared__ float s_mix[kMaxLanes];
+    __shared__ float s_pre[4], s_post[4], s_comb[4 * 4];
+
+    // Unweighted RMS norm: eps inside the sqrt, one shared-staged block reduction.
+    float square = 0.0f;
+    for (std::int64_t i = tid; i < plane; i += threads) {
+        const float value = __bfloat162float(row[i]);
+        square = fmaf(value, value, square);
+    }
+    s_reduce[tid] = square;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 0.0f;
+        for (std::int32_t i = 0; i < threads; ++i) { acc += s_reduce[i]; }
+        s_reduce[0] = rsqrtf(acc / static_cast<float>(plane) + rms_eps);
+    }
+    __syncthreads();
+    const float inverse = s_reduce[0];
+
+    // 24 lane dots: each thread walks its stride of the normalized plane once per lane,
+    // keeping lane accumulators in registers; the per-lane block reduction reuses staging.
+    float lane_acc[kMaxLanes];
+#pragma unroll
+    for (std::int32_t m = 0; m < kMaxLanes; ++m) { lane_acc[m] = 0.0f; }
+    for (std::int64_t i = tid; i < plane; i += threads) {
+        const float x = __bfloat162float(row[i]) * inverse;
+        const __nv_bfloat16* weights = fn + i;
+#pragma unroll
+        for (std::int32_t m = 0; m < kMaxLanes; ++m) {
+            lane_acc[m] = fmaf(x, __bfloat162float(weights[static_cast<std::int64_t>(m) * plane]),
+                               lane_acc[m]);
+        }
+    }
+#pragma unroll
+    for (std::int32_t m = 0; m < kMaxLanes; ++m) {
+        s_reduce[tid] = lane_acc[m];
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 0.0f;
+            for (std::int32_t i = 0; i < threads; ++i) { acc += s_reduce[i]; }
+            s_mix[m] = acc;
+        }
+        __syncthreads();
+    }
+    // Lanes beyond this profile stay zero; thread 0 finishes every gate from s_mix.
+    if (tid == 0) {
+#pragma unroll
+        for (std::int32_t n = 0; n < 4; ++n) {
+            if (n < hc) {
+                s_pre[n] = sigmoid_f(s_mix[n] * scale[0] + base[n]) + hc_eps;
+                s_post[n] = 2.0f * sigmoid_f(s_mix[hc + n] * scale[1] + base[hc + n]);
+            }
+        }
+        // comb[src][dst] from the flat layout comb[dst + hc*src]; softmax over dst per src.
+        float comb_w[4][4];
+#pragma unroll
+        for (std::int32_t src = 0; src < 4; ++src) {
+#pragma unroll
+            for (std::int32_t dst = 0; dst < 4; ++dst) {
+                comb_w[src][dst] = 0.0f;
+            }
+        }
+        for (std::int32_t src = 0; src < hc; ++src) {
+            float logits[4], maximum = 0.0f;
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                const std::int32_t flat = 2 * hc + dst + hc * src;
+                logits[dst] = s_mix[flat] * scale[2] + base[flat];
+                if (dst == 0 || logits[dst] > maximum) { maximum = logits[dst]; }
+            }
+            float denominator = 0.0f;
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                logits[dst] = expf(logits[dst] - maximum);
+                denominator += logits[dst];
+            }
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                comb_w[src][dst] = logits[dst] / denominator + hc_eps;
+            }
+        }
+        // Sinkhorn: one column normalization (sum over src), then iters-1 of {row, column}.
+        auto normalize_columns = [&]() {
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                float sum = 0.0f;
+                for (std::int32_t src = 0; src < hc; ++src) { sum += comb_w[src][dst]; }
+                const float inverse_sum = 1.0f / (sum + hc_eps);
+                for (std::int32_t src = 0; src < hc; ++src) { comb_w[src][dst] *= inverse_sum; }
+            }
+        };
+        auto normalize_rows = [&]() {
+            for (std::int32_t src = 0; src < hc; ++src) {
+                float sum = 0.0f;
+                for (std::int32_t dst = 0; dst < hc; ++dst) { sum += comb_w[src][dst]; }
+                const float inverse_sum = 1.0f / (sum + hc_eps);
+                for (std::int32_t dst = 0; dst < hc; ++dst) { comb_w[src][dst] *= inverse_sum; }
+            }
+        };
+        normalize_columns();
+        for (std::int32_t round = 1; round < sinkhorn_iters; ++round) {
+            normalize_rows();
+            normalize_columns();
+        }
+        for (std::int32_t src = 0; src < hc; ++src) {
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                s_comb[src * 4 + dst] = comb_w[src][dst];
+            }
+        }
+    }
+    __syncthreads();
+
+    for (std::int32_t n = 0; n < hc; ++n) {
+        pre[token * hc + n] = s_pre[n];
+        post[token * hc + n] = s_post[n];
+    }
+    for (std::int32_t i = 0; i < hc * hc; ++i) { comb[token * hc * hc + i] = s_comb[i]; }
+
+    // Collapse: out[d] = sum_n pre[n] * row[n*hidden + d], published from FP32 math.
+    for (std::int64_t d = tid; d < hidden; d += threads) {
+        float acc = 0.0f;
+        for (std::int32_t n = 0; n < hc; ++n) {
+            acc = fmaf(s_pre[n], __bfloat162float(row[static_cast<std::int64_t>(n) * hidden + d]),
+                       acc);
+        }
+        collapsed[token * hidden + d] = __float2bfloat16(acc);
+    }
+}
+
+// One thread per (t, dst, d): mix four residual reads, add post*block.
+__global__ void post_kernel(const __nv_bfloat16* __restrict__ block,
+                            const __nv_bfloat16* __restrict__ residual, const float* __restrict__ post,
+                            const float* __restrict__ comb, std::int32_t hidden, std::int32_t hc,
+                            __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int64_t plane = static_cast<std::int64_t>(hc) * hidden;
+    // Grid is 1D over [T * hc * hidden]; decompose cheaply.
+    const std::int32_t t = static_cast<std::int32_t>(index / plane);
+    const std::int64_t within = index % plane;
+    const std::int32_t dst = static_cast<std::int32_t>(within / hidden);
+    const std::int32_t d = static_cast<std::int32_t>(within % hidden);
+    const __nv_bfloat16* residual_t = residual + static_cast<std::int64_t>(t) * plane;
+    float mix = 0.0f;
+    for (std::int32_t src = 0; src < hc; ++src) {
+        mix = fmaf(comb[static_cast<std::int64_t>(t) * hc * hc + src * hc + dst],
+                   __bfloat162float(residual_t[static_cast<std::int64_t>(src) * hidden + d]), mix);
+    }
+    const float gated =
+        fmaf(post[static_cast<std::int64_t>(t) * hc + dst], __bfloat162float(block[static_cast<std::int64_t>(t) * hidden + d]), mix);
+    out[static_cast<std::int64_t>(t) * plane + static_cast<std::int64_t>(dst) * hidden + d] =
+        __float2bfloat16(gated);
+}
+
+// One thread per (t, d): unweighted mean of the four streams.
+__global__ void head_kernel(const __nv_bfloat16* __restrict__ streams, std::int32_t hidden,
+                            std::int32_t hc, __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t t = static_cast<std::int32_t>(index / hidden);
+    const std::int32_t d = static_cast<std::int32_t>(index % hidden);
+    const std::int64_t plane = static_cast<std::int64_t>(hc) * hidden;
+    float acc = 0.0f;
+    for (std::int32_t n = 0; n < hc; ++n) {
+        acc += __bfloat162float(streams[static_cast<std::int64_t>(t) * plane +
+                                        static_cast<std::int64_t>(n) * hidden + d]);
+    }
+    out[static_cast<std::int64_t>(t) * hidden + d] =
+        __float2bfloat16(acc * (1.0f / static_cast<float>(hc)));
+}
+
+} // namespace glm5_mhc_detail
+} // namespace ninfer::ops
