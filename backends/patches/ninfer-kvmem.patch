@@ -0,0 +1,5 @@
+// SPDX-License-Identifier: Apache-2.0
+// Cold BF16 weights, BF16 products with FP32 accumulation. This is a numerical
+// candidate, qualified against the upstream mHC tolerance rather than bit equality.
+#define DSV41_CONTROL_BF16_WEIGHT
+#include "deepseek_v41_control_rrms_parallel_bf16_gaudi2.c"
diff --git a/src/core/gaudi2/tpc/kernels/rmsnorm_parallel_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/rmsnorm_parallel_bf16_gaudi2.c
new file mode 100644
index 0000000..d2b05ef
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/rmsnorm_parallel_bf16_gaudi2.c
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: Apache-2.0
+// Independent K accumulators remove the loop-carried FP32 MAC dependency.
+// Reduction order follows the upstream tolerance contract, not bit equality.
+#pragma clang fp contract(off)
+#define FLASHINFER_NORM_USE_LOOKUP_RSQRT
+#include "../../flashinfer_gaudi/kernels/norm_math_gaudi2.h"
+#ifdef DSV41_CONTROL_SWIZZLED
+#define WEIGHT_COORD(K,R) ((int5){(K)%128,R,(K)/128})
+#else
+#define WEIGHT_COORD(K,R) ((int5){K,R})
+#endif
+void main(tensor activation,tensor weight,tensor output,float epsilon,float inverse_width) {
+    const int5 begin=get_index_space_offset(),end=begin+get_index_space_size();
+    for(int token=begin[1];token<end[1];++token)for(int row=begin[0];row<end[0];++row) {
+        float128 a0={0},a1={0},a2={0},a3={0},squares={0};
+        for(int k=0;k<20480;k+=512) {
+#ifdef DSV41_CONTROL_BF16_WEIGHT
+            const bfloat128 x0=v_bf16_ld_tnsr_b((int5){k,token},activation);
+            const bfloat128 x1=v_bf16_ld_tnsr_b((int5){k+128,token},activation);
+            const bfloat128 x2=v_bf16_ld_tnsr_b((int5){k+256,token},activation);
+            const bfloat128 x3=v_bf16_ld_tnsr_b((int5){k+384,token},activation);
+#define ACC(I,A,X) \
+            A=v_bf16_mac_acc32_b(X,v_bf16_ld_tnsr_b(WEIGHT_COORD(k+I*128,row),weight),A,0); \
+            if(row==0) { \
+                const float128 xf=convert_bfloat128_to_float128(X,SW_LINEAR); \
+                squares.v1=v_f32_mac_b(xf.v1,xf.v1,squares.v1); \
+                squares.v2=v_f32_mac_b(xf.v2,xf.v2,squares.v2); \
+            }
+#else
+            const float128 x0=convert_bfloat128_to_float128(v_bf16_ld_tnsr_b((int5){k,token},activation),SW_LINEAR);
+            const float128 x1=convert_bfloat128_to_float128(v_bf16_ld_tnsr_b((int5){k+128,token},activation),SW_LINEAR);
+            const float128 x2=convert_bfloat128_to_float128(v_bf16_ld_tnsr_b((int5){k+256,token},activation),SW_LINEAR);
+            const float128 x3=convert_bfloat128_to_float128(v_bf16_ld_tnsr_b((int5){k+384,token},activation),SW_LINEAR);
+#define ACC(I,A,X) \
+            A.v1=v_f32_mac_b(X.v1,v_f32_ld_tnsr_b(WEIGHT_COORD(k+I*128,row),weight),A.v1); \
+            A.v2=v_f32_mac_b(X.v2,v_f32_ld_tnsr_b(WEIGHT_COORD(k+I*128+64,row),weight),A.v2); \
+            if(row==0) {squares.v1=v_f32_mac_b(X.v1,X.v1,squares.v1);squares.v2=v_f32_mac_b(X.v2,X.v2,squares.v2);}
+#endif
+            ACC(0,a0,x0);ACC(1,a1,x1);ACC(2,a2,x2);ACC(3,a3,x3);
+#undef ACC
+        }
+        const float64 total=(a0.v1+a0.v2)+(a1.v1+a1.v2)+(a2.v1+a2.v2)+(a3.v1+a3.v2);
+        v_f32_st_tnsr_partial((int5){row,token},output,v_f32_reduce_add(total),0,0);
+        if(row==0) v_f32_st_tnsr_partial((int5){24,token},output,
+            positive_rsqrt(v_f32_reduce_add(squares.v1+squares.v2)*inverse_width+epsilon),0,0);
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/sinkhorn4_gaudi2.c b/src/core/gaudi2/tpc/kernels/sinkhorn4_gaudi2.c
new file mode 100644
index 0000000..20fab9e
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/sinkhorn4_gaudi2.c
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: Apache-2.0
+// Four independent matrices occupy the four dual groups of one FP32 vector.
+static inline uchar256 direction(uint64 index) {
+    const uint64 selected = (index & 7) | ((index & 8) << 2) | 0x80;
+    uint256 packed;
+    packed.v1 = selected;
+    packed.v2 = selected;
+    packed.v3 = selected;
+    packed.v4 = selected;
+    return v_convert_u32_to_u8_all_b(packed);
+}
+
+void main(tensor input, tensor output) {
+    const int5 start = get_index_space_offset();
+    const int5 end = start + get_index_space_size();
+    const int width = get_dim_size(input, 0);
+    const uint64 lane = read_lane_id_4b_b();
+    const uchar256 r0 = direction(lane & 0xfffffffc);
+    const uchar256 r1 = direction((lane & 0xfffffffc) | 1);
+    const uchar256 r2 = direction((lane & 0xfffffffc) | 2);
+    const uchar256 r3 = direction((lane & 0xfffffffc) | 3);
+    const uchar256 c0 = direction(lane & 3);
+    const uchar256 c1 = direction((lane & 3) | 4);
+    const uchar256 c2 = direction((lane & 3) | 8);
+    const uchar256 c3 = direction((lane & 3) | 12);
+    for (int block = start[0]; block < end[0]; ++block) {
+        const int5 at = {block * 64, 0, 0, 0, 0};
+        const int last = s_i32_min(63, width - block * 64 - 1);
+        float64 values = v_f32_ld_tnsr_partial_b(at, input, last, 0);
+        for (int iteration = 0; iteration < 20; ++iteration) {
+            if (iteration != 0) {
+                const float64 a = v_f32_shuffle_b(values, r0, 0, 0.0f)
+                                + v_f32_shuffle_b(values, r1, 0, 0.0f);
+                const float64 b = v_f32_shuffle_b(values, r2, 0, 0.0f)
+                                + v_f32_shuffle_b(values, r3, 0, 0.0f);
+                values /= (a + b) + 1.0e-6f;
+            }
+            float64 sum = 0.0f;
+            sum += v_f32_shuffle_b(values, c0, 0, 0.0f);
+            sum += v_f32_shuffle_b(values, c1, 0, 0.0f);
+            sum += v_f32_shuffle_b(values, c2, 0, 0.0f);
+            sum += v_f32_shuffle_b(values, c3, 0, 0.0f);
+            values /= sum + 1.0e-6f;
+        }
+        v_f32_st_tnsr_partial(at, output, values, last, 0);
+    }
+}
diff --git a/src/core/gaudi2/tpc/tests/glm5_tpc_test.cpp b/src/core/gaudi2/tpc/tests/glm5_tpc_test.cpp
new file mode 100644
index 0000000..ed5c9c9
--- /dev/null
+++ b/src/core/gaudi2/tpc/tests/glm5_tpc_test.cpp
@@ -0,0 +1,432 @@
+// TPC kernel bridge lifecycle tests against the fake_synapse asynchronous test
+// double. These validate graph construction (tensors, sections, custom kernel
+// nodes), recipe compilation, launch resource management (DMA leases), and
+// cleanup — not kernel math (the CUDA executor tests cover that against the
+// same host reference).
+#include "core/gaudi2/tpc/include/glm5_tpc.h"
+#include "control.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <vector>
+
+using namespace ninfer::gaudi2;
+using namespace ninfer::gaudi2::tpc;
+
+namespace {
+
+void require(bool value, const char* what) { if (!value) throw std::runtime_error(what); }
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 17u) - 8) / 8.0f;
+}
+
+void rms_norm_lifecycle() {
+    constexpr std::uint32_t W = 64, T = 1;
+    {
+        Device device;
+        auto stream = device.create_stream();
+        RmsNormShape shape{W, T};
+        RmsNorm norm(device, shape, 1e-5f, 4096);
+        require(norm.shape().width == W && norm.shape().tokens == T, "RmsNorm shape");
+
+        PinnedBuffer host_x = device.allocate_host(W * T * 2);
+        PinnedBuffer host_w = device.allocate_host(W * 2);
+        PinnedBuffer host_o = device.allocate_host(W * T * 2);
+        DeviceBuffer dev_x = device.allocate_device(W * T * 2);
+        DeviceBuffer dev_w = device.allocate_device(W * 2);
+        DeviceBuffer dev_o = device.allocate_device(W * T * 2);
+        // Fill with BF16 values.
+        for (std::uint32_t i = 0; i < W; ++i) {
+            const auto bits = static_cast<std::uint16_t>(i % 100);
+            std::memcpy(reinterpret_cast<std::byte*>(host_x.bytes().data()) + i * 2, &bits, 2);
+            std::memcpy(reinterpret_cast<std::byte*>(host_w.bytes().data()) + i * 2, &bits, 2);
+        }
+        auto up1 = stream.upload(dev_x, host_x, host_x.size()); up1.wait();
+        auto up2 = stream.upload(dev_w, host_w, host_w.size()); up2.wait();
+        auto compute = norm.launch(stream, dev_x, dev_w, dev_o);
+        require(!compute.ready(), "RmsNorm compute should be pending immediately");
+        compute.wait(); compute.wait();
+        require(compute.ready(), "RmsNorm compute completion must be idempotent");
+        auto down = stream.download(host_o, dev_o, host_o.size()); down.wait();
+    }
+    fake_synapse::assert_clean();
+}
+
+void clamp_swiglu_lifecycle() {
+    constexpr std::uint32_t I = 32, T = 1;
+    {
+        Device device;
+        auto stream = device.create_stream();
+        ClampSwigluShape shape{I, T};
+        ClampSwiglu swiglu(device, shape, 10.0f, 4096);
+        require(swiglu.shape().inner == I, "ClampSwiglu shape");
+
+        PinnedBuffer host_h = device.allocate_host(I * 2 * T * 2);
+        PinnedBuffer host_o = device.allocate_host(I * T * 2);
+        DeviceBuffer dev_h = device.allocate_device(I * 2 * T * 2);
+        DeviceBuffer dev_o = device.allocate_device(I * T * 2);
+        auto up = stream.upload(dev_h, host_h, host_h.size()); up.wait();
+        auto compute = swiglu.launch(stream, dev_h, dev_o);
+        compute.wait();
+        auto down = stream.download(host_o, dev_o, host_o.size()); down.wait();
+    }
+    fake_synapse::assert_clean();
+}
+
+void kda_gate_lifecycle() {
+    constexpr std::uint32_t H = 4, D = 16, DI = H * D, T = 1;
+    {
+        Device device;
+        auto stream = device.create_stream();
+        KdaGateShape shape{DI, H, D, T};
+        KdaGate gate_kernel(device, shape, -5.0f, 4096);
+        require(gate_kernel.shape().d_inner == DI, "KdaGate shape");
+
+        PinnedBuffer host_a = device.allocate_host(DI * T * 2);
+        PinnedBuffer host_log = device.allocate_host(H * 4);
+        PinnedBuffer host_gate = device.allocate_host(DI * T * 4);
+        DeviceBuffer dev_a = device.allocate_device(DI * T * 2);
+        DeviceBuffer dev_log = device.allocate_device(H * 4);
+        DeviceBuffer dev_gate = device.allocate_device(DI * T * 4);
+        auto up1 = stream.upload(dev_a, host_a, host_a.size()); up1.wait();
+        auto up2 = stream.upload(dev_log, host_log, host_log.size()); up2.wait();
+        auto compute = gate_kernel.launch(stream, dev_a, dev_log, dev_gate);
+        compute.wait();
+        auto down = stream.download(host_gate, dev_gate, host_gate.size()); down.wait();
+    }
