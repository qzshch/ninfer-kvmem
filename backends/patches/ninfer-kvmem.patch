+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from tools.convert.glm5_tensors import block_tensor_names, expected_tensors, refused_reasons
+
+_FIXTURES = Path(__file__).resolve().parents[1] / "fixtures" / "glm5"
+
+
+def _layer_types():
+    config = json.loads((_FIXTURES / "text_config.json").read_text())
+    return config["layer_types"], config["first_k_dense_replace"]
+
+
+def test_every_block_gets_its_mixer_tensor_set():
+    kinds = _layer_types()[0]
+    kda = block_tensor_names(0, "linear_attention", "sparse")
+    dsa = block_tensor_names(3, "deepseek_sparse_attention", "sparse")
+    assert kinds[0] == "linear_attention" and kinds[3] == "deepseek_sparse_attention"
+    # KDA-only pieces
+    assert kda["kda_q_conv"] == "blk.0.ssm_conv1d_q.weight"
+    assert "ssm_conv1d_k.weight" in kda["kda_k_conv"]
+    assert kda["kda_a_log_rate"].endswith("ssm_a_noscan.weight")
+    # DSA-only pieces
+    assert dsa["mla_absorbed_value_b"] == "blk.3.wv_b.weight"
+    assert dsa["indexer_pool_position_embedding"].endswith("indexer_kpool_ape.weight")
+    assert "kda_q_conv" not in dsa and "mla_q_lowrank_a" not in kda
+    # Shared pieces on both
+    assert kda["mhc_attn_mix"].endswith("hc_attn_fn.weight")
+    assert dsa["mhc_attn_mix"] == "blk.3.hc_attn_fn.weight"
+
+
+def test_expected_inventory_counts_match_the_audited_profile():
+    layers, dense = _layer_types()
+    inventory = expected_tensors(layers, dense)
+    assert len(layers) == 45 and layers.count("deepseek_sparse_attention") == 11
+    # Per-block roles: every block shares 8 mHC/norm/output tensors; KDA adds 14 more,
+    # DSA adds 14 more, dense MLPs 3, sparse MLPs 8.
+    assert len(inventory["mhc_attn_mix"]) == 45
+    assert len(inventory["kda_q_conv"]) == 34
+    assert len(inventory["mla_absorbed_value_b"]) == 11
+    assert len(inventory["dense_gate"]) == 3
+    assert len(inventory["moe_router"]) == 42
+    assert len(inventory["token_embedding"]) == 1
+
+
+def test_missing_tensors_are_reported_by_role():
+    layers, dense = _layer_types()
+    full = expected_tensors(layers, dense)
+    present = set().union(*full.values())
