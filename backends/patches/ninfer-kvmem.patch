+        require(drafts <= 15, "invalid draft count");
+        if (drafts) {
+            options.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+            options.speculative.draft_tokens = drafts;
+        }
+        struct Case { unsigned frontier, output; };
+        // A one-token request finishes in prefill before another lane can be
+        // admitted; the concurrent cases exercise decode across the page boundary.
+        // MTP can split the last prompt chunk to leave proposal space in R.
+        // Long outputs must still finish within the admitted service projection.
+        const std::vector<Case> cases = options.max_concurrency == 1
+            ? std::vector<Case>{{2047, 2}, {2048, 1}, {2048, 2}, {2048, 5}, {2049, 2},
+                                {2051, 5}, {2052, 5}, {2047, 129}}
+            : std::vector<Case>{{2047, 8}, {2048, 8}, {2049, 8},
+                                {2047, 129}, {2048, 129}, {2048, 257}, {2049, 129}};
+        std::vector<ninfer::TokenId> corpus;
+        std::vector<std::vector<Observed>> reference;
+        std::uint64_t page_bytes = 0;
+        {
+            ninfer::Engine roomy(options);
+            std::string text;
+            for (unsigned i = 0; i < 1024; ++i)
+                text += "The observatory archives pulsars, cosmic rays and distant galaxies. ";
+            corpus = roomy.tokenize_text(text);
+            require(corpus.size() >= 2052, "prompt corpus is too short");
+            // Observe one admitted request to size H for this artifact's native
+            // main+draft KV representation, independently of the allocation path.
+            const auto sizing = batch(roomy, corpus, 2048, 1, 1);
+            require(sizing[0].reservation && sizing[0].reservation % 32 == 0,
+                    "cannot size the native 64-token Host pages");
+            page_bytes = sizing[0].reservation / 32;
+            for (const auto& c : cases)
+                reference.push_back(batch(roomy, corpus, c.frontier, c.output, options.max_concurrency));
+        }
+        // Use the exact admitted capacity, then repeat requests on the same Engine
+        // so a boundary failure or leaked reservation cannot hide at destruction.
+        for (unsigned pages : {32U, 33U}) {
+            options.kvmem.host_bytes = page_bytes * pages * options.max_concurrency;
+            ninfer::Engine tight(options);
+            for (std::size_t i = 0; i < cases.size(); ++i) {
+                const auto& c = cases[i];
+                if ((c.frontier + 63U) / 64U != pages) continue;
+                const auto actual = batch(tight, corpus, c.frontier, c.output, options.max_concurrency);
+                for (std::size_t lane = 0; lane < actual.size(); ++lane)
+                    require(actual[lane].result.generated_token_ids == reference[i][lane].result.generated_token_ids,
+                            "tight Host budget changed greedy output");
+                require(std::any_of(actual.begin(), actual.end(), [&](const auto& r) {
+                    return r.reservation == options.kvmem.host_bytes;
+                }), "test did not consume the entire Host reservation budget");
+                std::cout << "RAM_BUDGET frontier=" << c.frontier << " output=" << c.output
+                          << " lanes=" << options.max_concurrency << " H=" << options.kvmem.host_bytes
+                          << " exact_output=1 resources_released=1" << std::endl;
+            }
+        }
+        std::cout << "MEMORY_RAM_BUDGET PASS" << std::endl;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/memory_sessions.cpp b/tests/experimental/memory_sessions.cpp
new file mode 100644
index 0000000..a04109b
--- /dev/null
+++ b/tests/experimental/memory_sessions.cpp
@@ -0,0 +1,175 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <atomic>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+ninfer::PromptInput history(const std::string& key) {
+    ninfer::PromptInput input;
+    input.context_cache.session_key = key;
+    const auto add = [&](ninfer::ChatRole role, std::string text) {
+        ninfer::ChatMessage message;
+        message.role = role;
+        message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(text)});
+        input.messages.push_back(std::move(message));
+    };
+    add(ninfer::ChatRole::System, "Read archive " + key + " and answer briefly.");
+    for (int entry = 0; entry < 16; ++entry) {
+        std::string text = "Archive entry " + std::to_string(entry) + ". ";
+        for (int repeat = 0; repeat < 8; ++repeat)
+            text += entry < 4 ? "The violet observatory studies pulsars, cosmic rays and distant galaxies. "
+                             : "The coastal office files invoices, transport schedules and warehouse inventories. ";
+        add(ninfer::ChatRole::User, text);
+        add(ninfer::ChatRole::Assistant, "Recorded.");
+    }
+    add(ninfer::ChatRole::User, "What does the violet observatory study?");
+    return input;
+}
+struct Sink final : ninfer::OutputSink {
+    bool cancel_enabled = false;
+    ninfer::Engine* memory_probe = nullptr;
+    bool observed_active_memory = false;
+    void observe_memory() {
+        if (!memory_probe) return;
+        // Read the gauges from the same published execution boundary. The full
+        // memory_summary() takes the execution lock and can wait for completion.
+        const auto snapshot = memory_probe->runtime_stats();
+        if (snapshot.running_requests != 1) return;
+        const auto& memory = snapshot.kvmem;
+        require(memory.active_payload_reservation_bytes == 0,
+                "short request unexpectedly obtained a Host reservation");
+        require(memory.host_payload_bytes == 0,
+                "active short unretained request allocated Host archive pages");
+        observed_active_memory = true;
+    }
+    std::atomic<bool> cancelled{false};
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress) override {}
+    void publish(ninfer::OutputDelta) override { observe_memory(); }
+    void timing(ninfer::GenerationTimingObservation value) override {
+        if (value.generated_tokens) observe_memory();
+        if (cancel_enabled && value.generated_tokens >= 8) cancelled.store(true);
+    }
+};
+}
+
+int main(int argc, char** argv) {
+    try {
+        require(argc >= 3 && argc <= 5, "artifact draft-count(0..4) [bf16|int8|nvfp4|k8v4|rk8v4] [eager|graph]");
+        ninfer::EngineOptions options;
+        ninfer::test::kvmem_test_devices(options);
+        options.artifact_path = argv[1];
+        options.device_profile = "off";
+        options.max_context = 16384;
+        options.prefill_chunk = 128;
+        options.kv_cache = argc >= 4 ? ninfer::test::kvmem_test_storage(argv[3])
+                                    : ninfer::KvCacheStorage::Int8Group64;
+        if (argc == 5) options.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[4]);
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512);
+        options.kvmem = {.selected_tokens = 384, .reserve_tokens = 128,
+            .host_bytes = ninfer::test::kvmem_test_host_bytes(230ULL << 20, options.kv_cache),
+            .retained_sessions = 3, .verify_transfers = true};
+        options.context_cache.enabled = false;
+        const auto drafts = static_cast<std::uint32_t>(std::stoul(argv[2]));
+        if (drafts) {
+            options.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+            options.speculative.draft_tokens = drafts;
+        }
+        ninfer::Engine engine(options);
+        const auto run = [&](const char* name, ninfer::PromptInput input, bool expected_reuse,
+                             bool allow_reuse = true, bool cancel = false) {
+            ninfer::RequestOptions request;
+            request.execution.allow_prefix_reuse = allow_reuse;
+            request.execution.requested_output_tokens = cancel ? 130 : 24;
+            request.execution.sampling.temperature = 0;
+            request.stop.include_model_defaults = false;
+            Sink sink;
+            sink.cancel_enabled = cancel;
+            auto result = engine.submit(engine.prepare(std::move(input)), request,
+                ninfer::OutputConsumerMode::Streaming, {.live_timings = true})
+                .wait(&sink, ninfer::CancellationView([&] { return sink.cancelled.load(); }));
+            require(engine.is_available(), "Engine became unavailable");
+            require((result.reused_prompt_tokens != 0) == expected_reuse, "wrong session reuse decision");
+            require(cancel ? result.finish_reason == ninfer::FinishReason::Cancelled
+                           : result.generated_token_ids.size() == 24, "wrong termination");
+            const auto memory = engine.memory_summary().kvmem;
+            require(memory.host_payload_bytes <= options.kvmem.host_bytes, "global H exceeded");
+            require(memory.retained_sessions <= 3, "session count limit exceeded");
+            require(memory.resident_pages == 0 && memory.mtp_resident_pages == 0, "device pages leaked");
+            std::cout << "MEMORY_SESSION " << name << " reused=" << result.reused_prompt_tokens
+                      << " retained=" << memory.retained_sessions << " H=" << memory.host_payload_bytes
+                      << " evictions=" << memory.history_evictions << std::endl;
+            return result;
+        };
+        // Cross a Prefill chunk without crossing the physical window. With reuse
+        // disabled this request needs no Host reservation, even though RAM lookahead
+        // is enabled globally. Observe before terminal cleanup can hide an allocation.
+        ninfer::PromptInput short_unretained;
+        short_unretained.options.enable_thinking = false;
+        ninfer::ChatMessage short_message;
+        short_message.role = ninfer::ChatRole::User;
+        std::string short_text;
+        for (int repeat = 0; repeat < 24; ++repeat)
+            short_text += "The notebook contains ordinary observation notes. ";
+        short_text += "Continue with a detailed explanation.";
+        short_message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(short_text)});
+        short_unretained.messages.push_back(std::move(short_message));
+        auto short_prepared = engine.prepare(std::move(short_unretained));
+        constexpr std::uint32_t short_output = 128;
+        require(short_prepared.summary().prompt_tokens > options.prefill_chunk,
+                "short-request fixture did not exercise next-chunk preparation");
+        require(short_prepared.summary().prompt_tokens + short_output <= options.kvmem.device_tokens(),
+                "short-request fixture unexpectedly requires Host archive capacity");
+        std::cout << "MEMORY_SHORT_UNRETAINED tokens=" << short_prepared.summary().prompt_tokens << std::endl;
+        ninfer::RequestOptions short_options;
+        short_options.execution.allow_prefix_reuse = false;
+        short_options.execution.requested_output_tokens = short_output;
+        short_options.execution.sampling.temperature = 0;
+        short_options.stop.include_model_defaults = false;
+        Sink short_sink;
+        short_sink.memory_probe = &engine;
+        const auto short_result = engine.submit(std::move(short_prepared), short_options,
+            ninfer::OutputConsumerMode::Streaming, {.live_timings = true})
+            .wait(&short_sink, ninfer::CancellationView([] { return false; }));
+        require(short_result.generated_token_ids.size() == short_output, "short request did not complete");
+        require(short_sink.observed_active_memory, "short request had no active memory observation");
+        require(engine.memory_summary().kvmem.host_payload_bytes == 0,
+                "short unretained request leaked Host archive pages");
+        std::cout << "MEMORY_SHORT_UNRETAINED PASS active_reservation=0 active_payload=0" << std::endl;
+        auto a = history("A"), b = history("B"), c = history("C"), d = history("D");
+        const auto first = run("A-cold", a, false);
+        run("B-cold", b, false);
+        require(first.generated_token_ids == run("A-return", a, true).generated_token_ids,
+                "A/B/A changed the trusted result");
+        run("C-cold", c, false);
+        run("D-pressure", d, false);
+        require(engine.memory_summary().kvmem.history_evictions > 0, "Host pressure did not evict");
+        run("B-evicted", b, false);
+        run("C-return", c, true);
+        run("C-cancel", c, true, true, true);
+        run("C-resume", c, true);
+        auto no_update = c;
+        no_update.context_cache.update_session_index = false;
+        no_update.messages.front().parts.front().text = "Read the temporary branch carefully.";
+        run("C-no-update", no_update, false);
+        run("C-index-preserved", c, true);
+        run("C-clear", c, false, false);
+        run("C-cleared", c, false);
+        auto other_key = c;
+        other_key.context_cache.session_key = "same-text-other-key";
+        run("different-key", other_key, false);
+        auto edited = other_key;
+        edited.messages[1].parts[0].text = "The archive was edited.";
+        run("edited-prefix", edited, false);
+        run("edited-repeat", edited, true);
+        std::cout << "MEMORY_SESSIONS PASS" << std::endl;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
