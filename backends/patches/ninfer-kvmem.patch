@@ -0,0 +1,42 @@
+#include "bf16_gemm.h"
+
+#include <array>
+#include <bit>
+#include <cstring>
+#include <iostream>
+
+namespace {
+template<std::size_t N> void put(ninfer::gaudi2::PinnedBuffer& buffer, const std::array<float, N>& values) {
+    std::array<std::uint16_t, N> words{};
+    for (std::size_t i = 0; i < N; ++i) {
+        const auto bits = std::bit_cast<std::uint32_t>(values[i]);
+        if (bits & 0xffffu) throw std::logic_error("smoke inputs must be exactly representable BF16");
+        words[i] = static_cast<std::uint16_t>(bits >> 16);
+    }
+    std::memcpy(buffer.bytes().data(), words.data(), sizeof(words));
+}
+}
+int main() {
+    using namespace ninfer::gaudi2;
+    try {
+        Device device; auto stream = device.create_stream();
+        Bf16Gemm gemm(device, {2, 3, 5}, 64u * 1024u * 1024u);
+        auto ah = device.allocate_host(20), wh = device.allocate_host(30), yh = device.allocate_host(12);
+        auto a = device.allocate_device(20), w = device.allocate_device(30), y = device.allocate_device(12);
+        put(ah, std::array<float, 10>{1, 2, 3, 4, 5, -2, .5f, 1, 0, -3});
+        put(wh, std::array<float, 15>{2, -1, 0, 3, 1, -1, 4, 2, 0, -2, .5f, 0, -1, 1, 2});
+        stream.upload(a, ah, ah.size()).wait(); stream.upload(w, wh, wh.size()).wait();
+        auto execution = gemm.launch(stream, a, w, y); execution.wait();
+        stream.download(yh, y, yh.size()).wait();
+        std::array<std::uint16_t, 6> actual{};
+        std::memcpy(actual.data(), yh.bytes().data(), sizeof(actual));
+        // Independent exact golden values: [[17,3,11.5],[-7.5,12,-8]].
+        constexpr std::array<std::uint16_t, 6> expected{0x4188, 0x4040, 0x4138, 0xc0f0, 0x4140, 0xc100};
+        if (actual != expected) {
+            std::cerr << "Gaudi2 native GEMM readback differs from the exact rectangular fixture\n"; return 1;
+        }
+        std::cout << "Gaudi2 native BF16 [2,5] x transpose([3,5]) readback passed; workspace="
+                  << gemm.workspace_bytes() << " bytes\n";
+        return 0;
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
