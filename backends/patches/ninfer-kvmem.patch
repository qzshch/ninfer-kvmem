+    l0.moe.up_shexp = execution::bf16_weight(d_mush.data(), FFN_M, H);
+    l0.moe.down_shexp = execution::bf16_weight(d_mdsh.data(), H, FFN_M);
+    l0.moe_router_bias = d_mbias.data();
+
+    auto& l1 = mw.layers[1];
+    l1.is_dsa = true; l1.mlp_is_dense = true;
+    l1.hc_attn_fn = execution::bf16_weight(d_hcfn[2].data(), 24, 4 * H);
+    l1.hc_attn_base = execution::bf16_weight(d_hcbase[2].data(), 24, 1);
+    l1.hc_attn_scale = execution::bf16_weight(d_hcscale[2].data(), 3, 1);
