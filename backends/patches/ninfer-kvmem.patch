+        auto up2 = stream.upload(d_bias, h_bias, h_bias.size()); up2.wait();
+        auto up3 = stream.upload(d_experts, h_experts, h_experts.size()); up3.wait();
+        auto up4 = stream.upload(d_shared, h_shared, h_shared.size()); up4.wait();
+
+        auto c1 = router.launch(stream, d_logits, d_bias, d_weights, d_indices); c1.wait();
+        auto c2 = combine.launch(stream, d_experts, d_weights, d_shared, d_out); c2.wait();
+
+        auto dn1 = stream.download(h_weights, d_weights, h_weights.size()); dn1.wait();
+        auto dn2 = stream.download(h_indices, d_indices, h_indices.size()); dn2.wait();
+        auto dn3 = stream.download(h_out, d_out, h_out.size()); dn3.wait();
