diff --git a/src/core/gaudi2/test_fp8_tile_files.py b/src/core/gaudi2/test_fp8_tile_files.py
new file mode 100644
index 0000000..2569a6b
--- /dev/null
+++ b/src/core/gaudi2/test_fp8_tile_files.py
@@ -0,0 +1,99 @@
+"""File-boundary/working-set checks for the C++ preparation route; no model dependencies."""
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+EXE = str(Path(sys.argv.pop(1)).resolve())
+
+
+def decoded(code: int) -> float:
+    exponent, mantissa = (code >> 3) & 15, code & 7
+    value = math.ldexp(1 + mantissa / 8, exponent - 7) if exponent else math.ldexp(mantissa, -9)
+    return -value if code & 128 else value
+
+
+def bf16_oracle(value: float) -> int:
+    """Choose the closest representable BF16 by numerical distance; even low bit breaks ties."""
+    value = struct.unpack('<f', struct.pack('<f', value))[0]  # explicit FP32 multiply boundary
+    word = struct.unpack('<I', struct.pack('<f', value))[0]
+    lower = word >> 16
+    candidates = [lower, lower + 1]
+    return min(candidates, key=lambda b: (abs(struct.unpack('<f', struct.pack('<I', b << 16))[0] - value), b & 1))
+
+
+class TileFiles(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='ninfer-gaudi2-tile-')
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.codes = self.root / 'codes.bin'
+        self.scales = self.root / 'scales.bin'
+        self.output = self.root / 'tile.bf16'
+        self.n, self.k = 131, 259
+        self.data = bytes((i * 17 % 255 if i * 17 % 255 not in (127, 255) else 126) for i in range(self.n * self.k))
+        self.multipliers = [0.1, 1.25, 0.0, 1.7, 0.003, 2.1]
+        self.codes.write_bytes(self.data)
+        self.scales.write_bytes(struct.pack('<6f', *self.multipliers))
+        self.multipliers = list(struct.unpack('<6f', self.scales.read_bytes()))
+
+    def run_tool(self, *extra, codes=None, scales=None, shape=None, good=True):
+        args = [EXE, str(codes or self.codes), str(scales or self.scales),
+                str(self.n), str(self.k), *(str(v) for v in (shape or (127, 126, 4, 133))),
+                str(self.output), *map(str, extra)]
+        result = subprocess.run(args, capture_output=True, text=True, timeout=15)
+        self.assertEqual(result.returncode == 0, good, result.stdout + result.stderr)
+        return result
+
+    def test_unaligned_file_tile_against_independent_oracle(self):
+        result = self.run_tool()
+        meta = json.loads(result.stdout)
+        self.assertEqual(meta['host_tile_buffer_bytes'], 4 * 133 * 3 + 6 * 4)
+        actual = struct.unpack('<532H', self.output.read_bytes())
+        expected = [bf16_oracle(decoded(self.data[r * self.k + c]) * self.multipliers[r // 128 * 3 + c // 128])
+                    for r in range(127, 131) for c in range(126, 259)]
+        self.assertEqual(list(actual), expected)
+
+    def test_same_checkpoint_file_offsets(self):
+        checkpoint = self.root / 'model.safetensors'
+        prefix = b'header is checked by the checkpoint inventory, not this plane reader'
+        checkpoint.write_bytes(prefix + self.codes.read_bytes() + self.scales.read_bytes() + b'trailing tensor')
+        self.run_tool('--codes-offset', len(prefix), '--scales-offset', len(prefix) + len(self.data),
+                      codes=checkpoint, scales=checkpoint)
+        with_offsets = self.output.read_bytes()
+        self.run_tool()
+        self.assertEqual(self.output.read_bytes(), with_offsets)
+        self.run_tool('--codes-offset', checkpoint.stat().st_size, codes=checkpoint, good=False)
+
+    def test_bad_plane_and_budget_preserve_existing_output(self):
+        self.output.write_bytes(b'existing output')
+        self.run_tool('--max-host-tile-bytes', 1, good=False)
+        self.assertEqual(self.output.read_bytes(), b'existing output')
+        self.codes.write_bytes(self.data[:-1])
+        self.run_tool(good=False)
+        self.assertEqual(self.output.read_bytes(), b'existing output')
+        self.codes.write_bytes(self.data[:-1] + b'\x7f')
+        self.run_tool(good=False)
+        self.assertEqual(self.output.read_bytes(), b'existing output')
+        self.codes.write_bytes(self.data)
+        self.scales.write_bytes(struct.pack('<6f', *([float('nan')] * 6)))
+        self.run_tool(good=False)
+        self.assertEqual(self.output.read_bytes(), b'existing output')
+
+    def test_reject_input_output_alias_and_out_of_bounds(self):
+        self.output = self.codes
+        self.run_tool(good=False)
+        self.assertEqual(self.codes.read_bytes(), self.data)
+        self.output = self.root / 'tile.bf16'
+        self.run_tool(shape=(130, 258, 2, 2), good=False)
+        self.assertFalse(self.output.exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
