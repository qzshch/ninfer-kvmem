+namespace {
+
+using namespace ninfer;
+namespace execution = ninfer::models::glm5::execution;
+namespace DsaRef = ninfer::models::glm5::reference;
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 17u) - 8) / 8.0f;
+}
+
+std::vector<__nv_bfloat16> round_trip(const std::vector<float>& values) {
+    std::vector<__nv_bfloat16> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __float2bfloat16(values[i]); }
+    return out;
+}
+std::vector<float> represented(const std::vector<__nv_bfloat16>& values) {
+    std::vector<float> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __bfloat162float(values[i]); }
+    return out;
+}
+std::vector<float> bf16(const std::vector<float>& values) {
+    return represented(round_trip(values));
+}
+
+test::GuardedDeviceBuffer upload(const void* data, std::size_t bytes) {
+    test::GuardedDeviceBuffer buffer(bytes);
+    buffer.copy_from_host(data, bytes);
+    return buffer;
+}
+template <typename T> test::GuardedDeviceBuffer upload(const std::vector<T>& values) {
+    return upload(values.data(), values.size() * sizeof(T));
+}
+template <typename T> std::vector<T> download(const test::GuardedDeviceBuffer& buffer) {
+    std::vector<T> out(buffer.bytes() / sizeof(T));
+    buffer.copy_to_host(out.data(), out.size() * sizeof(T));
+    return out;
+}
+
+std::vector<double> gemv(const std::vector<float>& w, std::uint32_t rows, std::uint32_t cols,
+                         const std::vector<float>& x) {
+    std::vector<double> y(rows, 0.0);
+    for (std::uint32_t r = 0; r < rows; ++r) {
+        for (std::uint32_t c = 0; c < cols; ++c) { y[r] += w[r * cols + c] * x[c]; }
+    }
+    return y;
+}
+std::vector<float> projected(const std::vector<float>& w, std::uint32_t rows, std::uint32_t cols,
+                             const std::vector<float>& x) {
+    std::vector<float> y(rows);
+    const auto acc = gemv(w, rows, cols, x);
+    for (std::uint32_t r = 0; r < rows; ++r) { y[r] = static_cast<float>(acc[r]); }
+    return bf16(y);
+}
+
+int failures = 0;
+
+void check(const std::string& what, const std::vector<float>& got,
+           const std::vector<float>& want, double tolerance) {
+    if (got.size() != want.size()) {
+        std::fprintf(stderr, "%s: size %zu vs %zu\n", what.c_str(), got.size(), want.size());
+        ++failures;
+        return;
+    }
+    for (std::size_t i = 0; i < got.size(); ++i) {
+        if (std::abs((double)got[i] - want[i]) > tolerance * std::max(1.0, (double)std::abs(want[i]))) {
+            if (failures < 10) {
+                std::fprintf(stderr, "%s[%zu]: %.6g vs %.6g\n", what.c_str(), i, got[i], want[i]);
+            }
+            ++failures;
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+void run_dsa_case(std::uint32_t hidden, std::uint32_t heads, std::uint32_t head_dim,
+                  std::uint32_t q_lora, std::uint32_t kv_lora, std::uint32_t v_head,
+                  std::uint32_t index_heads, std::uint32_t index_dim, std::uint32_t kpool,
+                  std::uint32_t top_k, std::uint32_t cache) {
+    const std::uint32_t width = top_k + kpool - 1;
+    const std::string label = "h" + std::to_string(hidden);
+    auto plane = [&](std::uint32_t rows, std::uint32_t cols, std::uint32_t seed) {
+        std::vector<float> raw(rows * cols);
+        for (std::size_t i = 0; i < raw.size(); ++i) {
+            raw[i] = source(static_cast<std::uint32_t>(i) * 3 + seed) / 16.0f;
+        }
+        return bf16(raw);
+    };
+    auto gamma = [&](std::uint32_t n, std::uint32_t seed) {
+        std::vector<float> raw(n);
+        for (std::uint32_t i = 0; i < n; ++i) { raw[i] = 1.0f + source(i + seed) / 8; }
+        return bf16(raw);
+    };
+    std::vector<float> attn_norm(gamma(hidden, 1)), q_a(plane(q_lora, hidden, 2)),
+        q_a_norm(gamma(q_lora, 3)), q_b(plane(heads * head_dim, q_lora, 4)),
+        kv_a(plane(kv_lora, hidden, 5)), kv_a_norm(gamma(kv_lora, 6)),
+        wk_b(plane(head_dim * kv_lora * heads, 1, 7)), wv_b(plane(kv_lora * v_head * heads, 1, 8)),
+        wo(plane(hidden, heads * v_head, 9)),
+        indexer_q_b(plane(index_heads * index_dim, q_lora, 10)),
+        indexer_k(plane(index_dim, hidden, 11)), indexer_k_norm_w(gamma(index_dim, 12)),
+        indexer_k_norm_b(plane(index_dim, 1, 13)), indexer_gate(plane(index_dim, hidden, 14)),
+        indexer_proj_raw(plane(index_heads, hidden, 15));
+    std::vector<float> ape(kpool * index_dim);
+    for (std::size_t i = 0; i < ape.size(); ++i) { ape[i] = source(static_cast<std::uint32_t>(i) * 5 + 7) / 4; }
+
+    const std::uint32_t position = cache - 1;
+    std::vector<float> hidden_in(hidden);
+    for (std::uint32_t i = 0; i < hidden; ++i) { hidden_in[i] = source(i * 5 + 2) / 4; }
+    hidden_in = bf16(hidden_in);
+
+    // Host oracle: norm, projections, indexer chain, then the reference selection and
+    // absorbed attention over the same planes the device builds.
+    std::vector<float> x(hidden);
+    {
+        double square = 0;
+        for (std::uint32_t i = 0; i < hidden; ++i) { square += (double)hidden_in[i] * hidden_in[i]; }
+        const double inverse = 1.0 / std::sqrt(square / hidden + 1e-5);
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            x[i] = static_cast<float>(attn_norm[i] * hidden_in[i] * inverse);
+        }
+        x = bf16(x);
+    }
+    const std::vector<float> ql = projected(q_a, q_lora, hidden, x);
+    std::vector<float> qln(q_lora);
+    {
+        double square = 0;
+        for (std::uint32_t i = 0; i < q_lora; ++i) { square += (double)ql[i] * ql[i]; }
+        const double inverse = 1.0 / std::sqrt(square / q_lora + 1e-5);
+        for (std::uint32_t i = 0; i < q_lora; ++i) {
+            qln[i] = static_cast<float>(q_a_norm[i] * ql[i] * inverse);
+        }
+        qln = bf16(qln);
+    }
+    const std::vector<float> q_heads = projected(q_b, heads * head_dim, q_lora, qln);
+    const std::vector<float> lat = projected(kv_a, kv_lora, hidden, x);
+    std::vector<float> latn(kv_lora);
+    {
+        double square = 0;
+        for (std::uint32_t i = 0; i < kv_lora; ++i) { square += (double)lat[i] * lat[i]; }
+        const double inverse = 1.0 / std::sqrt(square / kv_lora + 1e-5);
+        for (std::uint32_t i = 0; i < kv_lora; ++i) {
+            latn[i] = static_cast<float>(kv_a_norm[i] * lat[i] * inverse);
+        }
+        latn = bf16(latn);
+    }
+    // Latent cache history (deterministic synthetic) with the current row appended.
+    std::vector<float> latents(cache * kv_lora);
+    for (std::uint32_t t = 0; t < cache; ++t) {
+        for (std::uint32_t e = 0; e < kv_lora; ++e) {
+            latents[t * kv_lora + e] =
+                bf16({source((t * 7 + e) * 3 + 21) / 3})[0];
+        }
+    }
+    for (std::uint32_t e = 0; e < kv_lora; ++e) { latents[position * kv_lora + e] = latn[e]; }
+    // Indexer planes.
+    const std::vector<float> iq = projected(indexer_q_b, index_heads * index_dim, q_lora, qln);
+    std::vector<float> ik_history(cache * index_dim), ig_history(cache * index_dim);
+    for (std::uint32_t t = 0; t < position; ++t) {
+        for (std::uint32_t e = 0; e < index_dim; ++e) {
+            ik_history[t * index_dim + e] = bf16({source((t * 11 + e) * 5 + 3) / 3})[0];
+            ig_history[t * index_dim + e] = bf16({source((t * 13 + e) * 3 + 9) / 2})[0];
+        }
+    }
+    const std::vector<float> ik_raw = projected(indexer_k, index_dim, hidden, x);
+    std::vector<float> ik_normed(index_dim);
+    {
+        // LayerNorm with weight and bias in fp64 then bf16.
+        double mean = 0;
+        for (std::uint32_t e = 0; e < index_dim; ++e) { mean += ik_raw[e]; }
+        mean /= index_dim;
+        double variance = 0;
+        for (std::uint32_t e = 0; e < index_dim; ++e) {
+            variance += (ik_raw[e] - mean) * (ik_raw[e] - mean);
+        }
+        variance /= index_dim;
+        const double inverse = 1.0 / std::sqrt(variance + 1e-6);
+        for (std::uint32_t e = 0; e < index_dim; ++e) {
+            ik_normed[e] = static_cast<float>((ik_raw[e] - mean) * inverse *
+                                              indexer_k_norm_w[e] + indexer_k_norm_b[e]);
+        }
+        ik_normed = bf16(ik_normed);
+    }
+    for (std::uint32_t e = 0; e < index_dim; ++e) {
+        ik_history[position * index_dim + e] = ik_normed[e];
+    }
+    const std::vector<float> ig_row = projected(indexer_gate, index_dim, hidden, x);
+    for (std::uint32_t e = 0; e < index_dim; ++e) { ig_history[position * index_dim + e] = ig_row[e]; }
+    // Pools, scores, selection and attention through the reference.
+    const DsaRef::DsaIndexerProfile iprofile{index_heads, index_dim, kpool, top_k, true};
+    const DsaRef::DsaMlaProfile mprofile{kv_lora, heads, head_dim, v_head};
+    const std::uint32_t completed = cache / kpool;
+    std::vector<float> pooled_want(completed * index_dim, 0.0f);
+    if (completed) {
+        // The pool reference consumes only the completed prefix.
+        const std::uint32_t pool_tokens = completed * kpool;
+        DsaRef::dsa_pool_reference(
+            std::vector<float>(ik_history.begin(), ik_history.begin() + pool_tokens * index_dim),
+            std::vector<float>(ig_history.begin(), ig_history.begin() + pool_tokens * index_dim),
+            ape, pooled_want, iprofile);
+    }
+    std::vector<float> weights_scaled(index_heads);
+    {
+        const std::vector<float> weights_raw = projected(indexer_proj_raw, index_heads, hidden, x);
+        const float scale = std::sqrt(1.0f / (static_cast<float>(index_dim) * index_heads));
+        for (std::uint32_t h = 0; h < index_heads; ++h) {
+            weights_scaled[h] = weights_raw[h] * scale;
+        }
+    }
+    std::vector<float> scores_want(completed, 0.0f);
+    std::vector<std::int32_t> cells_want(width, -1);
+    if (completed) {
+        DsaRef::dsa_score_reference(iq, weights_scaled, pooled_want, scores_want, iprofile);
+        const std::vector<float> transposed;   // one token: scores already [1, P]
+        std::vector<std::uint32_t> pos{position};
+        DsaRef::dsa_select_reference(scores_want, pos, cells_want, iprofile);
+    } else {
+        for (std::uint32_t m = 0; m + 1 < kpool; ++m) {
+            if (m <= position) { cells_want[top_k + m] = static_cast<std::int32_t>(m); }
+        }
+    }
+    // q_absorb per head in fp64.
+    std::vector<float> q_abs(heads * kv_lora);
+    for (std::uint32_t h = 0; h < heads; ++h) {
+        for (std::uint32_t e = 0; e < kv_lora; ++e) {
+            double acc = 0;
+            for (std::uint32_t d = 0; d < head_dim; ++d) {
+                acc += q_heads[h * head_dim + d] *
+                       wk_b[static_cast<std::size_t>(h) * head_dim * kv_lora +
+                            static_cast<std::size_t>(e) * head_dim + d];
+            }
+            q_abs[h * kv_lora + e] = static_cast<float>(acc);
+        }
+    }
+    q_abs = bf16(q_abs);
+    std::vector<float> attn_want(heads * v_head);
+    DsaRef::dsa_attention_reference(q_abs, latents, cells_want, wv_b, attn_want, iprofile,
+                                    mprofile, cache);
+    std::vector<double> out_want(hidden);
+    {
+        const auto acc = gemv(wo, hidden, heads * v_head, attn_want);
+        for (std::uint32_t i = 0; i < hidden; ++i) { out_want[i] = acc[i]; }
+    }
+
+    // ---- device run ----
+    auto d_attn_norm = upload(round_trip(attn_norm));
+    auto d_q_a = upload(round_trip(q_a));
+    auto d_q_a_norm = upload(round_trip(q_a_norm));
+    auto d_q_b = upload(round_trip(q_b));
+    auto d_kv_a = upload(round_trip(kv_a));
+    auto d_kv_a_norm = upload(round_trip(kv_a_norm));
+    auto d_wk_b = upload(round_trip(wk_b));
+    auto d_wv_b = upload(round_trip(wv_b));
+    auto d_wo = upload(round_trip(wo));
+    auto d_iqb = upload(round_trip(indexer_q_b));
+    auto d_ik = upload(round_trip(indexer_k));
+    auto d_iknw = upload(round_trip(indexer_k_norm_w));
+    auto d_iknb = upload(round_trip(indexer_k_norm_b));
+    auto d_igate = upload(round_trip(indexer_gate));
+    auto d_iproj = upload(round_trip(indexer_proj_raw));
+    auto d_ape = upload(ape);
+    auto d_hidden = upload(round_trip(hidden_in));
+    auto d_latents = upload(round_trip(latents));
+    auto d_ikh = upload(round_trip(ik_history));
+    auto d_igh = upload(round_trip(ig_history));
+    test::GuardedDeviceBuffer d_pooled(static_cast<std::size_t>(std::max<std::uint32_t>(completed, 1)) * index_dim * 4);
+    test::GuardedDeviceBuffer d_cells(width * 4);
+    test::GuardedDeviceBuffer d_out(hidden * 2);
+    const std::size_t scratch_bytes = execution::dsa_block_scratch_bytes(
+        hidden, heads, head_dim, q_lora, kv_lora, v_head, index_heads, index_dim, kpool, position);
+    test::GuardedDeviceBuffer d_scratch(scratch_bytes);
+
+    execution::DsaBlockWeights w{};
+    w.attn_norm = execution::bf16_weight(d_attn_norm.data(), hidden, 1);
+    w.q_a = execution::bf16_weight(d_q_a.data(), q_lora, hidden);
+    w.q_a_norm = execution::bf16_weight(d_q_a_norm.data(), q_lora, 1);
+    w.q_b = execution::bf16_weight(d_q_b.data(), heads * head_dim, q_lora);
+    w.kv_a = execution::bf16_weight(d_kv_a.data(), kv_lora, hidden);
+    w.kv_a_norm = execution::bf16_weight(d_kv_a_norm.data(), kv_lora, 1);
+    w.wk_b = execution::bf16_weight(d_wk_b.data(), head_dim * kv_lora * heads, 1);
+    w.wv_b = execution::bf16_weight(d_wv_b.data(), kv_lora * v_head * heads, 1);
+    w.wo = execution::bf16_weight(d_wo.data(), hidden, heads * v_head);
+    w.indexer_q_b = execution::bf16_weight(d_iqb.data(), index_heads * index_dim, q_lora);
+    w.indexer_k = execution::bf16_weight(d_ik.data(), index_dim, hidden);
+    w.indexer_k_norm_w = execution::bf16_weight(d_iknw.data(), index_dim, 1);
+    w.indexer_k_norm_b = execution::bf16_weight(d_iknb.data(), index_dim, 1);
+    w.indexer_gate = execution::bf16_weight(d_igate.data(), index_dim, hidden);
+    w.indexer_proj = execution::bf16_weight(d_iproj.data(), index_heads, hidden);
+
+    {
+        Tensor hidden_t(const_cast<void*>(d_hidden.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+        Tensor ape_t(const_cast<void*>(d_ape.data()), DType::FP32,
+                     {static_cast<std::int32_t>(kpool), static_cast<std::int32_t>(index_dim)});
+        Tensor latents_t(const_cast<void*>(d_latents.data()), DType::BF16,
+                         {static_cast<std::int32_t>(cache), static_cast<std::int32_t>(kv_lora)});
+        Tensor ikh_t(const_cast<void*>(d_ikh.data()), DType::BF16,
+                     {static_cast<std::int32_t>(cache), static_cast<std::int32_t>(index_dim)});
+        Tensor igh_t(const_cast<void*>(d_igh.data()), DType::BF16,
+                     {static_cast<std::int32_t>(cache), static_cast<std::int32_t>(index_dim)});
+        Tensor pooled_t(const_cast<void*>(d_pooled.data()), DType::FP32,
+                        {static_cast<std::int32_t>(std::max<std::uint32_t>(completed, 1)),
+                         static_cast<std::int32_t>(index_dim)});
+        Tensor cells_t(const_cast<void*>(d_cells.data()), DType::I32,
+                       {static_cast<std::int32_t>(width)});
+        Tensor out_t(const_cast<void*>(d_out.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+        execution::dsa_block_decode(w, hidden_t, ape_t, latents_t, ikh_t, igh_t, pooled_t,
+                                    cells_t, position, 1e-5f, heads, head_dim, q_lora, kv_lora,
+                                    v_head, index_heads, index_dim, kpool, top_k, out_t,
+                                    d_scratch.data(), nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+
+    // ---- batched prefill cross-check: T sequential decode calls against one
+    // dsa_block_prefill over the same token sequence (fresh identical state
+    // planes), comparing the final planes and outputs. ----
+    {
+        const std::uint32_t BT = std::min<std::uint32_t>(6, cache);
+        std::vector<float> seq_hidden(static_cast<std::size_t>(hidden) * BT);
+        for (std::uint32_t t = 0; t < BT; ++t)
+            for (std::uint32_t i = 0; i < hidden; ++i)
+                seq_hidden[static_cast<std::size_t>(t) * hidden + i] =
+                    source(i * 11 + t * 17 + 5) / 4.0f;
+        seq_hidden = represented(round_trip(seq_hidden));
+
+        auto d_seq = upload(round_trip(seq_hidden));
+        auto d_lat_a = upload(round_trip(latents)), d_lat_b = upload(round_trip(latents));
+        auto d_ik_a = upload(round_trip(ik_history)), d_ik_b = upload(round_trip(ik_history));
+        auto d_ig_a = upload(round_trip(ig_history)), d_ig_b = upload(round_trip(ig_history));
+        test::GuardedDeviceBuffer d_pool_a(d_pooled.bytes()), d_pool_b(d_pooled.bytes());
+        test::GuardedDeviceBuffer d_cells_a(width * 4), d_cells_b(width * 4);
+        test::GuardedDeviceBuffer d_out_a(hidden * BT * 2), d_out_b(hidden * BT * 2);
+        test::GuardedDeviceBuffer d_scratch_b(execution::dsa_block_prefill_scratch_bytes(
+            hidden, heads, head_dim, q_lora, kv_lora, v_head, index_heads, index_dim, kpool,
+            width, BT, 0));
+
+        auto make_views = [&](auto& lat, auto& ik, auto& ig, auto& pool, auto& cells) {
+            Tensor lat_t(lat.data(), DType::BF16, {static_cast<std::int32_t>(cache),
+                                                 static_cast<std::int32_t>(kv_lora)});
+            Tensor ik_t(ik.data(), DType::BF16, {static_cast<std::int32_t>(cache),
+                                               static_cast<std::int32_t>(index_dim)});
+            Tensor ig_t(ig.data(), DType::BF16, {static_cast<std::int32_t>(cache),
+                                               static_cast<std::int32_t>(index_dim)});
+            Tensor pool_t(pool.data(), DType::FP32,
+                          {static_cast<std::int32_t>(std::max<std::uint32_t>(completed, 1)),
+                           static_cast<std::int32_t>(index_dim)});
+            Tensor cells_t(cells.data(), DType::I32, {static_cast<std::int32_t>(width)});
+            return std::tuple{lat_t, ik_t, ig_t, pool_t, cells_t};
+        };
+        {
+            auto [lat_t, ik_t, ig_t, pool_t, cells_t] =
+                make_views(d_lat_a, d_ik_a, d_ig_a, d_pool_a, d_cells_a);
+            Tensor ape_t(const_cast<void*>(d_ape.data()), DType::FP32,
+                         {static_cast<std::int32_t>(kpool),
+                          static_cast<std::int32_t>(index_dim)});
+            for (std::uint32_t t = 0; t < BT; ++t) {
+                Tensor column(reinterpret_cast<void*>(
+                                  static_cast<std::uint8_t*>(d_seq.data()) +
+                                  static_cast<std::size_t>(t) * hidden * 2),
+                              DType::BF16, {static_cast<std::int32_t>(hidden)});
+                Tensor out_t(reinterpret_cast<void*>(static_cast<std::uint8_t*>(d_out_a.data()) +
+                                                          static_cast<std::size_t>(t) * hidden * 2),
+                             DType::BF16, {static_cast<std::int32_t>(hidden)});
+                execution::dsa_block_decode(w, column, ape_t, lat_t, ik_t, ig_t, pool_t,
+                                            cells_t, t, 1e-5f, heads, head_dim,
+                                            q_lora, kv_lora, v_head, index_heads, index_dim,
+                                            kpool, top_k, out_t, d_scratch.data(), nullptr);
+            }
+        }
+        {
+            auto [lat_t, ik_t, ig_t, pool_t, cells_t] =
+                make_views(d_lat_b, d_ik_b, d_ig_b, d_pool_b, d_cells_b);
+            Tensor ape_t(const_cast<void*>(d_ape.data()), DType::FP32,
+                         {static_cast<std::int32_t>(kpool),
+                          static_cast<std::int32_t>(index_dim)});
+            Tensor batch_t(d_seq.data(), DType::BF16,
+                           {static_cast<std::int32_t>(hidden), static_cast<std::int32_t>(BT)});
+            Tensor out_t(d_out_b.data(), DType::BF16,
+                         {static_cast<std::int32_t>(hidden), static_cast<std::int32_t>(BT)});
+            execution::dsa_block_prefill(w, batch_t, ape_t, lat_t, ik_t, ig_t, pool_t, cells_t,
+                                         0, 1e-5f, heads, head_dim, q_lora, kv_lora,
+                                         v_head, index_heads, index_dim, kpool, top_k, out_t,
+                                         d_scratch_b.data(), nullptr);
+        }
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+        const auto out_a = represented(download<__nv_bfloat16>(d_out_a));
+        const auto out_b = represented(download<__nv_bfloat16>(d_out_b));
+        for (std::size_t i = 0; i < out_a.size(); ++i) {
+            if (std::abs((double)out_b[i] - out_a[i]) > 0.05 * std::max(1.0, std::abs((double)out_a[i]))) {
+                if (failures < 10) std::fprintf(stderr, "batch-dsa[%zu]: %.6g vs %.6g%c", i, out_b[i], out_a[i], 10);
+                ++failures;
+            }
+        }
+        const auto lat_a = represented(download<__nv_bfloat16>(d_lat_a));
+        const auto lat_b = represented(download<__nv_bfloat16>(d_lat_b));
+        for (std::size_t i = 0; i < lat_a.size(); ++i) {
+            if (std::abs((double)lat_b[i] - lat_a[i]) > 0.03 * std::max(1.0, std::abs((double)lat_a[i]))) {
+                if (failures < 10) std::fprintf(stderr, "batch-latents[%zu]: %.6g vs %.6g%c", i, lat_b[i], lat_a[i], 10);
+                ++failures;
+            }
+        }
+    }
+
+    if (completed) {
+        const auto pooled_got = download<float>(d_pooled);
+        double worst = 0;
+        for (std::size_t i = 0; i < pooled_want.size(); ++i) {
+            worst = std::max(worst, std::abs((double)pooled_got[i] - pooled_want[i]));
+        }
+        std::printf("[dsa:%s] pooled worst %.5f | ", label.c_str(), worst);
+    }
+    const auto cells_got = download<std::int32_t>(d_cells);
+    std::printf("cells %s\n", cells_got == cells_want ? "match" : "DIFFER");
+    if (cells_got != cells_want) {
+        for (std::size_t i = 0; i < width && i < 12; ++i) {
+            if (cells_got[i] != cells_want[i]) {
+                std::fprintf(stderr, "cells[%zu]: %d vs %d\n", i, cells_got[i], cells_want[i]);
+            }
+        }
+        ++failures;
+    }
+    check("dsa_block[" + label + "]", represented(download<__nv_bfloat16>(d_out)),
+          {out_want.begin(), out_want.end()}, 0.06);
+}
+
+// ---------------------------------------------------------------------------
+void run_mlp_cases() {
+    // Dense MLP, small + audited widths.
+    {
+        const std::uint32_t hidden = 64, ffn = 128;
+        std::vector<float> norm_w(hidden), gate(ffn * hidden), up(ffn * hidden),
+            down(hidden * ffn), hidden_in(hidden);
+        for (std::uint32_t i = 0; i < hidden; ++i) { norm_w[i] = 1.0f + source(i) / 8; }
+        for (std::size_t i = 0; i < gate.size(); ++i) { gate[i] = source(static_cast<std::uint32_t>(i) * 3 + 1) / 16; }
+        for (std::size_t i = 0; i < up.size(); ++i) { up[i] = source(static_cast<std::uint32_t>(i) * 5 + 2) / 16; }
+        for (std::size_t i = 0; i < down.size(); ++i) { down[i] = source(static_cast<std::uint32_t>(i) * 7 + 3) / 16; }
+        for (std::uint32_t i = 0; i < hidden; ++i) { hidden_in[i] = source(i * 5 + 2) / 4; }
+        std::vector<float> gw = bf16(gate), uw = bf16(up), dw = bf16(down), nw = bf16(norm_w),
+            hin = bf16(hidden_in);
+        std::vector<float> x(hidden);
+        {
+            double square = 0;
+            for (std::uint32_t i = 0; i < hidden; ++i) { square += (double)hin[i] * hin[i]; }
+            const double inverse = 1.0 / std::sqrt(square / hidden + 1e-5);
+            for (std::uint32_t i = 0; i < hidden; ++i) { x[i] = static_cast<float>(nw[i] * hin[i] * inverse); }
+            x = bf16(x);
+        }
+        const std::vector<float> g = projected(gw, ffn, hidden, x);
+        const std::vector<float> u = projected(uw, ffn, hidden, x);
+        std::vector<float> act(ffn);
+        for (std::uint32_t i = 0; i < ffn; ++i) {
+            const double clamped_g = std::min((double)g[i], 10.0);
+            const double clamped_u = std::max(-10.0, std::min((double)u[i], 10.0));
+            act[i] = static_cast<float>(clamped_g / (1.0 + std::exp(-clamped_g)) * clamped_u);
+        }
+        act = bf16(act);
+        std::vector<double> want(hidden);
+        {
+            const auto acc = gemv(dw, hidden, ffn, act);
+            for (std::uint32_t i = 0; i < hidden; ++i) { want[i] = acc[i]; }
+        }
+        auto d_nw = upload(round_trip(nw));
+        auto d_g = upload(round_trip(gw));
+        auto d_u = upload(round_trip(uw));
+        auto d_d = upload(round_trip(dw));
+        auto d_h = upload(round_trip(hin));
+        test::GuardedDeviceBuffer d_out(hidden * 2);
+        test::GuardedDeviceBuffer d_scratch(execution::dense_mlp_scratch_bytes(hidden, ffn));
+        execution::DenseMlpWeights w{};
+        w.ffn_norm = execution::bf16_weight(d_nw.data(), hidden, 1);
+        w.gate = execution::bf16_weight(d_g.data(), ffn, hidden);
+        w.up = execution::bf16_weight(d_u.data(), ffn, hidden);
+        w.down = execution::bf16_weight(d_d.data(), hidden, ffn);
+        Tensor ht(const_cast<void*>(d_h.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+        Tensor ot(const_cast<void*>(d_out.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+        execution::dense_mlp_decode(w, ht, 1e-5f, 10.0f, ffn, ot, d_scratch.data(), nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+        check("dense_mlp", represented(download<__nv_bfloat16>(d_out)),
+              {want.begin(), want.end()}, 0.05);
+    }
+}
+
+void run_moe_case() {
+    const std::uint32_t hidden = 48, ffn = 64, experts = 8, top_k = 2;
+    std::vector<float> norm_w(hidden), router(experts * hidden), bias(experts),
+        gate_exps(static_cast<std::size_t>(experts) * ffn * hidden),
+        up_exps(gate_exps.size()), down_exps(static_cast<std::size_t>(experts) * hidden * ffn),
+        gate_sh(ffn * hidden), up_sh(ffn * hidden), down_sh(hidden * ffn), hidden_in(hidden);
+    for (std::uint32_t i = 0; i < hidden; ++i) { norm_w[i] = 1.0f + source(i) / 8; }
+    for (std::uint32_t e = 0; e < experts; ++e) {
+        for (std::size_t i = 0; i < static_cast<std::size_t>(ffn) * hidden; ++i) {
+            gate_exps[static_cast<std::size_t>(e) * ffn * hidden + i] =
+                source(static_cast<std::uint32_t>(i) * 3 + e * 7 + 1) / 16;
+            up_exps[static_cast<std::size_t>(e) * ffn * hidden + i] =
+                source(static_cast<std::uint32_t>(i) * 5 + e * 3 + 2) / 16;
+        }
+        for (std::size_t i = 0; i < static_cast<std::size_t>(hidden) * ffn; ++i) {
+            down_exps[static_cast<std::size_t>(e) * hidden * ffn + i] =
+                source(static_cast<std::uint32_t>(i) * 7 + e * 11 + 3) / 16;
+        }
+    }
+    for (std::size_t i = 0; i < router.size(); ++i) { router[i] = source(static_cast<std::uint32_t>(i) * 3 + 5) / 8; }
+    for (std::uint32_t e = 0; e < experts; ++e) { bias[e] = (e == 5) ? 4.0f : 0.0f; }
+    for (std::size_t i = 0; i < gate_sh.size(); ++i) { gate_sh[i] = source(static_cast<std::uint32_t>(i) + 7) / 16; }
+    for (std::size_t i = 0; i < up_sh.size(); ++i) { up_sh[i] = source(static_cast<std::uint32_t>(i) * 5 + 9) / 16; }
+    for (std::size_t i = 0; i < down_sh.size(); ++i) { down_sh[i] = source(static_cast<std::uint32_t>(i) * 7 + 11) / 16; }
+    for (std::uint32_t i = 0; i < hidden; ++i) { hidden_in[i] = source(i * 5 + 2) / 4; }
+
+    // host oracle: norm -> router logits -> GLM route (sigmoid + bias top-k, normalized
+    // original scores scaled by 2.5) -> selected experts + shared, all with bf16 rounding.
+    std::vector<float> gw = bf16(router), gex = bf16(gate_exps), uex = bf16(up_exps),
+        dex = bf16(down_exps), gsh = bf16(gate_sh), ush = bf16(up_sh), dsh = bf16(down_sh),
+        nw = bf16(norm_w), hin = bf16(hidden_in);
+    std::vector<float> x(hidden);
+    {
+        double square = 0;
+        for (std::uint32_t i = 0; i < hidden; ++i) { square += (double)hin[i] * hin[i]; }
+        const double inv = 1.0 / std::sqrt(square / hidden + 1e-5);
+        for (std::uint32_t i = 0; i < hidden; ++i) { x[i] = static_cast<float>(nw[i] * hin[i] * inv); }
+        x = bf16(x);
+    }
+    const std::vector<float> logits = projected(gw, experts, hidden, x);
+    // route: sigmoid scores; corrected = score + bias; rank desc ties lower index.
+    std::vector<double> score(experts);
+    for (std::uint32_t e = 0; e < experts; ++e) {
+        score[e] = 1.0 / (1.0 + std::exp(-(double)logits[e]));
+    }
+    std::vector<std::uint32_t> picked;
+    {
+        std::vector<std::uint32_t> order(experts);
+        for (std::uint32_t e = 0; e < experts; ++e) { order[e] = e; }
+        std::stable_sort(order.begin(), order.end(), [&](std::uint32_t a, std::uint32_t b) {
+            const double ca = score[a] + bias[a], cb = score[b] + bias[b];
+            return ca != cb ? ca > cb : a < b;
+        });
+        picked.assign(order.begin(), order.begin() + top_k);
+    }
+    double sum = 0;
+    for (std::uint32_t i = 0; i < top_k; ++i) { sum += score[picked[i]]; }
+    std::vector<double> w_exp(top_k);
+    for (std::uint32_t i = 0; i < top_k; ++i) { w_exp[i] = 2.5 * score[picked[i]] / (sum + 1e-20); }
+    std::vector<double> want(hidden, 0.0);
+    for (std::uint32_t slot = 0; slot < top_k; ++slot) {
+        const auto e = picked[slot];
+        const std::vector<float> g = projected(
+            std::vector<float>(gex.begin() + static_cast<std::ptrdiff_t>(e) * ffn * hidden,
+                              gex.begin() + static_cast<std::ptrdiff_t>(e + 1) * ffn * hidden),
+            ffn, hidden, x);
+        const std::vector<float> u = projected(
+            std::vector<float>(uex.begin() + static_cast<std::ptrdiff_t>(e) * ffn * hidden,
+                              uex.begin() + static_cast<std::ptrdiff_t>(e + 1) * ffn * hidden),
+            ffn, hidden, x);
+        std::vector<float> act(ffn);
+        for (std::uint32_t i = 0; i < ffn; ++i) {
+            const double cg = std::min((double)g[i], 10.0);
+            const double cu = std::max(-10.0, std::min((double)u[i], 10.0));
+            act[i] = static_cast<float>(cg / (1.0 + std::exp(-cg)) * cu);
+        }
+        act = bf16(act);
+        const auto dacc = gemv(
+            std::vector<float>(dex.begin() + static_cast<std::ptrdiff_t>(e) * hidden * ffn,
+                               dex.begin() + static_cast<std::ptrdiff_t>(e + 1) * hidden * ffn),
+            hidden, ffn, act);
+        for (std::uint32_t i = 0; i < hidden; ++i) { want[i] += w_exp[slot] * dacc[i]; }
+    }
+    {
+        const std::vector<float> g = projected(gsh, ffn, hidden, x);
+        const std::vector<float> u = projected(ush, ffn, hidden, x);
+        std::vector<float> act(ffn);
+        for (std::uint32_t i = 0; i < ffn; ++i) {
+            const double cg = std::min((double)g[i], 10.0);
+            const double cu = std::max(-10.0, std::min((double)u[i], 10.0));
+            act[i] = static_cast<float>(cg / (1.0 + std::exp(-cg)) * cu);
+        }
+        act = bf16(act);
+        const auto dacc = gemv(dsh, hidden, ffn, act);
+        for (std::uint32_t i = 0; i < hidden; ++i) { want[i] += dacc[i]; }
+    }
+
+    // device run
+    auto d_nw = upload(round_trip(nw));
+    auto d_router = upload(round_trip(gw));
+    auto d_bias = upload(bias);
+    auto d_gex = upload(round_trip(gex));
+    auto d_uex = upload(round_trip(uex));
+    auto d_dex = upload(round_trip(dex));
+    auto d_gsh = upload(round_trip(gsh));
+    auto d_ush = upload(round_trip(ush));
+    auto d_dsh = upload(round_trip(dsh));
+    auto d_h = upload(round_trip(hin));
+    test::GuardedDeviceBuffer d_out(hidden * 2);
+    test::GuardedDeviceBuffer d_scratch(execution::moe_block_scratch_bytes(hidden, ffn, experts, top_k));
+    execution::MoeBlockWeights w{};
+    w.ffn_norm = execution::bf16_weight(d_nw.data(), hidden, 1);
+    w.router = execution::bf16_weight(d_router.data(), experts, hidden);
+    w.gate_exps = execution::bf16_weight(d_gex.data(), experts * ffn, hidden);
+    w.up_exps = execution::bf16_weight(d_uex.data(), experts * ffn, hidden);
+    w.down_exps = execution::bf16_weight(d_dex.data(), experts * hidden, ffn);
+    w.gate_shexp = execution::bf16_weight(d_gsh.data(), ffn, hidden);
+    w.up_shexp = execution::bf16_weight(d_ush.data(), ffn, hidden);
+    w.down_shexp = execution::bf16_weight(d_dsh.data(), hidden, ffn);
+    Tensor ht(const_cast<void*>(d_h.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+    Tensor bt(const_cast<void*>(d_bias.data()), DType::FP32, {static_cast<std::int32_t>(experts)});
+    Tensor ot(const_cast<void*>(d_out.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+    execution::moe_block_decode(w, ht, bt, 1e-5f, 10.0f, 2.5f, experts, top_k, ffn, ot,
+                                d_scratch.data(), nullptr);
+    CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    check("moe_block", represented(download<__nv_bfloat16>(d_out)),
+          std::vector<float>(want.begin(), want.end()), 0.08);
+}
+
+int run() {
+    run_dsa_case(96, 2, 16, 24, 32, 16, 3, 12, 4, 8, 9);       // small probe (no completed pool edge first)
+    run_dsa_case(96, 2, 16, 24, 32, 16, 3, 12, 4, 8, 12);      // three completed pools
+    run_dsa_case(4096, 64, 256, 1536, 512, 256, 32, 128, 4, 2048, 16);   // audited geometry
+    run_mlp_cases();
+    run_moe_case();
+    if (failures == 0) {
+        std::puts("GLM5 DSA block and dense MLP match the chained host oracle on device");
+        return 0;
+    }
+    std::fprintf(stderr, "%d numeric failures\n", failures);
+    return 1;
+}
+
+} // namespace
+
+int main() {
+    try {
+        return run();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "FATAL: %s\n", error.what());
+        return 1;
+    } catch (...) {
+        std::fprintf(stderr, "FATAL: unknown exception\n");
+        return 1;
+    }
+}
diff --git a/tests/models/glm5/test_embed_prefill.cpp b/tests/models/glm5/test_embed_prefill.cpp
