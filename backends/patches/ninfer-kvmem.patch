index 0000000..826390a
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/clamp_swiglu_bf16_gaudi2.c
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// clamp_swiglu_fwd_bf16 — fused clamped-SwiGLU MoE epilogue for Intel Gaudi 2 (HL-225).
+//
+// Input  h   : [T, 2I] bf16, dense row-major. Declared to GC with dim0 = 2I (FCD),
+//              dim1 = T. The gate half of row t is h[t, 0:I], the up half h[t, I:2I].
+// Output out : [T, I]  bf16 (dim0 = I, dim1 = T).
+// Scalar     : limit (fp32 scalar kernel param; production value 10.0).
+//
+// Math per element (fp32 internal, single bf16 round at the very end):
+//   g = min(h_g, limit);  u = clamp(h_u, -limit, limit);
+//   out = silu(g) * u,  silu(g) = g * sigmoid(g).
+//
+// sigmoid comes from no_saturation_sigmoid_f32 (gaudi2/gaudi3 builtin): a short
+// polynomial that keeps full precision for large-negative gates. It replaces an
+// earlier hand-rolled 1/(1+exp(-|x|)) chain built from v_exp_f32 +
+// v_reciprocal_f32; that pair costs ~45 VPU ops per 64-lane half against ~20
+// here, and the two produce bit-identical bf16 output over the whole input
+// range (simulator A/B, sim_accuracy.cpp). Do NOT swap in v_sigmoid_f32: that
+// one is the LUT tanh path, which saturates to exact 0/1 at |x| >= 9 and so
+// zeroes out every deep-negative gate. no_saturation_sigmoid_bf16 is likewise
+// not a substitute — a bf16-domain sigmoid loses ~13% relative accuracy on
+// those same gates.
+//
+// Note the multiply order: (sigmoid(g) * g) * u. Folding it to
+// sigmoid(g) * (g * u) looks equivalent and schedules slightly better, but g*u
+// overflows fp32 for a large-magnitude gate (the gate is clamped only from
+// ABOVE), and 0 * inf is NaN. Keeping silu(g) as the first product bounds every
+// intermediate by limit^2.
+//
+// Vectorization: dim0 (I direction) in 128-lane bf16 steps (one 256 B VPU
+// vector). Two TOKENS are processed per iteration so that two independent
+// sigmoid chains are in flight and fill the VLIW bubble slots — that is the
+// axis with slack, because GC splits the index space along dim0 and typically
+// hands each of the 24 TPCs only one or two 128-element chunks per row. A
+// leftover odd row falls back to a 2x unroll along the FCD so a single-token
+// call still gets instruction-level parallelism. The trailing partial vector
+// (I % 128 != 0) is peeled out of the hot loop entirely: expressing it as a
+// ternary inside the loop made the compiler issue BOTH the full and the partial
+// load every iteration, doubling tensor traffic.
+
+// One 128-lane step: load gate at CG and up at CU, clamp, silu*up in fp32.
+#define BODY(CG, CU, G, U, S_)                                                   \
+    float128 G = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b(CG, h));           \
+    float128 U = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b(CU, h));           \
+    G.v1 = v_f32_min_b(G.v1, lim);                                               \
+    G.v2 = v_f32_min_b(G.v2, lim);                                               \
+    U.v1 = v_f32_max_b(v_f32_min_b(U.v1, lim), nlim);                            \
+    U.v2 = v_f32_max_b(v_f32_min_b(U.v2, lim), nlim);                            \
+    float128 S_;                                                                 \
+    S_.v1 = v_f32_mul_b(v_f32_mul_b(no_saturation_sigmoid_f32(G.v1), G.v1), U.v1); \
+    S_.v2 = v_f32_mul_b(v_f32_mul_b(no_saturation_sigmoid_f32(G.v2), G.v2), U.v2);
+
+// Same, for a trailing REM < 128 lane group.
+#define BODYP(CG, CU, REM, G, U, S_)                                             \
+    float128 G = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(CG, h, REM, 0)); \
+    float128 U = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(CU, h, REM, 0)); \
+    G.v1 = v_f32_min_b(G.v1, lim);                                               \
+    G.v2 = v_f32_min_b(G.v2, lim);                                               \
+    U.v1 = v_f32_max_b(v_f32_min_b(U.v1, lim), nlim);                            \
+    U.v2 = v_f32_max_b(v_f32_min_b(U.v2, lim), nlim);                            \
+    float128 S_;                                                                 \
+    S_.v1 = v_f32_mul_b(v_f32_mul_b(no_saturation_sigmoid_f32(G.v1), G.v1), U.v1); \
+    S_.v2 = v_f32_mul_b(v_f32_mul_b(no_saturation_sigmoid_f32(G.v2), G.v2), U.v2);
+
+#define ST(CG, S_)        v_bf16_st_tnsr(CG, out, v_convert_f32_to_bf16_all_b(S_));
+#define STP(CG, S_, REM)  v_bf16_st_tnsr_partial(CG, out, v_convert_f32_to_bf16_all_b(S_), REM, 0);
+
+void main(tensor h, tensor out, float limit)
+{
+    const int5 start = get_index_space_offset();
+    const int5 end   = start + get_index_space_size();
+
+    // Elements per output half-row: h dim0 = 2I.
+    const int I = get_dim_size(h, 0) >> 1;
+
+    float64 lim  = limit;    // scalar broadcast into vector lanes
+    float64 nlim = -limit;
+
+    const int s0 = start[0], e0 = end[0], t1 = end[1];
+
+    int5 ca = start, cb = start;   // gate (and output) coords, chains a and b
+    int5 ua = start, ub = start;   // up coords: same row, +I along the FCD
+
+    int t = start[1];
+    for (; t + 1 < t1; t += 2)     // two tokens per iteration
+    {
+        ca[1] = t;     ua[1] = t;
+        cb[1] = t + 1; ub[1] = t + 1;
+
+        int c0 = s0;
+        for (; c0 < e0 && (I - c0) >= 128; c0 += 128)
+        {
+            ca[0] = c0; ua[0] = c0 + I;
+            cb[0] = c0; ub[0] = c0 + I;
+            BODY(ca, ua, ga, ura, sa)
+            BODY(cb, ub, gb, urb, sb)
+            ST(ca, sa) ST(cb, sb)
+        }
+        if (c0 < e0)
+        {
+            const int rem = I - c0;
+            ca[0] = c0; ua[0] = c0 + I;
+            cb[0] = c0; ub[0] = c0 + I;
+            BODYP(ca, ua, rem, ga, ura, sa)
+            BODYP(cb, ub, rem, gb, urb, sb)
+            STP(ca, sa, rem) STP(cb, sb, rem)
+        }
+    }
+    if (t < t1)   // odd leftover row: take the parallelism from the FCD instead
+    {
+        ca[1] = t; ua[1] = t;
+        cb[1] = t; ub[1] = t;
+
+        int c0 = s0;
+        // both chunks must lie inside THIS member's slice, not just inside the
+        // row: GC guarantees 128-element granularity along dim0, not 256.
+        for (; c0 + 256 <= e0 && (I - c0) >= 256; c0 += 256)
+        {
+            ca[0] = c0;       ua[0] = c0 + I;
+            cb[0] = c0 + 128; ub[0] = c0 + 128 + I;
+            BODY(ca, ua, ga, ura, sa)
+            BODY(cb, ub, gb, urb, sb)
+            ST(ca, sa) ST(cb, sb)
+        }
+        for (; c0 < e0 && (I - c0) >= 128; c0 += 128)
+        {
+            ca[0] = c0; ua[0] = c0 + I;
+            BODY(ca, ua, g, ur, s)
+            ST(ca, s)
+        }
+        if (c0 < e0)
+        {
+            const int rem = I - c0;
+            ca[0] = c0; ua[0] = c0 + I;
+            BODYP(ca, ua, rem, g, ur, s)
+            STP(ca, s, rem)
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/clamp_swiglu_ext_src.cpp b/src/core/gaudi2/tpc/kernels/clamp_swiglu_ext_src.cpp
new file mode 100644
index 0000000..a7b665d
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/clamp_swiglu_ext_src.cpp
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: Apache-2.0
+// PyTorch custom-op binding for the clamp_swiglu_fwd_bf16 TPC kernel.
+// Compiled as a torch extension by loader.py; the GUID resolves through
+// GC_KERNEL_PATH to libclamp_swiglu_kernels.so.
+
+#include <torch/extension.h>
+#include <ATen/Tensor.h>
+#include "hpu_custom_op.h"
+
+struct ClampSwigluNodeParams
+{
+    float limit;
+};
+
+static std::vector<int64_t> clamp_swiglu_out_shape(const at::Stack& stack)
+{
+    auto               h     = stack[0].toTensor();
+    auto               sizes = h.sizes();
+    std::vector<int64_t> out(sizes.begin(), sizes.end());
+    out[out.size() - 1] /= 2;
+    return out;
+}
+
+static std::shared_ptr<void> clamp_swiglu_fill_params(const at::Stack& stack, size_t& size)
+{
+    HPU_PARAMS_STUB(ClampSwigluNodeParams);
+    params->limit = static_cast<float>(stack[1].toDouble());
+    return params;
+}
+
+static at::Tensor clamp_swiglu_hpu(const at::Tensor& input, double limit)
+{
+    const auto& desc = habana::custom_op::HabanaCustomOpDescriptor::getCustomOpDescriptor("custom_op::clamp_swiglu");
+    auto       res   = const_cast<habana::custom_op::HabanaCustomOpDescriptor&>(desc).execute(
+        {input, c10::IValue(limit)});
+    return res[0];
+}
+
+TORCH_LIBRARY(custom_op, m)
+{
+    m.def("clamp_swiglu(Tensor input, float limit) -> Tensor");
+}
+
+TORCH_LIBRARY_IMPL(custom_op, HPU, m)
+{
+    m.impl("clamp_swiglu", &clamp_swiglu_hpu);
+}
+
+namespace
+{
+const bool reg_clamp_swiglu = []() -> bool
+{
+    std::vector<habana::custom_op::InputDesc> inputs = {
+        {habana::custom_op::input_type::TENSOR, 0},
+        {habana::custom_op::input_type::USER_PARAMS, 1}};
+    std::vector<habana::custom_op::OutputDesc> outputs = {
+        {0, c10::ScalarType::BFloat16, clamp_swiglu_out_shape}};
+    REGISTER_CUSTOM_OP_ATTRIBUTES(
+        "custom_op::clamp_swiglu", "clamp_swiglu_fwd_bf16", inputs, outputs, clamp_swiglu_fill_params);
+
+    return true;
+}();
+} // namespace
+
+// cpp_extension.load() imports the module as a python extension — provide a
+// (near-empty) pybind surface; the real op lives in torch.ops.custom_op.
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m)
+{
+    m.def("registered", []() { return true; });
+}
diff --git a/src/core/gaudi2/tpc/kernels/compile_kernels.sh b/src/core/gaudi2/tpc/kernels/compile_kernels.sh
new file mode 100644
index 0000000..70db1dd
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/compile_kernels.sh
@@ -0,0 +1,29 @@
+#!/bin/bash
+# Compile every GLM-5.3-Flash TPC-C kernel with the SynapseAI tpc-clang
+# (extracted once into ~/tpc-sdk/extract — see README.md). 10/10 must pass
+# before any kernel-source change is committed.
+#
+# Requires: WSL Ubuntu with the habanalabs-graph 1.24.1-482 deb extracted
+# (tpc-clang 2.7.33, no installation beyond dpkg-deb -x).
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+OUT="${1:-/tmp/tpc-out}"
+GC="$HOME/tpc-sdk/extract/opt/habanalabs/bin/tpc-clang"
+GC_FLAGS="-march=gaudi2"
+if [ ! -x "$GC" ]; then
+    echo "tpc-clang not found at $GC — extract the SDK first (README.md)" >&2
+    exit 2
+fi
+mkdir -p "$OUT"
+pass=0; fail=0
+for src in "$HERE"/glm5_*_gaudi2.c; do
+    name=$(basename "$src" .c)
+    if "$GC" $GC_FLAGS -c "$src" -o "$OUT/$name.o" 2> "$OUT/$name.err"; then
+        echo "PASS $name"; pass=$((pass+1))
+    else
+        echo "FAIL $name"; fail=$((fail+1))
+        sed -n '1,12p' "$OUT/$name.err"
+    fi
+done
+echo "== $pass passed, $fail failed =="
+[ "$fail" -eq 0 ]
diff --git a/src/core/gaudi2/tpc/kernels/glm5_clamp_swiglu_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_clamp_swiglu_bf16_gaudi2.c
new file mode 100644
index 0000000..c656d9a
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_clamp_swiglu_bf16_gaudi2.c
@@ -0,0 +1,75 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash clamped SwiGLU TPC-C kernel for Gaudi2.
+// Adapted from abotsis/vllm-gaudi's tpc_clamp_swiglu (Apache-2.0), simplified
+// for the ninfer runtime adapter's tensor contracts and made tail-safe.
+//
+// Input  h   : [2I, T] BF16, dim0 = 2I (FCD), dim1 = T.
+//              Gate half: h[0:I], up half: h[I:2I] along dim0.
+// Output out : [I, T] BF16.
+// Scalar limit : FP32 (production 10.0).
+//
+// Math per element (FP32 internal, single BF16 round at output):
+//   g = min(h_g, limit);  u = clamp(h_u, -limit, limit);
+//   out = silu(g) * u,  silu(g) = g * sigmoid(g).
+//
+// The multiply order is (sigmoid(g) * g) * u; folding
+// to sigmoid(g) * (g * u) overflows FP32 for large-magnitude gates because
+// g*u can reach inf and 0 * inf = NaN. Keeping silu(g) first bounds every
+// intermediate by limit^2.
+//
+// The tail chunk (I % 128) uses partial load/store with count clamping.
+//
+// Sigmoid is the no-LUT Cephe path (v_exp_cephes_f32 + v_reciprocal_f32);
+// the LUT tanh path (v_sigmoid_f32) saturates to exact 0/1 at |x| >= 9 —
+// the deep-negative gate region that silu must resolve.
+
+static inline float64 sigmoid_nolut_f32(float64 v)
+{
+    return v_reciprocal_f32(1.0f + v_exp_cephes_f32(-v));
+}
+
+void main(tensor h, tensor out, float limit)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int inner  = get_dim_size(out, 0);  // I
+    const float64 nlim = -limit;
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        for (int i = begin[0]; i < end[0]; i += 128) {
+            const int count = (end[0] - i < 128) ? end[0] - i : 128;
+
+            // Load gate at [i] and up at [i + inner] along the FCD.
+            float128 g, u;
+            if (count == 128) {
+                g = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){i, token}, h));
+                u = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){i + inner, token}, h));
+            } else {
+                g = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){i, token}, h, count, 0));
+                u = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){i + inner, token}, h, count, 0));
+            }
+
+            // Clamp gate from above only; clamp up both sides.
+            float128 gc, uc;
+            gc.v1 = v_f32_min_b(g.v1, limit);
+            gc.v2 = v_f32_min_b(g.v2, limit);
+            uc.v1 = v_f32_max_b(v_f32_min_b(u.v1, limit), nlim);
+            uc.v2 = v_f32_max_b(v_f32_min_b(u.v2, limit), nlim);
+
+            // silu(g) * u, with the no-LUT Cephe sigmoid.
+            float128 result;
+            const float64 s1 = sigmoid_nolut_f32(gc.v1);
+            const float64 s2 = sigmoid_nolut_f32(gc.v2);
+            result.v1 = s1 * gc.v1 * uc.v1;  // sigmoid first: bounds by limit^2.
+            result.v2 = s2 * gc.v2 * uc.v2;
+
+            const bfloat128 packed = v_convert_f32_to_bf16_all_b(result);
+            if (count == 128) {
+                v_bf16_st_tnsr((int5){i, token}, out, packed);
+            } else {
+                v_bf16_st_tnsr_partial((int5){i, token}, out, packed, count - 1, 0);
+            }
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_dsa_absorb_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_dsa_absorb_bf16_gaudi2.c
new file mode 100644
index 0000000..3ec9fea
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_dsa_absorb_bf16_gaudi2.c
@@ -0,0 +1,68 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash DSA query absorption TPC-C kernel.
+//
+// q_abs[h, e] = Σ_d q[h, d] * wk_b[d + nope*e + nope*lora*h] in FP32 from
+// the represented BF16 inputs, for one token.
+//
+// Input  q     : BF16 [nope, heads] (FCD = nope; row-major [H][nope]).
+// Input  wk_b  : BF16 [nope*lora*heads, 1] in the GGUF {nope, lora, heads}
+//                layout — for a fixed (h, e) the d axis IS contiguous, but
+//                the e axis strides by `nope`: a 128-lane vector load along
+//                e would read across the non-contiguous lora dimension, so
+//                the kernel instead walks d in 128-lane chunks (the
+//                contiguous axis) and reduces.
+// Output q_abs : FP32 [lora, heads] (FCD = lora; row-major [H][lora]).
+//
+// Per (h, e): q-hat rides in registers as nope/128 chunks (shared across
+// all e of the head), wk rows load along d, and the dot leaves through a
+// broadcast-to-float128 store of one element.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor q, tensor wk_b, tensor q_abs)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    // q is {nope, heads}: dim0 is the contiguous head-dim width.
+    const int nope   = get_dim_size(q, 0);
+    const int heads  = get_dim_size(q, 1);
+    const int lora   = get_dim_size(q_abs, 0);   // q_abs is {lora, heads}
+
+    for (int h = 0; h < heads; ++h) {
+        // The head's q-hat plane in nope/128 float128 chunks (d contiguous).
+        float128 qh[8];
+        for (int col = 0; col < nope; col += 128) {
+            const int count = (nope - col < 128) ? nope - col : 128;
+            if (count == 128) {
+                qh[col / 128] = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_b((int5){col, h}, q));
+            } else {
+                qh[col / 128] = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){col, h}, q, count, 0));
+            }
+        }
+        for (int e = 0; e < lora; ++e) {
+            // wk_b row for (h, e): the d axis is contiguous from
+            // d = 0 at offset nope*e + nope*lora*h.
+            const int row = nope * e + nope * lora * h;
+            float128 acc = {0};
+            for (int col = 0; col < nope; col += 128) {
+                const int count = (nope - col < 128) ? nope - col : 128;
+                float128 w;
+                if (count == 128) {
+                    w = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){row + col, 0}, wk_b));
+                } else {
+                    w = v_convert_bf16_to_f32_all_b(
+                        v_bf16_ld_tnsr_partial_b((int5){row + col, 0}, wk_b, count, 0));
+                }
+                acc.v1 = v_f32_mac_b(w.v1, qh[col / 128].v1, acc.v1);
+                acc.v2 = v_f32_mac_b(w.v2, qh[col / 128].v2, acc.v2);
+            }
+            // One-element exit: reduce to a broadcast float64 and store a
+            // single lane (there is no vector->scalar conversion).
+            const float64 total = v_f32_reduce_add(acc.v1 + acc.v2);
+            // The store takes a float64 operand directly (a broadcast
+            // vector); last valid lane 0 writes exactly one element.
+            v_f32_st_tnsr_partial((int5){e, h}, q_abs, total, 0, 0);
+        }
+    }
+    (void)begin; (void)end;
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_dsa_attention_f32_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_dsa_attention_f32_gaudi2.c
new file mode 100644
index 0000000..de130b9
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_dsa_attention_f32_gaudi2.c
@@ -0,0 +1,130 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash DSA absorbed sparse attention TPC-C
+// kernel (decode path, one token).
+//
+// score_s = (q_abs[h, :] . latents[cells[s], :]) * qk_scale  (the model's
+// 256^-0.5 constant arrives precomputed as `qk_scale`);
+// softmax EXCLUDES -1 slots; ctx = Σ_s w_s * latents[cells[s], :];
+// out[h, v] = Σ_c wv_b[c + kv_lora*v + kv_lora*v_head*h, :] . ctx.
+//
+// Input  q_abs   : BF16 [H, kv_lora] (FCD = kv_lora).
+// Input  latents : BF16 [cache, kv_lora].
+// Input  cells   : Int32 [W, 1] from the select kernel.
+// Input  wv_b    : BF16 [kv_lora*v_head*H, 1] in the GGUF {lora, v_head, H}
+//                  layout — for fixed (h, v) the c axis is contiguous.
+// Output out     : BF16 [H*v_head, 1].
+// Scalar: qk_scale.
+//
+// Per head: two streaming passes over the selection row (max/sum, then the
+// weighted ctx accumulation — the exp/softmax math stays in broadcast
+// float64; the type model forbids vector->scalar extraction, which this
+// structure never needs). The wv_b contraction is lane-parallel dot
+// products (c blocks in lanes) whose scalar results exit through 1-lane
+// BF16 partial stores.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor q_abs, tensor latents, tensor cells, tensor wv_b, tensor out,
+          float qk_scale)
+{
+    const int5 begin = get_index_space_offset();
+    // q_abs is bound as {lora, heads} (FCD = lora): dim0 is the lane width,
+    // dim1 the head count.
+    const int lora   = get_dim_size(q_abs, 0);
+    const int heads  = get_dim_size(q_abs, 1);
+    const int v_head = get_dim_size(out, 0) / heads;
+    const int slots  = get_dim_size(cells, 0);
+
+    for (int h = 0; h < heads; ++h) {
+        // The head's query plane, kept as lora/128 float128 chunks.
+        float128 q[8];
+        for (int col = 0; col < lora; col += 128) {
+            const int count = (lora - col < 128) ? lora - col : 128;
+            if (count == 128) {
+                q[col / 128] = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_b((int5){col, h}, q_abs));
+            } else {
+                q[col / 128] = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(
+                    (int5){col, h}, q_abs, count, 0));
+            }
+        }
+
+        // Pass 1: max over the valid slots.
+        float64 maximum = as_float64((int64)0xff800000);
+        for (int s = 0; s < slots; ++s) {
+            const int cell = s_i32_ld_g(gen_addr((int5){s, 0}, cells));
+            if (cell >= 0) {
+                float128 acc = {0};
+                for (int col = 0; col < lora; col += 128) {
+                    const float128 x = v_convert_bf16_to_f32_all_b(
+                        v_bf16_ld_tnsr_b((int5){col, cell}, latents));
+                    acc.v1 = v_f32_mac_b(x.v1, q[col / 128].v1, acc.v1);
+                    acc.v2 = v_f32_mac_b(x.v2, q[col / 128].v2, acc.v2);
+                }
+                maximum = v_f32_max_b(
+                    v_f32_reduce_add(acc.v1 + acc.v2) * qk_scale, maximum);
+            }
+        }
+
+        // Pass 2: exp-normalized ctx accumulation.
+        float128 ctx[8];
+        for (int c = 0; c < 8; ++c) { ctx[c].v1 = 0; ctx[c].v2 = 0; }
+        float64 denom = 0;
+        for (int s = 0; s < slots; ++s) {
+            const int cell = s_i32_ld_g(gen_addr((int5){s, 0}, cells));
+            if (cell >= 0) {
+                float128 acc = {0};
+                for (int col = 0; col < lora; col += 128) {
+                    const float128 x = v_convert_bf16_to_f32_all_b(
+                        v_bf16_ld_tnsr_b((int5){col, cell}, latents));
+                    acc.v1 = v_f32_mac_b(x.v1, q[col / 128].v1, acc.v1);
+                    acc.v2 = v_f32_mac_b(x.v2, q[col / 128].v2, acc.v2);
+                }
+                const float64 w = v_exp_cephes_f32(
+                    v_f32_reduce_add(acc.v1 + acc.v2) * qk_scale - maximum);
+                denom += w;
+                for (int col = 0; col < lora; col += 128) {
+                    const int count = (lora - col < 128) ? lora - col : 128;
+                    float128 x;
+                    if (count == 128) {
+                        x = v_convert_bf16_to_f32_all_b(
+                            v_bf16_ld_tnsr_b((int5){col, cell}, latents));
+                    } else {
+                        x = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(
+                            (int5){col, cell}, latents, count, 0));
+                    }
+                    ctx[col / 128].v1 = v_f32_mac_b(x.v1, w, ctx[col / 128].v1);
+                    ctx[col / 128].v2 = v_f32_mac_b(x.v2, w, ctx[col / 128].v2);
+                }
+            }
+        }
+        const float64 inverse = v_reciprocal_f32(denom + 1.0e-20f);
+        for (int c = 0; c < 8; ++c) {
+            ctx[c].v1 = ctx[c].v1 * inverse;
+            ctx[c].v2 = ctx[c].v2 * inverse;
+        }
+
+        // wv_b contraction: per (h, v) a lane-parallel dot over c blocks.
+        for (int v = 0; v < v_head; ++v) {
+            const int wv_row = lora * v + lora * v_head * h;
+            float128 acc = {0};
+            for (int col = 0; col < lora; col += 128) {
+                const int count = (lora - col < 128) ? lora - col : 128;
+                float128 wv;
+                if (count == 128) {
+                    wv = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){col + wv_row, 0}, wv_b));
+                } else {
+                    wv = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(
+                        (int5){col + wv_row, 0}, wv_b, count, 0));
+                }
+                acc.v1 = v_f32_mac_b(wv.v1, ctx[col / 128].v1, acc.v1);
+                acc.v2 = v_f32_mac_b(wv.v2, ctx[col / 128].v2, acc.v2);
+            }
+            const float64 total = v_f32_reduce_add(acc.v1 + acc.v2);
+            float128 packed;
+            packed.v1 = total;
+            packed.v2 = total;
+            v_bf16_st_tnsr_partial((int5){h * v_head + v, 0}, out,
+                                   v_convert_f32_to_bf16_all_b(packed), 0, 0);
+        }
+    }
+    (void)begin;
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_dsa_pool_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_dsa_pool_bf16_gaudi2.c
new file mode 100644
index 0000000..223c9d6
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_dsa_pool_bf16_gaudi2.c
@@ -0,0 +1,87 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash DSA indexer pooling TPC-C kernel.
+//
+// pooled[p, e] = Σ_m softmax_m(ig[p*K+m, e] + ape[m, e]) * ik[p*K+m, e]
+// with the softmax running SEPARATELY PER KEY-DIM ELEMENT over the K pool
+// members: each lane e carries its own K-way distribution, so the max, the
+// exp-sum denominator, and the weighted sum are all per-lane vectors. The
+// two 64-lane halves of a 128-wide block are DIFFERENT output elements and
+// must keep separate denominators - folding w.v1 and w.v2 into one
+// accumulator would give every (col+i, col+64+i) pair a shared normalizer
+// (an all-ones input would pool to 0.5 instead of 1).
+//
+// Input  ik, ig  : BF16 [D, T] (FCD = D), T a multiple of K.
+// Input  ape     : FP32 [D, K] (FCD = D).
+// Output pooled  : FP32 [D, T/K] (FCD = D).
+// Scalar: K (the pool size).
+//
+// Pass 1 finds the per-lane max; pass 2 exponentiates, normalizes by the
+// lane's own sum, and MACs the weighted ik. FP32 tensors move in 64-lane
+// halves; the tail block uses partial loads/stores.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor ik, tensor ig, tensor ape, tensor pooled, int pool_k)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(ig, 0);       // D (FCD of the {dim, tokens} planes)
+    const int pools  = get_dim_size(pooled, 1);   // pooled is {dim, pools}
+
+    for (int pool = begin[0]; pool < end[0] && pool < pools; ++pool) {
+        for (int col = begin[1]; col < end[1] && col < width; col += 128) {
+            const int count = (width - col < 128) ? width - col : 128;
+
+            // Pass 1: per-lane max over the K logits (ig + ape).
+            float64 max1 = as_float64((int64)0xff800000);
+            float64 max2 = as_float64((int64)0xff800000);
+            for (int m = 0; m < pool_k; ++m) {
+                const float128 g = v_convert_bf16_to_f32_all_b(
+                    count == 128
+                        ? v_bf16_ld_tnsr_b((int5){col, pool * pool_k + m}, ig)
+                        : v_bf16_ld_tnsr_partial_b((int5){col, pool * pool_k + m}, ig, count, 0));
+                float128 a = {0};
+                a.v1 = count > 0
+                    ? v_f32_ld_tnsr_partial_b((int5){col, m}, ape, count > 64 ? 64 : count, 0)
+                    : 0;
+                if (count > 64)
+                    a.v2 = v_f32_ld_tnsr_partial_b((int5){col + 64, m}, ape, count - 64, 0);
+                max1 = v_f32_max_b(g.v1 + a.v1, max1);
+                if (count > 64) max2 = v_f32_max_b(g.v2 + a.v2, max2);
+            }
+
+            // Pass 2: each half keeps its OWN per-lane denominator.
+            float64 sum1 = 0, sum2 = 0;
+            float64 wsum1 = 0, wsum2 = 0;
+            for (int m = 0; m < pool_k; ++m) {
+                const float128 g = v_convert_bf16_to_f32_all_b(
+                    count == 128
+                        ? v_bf16_ld_tnsr_b((int5){col, pool * pool_k + m}, ig)
+                        : v_bf16_ld_tnsr_partial_b((int5){col, pool * pool_k + m}, ig, count, 0));
+                float128 a = {0};
+                a.v1 = count > 0
+                    ? v_f32_ld_tnsr_partial_b((int5){col, m}, ape, count > 64 ? 64 : count, 0)
+                    : 0;
+                if (count > 64)
+                    a.v2 = v_f32_ld_tnsr_partial_b((int5){col + 64, m}, ape, count - 64, 0);
+                const float128 x = v_convert_bf16_to_f32_all_b(
+                    count == 128
+                        ? v_bf16_ld_tnsr_b((int5){col, pool * pool_k + m}, ik)
+                        : v_bf16_ld_tnsr_partial_b((int5){col, pool * pool_k + m}, ik, count, 0));
+
+                float128 w;
+                w.v1 = v_exp_cephes_f32((g.v1 + a.v1) - max1);
+                w.v2 = v_exp_cephes_f32((g.v2 + a.v2) - max2);
+                sum1 += w.v1;
+                sum2 += w.v2;
+                wsum1 = v_f32_mac_b(x.v1, w.v1, wsum1);
+                wsum2 = v_f32_mac_b(x.v2, w.v2, wsum2);
+            }
+
+            v_f32_st_tnsr_partial((int5){col, pool}, pooled,
+                                  wsum1 * v_reciprocal_f32(sum1),
+                                  (count > 64 ? 64 : count) - 1, 0);
+            if (count > 64)
+                v_f32_st_tnsr_partial((int5){col + 64, pool}, pooled,
+                                      wsum2 * v_reciprocal_f32(sum2), count - 64 - 1, 0);
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_dsa_scale_f32_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_dsa_scale_f32_gaudi2.c
new file mode 100644
index 0000000..d7d8608
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_dsa_scale_f32_gaudi2.c
@@ -0,0 +1,27 @@
+// ninfer::gaudi2::tpc — elementwise FP32 scaling, TPC-C for Gaudi2:
+// out = values * factor. FP32 tensors move in 64-lane halves with partial
+// tail handling. Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor values, tensor out, float factor)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(values, 0);
+
+    for (int col = begin[0]; col < end[0] && col < width; col += 128) {
+        const int count = (width - col < 128) ? width - col : 128;
+        const float64 v1 = count > 0
+            ? (count >= 64 ? v_f32_ld_tnsr_b((int5){col, 0}, values)
+                           : v_f32_ld_tnsr_partial_b((int5){col, 0}, values, count, 0))
+            : 0;
+        v_f32_st_tnsr_partial((int5){col, 0}, out, v1 * factor,
+                              (count > 64 ? 64 : count) - 1, 0);
+        if (count > 64) {
+            const int count2 = count - 64;
+            const float64 v2 = count2 >= 64
+                ? v_f32_ld_tnsr_b((int5){col + 64, 0}, values)
+                : v_f32_ld_tnsr_partial_b((int5){col + 64, 0}, values, count2, 0);
+            v_f32_st_tnsr_partial((int5){col + 64, 0}, out, v2 * factor, count2 - 1, 0);
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_dsa_score_f32_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_dsa_score_f32_gaudi2.c
new file mode 100644
index 0000000..fc5a413
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_dsa_score_f32_gaudi2.c
@@ -0,0 +1,63 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash DSA indexer scoring TPC-C kernel.
+//
+// score[p] = Σ_h relu(iq[h, :] . pooled[p, :]) * weights[h], where weights
+// are ALREADY scaled by 1/sqrt(D*H) by the caller.
+//
+// Input  iq      : BF16 [H, D] (FCD = D), H = index heads.
+// Input  pooled  : FP32 [P, D].
+// Input  weights : FP32 [H, 1].
+// Output score   : FP32 [P, 1].
+//
+// Per pool: H dot products (128-lane MAC + reduce, FP32 domain), relu, and
+// the weighted sum accumulates in a broadcast float64; the single output
+// element leaves through a 1-lane partial store (the type model has no
+// vector->scalar extraction, but every lane of the broadcast carries the
+// same value).
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor iq, tensor pooled, tensor weights, tensor score)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    // iq is {dim, heads} and pooled {dim, pools}: dim0 is the shared key-dim
+    // width; the counts ride on dim1.
+    const int width  = get_dim_size(iq, 0);   // D
+    const int heads  = get_dim_size(iq, 1);
+    const int pools  = get_dim_size(pooled, 1);
+
+    for (int pool = begin[0]; pool < end[0] && pool < pools; ++pool) {
+        float64 acc = 0;
+        for (int h = 0; h < heads; ++h) {
+            float128 dot = {0};
+            for (int col = 0; col < width; col += 128) {
+                const int count = (width - col < 128) ? width - col : 128;
+                float128 q;
+                if (count == 128) {
+                    q = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){col, h}, iq));
+                } else {
+                    q = v_convert_bf16_to_f32_all_b(
+                        v_bf16_ld_tnsr_partial_b((int5){col, h}, iq, count, 0));
+                }
+                const float64 p1 = count > 64
+                    ? v_f32_ld_tnsr_b((int5){col, pool}, pooled)
+                    : v_f32_ld_tnsr_partial_b((int5){col, pool}, pooled, count, 0);
+                const float64 p2 = count > 64
+                    ? v_f32_ld_tnsr_b((int5){col + 64, pool}, pooled)
+                    : 0;
+                const int count2 = count > 64 ? count - 64 : 0;
+                dot.v1 = v_f32_mac_b(q.v1, p1, dot.v1);
+                if (count2 > 0)
+                    dot.v2 = v_f32_mac_b(q.v2,
+                        v_f32_ld_tnsr_partial_b((int5){col + 64, pool}, pooled, count2, 0),
+                        dot.v2);
+            }
+            const float64 total = v_f32_reduce_add(dot.v1 + dot.v2);
+            const float64 clamped = v_f32_max_b(total, 0.0f);
+            const float w = s_f32_ld_g(gen_addr((int5){h, 0}, weights));
+            acc = v_f32_mac_b(clamped, w, acc);
+        }
+        // Last valid lane INDEX: one element passes 0 - a 1 here writes
+        // two lanes and a neighbouring partition overwrites its peer.
+        v_f32_st_tnsr_partial((int5){pool, 0}, score, acc, 0, 0);
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_dsa_select_f32_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_dsa_select_f32_gaudi2.c
new file mode 100644
index 0000000..f8f04b3
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_dsa_select_f32_gaudi2.c
@@ -0,0 +1,80 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash DSA pool selection TPC-C kernel.
+//
+// The visible pools (p visible iff p*K + K-1 <= position, i.e. the first
+// n_vis = (position+1)/K pools) are ranked stable-descending with exact ties
+// broken by lower pool index; the pool at rank r occupies cells
+// [r*K, r*K+K); the incomplete tail (cells n_vis*K .. position, the query
+// included) fills [top_pools*K, ...) in position order when select_tail;
+// every unused slot of the fixed width W = top_pools*K + (K-1) is -1.
+//
+// Input  score  : FP32 [P, 1] (P <= 512).
+// Output cells  : Int32 [W, 1].
+// Scalars: position (the query's global position), pool_k, top_pools,
+//          select_tail (0/1).
+//
+// The top-pools ranking reuses the MoE router's repeated-max machinery:
+// chunks of 64 lanes, vector (key, id) selects, reduce-max winner,
+// reduce-min id on ties, predicated retirement. Cell runs write through
+// `winner*K + lane_id` so one partial store emits a pool's whole K-cell
+// span; the tail and the -1 fill use the same lane trick.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+#define DSA_SELECT_MAX_CHUNKS 8
+
+void main(tensor score, tensor cells, int position, int pool_k,
+          int top_pools, int select_tail)
+{
+    // One slot (review S3): the whole ranking runs inside it, so the -1
+    // fill must walk the FULL cells width - the production width
+    // W = top_pools*K + K-1 = 2051 spans 33 lane runs, not one.
+    const int pools = get_dim_size(score, 0);
+    const int visible = (position + 1) / pool_k;
+    const int chunks = (visible + 63) / 64;
+    const int64 lanes = (int64)V_LANE_ID_32;
+    const int width = get_dim_size(cells, 0);  // W
+
+    // -1 fill for every cell (the selected runs overwrite theirs).
+    for (int c = 0; c < width; c += 64) {
+        const int count = (width - c < 64) ? width - c : 64;
+        v_i32_st_tnsr_partial((int5){c, 0}, cells, lanes * 0 - 1, count - 1, 0);
+    }
+
+    // Load the visible scores into chunks and rank them.
+    float64 key[DSA_SELECT_MAX_CHUNKS];
+    bool64 eligible[DSA_SELECT_MAX_CHUNKS];
+    for (int c = 0; c < chunks; ++c) {
+        const int have = visible - c * 64;
+        key[c] = have >= 64
+            ? v_f32_ld_tnsr_b((int5){c * 64, 0}, score)
+            : v_f32_ld_tnsr_partial_b((int5){c * 64, 0}, score, have, 0);
+        eligible[c] = v_i32_cmp_less_b(lanes, (int64)have);
+    }
+
+    for (int rank = 0; rank < top_pools; ++rank) {
+        int64_float64_pair_t local;
+        local.v1 = 2147483647;
+        local.v2 = as_float64((int64)0xff800000);
+        for (int c = chunks - 1; c >= 0; --c) {
+            local = v_i32_sel2_geq_f32_vb(key[c], local.v2, lanes + c * 64, local.v1,
+                                          0, local, eligible[c], 0);
+        }
+        const float64 best = v_f32_reduce_max(local.v2);
+        int64 winner = v_i32_sel_eq_f32_b(local.v2, best, local.v1, 2147483647);
+        winner = v_i32_reduce_min(winner);
+        for (int c = 0; c < chunks; ++c)
+            eligible[c] = eligible[c] & v_i32_cmp_neq_b(lanes + c * 64, winner);
+
+        // The pool's whole K-cell span in one lane-indexed partial store.
+        v_i32_st_tnsr_partial((int5){rank * pool_k, 0}, cells,
+                              winner * pool_k + lanes, pool_k - 1, 0);
+    }
+
+    // The incomplete tail: cells n_vis*K .. position in position order.
+    if (select_tail) {
+        const int tail_len = (position + 1) - visible * pool_k;
+        if (tail_len > 0) {
+            v_i32_st_tnsr_partial((int5){top_pools * pool_k, 0}, cells,
+                                  lanes + visible * pool_k, tail_len - 1, 0);
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_kda_gate_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_kda_gate_bf16_gaudi2.c
new file mode 100644
index 0000000..2b04ad5
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_kda_gate_bf16_gaudi2.c
@@ -0,0 +1,73 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash KDA decay gate TPC-C kernel for Gaudi2.
+//
+// Input  a     : BF16 [d_inner, T], dim0 = d_inner (FCD), dim1 = T.
+//                The already-summed f_b(f_a(x)) + dt_bias plane.
+// Input  a_log : FP32 [heads, 1] (padded to 2-D by the host bridge).
+// Output gate  : FP32 [d_inner, T] (log space, values in (lower_bound, 0]).
+// Scalars: lower_bound (negative finite FP32), head_dim.
+//
+// Math: gate[i, t] = lower_bound * sigmoid(exp(A_log[i / head_dim]) * a[i, t]).
+// The result is the log-space decay factor the KDA recurrence kernel
+// exponentiates. The output stays FP32 (not BF16) because exp() amplifies
+// any BF16 rounding in the log domain by the gate magnitude.
+//
+// Vectorized contract: head_dim == 128 (the production KDA head), so every
+// 128-lane chunk of `a` spans exactly one head and the per-head rate is a
+// single scalar broadcast. FP32 tensors load/store in 64-lane halves
+// (v_f32_ld/st semantics on this target), hence the split stores.
+//
+// Sigmoid is the no-LUT Cephe path (v_exp_cephes_f32 + v_reciprocal_f32):
+// the LUT tanh path (v_sigmoid_f32) saturates to exact 0/1 at |x| >= 9, and
+// the deep-negative product region maps to the whole decay range.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+static inline float64 sigmoid_nolut_f32(float64 v)
+{
+    return v_reciprocal_f32(1.0f + v_exp_cephes_f32(-v));
+}
+
+void main(tensor a, tensor a_log, tensor gate, float lower_bound, int head_dim)
+{
+    // Vector slots (review S2): the glue maps slot s onto the element span
+    // [s*128, s*128+127], so one slot is exactly one head's 128 elements
+    // when head_dim == 128 - no lane ever crosses a head boundary and no
+    // store leaves its slot. Element-partitioned scheduling could split a
+    // head's span across slots, which the old element-coordinate loop both
+    // overwrote (fixed 63-lane stores) and mis-rated (broadcast rate of
+    // the chunk's first head).
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(a, 0);
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        for (int slot = begin[0]; slot < end[0]; ++slot) {
+            const int i = slot * 128;
+            const int count = (width - i < 128) ? width - i : 128;
+            const int head = slot;  // head_dim == 128: slot index == head
+            const float rate = s_f32_ld_g(gen_addr((int5){head, 0}, a_log));
+            const float64 decay_scale = exp_f32(rate);
+
+            float128 av;
+            if (count == 128) {
+                av = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){i, token}, a));
+            } else {
+                av = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){i, token}, a, count, 0));
+            }
+
+            float128 out;
+            out.v1 = lower_bound * sigmoid_nolut_f32(av.v1 * decay_scale);
+            out.v2 = lower_bound * sigmoid_nolut_f32(av.v2 * decay_scale);
+
+            // Masked 64-lane halves; the partial-store argument is the last
+            // valid lane index, so the second half is skipped entirely when
+            // the slot's tail is short.
+            const int first = count >= 64 ? 64 : count;
+            v_f32_st_tnsr_partial((int5){i, token}, gate, out.v1, first - 1, 0);
+            if (count > 64) {
+                v_f32_st_tnsr_partial((int5){i + 64, token}, gate, out.v2,
+                                      count - 64 - 1, 0);
+            }
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_kda_scan_f32_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_kda_scan_f32_gaudi2.c
new file mode 100644
index 0000000..9ae373e
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_kda_scan_f32_gaudi2.c
@@ -0,0 +1,102 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash KDA delta-rule recurrence TPC-C kernel.
+//
+// Single token, all heads. One index-space x-slot per head.
+//
+// Input  q     : BF16 [d_inner, 1] (post-conv, pre-norm).
+// Input  k     : BF16 [d_inner, 1].
+// Input  v     : BF16 [d_inner, 1].
+// Input  gate  : FP32 [d_inner, 1] (log space, from the KDA gate kernel).
+// Input  beta  : FP32 [heads, 1] (already sigmoided).
+// In/Out state : FP32 [heads*dk*dk, 1], row = key axis i, lane = value axis j
+//                at offset head*dk*dk + i*dk + j; updated in place.
+// Output out   : BF16 [d_inner, 1] (pre-output-gate).
+// Scalar: head_dim (must equal 128 — the production KDA head).
+//
+// Math per head h (k-hat/q-hat are L2-normalized, q scaled by dk^-0.5,
+// eps 1e-6 inside both sqrts):
+//   c[i]    = exp(gate[i]) * k_hat[i]
+//   u[j]    = Σ_i c[i] * S[i][j]                (pass A over state)
+//   delta[j]= beta * (v[j] - u[j])
+//   S'[i][j]= c[i] * S[i][j] + k_hat[i] * delta[j]
+//   out[j]  = Σ_i q_hat[i] * S'[i][j]           (pass B, fused with update)
+//
+// Two streaming passes over the HBM-resident state rows; the state never
+// needs to fit in TPC local memory (the 64KB-per-head local-array variant
+// exists as a later optimization target). u/delta/out stay lane-aligned
+// float128 vectors: lane j of the row load IS value-axis j, so the
+// recurrence's column indexing is free. Per-row scalar coefficients come
+// from scalar memory reads (s_bf16_ld_g/s_f32_ld_g) and broadcast into
+// float64 lane math — the TPC type model has no vector->scalar extraction.
+// FP32 state rows load/store in 64-lane halves (v_f32_ld_tnsr_b returns
+// float64 on this target).
+//
+// exp is the Cephe no-LUT path via exp_f32 on the broadcast coefficient.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor q, tensor k, tensor v, tensor gate, tensor beta,
+          tensor state, tensor out, int head_dim)
+{
+    const int5 begin = get_index_space_offset();
+    const int head = begin[0];
+    const int dk = head_dim;
+    const int base = head * dk;
+    const int state_base = head * dk * dk;
+
+    // ---- Load q, k, v as one 128-lane vector each; L2-normalize. ----
+    const float128 qv = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){base, 0}, q));
+    const float128 kv = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){base, 0}, k));
+    const float128 vv = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){base, 0}, v));
+
+    const float64 q_ss = v_f32_reduce_add(qv.v1 * qv.v1 + qv.v2 * qv.v2) + 1e-6f;
+    const float64 k_ss = v_f32_reduce_add(kv.v1 * kv.v1 + kv.v2 * kv.v2) + 1e-6f;
+    const float64 q_scale = rsqrt_f32(q_ss) * (1.0f / sqrt_f32((float64)dk));
+    const float64 k_inv = rsqrt_f32(k_ss);
+
+    float128 qh, kh;
+    qh.v1 = qv.v1 * q_scale;  qh.v2 = qv.v2 * q_scale;
+    kh.v1 = kv.v1 * k_inv;    kh.v2 = kv.v2 * k_inv;
+
+    const float64 beta_lane = s_f32_ld_g(gen_addr((int5){head, 0}, beta));
+
+    // ---- Pass A: u[j] = Σ_i c[i] * S[i][j], lane-aligned accumulation. ----
+    float128 u = {0};
+    for (int i = 0; i < dk; ++i) {
+        const float gi = s_f32_ld_g(gen_addr((int5){base + i, 0}, gate));
+        const float64 ki = s_bf16_ld_g(gen_addr((int5){base + i, 0}, k)) * k_inv;
+        const float64 c = exp_f32(gi) * ki;
+        const int row = state_base + i * dk;
+        u.v1 = v_f32_mac_b(v_f32_ld_tnsr_b((int5){row, 0}, state), c, u.v1);
+        u.v2 = v_f32_mac_b(v_f32_ld_tnsr_b((int5){row + 64, 0}, state), c, u.v2);
+    }
+
+    // ---- delta[j] = beta * (v[j] - u[j]). ----
+    float128 delta;
+    delta.v1 = beta_lane * (vv.v1 - u.v1);
+    delta.v2 = beta_lane * (vv.v2 - u.v2);
+
+    // ---- Pass B: update rows, accumulate out[j] = Σ_i q_hat[i] * S'[i][j]. ----
+    float128 out_acc = {0};
+    for (int i = 0; i < dk; ++i) {
+        const float gi = s_f32_ld_g(gen_addr((int5){base + i, 0}, gate));
+        const float64 ki = s_bf16_ld_g(gen_addr((int5){base + i, 0}, k)) * k_inv;
+        // The state update decays by exp(g) ALONE; k-hat only weights the
+        // delta term (u's coefficient carried exp(g)*k-hat, but reusing it
+        // here would multiply the carried state by k-hat every step).
+        const float64 decay = exp_f32(gi);
+        const float64 qi = s_bf16_ld_g(gen_addr((int5){base + i, 0}, q)) * q_scale;
+        const int row = state_base + i * dk;
+
+        const float64 r1 = v_f32_ld_tnsr_b((int5){row, 0}, state);
+        const float64 r2 = v_f32_ld_tnsr_b((int5){row + 64, 0}, state);
+        const float64 n1 = v_f32_mac_b(delta.v1, ki, r1 * decay);
+        const float64 n2 = v_f32_mac_b(delta.v2, ki, r2 * decay);
+        // FP32 tensor rows are 64 lanes; the partial-store argument is
+        // the last valid lane INDEX, so a full half passes 63.
+        v_f32_st_tnsr_partial((int5){row, 0}, state, n1, 63, 0);
+        v_f32_st_tnsr_partial((int5){row + 64, 0}, state, n2, 63, 0);
+        out_acc.v1 = v_f32_mac_b(n1, qi, out_acc.v1);
+        out_acc.v2 = v_f32_mac_b(n2, qi, out_acc.v2);
+    }
+
+    v_bf16_st_tnsr((int5){base, 0}, out, v_convert_f32_to_bf16_all_b(out_acc));
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_mhc_collapse_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_mhc_collapse_bf16_gaudi2.c
new file mode 100644
index 0000000..d67e976
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_mhc_collapse_bf16_gaudi2.c
@@ -0,0 +1,49 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash mHC pre-block stream collapse TPC-C
+// kernel: collapsed[t, :] = Σ_n pre[t, n] * streams[t, n*H + :].
+//
+// Input  streams : BF16 [4H, T], FCD = 4H, stream n at rows [n*H, (n+1)*H).
+// Input  pre     : FP32 [4, T] — the sigmoid+eps pre gates.
+// Output out     : BF16 [H, T] — the block's input residual.
+//
+// Per-token four scalar gate reads broadcast into float64 lane coefficients;
+// the H-axis runs in 128-lane chunks with FP32 MAC accumulation and a single
+// BF16 round at the store. Validated against tpc-clang 2.7.33 (SynapseAI
+// 1.24.1).
+
+void main(tensor streams, tensor pre, tensor out)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(out, 0);  // H
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        const float pre0 = s_f32_ld_g(gen_addr((int5){0, token}, pre));
+        const float pre1 = s_f32_ld_g(gen_addr((int5){1, token}, pre));
+        const float pre2 = s_f32_ld_g(gen_addr((int5){2, token}, pre));
+        const float pre3 = s_f32_ld_g(gen_addr((int5){3, token}, pre));
+
+        for (int col = begin[0]; col < end[0]; col += 128) {
+            const int count = (end[0] - col < 128) ? end[0] - col : 128;
+            float128 acc = {0};
+            for (int n = 0; n < 4; ++n) {
+                const float gate = n == 0 ? pre0 : n == 1 ? pre1 : n == 2 ? pre2 : pre3;
+                float128 x;
+                if (count == 128) {
+                    x = v_convert_bf16_to_f32_all_b(
+                        v_bf16_ld_tnsr_b((int5){n * width + col, token}, streams));
+                } else {
+                    x = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(
+                        (int5){n * width + col, token}, streams, count, 0));
+                }
+                acc.v1 = v_f32_mac_b(x.v1, gate, acc.v1);
+                acc.v2 = v_f32_mac_b(x.v2, gate, acc.v2);
+            }
+            if (count == 128) {
+                v_bf16_st_tnsr((int5){col, token}, out, v_convert_f32_to_bf16_all_b(acc));
+            } else {
+                v_bf16_st_tnsr_partial((int5){col, token}, out,
+                                       v_convert_f32_to_bf16_all_b(acc), count - 1, 0);
+            }
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_mhc_gates_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_mhc_gates_bf16_gaudi2.c
new file mode 100644
index 0000000..c341ff7
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_mhc_gates_bf16_gaudi2.c
@@ -0,0 +1,138 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash mHC gate generation TPC-C kernel.
+// Sinkhorn lane machinery adapted from the 1Cat flashinfer-gaudi mHC kernel
+// (Apache-2.0): the 4x4 comb matrix rides in the low 16 lanes of a float64;
+// row/column sums go through byte shuffles (matrix_direction maps entry k to
+// lane k), and the low-16 partial loads/stores move the whole group at once.
+//
+// Input  streams : BF16 [4H, T] — the four residual streams, FCD = 4H.
+// Input  mixes   : BF16 [24, T] — raw fn projections (MME GEMM output,
+//                  un-normalized; the gate math applies the RMS scale here,
+//                  so the BF16 rounding sits at the mix magnitude).
+// Input  base    : FP32 [24, 1] — pre[0:4] | post[4:8] | comb[8:24], comb
+//                  entry (s,d) at 8 + 4*s + d (src-major rows).
+// Input  scale   : FP32 [3, 1]  — {pre, post, comb} scales.
+// Output gates   : FP32 [24, T] — pre | post | comb in the same lane order.
+// Scalars: rms_eps, hc_eps, sinkhorn_iters (>= 1).
+//
+// Math per token:
+//   inv_rms   = 1 / sqrt(mean(streams^2) + rms_eps)      [FP32 scan of 4H]
+//   pre[n]    = sigmoid(mixes[n]*inv_rms*scale[0] + base[n]) + hc_eps
+//   post[n]   = 2 * sigmoid(mixes[4+n]*inv_rms*scale[1] + base[4+n])
+//   comb[s,d] = sinkhorn(softmax over d of mixes[8+4*s+d]*inv_rms*scale[2]
+//                        + base[8+4*s+d]):
+//               row-softmax, one column normalization (sum over src + hc_eps),
+//               then iters-1 rounds of {row over dst, column over src}.
+//
+// Sigmoid is the no-LUT Cephe path (v_sigmoid_f32's LUT saturates at |x|>=9).
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+static inline float64 sigmoid_nolut_f32(float64 v)
+{
+    return v_reciprocal_f32(1.0f + v_exp_cephes_f32(-v));
+}
+
+// Byte-shuffle selector that picks matrix entry k (lane k) into every lane.
+static inline uchar256 matrix_direction(uint64 index)
+{
+    const uint64 selected = (index & 7) | ((index & 8) << 2) | 0x80;
+    uint256 packed;
+    packed.v1 = selected;
+    packed.v2 = selected;
+    packed.v3 = selected;
+    packed.v4 = selected;
+    return v_convert_u32_to_u8_all_b(packed);
+}
+
+void main(tensor streams, tensor mixes, tensor base, tensor scale, tensor gates,
+          float rms_eps, float hc_eps, int sinkhorn_iters)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(streams, 0);  // 4H
+    const uint64 lane = read_lane_id_4b_b();
+    const uchar256 r0 = matrix_direction(lane & 0xfffffffc);
+    const uchar256 r1 = matrix_direction((lane & 0xfffffffc) | 1);
+    const uchar256 r2 = matrix_direction((lane & 0xfffffffc) | 2);
+    const uchar256 r3 = matrix_direction((lane & 0xfffffffc) | 3);
+    const uchar256 c0 = matrix_direction(lane & 3);
+    const uchar256 c1 = matrix_direction((lane & 3) | 4);
+    const uchar256 c2 = matrix_direction((lane & 3) | 8);
+    const uchar256 c3 = matrix_direction((lane & 3) | 12);
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        // In-kernel RMS of the four streams (FP32 accumulation over BF16).
+        float128 squares = {0};
+        for (int col = 0; col < width; col += 128) {
+            const int count = (width - col < 128) ? width - col : 128;
+            float128 x;
+            if (count == 128) {
+                x = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){col, token}, streams));
+            } else {
+                x = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){col, token}, streams, count, 0));
+            }
+            squares.v1 = v_f32_mac_b(x.v1, x.v1, squares.v1);
+            squares.v2 = v_f32_mac_b(x.v2, x.v2, squares.v2);
+        }
+        const float64 inv_rms = 1.0 /
+            sqrt_f32(v_f32_reduce_add(squares.v1 + squares.v2) *
+                        (1.0f / (float)width) + rms_eps);
+
+        const float64 pre_scale  = s_f32_ld_g(gen_addr((int5){0, 0}, scale));
+        const float64 post_scale = s_f32_ld_g(gen_addr((int5){1, 0}, scale));
+        const float64 comb_scale = s_f32_ld_g(gen_addr((int5){2, 0}, scale));
+
+        // pre[n] = sigmoid(mixes[n] * inv_rms * pre_scale + base[n]) + hc_eps.
+        const float64 pre_raw = v_convert_bf16_to_f32_all_b(
+            v_bf16_ld_tnsr_partial_b((int5){0, token}, mixes, 4, 0)).v1;
+        const float64 pre_base = v_f32_ld_tnsr_partial_b((int5){0, 0}, base, 4, 0);
+        const float64 pre_gates = sigmoid_nolut_f32(
+            pre_raw * (inv_rms * pre_scale) + pre_base) + hc_eps;
+        v_f32_st_tnsr_partial((int5){0, token}, gates, pre_gates, 3, 0);
+
+        // post[n] = 2 * sigmoid(mixes[4+n] * inv_rms * post_scale + base[4+n]).
+        const float64 post_raw = v_convert_bf16_to_f32_all_b(
+            v_bf16_ld_tnsr_partial_b((int5){4, token}, mixes, 4, 0)).v1;
+        const float64 post_base = v_f32_ld_tnsr_partial_b((int5){4, 0}, base, 4, 0);
+        const float64 post_gates = sigmoid_nolut_f32(
+            post_raw * (inv_rms * post_scale) + post_base) * 2.0f;
+        v_f32_st_tnsr_partial((int5){4, token}, gates, post_gates, 3, 0);
+
+        // comb: 16 raw lanes, stable softmax over dst (row-major src rows),
+        // then the Sinkhorn alternation.
+        const float64 comb_raw = v_convert_bf16_to_f32_all_b(
+            v_bf16_ld_tnsr_partial_b((int5){8, token}, mixes, 16, 0)).v1;
+        const float64 comb_base = v_f32_ld_tnsr_partial_b((int5){8, 0}, base, 16, 0);
+        float64 values = comb_raw * (inv_rms * comb_scale) + comb_base;
+
+        float64 maximum = -3.402823466e+38f;
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r0, 0, 0.0f), maximum);
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r1, 0, 0.0f), maximum);
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r2, 0, 0.0f), maximum);
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r3, 0, 0.0f), maximum);
+        values = v_exp_cephes_f32(values - maximum);
+        float64 sum = 0.0f;
+        sum += v_f32_shuffle_b(values, r0, 0, 0.0f);
+        sum += v_f32_shuffle_b(values, r1, 0, 0.0f);
+        sum += v_f32_shuffle_b(values, r2, 0, 0.0f);
+        sum += v_f32_shuffle_b(values, r3, 0, 0.0f);
+        values = values / (sum + hc_eps);
+
+        for (int iteration = 0; iteration < sinkhorn_iters; ++iteration) {
+            if (iteration != 0) {
+                const float64 a = v_f32_shuffle_b(values, r0, 0, 0.0f)
+                                + v_f32_shuffle_b(values, r1, 0, 0.0f);
+                const float64 b = v_f32_shuffle_b(values, r2, 0, 0.0f)
+                                + v_f32_shuffle_b(values, r3, 0, 0.0f);
+                values = values / ((a + b) + hc_eps);
+            }
+            float64 column_sum = 0.0f;
+            column_sum += v_f32_shuffle_b(values, c0, 0, 0.0f);
+            column_sum += v_f32_shuffle_b(values, c1, 0, 0.0f);
+            column_sum += v_f32_shuffle_b(values, c2, 0, 0.0f);
+            column_sum += v_f32_shuffle_b(values, c3, 0, 0.0f);
+            values = values / (column_sum + hc_eps);
+        }
+        v_f32_st_tnsr_partial((int5){8, token}, gates, values, 15, 0);
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_mhc_head_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_mhc_head_bf16_gaudi2.c
new file mode 100644
index 0000000..16818fc
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_mhc_head_bf16_gaudi2.c
@@ -0,0 +1,42 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash mHC head TPC-C kernel: the final
+// unweighted mean over the four streams, out[t, :] = (1/4) Σ_n streams[t, n*H + :].
+//
+// Input  streams : BF16 [4H, T], stream n at rows [n*H, (n+1)*H).
+// Output out     : BF16 [H, T].
+//
+// FP32 accumulation across the four 128-lane chunks, ×0.25, one BF16 round.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor streams, tensor out)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(out, 0);  // H
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        for (int col = begin[0]; col < end[0]; col += 128) {
+            const int count = (end[0] - col < 128) ? end[0] - col : 128;
+            float128 acc = {0};
+            for (int n = 0; n < 4; ++n) {
+                float128 x;
+                if (count == 128) {
+                    x = v_convert_bf16_to_f32_all_b(
+                        v_bf16_ld_tnsr_b((int5){n * width + col, token}, streams));
+                } else {
+                    x = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(
+                        (int5){n * width + col, token}, streams, count, 0));
+                }
+                acc.v1 += x.v1;
+                acc.v2 += x.v2;
+            }
+            acc.v1 = acc.v1 * 0.25f;
+            acc.v2 = acc.v2 * 0.25f;
+            if (count == 128) {
+                v_bf16_st_tnsr((int5){col, token}, out, v_convert_f32_to_bf16_all_b(acc));
+            } else {
+                v_bf16_st_tnsr_partial((int5){col, token}, out,
+                                       v_convert_f32_to_bf16_all_b(acc), count - 1, 0);
+            }
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_mhc_post_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_mhc_post_bf16_gaudi2.c
new file mode 100644
index 0000000..9f07e6e
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_mhc_post_bf16_gaudi2.c
@@ -0,0 +1,75 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash mHC post-block stream update TPC-C
+// kernel: out[t, dst, :] = post[t,dst] * block[t, :] + Σ_src comb[t,src,dst]
+//                                   * residual[t, src, :].
+//
+// Input  block    : BF16 [H, T] — the block output.
+// Input  residual : BF16 [4H, T] — the pre-block streams, stream src at rows
+//                   [src*H, (src+1)*H).
+// Input  post     : FP32 [4, T].
+// Input  comb     : FP32 [16, T] — entry (src, dst) at row 4*src + dst.
+// Output out      : BF16 [4H, T] — the updated streams, may alias residual.
+//
+// Four dst streams each re-scan their H-axis in 128-lane chunks; the five
+// scalar coefficients (one post, four comb) broadcast into float64 lane
+// math. FP32 accumulation, one BF16 round at the store.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor block, tensor residual, tensor post, tensor comb, tensor out)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(block, 0);  // H
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        const float post0 = s_f32_ld_g(gen_addr((int5){0, token}, post));
+        const float post1 = s_f32_ld_g(gen_addr((int5){1, token}, post));
+        const float post2 = s_f32_ld_g(gen_addr((int5){2, token}, post));
+        const float post3 = s_f32_ld_g(gen_addr((int5){3, token}, post));
+
+        for (int dst = 0; dst < 4; ++dst) {
+            const float dst_post = dst == 0 ? post0 : dst == 1 ? post1
+                                 : dst == 2 ? post2 : post3;
+            float64 c0 = s_f32_ld_g(gen_addr((int5){0 * 4 + dst, token}, comb));
+            float64 c1 = s_f32_ld_g(gen_addr((int5){1 * 4 + dst, token}, comb));
+            float64 c2 = s_f32_ld_g(gen_addr((int5){2 * 4 + dst, token}, comb));
+            float64 c3 = s_f32_ld_g(gen_addr((int5){3 * 4 + dst, token}, comb));
+
+            for (int col = begin[0]; col < end[0]; col += 128) {
+                const int count = (end[0] - col < 128) ? end[0] - col : 128;
+                float128 b, r0, r1, r2, r3;
+                if (count == 128) {
+                    b  = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){col, token}, block));
+                    r0 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){0 * width + col, token}, residual));
+                    r1 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){1 * width + col, token}, residual));
+                    r2 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){2 * width + col, token}, residual));
+                    r3 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){3 * width + col, token}, residual));
+                } else {
+                    b  = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b((int5){col, token}, block, count, 0));
+                    r0 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b((int5){0 * width + col, token}, residual, count, 0));
+                    r1 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b((int5){1 * width + col, token}, residual, count, 0));
+                    r2 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b((int5){2 * width + col, token}, residual, count, 0));
+                    r3 = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b((int5){3 * width + col, token}, residual, count, 0));
+                }
+                float128 acc;
+                acc.v1 = b.v1 * dst_post;
+                acc.v2 = b.v2 * dst_post;
+                acc.v1 = v_f32_mac_b(r0.v1, c0, acc.v1);
+                acc.v2 = v_f32_mac_b(r0.v2, c0, acc.v2);
+                acc.v1 = v_f32_mac_b(r1.v1, c1, acc.v1);
+                acc.v2 = v_f32_mac_b(r1.v2, c1, acc.v2);
+                acc.v1 = v_f32_mac_b(r2.v1, c2, acc.v1);
+                acc.v2 = v_f32_mac_b(r2.v2, c2, acc.v2);
+                acc.v1 = v_f32_mac_b(r3.v1, c3, acc.v1);
+                acc.v2 = v_f32_mac_b(r3.v2, c3, acc.v2);
+
+                const bfloat128 packed = v_convert_f32_to_bf16_all_b(acc);
+                if (count == 128) {
+                    v_bf16_st_tnsr((int5){dst * width + col, token}, out, packed);
+                } else {
+                    v_bf16_st_tnsr_partial((int5){dst * width + col, token}, out,
+                                           packed, count - 1, 0);
+                }
+            }
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_moe_combine_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_moe_combine_bf16_gaudi2.c
new file mode 100644
index 0000000..dcb552e
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_moe_combine_bf16_gaudi2.c
@@ -0,0 +1,50 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash MoE expert combination TPC-C kernel:
+// out[t, :] = Σ_i weights[t, i] * experts[t, i, :] + shared[t, :].
+//
+// Input  experts  : BF16 [top_k*H, T] — expert i at rows [i*H, (i+1)*H).
+// Input  weights  : FP32 [top_k, T].
+// Input  shared   : BF16 [H, T] — the shared expert, added unweighted.
+// Output out      : BF16 [H, T].
+//
+// top_k is a runtime scalar (register-bounded by the loop; the production
+// GLM-5.3-Flash route is 8). FP32 accumulation, one BF16 round at the store.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+void main(tensor experts, tensor weights, tensor shared, tensor out, int top_k)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(out, 0);  // H
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        for (int col = begin[0]; col < end[0]; col += 128) {
+            const int count = (end[0] - col < 128) ? end[0] - col : 128;
+            float128 acc;
+            if (count == 128) {
+                acc = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){col, token}, shared));
+            } else {
+                acc = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){col, token}, shared, count, 0));
+            }
+            for (int i = 0; i < top_k; ++i) {
+                const float w = s_f32_ld_g(gen_addr((int5){i, token}, weights));
+                float128 x;
+                if (count == 128) {
+                    x = v_convert_bf16_to_f32_all_b(
+                        v_bf16_ld_tnsr_b((int5){i * width + col, token}, experts));
+                } else {
+                    x = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(
+                        (int5){i * width + col, token}, experts, count, 0));
+                }
+                acc.v1 = v_f32_mac_b(x.v1, w, acc.v1);
+                acc.v2 = v_f32_mac_b(x.v2, w, acc.v2);
+            }
+            if (count == 128) {
+                v_bf16_st_tnsr((int5){col, token}, out, v_convert_f32_to_bf16_all_b(acc));
+            } else {
+                v_bf16_st_tnsr_partial((int5){col, token}, out,
+                                       v_convert_f32_to_bf16_all_b(acc), count - 1, 0);
+            }
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_moe_route_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_moe_route_bf16_gaudi2.c
new file mode 100644
index 0000000..d62f36f
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_moe_route_bf16_gaudi2.c
@@ -0,0 +1,115 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash MoE sigmoid router with noaux_tc
+// correction, TPC-C for Gaudi2. The repeated-max selection mechanism is
+// adapted from the 1Cat flashinfer-gaudi DeepSeek top-k router (Apache-2.0):
+// every 64-lane chunk carries one expert per lane; a vector select reduces
+// (score, expert-id) pairs, reduce-max picks the winner, ties resolve to the
+// smaller id via the reduce-min id pass, and predication retires winners.
+//
+// Input  logits          : BF16 [E, T] — the router projection, FCD = E.
+// Input  correction_bias : FP32 [E, 1] — the noaux_tc bias.
+// Output weights         : FP32 [top_k, T] — normalized ORIGINAL scores,
+//                          scaled by routed_scaling_factor.
+// Output indices         : Int32 [top_k, T] — expert ids, descending by
+//                          score + bias, ties by lower id.
+// Scalars: top_k (>= 1), routed_scaling_factor.
+//
+// Math per token:
+//   score[e]  = sigmoid(logits[e])                    [no-LUT Cephe sigmoid]
+//   rank key  = score[e] + correction_bias[e]
+//   select top_k by key (stable descending, ties -> lower id)
+//   weights[i] = score[sel_i] * routed_scaling / (Σ_j score[sel_j] + 1e-20)
+//
+// The expert axis rides in ceil(E/64) 64-lane chunks (register arrays sized
+// for 8 chunks = 512 experts; one BF16 load fills two chunks). Tail chunks
+// load partially and their idle lanes are excluded from selection.
+// Validated against tpc-clang 2.7.33 (SynapseAI 1.24.1).
+
+#define MOE_MAX_CHUNKS 8
+
+static inline float64 sigmoid_nolut_f32(float64 v)
+{
+    return v_reciprocal_f32(1.0f + v_exp_cephes_f32(-v));
+}
+
+void main(tensor logits, tensor correction_bias, tensor weights, tensor indices,
+          int top_k, float routed_scaling_factor)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int experts = get_dim_size(logits, 0);
+    const int chunks = (experts + 63) / 64;
+    const int64 lanes = (int64)V_LANE_ID_32;
+
+    for (int token = begin[1]; token < end[1]; ++token) {
+        float64 score[MOE_MAX_CHUNKS];
+        float64 key[MOE_MAX_CHUNKS];
+        bool64 eligible[MOE_MAX_CHUNKS];
+        for (int c = 0; c < chunks; ++c) {
+            score[c] = 0;
+            key[c] = as_float64((int64)0xff800000);  // -inf: idle until loaded
+            eligible[c] = v_i32_cmp_less_b(lanes, (int64)(experts - c * 64));
+        }
+
+        // One BF16 load covers two 64-lane chunks of logits.
+        for (int c = 0; c < chunks; c += 2) {
+            const int base = c * 64;
+            const int have = experts - base;
+            float128 raw;
+            if (have >= 128) {
+                raw = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_b((int5){base, token}, logits));
+            } else {
+                raw = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_partial_b(
+                    (int5){base, token}, logits, have, 0));
+            }
+            score[c] = sigmoid_nolut_f32(raw.v1);
+            if (c + 1 < chunks) score[c + 1] = sigmoid_nolut_f32(raw.v2);
+        }
+        for (int c = 0; c < chunks; ++c) {
+            const int base = c * 64;
+            const int have = experts - base;
+            const float64 bias = have >= 64
+                ? v_f32_ld_tnsr_b((int5){base, 0}, correction_bias)
+                : v_f32_ld_tnsr_partial_b((int5){base, 0}, correction_bias, have, 0);
+            key[c] = score[c] + bias;
+        }
+
+        float64 sum = 0;
+        float64 packed_weights = 0;
+        int64 packed_ids = 0;
+        for (int rank = 0; rank < top_k; ++rank) {
+            // Reduce (key, score, id) across all chunks; descending chunk
+            // order plus >= gives the smaller id on ties, and predication
+            // excludes already-selected experts and idle tail lanes.
+            int64_float64_pair_t local;
+            local.v1 = 2147483647;
+            local.v2 = as_float64((int64)0xff800000);
+            float64 local_score = 0;
+            for (int c = chunks - 1; c >= 0; --c) {
+                local_score = v_f32_sel_geq_f32_vb(key[c], local.v2, score[c], local_score,
+                                                   0, local_score, eligible[c], 0);
+                local = v_i32_sel2_geq_f32_vb(key[c], local.v2, lanes + c * 64, local.v1,
+                                              0, local, eligible[c], 0);
+            }
+            const float64 best = v_f32_reduce_max(local.v2);
+            int64 winner = v_i32_sel_eq_f32_b(local.v2, best, local.v1, 2147483647);
+            winner = v_i32_reduce_min(winner);
+            const bool64 selected_lane = v_i32_cmp_eq_b(local.v1, winner);
+            for (int c = 0; c < chunks; ++c)
+                eligible[c] = eligible[c] & v_i32_cmp_neq_b(lanes + c * 64, winner);
+            const float64 selected_weight = v_f32_reduce_add(
+                v_f32_mov_vb(local_score, 0, 0, selected_lane, 0));
+            const bool64 output_lane = v_i32_cmp_eq_b(lanes, rank);
+            packed_weights = v_f32_mov_vb(selected_weight, 0, packed_weights, output_lane, 0);
+            packed_ids = v_i32_mov_vb(winner, 0, packed_ids, output_lane, 0);
+            sum += selected_weight;
+        }
+
+        const float64 denominator = sum + 1.0e-20f;
+        float64 inverse = v_reciprocal_f32(denominator);
+        inverse = inverse * (2.0f - denominator * inverse);
+        v_i32_st_tnsr_partial((int5){0, token}, indices, packed_ids, top_k - 1, 0);
+        v_f32_st_tnsr_partial((int5){0, token}, weights,
+                              packed_weights * (inverse * routed_scaling_factor), top_k - 1, 0);
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/glm5_rmsnorm_bf16_gaudi2.c b/src/core/gaudi2/tpc/kernels/glm5_rmsnorm_bf16_gaudi2.c
new file mode 100644
index 0000000..9c6441a
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/glm5_rmsnorm_bf16_gaudi2.c
@@ -0,0 +1,75 @@
+// ninfer::gaudi2::tpc — GLM-5.3-Flash RMSNorm TPC-C kernel for Gaudi2.
+//
+// Input  x      : BF16 [D, T], dim0 = D (FCD), dim1 = T.
+// Input  weight : BF16 [D, 1] (padded to 2-D by the host bridge).
+// Output out    : BF16 [D, T].
+// Scalars: epsilon (e.g. 1e-5), inverse_width = 1/D.
+//
+// Math per token (FP32 internal, single BF16 round at output):
+//   ss    = Σ_d x[d]^2
+//   scale = 1 / sqrt(ss * inverse_width + epsilon)
+//   out[d] = x[d] * scale * weight[d]
+//
+// Two passes over D: squares accumulation, then the scaled store. Lanes are
+// 128-wide (float128 MACs, 64+64 lane fold before the reduce); the scalar
+// sqrt is IEEE, not the lookup rsqrt — the norm scale feeds every downstream
+// projection, so bit-exact-adjacent precision matters more than the ~cycle
+// the LUT saves. Vectorization idioms follow the flashinfer-gaudi RMSNorm
+// lineage (1Cat/flashinfer, Apache-2.0): independent accumulators, no
+// loop-carried FP32 dependency. The tail chunk (D % 128) uses partial
+// load/store with count clamping; D need not be a multiple of 128.
+
+void main(tensor x, tensor weight, tensor out, float epsilon, float inverse_width)
+{
+    const int5 begin = get_index_space_offset();
+    const int5 end   = begin + get_index_space_size();
+    const int width  = get_dim_size(x, 0);  // D
+
+    // One slot per token: the whole-row reduction must stay inside a slot
+    // (the FCD axis is never index-space mapped, so the graph compiler
+    // cannot split a row's pass across slots). Both passes walk [0, width).
+    for (int token = begin[1]; token < end[1]; ++token) {
+        // Pass 1: sum of squares in FP32.
+        float128 squares = {0};
+        for (int i = 0; i < width; i += 128) {
+            const int count = (width - i < 128) ? width - i : 128;
+            float128 v;
+            if (count == 128) {
+                v = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){i, token}, x));
+            } else {
+                v = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){i, token}, x, count, 0));
+            }
+            squares.v1 = v_f32_mac_b(v.v1, v.v1, squares.v1);
+            squares.v2 = v_f32_mac_b(v.v2, v.v2, squares.v2);
+        }
+        // 64+64 lane fold, then the 64-lane reduce (lane-fold is exact: adds
+        // disjoint halves element-wise, no reorder within a lane).
+        const float64 ss = v_f32_reduce_add(squares.v1 + squares.v2);
+        const float64 scale = 1.0 / sqrt_f32(ss * inverse_width + epsilon);
+
+        // Pass 2: scale and store.
+        for (int i = 0; i < width; i += 128) {
+            const int count = (width - i < 128) ? width - i : 128;
+            float128 v, w;
+            if (count == 128) {
+                v = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){i, token}, x));
+                w = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){i, 0}, weight));
+            } else {
+                v = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){i, token}, x, count, 0));
+                w = v_convert_bf16_to_f32_all_b(
+                    v_bf16_ld_tnsr_partial_b((int5){i, 0}, weight, count, 0));
+            }
+            float128 r;
+            r.v1 = v.v1 * scale * w.v1;
+            r.v2 = v.v2 * scale * w.v2;
+            if (count == 128) {
+                v_bf16_st_tnsr((int5){i, token}, out, v_convert_f32_to_bf16_all_b(r));
+            } else {
+                v_bf16_st_tnsr_partial((int5){i, token}, out,
+                                       v_convert_f32_to_bf16_all_b(r), count - 1, 0);
+            }
+        }
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/mhc_gates_f32_gaudi2.c b/src/core/gaudi2/tpc/kernels/mhc_gates_f32_gaudi2.c
new file mode 100644
index 0000000..32b8e1b
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/mhc_gates_f32_gaudi2.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: Apache-2.0
+// Keep each 4x4 mHC matrix in SIMD lanes. The scalar-per-entry implementation
+// replicated each matrix entry across a full vector and spilled local vectors.
+// Row and column shuffle reductions retain its FP32 addition order.
+#define HC_EPS 1.0e-6f
+#define SINKHORN_ITERS 20
+#ifndef DSV41_MHC_MME_EPILOGUE
+#define DSV41_MHC_MME_EPILOGUE 0
+#endif
+#ifndef DSV41_MHC_PARTIAL_STATISTICS
+#define DSV41_MHC_PARTIAL_STATISTICS 0
+#endif
+#if DSV41_MHC_MME_EPILOGUE
+#pragma clang fp contract(off)
+#define FLASHINFER_NORM_USE_LOOKUP_RSQRT
+#include "../../flashinfer_gaudi/kernels/norm_math_gaudi2.h"
+#endif
+
+static inline float64 projection_part(tensor projection, int5 at, int last) {
+    float64 value = v_f32_ld_tnsr_partial_b(at, projection, last, 0);
+#if DSV41_MHC_MME_EPILOGUE
+    if (get_dim_size(projection, 0) == 48) {
+        at[0] += 24;
+        value += v_f32_ld_tnsr_partial_b(at, projection, last, 0);
+    }
+#endif
+    return value;
+}
+
+static inline float64 sigmoid_f32(float64 value)
+{
+    return v_reciprocal_f32(1.0f + v_exp_cephes_f32(-value));
+}
+
+static inline uchar256 matrix_direction(uint64 index)
+{
+    const uint64 selected = (index & 7) | ((index & 8) << 2) | 0x80;
+    uint256 packed;
+    packed.v1 = selected;
+    packed.v2 = selected;
+    packed.v3 = selected;
+    packed.v4 = selected;
+    return v_convert_u32_to_u8_all_b(packed);
+}
+
+#ifdef DSV41_MHC_POSITIVE_DIV
+// Sinkhorn row/column denominators are finite and strictly positive after epsilon.
+// Two FP32 Newton corrections avoid generic reciprocal range/LUT machinery.
+static inline float64 sinkhorn_div(float64 numerator,float64 denominator) {
+    float64 inverse=as_float64((int64)0x7ef311c3-as_int64(denominator));
+    inverse*=v_f32_mac_b(-denominator,inverse,2.0f);
+    inverse*=v_f32_mac_b(-denominator,inverse,2.0f);
+    return numerator*inverse;
+}
+#else
+static inline float64 sinkhorn_div(float64 numerator,float64 denominator) { return numerator/denominator; }
+#endif
+
+void main(tensor raw_mixes, tensor rrms, tensor hc_scale, tensor hc_base,
+          tensor gates_out)
+{
+    const int5 start = get_index_space_offset();
+    const int5 end = start + get_index_space_size();
+    const uint64 lane = read_lane_id_4b_b();
+    const uchar256 r0 = matrix_direction(lane & 0xfffffffc);
+    const uchar256 r1 = matrix_direction((lane & 0xfffffffc) | 1);
+    const uchar256 r2 = matrix_direction((lane & 0xfffffffc) | 2);
+    const uchar256 r3 = matrix_direction((lane & 0xfffffffc) | 3);
+    const uchar256 c0 = matrix_direction(lane & 3);
+    const uchar256 c1 = matrix_direction((lane & 3) | 4);
+    const uchar256 c2 = matrix_direction((lane & 3) | 8);
+    const uchar256 c3 = matrix_direction((lane & 3) | 12);
+    for (int token = start[0]; token < end[0]; ++token) {
+#if DSV41_MHC_MME_EPILOGUE
+        // The input is already BF16. One scan supplies RRMS directly to
+        // Sinkhorn, avoiding FP32 expansion/reduction and the hi/lo add node.
+#if DSV41_MHC_PARTIAL_STATISTICS
+        float64 mean = v_f32_reduce_add(v_f32_ld_tnsr_partial_b((int5){0, token}, rrms, 39, 0))
+                       * (1.0f / 20480.0f);
+#else
+        float128 square = {0};
+        for (int col = 0; col < 20480; col += 128) {
+            const float128 x = v_convert_bf16_to_f32_all_b(v_bf16_ld_tnsr_b((int5){col, token}, rrms));
+            square.v1 += x.v1 * x.v1;
+            square.v2 += x.v2 * x.v2;
+        }
+        float64 mean = v_f32_reduce_add(square.v1 + square.v2) * (1.0f / 20480.0f);
+#endif
+        mean = v_f32_shuffle_b(mean, (uchar256)0x80, 0, mean);
+        const float64 inverse_rms = positive_rsqrt(mean + 1.0e-20f);
+#else
+        const float64 inverse_rms = s_f32_ld_g(
+            gen_addr((int5){0, token, 0, 0, 0}, rrms));
+#endif
+        const float64 pre_scale = s_f32_ld_g(gen_addr((int5){0}, hc_scale));
+        const float64 post_scale = s_f32_ld_g(gen_addr((int5){1, 0, 0, 0, 0}, hc_scale));
+        const float64 comb_scale = s_f32_ld_g(gen_addr((int5){2, 0, 0, 0, 0}, hc_scale));
+
+        const float64 pre_raw = projection_part(raw_mixes, (int5){0, token, 0, 0, 0}, 3);
+        const float64 pre_base = v_f32_ld_tnsr_partial_b((int5){0}, hc_base, 3, 0);
+        const float64 pre = sigmoid_f32(pre_raw * inverse_rms * pre_scale + pre_base) + HC_EPS;
+        v_f32_st_tnsr_partial((int5){0, token, 0, 0, 0}, gates_out, pre, 3, 0);
+
+        const float64 post_raw = projection_part(raw_mixes, (int5){4, token, 0, 0, 0}, 3);
+        const float64 post_base = v_f32_ld_tnsr_partial_b(
+            (int5){4, 0, 0, 0, 0}, hc_base, 3, 0);
+        const float64 post = sigmoid_f32(post_raw * inverse_rms * post_scale + post_base) * 2.0f;
+        v_f32_st_tnsr_partial((int5){4, token, 0, 0, 0}, gates_out, post, 3, 0);
+
+        const float64 raw = projection_part(raw_mixes, (int5){8, token, 0, 0, 0}, 15);
+        const float64 base = v_f32_ld_tnsr_partial_b(
+            (int5){8, 0, 0, 0, 0}, hc_base, 15, 0);
+        float64 values = raw * inverse_rms * comb_scale + base;
+        float64 maximum = -3.402823466e+38f;
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r0, 0, 0.0f), maximum);
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r1, 0, 0.0f), maximum);
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r2, 0, 0.0f), maximum);
+        maximum = v_f32_max_b(v_f32_shuffle_b(values, r3, 0, 0.0f), maximum);
+        values = v_exp_cephes_f32(values - maximum);
+        float64 sum = 0.0f;
+        sum += v_f32_shuffle_b(values, r0, 0, 0.0f);
+        sum += v_f32_shuffle_b(values, r1, 0, 0.0f);
+        sum += v_f32_shuffle_b(values, r2, 0, 0.0f);
+        sum += v_f32_shuffle_b(values, r3, 0, 0.0f);
+        values = sinkhorn_div(values,sum) + HC_EPS;
+
+        for (int iteration = 0; iteration < SINKHORN_ITERS; ++iteration) {
+            if (iteration != 0) {
+                const float64 a = v_f32_shuffle_b(values, r0, 0, 0.0f)
+                                + v_f32_shuffle_b(values, r1, 0, 0.0f);
+                const float64 b = v_f32_shuffle_b(values, r2, 0, 0.0f)
+                                + v_f32_shuffle_b(values, r3, 0, 0.0f);
+                values = sinkhorn_div(values,(a + b) + HC_EPS);
+            }
+            float64 column_sum = 0.0f;
+            column_sum += v_f32_shuffle_b(values, c0, 0, 0.0f);
+            column_sum += v_f32_shuffle_b(values, c1, 0, 0.0f);
+            column_sum += v_f32_shuffle_b(values, c2, 0, 0.0f);
+            column_sum += v_f32_shuffle_b(values, c3, 0, 0.0f);
+            values = sinkhorn_div(values,column_sum + HC_EPS);
+        }
+        v_f32_st_tnsr_partial((int5){8, token, 0, 0, 0}, gates_out, values, 15, 0);
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/mhc_post_collapse_f32_gaudi2.c b/src/core/gaudi2/tpc/kernels/mhc_post_collapse_f32_gaudi2.c
new file mode 100644
index 0000000..4aecc96
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/mhc_post_collapse_f32_gaudi2.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: Apache-2.0
+// Emit FP32 collapse for the deployed generic attention RMSNorm consumer.
+// The residual itself retains its explicit BF16 semantic boundary.
+// Keep row reductions outside this kernel to retain TPC parallelism.  The rounded BF16 residual is the
+// semantic boundary: collapse and RRMS consume that value, exactly as the
+// unfused producer/consumer chain does.
+#pragma clang fp contract(off)
+void main(tensor value, tensor residual, tensor post, tensor comb,
+          tensor next_pre, tensor residual_out, tensor collapsed_out)
+{
+    const int5 start = get_index_space_offset();
+    const int5 end = start + get_index_space_size();
+    for (int token = start[1]; token < end[1]; ++token) {
+        float post_weight[4];
+        float comb_weight[4][4];
+        float collapse_weight[4];
+        #pragma unroll
+        for (int target = 0; target < 4; ++target) {
+            int5 pc = {target, token, 0, 0, 0};
+            post_weight[target] = s_f32_ld_g(gen_addr(pc, post));
+            collapse_weight[target] = s_f32_ld_g(gen_addr(pc, next_pre));
+            #pragma unroll
+            for (int source = 0; source < 4; ++source) {
+                int5 cc = {target, source, token, 0, 0};
+                comb_weight[source][target] = s_f32_ld_g(gen_addr(cc, comb));
+            }
+        }
+
+        for (int block = start[0]; block < end[0]; ++block) {
+            const int feature = block * 128;
+            int5 vc = {feature, token, 0, 0, 0};
+            // FP32 stores use contiguous halves. Keep every conversion in
+            // linear lane order; default all-lane conversion interleaves halves.
+            const float128 x = convert_bfloat128_to_float128(
+                v_bf16_ld_tnsr_b(vc, value), SW_LINEAR);
+            float128 source_value[4];
+            #pragma unroll
+            for (int source = 0; source < 4; ++source) {
+                int5 rc = {feature, source, token, 0, 0};
+                source_value[source] = convert_bfloat128_to_float128(
+                    v_bf16_ld_tnsr_b(rc, residual), SW_LINEAR);
+            }
+
+            float128 updated[4];
+            #pragma unroll
+            for (int target = 0; target < 4; ++target) {
+                // Preserve the production expression order: source 0 starts
+                // the residual mix, sources 1..3 are added in order, and the
+                // projected value is added last.  Starting from x*post here
+                // changes FP32 rounding before the BF16 semantic boundary.
+                updated[target].v1 = v_f32_mul_b(
+                    source_value[0].v1, comb_weight[0][target]);
+                updated[target].v2 = v_f32_mul_b(
+                    source_value[0].v2, comb_weight[0][target]);
+                #pragma unroll
+                for (int source = 1; source < 4; ++source) {
+                    const float64 lo = v_f32_mul_b(
+                        source_value[source].v1, comb_weight[source][target]);
+                    const float64 hi = v_f32_mul_b(
+                        source_value[source].v2, comb_weight[source][target]);
+                    updated[target].v1 = v_f32_add_b(updated[target].v1, lo);
+                    updated[target].v2 = v_f32_add_b(updated[target].v2, hi);
+                }
+                // The deployed decode fuser contracts this final product
+                // and add. Keep its single FP32 rounding before BF16; a
+                // separate multiply/add changes exact BF16 midpoint cases.
+                updated[target].v1 = v_f32_mac_b(
+                    x.v1, post_weight[target], updated[target].v1);
+                updated[target].v2 = v_f32_mac_b(
+                    x.v2, post_weight[target], updated[target].v2);
+                const bfloat128 rounded = convert_float128_to_bfloat128(
+                    updated[target], SW_RHNE | SW_LINEAR);
+                int5 oc = {feature, target, token, 0, 0};
+                v_bf16_st_tnsr(oc, residual_out, rounded);
+                updated[target] = convert_bfloat128_to_float128(rounded, SW_LINEAR);
+            }
+
+            float128 collapsed;
+            collapsed.v1 = v_f32_mul_b(updated[0].v1, collapse_weight[0]);
+            collapsed.v2 = v_f32_mul_b(updated[0].v2, collapse_weight[0]);
+            #pragma unroll
+            for (int target = 1; target < 4; ++target) {
+                const float64 lo = v_f32_mul_b(
+                    updated[target].v1, collapse_weight[target]);
+                const float64 hi = v_f32_mul_b(
+                    updated[target].v2, collapse_weight[target]);
+                collapsed.v1 = v_f32_add_b(collapsed.v1, lo);
+                collapsed.v2 = v_f32_add_b(collapsed.v2, hi);
+            }
+            int5 cc = {feature, token, 0, 0, 0};
+            v_f32_st_tnsr(cc, collapsed_out, collapsed.v1);
+            cc[0] += 64;
+            v_f32_st_tnsr(cc, collapsed_out, collapsed.v2);
+        }
+
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/moe_router_topk_gaudi2.c b/src/core/gaudi2/tpc/kernels/moe_router_topk_gaudi2.c
new file mode 100644
index 0000000..d6266c4
--- /dev/null
+++ b/src/core/gaudi2/tpc/kernels/moe_router_topk_gaudi2.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: Apache-2.0
+// Repeated-max selection follows the upstream DeepSeek top-6 contract.
+// Input scores retain the model's FP32 softplus/sqrt computation.
+void main(tensor input, tensor text_bias, tensor image_bias, tensor image_mask,
+          tensor output_ids, tensor output_weights) {
+    const int5 start = get_index_space_offset();
+    const int5 end = start + get_index_space_size();
+    const int64 lanes = (int64)V_LANE_ID_32;
+    for (int token = start[0]; token < end[0]; ++token) {
+        const int5 image_at = {token, 0, 0, 0, 0};
+        const char is_image = s_i8_ld_g(gen_addr(image_at, image_mask));
+        float64 scores[6], choices[6];
+        float64 packed_weights = 0;
+        int64 packed_ids = 0;
+        bool64 eligible[6];
+        #pragma unroll
+        for (int c = 0; c < 6; ++c) {
+            const int5 at = {c * 64, token, 0, 0, 0};
+            const int5 bias_at = {c * 64, 0, 0, 0, 0};
+            scores[c] = v_f32_ld_tnsr_b(at, input);
+            const float64 bias = is_image ? v_f32_ld_tnsr_b(bias_at, image_bias) : v_f32_ld_tnsr_b(bias_at, text_bias);
+            choices[c] = scores[c] + bias;
+            eligible[c] = (bool64)1;
+        }
+        float64 sum = 0;
+        #pragma unroll
+        for (int rank = 0; rank < 6; ++rank) {
+            // Reduce each lane's six experts together with its expert ID.
+            // Descending chunk order plus >= gives the smaller ID on ties;
+            // predication excludes an already-selected -Inf expert as well.
+            int64_float64_pair_t local;
+            local.v1 = 2147483647;
+            local.v2 = as_float64((int64)0xff800000);
+            float64 local_score = 0;
+            #pragma unroll
+            for (int c = 5; c >= 0; --c) {
+                local_score = v_f32_sel_geq_f32_vb(choices[c], local.v2, scores[c], local_score,
+                                                   0, local_score, eligible[c], 0);
+                local = v_i32_sel2_geq_f32_vb(choices[c], local.v2, lanes + c * 64, local.v1,
+                                              0, local, eligible[c], 0);
+            }
+            const float64 best = v_f32_reduce_max(local.v2);
+            int64 winner = v_i32_sel_eq_f32_b(local.v2, best, local.v1, 2147483647);
+            winner = v_i32_reduce_min(winner);
+            const bool64 selected_lane = v_i32_cmp_eq_b(local.v1, winner);
+            const float64 selected = v_f32_mov_vb(local_score, 0, 0, selected_lane, 0);
+            #pragma unroll
+            for (int c = 0; c < 6; ++c)
+                eligible[c] = eligible[c] & v_i32_cmp_neq_b(lanes + c * 64, winner);
+            const float64 selected_weight = v_f32_reduce_add(selected);
+            const bool64 output_lane = v_i32_cmp_eq_b(lanes, rank);
+            packed_weights = v_f32_mov_vb(selected_weight, 0, packed_weights, output_lane, 0);
+            packed_ids = v_i32_mov_vb(winner, 0, packed_ids, output_lane, 0);
+            sum += selected_weight;
+        }
+        const float64 denominator = sum + 1.0e-20f;
+        float64 inverse = v_reciprocal_f32(denominator);
+        inverse = inverse * (2.0f - denominator * inverse);
+        const int5 at = {0, token, 0, 0, 0};
+        v_i32_st_tnsr_partial(at, output_ids, packed_ids, 5, 0);
+        v_f32_st_tnsr_partial(at, output_weights, packed_weights * inverse * 1.5f, 5, 0);
+    }
+}
diff --git a/src/core/gaudi2/tpc/kernels/rmsnorm_bf16_weight_gaudi2.c b/src/core/gaudi2/tpc/kernels/rmsnorm_bf16_weight_gaudi2.c
