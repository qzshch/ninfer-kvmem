index 0000000..36dbb75
--- /dev/null
+++ b/docs/gaudi2-w8a16-linear.md
@@ -0,0 +1,62 @@
+# Native Gaudi2 W8A16 Block-FP8 Linear
+
+`src/ops/gaudi2/block_fp8_linear.h` composes the block-FP8 preparation and the
+[BF16 GEMM](gaudi2-bf16-gemm.md) into one explicit linear operator:
+
+```text
+A[M,K] BF16 words, W[N,K] official 128x128 block-FP8, scales[Bn,Bk] FP32
+-> Y[M,N] BF16 = A * transpose(dequant(W))
+```
+
+`BlockFp8Linear(device, m, {n,k}, tile_rows, max_workspace_bytes)` fixes one
+static GEMM recipe of `{M, tile_rows, K}` shared by every tile; `tile_rows`
+must divide `N` exactly. Per row tile, the exact
+[block decoder](gaudi2-preparation.md) fills one pinned BF16 staging plane from
+the caller's host codes/scales, one DMA uploads it, one launch consumes it and
+one download returns the `M x tile_rows` output block, gathered into the
+caller's output columns. The weight plane never exists as BF16 on host or
+device, and `run` publishes `y` only after every tile validated and completed.
+
+## Numerical contract
+
+Weights decode through the exact E4M3FN path (bias 7, subnormal step 2^-9, no
+inf, original multiplicative block scales) and round to BF16 words before the
+MME; the GEMM runs the full `K` per tile, so tiling adds **no accumulation
+boundary** beyond the single GEMM's own FP32-accumulate/BF16-round contract.
+Original checkpoint scales are preserved. This is deliberately the
+representation-preserving W8A16 path; it is not an FP8-MME/W8A8 execution, does
+not re-encode Gaudi2's native E4M3 range, and makes no dequant-throughput claim.
+
+Host dequantization of the staging tile is the first version. Moving it into a
+TPC kernel that keeps compressed codes on device is the follow-up; this operator
+does not foreclose it, because the staging and GEMM contracts stay tile-bounded.
+
+## Ownership and failure
+
+Fixed per-instance footprint: `M*K + tile*K + M*tile` BF16 words on host and
+device each, plus the output-bounded publish image; nothing scales with `N`
+beyond `y` itself. Input validation (plane lengths, output/input disjointness,
+finite nonnegative scales) happens before the first DMA. Tile decode validates
+every code before touching staging; the upload/launch/download sequence holds
+the runtime's DMA and compute leases, so a staging tile is never overwritten
+while its previous submission can still read it. A launch failure drains
+before unwinding and leaves `y` untouched; a rerun after an injected failure
+reproduces the oracle. Output is written once at the end from the staged image.
+
+## Build and evidence
+
+`ninfer-gaudi2-block-fp8-linear-test` (host preparation build, no CUDA or
+SynapseAI) runs the real operator over the private asynchronous fake API and
+checks an independent oracle that re-derives E4M3FN decoding from the bit
+layout, applies block scales and accumulates in FP64, allowing one BF16 ulp for
+the fake's FP32-FMA association. Fixtures cover a rectangular multi-tile case
+with partial 128-block edges on both axes (`2x384x260`, tile 128), a single
+token whose tile spans several blocks (`1x256x512`, tile 256) and a sub-block
+tile exercising half-block scale coverage on the row axis (`3x192x128`, tile
+64). Failure coverage includes invalid geometry, plane-length mismatches,
+negative/NaN scales, a first-tile injected launch failure and a post-failure
+rerun; every rejected run must leave the output bytes untouched.
+
+The operator source also compiles against verified official SynapseAI 1.24.1-482
+headers in the strict SDK object check. Physical DMA/MME execution, real-check
+point end-to-end accuracy and throughput remain unverified on Gaudi2 hardware.
diff --git a/include/ninfer/ops/gdn_projected_conv.h b/include/ninfer/ops/gdn_projected_conv.h
new file mode 100644
index 0000000..ead8950
--- /dev/null
+++ b/include/ninfer/ops/gdn_projected_conv.h
@@ -0,0 +1,20 @@
+#pragma once
+#include "core/tensor.h"
+#include <cuda_runtime.h>
+namespace ninfer::ops {
+/**
+ * Convolve an already materialized BF16 q/k/value plane and retain it for replay.
+ * projected/record [C,W,B], weight [C,4], read-only states [C,3,Slots], selectors [B].
+ * B=1..8, W=1..16, C=10240 or 8192 with split rows (2048,2048,C-4096).
+ * For valid j, output = BF16(SiLU(sum_i weight[c,i]*history[c,j-3+i])).
+ * History starts at the selected BF16 state and continues with represented projected values.
+ * Invalid output columns are exact zero; record is an exact copy of every projected column.
+ * No persistent state is modified. Operands are contiguous, four-byte aligned and disjoint.
+ * Validate outputs against an independent FP64 convolution/SiLU oracle from represented BF16
+ * inputs; projection materialization is an explicit cast boundary of this entry.
+ */
+void gdn_projected_conv_record(const Tensor& projected, const Tensor& weight,
+    const Tensor& states, const Tensor& valid, const Tensor& initial_slots,
+    Tensor& record, Tensor& query, Tensor& key, Tensor& value, cudaStream_t stream);
+
+}
diff --git a/include/ninfer/ops/glm5_dsa.h b/include/ninfer/ops/glm5_dsa.h
new file mode 100644
index 0000000..6929b21
--- /dev/null
+++ b/include/ninfer/ops/glm5_dsa.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h> // cudaStream_t
+
+namespace ninfer::ops {
+
+/**
+ * GLM-5.3-Flash DSA indexer selection chain and absorbed sparse attention (decode path,
+ * single token per call). pool -> score -> select -> attend follow the audited semantics;
+ * the oracle is models/glm5/reference/dsa_reference.
+ *
+ * glm5_dsa_pool: pooled[p, e] = sum_m softmax_m(ig[p*K+m, e] + ape[m, e]) * ik[p*K+m, e]
+ * with the softmax running SEPARATELY PER KEY-DIM ELEMENT over the K pool members.
+ * `ik`/`ig` are contiguous BF16 [T, D] with T a multiple of K, `ape` FP32 [K, D],
+ * `pooled` FP32 [T/K, D].
+ */
+void glm5_dsa_pool(const Tensor& ik, const Tensor& ig, const Tensor& ape, Tensor& pooled,
+                   cudaStream_t stream);
+
+/**
+ * glm5_dsa_score: score[p] = sum_h relu(iq[h] . pooled[p]) * weights[h], where `weights`
+ * are ALREADY scaled by 1/sqrt(D*H) (the llama.cpp/Maya placement; the transformers split
+ * placement differs only in rounding). `iq` is contiguous BF16 [H, D], `pooled` FP32 [P, D],
+ * `weights` FP32 [H], `score` FP32 [P]. One token per call.
+ */
+void glm5_dsa_score(const Tensor& iq, const Tensor& pooled, const Tensor& weights, Tensor& score,
+                    cudaStream_t stream);
+
+/**
+ * glm5_dsa_select: the visible pools (pool p visible iff p*K+K-1 <= position, i.e. the
+ * first n_vis = (position+1)/K pools of the aligned layout) are ranked stable-descending
+ * with exact ties broken by lower pool index; the pool at rank r occupies cells
+ * [r*K, r*K+K); the incomplete tail (cells n_vis*K .. position, the query included) fills
+ * [top_pools*K, ...) in position order when select_tail; every unused slot of the fixed
+ * width W = top_pools*K + (K-1) is -1. `score` is FP32 [P], `position` the query's global
+ * position, `cells` Int32 [W].
+ */
+void glm5_dsa_select(const Tensor& score, std::uint32_t position, std::int32_t top_pools,
+                     bool select_tail, Tensor& cells, cudaStream_t stream);
+
+/**
+ * glm5_dsa_attention: absorbed sparse attention over one token's selection row.
+ * score_s = (q_abs[h] . latent[cells[s]]) * qk_nope^-0.5 (the 256^-0.5 model constant);
+ * softmax EXCLUDES -1 slots; ctx accumulates only over valid slots;
+ * out[h, v] = sum_c wv_b[c, v, h] * ctx[c]. `q_abs` is BF16 [H, kv_lora], `latents`
+ * BF16 [cache, kv_lora], `cells` Int32 [W] from glm5_dsa_select, `wv_b` the GGUF layout
+ * BF16 {kv_lora, v_head, H} (wv_b[c + kv_lora*v + kv_lora*v_head*h]), `out` BF16 [H*v_head].
+ */
+void glm5_dsa_attention(const Tensor& q_abs, const Tensor& latents, const Tensor& cells,
+                        const Tensor& wv_b, Tensor& out, std::int32_t qk_nope,
+                        cudaStream_t stream);
+
+/**
+ * Query absorption: q_abs[h, e] = sum_d q[h, d] * wk_b[d + nope*e + nope*lora*h] in FP32 from
+ * the represented BF16 inputs, for ONE token. `q` is BF16 [H, nope] (the q_b output),
+ * `wk_b` the GGUF layout BF16 {nope, lora, heads}, `q_abs` FP32 [H, lora]. Feeds
+ * glm5_dsa_attention's [H, lora] query plane (which reads it as BF16-representable values;
+ * the caller rounds when needed).
+ */
+void glm5_dsa_absorb(const Tensor& q, const Tensor& wk_b, Tensor& q_abs, cudaStream_t stream);
+
+/**
+ * Batched query absorption over T tokens: same math and GGUF wk_b layout as
+ * glm5_dsa_absorb, with `q` BF16 [H, nope, T] (the batched q_b linear output,
+ * FCD H*nope) and `q_abs` FP32 [H, lora, T].
+ */
+void glm5_dsa_absorb_batch(const Tensor& q, const Tensor& wk_b, Tensor& q_abs,
+                           cudaStream_t stream);
+
+/** Elementwise FP32 scaling: out = values * factor. Same-shape FP32 planes. */
+void glm5_dsa_scale(const Tensor& values, float factor, Tensor& out, cudaStream_t stream);
+
+} // namespace ninfer::ops
diff --git a/include/ninfer/ops/glm5_kda.h b/include/ninfer/ops/glm5_kda.h
new file mode 100644
index 0000000..8e911f7
--- /dev/null
+++ b/include/ninfer/ops/glm5_kda.h
@@ -0,0 +1,104 @@
+#pragma once
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h> // cudaStream_t
+
+namespace ninfer::ops {
+
+/**
+ * Prepares GLM-5.3-Flash KDA gates for T tokens (the safe path):
+ *
+ *   gate[t, h*D+i] = lower_bound * sigmoid(exp(A_log[h]) * a[t, h*D+i])   (LOG space, <= 0)
+ *   beta[t, h]     = sigmoid(b[t, h]).
+ *
+ * `a` is the already-summed f_b(f_a(x)) + dt_bias plane as contiguous BF16 [D_inner, T]
+ * (fastest dimension the inner width), `b` contiguous BF16 [H, T], `A_log` contiguous FP32 [H]
+ * and `lower_bound` negative finite FP32. `gate` is contiguous FP32 [D_inner, T] and `beta`
+ * contiguous FP32 [H, T]. The oracle evaluates the formula naively in FP64 from the represented
+ * input; transcendental implementation and intermediate precision are private kernel choices.
+ * Inputs and outputs must be mutually non-overlapping. No workspace or persistent state.
+ */
+void glm5_kda_gating(const Tensor& a, const Tensor& b, const Tensor& A_log, float lower_bound,
+                     Tensor& gate, Tensor& beta, cudaStream_t stream);
+
+/**
+ * One KDA block's causal per-channel short conv followed by SiLU, over T tokens:
+ *
+ *   out[t, c] = silu(sum_tap w[c, tap] * window(t - (K-1) + tap, c))
+ *
+ * with the window reading the [K-1, D_inner] FP32 conv_state (oldest tap first) before the
+ * token plane, and conv_state advanced to the last K-1 columns of [conv_state | x]. `x` and
+ * `out` are contiguous BF16 [D_inner, T], `w` is the GGUF layout contiguous BF16 [K, D_inner]
+ * (fastest dimension the taps: w[c*K + tap]), `conv_state` is contiguous FP32 [D_inner, K-1]
+ * and is updated in place only after the whole plane computes. Padding-free: T >= 1.
+ */
+void glm5_kda_conv(const Tensor& x, const Tensor& w, Tensor& conv_state, Tensor& out,
+                   cudaStream_t stream);
+
+/**
+ * One single-token KDA decode step over every head at once (the recurrent
+ * algorithm; chunk prefill is a separate future op):
+ *
+ *   qh = l2norm(q_h) * dk^-0.5 ; kh = l2norm(k_h)                  (eps 1e-6)
+ *   S[i, :] *= exp(gate_h[i])                                       (key-axis rows)
+ *   u[j]    = sum_i S[i, j] * kh[i]
+ *   delta[j]= beta_h * (v_h[j] - u[j])
+ *   S[i, j]+= kh[i] * delta[j]
+ *   o_h[j]  = sum_i S[i, j] * qh[i]
+ *   out_h   = rms(o_h) * o_norm_w * sigmoid(g2_h)                   (eps 1e-6, FP32)
+ *
+ * `q`, `k`, `v`, `g2` are contiguous BF16 [D_inner] (head h at h*D..h*D+D), `gate` is
+ * contiguous FP32 [D_inner] in LOG space, `beta` contiguous FP32 [H], `o_norm_w` contiguous
+ * FP32 [D], and `state` is contiguous FP32 [H, D, D] (row = key axis), updated in place.
+ * `out` is contiguous BF16 [D_inner]. D must be <= 256. The oracle is the host reference
+ * (models/glm5/reference/kda_reference) in FP32; kernel reduction order is a private choice.
+ */
+void glm5_kda_decode_step(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                          const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                          Tensor& state, Tensor& out, cudaStream_t stream);
+
+/**
+ * The prefill companion: the SAME recurrent math as glm5_kda_decode_step applied to T tokens
+ * in a loop, one head per block (state resident in global memory, the head slice never
+ * leaves registers/shared). Numerically one decode_step per token; the chunked prefill
+ * algorithm is a future throughput path, not a different result. `q`/`k`/`v` are BF16
+ * [D_inner, T] (the conv output plane), `gate` FP32 [D_inner, T] log space, `beta` FP32
+ * [H, T], `g2` BF16 [D_inner, T]; `state` FP32 [H, D, D] carries in and out; `out` is BF16
+ * [D_inner, T].
+ */
+/**
+ * The chunked prefill throughput path: the FLA naive chunk algorithm with the
+ * audited GLM-5.3 semantics (per-chunk rebased log-gate cumsum, the decayed
+ * key Gram from DIFFERENCES exp(gsum[i]-gsum[j]) only, exact forward
+ * substitution for (I+L)^-1, beta-of-earlier-token Gram rows, the state
+ * affine update per chunk). Tensor contracts match glm5_kda_prefill exactly;
+ * `tokens` must be a multiple of `chunk` (pad tails with zero rows, which
+ * contribute nothing). One head per block, chunks sequential inside (the
+ * state carries between chunks); the per-chunk work planes live in dynamic
+ * shared memory. chunk=64 x head_dim=128 needs ~213KB (datacenter parts
+ * only); consumer GPUs cap dynamic smem at 99KB, which bounds chunk at 28
+ * for head_dim 128 (88,992 bytes) — the launcher rejects geometries past
+ * the device limit, so pick the chunk width per part). The oracle is
+ * models/glm5/reference/kda_chunk_reference; reduction order is a private
+ * choice, so equality is tolerance-based.
+ */
+/**
+ * The batched output gate of the chunked prefill path: out[t, head*dk+i] =
+ * o[t, head*dk+i] * perHeadRMSNorm^-1(o[t, ·]) * o_norm_w[i] * sigmoid(g2[t,
+ * head*dk+i]) over the whole [d_inner, T] plane (eps 1e-6, the same sigmoid
+ * and reduction semantics as the recurrent kernels; the oracle is
+ * models/glm5/reference kda_out_gate_reference).
+ */
+void glm5_kda_outgate(const Tensor& o, const Tensor& g2, const Tensor& o_norm_w,
+                      Tensor& out, cudaStream_t stream);
+
+void glm5_kda_chunk(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                    const Tensor& beta, Tensor& state, Tensor& out, std::uint32_t chunk,
+                    cudaStream_t stream);
+
+void glm5_kda_prefill(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                      const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                      Tensor& state, Tensor& out, cudaStream_t stream);
+
+} // namespace ninfer::ops
diff --git a/include/ninfer/ops/glm5_mhc.h b/include/ninfer/ops/glm5_mhc.h
new file mode 100644
index 0000000..0680d54
--- /dev/null
+++ b/include/ninfer/ops/glm5_mhc.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h> // cudaStream_t
+
+namespace ninfer::ops {
+
+/**
+ * One mHC site's weight generation and stream collapse for T tokens (GLM-5.3-Flash,
+ * 4 streams, 24 mix lanes), fused:
+ *
+ *   flat       = streams[t] viewed as [4*H]
+ *   mixes[m]   = (rmsnorm(flat) . fn[m])                       (FP32, unweighted RMS, eps inside)
+ *   pre[n]     = sigmoid(mixes[n]*scale[0] + base[n]) + hc_eps
+ *   post[n]    = 2*sigmoid(mixes[4+n]*scale[1] + base[4+n])
+ *   comb[s,d]  = sinkhorn(softmax_d(mixes[8 + d + 4*s]*scale[2] + base[8 + d + 4*s]) + hc_eps)
+ *                one column normalization (sum over src + eps), then iters-1 rounds of
+ *                {row over dst, column over src}
+ *   collapsed  = sum_n pre[n] * streams[t][n*H + :]            (published from FP32 math)
+ *
+ * `streams` is contiguous BF16 [T, 4*H], `fn` contiguous BF16 [24, 4*H] (row-major lanes),
+ * `base` contiguous FP32 [24] in the pre|post|comb order, `scale` contiguous FP32 [3],
+ * `lower`-style epsilons are compile constants: rms eps is the caller's `rms_eps`, hc_eps is
+ * `hc_eps`, and `sinkhorn_iters` repeats as stated (>= 1). Outputs `pre` [T,4], `post` [T,4],
+ * `comb` [T,4,4] (row = src, col = dst) are FP32; `collapsed` is BF16 [T, H]. All operands
+ * must be mutually non-overlapping. The oracle is models/glm5/reference/mhc_reference.
+ */
+void glm5_mhc_pre(const Tensor& streams, const Tensor& fn, const Tensor& base, const Tensor& scale,
+                  float rms_eps, float hc_eps, std::int32_t sinkhorn_iters, Tensor& pre,
+                  Tensor& post, Tensor& comb, Tensor& collapsed, cudaStream_t stream);
+
+/**
+ * The stream update after the block: out[t, dst, :] = post[t,dst] * block[t, :] +
+ * sum_src comb[t,src,dst] * residual[t, src, :]. `block` is BF16 [T,H], `residual` BF16
+ * [T,4*H], `post` FP32 [T,4], `comb` FP32 [T,4,4] (src rows, dst columns), `out` BF16
+ * [T,4*H]; out may alias residual (each element reads only its own inputs).
+ */
+void glm5_mhc_post(const Tensor& block, const Tensor& residual, const Tensor& post,
+                   const Tensor& comb, Tensor& out, cudaStream_t stream);
+
+/**
+ * The final unweighted mean over the streams: out[t,:] = mean_n streams[t, n*H, :].
+ * `streams` is BF16 [T,4*H]; `out` is BF16 [T,H] and may alias streams' first quarter.
+ */
+void glm5_mhc_head(const Tensor& streams, Tensor& out, cudaStream_t stream);
+
+} // namespace ninfer::ops
diff --git a/include/ninfer/ops/glm5_mlp.h b/include/ninfer/ops/glm5_mlp.h
new file mode 100644
index 0000000..297dc95
--- /dev/null
+++ b/include/ninfer/ops/glm5_mlp.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h> // cudaStream_t
+
+namespace ninfer::ops {
+
+/**
+ * GLM-5.3-Flash's clamped SwiGLU: out = silu(min(gate, limit)) * clamp(up, -limit, +limit),
+ * evaluated in FP32 from the represented BF16 inputs (gate has NO lower clamp; the limit is
+ * the audited swiglu_limit, e.g. 10). `gate`/`up` are BF16 [W, T], `out` BF16 [W, T].
+ */
+void glm5_swiglu(const Tensor& gate, const Tensor& up, float limit, Tensor& out,
+                 cudaStream_t stream);
+
+/**
+ * The GLM sigmoid router with noaux_tc correction: score = sigmoid(logits); selection ranks
+ * score + correction_bias (stable descending, ties by lower expert); the ORIGINAL scores of
+ * the selected experts are normalized (sum + 1e-20) and scaled by routed_scaling_factor.
+ * `logits` is BF16 [E] (one token), `correction_bias` FP32 [E], `weights` FP32 [top_k],
+ * `indices` Int32 [top_k].
+ */
+void glm5_moe_route(const Tensor& logits, const Tensor& correction_bias, std::int32_t top_k,
+                    float routed_scaling_factor, Tensor& weights, Tensor& indices,
+                    cudaStream_t stream);
+
+/**
+ * Weighted expert combination with the shared expert added unweighted:
+ * out = sum_i weights[i] * experts[i, :] + shared[:]. `experts` is BF16 [top_k, H],
+ * `weights` FP32 [top_k], `shared` BF16 [H], `out` BF16 [H].
+ */
+void glm5_moe_combine(const Tensor& experts, const Tensor& weights, const Tensor& shared,
+                      Tensor& out, cudaStream_t stream);
+
+} // namespace ninfer::ops
diff --git a/include/ninfer/ops/glm5_prefill.h b/include/ninfer/ops/glm5_prefill.h
new file mode 100644
index 0000000..053bbb0
--- /dev/null
+++ b/include/ninfer/ops/glm5_prefill.h
@@ -0,0 +1,29 @@
+#pragma once
+
+// Batched-prefill helper ops for the GLM-5.3-Flash chunked path: the layout
+// bridge between the mHC residual planes (row-major [T, width]) and the block
+// executor planes (FCD-first [width, T]).
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h>
+
+namespace ninfer::ops {
+
+/**
+ * Transposes a contiguous BF16 plane: `in` [A, B] (FCD = A) becomes `out`
+ * [B, A] (FCD = B). Tiled 32x32 shared-memory transpose; inputs and outputs
+ * must not overlap.
+ */
+void glm5_transpose_bf16(const Tensor& in, Tensor& out, cudaStream_t stream);
+
+/**
+ * Casts a BF16 plane to FP32 while scaling every element by `factor`
+ * (dst[i] = float(src[i]) * factor) over same-shape [A, B] planes. This is
+ * the batched DSA head-weights bridge: the [index_heads, T] projection
+ * becomes the score op's pre-scaled FP32 input with no host round trip.
+ */
+void glm5_cast_bf16_to_f32_scaled(const Tensor& src, float factor, Tensor& dst,
+                                  cudaStream_t stream);
+
+} // namespace ninfer::ops
diff --git a/include/ninfer/ops/token_sums.h b/include/ninfer/ops/token_sums.h
new file mode 100644
index 0000000..9c7ede5
--- /dev/null
+++ b/include/ninfer/ops/token_sums.h
@@ -0,0 +1,19 @@
+#pragma once
+#include "core/tensor.h"
+#include <cuda_runtime.h>
+
+namespace ninfer::ops {
+// Sum represented BF16 values over token rows, producing FP32 statistics.
+// input is contiguous [channels,T], origin is an I32 scalar containing the
+// nonnegative original position of row zero, range is I32 [begin,end).
+// Only rows whose original position lies in range contribute. If block_tokens
+// is positive, output bucket j corresponds to floor(origin/block_tokens)+j;
+// output is [channels,ceil((T+block_tokens-1)/block_tokens)], including zero
+// padding buckets. block_tokens==0 produces one sum over the entire range.
+// Outputs are overwritten, not accumulated. All buffers must be disjoint;
+// origin/range contents can change between graph replays. No persistent state,
+// frontier update, normalization, quantization, allocation or host copy occurs.
+// Numerical reference: naive FP64 sums of the represented BF16 inputs.
+void token_sums(const Tensor& input, const Tensor& origin, const Tensor& range,
+                std::uint32_t block_tokens, Tensor& output, cudaStream_t stream);
+} // namespace ninfer::ops
diff --git a/scripts/run-wsl-glm5-chunk-test.sh b/scripts/run-wsl-glm5-chunk-test.sh
new file mode 100644
index 0000000..6fb7382
--- /dev/null
+++ b/scripts/run-wsl-glm5-chunk-test.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+# Standalone build+run of the GLM KDA chunk kernel test against the WSL GPU
+# (the host Windows tree needs the vcpkg FFmpeg triplet for a full configure;
+# this path bypasses it for the one kernel). Sources are compiled directly,
+# so it doubles as a fast syntax check. Usage: bash run-wsl-glm5-chunk-test.sh
+set -eu
+NVCC=/usr/local/cuda/bin/nvcc
+SRC="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$SRC"
+FLAGS="-std=c++20 -arch=sm_120 -Iinclude -Isrc -Itests"
+"$NVCC" $FLAGS -c tests/ops/test_glm5_kda_chunk.cu -o /tmp/ct_test.o
+"$NVCC" $FLAGS -c src/ops/glm5_kda/glm5_kda.cu -o /tmp/ct_kda.o
+"$NVCC" $FLAGS -c src/core/tensor.cpp -o /tmp/ct_tensor.o
+"$NVCC" $FLAGS -c src/core/device.cu -o /tmp/ct_device.o
+"$NVCC" $FLAGS -c src/core/arena.cu -o /tmp/ct_arena.o
+"$NVCC" $FLAGS -c src/core/dtype.cpp -o /tmp/ct_dtype.o
+"$NVCC" $FLAGS -c src/core/resident_memory.cpp -o /tmp/ct_res.o
+"$NVCC" $FLAGS -c src/core/resident_scan.cu -o /tmp/ct_scan.o
+g++ -std=c++20 -ffp-contract=off -Isrc -c src/models/glm5/reference/kda_reference.cpp -o /tmp/ct_ref.o
+g++ -std=c++20 -ffp-contract=off -Isrc -c src/models/glm5/reference/kda_chunk_reference.cpp -o /tmp/ct_chunk.o
+"$NVCC" /tmp/ct_test.o /tmp/ct_kda.o /tmp/ct_tensor.o /tmp/ct_device.o /tmp/ct_arena.o \
+    /tmp/ct_dtype.o /tmp/ct_res.o /tmp/ct_scan.o /tmp/ct_ref.o /tmp/ct_chunk.o \
+    -o /tmp/ct_run -lcudart
+/tmp/ct_run
+echo "RUN_EXIT=$?"
