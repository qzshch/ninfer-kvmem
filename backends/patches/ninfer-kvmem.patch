+
+        PinnedBuffer h_logits = device.allocate_host(E * T * 2);
+        PinnedBuffer h_bias = device.allocate_host(E * 4);
+        PinnedBuffer h_weights = device.allocate_host(K * T * 4);
+        PinnedBuffer h_indices = device.allocate_host(K * T * 4);
+        PinnedBuffer h_experts = device.allocate_host(K * H * T * 2);
+        PinnedBuffer h_shared = device.allocate_host(H * T * 2);
+        PinnedBuffer h_out = device.allocate_host(H * T * 2);
+        DeviceBuffer d_logits = device.allocate_device(E * T * 2);
+        DeviceBuffer d_bias = device.allocate_device(E * 4);
+        DeviceBuffer d_weights = device.allocate_device(K * T * 4);
+        DeviceBuffer d_indices = device.allocate_device(K * T * 4);
