+// ninfer::ops - GLM-5.3-Flash KDA launchers (decode path).
+#include "ninfer/ops/glm5_kda.h"
+
+#include "ops/kernel/glm5_kda.cuh"
+#include "core/device.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::ops {
+
+namespace {
+
+void require_contiguous(const Tensor& tensor, const char* what) {
+    if (!tensor.is_contiguous()) { throw std::invalid_argument(std::string(what) + " must be contiguous"); }
+}
+
+void require_shape(const Tensor& tensor, DType dtype, std::initializer_list<std::int32_t> shape,
+                   const char* what) {
+    require_contiguous(tensor, what);
+    if (tensor.dtype != dtype) {
+        throw std::invalid_argument(std::string(what) + " has the wrong dtype");
+    }
+    int index = 0;
+    for (const auto extent : shape) {
+        if (tensor.ne[index] != extent) {
+            throw std::invalid_argument(std::string(what) + " has the wrong shape");
+        }
+        ++index;
+    }
+}
+
+std::int32_t dim0(const Tensor& tensor) { return tensor.ne[0]; }
+std::int32_t dim1(const Tensor& tensor) { return tensor.ne[1]; }
+
+void require_disjoint(const Tensor& a, const Tensor& b) {
+    const auto a_begin = reinterpret_cast<std::uintptr_t>(a.data);
+    const auto b_begin = reinterpret_cast<std::uintptr_t>(b.data);
+    const auto a_end = a_begin + a.bytes();
+    const auto b_end = b_begin + b.bytes();
+    if (a_begin < b_end && b_begin < a_end) {
+        throw std::invalid_argument("glm5_kda operands must not overlap");
+    }
+}
+
+} // namespace
+
+void glm5_kda_gating(const Tensor& a, const Tensor& b, const Tensor& A_log, float lower_bound,
+                     Tensor& gate, Tensor& beta, cudaStream_t stream) {
+    const std::int32_t d_inner = dim1(a);
+    const std::int32_t tokens = dim0(a);
+    const std::int32_t heads = dim1(b);
+    if (d_inner <= 0 || tokens <= 0 || heads <= 0 || d_inner % heads != 0) {
+        throw std::invalid_argument("glm5_kda_gating: a [T, d_inner] and b [T, heads] disagree");
+    }
+    require_shape(a, DType::BF16, {tokens, d_inner}, "glm5_kda_gating: a");
+    require_shape(b, DType::BF16, {tokens, heads}, "glm5_kda_gating: b");
+    require_shape(A_log, DType::FP32, {heads}, "glm5_kda_gating: A_log");
+    require_shape(gate, DType::FP32, {tokens, d_inner}, "glm5_kda_gating: gate");
+    require_shape(beta, DType::FP32, {tokens, heads}, "glm5_kda_gating: beta");
+    if (!std::isfinite(lower_bound) || lower_bound >= 0) {
+        throw std::invalid_argument("glm5_kda_gating: lower_bound must be negative finite");
+    }
+    require_disjoint(a, gate); require_disjoint(a, beta);
+    require_disjoint(b, gate); require_disjoint(b, beta);
+
+    const std::int64_t gate_elements = static_cast<std::int64_t>(tokens) * d_inner;
+    const auto gate_blocks = static_cast<unsigned int>(
+        (gate_elements + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::decay_gate_kernel<<<gate_blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(a.data), static_cast<const float*>(A_log.data),
+        lower_bound, d_inner, d_inner / heads, gate_elements,
+        static_cast<float*>(gate.data));
+    const std::int64_t beta_elements = static_cast<std::int64_t>(tokens) * heads;
+    const auto beta_blocks = static_cast<unsigned int>(
+        (beta_elements + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::beta_kernel<<<beta_blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(b.data), beta_elements,
+        static_cast<float*>(beta.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_kda_conv(const Tensor& x, const Tensor& w, Tensor& conv_state, Tensor& out,
+                   cudaStream_t stream) {
+    const std::int32_t d_inner = dim1(x);
+    const std::int32_t tokens = dim0(x);
+    const std::int32_t taps = dim0(w);
+    if (d_inner <= 0 || tokens <= 0 || taps < 2 || taps > 8) {
+        throw std::invalid_argument("glm5_kda_conv: bad x/w geometry");
+    }
+    require_shape(x, DType::BF16, {tokens, d_inner}, "glm5_kda_conv: x");
+    require_shape(w, DType::BF16, {taps, d_inner}, "glm5_kda_conv: w");
+    require_shape(conv_state, DType::FP32, {taps - 1, d_inner}, "glm5_kda_conv: conv_state");
+    require_shape(out, DType::BF16, {tokens, d_inner}, "glm5_kda_conv: out");
+    require_disjoint(x, out); require_disjoint(x, conv_state); require_disjoint(w, out);
+
+    const std::int64_t elements = static_cast<std::int64_t>(tokens) * d_inner;
+    const auto blocks = static_cast<unsigned int>(
+        (elements + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::conv_kernel<<<blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(x.data), static_cast<const __nv_bfloat16*>(w.data),
+        static_cast<const float*>(conv_state.data), d_inner, taps, tokens,
+        static_cast<__nv_bfloat16*>(out.data));
+    const auto slide_blocks = static_cast<unsigned int>(
+        (d_inner + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::conv_slide_kernel<<<slide_blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(x.data), static_cast<const float*>(conv_state.data),
+        d_inner, taps, tokens, static_cast<float*>(conv_state.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_kda_decode_step(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                          const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                          Tensor& state, Tensor& out, cudaStream_t stream) {
+    const std::int32_t d_inner = dim0(q);
+    const std::int32_t heads = dim0(beta);
+    if (d_inner <= 0 || heads <= 0 || d_inner % heads != 0) {
+        throw std::invalid_argument("glm5_kda_decode_step: bad q/beta geometry");
+    }
+    const std::int32_t dk = d_inner / heads;
+    if (dk <= 0 || dk > glm5_kda_detail::kDecodeBlock) {
+        throw std::invalid_argument("glm5_kda_decode_step: head dim must be <= 256");
+    }
+    require_shape(q, DType::BF16, {d_inner}, "glm5_kda_decode_step: q");
+    require_shape(k, DType::BF16, {d_inner}, "glm5_kda_decode_step: k");
+    require_shape(v, DType::BF16, {d_inner}, "glm5_kda_decode_step: v");
+    require_shape(gate, DType::FP32, {d_inner}, "glm5_kda_decode_step: gate");
+    require_shape(beta, DType::FP32, {heads}, "glm5_kda_decode_step: beta");
+    require_shape(g2, DType::BF16, {d_inner}, "glm5_kda_decode_step: g2");
+    require_shape(o_norm_w, DType::FP32, {dk}, "glm5_kda_decode_step: o_norm_w");
+    require_shape(state, DType::FP32, {dk, dk, heads}, "glm5_kda_decode_step: state");
+    require_shape(out, DType::BF16, {d_inner}, "glm5_kda_decode_step: out");
+    require_disjoint(q, out); require_disjoint(k, out); require_disjoint(v, out);
+    require_disjoint(g2, out);
+
+    glm5_kda_detail::decode_step_kernel<<<static_cast<unsigned int>(heads),
+                                          glm5_kda_detail::kDecodeBlock, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data), static_cast<const __nv_bfloat16*>(k.data),
+        static_cast<const __nv_bfloat16*>(v.data), static_cast<const float*>(gate.data),
+        static_cast<const float*>(beta.data), static_cast<const __nv_bfloat16*>(g2.data),
+        static_cast<const float*>(o_norm_w.data), static_cast<float*>(state.data),
+        static_cast<__nv_bfloat16*>(out.data), dk);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_kda_prefill(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                      const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                      Tensor& state, Tensor& out, cudaStream_t stream) {
+    const std::int32_t tokens = dim1(q);
+    const std::int32_t d_inner = dim0(q);
+    const std::int32_t heads = dim0(beta);
+    if (d_inner <= 0 || heads <= 0 || tokens <= 0 || d_inner % heads != 0) {
+        throw std::invalid_argument("glm5_kda_prefill: bad geometry");
+    }
+    const std::int32_t dk = d_inner / heads;
+    if (dk <= 0 || dk > glm5_kda_detail::kDecodeBlock) {
+        throw std::invalid_argument("glm5_kda_prefill: head dim must be <= 256");
+    }
+    require_shape(q, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: q");
+    require_shape(k, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: k");
+    require_shape(v, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: v");
+    require_shape(gate, DType::FP32, {d_inner, tokens}, "glm5_kda_prefill: gate");
+    require_shape(beta, DType::FP32, {heads, tokens}, "glm5_kda_prefill: beta");
+    require_shape(g2, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: g2");
+    require_shape(o_norm_w, DType::FP32, {dk}, "glm5_kda_prefill: o_norm_w");
+    require_shape(state, DType::FP32, {dk, dk, heads}, "glm5_kda_prefill: state");
+    require_shape(out, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: out");
+    require_disjoint(q, out); require_disjoint(k, out); require_disjoint(v, out);
+    require_disjoint(g2, out);
+
+    glm5_kda_detail::prefill_kernel<<<static_cast<unsigned int>(heads),
+                                      glm5_kda_detail::kDecodeBlock, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data), static_cast<const __nv_bfloat16*>(k.data),
+        static_cast<const __nv_bfloat16*>(v.data), static_cast<const float*>(gate.data),
+        static_cast<const float*>(beta.data), static_cast<const __nv_bfloat16*>(g2.data),
+        static_cast<const float*>(o_norm_w.data), static_cast<float*>(state.data),
+        static_cast<__nv_bfloat16*>(out.data), dk, d_inner, heads, tokens);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+namespace {
+
+// The FLA naive chunk algorithm as a CUDA kernel: one head per block, the
+// chunk sequence serial inside the block (the recurrent state carries
+// between chunks). Work planes live in dynamic shared memory:
+//   gsum, q_normed, k_normed, egsum, w_rows (reused as ke), v_fixed  [c][dk]
+//   t_matrix (reused as the Aqk gram)                               [c][c]
+// The decayed grams keep the reference's DIFFERENCES-only exponentials —
+// expf(gsum[i]-gsum[j]) — never the factored e_i/e_j form, which overflows
+// for long chunks. Forward substitution is exact (no Neumann iteration).
+__global__ void glm5_kda_chunk_kernel(const __nv_bfloat16* __restrict__ q,
+                                      const __nv_bfloat16* __restrict__ k,
+                                      const __nv_bfloat16* __restrict__ v,
+                                      const float* __restrict__ gate,
+                                      const float* __restrict__ beta,
+                                      float* __restrict__ state,
+                                      __nv_bfloat16* __restrict__ out,
+                                      int dk, int d_inner, int heads, int tokens, int chunk) {
+    extern __shared__ float smem[];
+    const int head = blockIdx.x;
+    const int lane = threadIdx.x;               // one thread per value-axis d
+    const bool live = lane < dk;
+    const int d = lane;
+    const int base_d = head * dk;
+    const int chunks = tokens / chunk;
+    const float scale = 1.0f / sqrtf(static_cast<float>(dk));
+
+    float* gsum = smem;
+    float* q_normed = gsum + size_t(chunk) * dk;
+    float* k_normed = q_normed + size_t(chunk) * dk;
+    float* egsum = k_normed + size_t(chunk) * dk;
+    float* w_rows = egsum + size_t(chunk) * dk;
+    float* v_fixed = w_rows + size_t(chunk) * dk;
+    float* t_matrix = v_fixed + size_t(chunk) * dk;
+    float* staging = t_matrix + size_t(chunk) * chunk;   // [2]
+
+    for (int ci = 0; ci < chunks; ++ci) {
+        const int row0 = ci * chunk;
+        __syncthreads();
+
+        // Rebased log-gate cumsum (each lane owns one d column) and its
+        // elementwise exponential.
+        if (live) {
+            float running = 0.0f;
+            for (int r = 0; r < chunk; ++r) {
+                running += gate[size_t(row0 + r) * d_inner + base_d + d];
+                gsum[r * dk + d] = running;
+            }
+        }
+        __syncthreads();
+        for (int rd = lane; rd < chunk * dk; rd += blockDim.x)
+            egsum[rd] = expf(gsum[rd]);
+        __syncthreads();
+
+        // q/k L2 norms (eps 1e-6 inside the sqrt), q scaled by dk^-0.5.
+        for (int r = 0; r < chunk; ++r) {
+            float q_sq = 0.0f, k_sq = 0.0f;
+            if (lane == 0) { staging[0] = 0.0f; staging[1] = 0.0f; }
+            __syncthreads();
+            if (live) {
+                const float qv = __bfloat162float(q[size_t(row0 + r) * d_inner + base_d + d]);
+                const float kv = __bfloat162float(k[size_t(row0 + r) * d_inner + base_d + d]);
+                q_sq = qv * qv + 1e-6f;
+                k_sq = kv * kv + 1e-6f;
+            }
+            __syncthreads();
+            // Block reduction over the dk lanes (warp shuffle + smem cross).
+            for (int offset = 16; offset > 0; offset >>= 1) {
+                q_sq += __shfl_down_sync(0xffffffffu, q_sq, offset);
+                k_sq += __shfl_down_sync(0xffffffffu, k_sq, offset);
+            }
+            if (live && (lane % 32) == 0) {
+                atomicAdd(staging, q_sq);
+                atomicAdd(staging + 1, k_sq);
+            }
+            __syncthreads();
+            // Exact sqrt (not rsqrtf's approximation): the norm feeds every
+            // downstream product, and the zero-gate extreme (decay == 1)
+            // accumulates any norm error without attenuation.
+            const float q_inv = 1.0f / sqrtf(staging[0]);
+            const float k_inv = 1.0f / sqrtf(staging[1]);
+            if (live) {
+                const float qv = __bfloat162float(q[size_t(row0 + r) * d_inner + base_d + d]);
+                const float kv = __bfloat162float(k[size_t(row0 + r) * d_inner + base_d + d]);
+                q_normed[r * dk + d] = qv * q_inv * scale;
+                k_normed[r * dk + d] = kv * k_inv;
+            }
+            __syncthreads();  // staging must not be re-zeroed before every lane read it
+        }
+
+        // Decayed key Gram (strict lower; the LATER token's beta), then the
+        // exact forward substitution producing (I+L)^-1 - I.
+        for (int ij = lane; ij < chunk * chunk; ij += blockDim.x) {
+            const int i = ij / chunk, j = ij % chunk;
+            float acc = 0.0f;
+            if (j < i) {
+                const float beta_i = beta[size_t(row0 + i) * heads + head];
+                for (int dd = 0; dd < dk; ++dd)
+                    acc += k_normed[i * dk + dd] * expf(gsum[i * dk + dd] - gsum[j * dk + dd])
+                           * k_normed[j * dk + dd];
+                acc = -beta_i * acc;
+            }
+            t_matrix[ij] = acc;
+        }
+        __syncthreads();
+        for (int i = 1; i < chunk; ++i) {
+            // v_fixed doubles as the substitution scratch here; its real
+            // contents are produced only after this loop.
+            // The reference's exact forward substitution: the whole row of
+            // OLD values participates (m < i, double-buffered through the
+            // scratch), not the textbook m < j restricted form.
+            for (int j = lane; j < i; j += dk) {
+                float acc = 0.0f;
+                for (int m = 0; m < i; ++m)
+                    acc += t_matrix[i * chunk + m] * t_matrix[m * chunk + j];
+                v_fixed[j] = acc;
+            }
+            __syncthreads();
+            for (int j = lane; j < i; j += dk)
+                t_matrix[i * chunk + j] += v_fixed[j];
+            __syncthreads();
+        }
+
+        // w_rows and v_fixed hold (I+T) @ (beta_key . e^gsum k / v); then
+        // v_fixed -= w_rows @ S. The own token's beta is the diagonal.
+        for (int r = 0; r < chunk; ++r) {
+            if (!live) break;
+            const float b_own = beta[size_t(row0 + r) * heads + head];
+            float u_acc = b_own * __bfloat162float(v[size_t(row0 + r) * d_inner + base_d + d]);
+            float w_acc = b_own * k_normed[r * dk + d] * egsum[r * dk + d];
+            for (int col = 0; col < r; ++col) {
+                const float t = t_matrix[r * chunk + col] * beta[size_t(row0 + col) * heads + head];
+                u_acc += t * __bfloat162float(v[size_t(row0 + col) * d_inner + base_d + d]);
+                w_acc += t * k_normed[col * dk + d] * egsum[col * dk + d];
+            }
+            w_rows[r * dk + d] = w_acc;
+            v_fixed[r * dk + d] = u_acc;
+        }
+        __syncthreads();
+        for (int r = 0; r < chunk; ++r) {
+            if (!live) break;
+            float acc = 0.0f;
+            for (int kd = 0; kd < dk; ++kd)
+                acc += w_rows[r * dk + kd] * state[(size_t(head) * dk + kd) * dk + d];
+            v_fixed[r * dk + d] -= acc;
+        }
+        __syncthreads();
+
+        // Aqk (diagonal kept, differences only) into the consumed T plane;
+        // the output rows follow.
+        for (int ij = lane; ij < chunk * chunk; ij += blockDim.x) {
+            const int i = ij / chunk, j = ij % chunk;
+            float gram = 0.0f;
+            if (j <= i)
+                for (int dd = 0; dd < dk; ++dd)
+                    gram += q_normed[i * dk + dd] * expf(gsum[i * dk + dd] - gsum[j * dk + dd])
+                            * k_normed[j * dk + dd];
+            t_matrix[ij] = gram;
+        }
+        __syncthreads();
+        if (live) {
+            for (int r = 0; r < chunk; ++r) {
+                float acc = 0.0f;
+                for (int kd = 0; kd < dk; ++kd)
+                    acc += q_normed[r * dk + kd] * egsum[r * dk + kd]
+                           * state[(size_t(head) * dk + kd) * dk + d];
+                for (int col = 0; col <= r; ++col)
+                    acc += t_matrix[r * chunk + col] * v_fixed[col * dk + d];
+                out[size_t(row0 + r) * d_inner + base_d + d] = __float2bfloat16(acc);
+            }
+        }
+        __syncthreads();
+
+        // State: decay by the chunk's last cumsum, then the rank-chunk
+        // update with decay-shifted keys. w_rows (consumed) becomes ke.
+        if (live) {
+            for (int r = 0; r < chunk; ++r)
+                w_rows[r * dk + d] = k_normed[r * dk + d]
+                    * expf(gsum[(chunk - 1) * dk + d] - gsum[r * dk + d]);
+        }
+        __syncthreads();
+        if (live) {
+            for (int kd = 0; kd < dk; ++kd) {
+                const float decay = egsum[(chunk - 1) * dk + kd];
+                float* s_entry = state + (size_t(head) * dk + kd) * dk + d;
+                float acc = (*s_entry) * decay;
+                for (int r = 0; r < chunk; ++r)
+                    acc += w_rows[r * dk + kd] * v_fixed[r * dk + d];
+                *s_entry = acc;
+            }
+        }
+        __syncthreads();
+    }
+}
+
+} // namespace
+
+void glm5_kda_chunk(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                    const Tensor& beta, Tensor& state, Tensor& out, std::uint32_t chunk,
+                    cudaStream_t stream) {
+    const std::int32_t tokens = dim1(q);
+    const std::int32_t d_inner = dim0(q);
+    const std::int32_t heads = dim0(beta);
+    if (d_inner <= 0 || heads <= 0 || tokens <= 0 || d_inner % heads != 0 ||
+        chunk == 0 || tokens % chunk != 0) {
+        throw std::invalid_argument("glm5_kda_chunk: bad geometry (tokens must be a multiple of chunk)");
+    }
+    const std::int32_t dk = d_inner / heads;
+    if (dk <= 0 || dk > glm5_kda_detail::kDecodeBlock) {
+        throw std::invalid_argument("glm5_kda_chunk: head dim must be <= 256");
+    }
+    if (chunk > 256) {
+        throw std::invalid_argument("glm5_kda_chunk: chunk must be <= 256");
+    }
+    require_shape(q, DType::BF16, {d_inner, tokens}, "glm5_kda_chunk: q");
+    require_shape(k, DType::BF16, {d_inner, tokens}, "glm5_kda_chunk: k");
+    require_shape(v, DType::BF16, {d_inner, tokens}, "glm5_kda_chunk: v");
+    require_shape(gate, DType::FP32, {d_inner, tokens}, "glm5_kda_chunk: gate");
+    require_shape(beta, DType::FP32, {heads, tokens}, "glm5_kda_chunk: beta");
+    require_shape(state, DType::FP32, {dk, dk, heads}, "glm5_kda_chunk: state");
+    require_shape(out, DType::BF16, {d_inner, tokens}, "glm5_kda_chunk: out");
+    require_disjoint(q, out); require_disjoint(k, out); require_disjoint(v, out);
+
+    const size_t smem_floats = size_t(chunk) * (6 * size_t(dk) + chunk) + 2;
+    const size_t smem_bytes = smem_floats * 4;
+    int device = 0;
+    CUDA_CHECK(cudaGetDevice(&device));
+    int max_smem = 0;
+    CUDA_CHECK(cudaDeviceGetAttribute(&max_smem, cudaDevAttrMaxSharedMemoryPerBlockOptin, device));
+    if (smem_bytes > static_cast<size_t>(max_smem)) {
+        throw std::invalid_argument("glm5_kda_chunk: geometry needs "
+                                    + std::to_string(smem_bytes) + " bytes of shared memory, device offers "
+                                    + std::to_string(max_smem));
+    }
+    static size_t configured_bytes = 0;
+    static int configured_device = -1;
+    if (smem_bytes > configured_bytes || device != configured_device) {
+        CUDA_CHECK(cudaFuncSetAttribute(glm5_kda_chunk_kernel,
+                                        cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                        static_cast<int>(smem_bytes)));
+        if (smem_bytes > configured_bytes) configured_bytes = smem_bytes;
+        configured_device = device;
+    }
+    glm5_kda_chunk_kernel<<<static_cast<unsigned int>(heads),
+                            glm5_kda_detail::kDecodeBlock,
+                            smem_bytes, stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data), static_cast<const __nv_bfloat16*>(k.data),
+        static_cast<const __nv_bfloat16*>(v.data), static_cast<const float*>(gate.data),
+        static_cast<const float*>(beta.data), static_cast<float*>(state.data),
+        static_cast<__nv_bfloat16*>(out.data), dk, d_inner, heads, tokens,
+        static_cast<int>(chunk));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+namespace {
+
+// Batched KDA output gate over the [d_inner, T] plane:
+//   out[t, head*dk + i] = o[t, ·] * per-head-RMSNorm^-1 * o_norm_w[i] * sigmoid(g2)
+// One block per (head, token); the per-head mean is a block reduction, the
+// same eps (1e-6) and sigmoid as the recurrent kernels.
+__global__ void kda_outgate_kernel(const __nv_bfloat16* __restrict__ o,
+                                   const __nv_bfloat16* __restrict__ g2,
+                                   const float* __restrict__ o_norm_w,
+                                   __nv_bfloat16* __restrict__ out, int dk, int d_inner,
+                                   std::int64_t tokens) {
+    const int head = blockIdx.x;
+    const std::int64_t t = blockIdx.y;
+    const int tid = threadIdx.x;
+    const bool live = tid < dk;
+    __shared__ float s_mean[1];
+    extern __shared__ float s_values[];
+    const std::int64_t base = t * d_inner + std::int64_t(head) * dk;
+    float value = 0.0f;
+    if (live) {
+        value = __bfloat162float(o[base + tid]);
+        s_values[tid] = value * value;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        float sum = 0.0f;
+        for (int i = 0; i < dk; ++i) sum += s_values[i];
+        s_mean[0] = sum / static_cast<float>(dk);
+    }
+    __syncthreads();
+    if (live) {
+        const float inv = 1.0f / sqrtf(s_mean[0] + 1e-6f);
+        out[base + tid] = __float2bfloat16(
+            value * inv * o_norm_w[tid] * (1.0f / (1.0f + expf(-__bfloat162float(g2[base + tid])))));
+    }
+}
+
+} // namespace
+
+void glm5_kda_outgate(const Tensor& o, const Tensor& g2, const Tensor& o_norm_w,
+                      Tensor& out, cudaStream_t stream) {
+    const std::int32_t d_inner = dim0(o);
+    const std::int32_t tokens = dim1(o);
+    const std::int32_t dk = o_norm_w.ne[0];
+    if (d_inner <= 0 || tokens <= 0 || dk <= 0 || dk > glm5_kda_detail::kDecodeBlock ||
+        d_inner % dk != 0) {
+        throw std::invalid_argument("glm5_kda_outgate: [d_inner, T] over head_dim <= 256");
+    }
+    require_shape(o, DType::BF16, {d_inner, tokens}, "glm5_kda_outgate: o");
+    require_shape(g2, DType::BF16, {d_inner, tokens}, "glm5_kda_outgate: g2");
+    require_shape(o_norm_w, DType::FP32, {dk}, "glm5_kda_outgate: o_norm_w");
+    require_shape(out, DType::BF16, {d_inner, tokens}, "glm5_kda_outgate: out");
+    // o may alias out: every element's inputs are read into registers before
+    // its own store, so in-place application is element-wise safe.
+    require_disjoint(g2, out);
+
+    const auto heads = static_cast<unsigned int>(d_inner / dk);
+    const auto token_grid = static_cast<unsigned int>(tokens);
+    const std::size_t smem = static_cast<std::size_t>(glm5_kda_detail::kDecodeBlock) * 4;
+    kda_outgate_kernel<<<dim3(heads, token_grid), glm5_kda_detail::kDecodeBlock, smem, stream>>>(
+        static_cast<const __nv_bfloat16*>(o.data), static_cast<const __nv_bfloat16*>(g2.data),
+        static_cast<const float*>(o_norm_w.data), static_cast<__nv_bfloat16*>(out.data),
+        dk, d_inner, static_cast<std::int64_t>(tokens));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+
+} // namespace ninfer::ops
