+// Host bridges for the GLM-5.3-Flash TPC kernels. Each class builds a
+// SynapseAI graph with a custom kernel node, compiles it into a Recipe, and
+// launches through the runtime adapter's Stream. The graph-building pattern
+// follows Bf16Gemm: explicit tensors with geometry, persistent sections, one
+// node, one compile. The TPC-C device sources sit in kernels/ and are
+// compiled by HabanaTools GC on real hardware.
+
+#include "core/gaudi2/tpc/include/glm5_tpc.h"
+
+#include <stdexcept>
+#include <cstring>
+
+namespace ninfer::gaudi2::tpc {
+namespace {
+
+synGraphHandle create_graph() {
+    synGraphHandle graph = nullptr;
+    if (synGraphCreate(&graph, synDeviceGaudi2) != synSuccess) {
+        throw SynapseError(synFail, "synGraphCreate");
+    }
+    return graph;
+}
+
+// Creates one external BF16 tensor with the given shape and assigns it to a
+// new persistent section. Returns the tensor handle (owned by the graph).
+synTensor create_bf16_tensor(synGraphHandle graph, const char* name,
+                              std::initializer_list<std::uint32_t> sizes,
+                              std::vector<synSectionHandle>& sections) {
+    synTensor tensor = nullptr;
+    // Always 2-D (FCD first), padding {n} to {n, 1}: the runtime's
+    // RecipeBinding sizes are a fixed 2-entry array.
+    synTensorGeometry geo{};
+    geo.dims = 2;
+    geo.sizes[0] = *sizes.begin();
+    geo.sizes[1] = sizes.size() > 1 ? *(sizes.begin() + 1) : 1;
+    if (synTensorHandleCreate(&tensor, graph, DATA_TENSOR, name) != synSuccess ||
+        synTensorSetGeometry(tensor, &geo, synGeometrySizes) != synSuccess ||
+        synTensorSetDeviceDataType(tensor, syn_type_bf16) != synSuccess ||
+        synTensorSetAllowPermutation(tensor, false) != synSuccess) {
+        throw SynapseError(synFail, "TPC tensor creation failed");
+    }
+    synSectionHandle section = nullptr;
+    if (synSectionCreate(&section, 0, graph) != synSuccess ||
+        synSectionSetPersistent(section, true) != synSuccess ||
+        synTensorAssignToSection(tensor, section, 0) != synSuccess) {
+        throw SynapseError(synFail, "TPC section assignment failed");
+    }
+    sections.push_back(section);
+    return tensor;
+}
+
+// Creates one external Int32 tensor (for expert indices); the section handle
+// is appended to `sections` for later destruction.
+synTensor create_i32_tensor(synGraphHandle graph, const char* name,
+                              std::initializer_list<std::uint32_t> sizes,
+                              std::vector<synSectionHandle>& sections) {
+    synTensor tensor = nullptr;
+    // Always 2-D (FCD first), padding {n} to {n, 1}: the runtime's
+    // RecipeBinding sizes are a fixed 2-entry array.
+    synTensorGeometry geo{};
+    geo.dims = 2;
+    geo.sizes[0] = *sizes.begin();
+    geo.sizes[1] = sizes.size() > 1 ? *(sizes.begin() + 1) : 1;
+    if (synTensorHandleCreate(&tensor, graph, DATA_TENSOR, name) != synSuccess ||
+        synTensorSetGeometry(tensor, &geo, synGeometrySizes) != synSuccess ||
+        synTensorSetDeviceDataType(tensor, syn_type_int32) != synSuccess ||
+        synTensorSetAllowPermutation(tensor, false) != synSuccess) {
+        throw SynapseError(synFail, "TPC I32 tensor creation failed");
+    }
+    synSectionHandle section = nullptr;
+    if (synSectionCreate(&section, 0, graph) != synSuccess ||
+        synSectionSetPersistent(section, true) != synSuccess ||
+        synTensorAssignToSection(tensor, section, 0) != synSuccess) {
+        throw SynapseError(synFail, "TPC I32 section assignment failed");
+    }
+    sections.push_back(section);
+    return tensor;
+}
+
+// Creates one external FP32 tensor (for gate/beta/state planes).
+synTensor create_f32_tensor(synGraphHandle graph, const char* name,
+                              std::initializer_list<std::uint32_t> sizes,
+                              std::vector<synSectionHandle>& sections) {
+    synTensor tensor = nullptr;
+    // Always 2-D (FCD first), padding {n} to {n, 1}: the runtime's
+    // RecipeBinding sizes are a fixed 2-entry array.
+    synTensorGeometry geo{};
+    geo.dims = 2;
+    geo.sizes[0] = *sizes.begin();
+    geo.sizes[1] = sizes.size() > 1 ? *(sizes.begin() + 1) : 1;
+    if (synTensorHandleCreate(&tensor, graph, DATA_TENSOR, name) != synSuccess ||
+        synTensorSetGeometry(tensor, &geo, synGeometrySizes) != synSuccess ||
+        synTensorSetDeviceDataType(tensor, syn_type_float) != synSuccess ||
+        synTensorSetAllowPermutation(tensor, false) != synSuccess) {
+        throw SynapseError(synFail, "TPC F32 tensor creation failed");
+    }
+    synSectionHandle section = nullptr;
+    if (synSectionCreate(&section, 0, graph) != synSuccess ||
+        synSectionSetPersistent(section, true) != synSuccess ||
+        synTensorAssignToSection(tensor, section, 0) != synSuccess) {
+        throw SynapseError(synFail, "TPC F32 section assignment failed");
+    }
+    sections.push_back(section);
+    return tensor;
+}
+
+// Destroys the tracked tensor handles (the graph retains linked tensors) and
+// then the graph, matching the Bf16Gemm cleanup order: synTensorDestroy marks
+// each handle released; synGraphDestroy then frees the retained tensors.
+void destroy_graph_safe(synGraphHandle graph,
+                        const std::vector<synTensor>& tensors,
+                        const std::vector<synSectionHandle>& sections) noexcept {
+    for (const auto tensor : tensors) if (tensor) (void)synTensorDestroy(tensor);
+    for (const auto section : sections) if (section) (void)synSectionDestroy(section);
+    if (graph) (void)synGraphDestroy(graph);
+}
+
+} // namespace
+
+// ---------------------------------------------------------------------------
+// RMSNorm
+
+RmsNorm::RmsNorm(const Device& device, RmsNormShape shape, float epsilon,
+                 std::size_t max_workspace_bytes)
+    : shape_(shape), epsilon_(epsilon) {
+    if (!shape.width || !shape.tokens) {
+        throw std::invalid_argument("RmsNorm: width and tokens must be positive");
+    }
+    if (!(epsilon > 0)) throw std::invalid_argument("RmsNorm: epsilon must be positive");
+
+    synGraphHandle graph = create_graph();
+    std::vector<synTensor> created;
+    std::vector<synSectionHandle> sections;
+    try {
+        synTensor x = create_bf16_tensor(graph, "x", {shape.width, shape.tokens}, sections);
+        synTensor weight = create_bf16_tensor(graph, "weight", {shape.width}, sections);
+        synTensor out = create_bf16_tensor(graph, "out", {shape.width, shape.tokens}, sections);
+        created = {x, weight, out};
+        struct { float epsilon; float inverse_width; } params;
+        params.epsilon = epsilon;
+        params.inverse_width = 1.0f / static_cast<float>(shape.width);
+        const synTensor inputs[] = {x, weight};
+        const synTensor outputs[] = {out};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 2, 1, &params, sizeof(params),
+                                "glm5_rmsnorm_bf16", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "RmsNorm node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_rmsnorm", max_workspace_bytes);
+        const char* names[] = {"x", "weight", "out"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute RmsNorm::launch(Stream& stream, DeviceBuffer& x, DeviceBuffer& weight,
+                        DeviceBuffer& out) {
+    if (x.size() != static_cast<std::uint64_t>(shape_.width) * shape_.tokens * 2 ||
+        weight.size() != static_cast<std::uint64_t>(shape_.width) * 2 ||
+        out.size() != static_cast<std::uint64_t>(shape_.width) * shape_.tokens * 2) {
+        throw std::invalid_argument("RmsNorm launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &x, {shape_.width, shape_.tokens}},
+        {tensor_ids_[1], &weight, {shape_.width, 1}},
+        {tensor_ids_[2], &out, {shape_.width, shape_.tokens}},
+    };
+    return stream.launch(recipe_, bindings);
+}
+
+// ---------------------------------------------------------------------------
+// clamp SwiGLU
+
+ClampSwiglu::ClampSwiglu(const Device& device, ClampSwigluShape shape, float limit,
+                         std::size_t max_workspace_bytes)
+    : shape_(shape), limit_(limit) {
+    if (!shape.inner || !shape.tokens) {
+        throw std::invalid_argument("ClampSwiglu: inner and tokens must be positive");
+    }
+    if (!(limit > 0)) throw std::invalid_argument("ClampSwiglu: limit must be positive");
+
+    synGraphHandle graph = create_graph();
+    std::vector<synTensor> created;
+    std::vector<synSectionHandle> sections;
+    try {
+        synTensor h = create_bf16_tensor(graph, "h", {shape.inner * 2, shape.tokens}, sections);
+        synTensor out = create_bf16_tensor(graph, "out", {shape.inner, shape.tokens}, sections);
+        created = {h, out};
+        struct { float limit; } params = {limit};
+        const synTensor inputs[] = {h};
+        const synTensor outputs[] = {out};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 1, 1, &params, sizeof(params),
+                                "glm5_clamp_swiglu_bf16", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "ClampSwiglu node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_clamp_swiglu", max_workspace_bytes);
+        const char* names[] = {"h", "out"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute ClampSwiglu::launch(Stream& stream, DeviceBuffer& h, DeviceBuffer& out) {
+    if (h.size() != static_cast<std::uint64_t>(shape_.inner) * 2 * shape_.tokens * 2 ||
+        out.size() != static_cast<std::uint64_t>(shape_.inner) * shape_.tokens * 2) {
+        throw std::invalid_argument("ClampSwiglu launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &h, {shape_.inner * 2, shape_.tokens}},
+        {tensor_ids_[1], &out, {shape_.inner, shape_.tokens}},
+    };
+    return stream.launch(recipe_, bindings);
+}
