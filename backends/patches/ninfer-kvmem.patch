+#pragma once
+#include "core/gaudi2/runtime.h"
+#include "core/gaudi2/block_fp8.h"
+#include "bf16_gemm.h"
+
+#include <cstddef>
+#include <span>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+// One W8A16 linear against an official 128x128 block-FP8 checkpoint plane:
+// Y[M,N] = A[M,K] * dequant(W[N,K])^T with A/Y in BF16 words.
+//
+// The weight plane never exists as BF16 anywhere. Per row tile of tile_rows
+// weights, the exact block decoder fills one pinned BF16 staging tile, one DMA
+// uploads it and one closed BF16 GEMM (full K, so no cross-tile accumulation
+// rounding) consumes it. Original block scales are preserved; this is NOT an
+// FP8-MME/W8A8 execution and never re-encodes Gaudi2's native FP8 range.
+class BlockFp8Linear {
+public:
+    BlockFp8Linear(const Device& device, std::size_t m, const BlockFp8Matrix& weights,
+                   std::size_t tile_rows, std::size_t max_workspace_bytes);
+    [[nodiscard]] std::size_t rows() const noexcept { return weights_.rows; }
+    [[nodiscard]] std::size_t columns() const noexcept { return weights_.columns; }
+    [[nodiscard]] std::size_t tile_rows() const noexcept { return tile_rows_; }
+    // Fixed per-instance footprint: activation upload + weight tile + output tile
+    // on both host and device, independent of N; host_bytes additionally counts
+    // the output-bounded publish image (same order as y itself).
+    [[nodiscard]] std::size_t device_bytes() const noexcept;
+    [[nodiscard]] std::size_t host_bytes() const noexcept;
+
+    // a is [m,k] row-major BF16 words, codes the full [n,k] plane, scales the
+    // full block-scale plane; y is [m,n] row-major and is published only after
+    // every tile validated and completed. Any throw leaves y untouched.
+    void run(Stream& stream, std::span<const std::uint16_t> a, std::span<const std::uint8_t> codes,
+             std::span<const float> scales, std::span<std::uint16_t> y);
+private:
+    Device device_;
+    BlockFp8Matrix weights_;
+    std::size_t m_, tile_rows_;
+    Bf16Gemm gemm_;
+    PinnedBuffer a_host_, w_host_, y_host_;
+    DeviceBuffer a_device_, w_device_, y_device_;
+    std::vector<std::uint16_t> y_result_;
+};
+
+} // namespace ninfer::gaudi2
