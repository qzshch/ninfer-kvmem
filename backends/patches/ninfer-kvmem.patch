@@ -0,0 +1,62 @@
+#pragma once
+
+#include "models/qwen3_5/program/storage/bounded_checkpoint_buffer_pool.h"
+
+#include <charconv>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string_view>
+
+namespace ninfer::models::qwen3_5::detail {
+
+inline std::size_t checkpoint_buffer_pool_capacity() {
+    const char* value=std::getenv("NINFER_EXPERIMENT_CHECKPOINT_POOL");
+    if (value==nullptr) return 0;
+    std::string_view text(value);
+    unsigned capacity=0;
+    const auto parsed=std::from_chars(text.data(),text.data()+text.size(),capacity);
+    if (parsed.ec!=std::errc{} || parsed.ptr!=text.data()+text.size() || capacity>4)
+        throw std::invalid_argument("checkpoint buffer free-list requires a capacity in 0..4");
+    return capacity;
+}
+
+template <class Buffer>
+class CheckpointBufferPool {
+    using Pool=BoundedCheckpointBufferPool<Buffer>;
+public:
+    CheckpointBufferPool(std::size_t capacity,std::size_t image_bytes,bool prewarm=false)
+        : pool_(std::make_shared<Pool>(capacity,image_bytes)), resident_(prewarm) {
+        if (prewarm) pool_->prewarm(capacity,[](auto& image) { std::memset(image.data(),0,image.size()); });
+        std::fprintf(stderr,"CHECKPOINT_POOL capacity=%zu image_bytes=%zu maximum_cached_bytes=%zu prewarm=%zu\n",
+                     capacity,image_bytes,capacity*image_bytes,prewarm ? capacity : 0);
+    }
+    std::shared_ptr<Buffer> acquire(std::size_t bytes) { return pool_->acquire(bytes); }
+    int reconstruction_scratch_mode(int configured) const noexcept {
+        // Resident mode covers the backup even when the old experiment is off.
+        // Explicit pooled/retained modes keep their existing ownership behavior.
+        return resident_ && configured == 0 ? 1 : configured;
+    }
+    std::size_t idle_bytes() const { return pool_->statistics().cached_bytes; }
+    void close() noexcept {
+        const auto stats=pool_->statistics();
+        std::fprintf(stderr,"CHECKPOINT_POOL_CLOSE hits=%llu misses=%llu cached=%zu cached_bytes=%zu high_water_cached_bytes=%zu\n",
+                     static_cast<unsigned long long>(stats.hits),static_cast<unsigned long long>(stats.misses),
+                     stats.cached,stats.cached_bytes,stats.high_water_cached_bytes);
+        pool_->close();
+    }
+private:
+    std::shared_ptr<Pool> pool_;
+    const bool resident_;
+};
+
+// Catalog images are counted by their owners. An idle image cannot also be
+// leased, and the independently retained reconstruction backup is never a
+// catalog image. Count its allocation once, regardless of shared aliases.
+template <class Buffer>
+std::size_t checkpoint_auxiliary_host_bytes(const CheckpointBufferPool<Buffer>* pool,
+                                           const std::shared_ptr<Buffer>& scratch) {
+    return (pool ? pool->idle_bytes() : 0) + (scratch ? scratch->size() : 0);
+}
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/checkpoint_residency.h b/src/models/qwen3_5/program/storage/checkpoint_residency.h
new file mode 100644
index 0000000000000000000000000000000000000000..44e39d213292db2f4d8313c00fd5b23d1bac2663
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_residency.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstddef>
+#include <limits>
+#include <stdexcept>
+#include <string_view>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Parse once at startup. Null and "0" preserve the existing allocation path.
+inline bool checkpoint_resident_enabled(const char* value) {
+    if (!value || std::string_view(value) == "0") return false;
+    if (std::string_view(value) == "1") return true;
+    throw std::invalid_argument("NINFER_KVMEM_CHECKPOINT_RESIDENT must be 0 or 1");
+}
+
+// Catalog aliases share images. Only a replacement capture and the single
+// outstanding idle-I/O owner can hold images beyond those catalogs. Scratch
+// leases are explicit so callers account for their actual simultaneous lifetime.
+inline std::size_t checkpoint_resident_capacity(std::size_t active,
+                                                std::size_t retained,
+                                                std::size_t kinds,
+                                                std::size_t scratch) {
+    constexpr auto limit = std::numeric_limits<std::size_t>::max();
+    if (!active || !kinds) throw std::invalid_argument("empty checkpoint resident geometry");
+    if (retained > limit - active || scratch > limit - 2)
+        throw std::overflow_error("checkpoint resident capacity overflow");
+    const auto transient = 2 + scratch;
+    const auto windows = active + retained;
+    if (windows > (limit - transient) / kinds)
+        throw std::overflow_error("checkpoint resident capacity overflow");
+    return windows * kinds + transient;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
