+#pragma once
+
+// The GLM-5.3-Flash full-model decode step: one token through every block (mHC residual
+// loop -> mixer -> MLP) then the head mean, final norm and LM head. This is the assembly
+// of the individually verified block executors; every mixer and MLP path keeps its own
+// device test, so the model-level test verifies the CHAINING (mHC wiring, block order,
+// residual discipline), not the per-block math again.
+
+#include "core/tensor.h"
+#include "core/weight.h"
+#include "models/glm5/execution/block.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// cudaStream_t is an opaque handle in these signatures (the execution
+// backend's stream); the CUDA translation units include the real header.
+
+namespace ninfer {
+// Opaque execution handle (defined in core/device.h); the CUDA
+// translation units include the real header.
+class CudaExecutionView;
+}
+
+namespace ninfer::models::glm5::execution {
+
+// One block's mHC sites + its mixer/MLP kind pointer (null for the unused kind).
+struct Glm5Layer {
+    Weight hc_attn_fn, hc_attn_base, hc_attn_scale;   // [24, 4*H], [24], [3]
+    Weight hc_ffn_fn, hc_ffn_base, hc_ffn_scale;
+    Weight attn_norm, ffn_norm;                        // shared names for KDA/DSA/Dense/MoE
+    bool is_dsa = false;
+    KdaBlockWeights kda;                               // valid when !is_dsa
+    DsaBlockWeights dsa;                               // valid when is_dsa
+    bool mlp_is_dense = false;
+    DenseMlpWeights dense_mlp;                         // valid when mlp_is_dense
+    MoeBlockWeights moe;                               // valid when !mlp_is_dense
+    const void* moe_router_bias = nullptr;             // FP32 [experts] when MoE
+};
+
+struct Glm5ModelWeights {
+    Weight token_embd;    // [vocab, hidden]
+    Weight output_norm;   // [hidden] final norm
+    Weight lm_head;       // [vocab, hidden]
+    std::vector<Glm5Layer> layers;
+
+    // KDA FP32 planes (one per KDA block, in layer order).
+    struct KdaScalars {
+        const void* dt_bias = nullptr;    // BF16 [d_inner] (the add_bias operand)
+        const void* a_log = nullptr;      // FP32 [heads]
+        const void* o_norm_w = nullptr;   // FP32 [head_dim]
+    };
+    std::vector<KdaScalars> kda_scalars;
+    // DSA indexer ape planes (one per DSA block).
+    std::vector<const void*> dsa_ape;     // FP32 [kpool, index_dim]
+};
+
+// The caller's per-sequence decode state: the three conv planes and matrix state per KDA
+// block, the latent/indexer planes per DSA block.
+struct Glm5DecodeState {
+    // KDA (indexed by KDA block order)
+    std::vector<Tensor> kda_conv_q, kda_conv_k, kda_conv_v, kda_matrix;
+    // DSA (indexed by DSA block order)
+    std::vector<Tensor> dsa_latents, dsa_ik_plane, dsa_ig_plane, dsa_pooled, dsa_cells;
+};
+
+struct Glm5StepConfig;  // defined below; the scratch budgets need its geometry
+
+// The per-block slice is the peak over one block of each kind; the DSA slice
+// scales with the visible-pool count at `worst_position` (history length).
+[[nodiscard]] std::size_t glm5_decode_step_scratch_bytes(const Glm5StepConfig& config,
+                                                         std::uint32_t worst_position);
+
+// One full decode step: token_embedding [hidden,1] BF16 -> the four-stream mHC residual
+// (initialized to four copies of the embedding), every block (mHC pre -> norm -> mixer ->
+// mHC post -> mHC pre -> norm -> MLP -> mHC post), then the head mean, the final norm and
+// the lm_head projection. `logits` is BF16 [vocab, 1]. `position` is the token's logical
+// position (drives DSA visibility). The layer geometry comes from the model weights; the
+// caller passes the layer_types ordering and dimensions in the config structure below.
+struct Glm5StepConfig {
+    std::uint32_t hidden;
+    std::uint32_t kda_heads, kda_head_dim;          // KDA mixer geometry
+    std::uint32_t heads, head_dim;                  // DSA MLA geometry (head_dim = qk_nope)
+    std::uint32_t q_lora, kv_lora, v_head;
+    std::uint32_t index_heads, index_dim, kpool, top_k;
+    std::uint32_t ffn_dense, ffn_moe, experts, num_experts_per_tok;
+    std::uint32_t vocab_size;
+    float rms_eps, gate_lower_bound, swiglu_limit, routed_scaling_factor;
+    std::vector<bool> layer_is_dsa;      // [layers]
+    std::vector<bool> layer_mlp_dense;   // [layers]
+};
+
+// `hidden_out` (optional) receives the final-normed hidden state that feeds
+// the lm_head - the prefill path uses it to publish last_hidden.
+void glm5_decode_step(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                      const Glm5StepConfig& config, const Tensor& token_embedding,
+                      std::uint32_t position, Tensor& logits, void* scratch,
+                      const CudaExecutionView& execution, Tensor* hidden_out = nullptr);
+
+// Embedding lookup: gathers the token's row from the model's embedding table.
+// `token_id` is the vocabulary index; `out` is BF16 [hidden, 1].
+void glm5_embed_token(const Glm5ModelWeights& w, std::uint32_t token_id,
+                      std::uint32_t hidden, Tensor& out, const CudaExecutionView& execution);
+
+// Convenience wrapper: embedding + decode_step in one call.
+void glm5_decode_token(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                       const Glm5StepConfig& config, std::uint32_t token_id,
+                       std::uint32_t position, Tensor& logits, void* scratch,
+                       const CudaExecutionView& execution, Tensor* hidden_out = nullptr);
+
+[[nodiscard]] std::size_t glm5_embed_scratch_bytes(std::uint32_t hidden);
+
+// ---------------------------------------------------------------------------
+// Multi-token prefill: processes T tokens through the full model in one call.
+// The KDA mixer runs the chunked prefill kernel; the DSA indexer and attention
+// run per-token (the selection is query-position-dependent). This is the
+// correctness-first path - chunked DSA attention and batched MoE are later
+// optimizations.
+
+// The prefill state is the same Glm5DecodeState plus the residual streams.
+struct Glm5PrefillResult {
+    Tensor hidden;        // BF16 [hidden, 1] - the final hidden state for sampling
+    Tensor logits;        // BF16 [vocab, 1]  - logits of the LAST token only
+};
+
+void glm5_prefill(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                  const Glm5StepConfig& config, const Tensor& token_ids,
+                  std::uint32_t first_position, Tensor& last_hidden, Tensor& last_logits,
+                  void* scratch, const CudaExecutionView& execution);
+
+[[nodiscard]] std::size_t glm5_prefill_scratch_bytes(const Glm5StepConfig& config,
+                                                      std::uint32_t max_tokens);
+
+// The chunked-prefill throughput path: T tokens (a multiple of `chunk`) in
+// one call. KDA blocks run their conv/gating/chunk-scan/output-gate fully
+// batched; DSA blocks batch projections, latent/indexer writes and pooling,
+// with the per-position selection/attention chain inside; dense MLPs are
+// batched, MoE reuses the single-token executor per token (grouped expert
+// GEMM is the follow-up). `last_logits` receives the final token's row.
+// Same state and result contract as glm5_prefill.
+void glm5_prefill_chunked(const Glm5ModelWeights& w, Glm5DecodeState& state,
+                          const Glm5StepConfig& config, const Tensor& token_ids,
+                          std::uint32_t first_position, std::uint32_t chunk,
+                          Tensor& last_hidden, Tensor& last_logits, void* scratch,
+                          const CudaExecutionView& execution);
+
+[[nodiscard]] std::size_t glm5_prefill_chunked_scratch_bytes(
+    const Glm5StepConfig& config, std::uint32_t max_tokens, std::uint32_t first_position);
+
+} // namespace ninfer::models::glm5::execution
