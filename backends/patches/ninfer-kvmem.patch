+// Adapted from NInfer 64d10fbf9f8e6bfc79ab0570b94674c5b9997929 (Apache-2.0).
+#pragma once
+#include "core/arena.h"
+#include "core/paged_kv_cache.h"
+#include "ops/softmax_attention/dense/causal_cache/selective_int8/ported/ops/softmax_attention/kernels/causal/geometry.h"
