+void kda_scan_lifecycle() {
+    constexpr std::uint32_t H = 2, D = 8, DI = H * D;
+    {
+        Device device;
+        auto stream = device.create_stream();
+        KdaScanShape shape{H, D};
+        KdaScan scan(device, shape, 4096);
+        require(scan.shape().heads == H && scan.shape().head_dim == D, "KdaScan shape");
+
+        const auto state_floats = static_cast<std::uint64_t>(H) * D * D;
+        PinnedBuffer host_q = device.allocate_host(DI * 2);
+        PinnedBuffer host_k = device.allocate_host(DI * 2);
+        PinnedBuffer host_v = device.allocate_host(DI * 2);
+        PinnedBuffer host_gate = device.allocate_host(DI * 4);
+        PinnedBuffer host_beta = device.allocate_host(H * 4);
+        PinnedBuffer host_state = device.allocate_host(state_floats * 4);
+        PinnedBuffer host_out = device.allocate_host(DI * 2);
+        DeviceBuffer dev_q = device.allocate_device(DI * 2);
+        DeviceBuffer dev_k = device.allocate_device(DI * 2);
+        DeviceBuffer dev_v = device.allocate_device(DI * 2);
+        DeviceBuffer dev_gate = device.allocate_device(DI * 4);
+        DeviceBuffer dev_beta = device.allocate_device(H * 4);
+        DeviceBuffer dev_state = device.allocate_device(state_floats * 4);
+        DeviceBuffer dev_out = device.allocate_device(DI * 2);
+        auto up1 = stream.upload(dev_q, host_q, host_q.size()); up1.wait();
+        auto up2 = stream.upload(dev_state, host_state, host_state.size()); up2.wait();
+        auto compute = scan.launch(stream, dev_q, dev_k, dev_v, dev_gate, dev_beta,
+                                   dev_state, dev_out);
+        compute.wait();
+        auto down = stream.download(host_out, dev_out, host_out.size()); down.wait();
+    }
+    fake_synapse::assert_clean();
+}
