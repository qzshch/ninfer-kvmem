diff --git a/src/models/glm5/reference/dsa_reference.cpp b/src/models/glm5/reference/dsa_reference.cpp
new file mode 100644
index 0000000..d86410c
--- /dev/null
+++ b/src/models/glm5/reference/dsa_reference.cpp
@@ -0,0 +1,227 @@
+#include "models/glm5/reference/dsa_reference.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "GLM DSA reference requires IEEE-754 binary32");
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("DSA reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+
+size_t token_count(std::span<const float> plane, size_t per_token, const char* what) {
+    if (per_token == 0 || plane.size() % per_token != 0)
+        throw std::invalid_argument(what);
+    return plane.size() / per_token;
+}
+}  // namespace
+
+void dsa_pool_reference(std::span<const float> keys, std::span<const float> gates,
+                        std::span<const float> ape, std::span<float> pooled,
+                        const DsaIndexerProfile& profile) {
+    const size_t dim = profile.head_dim;
+    const size_t kpool = profile.kpool;
+    if (dim == 0 || kpool == 0 || profile.top_k == 0 || profile.top_k % kpool)
+        throw std::invalid_argument("DSA indexer profile is degenerate");
+    const size_t tokens = token_count(keys, dim, "DSA keys are not whole token planes");
+    if (gates.size() != keys.size() || ape.size() != checked_mul(kpool, dim))
+        throw std::invalid_argument("DSA pool gate/ape plane mismatch");
+    if (tokens == 0 || tokens % kpool)
+        throw std::invalid_argument("DSA pooling requires tokens to be a positive multiple of kpool");
+    const size_t pools = tokens / kpool;
+    if (pooled.size() != checked_mul(pools, dim))
+        throw std::invalid_argument("DSA pooled plane does not match the pool count");
+    demand_finite(keys, "DSA keys must be finite");
+    demand_finite(gates, "DSA gates must be finite");
+    demand_finite(ape, "DSA ape must be finite");
+
+    for (size_t p = 0; p < pools; ++p)
+        for (size_t e = 0; e < dim; ++e) {
+            float logits[8], maximum = 0;
+            if (kpool > 8) throw std::invalid_argument("DSA pooling pins kpool at 8 members or fewer");
+            for (size_t m = 0; m < kpool; ++m) {
+                logits[m] = gates[(p * kpool + m) * dim + e] + ape[m * dim + e];
+                if (m == 0 || logits[m] > maximum) maximum = logits[m];
+            }
+            float denominator = 0, exps[8];
+            for (size_t m = 0; m < kpool; ++m) {
+                exps[m] = std::exp(logits[m] - maximum);
+                denominator += exps[m];
+            }
+            const float inverse = 1.0f / denominator;
+            float acc = 0;
+            for (size_t m = 0; m < kpool; ++m)
+                acc = std::fma(exps[m] * inverse, keys[(p * kpool + m) * dim + e], acc);
+            if (!std::isfinite(acc)) throw std::overflow_error("DSA pooling overflowed");
+            pooled[p * dim + e] = acc;
+        }
+}
+
+void dsa_score_reference(std::span<const float> iq, std::span<const float> weights,
+                         std::span<const float> pooled, std::span<float> scores,
+                         const DsaIndexerProfile& profile) {
+    const size_t heads = profile.heads;
+    const size_t dim = profile.head_dim;
+    const size_t head_plane = checked_mul(heads, dim);
+    const size_t tokens = token_count(iq, head_plane, "DSA iq is not whole token planes");
+    const size_t pools = token_count(pooled, dim, "DSA pooled is not whole pool planes");
+    if (weights.size() != checked_mul(tokens, heads))
+        throw std::invalid_argument("DSA weights must hold one value per token and head");
+    if (scores.size() != checked_mul(tokens, pools))
+        throw std::invalid_argument("DSA score plane does not match tokens x pools");
+    if (tokens == 0) throw std::invalid_argument("DSA scoring requires at least one token");
+    demand_finite(iq, "DSA iq must be finite");
+    demand_finite(weights, "DSA weights must be finite");
+    demand_finite(pooled, "DSA pooled must be finite");
+
+    const float dot_scale = 1.0f / std::sqrt(static_cast<float>(dim));
+    const float head_scale = 1.0f / std::sqrt(static_cast<float>(heads));
+    for (size_t t = 0; t < tokens; ++t)
+        for (size_t p = 0; p < pools; ++p) {
+            float acc = 0;
+            for (size_t h = 0; h < heads; ++h) {
+                const float* q = iq.data() + t * head_plane + h * dim;
+                const float* key = pooled.data() + p * dim;
+                float dot = 0;
+                for (size_t e = 0; e < dim; ++e) dot = std::fma(q[e], key[e], dot);
+                acc = std::fma(std::fmax(dot * dot_scale, 0.0f),
+                               weights[t * heads + h] * head_scale, acc);
+            }
+            if (!std::isfinite(acc)) throw std::overflow_error("DSA scoring overflowed");
+            scores[t * pools + p] = acc;
+        }
+}
+
+void dsa_select_reference(std::span<const float> scores, std::span<const uint32_t> pos,
+                          std::span<int32_t> cells, const DsaIndexerProfile& profile) {
+    const size_t kpool = profile.kpool;
+    const size_t tokens = pos.size();
+    const size_t top_pools = dsa_top_pools(profile);
+    const size_t width = dsa_selection_width(profile);
+    if (tokens == 0) throw std::invalid_argument("DSA selection requires at least one token");
+    if (scores.size() % tokens != 0)
+        throw std::invalid_argument("DSA score plane does not match the position count");
+    const size_t pools = scores.size() / tokens;
+    if (cells.size() != checked_mul(tokens, width))
+        throw std::invalid_argument("DSA cell plane does not match the selection width");
+    if (pools == 0) throw std::invalid_argument("DSA selection requires at least one scored pool");
+    demand_finite(scores, "DSA scores must be finite");
+    for (const auto position : pos)
+        if ((position + 1) / kpool > pools)
+            throw std::invalid_argument("DSA position sees more pools than were scored");
+
+    // 2051 is the production width; a generous bound keeps narrower probe
+    // profiles testable without dynamic allocation.
+    constexpr size_t kMaxSelectionWidth = 4096;
+    if (width > kMaxSelectionWidth)
+        throw std::invalid_argument("DSA selection width exceeds the staging bound");
+    for (size_t t = 0; t < tokens; ++t) {
+        const size_t visible = (pos[t] + 1) / kpool;
+        int32_t row[kMaxSelectionWidth];
+        for (size_t s = 0; s < width; ++s) row[s] = -1;
+
+        for (size_t p = 0; p < visible; ++p) {
+            const float value = scores[t * pools + p];
+            size_t rank = 0;
+            for (size_t q = 0; q < visible; ++q) {
+                const float other = scores[t * pools + q];
+                if (other > value) ++rank;
+                else if (q < p && other == value) ++rank;
+            }
+            if (rank < top_pools)
+                for (size_t m = 0; m < kpool; ++m) row[rank * kpool + m] = static_cast<int32_t>(p * kpool + m);
+        }
+        if (profile.select_tail)
+            for (size_t m = 0; m + 1 < kpool; ++m) {
+                const size_t cell = visible * kpool + m;
+                if (cell <= pos[t]) row[top_pools * kpool + m] = static_cast<int32_t>(cell);
+            }
+        for (size_t s = 0; s < width; ++s) cells[t * width + s] = row[s];
+    }
+}
+
+void dsa_attention_reference(std::span<const float> q_abs, std::span<const float> latents,
+                             std::span<const int32_t> cells, std::span<const float> wv_b,
+                             std::span<float> out, const DsaIndexerProfile& indexer,
+                             const DsaMlaProfile& mla, size_t cache_tokens) {
+    const size_t lora = mla.kv_lora;
+    const size_t heads = mla.heads;
+    const size_t v_head = mla.v_head;
+    const size_t head_plane = checked_mul(lora, heads);
+    const size_t tokens = token_count(q_abs, head_plane, "DSA q_abs is not whole token planes");
+    const size_t width = dsa_selection_width(indexer);
+    if (cells.size() != checked_mul(tokens, width))
+        throw std::invalid_argument("DSA cells do not match tokens x selection width");
+    if (latents.size() != checked_mul(cache_tokens, lora))
+        throw std::invalid_argument("DSA latents do not match the cache token count");
+    if (wv_b.size() != checked_mul(checked_mul(lora, v_head), heads))
+        throw std::invalid_argument("DSA wv_b does not match the GGUF geometry");
+    if (out.size() != checked_mul(tokens, checked_mul(heads, v_head)))
+        throw std::invalid_argument("DSA output does not match tokens x heads x v_head");
+    if (tokens == 0 || cache_tokens == 0)
+        throw std::invalid_argument("DSA attention requires tokens and cache");
+    demand_finite(q_abs, "DSA q_abs must be finite");
+    demand_finite(latents, "DSA latents must be finite");
+    demand_finite(wv_b, "DSA wv_b must be finite");
+    for (const auto cell : cells)
+        if (cell < -1 || cell >= static_cast<int64_t>(cache_tokens))
+            throw std::invalid_argument("DSA cell is outside the cache");
+
+    const float scale = 1.0f / std::sqrt(static_cast<float>(mla.qk_nope));
+    std::vector<float> probabilities(width), context(lora), staged(heads * v_head);
+    for (size_t t = 0; t < tokens; ++t) {
+        const int32_t* row = cells.data() + t * width;
+        for (size_t s = 0; s < width; ++s) probabilities[s] = 0.0f;
+        for (size_t h = 0; h < heads; ++h) {
+            const float* q = q_abs.data() + t * head_plane + h * lora;
+            float maximum = 0;
+            bool any = false;
+            for (size_t s = 0; s < width; ++s) {
+                if (row[s] < 0) continue;
+                const float* latent = latents.data() + static_cast<size_t>(row[s]) * lora;
+                float dot = 0;
+                for (size_t e = 0; e < lora; ++e) dot = std::fma(q[e], latent[e], dot);
+                probabilities[s] = dot * scale;
+                if (!any || probabilities[s] > maximum) { maximum = probabilities[s]; any = true; }
+            }
+            if (!any) throw std::invalid_argument("DSA attention row has no valid cell");
+            float denominator = 0;
+            for (size_t s = 0; s < width; ++s)
+                if (row[s] >= 0) {
+                    probabilities[s] = std::exp(probabilities[s] - maximum);
+                    denominator += probabilities[s];
+                }
+            const float inverse = 1.0f / denominator;
+            for (size_t e = 0; e < lora; ++e) context[e] = 0.0f;
+            for (size_t s = 0; s < width; ++s)
+                if (row[s] >= 0) {
+                    const float* latent = latents.data() + static_cast<size_t>(row[s]) * lora;
+                    const float weight = probabilities[s] * inverse;
+                    for (size_t e = 0; e < lora; ++e) context[e] = std::fma(weight, latent[e], context[e]);
+                }
+            // out[t][h][v] = sum_c wv_b[c + lora*v + lora*v_head*h] * context[c]
+            for (size_t v = 0; v < v_head; ++v) {
+                const float* column = wv_b.data() + static_cast<size_t>(lora * v + lora * v_head * h);
+                float acc = 0;
+                for (size_t c = 0; c < lora; ++c) acc = std::fma(column[c], context[c], acc);
+                if (!std::isfinite(acc)) throw std::overflow_error("DSA attention overflowed");
+                staged[h * v_head + v] = acc;
+            }
+        }
+        for (size_t i = 0; i < staged.size(); ++i) out[t * heads * v_head + i] = staged[i];
+    }
+}
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/dsa_reference.h b/src/models/glm5/reference/dsa_reference.h
new file mode 100644
index 0000000..c9a3fac
--- /dev/null
+++ b/src/models/glm5/reference/dsa_reference.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kDsaReferenceProfile = "glm53_dsa_fp32";
+
+// GLM-5.3-Flash's audited DSA indexer geometry: 32 index heads of 128, pools
+// of 4 tokens, a 2048-token selection budget (512 pools) plus the mandatory
+// 3-slot incomplete tail, giving the fixed 2051-wide selection rows.
+struct DsaIndexerProfile {
+    uint32_t heads;
+    uint32_t head_dim;
+    uint32_t kpool;
+    uint32_t top_k;
+    bool select_tail;
+};
+inline constexpr DsaIndexerProfile kGlm53DsaIndexerProfile{32, 128, 4, 2048, true};
+
+[[nodiscard]] constexpr uint32_t dsa_top_pools(const DsaIndexerProfile& p) {
+    return p.top_k / p.kpool;  // 2048/4 = 512
+}
+[[nodiscard]] constexpr size_t dsa_selection_width(const DsaIndexerProfile& p) {
+    return p.select_tail ? size_t(p.top_k) + p.kpool - 1 : size_t(p.top_k);
+}
+
+// Pool compression over COMPLETE pools: pool p covers tokens [p*kpool,
+// p*kpool+kpool). pooled[p][e] = sum_m softmax_m(gates[p*kpool+m][e] +
+// ape[m][e]) * keys[p*kpool+m][e] where the softmax runs SEPARATELY PER
+// KEY-DIM ELEMENT over the pool members - the parity-pinned quirk; a whole-row
+// softmax is the natural wrong reading. Stable max-subtracted softmax in FP32.
+// tokens must be a positive multiple of kpool (the caller keeps the tail);
+// ape is [kpool][head_dim]. Everything validates before any output is written.
+void dsa_pool_reference(std::span<const float> keys, std::span<const float> gates,
+                        std::span<const float> ape, std::span<float> pooled,
+                        const DsaIndexerProfile&);
+
+// index_scores[t][p] = sum_h relu(iq[t][h] . pooled[p] * head_dim^-0.5) *
+// (weights[t][h] * heads^-0.5), all FP32. The two scale factors follow the
+// transformers placement (inside the ReLU / on the head weights); llama.cpp
+// and Maya pre-multiply 1/sqrt(head_dim*heads) onto the weights instead,
+// which is the same product in exact arithmetic and differs only in rounding.
+// iq is [tokens][heads][head_dim], weights [tokens][heads].
+void dsa_score_reference(std::span<const float> iq, std::span<const float> weights,
+                         std::span<const float> pooled, std::span<float> scores,
+                         const DsaIndexerProfile&);
+
+// Selection for one sequence of aligned pools: token t at GLOBAL position
+// pos[t] sees the first n_vis = (pos[t]+1)/kpool completed pools (pool p is
+// visible iff its last member p*kpool+kpool-1 <= pos[t]; the tail includes the
+// query token itself). Visible pools are ranked stable-descending with exact
+// ties broken by lower pool index; the pool at rank r occupies slots
+// [r*kpool, r*kpool+kpool) with its member cells in position order (slot
+// order IS score order). The incomplete tail (cells n_vis*kpool .. pos[t])
+// then fills [top_pools*kpool, ...) in position order when select_tail.
+// Every unused slot is -1. Output rows have the fixed dsa_selection_width.
+// pools is the completed-pool count of scores' second axis; n_vis must stay
+// <= pools. scores/pos/cells inputs must be finite/valid; cells publish per
+// token after the whole row validates.
+void dsa_select_reference(std::span<const float> scores, std::span<const uint32_t> pos,
+                          std::span<int32_t> cells, const DsaIndexerProfile&);
+
+// GLM-5.3-Flash's audited absorbed-MLA geometry: 512 latent, 64 heads, 256
+// nope score dim (also the softmax scale base) and 256 value dim. NoPE only.
+struct DsaMlaProfile {
+    uint32_t kv_lora;
+    uint32_t heads;
+    uint32_t qk_nope;
+    uint32_t v_head;
+};
+inline constexpr DsaMlaProfile kGlm53DsaMlaProfile{512, 64, 256, 256};
+
+// Absorbed sparse attention over one layer's selection rows.
+// q_abs is [tokens][heads][kv_lora] (queries already absorbed through
+// W_K_B: q_abs = W_K_B_h^T q_h), latents [cache][kv_lora] (the only cached
+// per-token state; no per-head K/V exists), cells [tokens][selection_width]
+// with -1 padding from dsa_select_reference, and wv_b the GGUF tensor
+// {kv_lora, v_head, heads}: wv_b[c + kv_lora*v + kv_lora*v_head*h].
+// Per token and head: score_s = (q_abs . latent_{cells[s]}) * qk_nope^-0.5
+// (the model constant 256^-0.5, NOT kv_lora^-0.5); softmax EXCLUDES the -1
+// slots entirely (numerically the graph's -inf additive mask); ctx accumulates
+// only over valid slots; out[t][h][v] = sum_c wv_b[c,v,h] * ctx[c]. Output
+// is [tokens][heads][v_head]. Inputs validate first; out publishes per token
+// once the whole token's values are finite.
+void dsa_attention_reference(std::span<const float> q_abs, std::span<const float> latents,
+                             std::span<const int32_t> cells, std::span<const float> wv_b,
+                             std::span<float> out, const DsaIndexerProfile&,
+                             const DsaMlaProfile&, size_t cache_tokens);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/kda_chunk_reference.cpp b/src/models/glm5/reference/kda_chunk_reference.cpp
new file mode 100644
index 0000000..2b0d531
--- /dev/null
+++ b/src/models/glm5/reference/kda_chunk_reference.cpp
@@ -0,0 +1,189 @@
+#include "models/glm5/reference/kda_chunk_reference.h"
+
+#include <array>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+constexpr float kL2Eps = 1e-6f;
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("KDA chunk reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+}  // namespace
+
+void kda_chunk_reference(std::span<const float> q, std::span<const float> k,
+                         std::span<const float> v, std::span<const float> gate,
+                         std::span<const float> beta, std::span<float> state,
+                         std::span<float> out, std::span<float> scratch, const KdaProfile& profile,
+                         uint32_t chunk) {
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t dk = profile.head_dim;
+    const size_t state_values = kda_state_values(profile);
+    if (d_inner == 0 || q.size() % d_inner != 0)
+        throw std::invalid_argument("KDA chunk query is not a whole token plane");
+    const size_t tokens = q.size() / d_inner;
+    if (chunk == 0 || chunk > kKdaMaxChunk || tokens % chunk != 0)
+        throw std::invalid_argument("KDA chunk requires tokens to be a positive multiple of chunk");
+    if (k.size() != q.size() || v.size() != q.size() || gate.size() != q.size())
+        throw std::invalid_argument("KDA chunk k/v/gate planes must match the query plane");
+    if (beta.size() != checked_mul(tokens, profile.heads))
+        throw std::invalid_argument("KDA chunk beta must hold one value per token and head");
+    if (state.size() != state_values)
+        throw std::invalid_argument("KDA chunk state does not match the profile");
+    if (out.size() != q.size()) throw std::invalid_argument("KDA chunk output size mismatch");
+    if (scratch.size() != kda_chunk_scratch_values(profile, tokens, chunk))
+        throw std::invalid_argument("KDA chunk scratch does not match the requirement");
+    if (tokens == 0) throw std::invalid_argument("KDA chunk requires at least one token");
+    for (const auto* plane : {&q, &k, &v, &gate, &beta})
+        demand_finite(*plane, "KDA chunk inputs must be finite");
+    demand_finite(state, "KDA chunk state must be finite");
+
+    const size_t c = chunk;
+    const float scale = 1.0f / std::sqrt(static_cast<float>(dk));
+    float* work = scratch.data();                        // state image ...
+    float* staged = work + state_values;                 // ... then output image ...
+    float* plane = staged + out.size();                  // ... then the per-head work plane
+    float* gsum = plane;                                 // [c][dk]
+    float* q_normed = gsum + c * dk;                     // [c][dk], scaled by head_dim^-0.5
+    float* k_normed = q_normed + c * dk;                 // [c][dk]
+    float* t_matrix = k_normed + c * dk;                 // [c][c]
+    float* w_rows = t_matrix + c * c;                    // [c][dk]
+    float* u_rows = w_rows + c * dk;                     // [c][dk]
+    float* v_fixed = u_rows + c * dk;                    // [c][dk]
+    float* staging = v_fixed + c * dk;                   // [c] substitution deltas / Aqk row
+
+    for (size_t i = 0; i < state_values; ++i) work[i] = state[i];
+    const size_t chunks = tokens / c;
+
+    for (size_t chunk_index = 0; chunk_index < chunks; ++chunk_index)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const size_t base = chunk_index * c * d_inner + size_t(head) * dk;
+            const size_t beta_base = chunk_index * c * profile.heads + head;  // + row*heads reaches row token
+
+            for (size_t row = 0; row < c; ++row)
+                for (size_t d = 0; d < dk; ++d) {
+                    const float value = gate[base + row * d_inner + d];
+                    gsum[row * dk + d] = value + (row ? gsum[(row - 1) * dk + d] : 0.0f);
+                }
+            for (size_t row = 0; row < c; ++row) {
+                float q_square = kL2Eps, k_square = kL2Eps;
+                for (size_t d = 0; d < dk; ++d) {
+                    const float qv = q[base + row * d_inner + d];
+                    const float kv = k[base + row * d_inner + d];
+                    q_square = std::fma(qv, qv, q_square);
+                    k_square = std::fma(kv, kv, k_square);
+                }
+                const float q_inv = 1.0f / std::sqrt(q_square);
+                const float k_inv = 1.0f / std::sqrt(k_square);
+                for (size_t d = 0; d < dk; ++d) {
+                    q_normed[row * dk + d] = (q[base + row * d_inner + d] * q_inv) * scale;
+                    k_normed[row * dk + d] = k[base + row * d_inner + d] * k_inv;
+                }
+            }
+
+            // Decayed key Gram from differences only. Entries are
+            // [row = later token i][col = earlier token j], j < i, with the
+            // exponent gsum[i] - gsum[j] <= 0 (gsum is non-increasing), so no
+            // positive exponent is ever computed. The LATER token's beta
+            // scales the Gram row; exact forward substitution then produces
+            // (I+L)^-1 - I on the strict lower triangle.
+            for (size_t i = 0; i < c; ++i)
+                for (size_t j = 0; j < c; ++j) t_matrix[i * c + j] = 0.0f;
+            for (size_t i = 1; i < c; ++i)
+                for (size_t j = 0; j < i; ++j) {
+                    float acc = 0;
+                    for (size_t d = 0; d < dk; ++d)
+                        acc = std::fma(k_normed[i * dk + d] *
+                                           std::exp(gsum[i * dk + d] - gsum[j * dk + d]),
+                                       k_normed[j * dk + d], acc);
+                    t_matrix[i * c + j] = -beta[beta_base + i * profile.heads] * acc;
+                }
+            for (size_t i = 1; i < c; ++i) {
+                for (size_t j = 0; j < i; ++j) {
+                    float acc = 0;
+                    for (size_t m = 0; m < i; ++m) acc += t_matrix[i * c + m] * t_matrix[m * c + j];
+                    staging[j] = acc;
+                }
+                for (size_t j = 0; j < i; ++j) t_matrix[i * c + j] += staging[j];
+            }
+            // u = (T+I) @ (beta_key * v), w = (T+I) @ (beta_key * e^gsum * k):
+            // the diagonal of (T+I) is beta of the own token, the strict-lower
+            // columns carry the EARLIER (column) token's beta.
+            for (size_t row = 0; row < c; ++row)
+                for (size_t d = 0; d < dk; ++d) {
+                    const float b_diag = beta[beta_base + row * profile.heads];
+                    float w_acc = b_diag * k_normed[row * dk + d] * std::exp(gsum[row * dk + d]);
+                    float u_acc = b_diag * v[base + row * d_inner + d];
+                    for (size_t col = 0; col < row; ++col) {
+                        const float t = t_matrix[row * c + col] * beta[beta_base + col * profile.heads];
+                        w_acc = std::fma(t, k_normed[col * dk + d] * std::exp(gsum[col * dk + d]), w_acc);
+                        u_acc = std::fma(t, v[base + col * d_inner + d], u_acc);
+                    }
+                    w_rows[row * dk + d] = w_acc;
+                    u_rows[row * dk + d] = u_acc;
+                }
+
+            float* S = work + size_t(head) * dk * dk;
+            for (size_t row = 0; row < c; ++row) {
+                for (size_t d = 0; d < dk; ++d) {
+                    float acc = 0;
+                    for (size_t kd = 0; kd < dk; ++kd)
+                        acc = std::fma(w_rows[row * dk + kd], S[kd * dk + d], acc);
+                    v_fixed[row * dk + d] = u_rows[row * dk + d] - acc;
+                }
+                // Aqk row with diagonal kept, differences only.
+                for (size_t col = 0; col <= row; ++col) {
+                    float gram = 0;
+                    for (size_t d = 0; d < dk; ++d)
+                        gram = std::fma(q_normed[row * dk + d] *
+                                            std::exp(gsum[row * dk + d] - gsum[col * dk + d]),
+                                        k_normed[col * dk + d], gram);
+                    staging[col] = gram;
+                }
+                float* o_row = staged + base + row * d_inner;
+                for (size_t d = 0; d < dk; ++d) {
+                    float acc = 0;
+                    for (size_t kd = 0; kd < dk; ++kd)
+                        acc = std::fma(q_normed[row * dk + kd] * std::exp(gsum[row * dk + kd]),
+                                       S[kd * dk + d], acc);
+                    for (size_t col = 0; col <= row; ++col)
+                        acc = std::fma(staging[col], v_fixed[col * dk + d], acc);
+                    o_row[d] = acc;
+                }
+            }
+            // State: rows decay by the chunk's last cumsum, then the rank-c
+            // update with decay-shifted keys and the corrected values.
+            for (size_t kd = 0; kd < dk; ++kd) {
+                const float decay = std::exp(gsum[(c - 1) * dk + kd]);
+                for (size_t d = 0; d < dk; ++d) S[kd * dk + d] *= decay;
+            }
+            for (size_t kd = 0; kd < dk; ++kd)
+                for (size_t d = 0; d < dk; ++d) {
+                    float acc = 0;
+                    for (size_t row = 0; row < c; ++row)
+                        acc = std::fma(k_normed[row * dk + kd] *
+                                           std::exp(gsum[(c - 1) * dk + kd] - gsum[row * dk + kd]),
+                                       v_fixed[row * dk + d], acc);
+                    S[kd * dk + d] += acc;
+                }
+        }
+
+    for (size_t i = 0; i < state_values; ++i)
+        if (!std::isfinite(work[i])) throw std::overflow_error("KDA chunk state overflowed");
+    for (size_t i = 0; i < out.size(); ++i)
+        if (!std::isfinite(staged[i])) throw std::overflow_error("KDA chunk output overflowed");
+    for (size_t i = 0; i < state_values; ++i) state[i] = work[i];
+    for (size_t i = 0; i < out.size(); ++i) out[i] = staged[i];
+}
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/kda_chunk_reference.h b/src/models/glm5/reference/kda_chunk_reference.h
new file mode 100644
index 0000000..1ef3c14
--- /dev/null
+++ b/src/models/glm5/reference/kda_chunk_reference.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "models/glm5/reference/kda_reference.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kKdaChunkReferenceProfile = "glm53_kda_chunk_fp32";
+
+// Production chunk width of the reference stack (FLA/abotsis default).
+inline constexpr uint32_t kGlm53KdaChunk = 64;
+// Staging bound: 64 production, 256 keeps accidental wider profiles testable.
+inline constexpr uint32_t kKdaMaxChunk = 256;
+
+// Total scratch of kda_chunk_reference in floats: the staged state image and
+// output image (validate-then-commit, same contract as the recurrent scan)
+// plus one reusable per-head work plane of chunk*(chunk + 6*head_dim + 1)
+// values (rebased cumsum, normalized q/k, T, u, w, corrected values - six
+// chunk x head_dim planes - plus the forward-substitution/Aqk staging row).
+[[nodiscard]] constexpr size_t kda_chunk_scratch_values(const KdaProfile& profile,
+                                                         size_t tokens, uint32_t chunk) {
+    const size_t per_head = size_t(chunk) * (chunk + 6 * size_t(profile.head_dim) + 1);
+    return kda_scan_scratch_values(profile, tokens) + per_head;
+}
+
+// Chunked prefill over whole chunks: the FLA naive chunk algorithm with the
+// audited GLM-5.3 semantics. Inputs match kda_gated_delta_reference exactly
+// (q/k/v post-conv SiLU planes, gate in log space from the decay-gate
+// reference, already-sigmoided beta); tokens must be a multiple of chunk (the
+// caller pads tails with g=0/q=k=v=beta=0 rows, which contribute nothing).
+// q/k get the in-kernel l2 norm (eps 1e-6) and q the head_dim^-0.5 scale.
+//
+// Per chunk and head: a per-chunk rebased cumsum of the log gate; the decayed
+// key Gram taken from DIFFERENCES exp(gsum[c]-gsum[i]) (never the factored
+// product form, which overflows for long chunks); the unit-diagonal strict
+// lower system solved by exact forward substitution (no Neumann iteration);
+// beta of the earlier token scales the Gram rows and beta of the own token
+// scales the v/w operands; Aqk keeps its diagonal; the state affine update
+// carries the chunk recurrence. All arithmetic FP32 with /fp:strict.
+//
+// state and out commit together only after every value validates, exactly like
+// the recurrent scan; scratch must hold kda_chunk_scratch_values and must not
+// alias any plane. This is the reference chunk algorithm only: no varlen
+// packing, no HPU execution, no performance claim.
+void kda_chunk_reference(std::span<const float> q, std::span<const float> k,
+                         std::span<const float> v, std::span<const float> gate,
+                         std::span<const float> beta, std::span<float> state,
+                         std::span<float> out, std::span<float> scratch, const KdaProfile&,
+                         uint32_t chunk);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/kda_reference.cpp b/src/models/glm5/reference/kda_reference.cpp
new file mode 100644
index 0000000..d998a03
--- /dev/null
+++ b/src/models/glm5/reference/kda_reference.cpp
@@ -0,0 +1,219 @@
+#include "models/glm5/reference/kda_reference.h"
+
+#include <array>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+constexpr float kL2Eps = 1e-6f;   // transformers l2norm/glm kernels add eps inside the sqrt
+constexpr float kNormEps = 1e-6f; // Glm5NextTextRMSNormGated default eps
+// Per-head staging bound: the reference head slice is 128 floats; twice that
+// keeps an accidental 256-dim profile testable instead of silently corrupt.
+constexpr size_t kMaxHeadDim = 256;
+
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "GLM KDA reference requires IEEE-754 binary32");
+
+float sigmoid(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("KDA reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+
+size_t token_count(std::span<const float> plane, size_t d_inner, const char* what) {
+    if (d_inner == 0 || plane.size() % d_inner != 0)
+        throw std::invalid_argument(what);
+    return plane.size() / d_inner;
+}
+}  // namespace
+
+void kda_conv_reference(std::span<const float> x, std::span<const float> weights,
+                        std::span<float> conv_state, std::span<float> out, const KdaProfile& profile) {
+    if (profile.d_conv < 2) throw std::invalid_argument("KDA conv requires at least two taps");
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t hist = profile.d_conv - 1;
+    const size_t tokens = token_count(x, d_inner, "KDA conv input is not a whole token plane");
+    if (weights.size() != checked_mul(d_inner, profile.d_conv))
+        throw std::invalid_argument("KDA conv weights do not match the profile");
+    if (conv_state.size() != checked_mul(hist, d_inner))
+        throw std::invalid_argument("KDA conv state does not match the profile");
+    if (out.size() != x.size()) throw std::invalid_argument("KDA conv output size mismatch");
+    if (tokens == 0) throw std::invalid_argument("KDA conv requires at least one token");
+    demand_finite(x, "KDA conv input must be finite");
+    demand_finite(weights, "KDA conv weights must be finite");
+    demand_finite(conv_state, "KDA conv state must be finite");
+
+    // The virtual window [state | x]: sample s maps to state row s+hist for s<0
+    // and to x[s] otherwise. Each output element is published as soon as it is
+    // finite; the state is only advanced after every element succeeded.
+    const auto sample = [&](long long s, size_t channel) -> float {
+        return s >= 0 ? x[static_cast<size_t>(s) * d_inner + channel]
+                      : conv_state[static_cast<size_t>(s + static_cast<long long>(hist)) * d_inner + channel];
+    };
+    for (size_t t = 0; t < tokens; ++t)
+        for (size_t channel = 0; channel < d_inner; ++channel) {
+            float acc = 0;
+            for (size_t tap = 0; tap < profile.d_conv; ++tap) {
+                const float w = weights[channel * profile.d_conv + tap];
+                acc = std::fma(w, sample(static_cast<long long>(t) - static_cast<long long>(hist) +
+                                         static_cast<long long>(tap), channel), acc);
+            }
+            if (!std::isfinite(acc)) throw std::overflow_error("KDA conv tap sum overflowed");
+            const float silu = acc * sigmoid(acc);
+            if (!std::isfinite(silu)) throw std::overflow_error("KDA conv SiLU overflowed");
+            out[t * d_inner + channel] = silu;
+        }
+    for (size_t channel = 0; channel < d_inner; ++channel) {
+        // Stage first: with tokens < hist the new state still reads old rows
+        // that earlier writes of this loop would already have replaced.
+        std::array<float, 64> replacement{};
+        if (hist > replacement.size()) throw std::invalid_argument("KDA conv history exceeds the staging bound");
+        for (size_t tap = 0; tap < hist; ++tap) {
+            const long long s = static_cast<long long>(tokens) - static_cast<long long>(hist) +
+                                static_cast<long long>(tap);
+            replacement[tap] = sample(s, channel);
+        }
+        for (size_t tap = 0; tap < hist; ++tap) conv_state[tap * d_inner + channel] = replacement[tap];
+    }
+}
+
+void kda_decay_gate_reference(std::span<const float> g, std::span<const float> a_log,
+                              std::span<float> out, const KdaProfile& profile) {
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t tokens = token_count(g, d_inner, "KDA gate input is not a whole token plane");
+    if (a_log.size() != profile.heads)
+        throw std::invalid_argument("KDA gate requires one A_log per head");
+    if (out.size() != g.size()) throw std::invalid_argument("KDA gate output size mismatch");
+    if (!std::isfinite(profile.gate_lower_bound) || profile.gate_lower_bound >= 0)
+        throw std::invalid_argument("KDA safe gate lower bound must be finite and negative");
+    demand_finite(g, "KDA gate input must be finite");
+    demand_finite(a_log, "KDA gate A_log must be finite");
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const float decay_rate = std::exp(a_log[head]);
+            for (uint32_t i = 0; i < profile.head_dim; ++i) {
+                const size_t index = t * d_inner + size_t(head) * profile.head_dim + i;
+                out[index] = profile.gate_lower_bound * sigmoid(decay_rate * g[index]);
+            }
+        }
+    // The safe-path result lies in (lower_bound, 0] by construction; the loop
+    // above cannot produce a non-finite value from finite inputs because sigmoid
+    // saturates to 0 or 1 and lower_bound is finite.
+}
+
+void kda_gated_delta_reference(std::span<const float> q, std::span<const float> k,
+                               std::span<const float> v, std::span<const float> gate,
+                               std::span<const float> beta, std::span<float> state,
+                               std::span<float> out, std::span<float> scratch, const KdaProfile& profile) {
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t dk = profile.head_dim;
+    const size_t state_values = kda_state_values(profile);
+    const size_t tokens = token_count(q, d_inner, "KDA scan query is not a whole token plane");
+    if (k.size() != q.size() || v.size() != q.size() || gate.size() != q.size())
+        throw std::invalid_argument("KDA scan k/v/gate planes must match the query plane");
+    if (beta.size() != checked_mul(tokens, profile.heads))
+        throw std::invalid_argument("KDA scan beta must hold one value per token and head");
+    if (state.size() != state_values)
+        throw std::invalid_argument("KDA scan state does not match the profile");
+    if (out.size() != q.size()) throw std::invalid_argument("KDA scan output size mismatch");
+    if (scratch.size() != state_values + out.size())
+        throw std::invalid_argument("KDA scan scratch must hold one state and one output image");
+    if (tokens == 0) throw std::invalid_argument("KDA scan requires at least one token");
+    for (const auto* plane : {&q, &k, &v, &gate, &beta}) demand_finite(*plane, "KDA scan inputs must be finite");
+    demand_finite(state, "KDA scan state must be finite");
+
+    const float scale = 1.0f / std::sqrt(static_cast<float>(dk));
+    float* work = scratch.data();                       // state image, then output image
+    float* staged = scratch.data() + state_values;
+    for (size_t i = 0; i < state_values; ++i) work[i] = state[i];
+
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const float* qt = q.data() + t * d_inner + size_t(head) * dk;
+            const float* kt = k.data() + t * d_inner + size_t(head) * dk;
+            const float* vt = v.data() + t * d_inner + size_t(head) * dk;
+            const float* gt = gate.data() + t * d_inner + size_t(head) * dk;
+            const float b = beta[t * profile.heads + head];
+            float* S = work + size_t(head) * dk * dk;   // row = key axis
+
+            float q_norm = kL2Eps, k_norm = kL2Eps;     // eps inside the sqrt keeps a zero vector finite
+            for (size_t i = 0; i < dk; ++i) {
+                q_norm = std::fma(qt[i], qt[i], q_norm);
+                k_norm = std::fma(kt[i], kt[i], k_norm);
+            }
+            q_norm = std::sqrt(q_norm); k_norm = std::sqrt(k_norm);
+            if (dk > kMaxHeadDim) throw std::invalid_argument("KDA scan head_dim exceeds the staging bound");
+            std::array<float, kMaxHeadDim> qh{}, kh{};
+            for (size_t i = 0; i < dk; ++i) {
+                qh[i] = (qt[i] / q_norm) * scale;
+                kh[i] = kt[i] / k_norm;
+            }
+            for (size_t i = 0; i < dk; ++i) {           // decay applies to the key axis
+                const float decay = std::exp(gt[i]);
+                for (size_t j = 0; j < dk; ++j) S[i * dk + j] *= decay;
+            }
+            std::array<float, kMaxHeadDim> u{}, delta{};
+            for (size_t j = 0; j < dk; ++j) {
+                float acc = 0;
+                for (size_t i = 0; i < dk; ++i) acc = std::fma(S[i * dk + j], kh[i], acc);
+                u[j] = acc;
+            }
+            for (size_t j = 0; j < dk; ++j) delta[j] = b * (vt[j] - u[j]);
+            for (size_t i = 0; i < dk; ++i)
+                for (size_t j = 0; j < dk; ++j) S[i * dk + j] = std::fma(kh[i], delta[j], S[i * dk + j]);
+            float* ot = staged + t * d_inner + size_t(head) * dk;
+            for (size_t j = 0; j < dk; ++j) {
+                float acc = 0;
+                for (size_t i = 0; i < dk; ++i) acc = std::fma(S[i * dk + j], qh[i], acc);
+                ot[j] = acc;
+            }
+            for (size_t i = 0; i < dk * dk; ++i)
+                if (!std::isfinite(S[i])) throw std::overflow_error("KDA scan state overflowed");
+            for (size_t j = 0; j < dk; ++j)
+                if (!std::isfinite(ot[j])) throw std::overflow_error("KDA scan output overflowed");
+        }
+    for (size_t i = 0; i < state_values; ++i) state[i] = work[i];
+    for (size_t i = 0; i < out.size(); ++i) out[i] = staged[i];
+}
+
+void kda_out_gate_reference(std::span<const float> o, std::span<const float> g2,
+                            std::span<const float> norm_w, std::span<float> out,
+                            const KdaProfile& profile) {
+    const size_t dk = profile.head_dim;
+    const size_t d_inner = checked_mul(profile.heads, dk);
+    const size_t tokens = token_count(o, d_inner, "KDA out-gate input is not a whole token plane");
+    if (g2.size() != o.size()) throw std::invalid_argument("KDA out-gate gate plane mismatch");
+    if (norm_w.size() != dk) throw std::invalid_argument("KDA out-gate weight must hold head_dim values");
+    if (out.size() != o.size()) throw std::invalid_argument("KDA out-gate output size mismatch");
+    demand_finite(o, "KDA out-gate input must be finite");
+    demand_finite(g2, "KDA out-gate gate must be finite");
+    demand_finite(norm_w, "KDA out-gate weight must be finite");
+
+    // Publication is per element after it validates; o and out may alias, and
+    // each output element only reads its own head slice, so an alias is safe.
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const float* ot = o.data() + t * d_inner + size_t(head) * dk;
+            const float* gt = g2.data() + t * d_inner + size_t(head) * dk;
+            float mean = 0;
+            for (size_t i = 0; i < dk; ++i) mean = std::fma(ot[i], ot[i], mean);
+            mean /= static_cast<float>(dk);
+            const float inv = 1.0f / std::sqrt(mean + kNormEps);
+            for (size_t i = 0; i < dk; ++i) {
+                const float value = ot[i] * inv * norm_w[i] * sigmoid(gt[i]);
+                if (!std::isfinite(value)) throw std::overflow_error("KDA out-gate overflowed");
+                out[t * d_inner + size_t(head) * dk + i] = value;
+            }
+        }
+}
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/kda_reference.h b/src/models/glm5/reference/kda_reference.h
new file mode 100644
index 0000000..04c9462
--- /dev/null
+++ b/src/models/glm5/reference/kda_reference.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kKdaReferenceProfile = "glm53_kda_fp32";
+
+// GLM-5.3-Flash's audited linear-attention geometry: 34 KDA layers, 64 heads of
+// 128, causal short conv of 4 taps and the -5.0 safe gate lower bound
+// (glm53-config evidence, 2026-10-23 header audit).
+struct KdaProfile {
+    uint32_t heads;
+    uint32_t head_dim;
+    uint32_t d_conv;
+    float gate_lower_bound;
+};
+inline constexpr KdaProfile kGlm53KdaProfile{64, 128, 4, -5.0f};
+
+// Bounded scratch requirement of kda_gated_delta_reference, in floats: one full
+// state image for the validate-then-commit state update.
+[[nodiscard]] constexpr size_t kda_state_values(const KdaProfile& profile) {
+    return size_t(profile.heads) * profile.head_dim * profile.head_dim;
+}
+
+// Total scratch of kda_gated_delta_reference: the state image followed by one
+// output image, both committed only after the whole scan validates.
+[[nodiscard]] constexpr size_t kda_scan_scratch_values(const KdaProfile& profile, size_t tokens) {
+    return kda_state_values(profile) + tokens * size_t(profile.heads) * profile.head_dim;
+}
+
+// Causal per-channel short conv followed by SiLU. x is [tokens][d_inner] with
+// d_inner = heads*head_dim, weights [d_inner][d_conv], conv_state [d_conv-1][d_inner]
+// oldest tap first. Each out element is published once it is finite; conv_state
+// is advanced to the last d_conv-1 columns of [conv_state | x] only after every
+// element succeeded. No projections, activation gating or HPU dispatch.
+void kda_conv_reference(std::span<const float> x, std::span<const float> weights,
+                        std::span<float> conv_state, std::span<float> out, const KdaProfile&);
+
+// Safe-path decay gate in LOG space: out[t][h*head_dim+i] =
+// gate_lower_bound * sigmoid(exp(a_log[h]) * g[t][h*head_dim+i]), i.e. values in
+// (gate_lower_bound, 0] that the scan exponentiates. g is the already-summed
+// f_b(f_a(x)) + dt_bias plane; A_log is per head. FP32 sigmoid and exp, no
+// softplus fallback: GLM-5.3-Flash fixes the safe path.
+void kda_decay_gate_reference(std::span<const float> g, std::span<const float> a_log,
+                              std::span<float> out, const KdaProfile&);
+
+// Gated delta rule scan over tokens. q/k/v are post-conv SiLU [tokens][d_inner];
+// q and k get FLA l2 norm (eps 1e-6 inside the sqrt) and q additionally the
+// head_dim^-0.5 scale, both in FP32, matching the fused kernel's in-kernel path.
+// gate is the kda_decay_gate_reference output (log space, decay applied as
+// exp(gate) on the KEY axis); beta is ALREADY sigmoided [tokens][heads].
+// state is [heads][head_dim key][head_dim value], row = key axis; scratch must
+// hold kda_scan_scratch_values(profile, tokens) floats (one state image then
+// one output image) and must not alias any plane. out is [tokens][d_inner];
+// out and state change together, only after the whole scan validates (a
+// non-finite intermediate rejects the call leaving both untouched). This is
+// the recurrent algorithm only; chunk prefill is a separate future module.
+void kda_gated_delta_reference(std::span<const float> q, std::span<const float> k,
+                               std::span<const float> v, std::span<const float> gate,
+                               std::span<const float> beta, std::span<float> state,
+                               std::span<float> out, std::span<float> scratch, const KdaProfile&);
+
+// Output gate: per token and head, o is RMS-normalized over head_dim (eps 1e-6,
+// FP32), multiplied by norm_w and by sigmoid(g2), writing [tokens][d_inner].
+// o and out may alias: publication happens only after all values validate.
+void kda_out_gate_reference(std::span<const float> o, std::span<const float> g2,
+                            std::span<const float> norm_w, std::span<float> out,
+                            const KdaProfile&);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/mhc_reference.cpp b/src/models/glm5/reference/mhc_reference.cpp
new file mode 100644
index 0000000..fc81414
--- /dev/null
+++ b/src/models/glm5/reference/mhc_reference.cpp
@@ -0,0 +1,216 @@
+#include "models/glm5/reference/mhc_reference.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+constexpr uint32_t kGlmHc = 4;
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "GLM mHC reference requires IEEE-754 binary32");
+
+float sigmoid(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("mHC reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+
+size_t token_count(std::span<const float> plane, size_t per_token, const char* what) {
+    if (per_token == 0 || plane.size() % per_token != 0)
+        throw std::invalid_argument(what);
+    return plane.size() / per_token;
+}
+}  // namespace
+
+void mhc_pre_reference(std::span<const float> streams, std::span<const float> fn,
+                       std::span<const float> base, std::span<const float> scale,
+                       std::span<float> pre, std::span<float> post, std::span<float> comb,
+                       std::span<float> collapsed, const MhcProfile& profile, uint32_t hidden) {
+    if (profile.hc != kGlmHc)
+        throw std::invalid_argument("mHC reference pins the audited 4-stream geometry");
+    if (profile.hc == 0 || hidden == 0 || profile.sinkhorn_iters == 0)
+        throw std::invalid_argument("mHC profile is degenerate");
+    if (!std::isfinite(profile.rms_eps) || profile.rms_eps < 0 ||
+        !std::isfinite(profile.hc_eps) || profile.hc_eps < 0)
+        throw std::invalid_argument("mHC profile epsilons must be finite and nonnegative");
+    const size_t hc = profile.hc;
+    const size_t stream_values = checked_mul(hc, hidden);
+    const size_t mix_values = checked_mul(2 + hc, hc);
+    const size_t tokens = token_count(streams, stream_values,
+                                      "mHC streams are not whole flattened token planes");
+    if (fn.size() != checked_mul(mix_values, stream_values) || base.size() != mix_values ||
+        scale.size() != 3)
+        throw std::invalid_argument("mHC parameters do not match the profile");
+    if (pre.size() != checked_mul(tokens, hc) || post.size() != pre.size() ||
+        comb.size() != checked_mul(tokens, checked_mul(hc, hc)) ||
+        collapsed.size() != checked_mul(tokens, hidden))
+        throw std::invalid_argument("mHC weight plane sizes do not match the token count");
+    if (tokens == 0) throw std::invalid_argument("mHC requires at least one token");
+    demand_finite(streams, "mHC streams must be finite");
+    demand_finite(fn, "mHC fn must be finite");
+    demand_finite(base, "mHC base must be finite");
+    demand_finite(scale, "mHC scale must be finite");
+
+    for (size_t t = 0; t < tokens; ++t) {
+        const float* row = streams.data() + t * stream_values;
+        float mean_square = 0;
+        for (size_t i = 0; i < stream_values; ++i) mean_square += row[i] * row[i];
+        const float inverse = 1.0f / std::sqrt(mean_square / static_cast<float>(stream_values) +
+                                               profile.rms_eps);
+
+        // Mix projection on the normalized plane, left-to-right accumulation.
+        static_assert((2 + kGlmHc) * kGlmHc == 24);
+        float mix_row[24];
+        for (size_t m = 0; m < mix_values; ++m) {
+            const float* weights = fn.data() + m * stream_values;
+            float acc = 0;
+            for (size_t i = 0; i < stream_values; ++i) acc = std::fma(weights[i], row[i], acc);
+            mix_row[m] = acc * inverse;
+        }
+        for (size_t m = 0; m < mix_values; ++m)
+            if (!std::isfinite(mix_row[m])) throw std::overflow_error("mHC mix overflowed");
+
+        float* pre_t = pre.data() + t * hc;
+        float* post_t = post.data() + t * hc;
+        for (size_t n = 0; n < hc; ++n) {
+            const float pre_logit = mix_row[n] * scale[0] + base[n];
+            const float post_logit = mix_row[hc + n] * scale[1] + base[hc + n];
+            pre_t[n] = sigmoid(pre_logit) + profile.hc_eps;
+            post_t[n] = 2.0f * sigmoid(post_logit);
+        }
+
+        // comb[src][dst], flat checkpoint layout comb[dst + hc*src]; softmax
+        // over dst per src row, +eps, then the pinned Sinkhorn order.
+        float* comb_t = comb.data() + t * hc * hc;
+        for (size_t src = 0; src < hc; ++src) {
+            float logits[4], maximum = 0;
+            for (size_t dst = 0; dst < hc; ++dst) {
+                const size_t flat = 2 * hc + dst + hc * src;
+                logits[dst] = mix_row[flat] * scale[2] + base[flat];
+                if (dst == 0 || logits[dst] > maximum) maximum = logits[dst];
+            }
+            float denominator = 0;
+            float exps[4];
+            for (size_t dst = 0; dst < hc; ++dst) {
+                exps[dst] = std::exp(logits[dst] - maximum);
+                denominator += exps[dst];
+            }
+            for (size_t dst = 0; dst < hc; ++dst)
+                comb_t[src * hc + dst] = exps[dst] / denominator + profile.hc_eps;
+        }
+        auto column_normalize = [&]() {   // each dst sums to 1 over src
+            for (size_t dst = 0; dst < hc; ++dst) {
+                float sum = 0;
+                for (size_t src = 0; src < hc; ++src) sum += comb_t[src * hc + dst];
+                const float inverse_sum = 1.0f / (sum + profile.hc_eps);
+                for (size_t src = 0; src < hc; ++src)
+                    comb_t[src * hc + dst] *= inverse_sum;
+            }
+        };
+        auto row_normalize = [&]() {      // each src sums to 1 over dst
+            for (size_t src = 0; src < hc; ++src) {
+                float sum = 0;
+                for (size_t dst = 0; dst < hc; ++dst) sum += comb_t[src * hc + dst];
+                const float inverse_sum = 1.0f / (sum + profile.hc_eps);
+                for (size_t dst = 0; dst < hc; ++dst)
+                    comb_t[src * hc + dst] *= inverse_sum;
+            }
+        };
+        column_normalize();
+        for (uint32_t round = 1; round < profile.sinkhorn_iters; ++round) {
+            row_normalize();
+            column_normalize();
+        }
+
+        float* collapsed_t = collapsed.data() + t * hidden;
+        for (size_t d = 0; d < hidden; ++d) {
+            float acc = 0;
+            for (size_t n = 0; n < hc; ++n) acc = std::fma(pre_t[n], row[n * hidden + d], acc);
+            collapsed_t[d] = acc;
+        }
+        for (size_t n = 0; n < hc; ++n)
+            if (!std::isfinite(pre_t[n]) || !std::isfinite(post_t[n]))
+                throw std::overflow_error("mHC gate overflowed");
+        for (size_t i = 0; i < hc * hc; ++i)
+            if (!std::isfinite(comb_t[i])) throw std::overflow_error("mHC comb overflowed");
+        for (size_t d = 0; d < hidden; ++d)
+            if (!std::isfinite(collapsed_t[d])) throw std::overflow_error("mHC collapse overflowed");
+    }
+}
+
+void mhc_post_reference(std::span<const float> block, std::span<const float> residual,
+                        std::span<const float> post, std::span<const float> comb,
+                        std::span<float> out, const MhcProfile& profile, uint32_t hidden) {
+    const size_t hc = profile.hc;
+    const size_t stream_values = checked_mul(hc, hidden);
+    const size_t tokens = token_count(residual, stream_values,
+                                      "mHC residual is not whole flattened token planes");
+    if (block.size() != checked_mul(tokens, hidden) || post.size() != checked_mul(tokens, hc) ||
+        comb.size() != checked_mul(tokens, checked_mul(hc, hc)) || out.size() != residual.size())
+        throw std::invalid_argument("mHC post plane sizes do not match the token count");
+    if (tokens == 0) throw std::invalid_argument("mHC requires at least one token");
+    demand_finite(block, "mHC block output must be finite");
+    demand_finite(residual, "mHC residual must be finite");
+    demand_finite(post, "mHC post must be finite");
+    demand_finite(comb, "mHC comb must be finite");
+
+    // Per token: compute the whole output row, validate, then publish, so that
+    // an out aliasing residual never mixes old and new stream values.
+    std::vector<float> staged;
+    staged.resize(stream_values);
+    for (size_t t = 0; t < tokens; ++t) {
+        const float* block_t = block.data() + t * hidden;
+        const float* residual_t = residual.data() + t * stream_values;
+        const float* post_t = post.data() + t * hc;
+        const float* comb_t = comb.data() + t * hc * hc;
+        for (size_t dst = 0; dst < hc; ++dst) {
+            for (size_t d = 0; d < hidden; ++d) {
+                float mix = 0;
+                for (size_t src = 0; src < hc; ++src)
+                    mix = std::fma(comb_t[src * hc + dst], residual_t[src * hidden + d], mix);
+                staged[dst * hidden + d] = std::fma(post_t[dst], block_t[d], mix);
+            }
+        }
+        for (size_t i = 0; i < stream_values; ++i)
+            if (!std::isfinite(staged[i])) throw std::overflow_error("mHC post overflowed");
+        float* out_t = out.data() + t * stream_values;
+        for (size_t i = 0; i < stream_values; ++i) out_t[i] = staged[i];
+    }
+}
+
+void mhc_head_reference(std::span<const float> streams, std::span<float> out,
+                        const MhcProfile& profile, uint32_t hidden) {
+    const size_t hc = profile.hc;
+    const size_t stream_values = checked_mul(hc, hidden);
+    const size_t tokens = token_count(streams, stream_values,
+                                      "mHC streams are not whole flattened token planes");
+    if (out.size() != checked_mul(tokens, hidden))
+        throw std::invalid_argument("mHC head output size mismatch");
+    if (tokens == 0) throw std::invalid_argument("mHC requires at least one token");
+    demand_finite(streams, "mHC streams must be finite");
+    const float inverse_count = 1.0f / static_cast<float>(hc);
+    for (size_t t = 0; t < tokens; ++t) {
+        const float* row = streams.data() + t * stream_values;
+        float* out_t = out.data() + t * hidden;
+        // hidden-major accumulation keeps an out alias safe: element d reads
+        // only the d-th column of every stream.
+        for (size_t d = 0; d < hidden; ++d) {
+            float acc = 0;
+            for (size_t n = 0; n < hc; ++n) acc += row[n * hidden + d];
+            const float mean = acc * inverse_count;
+            if (!std::isfinite(mean)) throw std::overflow_error("mHC head overflowed");
+            out_t[d] = mean;
+        }
+    }
+}
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/mhc_reference.h b/src/models/glm5/reference/mhc_reference.h
new file mode 100644
index 0000000..9975342
--- /dev/null
+++ b/src/models/glm5/reference/mhc_reference.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kMhcReferenceProfile = "glm53_mhc_fp32";
+
+// GLM-5.3-Flash's audited mHC geometry: 4 hyper-connection streams, 20 Sinkhorn
+// iterations, epsilon 1e-6 on every gate/denominator and the unweighted RMS
+// norm over the flattened streams (eps 1e-5). hc is pinned to 4 by both
+// production references; the parameterization only keeps test sizes honest.
+struct MhcProfile {
+    uint32_t hc;
+    float rms_eps;
+    float hc_eps;
+    uint32_t sinkhorn_iters;
+};
+inline constexpr MhcProfile kGlm53MhcProfile{4, 1e-5f, 1e-6f, 20};
+
+// Size of one token's flattened stream plane / mix vector for a profile.
+[[nodiscard]] constexpr size_t mhc_stream_values(const MhcProfile& p, uint32_t hidden) {
+    return size_t(p.hc) * hidden;
+}
+[[nodiscard]] constexpr size_t mhc_mix_values(const MhcProfile& p) {
+    return (2 + p.hc) * p.hc;  // pre | post | comb, in this flat order
+}
+
+// Weight generation for one mHC site (attn or ffn; parameters are per-site).
+// streams is [tokens][hc*hidden] FP32; fn is [mix_values][hc*hidden] row-major,
+// base [mix_values] and scale exactly [pre, post, comb]. All arithmetic FP32:
+// the flattened streams get the UNWEIGHTED RMS norm (eps inside the sqrt), the
+// mix projection is a plain left-to-right FP32 dot, pre = sigmoid+scaled by
+// pre_scale + base then +hc_eps, post = 2*sigmoid(...), and comb is built from
+// the flat layout comb[dst + hc*src] as a softmax over dst (each src row)
+// followed by Sinkhorn: one column normalization (sum over src, +hc_eps), then
+// sinkhorn_iters-1 rounds of {row over dst, column over src}, each +hc_eps.
+//
+// pre/post/comb are [tokens][hc]/[tokens][hc]/[tokens][hc*hc] in that same
+// comb[src,dst] order; collapsed is [tokens][hidden] = sum_n pre[n]*streams[n]
+// rounded from the FP32 accumulation. Inputs must be finite (validated); each
+// token's planes publish once all of its values validate, so an adversarial
+// overflow leaves only earlier tokens written.
+void mhc_pre_reference(std::span<const float> streams, std::span<const float> fn,
+                       std::span<const float> base, std::span<const float> scale,
+                       std::span<float> pre, std::span<float> post, std::span<float> comb,
+                       std::span<float> collapsed, const MhcProfile&, uint32_t hidden);
+
+// Stream update after the block: out[dst] = post[dst]*block_output +
+// sum_src comb[src,dst] * residual[src]. block is [tokens][hidden]; residual
+// and out are [tokens][hc*hidden] FP32 and may alias each other (publication
+// is per token after the whole token validates). pre/post/comb come from
+// mhc_pre_reference on that same residual.
+void mhc_post_reference(std::span<const float> block, std::span<const float> residual,
+                        std::span<const float> post, std::span<const float> comb,
+                        std::span<float> out, const MhcProfile&, uint32_t hidden);
+
+// Final head: the UNWEIGHTED mean of the streams, [tokens][hc*hidden] ->
+// [tokens][hidden]. out may alias the input.
+void mhc_head_reference(std::span<const float> streams, std::span<float> out,
+                        const MhcProfile&, uint32_t hidden);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/state.h b/src/models/glm5/state.h
new file mode 100644
index 0000000..62f6fe9
--- /dev/null
+++ b/src/models/glm5/state.h
@@ -0,0 +1,76 @@
+#pragma once
+
+// Per-sequence persistent state layout of GLM-5.3-Flash, derived from the
+// parsed text config and cross-checked against the audited capacity plan:
+// KDA carries an FP32 matrix state plus three causal-conv planes per block;
+// each DSA block caches ONLY the compressed MLA latent (NoPE) plus the
+// indexer's packed [key|gate|valid] row and one pooled key per completed
+// 4-token pool. The layout counts values; bytes come from the caller's dtype.
+
+#include "models/glm5/config.h"
+
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::models::glm5 {
+
+class Glm5StateLayout {
+public:
+    explicit Glm5StateLayout(const TextConfig& config) : config_(config) {
+        kda_blocks_ = 0;
+        dsa_blocks_ = 0;
+        for (const auto kind : config.layer_types) {
+            kda_blocks_ += kind == MixerKind::Kda;
+            dsa_blocks_ += kind == MixerKind::Dsa;
+        }
+        if ((kda_blocks_ + dsa_blocks_) != config.num_hidden_layers) {
+            throw std::invalid_argument("GLM5 state: layer types do not cover every block");
+        }
+    }
+
+    // ---- per-sequence, position-independent state ----
+    // FP32 gated-delta matrix S, [heads][head_dim key][head_dim value] per KDA block.
+    [[nodiscard]] std::uint64_t kda_matrix_floats() const {
+        return std::uint64_t(kda_blocks_) * config_.linear_num_heads * config_.linear_head_dim *
+               config_.linear_head_dim;
+    }
+    // Three causal conv planes (q/k/v), (kernel-1) taps over the KDA inner width.
+    [[nodiscard]] std::uint64_t kda_conv_values() const {
+        return std::uint64_t(kda_blocks_) * 3 * (config_.linear_conv_kernel - 1) *
+               config_.linear_inner_width();
+    }
+
+    // ---- per-sequence, per-logical-position state ----
+    // The MLA latent is the ONLY attention cache: NoPE means no rope component.
+    [[nodiscard]] std::uint64_t mla_latent_values_per_position() const {
+        return std::uint64_t(dsa_blocks_) * config_.kv_lora_rank;
+    }
+    // The indexer's packed row [key | gate | valid] per DSA block.
+    [[nodiscard]] std::uint64_t indexer_packed_values_per_position() const {
+        return std::uint64_t(dsa_blocks_) * (2 * config_.index_head_dim + 1);
+    }
+
+    // ---- per-sequence, per-completed-pool state ----
+    [[nodiscard]] std::uint64_t indexer_pool_key_values_per_pool() const {
+        return std::uint64_t(dsa_blocks_) * config_.index_head_dim;
+    }
+    [[nodiscard]] std::uint64_t completed_pools(std::uint64_t positions) const {
+        return positions / config_.index_kpool;
+    }
+
+    // The decode step's working set for one block boundary (single token):
+    // the mHC residual streams are the model's running hidden state.
+    [[nodiscard]] std::uint64_t mhc_stream_values() const {
+        return std::uint64_t(config_.hc_mult) * config_.hidden_size;
+    }
+
+    [[nodiscard]] std::uint32_t kda_blocks() const noexcept { return kda_blocks_; }
+    [[nodiscard]] std::uint32_t dsa_blocks() const noexcept { return dsa_blocks_; }
+
+private:
+    TextConfig config_;
+    std::uint32_t kda_blocks_ = 0;
+    std::uint32_t dsa_blocks_ = 0;
+};
+
+} // namespace ninfer::models::glm5
diff --git a/src/models/qwen3_5/execution/joint_batch.h b/src/models/qwen3_5/execution/joint_batch.h
new file mode 100644
index 0000000..4424e68
--- /dev/null
+++ b/src/models/qwen3_5/execution/joint_batch.h
@@ -0,0 +1,146 @@
+#pragma once
+#include "core/arena.h"
+#include "core/device.h"
+#include "core/decode_graph.h"
+#include <vector>
+#include <cstdio>
+#include <span>
+#include <stdexcept>
+#include <cstring>
+#include "core/nvtx.h"
+#include "runtime/contract/timing.h"
+#include <functional>
+#include <array>
+
+namespace ninfer::models::qwen3_5::execution {
+class TextContext;
+struct JointNvtxRange {
+    JointNvtxRange(const char* name, std::uint64_t payload) noexcept {
+        nvtxEventAttributes_t event{};
+        event.version=NVTX_VERSION; event.size=NVTX_EVENT_ATTRIB_STRUCT_SIZE;
+        event.category=static_cast<std::uint32_t>(nvtx::Category::Control);
+        event.messageType=NVTX_MESSAGE_TYPE_ASCII; event.message.ascii=name;
+        event.payloadType=NVTX_PAYLOAD_TYPE_UNSIGNED_INT64; event.payload.ullValue=payload;
+        nvtxDomainRangePushEx(nvtx::domain(),&event);
+    }
+    ~JointNvtxRange() { nvtxDomainRangePop(nvtx::domain()); }
+    JointNvtxRange(const JointNvtxRange&)=delete;
+    JointNvtxRange& operator=(const JointNvtxRange&)=delete;
+};
+// Experimental ragged token batch. Sequence-specific mixers keep native KV/SSM contracts;
+// dense MLPs consume the concatenated token rows. An explicit second workspace protects the
+// suspended Prefill roots while the Decode transaction advances. No request-path allocation.
+struct JointBatchState {
+    static constexpr int decode_capacity = 32;
+    int decode_reservation = 16;
+    int decode_rows = 1;
+    const int prefill_capacity;
+    const int hidden_size;
+    DeviceSpan backing;
+    WorkspaceArena prefill_work;
+    Tensor hidden;
+    Tensor saved_controls;
+    // Each GDN layer has a bounded set of exact address/shape/state bindings. A miss
+    // beyond that set runs eager; live tensors and state indices never alias a cached key.
+    struct SegmentKey {
+        std::array<std::uintptr_t, 20> values{};
+        bool operator==(const SegmentKey&) const = default;
+    };
+    struct SegmentEntry {
+        SegmentKey key;
+        DecodeGraphExecutable executable;
+        bool parity_checked = false;
+    };
+    static constexpr std::size_t segments_per_layer = 8;
+    std::vector<std::array<SegmentEntry, segments_per_layer>> gdn_graphs;
+    bool check_graph_parity = false;
+    std::uint64_t graph_replays = 0, graph_captures = 0, graph_fallbacks = 0;
+    void execute_segment(std::uint32_t layer, const SegmentKey& key,
+                         cudaStream_t stream, const std::function<void()>& body,
+                         std::span<const Tensor> parity_tensors) {
+        if (gdn_graphs.empty()) { body(); return; }
+        auto& entries = gdn_graphs.at(layer);
+        SegmentEntry* vacant = nullptr;
+        for (auto& entry : entries) {
+            if (entry.executable.ready() && entry.key == key) {
+                JointNvtxRange range("model.joint_gdn_graph.replay", layer);
+                if (check_graph_parity && !entry.parity_checked) {
+                    // Diagnostic only. Preserve all affected persistent state, execute the
+                    // native body, restore identical bytes, then replay the *cached* graph.
+                    // Check the first cache hit, not just capture with the same control data.
+                    CUDA_CHECK(cudaStreamSynchronize(stream));
+                    std::vector<std::vector<std::byte>> original, expected;
+                    std::size_t bytes = 0;
+                    for (const auto& tensor : parity_tensors) {
+                        if (!tensor.is_contiguous()) throw std::logic_error("graph parity needs contiguous tensors");
+                        original.emplace_back(tensor.bytes()); expected.emplace_back(tensor.bytes());
+                        CUDA_CHECK(cudaMemcpy(original.back().data(), tensor.data, tensor.bytes(), cudaMemcpyDeviceToHost));
+                        bytes += tensor.bytes();
+                    }
+                    body(); CUDA_CHECK(cudaStreamSynchronize(stream));
+                    for (std::size_t i=0; i<parity_tensors.size(); ++i) {
+                        const auto& tensor=parity_tensors[i];
+                        CUDA_CHECK(cudaMemcpy(expected[i].data(), tensor.data, tensor.bytes(), cudaMemcpyDeviceToHost));
+                        CUDA_CHECK(cudaMemcpy(tensor.data, original[i].data(), tensor.bytes(), cudaMemcpyHostToDevice));
+                    }
+                    entry.executable.launch(stream); CUDA_CHECK(cudaStreamSynchronize(stream));
+                    for (std::size_t i=0; i<parity_tensors.size(); ++i) {
+                        const auto& tensor=parity_tensors[i];
+                        CUDA_CHECK(cudaMemcpy(original[i].data(), tensor.data, tensor.bytes(), cudaMemcpyDeviceToHost));
+                        if (original[i] != expected[i])
+                            throw std::runtime_error("joint Graph/native state parity failed at layer " + std::to_string(layer) + " tensor " + std::to_string(i));
+                    }
+                    entry.parity_checked=true;
+                    std::fprintf(stderr,"JOINT_GRAPH_PARITY layer=%u width=%zu bytes=%zu exact=1\n",
+                        layer,std::size_t(key.values[13]),bytes);
+                } else entry.executable.launch(stream);
+                ++graph_replays; return;
+            }
+            if (!entry.executable.ready() && !vacant) vacant = &entry;
+        }
+        if (!vacant) {
+            ++graph_fallbacks;
+            JointNvtxRange range("model.joint_gdn_graph.capacity_fallback", layer);
+            body(); return;
+        }
+        JointNvtxRange range("model.joint_gdn_graph.prepare", layer);
+        DecodeGraphDefinition definition;
+        definition.capture(stream, body);
+        vacant->executable.instantiate(definition);
+        vacant->executable.upload(stream);
+        vacant->key = key;
+        ++graph_captures;
+        std::fprintf(stderr, "JOINT_GRAPH_CAPTURE layer=%u width=%zu captures=%llu replays=%llu fallbacks=%llu\n",
+            layer, std::size_t(key.values[13]), static_cast<unsigned long long>(graph_captures),
+            static_cast<unsigned long long>(graph_replays), static_cast<unsigned long long>(graph_fallbacks));
+        vacant->executable.launch(stream);
+    }
+    bool armed = false;
+    bool used = false;
+    bool fuse_mlp = true;
+    bool fuse_attention_input = false;
+    bool attention_projection_ready = false;
+    bool gdn_projection_ready = false;
+    bool defer_mixer_output = false;
+    std::array<Tensor, 3> gdn_control{};
+    Tensor gdn_projected;
+    Tensor gdn_gate;
+    Tensor mixer_output;
+    std::array<Tensor, 4> attention_projection{};
+    int prefill_columns = 0;
+    int decode_columns = 0;
+    TextContext* peer = nullptr;
+    std::function<void(runtime::ExecutionTiming*)> execute_decode;
+    std::uint64_t rounds = 0;
+    JointBatchState(int h, int p, DeviceSpan workspace, DeviceSpan storage)
+        : prefill_capacity(p), hidden_size(h),
+          backing(storage), prefill_work(workspace),
+          hidden(backing.data, DType::BF16, {h, p + 16}),
+          saved_controls(static_cast<std::byte*>(backing.data) + std::size_t(h) * (p + 16) * 2,
+                         DType::I32, {6}) {}
+    int prefill_limit() const { return prefill_capacity + 16 - decode_reservation; }
+    Tensor prefill_hidden() const { return hidden.slice(1, 0, prefill_columns); }
+    Tensor decode_hidden() const { return hidden.slice(1, prefill_columns, decode_columns); }
+    Tensor combined_hidden() const { return hidden.slice(1, 0, prefill_columns + decode_reservation); }
+};
+}
diff --git a/src/models/qwen3_5/execution/memory_statistics.h b/src/models/qwen3_5/execution/memory_statistics.h
new file mode 100644
index 0000000..ed68744
--- /dev/null
+++ b/src/models/qwen3_5/execution/memory_statistics.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "core/tensor.h"
+#include <vector>
+
+namespace ninfer::models::qwen3_5::execution {
+// Stable Program-owned buffers, borrowed by eager execution and graph capture.
+// Each shard holds its stage's attention layers. Host stores use global layer order.
+// Key sums: [key_width,buckets,layers]; query sums: [query_width,1,layers].
+// Ranges: [K begin,end,Q begin,end].
+// Only normalized, represented BF16 values BEFORE RoPE enter these reductions.
+struct MemoryStatisticsShard {
+    Tensor key_sums;
+    Tensor query_sums;
+    Tensor ranges;
+    // Prefill aggregates complete logical blocks; speculative verification keeps
+    // one column per candidate until the Frontend commits an exact prefix.
+    std::uint32_t block_tokens = 64;
+    Tensor candidate_origin;
+    Tensor prefill_origin;
+    std::uint32_t first_layer = 0;
+};
+
+struct MemoryStatistics {
+    std::vector<MemoryStatisticsShard> ranks;
+    std::uint32_t key_width = 0;
+    std::uint32_t query_width = 0;
+    std::uint32_t layers = 0;
+    std::uint32_t columns = 0;
+
+    [[nodiscard]] std::size_t key_bytes() const noexcept {
+        return std::size_t(key_width) * columns * layers * sizeof(float);
+    }
+    [[nodiscard]] std::size_t query_elements() const noexcept {
+        return std::size_t(query_width) * layers;
+    }
+    [[nodiscard]] std::size_t query_bytes() const noexcept {
+        return query_elements() * sizeof(float);
+    }
+};
+} // namespace ninfer::models::qwen3_5::execution
diff --git a/src/models/qwen3_5/frontend/tool_contract.cpp b/src/models/qwen3_5/frontend/tool_contract.cpp
new file mode 100644
index 0000000..6859764
--- /dev/null
+++ b/src/models/qwen3_5/frontend/tool_contract.cpp
@@ -0,0 +1,303 @@
+#include "models/qwen3_5/frontend/tool_call_parser.h"
+#include "text/structured_output.h"
+#include "text/schema_normalization.h"
+
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include <stdexcept>
+#include <string_view>
+#include <utility>
+
+namespace ninfer::models::qwen3_5::frontend {
+namespace {
+using Json                = nlohmann::ordered_json;
+using Contract            = ToolCallOutputContract;
+using SchemaType          = Contract::SchemaType;
+using TypeSet             = Contract::TypeSet;
+using NormalizationPolicy = Contract::NormalizationPolicy;
+
+constexpr std::uint8_t type_bit(SchemaType type) { return static_cast<std::uint8_t>(type); }
+
+[[noreturn]] void fail(std::string message, std::string path = {}) {
+    throw RequestError(RequestErrorKind::InvalidToolConstraint, std::move(message) + (path.empty() ? "" : " at " + path));
+}
+
+std::string parameter_path(const Contract::Tool& tool) {
+    return "/" + std::to_string(tool.declaration_index) + "/parameters";
+}
+
+bool valid_parameter_name(std::string_view name) {
+    return !name.empty() && name.find_first_of("<>\r\n") == std::string_view::npos;
+}
+
+bool schema_type(std::string_view name, SchemaType& type) {
+    if (name == "null") {
+        type = SchemaType::Null;
+    } else if (name == "boolean") {
+        type = SchemaType::Boolean;
+    } else if (name == "integer") {
+        type = SchemaType::Integer;
+    } else if (name == "number") {
+        type = SchemaType::Number;
+    } else if (name == "string") {
+        type = SchemaType::String;
+    } else if (name == "object") {
+        type = SchemaType::Object;
+    } else if (name == "array") {
+        type = SchemaType::Array;
+    } else {
+        return false;
+    }
+    return true;
+}
+
+bool compile_direct_types(const Json& type_definition, TypeSet& types) {
+    types = {};
+    if (type_definition.is_string()) {
+        SchemaType type;
+        if (!schema_type(type_definition.get_ref<const std::string&>(), type)) { return false; }
+        types.bits = type_bit(type);
+        return true;
+    }
+    if (!type_definition.is_array() || type_definition.empty()) { return false; }
+    for (const Json& member : type_definition) {
+        if (!member.is_string()) { return false; }
+        SchemaType type;
+        if (!schema_type(member.get_ref<const std::string&>(), type)) { return false; }
+        types.bits |= type_bit(type);
+    }
+    return types.bits != 0;
+}
+
+bool compile_schema_types(const Json& schema, TypeSet& types) {
+    if (!schema.is_object()) { return false; }
+    const auto direct = schema.find("type");
+    if (direct != schema.end()) { return compile_direct_types(*direct, types); }
+
+    const auto any_of     = schema.find("anyOf");
+    const auto one_of     = schema.find("oneOf");
+    const bool has_any_of = any_of != schema.end();
+    const bool has_one_of = one_of != schema.end();
+    if (has_any_of == has_one_of) { return false; }
+
+    const Json& alternatives = has_any_of ? *any_of : *one_of;
+    if (!alternatives.is_array() || alternatives.empty()) { return false; }
+
+    TypeSet combined;
+    for (const Json& alternative : alternatives) {
+        TypeSet branch;
+        if (!compile_schema_types(alternative, branch)) { return false; }
+        combined.bits |= branch.bits;
+    }
+    if (combined.bits == 0) { return false; }
+    types = combined;
+    return true;
+}
+
+const Json& resolve(const Json& node, const Json& document, std::set<std::string>& seen) {
+    if (!node.is_object()) return node;
+    if (node.contains("$ref") && node["$ref"].is_string()) {
+        const auto ref = node["$ref"].get<std::string>();
+        if ((ref != "#" && !ref.starts_with("#/")) || !seen.insert(ref).second)
+            fail("tool schema requires resolvable local references");
+        return resolve(document.at(Json::json_pointer(ref.substr(1))), document, seen);
+    }
+    if (node.contains("allOf") && node["allOf"].is_array() && node["allOf"].size() == 1)
+        return resolve(node["allOf"][0], document, seen);
+    return node;
+}
+
+std::uint8_t value_type(const Json& value) {
+    if (value.is_string()) return type_bit(SchemaType::String);
+    if (value.is_boolean()) return type_bit(SchemaType::Boolean);
+    if (value.is_null()) return type_bit(SchemaType::Null);
+    if (value.is_object()) return type_bit(SchemaType::Object);
+    if (value.is_array()) return type_bit(SchemaType::Array);
+    // JSON Schema classifies numbers by value: 1.0 belongs to the integer domain too.
+    const bool integer =
+        value.is_number_integer() ||
+        (value.is_number_float() && std::floor(value.get<double>()) == value.get<double>());
+    return type_bit(integer ? SchemaType::Integer : SchemaType::Number);
+}
+
+std::uint8_t domain(const Json& source, const Json& document, std::set<std::string> seen = {}) {
+    if (source.is_boolean()) return source.get<bool>() ? 0x7f : 0;
+    const Json& node = resolve(source, document, seen);
+    if (!node.is_object()) return node.is_boolean() && !node.get<bool>() ? 0 : 0x7f;
+    std::uint8_t types = 0x7f;
+    if (node.contains("type")) {
+        TypeSet direct;
+        if (!compile_direct_types(node["type"], direct)) fail("invalid tool parameter type");
+        types = direct.bits;
+        if (types & type_bit(SchemaType::Number)) types |= type_bit(SchemaType::Integer);
+    }
+    if (node.contains("const")) return types & value_type(node["const"]);
+    if (node.contains("enum") && node["enum"].is_array()) {
+        std::uint8_t values = 0;
+        for (const auto& item : node["enum"]) values |= value_type(item);
+        return types & values;
+    }
+    for (const char* key : {"anyOf", "oneOf"}) {
+        if (!node.contains(key) || !node[key].is_array()) continue;
+        std::uint8_t combined = 0;
+        for (const auto& branch : node[key]) combined |= domain(branch, document, seen);
+        types &= combined;
+    }
+    if (node.contains("allOf"))
+        for (const auto& branch : node["allOf"]) types &= domain(branch, document, seen);
+    return types;
+}
+
+void prepare_strict_parameters(Contract::Tool& tool) {
+    const Json document = Json::parse(tool.schema_json);
+    if (document.is_object() && (document.contains("$ref") || document.contains("allOf"))) {
+        for (const auto& [key, value] : document.items())
+            if (key != "$ref" && key != "allOf" && key != "$defs" && key != "definitions" &&
+                key != "$schema" && key != "title" && key != "description" && key != "default" &&
+                key != "examples" && key != "$comment")
+                fail("tool root references/composition do not support assertion siblings", parameter_path(tool));
+    }
+    std::set<std::string> seen;
+    const Json& root = resolve(document, document, seen);
+    Json prepared = root;
+    for (const char* key : {"$defs", "definitions"})
+        if (document.contains(key)) prepared[key] = document[key];
+    tool.schema_json = text::normalize_json_schema(prepared.dump());
+    text::validate_structured_output({StructuredOutputKind::JsonSchema, tool.schema_json, false});
+    // The fork's semantic uniqueItems validator operates on final JSON bodies, not XML arguments.
+    const auto reject_unique = [&](auto&& self, const Json& node) -> void {
+        if (!node.is_object()) return;
+        if (node.is_object() && node.contains("uniqueItems") && node["uniqueItems"] == true)
+            fail("uniqueItems in strict tool arguments is unsupported", parameter_path(tool));
+        for (const auto& [key, child] : node.items()) {
+            if (key == "properties" || key == "$defs" || key == "definitions") {
+                if (child.is_object()) for (const auto& member : child) self(self, member);
+            } else if (key == "items" || key == "additionalProperties") self(self, child);
+            else if (key == "anyOf" || key == "prefixItems")
+                if (child.is_array()) for (const auto& member : child) self(self, member);
+        }
+    };
+    reject_unique(reject_unique, prepared);
+    // The pinned converter stores const/enum literals as binary64. Reject inexact integers.
+    const auto check_literal = [&](auto&& self, const Json& value) -> void {
+        if (value.is_number() && (!std::isfinite(value.get<double>()) ||
+            (value.is_number_integer() && std::abs(value.get<long double>()) > 9007199254740991.0L)))
+            fail("numeric tool schema literals require exact finite binary64 values", parameter_path(tool));
+        if (value.is_array() || value.is_object()) for (const auto& child : value) self(self, child);
+    };
+    check_literal(check_literal, prepared);
+    if (!root.is_object() || root.value("type", std::string("object")) != "object")
+        fail("tool '" + tool.name + "' requires an object parameter schema", parameter_path(tool));
+    if (!root.contains("type") || !root.contains("additionalProperties") ||
+        root["additionalProperties"] != false)
+        fail("strict tool '" + tool.name + "' requires type object and additionalProperties=false",
+             parameter_path(tool));
+    for (const char* assertion : {"const", "enum", "anyOf", "oneOf"})
+        if (root.contains(assertion))
+            fail("tool '" + tool.name + "' requires a single declared object parameter list",
+                 parameter_path(tool) + "/" + assertion);
+    tool.parameters.clear();
+    if (!root.contains("properties")) return;
+    if (!root["properties"].is_object())
+        fail("tool properties must be an object", parameter_path(tool));
+    for (const auto& [name, schema] : root["properties"].items()) {
+        if (!valid_parameter_name(name))
+            fail("parameter name cannot be represented in Qwen tool format: " + name,
+                 parameter_path(tool));
+        Contract::Parameter parameter;
+        parameter.name = name;
+        if (compile_schema_types(schema, parameter.types))
+            parameter.policy = NormalizationPolicy::DeclaredTypes;
+        const auto types  = domain(schema, document);
+        const bool string = (types & type_bit(SchemaType::String)) != 0;
+        if (string && types != type_bit(SchemaType::String))
+            fail("strict tool '" + tool.name + "' parameter '" + name +
+                     "' mixes raw string and JSON value types",
+                 parameter_path(tool));
+        parameter.encoding = string ? Contract::Encoding::RawString : Contract::Encoding::Json;
+        if (string) {
+            std::set<std::string> refs;
+            const auto& resolved = resolve(schema, document, refs);
+            const auto check_literal = [&](const Json& value) {
+                if (value.is_string() && value.get<std::string>().find("\n</parameter>") != std::string::npos)
+                    fail("raw string literal contains the parameter closing delimiter", parameter_path(tool));
+            };
+            if (resolved.contains("const")) check_literal(resolved["const"]);
+            if (resolved.contains("enum")) for (const auto& value : resolved["enum"]) check_literal(value);
+        }
+        tool.parameters.push_back(std::move(parameter));
+    }
+}
+} // namespace
+
+std::shared_ptr<const ToolCallOutputContract>
+select_tool_call_contract(const std::shared_ptr<const ToolCallOutputContract>& declarations,
+                          const ToolChoice& choice) {
+    // Keep the tool definitions in the reusable prompt, but do not decode calls or build a
+    // prohibition grammar for the default none path. A separate sampler mask bans the single
+    // vocabulary token whose text is exactly <tool_call> when that token is unique.
+    if (choice.mode == ToolChoiceMode::None &&
+        choice.constraints == ToolConstraintMode::Automatic)
+        return {};
+    if (choice.allowed_names) {
+        for (const auto& name : *choice.allowed_names) {
+            if (!declarations ||
+                std::none_of(declarations->tools.begin(), declarations->tools.end(),
+                             [&](const auto& tool) { return tool.name == name; }))
+                fail("tool choice refers to undeclared tool: " + name);
+        }
+    }
+    if (declarations && declarations->forced_tool_name.empty() &&
+        choice.mode == ToolChoiceMode::Auto && choice.parallel &&
+        !choice.allowed_names && choice.constraints == ToolConstraintMode::Automatic &&
+        std::none_of(declarations->tools.begin(), declarations->tools.end(),
+                     [](const auto& tool) { return tool.strict; }))
+        return declarations;
+    auto selected      = std::make_shared<Contract>();
+    selected->required = choice.mode == ToolChoiceMode::Required;
+    selected->parallel = choice.parallel;
+    if (declarations && choice.mode != ToolChoiceMode::None) {
+        for (const auto& tool : declarations->tools) {
+            if (!choice.allowed_names ||
+                std::find(choice.allowed_names->begin(), choice.allowed_names->end(), tool.name) !=
+                    choice.allowed_names->end())
+                selected->tools.push_back(tool);
+        }
+    }
+    if (selected->tools.empty()) {
+        if (selected->required) fail("required tool choice has no callable tools");
+        if (!declarations || declarations->tools.empty()) return {};
+        selected->constrained = true;
+        return selected;
+    }
+    selected->constrained = selected->required || !declarations->forced_tool_name.empty() ||
+                            !selected->parallel ||
+                            choice.allowed_names.has_value() ||
+                            choice.constraints == ToolConstraintMode::Basic ||
+                            std::any_of(selected->tools.begin(), selected->tools.end(),
+                                        [](const auto& tool) { return tool.strict; });
+    if (selected->constrained) {
+        if (declarations->duplicate_names) fail("tool names must be unique");
+        selected->enforce_declared_names = true;
+        for (auto& tool : selected->tools) {
+            if (!tool.unambiguous || tool.name.empty() || tool.name.find_first_of("<>\r\n") != std::string::npos)
+                fail("invalid tool name: " + tool.name);
+            if (!tool.strict) continue;
+            try {
+                prepare_strict_parameters(tool);
+            } catch (const RequestError&) { throw;
+            } catch (const std::invalid_argument& error) {
+                fail("tool '" + tool.name + "': " + error.what(), parameter_path(tool));
+            } catch (const Json::exception& error) {
+                fail("invalid parameters for tool '" + tool.name + "': " + error.what(),
+                     parameter_path(tool));
+            }
+        }
+    }
+    return selected;
+}
+} // namespace ninfer::models::qwen3_5::frontend
diff --git a/src/models/qwen3_5/frontend/tool_grammar.cpp b/src/models/qwen3_5/frontend/tool_grammar.cpp
new file mode 100644
index 0000000..2e6f32c
--- /dev/null
+++ b/src/models/qwen3_5/frontend/tool_grammar.cpp
@@ -0,0 +1,81 @@
+#include "models/qwen3_5/frontend/tool_grammar.h"
+#include "text/structured_output.h"
+#include "text/schema_normalization.h"
+#include <sstream>
+
+#include "grammar_builder.h"
+#include "grammar_functor.h"
+#include "json_schema_converter.h"
+
+#include <nlohmann/json.hpp>
+#include <optional>
+
+namespace ninfer::models::qwen3_5::frontend {
+namespace {
+using Json     = nlohmann::ordered_json;
+using Contract = ToolCallOutputContract;
+
+xgrammar::Grammar arguments(const Contract::Tool& tool) {
+    try {
+        std::string source;
+        if (tool.strict)
+            source = text::normalize_json_schema(tool.schema_json);
+        else
+            source = R"({"type":"object","additionalProperties":{"type":"string"}})";
+        return xgrammar::JSONSchemaToGrammar(
+            source, false, std::nullopt, std::pair<std::string, std::string>{", ", ": "}, false,
+            std::nullopt, false, xgrammar::JSONFormat::kQwenXML);
+    } catch (const std::exception& error) {
+        throw RequestError(RequestErrorKind::InvalidToolConstraint,
+                           "tool '" + tool.name + "': " + error.what());
+    }
+}
+
+xgrammar::Grammar build(const Contract& contract, const StructuredOutputOptions& body) {
+    std::optional<xgrammar::Grammar> json;
+    if (body.kind != StructuredOutputKind::None) {
+        text::validate_structured_output(body);
+        json = xgrammar::JSONSchemaToGrammar(
+            body.kind == StructuredOutputKind::JsonObject ? "{\"type\":\"object\"}"
+                : text::normalize_json_schema(body.schema), true, std::nullopt, std::nullopt,
+            body.strict, 8);
+    }
+    if (json && contract.tools.empty()) return *json;
+    xgrammar::GrammarBuilder builder;
+    if (contract.tools.empty())
+        return builder.Get(
+            builder.AddRuleWithHint("root", builder.AddTagDispatch({{}, false, {"<tool_call>"}})));
+    std::vector<int32_t> choices;
+    std::optional<int32_t> basic_arguments;
+    for (const auto& tool : contract.tools) {
+        const auto body = !tool.strict && basic_arguments
+                              ? *basic_arguments
+                              : xgrammar::SubGrammarAdder::Apply(&builder, arguments(tool));
+        if (!tool.strict) basic_arguments = body;
+        choices.push_back(builder.AddSequence(
+            {builder.AddByteString("\n<function=" + tool.name + ">\n"), builder.AddRuleRef(body),
+             builder.AddByteString("</function>\n</tool_call>")}));
+    }
+    const auto call_body = builder.AddRuleWithHint("call_body", builder.AddChoices(choices));
+    const auto next_call = builder.AddSequence(
+        {builder.AddByteString("\n<tool_call>"), builder.AddRuleRef(call_body)});
+    const auto tail  = contract.parallel ? builder.AddRepeatFromExpr("calls", next_call, 0, -1)
+                                         : builder.AddEmptyStr();
+    const auto first = builder.AddRuleWithHint(
+        "calls", builder.AddSequence({builder.AddRuleRef(call_body), tail}));
+    const auto root =
+        (contract.required || json.has_value())
+            ? builder.AddSequence({builder.AddByteString("<tool_call>"), builder.AddRuleRef(first)})
+            : builder.AddTagDispatch({{{"<tool_call>", first}}, false, {}});
+    auto calls =
+        xgrammar::GrammarNormalizer::Apply(builder.Get(builder.AddRuleWithHint("root", root)));
+    return json && !contract.required ? xgrammar::Grammar::Union({*json, calls}) : calls;
+}
+} // namespace
+
+std::string tool_grammar(const Contract& contract, const StructuredOutputOptions& body) {
+    std::ostringstream source;
+    source << build(contract, body);
+    return source.str();
+}
+} // namespace ninfer::models::qwen3_5::frontend
