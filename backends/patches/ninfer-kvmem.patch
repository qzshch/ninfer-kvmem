@@ -0,0 +1,23 @@
+#pragma once
+#include "core/gaudi2/runtime.h"
+#include "bf16_gemm_shape.h"
+
+namespace ninfer::gaudi2 {
+class Bf16Gemm {
+public:
+    // Builds one closed static graph and allocates its bounded device workspace.
+    Bf16Gemm(const Device& device, Bf16GemmShape shape, std::size_t max_workspace_bytes);
+    [[nodiscard]] Bf16GemmShape shape() const noexcept { return shape_; }
+    [[nodiscard]] std::size_t workspace_bytes() const noexcept { return recipe_.workspace_bytes(); }
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& a, DeviceBuffer& w, DeviceBuffer& y);
+    // Binds W at a byte offset inside its (larger) allocation - routed
+    // experts bind their row blocks of the stacked planes this way, so the
+    // weights hold HBM once instead of plane + per-expert copies.
+    [[nodiscard]] Compute launch(Stream& stream, DeviceBuffer& a, DeviceBuffer& w, DeviceBuffer& y,
+                                 std::size_t w_byte_offset);
+private:
+    Bf16GemmShape shape_;
+    Recipe recipe_;
+    std::array<std::uint64_t, 3> tensor_ids_{};
+};
+} // namespace ninfer::gaudi2
diff --git a/src/ops/gaudi2/bf16_gemm_shape.h b/src/ops/gaudi2/bf16_gemm_shape.h
new file mode 100644
index 0000000..c1da6b3
--- /dev/null
+++ b/src/ops/gaudi2/bf16_gemm_shape.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+// One static recipe: row-major A[M,K], W[N,K], Y[M,N] = A * transpose(W).
+// All three tensors store BF16 words. There are no implicit strides/bias/alpha/beta.
+struct Bf16GemmShape {
+    std::size_t m, n, k;
+    void validate() const {
+        for (const auto dimension : {m, n, k})
+            if (!dimension || dimension > static_cast<std::size_t>(std::numeric_limits<std::int32_t>::max()))
+                throw std::invalid_argument("Gaudi2 GEMM dimensions must be positive signed-32-bit extents");
+        (void)a_bytes(); (void)w_bytes(); (void)y_bytes();
+    }
+    [[nodiscard]] std::size_t a_bytes() const { return bytes(m, k); }
+    [[nodiscard]] std::size_t w_bytes() const { return bytes(n, k); }
+    [[nodiscard]] std::size_t y_bytes() const { return bytes(m, n); }
+private:
+    static std::size_t bytes(std::size_t a, std::size_t b) {
+        if (!a || !b || a > std::numeric_limits<std::size_t>::max() / b ||
+            a * b > std::numeric_limits<std::size_t>::max() / 2)
+            throw std::overflow_error("Gaudi2 BF16 GEMM byte size is empty or overflows");
+        return a * b * 2;
+    }
+};
+} // namespace ninfer::gaudi2
diff --git a/src/ops/gaudi2/bf16_gemm_smoke.cpp b/src/ops/gaudi2/bf16_gemm_smoke.cpp
new file mode 100644
index 0000000..a1a318e
--- /dev/null
+++ b/src/ops/gaudi2/bf16_gemm_smoke.cpp
@@ -0,0 +1,42 @@
+#include "bf16_gemm.h"
+
+#include <array>
+#include <bit>
+#include <cstring>
+#include <iostream>
+
+namespace {
+template<std::size_t N> void put(ninfer::gaudi2::PinnedBuffer& buffer, const std::array<float, N>& values) {
+    std::array<std::uint16_t, N> words{};
+    for (std::size_t i = 0; i < N; ++i) {
+        const auto bits = std::bit_cast<std::uint32_t>(values[i]);
+        if (bits & 0xffffu) throw std::logic_error("smoke inputs must be exactly representable BF16");
+        words[i] = static_cast<std::uint16_t>(bits >> 16);
+    }
+    std::memcpy(buffer.bytes().data(), words.data(), sizeof(words));
+}
+}
+int main() {
+    using namespace ninfer::gaudi2;
+    try {
+        Device device; auto stream = device.create_stream();
+        Bf16Gemm gemm(device, {2, 3, 5}, 64u * 1024u * 1024u);
+        auto ah = device.allocate_host(20), wh = device.allocate_host(30), yh = device.allocate_host(12);
+        auto a = device.allocate_device(20), w = device.allocate_device(30), y = device.allocate_device(12);
+        put(ah, std::array<float, 10>{1, 2, 3, 4, 5, -2, .5f, 1, 0, -3});
+        put(wh, std::array<float, 15>{2, -1, 0, 3, 1, -1, 4, 2, 0, -2, .5f, 0, -1, 1, 2});
+        stream.upload(a, ah, ah.size()).wait(); stream.upload(w, wh, wh.size()).wait();
+        auto execution = gemm.launch(stream, a, w, y); execution.wait();
+        stream.download(yh, y, yh.size()).wait();
+        std::array<std::uint16_t, 6> actual{};
+        std::memcpy(actual.data(), yh.bytes().data(), sizeof(actual));
+        // Independent exact golden values: [[17,3,11.5],[-7.5,12,-8]].
+        constexpr std::array<std::uint16_t, 6> expected{0x4188, 0x4040, 0x4138, 0xc0f0, 0x4140, 0xc100};
+        if (actual != expected) {
+            std::cerr << "Gaudi2 native GEMM readback differs from the exact rectangular fixture\n"; return 1;
+        }
+        std::cout << "Gaudi2 native BF16 [2,5] x transpose([3,5]) readback passed; workspace="
+                  << gemm.workspace_bytes() << " bytes\n";
+        return 0;
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
diff --git a/src/ops/gaudi2/block_fp8_linear.cpp b/src/ops/gaudi2/block_fp8_linear.cpp
new file mode 100644
index 0000000..cf562fe
--- /dev/null
+++ b/src/ops/gaudi2/block_fp8_linear.cpp
@@ -0,0 +1,96 @@
+#include "block_fp8_linear.h"
+
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+namespace ninfer::gaudi2 {
+namespace {
+std::size_t multiply(std::size_t a, std::size_t b) {
+    if (!a || !b || b > std::numeric_limits<std::size_t>::max() / a)
+        throw std::overflow_error("block-FP8 linear size overflow");
+    return a * b;
+}
+bool disjoint(std::uintptr_t left_begin, std::uintptr_t left_end,
+             std::uintptr_t right_begin, std::uintptr_t right_end) {
+    return left_begin >= right_end || right_begin >= left_end;
+}
+}
+
+BlockFp8Linear::BlockFp8Linear(const Device& device, std::size_t m, const BlockFp8Matrix& weights,
+                               std::size_t tile_rows, std::size_t max_workspace_bytes)
+    : device_(device), weights_(weights), m_(m), tile_rows_(tile_rows),
+      gemm_(device, Bf16GemmShape{m, tile_rows, weights.columns}, max_workspace_bytes) {
+    if (!m) throw std::invalid_argument("block-FP8 linear needs a positive token count");
+    if (!tile_rows || weights.rows % tile_rows)
+        throw std::invalid_argument("block-FP8 linear tile must divide the weight rows exactly");
+    // Every tile shares one static GEMM recipe, so the staged planes are fixed.
+    a_host_ = device.allocate_host(multiply(m_, weights_.columns) * 2);
+    w_host_ = device.allocate_host(multiply(tile_rows_, weights_.columns) * 2);
+    y_host_ = device.allocate_host(multiply(m_, tile_rows_) * 2);
+    a_device_ = device.allocate_device(a_host_.size());
+    w_device_ = device.allocate_device(w_host_.size());
+    y_device_ = device.allocate_device(y_host_.size());
+    y_result_.resize(multiply(m_, weights_.rows));
+}
+
+std::size_t BlockFp8Linear::device_bytes() const noexcept {
+    return a_device_.size() + w_device_.size() + y_device_.size();
+}
+std::size_t BlockFp8Linear::host_bytes() const noexcept {
+    // Pinned staging plus the output-bounded publish image (same order as y).
+    return a_host_.size() + w_host_.size() + y_host_.size() + y_result_.size() * 2;
+}
+
+void BlockFp8Linear::run(Stream& stream, std::span<const std::uint16_t> a,
+                         std::span<const std::uint8_t> codes, std::span<const float> scales,
+                         std::span<std::uint16_t> y) {
+    if (a.size() != multiply(m_, weights_.columns) || codes.size() != weights_.code_bytes() ||
+        scales.size() * sizeof(float) != weights_.scale_bytes() || y.size() != y_result_.size())
+        throw std::invalid_argument("block-FP8 linear plane length mismatch");
+    const auto y_begin = reinterpret_cast<std::uintptr_t>(y.data());
+    const auto y_end = y_begin + y.size() * sizeof(std::uint16_t);
+    if (!disjoint(y_begin, y_end, reinterpret_cast<std::uintptr_t>(codes.data()),
+                  reinterpret_cast<std::uintptr_t>(codes.data() + codes.size())) ||
+        !disjoint(y_begin, y_end, reinterpret_cast<std::uintptr_t>(scales.data()),
+                  reinterpret_cast<std::uintptr_t>(scales.data() + scales.size())))
+        throw std::invalid_argument("block-FP8 linear output must not overlap its input planes");
+    for (const auto scale : scales)
+        if (!std::isfinite(scale) || scale < 0)
+            throw std::invalid_argument("block-FP8 linear scales must be finite and nonnegative");
+
+    std::memcpy(a_host_.bytes().data(), a.data(), a_host_.size());
+    auto upload_a = stream.upload(a_device_, a_host_, a_host_.size());
+    upload_a.wait();
+
+    const std::size_t scale_columns = weights_.scale_columns();
+    for (std::size_t row = 0; row < weights_.rows; row += tile_rows_) {
+        const BlockFp8Tile tile{weights_, row, 0, tile_rows_, weights_.columns};
+        // decode_block_fp8_tile validates every code and scale of this tile and
+        // leaves the staging plane untouched until all values pass.
+        decode_block_fp8_tile(tile,
+                              std::span<const std::uint8_t>(codes.data() + row * weights_.columns,
+                                                            tile.elements()),
+                              std::span<const float>(scales.data() + (row / 128) * scale_columns,
+                                                     tile.scale_elements()),
+                              std::span<std::uint16_t>(reinterpret_cast<std::uint16_t*>(
+                                                           w_host_.bytes().data()),
+                                                       w_host_.size() / 2));
+        auto upload_w = stream.upload(w_device_, w_host_, w_host_.size());
+        upload_w.wait();
+        auto execution = gemm_.launch(stream, a_device_, w_device_, y_device_);
+        execution.wait();
+        auto download = stream.download(y_host_, y_device_, y_host_.size());
+        download.wait();
+        // Column block [row, row+tile_rows) of every output row: strided gather.
+        const auto staged = reinterpret_cast<const std::uint16_t*>(y_host_.bytes().data());
+        for (std::size_t token = 0; token < m_; ++token)
+            std::memcpy(y_result_.data() + token * weights_.rows + row,
+                        staged + token * tile_rows_, tile_rows_ * sizeof(std::uint16_t));
+    }
+    std::memcpy(y.data(), y_result_.data(), y_result_.size() * sizeof(std::uint16_t));
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/ops/gaudi2/block_fp8_linear.h b/src/ops/gaudi2/block_fp8_linear.h
new file mode 100644
index 0000000..3145b21
--- /dev/null
+++ b/src/ops/gaudi2/block_fp8_linear.h
@@ -0,0 +1,48 @@
+#pragma once
+#include "core/gaudi2/runtime.h"
+#include "core/gaudi2/block_fp8.h"
+#include "bf16_gemm.h"
+
+#include <cstddef>
+#include <span>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+// One W8A16 linear against an official 128x128 block-FP8 checkpoint plane:
+// Y[M,N] = A[M,K] * dequant(W[N,K])^T with A/Y in BF16 words.
+//
+// The weight plane never exists as BF16 anywhere. Per row tile of tile_rows
+// weights, the exact block decoder fills one pinned BF16 staging tile, one DMA
+// uploads it and one closed BF16 GEMM (full K, so no cross-tile accumulation
+// rounding) consumes it. Original block scales are preserved; this is NOT an
+// FP8-MME/W8A8 execution and never re-encodes Gaudi2's native FP8 range.
+class BlockFp8Linear {
+public:
+    BlockFp8Linear(const Device& device, std::size_t m, const BlockFp8Matrix& weights,
+                   std::size_t tile_rows, std::size_t max_workspace_bytes);
+    [[nodiscard]] std::size_t rows() const noexcept { return weights_.rows; }
+    [[nodiscard]] std::size_t columns() const noexcept { return weights_.columns; }
+    [[nodiscard]] std::size_t tile_rows() const noexcept { return tile_rows_; }
+    // Fixed per-instance footprint: activation upload + weight tile + output tile
+    // on both host and device, independent of N; host_bytes additionally counts
+    // the output-bounded publish image (same order as y itself).
+    [[nodiscard]] std::size_t device_bytes() const noexcept;
+    [[nodiscard]] std::size_t host_bytes() const noexcept;
+
+    // a is [m,k] row-major BF16 words, codes the full [n,k] plane, scales the
+    // full block-scale plane; y is [m,n] row-major and is published only after
+    // every tile validated and completed. Any throw leaves y untouched.
+    void run(Stream& stream, std::span<const std::uint16_t> a, std::span<const std::uint8_t> codes,
+             std::span<const float> scales, std::span<std::uint16_t> y);
+private:
+    Device device_;
+    BlockFp8Matrix weights_;
+    std::size_t m_, tile_rows_;
+    Bf16Gemm gemm_;
+    PinnedBuffer a_host_, w_host_, y_host_;
+    DeviceBuffer a_device_, w_device_, y_device_;
+    std::vector<std::uint16_t> y_result_;
+};
+
+} // namespace ninfer::gaudi2
diff --git a/src/ops/glm5_dsa/glm5_dsa.cu b/src/ops/glm5_dsa/glm5_dsa.cu
new file mode 100644
index 0000000..31a46a6
--- /dev/null
+++ b/src/ops/glm5_dsa/glm5_dsa.cu
@@ -0,0 +1,220 @@
+// ninfer::ops - GLM-5.3-Flash DSA launchers (decode path).
+#include "ninfer/ops/glm5_dsa.h"
+
+#include "ops/kernel/glm5_dsa.cuh"
+#include "core/device.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::ops {
+
+namespace {
+
+void require_contiguous(const Tensor& tensor, const char* what) {
+    if (!tensor.is_contiguous()) { throw std::invalid_argument(std::string(what) + " must be contiguous"); }
+}
+
+void require_shape(const Tensor& tensor, DType dtype, std::initializer_list<std::int32_t> shape,
+                   const char* what) {
+    require_contiguous(tensor, what);
+    if (tensor.dtype != dtype) {
+        throw std::invalid_argument(std::string(what) + " has the wrong dtype");
+    }
+    int index = 0;
+    for (const auto extent : shape) {
+        if (tensor.ne[index] != extent) {
+            throw std::invalid_argument(std::string(what) + " has the wrong shape");
+        }
+        ++index;
+    }
+}
+
+void require_disjoint(const Tensor& a, const Tensor& b) {
+    const auto a_begin = reinterpret_cast<std::uintptr_t>(a.data);
+    const auto b_begin = reinterpret_cast<std::uintptr_t>(b.data);
+    const auto a_end = a_begin + a.bytes();
+    const auto b_end = b_begin + b.bytes();
+    if (a_begin < b_end && b_begin < a_end) {
+        throw std::invalid_argument("glm5_dsa operands must not overlap");
+    }
+}
+
+std::int32_t dim0(const Tensor& tensor) { return tensor.ne[0]; }
+std::int32_t dim1(const Tensor& tensor) { return tensor.ne[1]; }
+std::int32_t dim2(const Tensor& tensor) { return tensor.ne[2]; }
+
+} // namespace
+
+void glm5_dsa_pool(const Tensor& ik, const Tensor& ig, const Tensor& ape, Tensor& pooled,
+                   cudaStream_t stream) {
+    const std::int32_t tokens = dim0(ik);
+    const std::int32_t dim = dim1(ik);
+    const std::int32_t kpool = dim0(ape);
+    if (tokens <= 0 || dim <= 0 || kpool < 2 || kpool > 8 || tokens % kpool != 0) {
+        throw std::invalid_argument("glm5_dsa_pool: ik [T,D] must be a positive kpool multiple");
+    }
+    const std::int32_t pools = tokens / kpool;
+    require_shape(ik, DType::BF16, {tokens, dim}, "glm5_dsa_pool: ik");
+    require_shape(ig, DType::BF16, {tokens, dim}, "glm5_dsa_pool: ig");
+    require_shape(ape, DType::FP32, {kpool, dim}, "glm5_dsa_pool: ape");
+    require_shape(pooled, DType::FP32, {pools, dim}, "glm5_dsa_pool: pooled");
+    require_disjoint(ik, pooled); require_disjoint(ig, pooled);
+
+    const std::int64_t elements = static_cast<std::int64_t>(pools) * dim;
+    const auto blocks = static_cast<unsigned int>(
+        (elements + glm5_dsa_detail::kThreads - 1) / glm5_dsa_detail::kThreads);
+    glm5_dsa_detail::pool_kernel<<<blocks, glm5_dsa_detail::kThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(ik.data), static_cast<const __nv_bfloat16*>(ig.data),
+        static_cast<const float*>(ape.data), dim, kpool, pools,
+        static_cast<float*>(pooled.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_dsa_score(const Tensor& iq, const Tensor& pooled, const Tensor& weights, Tensor& score,
+                    cudaStream_t stream) {
+    const std::int32_t heads = dim0(iq);
+    const std::int32_t dim = dim1(iq);
+    const std::int32_t pools = dim0(pooled);
+    if (heads <= 0 || dim <= 0 || pools <= 0) {
+        throw std::invalid_argument("glm5_dsa_score: bad geometry");
+    }
+    require_shape(iq, DType::BF16, {heads, dim}, "glm5_dsa_score: iq");
+    require_shape(pooled, DType::FP32, {pools, dim}, "glm5_dsa_score: pooled");
+    require_shape(weights, DType::FP32, {heads}, "glm5_dsa_score: weights");
+    require_shape(score, DType::FP32, {pools}, "glm5_dsa_score: score");
+    require_disjoint(iq, score); require_disjoint(pooled, score);
+
+    const auto blocks = static_cast<unsigned int>(
+        (pools + glm5_dsa_detail::kThreads - 1) / glm5_dsa_detail::kThreads);
+    glm5_dsa_detail::score_kernel<<<blocks, glm5_dsa_detail::kThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(iq.data), static_cast<const float*>(pooled.data),
+        static_cast<const float*>(weights.data), dim, heads, pools,
+        static_cast<float*>(score.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_dsa_select(const Tensor& score, std::uint32_t position, std::int32_t top_pools,
+                     bool select_tail, Tensor& cells, cudaStream_t stream) {
+    const std::int32_t pools = dim0(score);
+    const std::int32_t kpool = 4;
+    const std::int32_t width =
+        top_pools * kpool + (select_tail ? kpool - 1 : 0);
+    if (top_pools <= 0) {
+        throw std::invalid_argument("glm5_dsa_select: top_pools must be positive");
+    }
+    if ((position + 1) / kpool > static_cast<std::uint32_t>(pools)) {
+        throw std::invalid_argument("glm5_dsa_select: position sees more pools than were scored");
+    }
+    require_shape(score, DType::FP32, {pools}, "glm5_dsa_select: score");
+    require_shape(cells, DType::I32, {width}, "glm5_dsa_select: cells");
+    require_disjoint(score, cells);
+
+    const std::size_t shared = sizeof(float) * static_cast<std::size_t>(pools);
+    if (shared > 48u * 1024u) {
+        throw std::invalid_argument("glm5_dsa_select: pool count exceeds static shared memory");
+    }
+    glm5_dsa_detail::select_kernel<<<1, glm5_dsa_detail::kThreads, shared, stream>>>(
+        static_cast<const float*>(score.data), pools, position, kpool, top_pools,
+        select_tail ? 1 : 0, width, static_cast<std::int32_t*>(cells.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_dsa_attention(const Tensor& q_abs, const Tensor& latents, const Tensor& cells,
+                        const Tensor& wv_b, Tensor& out, std::int32_t qk_nope,
+                        cudaStream_t stream) {
+    const std::int32_t heads = dim0(q_abs);
+    const std::int32_t lora = dim1(q_abs);
+    const std::int32_t cache = dim0(latents);
+    const std::int32_t width = dim0(cells);
+    const std::int32_t v_head = dim1(wv_b);
+    if (heads <= 0 || lora <= 0 || cache <= 0 || width <= 0 || qk_nope <= 0 || v_head <= 0 ||
+        dim0(wv_b) != lora || dim2(wv_b) != heads) {
+        throw std::invalid_argument("glm5_dsa_attention: bad geometry");
+    }
+    require_shape(q_abs, DType::BF16, {heads, lora}, "glm5_dsa_attention: q_abs");
+    require_shape(latents, DType::BF16, {cache, lora}, "glm5_dsa_attention: latents");
+    require_shape(cells, DType::I32, {width}, "glm5_dsa_attention: cells");
+    require_shape(wv_b, DType::BF16, {lora, v_head, heads}, "glm5_dsa_attention: wv_b");
+    require_shape(out, DType::BF16, {heads * v_head}, "glm5_dsa_attention: out");
+    require_disjoint(q_abs, out); require_disjoint(latents, out); require_disjoint(wv_b, out);
+
+    const std::size_t shared =
+        sizeof(float) * (static_cast<std::size_t>(width) + static_cast<std::size_t>(lora) + 1);
+    if (shared > 96u * 1024u) {
+        throw std::invalid_argument("glm5_dsa_attention: selection width exceeds shared memory");
+    }
+    glm5_dsa_detail::attention_kernel<<<static_cast<unsigned int>(heads),
+                                        glm5_dsa_detail::kThreads, shared, stream>>>(
+        static_cast<const __nv_bfloat16*>(q_abs.data),
+        static_cast<const __nv_bfloat16*>(latents.data),
+        static_cast<const std::int32_t*>(cells.data),
+        static_cast<const __nv_bfloat16*>(wv_b.data), width, lora, v_head, qk_nope,
+        static_cast<__nv_bfloat16*>(out.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_dsa_absorb(const Tensor& q, const Tensor& wk_b, Tensor& q_abs, cudaStream_t stream) {
+    const std::int32_t heads = dim0(q);
+    const std::int32_t nope = dim1(q);
+    const std::int32_t lora = dim1(wk_b);
+    if (heads <= 0 || nope <= 0 || lora <= 0 || dim0(wk_b) != nope || dim2(wk_b) != heads) {
+        throw std::invalid_argument("glm5_dsa_absorb: q [H,nope] and wk_b {nope,lora,heads} disagree");
+    }
+    require_shape(q, DType::BF16, {heads, nope}, "glm5_dsa_absorb: q");
+    require_shape(wk_b, DType::BF16, {nope, lora, heads}, "glm5_dsa_absorb: wk_b");
+    require_shape(q_abs, DType::FP32, {heads, lora}, "glm5_dsa_absorb: q_abs");
+    require_disjoint(q, q_abs); require_disjoint(wk_b, q_abs);
+
+    const std::int64_t elements = static_cast<std::int64_t>(heads) * lora;
+    const auto blocks = static_cast<unsigned int>(
+        (elements + glm5_dsa_detail::kThreads - 1) / glm5_dsa_detail::kThreads);
+    glm5_dsa_detail::absorb_kernel<<<blocks, glm5_dsa_detail::kThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data), static_cast<const __nv_bfloat16*>(wk_b.data),
+        nope, lora, heads, static_cast<float*>(q_abs.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_dsa_absorb_batch(const Tensor& q, const Tensor& wk_b, Tensor& q_abs,
+                           cudaStream_t stream) {
+    const std::int32_t heads = dim0(q);
+    const std::int32_t nope = dim1(q);
+    const std::int32_t lora = dim1(wk_b);
+    const std::int32_t tokens = dim2(q);
+    if (heads <= 0 || nope <= 0 || lora <= 0 || tokens <= 0 ||
+        dim0(wk_b) != nope || dim2(wk_b) != heads) {
+        throw std::invalid_argument(
+            "glm5_dsa_absorb_batch: q [H,nope,T] and wk_b {nope,lora,heads} disagree");
+    }
+    require_shape(q, DType::BF16, {heads, nope, tokens}, "glm5_dsa_absorb_batch: q");
+    require_shape(wk_b, DType::BF16, {nope, lora, heads}, "glm5_dsa_absorb_batch: wk_b");
+    require_shape(q_abs, DType::FP32, {heads, lora, tokens}, "glm5_dsa_absorb_batch: q_abs");
+    require_disjoint(q, q_abs);
+    require_disjoint(wk_b, q_abs);
+
+    const std::int64_t elements = static_cast<std::int64_t>(heads) * lora * tokens;
+    const auto blocks = static_cast<unsigned int>(
+        (elements + glm5_dsa_detail::kThreads - 1) / glm5_dsa_detail::kThreads);
+    glm5_dsa_detail::absorb_batch_kernel<<<blocks, glm5_dsa_detail::kThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data), static_cast<const __nv_bfloat16*>(wk_b.data),
+        nope, lora, heads, tokens, static_cast<float*>(q_abs.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_dsa_scale(const Tensor& values, float factor, Tensor& out, cudaStream_t stream) {
+    if (values.ne[0] <= 0 || out.ne[0] != values.ne[0]) {
+        throw std::invalid_argument("glm5_dsa_scale: same-shape FP32 planes required");
+    }
+    require_shape(values, DType::FP32, {dim0(values)}, "glm5_dsa_scale: values");
+    require_shape(out, DType::FP32, {dim0(values)}, "glm5_dsa_scale: out");
+    require_disjoint(values, out);
+    const auto blocks = static_cast<unsigned int>(
+        (values.ne[0] + glm5_dsa_detail::kThreads - 1) / glm5_dsa_detail::kThreads);
+    glm5_dsa_detail::scale_kernel<<<blocks, glm5_dsa_detail::kThreads, 0, stream>>>(
+        static_cast<const float*>(values.data), factor, values.ne[0],
+        static_cast<float*>(out.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
