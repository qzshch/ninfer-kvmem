+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_qc)), qc),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_kc)), kc),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_vc)), vc),
+                    worst_of(download<float>(d_dbg_gate), gate_log),
+                    worst_of(download<float>(d_dbg_beta), beta_f),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_gpre)), fb),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_blog)), beta_raw),
