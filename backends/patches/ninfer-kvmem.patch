diff --git a/src/ops/kernel/glm5_dsa.cuh b/src/ops/kernel/glm5_dsa.cuh
new file mode 100644
index 0000000..a32fc64
--- /dev/null
+++ b/src/ops/kernel/glm5_dsa.cuh
@@ -0,0 +1,268 @@
+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash DSA kernels: per-element pool compression, ReLU head scoring,
+// ranked selection with the incomplete tail, and the absorbed sparse attention. Math follows
+// models/glm5/reference/dsa_reference (audited semantics: per-key-dim softmax, rank ties by
+// lower pool index, -1 slots excluded from softmax and context, 256^-0.5 model constant).
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_dsa_detail {
+
+constexpr int kThreads = 256;
+constexpr float kNegInf = -3.0e38f;
+
+__global__ void pool_kernel(const __nv_bfloat16* __restrict__ ik, const __nv_bfloat16* __restrict__ ig,
+                            const float* __restrict__ ape, std::int32_t dim, std::int32_t kpool,
+                            std::int32_t pools, float* __restrict__ pooled) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t p = static_cast<std::int32_t>(index / dim);
+    const std::int32_t e = static_cast<std::int32_t>(index % dim);
+    if (p >= pools) { return; }
+    float logits[8], exps[8], maximum = 0.0f;
+    for (std::int32_t m = 0; m < kpool; ++m) {
+        logits[m] = __bfloat162float(ig[static_cast<std::int64_t>(p * kpool + m) * dim + e]) +
+                    ape[m * dim + e];
+        if (m == 0 || logits[m] > maximum) { maximum = logits[m]; }
+    }
+    float denominator = 0.0f;
+    for (std::int32_t m = 0; m < kpool; ++m) {
+        exps[m] = expf(logits[m] - maximum);
+        denominator += exps[m];
+    }
+    const float inverse = 1.0f / denominator;
+    float acc = 0.0f;
+    for (std::int32_t m = 0; m < kpool; ++m) {
+        acc = fmaf(exps[m] * inverse, __bfloat162float(ik[static_cast<std::int64_t>(p * kpool + m) * dim + e]), acc);
+    }
+    pooled[index] = acc;
+}
+
+// One thread per (pool); every head's ReLU dot walks the key dim.
+__global__ void score_kernel(const __nv_bfloat16* __restrict__ iq, const float* __restrict__ pooled,
+                             const float* __restrict__ weights, std::int32_t dim,
+                             std::int32_t heads, std::int32_t pools, float* __restrict__ score) {
+    const std::int32_t p = static_cast<std::int32_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (p >= pools) { return; }
+    const float* key = pooled + static_cast<std::int64_t>(p) * dim;
+    float acc = 0.0f;
+    for (std::int32_t h = 0; h < heads; ++h) {
+        const __nv_bfloat16* q = iq + static_cast<std::int64_t>(h) * dim;
+        float dot = 0.0f;
+        for (std::int32_t e = 0; e < dim; ++e) {
+            dot = fmaf(__bfloat162float(q[e]), key[e], dot);
+        }
+        acc = fmaf(fmaxf(dot, 0.0f), weights[h], acc);
+    }
+    score[p] = acc;
+}
+
+// One block: iterative block argmax over the visible pools, min(top_pools, n_vis) rounds.
+// Ties break by lower pool index because the scan keeps the first strict maximum.
+__global__ void select_kernel(const float* __restrict__ score, std::int32_t pools,
+                              std::uint32_t position, std::int32_t kpool, std::int32_t top_pools,
+                              std::int32_t select_tail, std::int32_t width, std::int32_t* __restrict__ cells) {
+    extern __shared__ float s_score[];   // [pools]
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const std::int32_t visible = static_cast<std::int32_t>((position + 1) / kpool);
+    const std::int32_t n_vis = min(visible, pools);
+    for (std::int32_t p = tid; p < pools; p += blockDim.x) {
+        s_score[p] = p < n_vis ? score[p] : kNegInf;
+    }
+    __syncthreads();
+    for (std::int32_t s = tid; s < width; s += blockDim.x) { cells[s] = -1; }
+    __syncthreads();
+
+    const std::int32_t picks = min(top_pools, n_vis);
+    for (std::int32_t rank = 0; rank < picks; ++rank) {
+        // Block argmax: each thread scans its stride, stage the winning (value, index).
+        float best_value = kNegInf;
+        std::int32_t best_index = 0;
+        for (std::int32_t p = tid; p < n_vis; p += blockDim.x) {
+            if (s_score[p] > best_value) {
+                best_value = s_score[p];
+                best_index = p;
+            }
+        }
+        // Reduce through shared memory: lanes stage then thread 0 folds. Values are finite
+        // scores or kNegInf for already-picked entries, so a plain max keeps determinism;
+        // equal values resolve to the SMALLER index by construction below.
+        __shared__ float s_val[kThreads];
+        __shared__ std::int32_t s_idx[kThreads];
+        s_val[tid] = best_value;
+        s_idx[tid] = best_index;
+        __syncthreads();
+        if (tid == 0) {
+            float value = kNegInf;
+            std::int32_t index = 0x7fffffff;
+            for (std::int32_t i = 0; i < blockDim.x; ++i) {
+                if (s_val[i] > value || (s_val[i] == value && s_idx[i] < index)) {
+                    value = s_val[i];
+                    index = s_idx[i];
+                }
+            }
+            // Smaller index wins ties: replace the winner's score so the next round moves on.
+            s_val[0] = value;
+            s_idx[0] = index;
+        }
+        __syncthreads();
+        const std::int32_t winner = s_idx[0];
+        __syncthreads();
+        if (tid == 0) { s_score[winner] = kNegInf; }
+        for (std::int32_t m = tid; m < kpool; m += blockDim.x) {
+            cells[rank * kpool + m] = winner * kpool + m;
+        }
+        __syncthreads();
+    }
+    if (select_tail) {
+        const std::int32_t tail_base = top_pools * kpool;
+        for (std::int32_t m = tid; m + 1 < kpool; m += blockDim.x) {
+            const std::int32_t cell = n_vis * kpool + m;
+            cells[tail_base + m] = cell <= static_cast<std::int32_t>(position) ? cell : -1;
+        }
+    }
+}
+
+// One block per head: scores over the selection row, softmax excluding -1, context
+// accumulation in shared memory, then the absorbed W_V_B per head.
+__global__ void attention_kernel(const __nv_bfloat16* __restrict__ q_abs,
+                                 const __nv_bfloat16* __restrict__ latents,
+                                 const std::int32_t* __restrict__ cells,
+                                 const __nv_bfloat16* __restrict__ wv_b, std::int32_t width,
+                                 std::int32_t lora, std::int32_t v_head, std::int32_t qk_nope,
+                                 __nv_bfloat16* __restrict__ out) {
+    const std::int32_t h = static_cast<std::int32_t>(blockIdx.x);
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const __nv_bfloat16* q = q_abs + static_cast<std::int64_t>(h) * lora;
+    const float scale = rsqrtf(static_cast<float>(qk_nope));
+
+    extern __shared__ float s_prob[];   // [width]
+    float* s_ctx = s_prob + width;      // [lora]
+    __shared__ float s_fold[kThreads];
+
+    bool any = false;
+    float maximum = 0.0f;
+    for (std::int32_t s = tid; s < width; s += kThreads) {
+        const std::int32_t cell = cells[s];
+        if (cell < 0) { s_prob[s] = kNegInf; continue; }
+        const __nv_bfloat16* latent = latents + static_cast<std::int64_t>(cell) * lora;
+        float dot = 0.0f;
+        for (std::int32_t e = 0; e < lora; ++e) {
+            dot = fmaf(__bfloat162float(q[e]), __bfloat162float(latent[e]), dot);
+        }
+        const float value = dot * scale;
+        s_prob[s] = value;
+        if (!any || value > maximum) { maximum = value; any = true; }
+    }
+    __syncthreads();
+    s_fold[tid] = any ? maximum : kNegInf;
+    __syncthreads();
+    if (tid == 0) {
+        float value = kNegInf;
+        for (std::int32_t i = 0; i < kThreads; ++i) { value = fmaxf(value, s_fold[i]); }
+        s_prob[width + lora] = value;   // park the max past the context plane
+    }
+    __syncthreads();
+    const float top = s_prob[width + lora];
+
+    float part = 0.0f;
+    for (std::int32_t s = tid; s < width; s += kThreads) {
+        if (cells[s] < 0) { continue; }
+        const float value = expf(s_prob[s] - top);
+        s_prob[s] = value;
+        part += value;
+    }
+    __syncthreads();
+    s_fold[tid] = part;
+    __syncthreads();
+    if (tid == 0) {
+        float value = 0.0f;
+        for (std::int32_t i = 0; i < kThreads; ++i) { value += s_fold[i]; }
+        s_prob[width + lora] = value > 0.0f ? value : 1.0f;
+    }
+    __syncthreads();
+    const float inverse = 1.0f / s_prob[width + lora];
+
+    // ctx[e] = sum over valid slots of prob_s * latent[s][e].
+    for (std::int32_t e = tid; e < lora; e += kThreads) {
+        float acc = 0.0f;
+        for (std::int32_t s = 0; s < width; ++s) {
+            if (cells[s] < 0) { continue; }
+            acc = fmaf(s_prob[s] * inverse,
+                       __bfloat162float(latents[static_cast<std::int64_t>(cells[s]) * lora + e]),
+                       acc);
+        }
+        s_ctx[e] = acc;
+    }
+    __syncthreads();
+
+    // out[h, v] = sum_c wv_b[c + lora*v + lora*v_head*h] * ctx[c].
+    const __nv_bfloat16* column = wv_b + static_cast<std::int64_t>(lora) * v_head * h;
+    for (std::int32_t v = tid; v < v_head; v += kThreads) {
+        const __nv_bfloat16* weights = column + static_cast<std::int64_t>(lora) * v;
+        float acc = 0.0f;
+        for (std::int32_t c = 0; c < lora; ++c) {
+            acc = fmaf(__bfloat162float(weights[c]), s_ctx[c], acc);
+        }
+        out[static_cast<std::int64_t>(h) * v_head + v] = __float2bfloat16(acc);
+    }
+}
+
+
+// q_abs[h, e] = sum_d q[h, d] * wk_b[d + nope*e + nope*lora*h]: absorb W_K_B into the query.
+// GGUF wk_b is {nope, lora, heads} (ne0 = the nope input dim fastest).
+__global__ void absorb_kernel(const __nv_bfloat16* __restrict__ q,
+                              const __nv_bfloat16* __restrict__ wk_b, std::int32_t nope,
+                              std::int32_t lora, std::int32_t heads, float* __restrict__ q_abs) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t h = static_cast<std::int32_t>(index / lora);
+    const std::int32_t e = static_cast<std::int32_t>(index % lora);
+    if (h >= heads) { return; }
+    const __nv_bfloat16* head_w = wk_b + static_cast<std::int64_t>(nope) * lora * h;
+    float acc = 0.0f;
+    for (std::int32_t d = 0; d < nope; ++d) {
+        acc = fmaf(__bfloat162float(q[static_cast<std::int64_t>(h) * nope + d]),
+                   __bfloat162float(head_w[static_cast<std::int64_t>(d) + static_cast<std::int64_t>(nope) * e]),
+                   acc);
+    }
+    q_abs[index] = acc;
+}
+
+// Batched query absorption over T tokens: q is the [H, nope, T] linear output
+// (FCD H*nope), q_abs FP32 [H, lora, T].
+__global__ void absorb_batch_kernel(const __nv_bfloat16* __restrict__ q,
+                                    const __nv_bfloat16* __restrict__ wk_b,
+                                    std::int32_t nope, std::int32_t lora, std::int32_t heads,
+                                    std::int32_t tokens, float* __restrict__ q_abs) {
+    const std::int64_t plane = static_cast<std::int64_t>(heads) * lora;
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= plane * tokens) { return; }
+    const std::int32_t t = static_cast<std::int32_t>(index / plane);
+    const std::int64_t flat = index % plane;
+    const std::int32_t h = static_cast<std::int32_t>(flat / lora);
+    const std::int32_t e = static_cast<std::int32_t>(flat % lora);
+    const __nv_bfloat16* head_w = wk_b + static_cast<std::int64_t>(nope) * lora * h;
+    const __nv_bfloat16* q_t = q + static_cast<std::int64_t>(t) * heads * nope;
+    float acc = 0.0f;
+    for (std::int32_t d = 0; d < nope; ++d) {
+        acc = fmaf(__bfloat162float(q_t[static_cast<std::int64_t>(h) * nope + d]),
+                   __bfloat162float(head_w[static_cast<std::int64_t>(d) +
+                                       static_cast<std::int64_t>(nope) * e]),
+                   acc);
+    }
+    q_abs[static_cast<std::int64_t>(t) * plane + flat] = acc;
+}
+
+// out = values * factor over a plane.
+__global__ void scale_kernel(const float* __restrict__ values, float factor,
+                             std::int64_t elements, float* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    out[index] = values[index] * factor;
+}
+
+} // namespace glm5_dsa_detail
+} // namespace ninfer::ops
diff --git a/src/ops/kernel/glm5_kda.cuh b/src/ops/kernel/glm5_kda.cuh
new file mode 100644
index 0000000..bb70fb2
--- /dev/null
+++ b/src/ops/kernel/glm5_kda.cuh
@@ -0,0 +1,286 @@
+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash KDA kernels: safe-path gating, the causal short conv with SiLU,
+// and the single-token recurrent decode step. All arithmetic FP32; inputs are BF16 where the
+// engine's tensor flow carries them. The math follows models/glm5/reference (the audited GLM-5.3
+// semantics cross-checked against FLA, llama.cpp and Maya). This is the decode path: clarity
+// over throughput, one token at a time.
+
+#include "ops/common/warp.cuh"
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_kda_detail {
+
+constexpr int kDecodeBlock = 256;   // one head per block, dk <= 256
+constexpr int kElementThreads = 256;
+
+__device__ __forceinline__ float sigmoid_f(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+// gate[t, c] = lower_bound * sigmoid(exp(A_log[c / dk]) * a[t, c]) over the [d_inner, T] plane.
+__global__ void decay_gate_kernel(const __nv_bfloat16* __restrict__ a,
+                                  const float* __restrict__ a_log, float lower_bound,
+                                  std::int32_t d_inner, std::int32_t dk, std::int64_t elements,
+                                  float* __restrict__ gate) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    const std::int32_t channel = static_cast<std::int32_t>(index % d_inner);
+    const float rate = expf(a_log[channel / dk]);
+    gate[index] = lower_bound * sigmoid_f(rate * __bfloat162float(a[index]));
+}
+
+__global__ void beta_kernel(const __nv_bfloat16* __restrict__ b, std::int64_t elements,
+                            float* __restrict__ beta) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    beta[index] = sigmoid_f(__bfloat162float(b[index]));
+}
+
+// out[t, c] = silu(sum_tap w[c*K + tap] * window(t - (K-1) + tap, c)); one thread per (t, c).
+__global__ void conv_kernel(const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ w,
+                            const float* __restrict__ conv_state, std::int32_t d_inner,
+                            std::int32_t taps, std::int32_t tokens,
+                            __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t channel = static_cast<std::int32_t>(index % d_inner);
+    const std::int32_t t = static_cast<std::int32_t>(index / d_inner);
+    if (t >= tokens) { return; }
+    const std::int32_t history = taps - 1;
+    float acc = 0.0f;
+    for (std::int32_t tap = 0; tap < taps; ++tap) {
+        const std::int64_t s = static_cast<std::int64_t>(t) - history + tap;
+        const float sample = s >= 0 ? __bfloat162float(x[s * d_inner + channel])
+                                    : conv_state[(s + history) * d_inner + channel];
+        acc = fmaf(__bfloat162float(w[channel * taps + tap]), sample, acc);
+    }
+    out[index] = __float2bfloat16(acc * sigmoid_f(acc));
+}
+
+// conv_state := last `taps-1` columns of [conv_state | x]; staged per channel so overlapping
+// reads never see partially updated rows (T shorter than the history still reaches back).
+__global__ void conv_slide_kernel(const __nv_bfloat16* __restrict__ x,
+                                  const float* __restrict__ conv_state, std::int32_t d_inner,
+                                  std::int32_t taps, std::int32_t tokens,
+                                  float* __restrict__ state_out) {
+    const std::int32_t channel = static_cast<std::int32_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (channel >= d_inner) { return; }
+    const std::int32_t history = taps - 1;
+    float staged[8];
+    for (std::int32_t j = 0; j < history; ++j) {
+        const std::int64_t s = static_cast<std::int64_t>(tokens) - history + j;
+        staged[j] = s >= 0 ? __bfloat162float(x[s * d_inner + channel])
+                           : conv_state[(s + history) * d_inner + channel];
+    }
+    for (std::int32_t j = 0; j < history; ++j) { state_out[j * d_inner + channel] = staged[j]; }
+}
+
+// One head per block; the head slice never leaves registers/shared memory. Reductions stage
+// through shared memory and reduce on one thread: the decode path is one token, correctness
+// and clarity over latency.
+__global__ void decode_step_kernel(const __nv_bfloat16* __restrict__ q,
+                                   const __nv_bfloat16* __restrict__ k,
+                                   const __nv_bfloat16* __restrict__ v,
+                                   const float* __restrict__ gate, const float* __restrict__ beta,
+                                   const __nv_bfloat16* __restrict__ g2,
+                                   const float* __restrict__ o_norm_w, float* __restrict__ state,
+                                   __nv_bfloat16* __restrict__ out, std::int32_t dk) {
+    const std::int32_t h = static_cast<std::int32_t>(blockIdx.x);
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const bool live = tid < dk;
+    const std::int64_t base = static_cast<std::int64_t>(h) * dk;
+
+    __shared__ float s_stage[kDecodeBlock];
+    __shared__ float s_qh[kDecodeBlock], s_kh[kDecodeBlock];
+    __shared__ float s_u[kDecodeBlock], s_delta[kDecodeBlock], s_o[kDecodeBlock];
+    __shared__ float s_scalar;
+
+    const float qv = live ? __bfloat162float(q[base + tid]) : 0.0f;
+    const float kv = live ? __bfloat162float(k[base + tid]) : 0.0f;
+    s_stage[tid] = qv * qv;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 1e-6f;   // eps inside the sqrt, matching the host reference accumulation
+        for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+        s_scalar = rsqrtf(acc);
+    }
+    __syncthreads();
+    const float q_inv = s_scalar * rsqrtf(static_cast<float>(dk));   // dk^-0.5 folded in
+
+    s_stage[tid] = kv * kv;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 1e-6f;
+        for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+        s_scalar = rsqrtf(acc);
+    }
+    __syncthreads();
+
+    if (live) {
+        s_qh[tid] = qv * q_inv;
+        s_kh[tid] = kv * s_scalar;
+    }
+    __syncthreads();
+
+    float* S = state + static_cast<std::int64_t>(h) * dk * dk;   // row = key axis
+    if (live) {
+        const float decay = expf(gate[base + tid]);
+        for (std::int32_t j = 0; j < dk; ++j) {
+            S[static_cast<std::int64_t>(tid) * dk + j] *= decay;
+        }
+    }
+    __syncthreads();
+
+    if (live) {
+        float u = 0.0f;
+        for (std::int32_t i = 0; i < dk; ++i) {
+            u = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_kh[i], u);
+        }
+        s_u[tid] = u;
+    }
+    __syncthreads();
+    if (live) { s_delta[tid] = beta[h] * (__bfloat162float(v[base + tid]) - s_u[tid]); }
+    __syncthreads();
+    if (live) {
+        for (std::int32_t j = 0; j < dk; ++j) {
+            float& cell = S[static_cast<std::int64_t>(tid) * dk + j];
+            cell = fmaf(s_kh[tid], s_delta[j], cell);
+        }
+    }
+    __syncthreads();
+
+    if (live) {
+        float o = 0.0f;
+        for (std::int32_t i = 0; i < dk; ++i) {
+            o = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_qh[i], o);
+        }
+        s_o[tid] = o;
+    }
+    __syncthreads();
+
+    s_stage[tid] = live ? s_o[tid] * s_o[tid] : 0.0f;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 0.0f;
+        for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+        s_scalar = rsqrtf(acc / static_cast<float>(dk) + 1e-6f);
+    }
+    __syncthreads();
+    if (live) {
+        out[base + tid] = __float2bfloat16(
+            s_o[tid] * s_scalar * o_norm_w[tid] * sigmoid_f(__bfloat162float(g2[base + tid])));
+    }
+}
+
+
+
+// T tokens in a loop over the decode-step phases; the head slice stays in shared memory
+// across tokens so only the state matrix itself moves through global memory. The token
+// plane is [T, d_inner] row-major (head h at h*dk), matching the conv output layout.
+__global__ void prefill_kernel(const __nv_bfloat16* __restrict__ q,
+                               const __nv_bfloat16* __restrict__ k,
+                               const __nv_bfloat16* __restrict__ v,
+                               const float* __restrict__ gate, const float* __restrict__ beta,
+                               const __nv_bfloat16* __restrict__ g2,
+                               const float* __restrict__ o_norm_w, float* __restrict__ state,
+                               __nv_bfloat16* __restrict__ out, std::int32_t dk,
+                               std::int32_t d_inner, std::int32_t heads, std::int32_t tokens) {
+    const std::int32_t h = static_cast<std::int32_t>(blockIdx.x);
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const bool live = tid < dk;
+    const std::int64_t base = static_cast<std::int64_t>(h) * dk;
+    float* S = state + static_cast<std::int64_t>(h) * dk * dk;
+
+    __shared__ float s_stage[kDecodeBlock];
+    __shared__ float s_qh[kDecodeBlock], s_kh[kDecodeBlock];
+    __shared__ float s_u[kDecodeBlock], s_delta[kDecodeBlock], s_o[kDecodeBlock];
+    __shared__ float s_scalar;
+
+    for (std::int32_t t = 0; t < tokens; ++t) {
+        const std::int64_t offset = static_cast<std::int64_t>(t) * d_inner;
+        const __nv_bfloat16* qt = q + offset + base;
+        const __nv_bfloat16* kt = k + offset + base;
+        const __nv_bfloat16* vt = v + offset + base;
+        const float* gt = gate + offset + base;
+        const __nv_bfloat16* g2t = g2 + offset + base;
+
+        const float qv = live ? __bfloat162float(qt[tid]) : 0.0f;
+        const float kv = live ? __bfloat162float(kt[tid]) : 0.0f;
+        s_stage[tid] = qv * qv;
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 1e-6f;
+            for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+            s_scalar = rsqrtf(acc);
+        }
+        __syncthreads();
+        const float q_inv = s_scalar * rsqrtf(static_cast<float>(dk));
+        s_stage[tid] = kv * kv;
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 1e-6f;
+            for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+            s_scalar = rsqrtf(acc);
+        }
+        __syncthreads();
+        if (live) {
+            s_qh[tid] = qv * q_inv;
+            s_kh[tid] = kv * s_scalar;
+        }
+        __syncthreads();
+
+        if (live) {
+            const float decay = expf(gt[tid]);
+            for (std::int32_t j = 0; j < dk; ++j) {
+                S[static_cast<std::int64_t>(tid) * dk + j] *= decay;
+            }
+        }
+        __syncthreads();
+        if (live) {
+            float u = 0.0f;
+            for (std::int32_t i = 0; i < dk; ++i) {
+                u = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_kh[i], u);
+            }
+            s_u[tid] = u;
+        }
+        __syncthreads();
+        if (live) {
+            s_delta[tid] =
+                beta[static_cast<std::int64_t>(t) * heads + h] * (__bfloat162float(vt[tid]) - s_u[tid]);
+        }
+        __syncthreads();
+        if (live) {
+            for (std::int32_t j = 0; j < dk; ++j) {
+                float& cell = S[static_cast<std::int64_t>(tid) * dk + j];
+                cell = fmaf(s_kh[tid], s_delta[j], cell);
+            }
+        }
+        __syncthreads();
+        if (live) {
+            float o = 0.0f;
+            for (std::int32_t i = 0; i < dk; ++i) {
+                o = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_qh[i], o);
+            }
+            s_o[tid] = o;
+        }
+        __syncthreads();
+        s_stage[tid] = live ? s_o[tid] * s_o[tid] : 0.0f;
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 0.0f;
+            for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+            s_scalar = rsqrtf(acc / static_cast<float>(dk) + 1e-6f);
+        }
+        __syncthreads();
+        if (live) {
+            out[offset + base + tid] = __float2bfloat16(
+                s_o[tid] * s_scalar * o_norm_w[tid] * sigmoid_f(__bfloat162float(g2t[tid])));
+        }
+        __syncthreads();
+    }
+}
+
+} // namespace glm5_kda_detail
+} // namespace ninfer::ops
diff --git a/src/ops/kernel/glm5_mhc.cuh b/src/ops/kernel/glm5_mhc.cuh
new file mode 100644
index 0000000..2079ed0
--- /dev/null
+++ b/src/ops/kernel/glm5_mhc.cuh
@@ -0,0 +1,202 @@
+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash mHC kernels: the fused weight generation + collapse for one
+// hyper-connection site (decode path: one block per token, correctness over latency), the
+// post-block stream update, and the final head mean. Math follows models/glm5/reference.
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_mhc_detail {
+
+constexpr int kPreBlock = 256;
+constexpr int kMaxLanes = 24;   // (2 + hc) * hc with hc = 4
+
+__device__ __forceinline__ float sigmoid_f(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+// One token per block. Phase order: unweighted RMS norm over the flattened streams, the
+// 24 mix dots (each thread strides the plane, one accumulator per lane), the gates and
+// Sinkhorn on thread 0 (a 4x4 in registers), then the pre-weighted collapse.
+__global__ void pre_kernel(const __nv_bfloat16* __restrict__ streams,
+                           const __nv_bfloat16* __restrict__ fn, const float* __restrict__ base,
+                           const float* __restrict__ scale, float rms_eps, float hc_eps,
+                           std::int32_t sinkhorn_iters, std::int32_t hidden, std::int32_t hc,
+                           float* __restrict__ pre, float* __restrict__ post,
+                           float* __restrict__ comb, __nv_bfloat16* __restrict__ collapsed) {
+    const std::int64_t token = blockIdx.x;
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const std::int32_t threads = blockDim.x;
+    const std::int64_t plane = static_cast<std::int64_t>(hc) * hidden;
+    const __nv_bfloat16* row = streams + token * plane;
+    const std::int32_t lanes = (2 + hc) * hc;
+
+    __shared__ float s_reduce[kPreBlock];
+    __shared__ float s_mix[kMaxLanes];
+    __shared__ float s_pre[4], s_post[4], s_comb[4 * 4];
+
+    // Unweighted RMS norm: eps inside the sqrt, one shared-staged block reduction.
+    float square = 0.0f;
+    for (std::int64_t i = tid; i < plane; i += threads) {
+        const float value = __bfloat162float(row[i]);
+        square = fmaf(value, value, square);
+    }
+    s_reduce[tid] = square;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 0.0f;
+        for (std::int32_t i = 0; i < threads; ++i) { acc += s_reduce[i]; }
+        s_reduce[0] = rsqrtf(acc / static_cast<float>(plane) + rms_eps);
+    }
+    __syncthreads();
+    const float inverse = s_reduce[0];
+
+    // 24 lane dots: each thread walks its stride of the normalized plane once per lane,
+    // keeping lane accumulators in registers; the per-lane block reduction reuses staging.
+    float lane_acc[kMaxLanes];
+#pragma unroll
+    for (std::int32_t m = 0; m < kMaxLanes; ++m) { lane_acc[m] = 0.0f; }
+    for (std::int64_t i = tid; i < plane; i += threads) {
+        const float x = __bfloat162float(row[i]) * inverse;
+        const __nv_bfloat16* weights = fn + i;
+#pragma unroll
+        for (std::int32_t m = 0; m < kMaxLanes; ++m) {
+            lane_acc[m] = fmaf(x, __bfloat162float(weights[static_cast<std::int64_t>(m) * plane]),
+                               lane_acc[m]);
+        }
+    }
+#pragma unroll
+    for (std::int32_t m = 0; m < kMaxLanes; ++m) {
+        s_reduce[tid] = lane_acc[m];
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 0.0f;
+            for (std::int32_t i = 0; i < threads; ++i) { acc += s_reduce[i]; }
+            s_mix[m] = acc;
+        }
+        __syncthreads();
+    }
+    // Lanes beyond this profile stay zero; thread 0 finishes every gate from s_mix.
+    if (tid == 0) {
+#pragma unroll
+        for (std::int32_t n = 0; n < 4; ++n) {
+            if (n < hc) {
+                s_pre[n] = sigmoid_f(s_mix[n] * scale[0] + base[n]) + hc_eps;
+                s_post[n] = 2.0f * sigmoid_f(s_mix[hc + n] * scale[1] + base[hc + n]);
+            }
+        }
+        // comb[src][dst] from the flat layout comb[dst + hc*src]; softmax over dst per src.
+        float comb_w[4][4];
+#pragma unroll
+        for (std::int32_t src = 0; src < 4; ++src) {
+#pragma unroll
+            for (std::int32_t dst = 0; dst < 4; ++dst) {
+                comb_w[src][dst] = 0.0f;
+            }
+        }
+        for (std::int32_t src = 0; src < hc; ++src) {
+            float logits[4], maximum = 0.0f;
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                const std::int32_t flat = 2 * hc + dst + hc * src;
+                logits[dst] = s_mix[flat] * scale[2] + base[flat];
+                if (dst == 0 || logits[dst] > maximum) { maximum = logits[dst]; }
+            }
+            float denominator = 0.0f;
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                logits[dst] = expf(logits[dst] - maximum);
+                denominator += logits[dst];
+            }
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                comb_w[src][dst] = logits[dst] / denominator + hc_eps;
+            }
+        }
+        // Sinkhorn: one column normalization (sum over src), then iters-1 of {row, column}.
+        auto normalize_columns = [&]() {
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                float sum = 0.0f;
+                for (std::int32_t src = 0; src < hc; ++src) { sum += comb_w[src][dst]; }
+                const float inverse_sum = 1.0f / (sum + hc_eps);
+                for (std::int32_t src = 0; src < hc; ++src) { comb_w[src][dst] *= inverse_sum; }
+            }
+        };
+        auto normalize_rows = [&]() {
+            for (std::int32_t src = 0; src < hc; ++src) {
+                float sum = 0.0f;
+                for (std::int32_t dst = 0; dst < hc; ++dst) { sum += comb_w[src][dst]; }
+                const float inverse_sum = 1.0f / (sum + hc_eps);
+                for (std::int32_t dst = 0; dst < hc; ++dst) { comb_w[src][dst] *= inverse_sum; }
+            }
+        };
+        normalize_columns();
+        for (std::int32_t round = 1; round < sinkhorn_iters; ++round) {
+            normalize_rows();
+            normalize_columns();
+        }
+        for (std::int32_t src = 0; src < hc; ++src) {
+            for (std::int32_t dst = 0; dst < hc; ++dst) {
+                s_comb[src * 4 + dst] = comb_w[src][dst];
+            }
+        }
+    }
+    __syncthreads();
+
+    for (std::int32_t n = 0; n < hc; ++n) {
+        pre[token * hc + n] = s_pre[n];
+        post[token * hc + n] = s_post[n];
+    }
+    for (std::int32_t i = 0; i < hc * hc; ++i) { comb[token * hc * hc + i] = s_comb[i]; }
+
+    // Collapse: out[d] = sum_n pre[n] * row[n*hidden + d], published from FP32 math.
+    for (std::int64_t d = tid; d < hidden; d += threads) {
+        float acc = 0.0f;
+        for (std::int32_t n = 0; n < hc; ++n) {
+            acc = fmaf(s_pre[n], __bfloat162float(row[static_cast<std::int64_t>(n) * hidden + d]),
+                       acc);
+        }
+        collapsed[token * hidden + d] = __float2bfloat16(acc);
+    }
+}
+
+// One thread per (t, dst, d): mix four residual reads, add post*block.
+__global__ void post_kernel(const __nv_bfloat16* __restrict__ block,
+                            const __nv_bfloat16* __restrict__ residual, const float* __restrict__ post,
+                            const float* __restrict__ comb, std::int32_t hidden, std::int32_t hc,
+                            __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int64_t plane = static_cast<std::int64_t>(hc) * hidden;
+    // Grid is 1D over [T * hc * hidden]; decompose cheaply.
+    const std::int32_t t = static_cast<std::int32_t>(index / plane);
+    const std::int64_t within = index % plane;
+    const std::int32_t dst = static_cast<std::int32_t>(within / hidden);
+    const std::int32_t d = static_cast<std::int32_t>(within % hidden);
+    const __nv_bfloat16* residual_t = residual + static_cast<std::int64_t>(t) * plane;
+    float mix = 0.0f;
+    for (std::int32_t src = 0; src < hc; ++src) {
+        mix = fmaf(comb[static_cast<std::int64_t>(t) * hc * hc + src * hc + dst],
+                   __bfloat162float(residual_t[static_cast<std::int64_t>(src) * hidden + d]), mix);
+    }
+    const float gated =
+        fmaf(post[static_cast<std::int64_t>(t) * hc + dst], __bfloat162float(block[static_cast<std::int64_t>(t) * hidden + d]), mix);
+    out[static_cast<std::int64_t>(t) * plane + static_cast<std::int64_t>(dst) * hidden + d] =
+        __float2bfloat16(gated);
+}
+
+// One thread per (t, d): unweighted mean of the four streams.
+__global__ void head_kernel(const __nv_bfloat16* __restrict__ streams, std::int32_t hidden,
+                            std::int32_t hc, __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t t = static_cast<std::int32_t>(index / hidden);
+    const std::int32_t d = static_cast<std::int32_t>(index % hidden);
+    const std::int64_t plane = static_cast<std::int64_t>(hc) * hidden;
+    float acc = 0.0f;
+    for (std::int32_t n = 0; n < hc; ++n) {
+        acc += __bfloat162float(streams[static_cast<std::int64_t>(t) * plane +
+                                        static_cast<std::int64_t>(n) * hidden + d]);
+    }
+    out[static_cast<std::int64_t>(t) * hidden + d] =
+        __float2bfloat16(acc * (1.0f / static_cast<float>(hc)));
+}
+
+} // namespace glm5_mhc_detail
+} // namespace ninfer::ops
diff --git a/src/ops/kernel/glm5_mlp.cuh b/src/ops/kernel/glm5_mlp.cuh
new file mode 100644
index 0000000..123ec48
--- /dev/null
+++ b/src/ops/kernel/glm5_mlp.cuh
@@ -0,0 +1,107 @@
+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash MLP kernels: the clamped SwiGLU, the sigmoid/noaux_tc router
+// and the expert combination. Math follows models/glm5/reference (expert_forward and
+// routing_reference semantics: gate upper-clamped only, up clamped both sides; the router's
+// correction bias participates ONLY in selection).
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_mlp_detail {
+
+constexpr int kThreads = 256;
+
+__device__ __forceinline__ float sigmoid_f(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+__global__ void swiglu_kernel(const __nv_bfloat16* __restrict__ gate,
+                              const __nv_bfloat16* __restrict__ up, float limit,
+                              std::int64_t elements, __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    const float g = __bfloat162float(gate[index]);
+    const float u = __bfloat162float(up[index]);
+    const float clamped_gate = fminf(g, limit);
+    const float clamped_up = fminf(fmaxf(u, -limit), limit);
+    out[index] = __float2bfloat16(clamped_gate * sigmoid_f(clamped_gate) * clamped_up);
+}
+
+// One block: iterative argmax over score+bias, top_k rounds (ties by lower index), then the
+// normalized original scores of the selected experts.
+__global__ void route_kernel(const __nv_bfloat16* __restrict__ logits,
+                             const float* __restrict__ correction_bias, std::int32_t experts,
+                             std::int32_t top_k, float scaling, float* __restrict__ weights,
+                             std::int32_t* __restrict__ indices) {
+    extern __shared__ float s_score[];   // [experts]
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    for (std::int32_t e = tid; e < experts; e += blockDim.x) {
+        s_score[e] = sigmoid_f(__bfloat162float(logits[e])) + correction_bias[e];
+    }
+    __syncthreads();
+    __shared__ float s_val[kThreads];
+    __shared__ std::int32_t s_idx[kThreads];
+    __shared__ float s_sum;
+    if (tid == 0) { s_sum = 0.0f; }
+    const std::int32_t picks = min(top_k, experts);
+    for (std::int32_t rank = 0; rank < picks; ++rank) {
+        float best_value = -3.0e38f;
+        std::int32_t best_index = 0x7fffffff;
+        for (std::int32_t e = tid; e < experts; e += blockDim.x) {
+            if (s_score[e] > best_value) {
+                best_value = s_score[e];
+                best_index = e;
+            }
+        }
+        s_val[tid] = best_value;
+        s_idx[tid] = best_index;
+        __syncthreads();
+        if (tid == 0) {
+            float value = -3.0e38f;
+            std::int32_t index = 0x7fffffff;
+            for (std::int32_t i = 0; i < kThreads; ++i) {
+                if (s_val[i] > value || (s_val[i] == value && s_idx[i] < index)) {
+                    value = s_val[i];
+                    index = s_idx[i];
+                }
+            }
+            s_idx[0] = index;
+            s_val[0] = value;
+        }
+        __syncthreads();
+        const std::int32_t winner = s_idx[0];
+        __syncthreads();
+        // Recover the ORIGINAL sigmoid score of the winner (bias removed) for the weights.
+        if (tid == 0) {
+            const float original = s_score[winner] - correction_bias[winner];
+            indices[rank] = winner;
+            weights[rank] = original;
+            s_sum += original;
+            s_score[winner] = -3.0e38f;
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        const float inverse = scaling / (s_sum + 1e-20f);
+        for (std::int32_t i = 0; i < picks; ++i) { weights[i] *= inverse; }
+    }
+}
+
+// One thread per output element.
+__global__ void combine_kernel(const __nv_bfloat16* __restrict__ experts,
+                               const float* __restrict__ weights,
+                               const __nv_bfloat16* __restrict__ shared, std::int32_t hidden,
+                               std::int32_t top_k, std::int64_t elements,
+                               __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    float acc = __bfloat162float(shared[index]);
+    for (std::int32_t i = 0; i < top_k; ++i) {
+        acc = fmaf(weights[i], __bfloat162float(experts[static_cast<std::int64_t>(i) * hidden + index]), acc);
+    }
+    out[index] = __float2bfloat16(acc);
+}
+
+} // namespace glm5_mlp_detail
+} // namespace ninfer::ops
diff --git a/src/ops/softmax_attention/dense/causal_cache/selective_int8/launch.cu b/src/ops/softmax_attention/dense/causal_cache/selective_int8/launch.cu
