diff --git a/src/core/gaudi2/tests/runtime_lifecycle_test.cpp b/src/core/gaudi2/tests/runtime_lifecycle_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d5a31d2e8e0f4864e13ad72ca8c8f9e90b69521e
--- /dev/null
+++ b/src/core/gaudi2/tests/runtime_lifecycle_test.cpp
@@ -0,0 +1,106 @@
+#include "runtime.h"
+#include "control.h"
+
+#include <algorithm>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <type_traits>
+
+using namespace ninfer::gaudi2;
+namespace {
+void require(bool value, const char* what) { if (!value) throw std::runtime_error(what); }
+template<class Exception, class F> void rejects(F&& action) {
+    try { action(); } catch (const Exception&) { return; }
+    throw std::runtime_error("expected exception was not raised");
+}
+void round_trip_and_ranges() {
+    Device device;
+    static_assert(!std::is_move_constructible_v<Device> && !std::is_move_assignable_v<Device>);
+    rejects<std::logic_error>([] { Device duplicate; });
+    auto stream = device.create_stream();
+    auto host = device.allocate_host(64); auto memory = device.allocate_device(64);
+    const auto info = device.memory_info(); require(info.free_bytes <= info.total_bytes, "memory information order");
+    for (std::size_t i = 0; i < 64; ++i) host.bytes()[i] = static_cast<std::byte>(i);
+    auto upload = stream.upload(memory, host, 16, 8, 4);
+    require(!upload.ready(), "fake must defer DMA until a real fence is drained");
+    rejects<std::logic_error>([&] { (void)host.bytes(); });
+    rejects<std::logic_error>([&] { (void)memory.address(); });
+    rejects<std::logic_error>([&] { (void)stream.upload(memory, host, 16); });
+    upload.wait(); upload.wait(); require(upload.ready(), "wait must be idempotent");
+    auto polled = stream.upload(memory, host, 16, 8, 4);
+    stream.synchronize();
+    require(polled.ready(), "successful event query must publish completed DMA");
+    (void)host.bytes(); (void)memory.address();
+    std::fill(host.bytes().begin(), host.bytes().end(), std::byte{0});
+    { auto download = stream.download(host, memory, 16, 32, 8); }
+    for (std::size_t i = 0; i < 16; ++i) require(host.bytes()[32 + i] == static_cast<std::byte>(4 + i), "DMA offset round trip");
+    rejects<std::invalid_argument>([&] { (void)stream.upload(memory, host, 0); });
+    rejects<std::invalid_argument>([&] { (void)stream.upload(memory, host, 2, 63); });
+    rejects<std::invalid_argument>([&] { (void)stream.upload(memory, host, 1, 0, std::numeric_limits<std::size_t>::max()); });
+    rejects<std::invalid_argument>([&] { (void)device.allocate_host(0); });
+    rejects<std::invalid_argument>([&] { (void)device.allocate_device(0); });
+    DeviceBuffer empty_device; PinnedBuffer empty_host; Stream empty_stream;
+    rejects<std::logic_error>([&] { (void)empty_device.address(); });
+    rejects<std::logic_error>([&] { (void)empty_host.bytes(); });
+    rejects<std::logic_error>([&] { empty_stream.synchronize(); });
+}
+void resources_outlive_facades() {
+    Transfer retained;
+    {
+        Device device; auto stream = device.create_stream();
+        auto host = device.allocate_host(8); auto memory = device.allocate_device(8);
+        retained = stream.upload(memory, host, 8);
+    }
+    require(fake_synapse::live_allocations() == 2, "transfer must retain both operands and device");
+    retained.wait(); retained = Transfer{};
+    fake_synapse::assert_clean();
+}
+void fence_scope_and_move_assignment() {
+    Device device; auto stream = device.create_stream();
+    auto h1 = device.allocate_host(8), h2 = device.allocate_host(8);
+    auto d1 = device.allocate_device(8), d2 = device.allocate_device(8);
+    auto first = stream.upload(d1, h1, 8); auto second = stream.upload(d2, h2, 8);
+    const auto before = fake_synapse::completed_copies();
+    first.wait();
+    require(fake_synapse::completed_copies() == before + 1 && !second.ready(), "event fence must not drain later work");
+    first = stream.upload(d1, h1, 8);
+    first = std::move(second); // Destruction of the old pending transfer waits for it.
+    require(second.ready(), "moved-from transfer must be empty"); second.wait(); first.wait();
+    require(fake_synapse::completed_copies() == before + 3, "move assignment completion count");
+}
+void failures() {
+    for (auto operation : {"synInitialize", "synDeviceAcquireByDeviceType"}) {
+        fake_synapse::fail_next(operation); rejects<SynapseError>([] { Device device; });
+        fake_synapse::assert_clean();
+    }
+    {
+        Device device;
+        fake_synapse::fail_next("synDeviceMalloc"); rejects<SynapseError>([&] { (void)device.allocate_device(8); });
+        fake_synapse::fail_next("synHostMalloc"); rejects<SynapseError>([&] { (void)device.allocate_host(8); });
+        fake_synapse::fail_next("synStreamCreateGeneric"); rejects<SynapseError>([&] { (void)device.create_stream(); });
+        require(fake_synapse::live_allocations() == 0, "failed allocation must not retain storage");
+        auto stream = device.create_stream(); auto host = device.allocate_host(8); auto memory = device.allocate_device(8);
+        for (auto operation : {"synEventCreate", "synMemCopyAsync", "synEventRecord"}) {
+            fake_synapse::fail_next(operation);
+            rejects<SynapseError>([&] { (void)stream.upload(memory, host, 8); });
+            (void)host.bytes(); (void)memory.address(); // Failed submission was safely drained.
+        }
+        auto transfer = stream.upload(memory, host, 8);
+        fake_synapse::fail_next("synEventQuery"); rejects<SynapseError>([&] { (void)transfer.ready(); });
+        rejects<std::logic_error>([&] { (void)host.bytes(); });
+        fake_synapse::fail_next("synEventSynchronize"); rejects<SynapseError>([&] { transfer.wait(); });
+        rejects<std::logic_error>([&] { (void)memory.address(); });
+        transfer.wait(); (void)host.bytes();
+        fake_synapse::fail_next("synDeviceGetMemoryInfo"); rejects<SynapseError>([&] { (void)device.memory_info(); });
+    }
+    fake_synapse::assert_clean();
+}
+}
+int main() {
+    try {
+        round_trip_and_ranges(); fake_synapse::assert_clean();
+        resources_outlive_facades(); fence_scope_and_move_assignment(); fake_synapse::assert_clean();
+        failures(); std::cout << "offline asynchronous resource lifecycle checks passed\n";
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
