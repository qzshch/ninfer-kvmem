+                 std::int32_t top_pools; std::int32_t select_tail; } params;
+        params.position = static_cast<std::int32_t>(position);
+        params.pool_k = static_cast<std::int32_t>(shape.pool_k);
+        params.top_pools = static_cast<std::int32_t>(shape.top_pools);
+        params.select_tail = select_tail_;
+        const synTensor inputs[] = {score};
+        const synTensor outputs[] = {cells};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 1, 1, &params, sizeof(params),
+                                "glm5_dsa_select_f32", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "DsaSelect node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_dsa_select", max_workspace_bytes);
+        const char* names[] = {"score", "cells"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute DsaSelect::launch(Stream& stream, DeviceBuffer& score, DeviceBuffer& cells) {
+    if (score.size() != static_cast<std::uint64_t>(shape_.pools) * 4 ||
+        cells.size() != static_cast<std::uint64_t>(shape_.slots) * 4) {
+        throw std::invalid_argument("DsaSelect launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &score, {shape_.pools, 1}},
+        {tensor_ids_[1], &cells, {shape_.slots, 1}},
+    };
+    return stream.launch(recipe_, bindings);
+}
+
+// ---------------------------------------------------------------------------
+// DSA attention
+
+DsaAttention::DsaAttention(const Device& device, DsaAttentionShape shape, float qk_scale,
+                           std::size_t max_workspace_bytes)
+    : shape_(shape), qk_scale_(qk_scale) {
+    if (!shape.heads || !shape.lora || !shape.v_head || !shape.cache || !shape.slots) {
+        throw std::invalid_argument("DsaAttention: all dimensions must be positive");
+    }
+    if (shape.lora > 1024 || shape.lora % 128) {
+        throw std::invalid_argument("DsaAttention: lora in (0, 1024], multiple of 128");
+    }
+
+    synGraphHandle graph = create_graph();
+    std::vector<synTensor> created;
+    std::vector<synSectionHandle> sections;
+    try {
+        synTensor q_abs = create_bf16_tensor(graph, "q_abs", {shape.lora, shape.heads}, sections);
+        synTensor latents = create_bf16_tensor(graph, "latents",
+                                               {shape.lora, shape.cache}, sections);
+        synTensor cells = create_i32_tensor(graph, "cells", {shape.slots}, sections);
+        synTensor wv_b = create_bf16_tensor(graph, "wv_b",
+                                            {shape.lora * shape.v_head * shape.heads}, sections);
+        synTensor out = create_bf16_tensor(graph, "out",
+                                           {shape.heads * shape.v_head}, sections);
+        created = {q_abs, latents, cells, wv_b, out};
+        struct { float qk_scale; } params = {qk_scale};
+        const synTensor inputs[] = {q_abs, latents, cells, wv_b};
+        const synTensor outputs[] = {out};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 4, 1, &params, sizeof(params),
+                                "glm5_dsa_attention_f32", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "DsaAttention node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_dsa_attention", max_workspace_bytes);
+        const char* names[] = {"q_abs", "latents", "cells", "wv_b", "out"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute DsaAttention::launch(Stream& stream, DeviceBuffer& q_abs, DeviceBuffer& latents,
+                             DeviceBuffer& cells, DeviceBuffer& wv_b, DeviceBuffer& out) {
+    if (q_abs.size() != static_cast<std::uint64_t>(shape_.lora) * shape_.heads * 2 ||
+        latents.size() != static_cast<std::uint64_t>(shape_.lora) * shape_.cache * 2 ||
+        cells.size() != static_cast<std::uint64_t>(shape_.slots) * 4 ||
+        wv_b.size() != static_cast<std::uint64_t>(shape_.lora) * shape_.v_head * shape_.heads * 2 ||
+        out.size() != static_cast<std::uint64_t>(shape_.heads) * shape_.v_head * 2) {
+        throw std::invalid_argument("DsaAttention launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &q_abs, {shape_.lora, shape_.heads}},
+        {tensor_ids_[1], &latents, {shape_.lora, shape_.cache}},
+        {tensor_ids_[2], &cells, {shape_.slots, 1}},
+        {tensor_ids_[3], &wv_b, {shape_.lora * shape_.v_head * shape_.heads, 1}},
+        {tensor_ids_[4], &out, {shape_.heads * shape_.v_head, 1}},
+    };
+    return stream.launch(recipe_, bindings);
+}
+
+// ---------------------------------------------------------------------------
+// DSA absorb
+
+DsaAbsorb::DsaAbsorb(const Device& device, DsaAbsorbShape shape,
+                     std::size_t max_workspace_bytes)
+    : shape_(shape) {
+    if (!shape.heads || !shape.nope || !shape.lora) {
+        throw std::invalid_argument("DsaAbsorb: heads, nope and lora must be positive");
+    }
+
+    synGraphHandle graph = create_graph();
+    std::vector<synTensor> created;
+    std::vector<synSectionHandle> sections;
+    try {
+        synTensor q = create_bf16_tensor(graph, "q", {shape.nope, shape.heads}, sections);
+        synTensor wk_b = create_bf16_tensor(graph, "wk_b",
+                                            {shape.nope * shape.lora * shape.heads}, sections);
+        synTensor q_abs = create_f32_tensor(graph, "q_abs", {shape.lora, shape.heads}, sections);
+        created = {q, wk_b, q_abs};
+        const synTensor inputs[] = {q, wk_b};
+        const synTensor outputs[] = {q_abs};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 2, 1, nullptr, 0,
+                                "glm5_dsa_absorb_bf16", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "DsaAbsorb node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_dsa_absorb", max_workspace_bytes);
+        const char* names[] = {"q", "wk_b", "q_abs"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute DsaAbsorb::launch(Stream& stream, DeviceBuffer& q, DeviceBuffer& wk_b,
+                          DeviceBuffer& q_abs) {
+    if (q.size() != static_cast<std::uint64_t>(shape_.nope) * shape_.heads * 2 ||
+        wk_b.size() != static_cast<std::uint64_t>(shape_.nope) * shape_.lora * shape_.heads * 2 ||
+        q_abs.size() != static_cast<std::uint64_t>(shape_.lora) * shape_.heads * 4) {
+        throw std::invalid_argument("DsaAbsorb launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &q, {shape_.nope, shape_.heads}},
+        {tensor_ids_[1], &wk_b, {shape_.nope * shape_.lora * shape_.heads, 1}},
+        {tensor_ids_[2], &q_abs, {shape_.lora, shape_.heads}},
+    };
+    return stream.launch(recipe_, bindings);
+}
+
+// ---------------------------------------------------------------------------
+// DSA scale
+
+DsaScale::DsaScale(const Device& device, std::uint32_t width, float factor,
+                   std::size_t max_workspace_bytes)
+    : width_(width), factor_(factor) {
+    if (!width) throw std::invalid_argument("DsaScale: width must be positive");
+
+    synGraphHandle graph = create_graph();
+    std::vector<synTensor> created;
+    std::vector<synSectionHandle> sections;
+    try {
+        synTensor values = create_f32_tensor(graph, "values", {width}, sections);
+        synTensor out = create_f32_tensor(graph, "out", {width}, sections);
+        created = {values, out};
+        struct { float factor; } params = {factor};
+        const synTensor inputs[] = {values};
+        const synTensor outputs[] = {out};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 1, 1, &params, sizeof(params),
+                                "glm5_dsa_scale_f32", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "DsaScale node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_dsa_scale", max_workspace_bytes);
+        const char* names[] = {"values", "out"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute DsaScale::launch(Stream& stream, DeviceBuffer& values, DeviceBuffer& out) {
+    if (values.size() != static_cast<std::uint64_t>(width_) * 4 ||
+        out.size() != static_cast<std::uint64_t>(width_) * 4) {
+        throw std::invalid_argument("DsaScale launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &values, {width_, 1}},
+        {tensor_ids_[1], &out, {width_, 1}},
+    };
+    return stream.launch(recipe_, bindings);
+}
+
+} // namespace ninfer::gaudi2::tpc
