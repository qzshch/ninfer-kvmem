+        m_down(static_cast<std::size_t>(EXP) * H * FFN_M),
+        m_gsh(plane(FFN_M, H, 111)), m_ush(plane(FFN_M, H, 112)), m_dsh(plane(H, FFN_M, 113));
+    for (std::uint32_t e = 0; e < EXP; ++e) {
+        for (std::size_t i = 0; i < static_cast<std::size_t>(FFN_M) * H; ++i) {
