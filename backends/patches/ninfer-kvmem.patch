+// Adapted from NInfer 64d10fbf9f8e6bfc79ab0570b94674c5b9997929 (Apache-2.0).
+#pragma once
+#include "ops/softmax_attention/dense/causal_cache/selective_int8/ported/ops/common/numeric/math.cuh"
+#include "ops/softmax_attention/dense/causal_cache/selective_int8/ported/ops/common/numeric/convert.cuh"
