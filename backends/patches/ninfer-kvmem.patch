--- /dev/null
+++ b/src/core/gaudi2/tests/bf16_gemm_test.cpp
@@ -0,0 +1,173 @@
+#include "ops/gaudi2/bf16_gemm.h"
+#include "control.h"
+
+#include <algorithm>
+#include <bit>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <vector>
+
+using namespace ninfer::gaudi2;
+namespace {
+void require(bool value, const char* what) { if (!value) throw std::runtime_error(what); }
+template<class Exception, class F> void rejects(F&& f) {
+    try { f(); } catch (const Exception&) { return; }
+    throw std::runtime_error("GEMM expected exception was not raised");
+}
+double decode(std::uint16_t word) { return std::bit_cast<float>(static_cast<std::uint32_t>(word) << 16); }
+// Independent nearest-representable oracle: compare distances to adjacent BF16
+// values in FP64, resolving an exact midpoint by the even stored low bit.
+std::uint16_t nearest(double value) {
+    const auto f = static_cast<float>(value);
+    const auto prefix = std::bit_cast<std::uint32_t>(f) >> 16;
+    const double d0 = std::abs(value - decode(static_cast<std::uint16_t>(prefix)));
+    const double d1 = std::abs(value - decode(static_cast<std::uint16_t>(prefix + 1)));
+    return static_cast<std::uint16_t>(d0 < d1 || (d0 == d1 && !(prefix & 1)) ? prefix : prefix + 1);
+}
+std::vector<std::uint16_t> oracle(Bf16GemmShape shape, const std::vector<std::uint16_t>& a,
+                                  const std::vector<std::uint16_t>& w) {
+    std::vector<std::uint16_t> y(shape.m * shape.n);
+    for (std::size_t r = 0; r < shape.m; ++r) for (std::size_t c = 0; c < shape.n; ++c) {
+        double sum = 0;
+        for (std::size_t k = 0; k < shape.k; ++k) sum += decode(a[r * shape.k + k]) * decode(w[c * shape.k + k]);
+        y[r * shape.n + c] = nearest(sum);
+    }
+    return y;
+}
+void put(PinnedBuffer& host, const std::vector<std::uint16_t>& words) {
+    require(host.size() == words.size() * 2, "fixture Host size");
+    std::memcpy(host.bytes().data(), words.data(), host.size());
+}
+std::vector<std::uint16_t> get(PinnedBuffer& host) {
+    std::vector<std::uint16_t> words(host.size() / 2);
+    std::memcpy(words.data(), host.bytes().data(), host.size()); return words;
+}
+void run_case(Bf16GemmShape shape, const std::vector<std::uint16_t>& a, const std::vector<std::uint16_t>& w) {
+    Device device; auto stream = device.create_stream(); Bf16Gemm gemm(device, shape, 4096);
+    auto ah = device.allocate_host(shape.a_bytes()), wh = device.allocate_host(shape.w_bytes()), yh = device.allocate_host(shape.y_bytes());
+    auto ad = device.allocate_device(shape.a_bytes()), wd = device.allocate_device(shape.w_bytes()), yd = device.allocate_device(shape.y_bytes());
+    put(ah, a); put(wh, w);
+    auto upload_a = stream.upload(ad, ah, ah.size()); auto upload_w = stream.upload(wd, wh, wh.size());
+    rejects<std::logic_error>([&] { (void)gemm.launch(stream, ad, wd, yd); });
+    upload_a.wait(); upload_w.wait();
+    auto execution = gemm.launch(stream, ad, wd, yd);
+    require(!execution.ready(), "compute must not complete merely because a DMA completed");
+    rejects<std::logic_error>([&] { (void)ad.address(); });
+    rejects<std::logic_error>([&] { (void)wd.address(); });
+    rejects<std::logic_error>([&] { (void)yd.address(); });
+    rejects<std::logic_error>([&] { (void)stream.download(yh, yd, yh.size()); });
+    execution.wait(); execution.wait(); require(execution.ready(), "compute completion must be idempotent");
+    auto download = stream.download(yh, yd, yh.size()); download.wait();
+    require(get(yh) == oracle(shape, a, w), "offline graph/math result differs from independent FP64/BF16 oracle");
+}
+void math_and_static_shapes() {
+    // Rectangular and asymmetric: catches dimensions/input order/transpose errors
+    // that square/all-ones fixtures cannot distinguish.
+    run_case({2, 3, 5}, {nearest(1), nearest(2), nearest(3), nearest(4), nearest(5),
+                         nearest(-2), nearest(.5), nearest(1), nearest(0), nearest(-3)},
+                       {nearest(2), nearest(-1), nearest(0), nearest(3), nearest(1),
+                        nearest(-1), nearest(4), nearest(2), nearest(0), nearest(-2),
+                        nearest(.5), nearest(0), nearest(-1), nearest(1), nearest(2)});
+    fake_synapse::assert_clean();
+    run_case({1, 2, 2}, {nearest(1), nearest(1)},
+                       {nearest(1), nearest(1.0 / 256), nearest(1), nearest(3.0 / 256)});
+    fake_synapse::assert_clean();
+    std::vector<std::uint16_t> a(513, nearest(1)), w(513, nearest(1.0 / 256));
+    w.back() = nearest(-2); run_case({1, 1, 513}, a, w); // BF16 accumulator would lose increments.
+    fake_synapse::assert_clean();
+    const Bf16GemmShape tile{1, 128, 5120};
+    a.resize(tile.m * tile.k); w.resize(tile.n * tile.k);
+    for (std::size_t i = 0; i < a.size(); ++i) a[i] = nearest((static_cast<int>(i % 19) - 9) / 16.0);
+    for (std::size_t i = 0; i < w.size(); ++i) w[i] = nearest((static_cast<int>((i * 7) % 23) - 11) / 16.0);
+    // Dyadic fixtures make FP32 and FP64 sums exact even at a real Qwen K extent.
+    run_case(tile, a, w); fake_synapse::assert_clean();
+    const Bf16GemmShape full_ffn{1, 17408, 5120}; full_ffn.validate();
+    require(full_ffn.a_bytes() == 10240 && full_ffn.w_bytes() == 178257920 && full_ffn.y_bytes() == 34816,
+            "real Qwen FFN resource query");
+    Device device;
+    rejects<std::invalid_argument>([&] { Bf16Gemm bad(device, {0, 3, 5}, 4096); });
+    rejects<std::invalid_argument>([&] { Bf16Gemm bad(device, {1, 3, std::numeric_limits<std::size_t>::max()}, 4096); });
+    rejects<std::overflow_error>([] { (void)Bf16GemmShape{1, 1, std::numeric_limits<std::size_t>::max()}.w_bytes(); });
+}
+void execution_lifetime() {
+    Compute retained;
+    {
+        Device device; auto stream = device.create_stream(); Bf16Gemm gemm(device, {1, 1, 1}, 4096);
+        auto ah = device.allocate_host(2), wh = device.allocate_host(2);
+        auto ad = device.allocate_device(2), wd = device.allocate_device(2), yd = device.allocate_device(2);
+        put(ah, {nearest(2)}); put(wh, {nearest(3)});
+        stream.upload(ad, ah, 2).wait(); stream.upload(wd, wh, 2).wait();
+        retained = gemm.launch(stream, ad, wd, yd);
+    }
+    require(fake_synapse::live_allocations() == 4, "compute must retain A/W/Y and workspace after all facades die");
+    retained.wait(); retained = Compute{}; fake_synapse::assert_clean();
+}
+void busy_workspace_ranges_and_fences() {
+    Device device; auto stream = device.create_stream(); Bf16Gemm gemm(device, {2, 2, 2}, 4096);
+    auto a = device.allocate_device(8), w = device.allocate_device(8), y = device.allocate_device(8);
+    auto a2 = device.allocate_device(8), w2 = device.allocate_device(8), y2 = device.allocate_device(8);
+    auto tiny = device.allocate_device(2);
+    rejects<std::invalid_argument>([&] { (void)gemm.launch(stream, tiny, w, y); });
+    rejects<std::invalid_argument>([&] { (void)gemm.launch(stream, a, a, y); });
+    auto execution = gemm.launch(stream, a, w, y);
+    rejects<std::logic_error>([&] { (void)gemm.launch(stream, a2, w2, y2); });
+    auto unrelated_host = device.allocate_host(8);
+    auto unrelated = device.allocate_device(8);
+    auto later_dma = stream.upload(unrelated, unrelated_host, 8);
+    execution.wait(); require(!later_dma.ready(), "compute fence must not complete later unrelated DMA"); later_dma.wait();
+    auto first = gemm.launch(stream, a, w, y);
+    stream.synchronize(); require(first.ready(), "successful compute query must release leases");
+    auto second = gemm.launch(stream, a2, w2, y2); first = std::move(second);
+    require(second.ready(), "moved-from Compute is empty"); first.wait();
+    Bf16Gemm other_recipe(device, {2, 2, 2}, 4096);
+    auto old_pending = gemm.launch(stream, a, w, y);
+    auto new_pending = other_recipe.launch(stream, a2, w2, y2);
+    old_pending = std::move(new_pending); // Must finish the old recipe before replacing its fence.
+    old_pending.wait();
+}
+void construction_failures() {
+    Device device;
+    for (const auto operation : {"synGraphCreate", "synTensorHandleCreate", "synTensorSetGeometry", "synTensorSetDeviceDataType",
+         "synTensorSetAllowPermutation", "synSectionCreate", "synSectionSetPersistent", "synTensorAssignToSection",
+         "synNodeCreateWithId", "synNodeSetRoundingMode", "synGraphCompile", "synWorkspaceGetSize", "synTensorRetrieveIds", "synDeviceMalloc"}) {
+        fake_synapse::fail_next(operation); rejects<SynapseError>([&] { Bf16Gemm bad(device, {2, 3, 5}, 4096); });
+        fake_synapse::assert_graph_clean(); require(!fake_synapse::live_allocations(), "failed recipe must free workspace");
+    }
+    fake_synapse::fail_after("synTensorHandleCreate", 2);
+    rejects<SynapseError>([&] { Bf16Gemm bad(device, {2, 3, 5}, 4096); }); fake_synapse::assert_graph_clean();
+    fake_synapse::set_workspace_bytes(4097);
+    rejects<std::length_error>([&] { Bf16Gemm bad(device, {2, 3, 5}, 4096); }); fake_synapse::assert_graph_clean();
+    fake_synapse::set_workspace_bytes(0);
+    {
+        Bf16Gemm zero(device, {2, 3, 5}, 0); require(!zero.workspace_bytes(), "zero workspace must not allocate hidden storage");
+        auto stream = device.create_stream();
+        auto a = device.allocate_device(20), w = device.allocate_device(30), y = device.allocate_device(12);
+        auto execution = zero.launch(stream, a, w, y); execution.wait();
+    }
+    fake_synapse::set_workspace_bytes(4096);
+}
+void launch_failures() {
+    Device device; auto stream = device.create_stream(); Bf16Gemm gemm(device, {1, 1, 1}, 4096);
+    auto a = device.allocate_device(2), w = device.allocate_device(2), y = device.allocate_device(2);
+    for (const auto operation : {"synEventCreate", "synLaunchWithExternalEventsExt", "synEventRecord"}) {
+        fake_synapse::fail_next(operation);
+        rejects<SynapseError>([&] { (void)gemm.launch(stream, a, w, y); });
+        (void)a.address(); (void)w.address(); (void)y.address();
+    }
+    auto execution = gemm.launch(stream, a, w, y);
+    fake_synapse::fail_next("synEventQuery"); rejects<SynapseError>([&] { (void)execution.ready(); });
+    rejects<std::logic_error>([&] { (void)y.address(); });
+    fake_synapse::fail_next("synEventSynchronize"); rejects<SynapseError>([&] { execution.wait(); });
+    rejects<std::logic_error>([&] { (void)a.address(); }); execution.wait();
+}
+}
+int main() {
+    try {
+        math_and_static_shapes(); fake_synapse::assert_clean(); execution_lifetime();
+        busy_workspace_ranges_and_fences(); fake_synapse::assert_clean();
+        construction_failures(); fake_synapse::assert_clean(); launch_failures(); fake_synapse::assert_clean();
+        std::cout << "offline GEMM graph, FP64 oracle and asynchronous ownership checks passed\n";
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
diff --git a/src/core/gaudi2/tests/block_fp8_linear_test.cpp b/src/core/gaudi2/tests/block_fp8_linear_test.cpp
new file mode 100644
index 0000000..62d25a8
--- /dev/null
+++ b/src/core/gaudi2/tests/block_fp8_linear_test.cpp
@@ -0,0 +1,164 @@
+#include "ops/gaudi2/block_fp8_linear.h"
+#include "control.h"
+
+#include <bit>
+#include <cmath>
+#include <cstring>
+#include <cstdio>
+#include <iostream>
+#include <limits>
+#include <vector>
+
+using namespace ninfer::gaudi2;
+namespace {
+void require(bool value, const char* what) { if (!value) throw std::runtime_error(what); }
+template<class Exception, class F> void rejects(F&& f) {
+    try { f(); } catch (const Exception&) { return; }
+    throw std::runtime_error("block-FP8 linear expected exception was not raised");
+}
+float decode(std::uint16_t word) { return std::bit_cast<float>(static_cast<std::uint32_t>(word) << 16); }
+std::uint16_t nearest(double value) {
+    const auto f = static_cast<float>(value);
+    const auto prefix = std::bit_cast<std::uint32_t>(f) >> 16;
+    const double d0 = std::abs(value - decode(static_cast<std::uint16_t>(prefix)));
+    const double d1 = std::abs(value - decode(static_cast<std::uint16_t>(prefix + 1)));
+    return static_cast<std::uint16_t>(d0 < d1 || (d0 == d1 && !(prefix & 1)) ? prefix : prefix + 1);
+}
+
+// Deterministic planes: codes from a small signed grid (0x7f excluded by the
+// decoder), scales as exact powers of two so tile products stay in FP64 range.
+struct Fixture {
+    std::size_t m, n, k, tile;
+    std::vector<std::uint16_t> a;
+    std::vector<std::uint8_t> codes;
+    std::vector<float> scales;
+    Fixture(std::size_t m_, std::size_t n_, std::size_t k_, std::size_t tile_)
+        : m(m_), n(n_), k(k_), tile(tile_), a(m_ * k_), codes(n_ * k_), scales((n_ / 128 + (n_ % 128 != 0)) * (k_ / 128 + (k_ % 128 != 0))) {
+        for (std::size_t i = 0; i < a.size(); ++i) a[i] = nearest(-1.0 + 0.5 * static_cast<double>((i * 7) % 5));
+        for (std::size_t i = 0; i < codes.size(); ++i) codes[i] = static_cast<std::uint8_t>((i * 11 + 3) % 0x7e);
+        for (std::size_t i = 0; i < scales.size(); ++i)
+            scales[i] = std::exp2(static_cast<float>(static_cast<int>((i * 5) % 9) - 6));
+    }
+};
+
+// Independent oracle: per-element E4M3FN decode re-derived from the bit layout
+// (bias 7, subnormal step 2^-9, no inf in E4M3FN), block-scale lookup and an
+// FP64 dot per output element, rounded the way the fake MME rounds.
+std::vector<std::uint16_t> oracle(const Fixture& f) {
+    const auto element = [&](std::size_t index) {
+        const std::uint8_t code = f.codes[index];
+        const int exponent = (code >> 3) & 0x0f, mantissa = code & 7;
+        double value;
+        if (exponent == 0) value = std::ldexp(mantissa, -9);
+        else value = std::ldexp(1.0 + mantissa / 8.0, exponent - 7);
+        if (code & 0x80) value = -value;
+        return value;
+    };
+    const auto scale_at = [&](std::size_t row, std::size_t column) {
+        return static_cast<double>(f.scales[(row / 128) * ((f.k + 127) / 128) + column / 128]);
+    };
+    std::vector<std::uint16_t> y(f.m * f.n);
+    for (std::size_t r = 0; r < f.m; ++r)
+        for (std::size_t c = 0; c < f.n; ++c) {
+            double sum = 0;
+            for (std::size_t inner = 0; inner < f.k; ++inner)
+                sum += decode(f.a[r * f.k + inner]) *
+                       decode(nearest(element(c * f.k + inner) * scale_at(c, inner)));
+            y[r * f.n + c] = nearest(sum);
+        }
+    return y;
+}
+
+// One signed-magnitude BF16 ulp of slack for the FP32-fma vs FP64 association.
+std::uint16_t monotonic(std::uint16_t word) {
+    return word ^ ((word >> 15) ? 0xffffu : 0u);
+}
+bool within_one_ulp(std::uint16_t got, std::uint16_t want) {
+    if (got == want) return true;
+    if (decode(got) == 0 && decode(want) == 0) return true;
+    const auto distance = static_cast<int>(monotonic(got)) - static_cast<int>(monotonic(want));
+    return distance >= -1 && distance <= 1;
+}
+
+void run_case(const Fixture& f) {
+    {
+        Device device; auto stream = device.create_stream();
+        BlockFp8Linear linear(device, f.m, BlockFp8Matrix{f.n, f.k}, f.tile, 1 << 20);
+        require(linear.rows() == f.n && linear.columns() == f.k && linear.tile_rows() == f.tile,
+                "linear geometry");
+        std::vector<std::uint16_t> y(f.m * f.n, 0xdead);
+        linear.run(stream, f.a, f.codes, f.scales, y);
+        const auto expected = oracle(f);
+        for (std::size_t i = 0; i < y.size(); ++i)
+            if (!within_one_ulp(y[i], expected[i])) {
+                std::fprintf(stderr, "m=%zu n=%zu k=%zu tile=%zu i=%zu (r=%zu,c=%zu) got=%04x want=%04x "
+                                     "(%g vs %g)\n", f.m, f.n, f.k, f.tile, i, i / f.n, i % f.n,
+                             y[i], expected[i], decode(y[i]), decode(expected[i]));
+                throw std::runtime_error("W8A16 result differs from the independent oracle");
+            }
+    }
+    fake_synapse::assert_clean();
+}
+
+void math_and_tiling() {
+    // Rectangular multi-tile case with partial 128-block edges on both axes.
+    run_case(Fixture{2, 384, 260, 128});
+    // Decode-like shape: one token, single tile spanning several blocks.
+    run_case(Fixture{1, 256, 512, 256});
+    // tile < 128 exercises half-block scale coverage on the row axis.
+    run_case(Fixture{3, 192, 128, 64});
+}
+
+void invalid_and_failure_paths() {
+    const Fixture f{1, 256, 128, 128};
+    std::vector<std::uint16_t> y(f.m * f.n, 0xdead);
+    {
+        Device device; auto stream = device.create_stream();
+        rejects<std::invalid_argument>([&] {
+            BlockFp8Linear linear(device, 0, BlockFp8Matrix{f.n, f.k}, f.tile, 1 << 20); (void)linear;
+        });
+        rejects<std::invalid_argument>([&] {
+            BlockFp8Linear linear(device, f.m, BlockFp8Matrix{257, f.k}, 128, 1 << 20); (void)linear;
+        });
+        BlockFp8Linear linear(device, f.m, BlockFp8Matrix{f.n, f.k}, f.tile, 1 << 20);
+        rejects<std::invalid_argument>([&] {
+            (void)linear.run(stream, std::span(f.a).first(f.a.size() - 1), f.codes, f.scales, y);
+        });
+        rejects<std::invalid_argument>([&] {
+            (void)linear.run(stream, f.a, std::span(f.codes).first(f.codes.size() - 1), f.scales, y);
+        });
+        auto poisoned = f.scales; poisoned[1] = -1;
+        rejects<std::invalid_argument>([&] { (void)linear.run(stream, f.a, f.codes, poisoned, y); });
+        poisoned = f.scales; poisoned[0] = std::numeric_limits<float>::quiet_NaN();
+        rejects<std::invalid_argument>([&] { (void)linear.run(stream, f.a, f.codes, poisoned, y); });
+        require(y == std::vector<std::uint16_t>(f.m * f.n, 0xdead), "rejected runs must not publish");
+
+        // A failed launch in the FIRST tile must leave y untouched.
+        fake_synapse::fail_next("synLaunchWithExternalEventsExt");
+        try {
+            linear.run(stream, f.a, f.codes, f.scales, y);
+            throw std::runtime_error("injected launch failure was not raised");
+        } catch (const SynapseError&) {
+        }
+        require(y == std::vector<std::uint16_t>(f.m * f.n, 0xdead), "failed run published output");
+
+        // Happy path again after the injection, to prove no state leaked.
+        linear.run(stream, f.a, f.codes, f.scales, y);
+        const auto expected = oracle(f);
+        for (std::size_t i = 0; i < y.size(); ++i)
+            require(within_one_ulp(y[i], expected[i]), "post-failure rerun diverges from the oracle");
+    }
+    fake_synapse::assert_clean();
+}
+} // namespace
+
+int main() {
+    try {
+        math_and_tiling();
+        invalid_and_failure_paths();
+        std::puts("block-FP8 W8A16 linear matches the independent oracle across tiles");
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n'; return 1;
+    }
+}
