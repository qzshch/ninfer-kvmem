+                ninfer::KvCacheStorage::RotatedInt4KeyInt4ValueE8, ninfer::KvCacheStorage::RotatedE8RootKeyInt4Value}) {
+            for (std::uint32_t lanes = 2; lanes <= 8; ++lanes) {
