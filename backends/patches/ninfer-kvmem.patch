+    auto d_norm = upload(round_trip(norm_w));
+    auto d_wq = upload(round_trip(wq));
+    auto d_wk = upload(round_trip(wk));
+    auto d_wv = upload(round_trip(wv));
+    auto d_cq = upload(round_trip(conv_q));
+    auto d_ck = upload(round_trip(conv_k));
+    auto d_cv = upload(round_trip(conv_v));
+    auto d_fa = upload(round_trip(f_a));
+    auto d_fb = upload(round_trip(f_b));
+    auto d_beta = upload(round_trip(beta_w));
+    auto d_ga = upload(round_trip(g_a));
+    auto d_gb = upload(round_trip(g_b));
+    auto d_wo = upload(round_trip(wo));
+    auto d_dt = upload(round_trip(dt_bias));
+    auto d_alog = upload(a_log);
+    auto d_onw = upload(o_norm_w);
