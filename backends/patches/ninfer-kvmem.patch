index 0000000000000000000000000000000000000000..762caaedcd7cf9028ba47b19148d6a6e379fe91b
--- /dev/null
+++ b/src/ops/glm5_kda/glm5_kda.cu
@@ -0,0 +1,182 @@
+// ninfer::ops - GLM-5.3-Flash KDA launchers (decode path).
+#include "ninfer/ops/glm5_kda.h"
+
+#include "ops/kernel/glm5_kda.cuh"
+#include "core/device.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::ops {
+
+namespace {
+
+void require_contiguous(const Tensor& tensor, const char* what) {
+    if (!tensor.is_contiguous()) { throw std::invalid_argument(std::string(what) + " must be contiguous"); }
+}
+
+void require_shape(const Tensor& tensor, DType dtype, std::initializer_list<std::int32_t> shape,
+                   const char* what) {
+    require_contiguous(tensor, what);
+    if (tensor.dtype != dtype) {
+        throw std::invalid_argument(std::string(what) + " has the wrong dtype");
+    }
+    int index = 0;
+    for (const auto extent : shape) {
+        if (tensor.ne[index] != extent) {
+            throw std::invalid_argument(std::string(what) + " has the wrong shape");
+        }
+        ++index;
+    }
+}
+
+std::int32_t dim0(const Tensor& tensor) { return tensor.ne[0]; }
+std::int32_t dim1(const Tensor& tensor) { return tensor.ne[1]; }
+
+void require_disjoint(const Tensor& a, const Tensor& b) {
+    const auto a_begin = reinterpret_cast<std::uintptr_t>(a.data);
+    const auto b_begin = reinterpret_cast<std::uintptr_t>(b.data);
+    const auto a_end = a_begin + a.bytes();
+    const auto b_end = b_begin + b.bytes();
+    if (a_begin < b_end && b_begin < a_end) {
+        throw std::invalid_argument("glm5_kda operands must not overlap");
+    }
+}
+
+} // namespace
+
+void glm5_kda_gating(const Tensor& a, const Tensor& b, const Tensor& A_log, float lower_bound,
+                     Tensor& gate, Tensor& beta, cudaStream_t stream) {
+    const std::int32_t d_inner = dim1(a);
+    const std::int32_t tokens = dim0(a);
+    const std::int32_t heads = dim1(b);
+    if (d_inner <= 0 || tokens <= 0 || heads <= 0 || d_inner % heads != 0) {
+        throw std::invalid_argument("glm5_kda_gating: a [T, d_inner] and b [T, heads] disagree");
+    }
+    require_shape(a, DType::BF16, {tokens, d_inner}, "glm5_kda_gating: a");
+    require_shape(b, DType::BF16, {tokens, heads}, "glm5_kda_gating: b");
+    require_shape(A_log, DType::FP32, {heads}, "glm5_kda_gating: A_log");
+    require_shape(gate, DType::FP32, {tokens, d_inner}, "glm5_kda_gating: gate");
+    require_shape(beta, DType::FP32, {tokens, heads}, "glm5_kda_gating: beta");
+    if (!std::isfinite(lower_bound) || lower_bound >= 0) {
+        throw std::invalid_argument("glm5_kda_gating: lower_bound must be negative finite");
+    }
+    require_disjoint(a, gate); require_disjoint(a, beta);
+    require_disjoint(b, gate); require_disjoint(b, beta);
+
+    const std::int64_t gate_elements = static_cast<std::int64_t>(tokens) * d_inner;
+    const auto gate_blocks = static_cast<unsigned int>(
+        (gate_elements + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::decay_gate_kernel<<<gate_blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(a.data), static_cast<const float*>(A_log.data),
+        lower_bound, d_inner, d_inner / heads, gate_elements,
+        static_cast<float*>(gate.data));
+    const std::int64_t beta_elements = static_cast<std::int64_t>(tokens) * heads;
+    const auto beta_blocks = static_cast<unsigned int>(
+        (beta_elements + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::beta_kernel<<<beta_blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(b.data), beta_elements,
+        static_cast<float*>(beta.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_kda_conv(const Tensor& x, const Tensor& w, Tensor& conv_state, Tensor& out,
+                   cudaStream_t stream) {
+    const std::int32_t d_inner = dim1(x);
+    const std::int32_t tokens = dim0(x);
+    const std::int32_t taps = dim0(w);
+    if (d_inner <= 0 || tokens <= 0 || taps < 2 || taps > 8) {
+        throw std::invalid_argument("glm5_kda_conv: bad x/w geometry");
+    }
+    require_shape(x, DType::BF16, {tokens, d_inner}, "glm5_kda_conv: x");
+    require_shape(w, DType::BF16, {taps, d_inner}, "glm5_kda_conv: w");
+    require_shape(conv_state, DType::FP32, {taps - 1, d_inner}, "glm5_kda_conv: conv_state");
+    require_shape(out, DType::BF16, {tokens, d_inner}, "glm5_kda_conv: out");
+    require_disjoint(x, out); require_disjoint(x, conv_state); require_disjoint(w, out);
+
+    const std::int64_t elements = static_cast<std::int64_t>(tokens) * d_inner;
+    const auto blocks = static_cast<unsigned int>(
+        (elements + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::conv_kernel<<<blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(x.data), static_cast<const __nv_bfloat16*>(w.data),
+        static_cast<const float*>(conv_state.data), d_inner, taps, tokens,
+        static_cast<__nv_bfloat16*>(out.data));
+    const auto slide_blocks = static_cast<unsigned int>(
+        (d_inner + glm5_kda_detail::kElementThreads - 1) / glm5_kda_detail::kElementThreads);
+    glm5_kda_detail::conv_slide_kernel<<<slide_blocks, glm5_kda_detail::kElementThreads, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(x.data), static_cast<const float*>(conv_state.data),
+        d_inner, taps, tokens, static_cast<float*>(conv_state.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_kda_decode_step(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                          const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                          Tensor& state, Tensor& out, cudaStream_t stream) {
+    const std::int32_t d_inner = dim0(q);
+    const std::int32_t heads = dim0(beta);
+    if (d_inner <= 0 || heads <= 0 || d_inner % heads != 0) {
+        throw std::invalid_argument("glm5_kda_decode_step: bad q/beta geometry");
+    }
+    const std::int32_t dk = d_inner / heads;
+    if (dk <= 0 || dk > glm5_kda_detail::kDecodeBlock) {
+        throw std::invalid_argument("glm5_kda_decode_step: head dim must be <= 256");
+    }
+    require_shape(q, DType::BF16, {d_inner}, "glm5_kda_decode_step: q");
+    require_shape(k, DType::BF16, {d_inner}, "glm5_kda_decode_step: k");
+    require_shape(v, DType::BF16, {d_inner}, "glm5_kda_decode_step: v");
+    require_shape(gate, DType::FP32, {d_inner}, "glm5_kda_decode_step: gate");
+    require_shape(beta, DType::FP32, {heads}, "glm5_kda_decode_step: beta");
+    require_shape(g2, DType::BF16, {d_inner}, "glm5_kda_decode_step: g2");
+    require_shape(o_norm_w, DType::FP32, {dk}, "glm5_kda_decode_step: o_norm_w");
+    require_shape(state, DType::FP32, {dk, dk, heads}, "glm5_kda_decode_step: state");
+    require_shape(out, DType::BF16, {d_inner}, "glm5_kda_decode_step: out");
+    require_disjoint(q, out); require_disjoint(k, out); require_disjoint(v, out);
+    require_disjoint(g2, out);
+
+    glm5_kda_detail::decode_step_kernel<<<static_cast<unsigned int>(heads),
+                                          glm5_kda_detail::kDecodeBlock, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data), static_cast<const __nv_bfloat16*>(k.data),
+        static_cast<const __nv_bfloat16*>(v.data), static_cast<const float*>(gate.data),
+        static_cast<const float*>(beta.data), static_cast<const __nv_bfloat16*>(g2.data),
+        static_cast<const float*>(o_norm_w.data), static_cast<float*>(state.data),
+        static_cast<__nv_bfloat16*>(out.data), dk);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void glm5_kda_prefill(const Tensor& q, const Tensor& k, const Tensor& v, const Tensor& gate,
+                      const Tensor& beta, const Tensor& g2, const Tensor& o_norm_w,
+                      Tensor& state, Tensor& out, cudaStream_t stream) {
+    const std::int32_t tokens = dim1(q);
+    const std::int32_t d_inner = dim0(q);
+    const std::int32_t heads = dim0(beta);
+    if (d_inner <= 0 || heads <= 0 || tokens <= 0 || d_inner % heads != 0) {
+        throw std::invalid_argument("glm5_kda_prefill: bad geometry");
+    }
+    const std::int32_t dk = d_inner / heads;
+    if (dk <= 0 || dk > glm5_kda_detail::kDecodeBlock) {
+        throw std::invalid_argument("glm5_kda_prefill: head dim must be <= 256");
+    }
+    require_shape(q, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: q");
+    require_shape(k, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: k");
+    require_shape(v, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: v");
+    require_shape(gate, DType::FP32, {d_inner, tokens}, "glm5_kda_prefill: gate");
+    require_shape(beta, DType::FP32, {heads, tokens}, "glm5_kda_prefill: beta");
+    require_shape(g2, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: g2");
+    require_shape(o_norm_w, DType::FP32, {dk}, "glm5_kda_prefill: o_norm_w");
+    require_shape(state, DType::FP32, {dk, dk, heads}, "glm5_kda_prefill: state");
+    require_shape(out, DType::BF16, {d_inner, tokens}, "glm5_kda_prefill: out");
+    require_disjoint(q, out); require_disjoint(k, out); require_disjoint(v, out);
+    require_disjoint(g2, out);
+
+    glm5_kda_detail::prefill_kernel<<<static_cast<unsigned int>(heads),
+                                      glm5_kda_detail::kDecodeBlock, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data), static_cast<const __nv_bfloat16*>(k.data),
+        static_cast<const __nv_bfloat16*>(v.data), static_cast<const float*>(gate.data),
+        static_cast<const float*>(beta.data), static_cast<const __nv_bfloat16*>(g2.data),
+        static_cast<const float*>(o_norm_w.data), static_cast<float*>(state.data),
+        static_cast<__nv_bfloat16*>(out.data), dk, d_inner, heads, tokens);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops
