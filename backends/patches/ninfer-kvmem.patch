diff --git a/tests/ops/test_glm5_dsa.cu b/tests/ops/test_glm5_dsa.cu
new file mode 100644
index 0000000..9d1f336
--- /dev/null
+++ b/tests/ops/test_glm5_dsa.cu
@@ -0,0 +1,303 @@
+// GLM-5.3-Flash DSA ops and the KDA prefill loop against the ported host references, on the
+// device. Small shapes pin the semantics (pool softmax, ReLU scoring, rank ties, tail,
+// -1 exclusion); the audited 32x128/512-latent/2051-width profile runs end to end.
+#include "ninfer/ops/glm5_dsa.h"
+#include "ninfer/ops/glm5_kda.h"
+#include "models/glm5/reference/dsa_reference.h"
+#include "models/glm5/reference/kda_reference.h"
+
+#include "core/device.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace ninfer;
+using namespace ninfer::ops;
+namespace DsaRef = ninfer::models::glm5::reference;
+namespace KdaRef = ninfer::models::glm5::reference;
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 17u) - 8) / 8.0f;
+}
+
+std::vector<__nv_bfloat16> round_trip(const std::vector<float>& values) {
+    std::vector<__nv_bfloat16> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __float2bfloat16(values[i]); }
+    return out;
+}
+std::vector<float> represented(const std::vector<__nv_bfloat16>& values) {
+    std::vector<float> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __bfloat162float(values[i]); }
+    return out;
+}
+
+test::GuardedDeviceBuffer upload(const void* data, std::size_t bytes) {
+    test::GuardedDeviceBuffer buffer(bytes);
+    buffer.copy_from_host(data, bytes);
+    return buffer;
+}
+template <typename T> test::GuardedDeviceBuffer upload(const std::vector<T>& values) {
+    return upload(values.data(), values.size() * sizeof(T));
+}
+template <typename T> std::vector<T> download(const test::GuardedDeviceBuffer& buffer) {
+    std::vector<T> out(buffer.bytes() / sizeof(T));
+    buffer.copy_to_host(out.data(), out.size() * sizeof(T));
+    return out;
+}
+
+int failures = 0;
+
+void check_close(const std::string& what, const std::vector<float>& got,
+                 const std::vector<float>& want, float tolerance) {
+    if (got.size() != want.size()) {
+        std::fprintf(stderr, "%s: size %zu vs %zu\n", what.c_str(), got.size(), want.size());
+        ++failures;
+        return;
+    }
+    for (std::size_t i = 0; i < got.size(); ++i) {
+        const float error = std::abs(got[i] - want[i]);
+        const float scale = std::max(1.0f, std::abs(want[i]));
+        if (error > tolerance * scale) {
+            if (failures < 10) {
+                std::fprintf(stderr, "%s[%zu]: %.7g vs %.7g\n", what.c_str(), i, got[i], want[i]);
+            }
+            ++failures;
+        }
+    }
+}
+
+void check_cells(const std::string& what, const std::vector<std::int32_t>& got,
+                 const std::vector<std::int32_t>& want) {
+    if (got != want) {
+        ++failures;
+        if (failures <= 10) {
+            for (std::size_t i = 0; i < got.size() && i < 16; ++i) {
+                if (got[i] != want[i]) {
+                    std::fprintf(stderr, "%s[%zu]: %d vs %d\n", what.c_str(), i, got[i], want[i]);
+                }
+            }
+        }
+    }
+}
+
+void run_dsa_case(std::uint32_t heads, std::uint32_t dim, std::uint32_t kpool,
+                  std::uint32_t top_k, std::uint32_t tokens, std::uint32_t lora,
+                  std::uint32_t v_head, std::uint32_t qk_nope) {
+    const DsaRef::DsaIndexerProfile profile{heads, dim, kpool, top_k, true};
+    const DsaRef::DsaMlaProfile mla{lora, 2, qk_nope, v_head};
+    const std::uint32_t pools = tokens / kpool;
+    const std::uint32_t top_pools = top_k / kpool;
+    const std::uint32_t width = top_k + kpool - 1;
+    const std::string label = "h" + std::to_string(heads) + " d" + std::to_string(dim);
+
+    // pool + score + select chain on the device.
+    std::vector<float> ik(tokens * dim), ig(tokens * dim), ape(kpool * dim);
+    for (std::size_t i = 0; i < ik.size(); ++i) {
+        ik[i] = source(static_cast<std::uint32_t>(i) + 3);
+        ig[i] = source(static_cast<std::uint32_t>(i) * 3 + 1) / 2;
+    }
+    for (std::size_t i = 0; i < ape.size(); ++i) { ape[i] = source(static_cast<std::uint32_t>(i) * 5 + 7) / 4; }
+    std::vector<float> pooled_want(pools * dim);
+    DsaRef::dsa_pool_reference(represented(round_trip(ik)), represented(round_trip(ig)), ape,
+                               pooled_want, profile);
+
+    std::vector<float> iq(heads * dim), weights_raw(heads), weights_device(heads);
+    for (std::size_t i = 0; i < iq.size(); ++i) { iq[i] = source(static_cast<std::uint32_t>(i) + 11) / 3; }
+    // The device kernel takes weights pre-scaled by 1/sqrt(dim*heads); the host reference
+    // applies its own two-factor scaling to raw weights.
+    const float combined_scale = std::sqrt(1.0f / (static_cast<float>(dim) * heads));
+    for (std::uint32_t h = 0; h < heads; ++h) {
+        weights_raw[h] = source(h * 7 + 2);
+        weights_device[h] = weights_raw[h] * combined_scale;
+    }
+    std::vector<float> score_want(pools);
+    DsaRef::dsa_score_reference(represented(round_trip(iq)), weights_raw, pooled_want, score_want,
+                                profile);
+
+    const std::uint32_t position = tokens - 1;
+    std::vector<std::int32_t> cells_want(width);
+    {
+        std::vector<float> score_transposed;   // host reference takes [tokens][pools]; one row.
+        score_transposed = score_want;
+        std::vector<std::uint32_t> pos{position};
+        DsaRef::dsa_select_reference(score_transposed, pos, cells_want, profile);
+    }
+
+    auto d_ik = upload(round_trip(ik));
+    auto d_ig = upload(round_trip(ig));
+    auto d_ape = upload(ape);
+    test::GuardedDeviceBuffer d_pooled(pooled_want.size() * sizeof(float));
+    {
+        Tensor ikt(const_cast<void*>(d_ik.data()), DType::BF16,
+                   {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(dim)});
+        Tensor igt(const_cast<void*>(d_ig.data()), DType::BF16,
+                   {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(dim)});
+        Tensor apt(const_cast<void*>(d_ape.data()), DType::FP32,
+                   {static_cast<std::int32_t>(kpool), static_cast<std::int32_t>(dim)});
+        Tensor pt(const_cast<void*>(d_pooled.data()), DType::FP32,
+                  {static_cast<std::int32_t>(pools), static_cast<std::int32_t>(dim)});
+        glm5_dsa_pool(ikt, igt, apt, pt, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("pooled[" + label + "]", download<float>(d_pooled), pooled_want, 2e-4f);
+
+    auto d_iq = upload(round_trip(iq));
+    auto d_weights = upload(weights_device);
+    test::GuardedDeviceBuffer d_score(score_want.size() * sizeof(float));
+    {
+        Tensor iqt(const_cast<void*>(d_iq.data()), DType::BF16,
+                   {static_cast<std::int32_t>(heads), static_cast<std::int32_t>(dim)});
+        Tensor pt(const_cast<void*>(d_pooled.data()), DType::FP32,
+                  {static_cast<std::int32_t>(pools), static_cast<std::int32_t>(dim)});
+        Tensor wt(const_cast<void*>(d_weights.data()), DType::FP32, {static_cast<std::int32_t>(heads)});
+        Tensor st(const_cast<void*>(d_score.data()), DType::FP32, {static_cast<std::int32_t>(pools)});
+        glm5_dsa_score(iqt, pt, wt, st, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("score[" + label + "]", download<float>(d_score), score_want, 2e-4f);
+
+    test::GuardedDeviceBuffer d_cells(width * sizeof(std::int32_t));
+    {
+        Tensor st(const_cast<void*>(d_score.data()), DType::FP32, {static_cast<std::int32_t>(pools)});
+        Tensor ct(const_cast<void*>(d_cells.data()), DType::I32,
+                  {static_cast<std::int32_t>(width)});
+        glm5_dsa_select(st, position, static_cast<std::int32_t>(top_pools), true, ct, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_cells("cells[" + label + "]", download<std::int32_t>(d_cells), cells_want);
+
+    // attention over the selected cells
+    std::vector<float> q_abs(mla.heads * lora), latents(tokens * lora),
+        wv_b(lora * v_head * mla.heads);
+    for (std::size_t i = 0; i < q_abs.size(); ++i) { q_abs[i] = source(static_cast<std::uint32_t>(i) * 2 + 1) / 3; }
+    for (std::size_t i = 0; i < latents.size(); ++i) { latents[i] = source(static_cast<std::uint32_t>(i) + 4) / 3; }
+    for (std::size_t i = 0; i < wv_b.size(); ++i) { wv_b[i] = source(static_cast<std::uint32_t>(i) * 7 + 2) / 4; }
+    std::vector<float> out_want(mla.heads * v_head);
+    DsaRef::dsa_attention_reference(represented(round_trip(q_abs)),
+                                    represented(round_trip(latents)), cells_want,
+                                    represented(round_trip(wv_b)), out_want, profile, mla, tokens);
+
+    auto d_qabs = upload(round_trip(q_abs));
+    auto d_latents = upload(round_trip(latents));
+    auto d_wvb = upload(round_trip(wv_b));
+    test::GuardedDeviceBuffer d_out(out_want.size() * sizeof(__nv_bfloat16));
+    {
+        Tensor qt(const_cast<void*>(d_qabs.data()), DType::BF16,
+                  {static_cast<std::int32_t>(mla.heads), static_cast<std::int32_t>(lora)});
+        Tensor lt(const_cast<void*>(d_latents.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(lora)});
+        Tensor ct(const_cast<void*>(d_cells.data()), DType::I32, {static_cast<std::int32_t>(width)});
+        Tensor wt(const_cast<void*>(d_wvb.data()), DType::BF16,
+                  {static_cast<std::int32_t>(lora), static_cast<std::int32_t>(v_head),
+                   static_cast<std::int32_t>(mla.heads)});
+        Tensor ot(const_cast<void*>(d_out.data()), DType::BF16,
+                  {static_cast<std::int32_t>(mla.heads * v_head)});
+        glm5_dsa_attention(qt, lt, ct, wt, ot, static_cast<std::int32_t>(qk_nope), nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("attention[" + label + "]", represented(download<__nv_bfloat16>(d_out)), out_want,
+                2e-2f);
+}
+
+void run_prefill_case(std::uint32_t heads, std::uint32_t dk, std::uint32_t tokens) {
+    const KdaRef::KdaProfile profile{heads, dk, 4, -5.0f};
+    const std::uint32_t d_inner = heads * dk;
+    const std::string label = "h" + std::to_string(heads) + " t" + std::to_string(tokens);
+
+    std::vector<float> q(tokens * d_inner), k(tokens * d_inner), v(tokens * d_inner),
+        gate(tokens * d_inner), beta(tokens * heads), g2(tokens * d_inner), o_norm_w(dk),
+        state0(KdaRef::kda_state_values(profile));
+    for (std::size_t i = 0; i < q.size(); ++i) {
+        q[i] = source(static_cast<std::uint32_t>(i) * 2 + 1);
+        k[i] = source(static_cast<std::uint32_t>(i) * 2 + 2);
+        v[i] = source(static_cast<std::uint32_t>(i) * 2 + 3) / 2;
+        gate[i] = source(static_cast<std::uint32_t>(i) * 2 + 4) / 3 - 0.25f;
+        g2[i] = source(static_cast<std::uint32_t>(i) * 11 + 3) / 4;
+    }
+    for (std::size_t i = 0; i < beta.size(); ++i) { beta[i] = 0.25f + 0.5f * (i % 3) / 3.0f; }
+    for (std::uint32_t i = 0; i < dk; ++i) { o_norm_w[i] = 1.0f + source(i) / 8; }
+    for (std::size_t i = 0; i < state0.size(); ++i) { state0[i] = source(static_cast<std::uint32_t>(i)) / 5; }
+
+    // Host reference: gated delta over all tokens then the output gate per token.
+    std::vector<float> scan_out(tokens * d_inner), scan_state = state0,
+        scratch(KdaRef::kda_scan_scratch_values(profile, tokens));
+    KdaRef::kda_gated_delta_reference(q, k, v, gate, beta, scan_state, scan_out, scratch, profile);
+    std::vector<float> gated(tokens * d_inner);
+    for (std::uint32_t t = 0; t < tokens; ++t) {
+        KdaRef::kda_out_gate_reference(
+            std::vector<float>(scan_out.begin() + t * d_inner, scan_out.begin() + (t + 1) * d_inner),
+            std::vector<float>(g2.begin() + t * d_inner, g2.begin() + (t + 1) * d_inner), o_norm_w,
+            std::span<float>(gated).subspan(t * d_inner, d_inner), profile);
+    }
+
+    auto d_q = upload(round_trip(q));
+    auto d_k = upload(round_trip(k));
+    auto d_v = upload(round_trip(v));
+    auto d_gate = upload(gate);
+    auto d_beta = upload(beta);
+    auto d_g2 = upload(round_trip(g2));
+    auto d_onw = upload(o_norm_w);
+    auto d_state = upload(state0);
+    test::GuardedDeviceBuffer d_out(gated.size() * sizeof(__nv_bfloat16));
+    {
+        Tensor qt(const_cast<void*>(d_q.data()), DType::BF16,
+                  {static_cast<std::int32_t>(d_inner), static_cast<std::int32_t>(tokens)});
+        Tensor kt(const_cast<void*>(d_k.data()), DType::BF16,
+                  {static_cast<std::int32_t>(d_inner), static_cast<std::int32_t>(tokens)});
+        Tensor vt(const_cast<void*>(d_v.data()), DType::BF16,
+                  {static_cast<std::int32_t>(d_inner), static_cast<std::int32_t>(tokens)});
+        Tensor gt(const_cast<void*>(d_gate.data()), DType::FP32,
+                  {static_cast<std::int32_t>(d_inner), static_cast<std::int32_t>(tokens)});
+        Tensor bt(const_cast<void*>(d_beta.data()), DType::FP32,
+                  {static_cast<std::int32_t>(heads), static_cast<std::int32_t>(tokens)});
+        Tensor g2t(const_cast<void*>(d_g2.data()), DType::BF16,
+                   {static_cast<std::int32_t>(d_inner), static_cast<std::int32_t>(tokens)});
+        Tensor wt(const_cast<void*>(d_onw.data()), DType::FP32, {static_cast<std::int32_t>(dk)});
+        Tensor st(const_cast<void*>(d_state.data()), DType::FP32,
+                  {static_cast<std::int32_t>(dk), static_cast<std::int32_t>(dk), static_cast<std::int32_t>(heads)});
+        Tensor ot(const_cast<void*>(d_out.data()), DType::BF16,
+                  {static_cast<std::int32_t>(d_inner), static_cast<std::int32_t>(tokens)});
+        glm5_kda_prefill(qt, kt, vt, gt, bt, g2t, wt, st, ot, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("prefill_state[" + label + "]", download<float>(d_state), scan_state, 2e-3f);
+    check_close("prefill_out[" + label + "]", represented(download<__nv_bfloat16>(d_out)), gated,
+                2e-2f);
+}
+
+int run() {
+    run_dsa_case(2, 6, 4, 8, 16, 12, 5, 8);       // small probe
+    run_dsa_case(32, 128, 4, 2048, 4096, 512, 256, 256);   // the audited profile
+    run_prefill_case(2, 8, 5);
+    run_prefill_case(64, 128, 4);
+    if (failures == 0) {
+        std::puts("GLM5 DSA pool/score/select/attention and KDA prefill match the host reference on device");
+        return 0;
+    }
+    std::fprintf(stderr, "%d numeric failures\n", failures);
+    return 1;
+}
+
+} // namespace
+
+int main() {
+    try {
+        return run();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "FATAL: %s\n", error.what());
+        return 1;
+    } catch (...) {
+        std::fprintf(stderr, "FATAL: unknown exception\n");
+        return 1;
+    }
+}
diff --git a/tests/ops/test_glm5_kda.cu b/tests/ops/test_glm5_kda.cu
new file mode 100644
index 0000000..04c022e
--- /dev/null
+++ b/tests/ops/test_glm5_kda.cu
@@ -0,0 +1,227 @@
+// GLM-5.3-Flash KDA decode ops against the ported host reference (models/glm5/reference),
+// on the real device. Small shapes pin the semantics; the audited 64x128 profile runs the
+// whole decode chain (conv -> gate -> recurrent step -> output gate) end to end.
+#include "ninfer/ops/glm5_kda.h"
+#include "models/glm5/reference/kda_reference.h"
+
+#include "core/device.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace ninfer;
+using namespace ninfer::ops;
+namespace Reference = ninfer::models::glm5::reference;
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 19u) - 9) / 8.0f;
+}
+
+std::vector<__nv_bfloat16> round_trip(const std::vector<float>& values) {
+    std::vector<__nv_bfloat16> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __float2bfloat16(values[i]); }
+    return out;
+}
+
+std::vector<float> represented(const std::vector<__nv_bfloat16>& values) {
+    std::vector<float> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __bfloat162float(values[i]); }
+    return out;
+}
+
+int failures = 0;
+
+void check_close(const std::string& what, const std::vector<float>& got,
+                 const std::vector<float>& want, float tolerance) {
+    if (got.size() != want.size()) {
+        std::fprintf(stderr, "%s: size %zu vs %zu\n", what.c_str(), got.size(), want.size());
+        ++failures;
+        return;
+    }
+    for (std::size_t i = 0; i < got.size(); ++i) {
+        const float error = std::abs(got[i] - want[i]);
+        const float scale = std::max(1.0f, std::abs(want[i]));
+        if (error > tolerance * scale) {
+            if (failures < 10) {
+                std::fprintf(stderr, "%s[%zu]: %.7g vs %.7g\n", what.c_str(), i, got[i], want[i]);
+            }
+            ++failures;
+        }
+    }
+}
+
+// Upload/download helpers over the guarded buffer's byte-level API.
+test::GuardedDeviceBuffer upload(const void* data, std::size_t bytes) {
+    test::GuardedDeviceBuffer buffer(bytes);
+    buffer.copy_from_host(data, bytes);
+    return buffer;
+}
+template <typename T> test::GuardedDeviceBuffer upload(const std::vector<T>& values) {
+    return upload(values.data(), values.size() * sizeof(T));
+}
+template <typename T> std::vector<T> download(const test::GuardedDeviceBuffer& buffer) {
+    std::vector<T> out(buffer.bytes() / sizeof(T));
+    buffer.copy_to_host(out.data(), out.size() * sizeof(T));
+    return out;
+}
+
+void run_case(std::uint32_t heads, std::uint32_t dk, std::uint32_t taps, std::uint32_t tokens) {
+    const Reference::KdaProfile profile{heads, dk, taps, -5.0f};
+    const std::uint32_t d_inner = heads * dk;
+    const std::string label = "h" + std::to_string(heads) + " d" + std::to_string(dk) +
+                              " t" + std::to_string(tokens);
+
+    // ---- gating: decay gate (log space) and beta ----
+    std::vector<float> a_plane(tokens * d_inner), b_plane(tokens * heads), a_log(heads);
+    for (std::size_t i = 0; i < a_plane.size(); ++i) { a_plane[i] = source(static_cast<std::uint32_t>(i)); }
+    for (std::size_t i = 0; i < b_plane.size(); ++i) { b_plane[i] = source(static_cast<std::uint32_t>(i) * 3 + 1); }
+    for (std::uint32_t h = 0; h < heads; ++h) { a_log[h] = -0.5f + 0.25f * static_cast<float>(h); }
+    const auto a_bf = round_trip(a_plane);
+    const auto b_bf = round_trip(b_plane);
+
+    std::vector<float> gate_want(tokens * d_inner), beta_want(tokens * heads);
+    Reference::kda_decay_gate_reference(represented(a_bf), a_log, gate_want, profile);
+    {
+        const auto b_repr = represented(b_bf);
+        for (std::size_t i = 0; i < beta_want.size(); ++i) {
+            beta_want[i] = static_cast<float>(1.0 / (1.0 + std::exp(-static_cast<double>(b_repr[i]))));
+        }
+    }
+
+    auto d_a = upload(a_bf);
+    auto d_b = upload(b_bf);
+    auto d_a_log = upload(a_log);
+    test::GuardedDeviceBuffer d_gate(gate_want.size() * sizeof(float));
+    test::GuardedDeviceBuffer d_beta(beta_want.size() * sizeof(float));
+    {
+        Tensor a(const_cast<void*>(d_a.data()), DType::BF16,
+                 {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(d_inner)});
+        Tensor b(const_cast<void*>(d_b.data()), DType::BF16,
+                 {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(heads)});
+        Tensor log_t(const_cast<void*>(d_a_log.data()), DType::FP32, {static_cast<std::int32_t>(heads)});
+        Tensor g(const_cast<void*>(d_gate.data()), DType::FP32,
+                 {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(d_inner)});
+        Tensor be(const_cast<void*>(d_beta.data()), DType::FP32,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(heads)});
+        glm5_kda_gating(a, b, log_t, -5.0f, g, be, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("gate[" + label + "]", download<float>(d_gate), gate_want, 5e-5f);
+    check_close("beta[" + label + "]", download<float>(d_beta), beta_want, 5e-5f);
+
+    // ---- conv + state slide ----
+    std::vector<float> x_plane(tokens * d_inner), w_plane(d_inner * taps),
+        conv_state((taps - 1) * d_inner);
+    for (std::size_t i = 0; i < x_plane.size(); ++i) { x_plane[i] = source(static_cast<std::uint32_t>(i) * 5 + 3); }
+    for (std::size_t i = 0; i < w_plane.size(); ++i) { w_plane[i] = source(static_cast<std::uint32_t>(i) * 7 + 1) / 4; }
+    for (std::size_t i = 0; i < conv_state.size(); ++i) { conv_state[i] = source(static_cast<std::uint32_t>(i) + 5) / 3; }
+    const auto x_bf = round_trip(x_plane);
+    const auto w_bf = round_trip(w_plane);
+    std::vector<float> out_want(tokens * d_inner), state_want = conv_state;
+    Reference::kda_conv_reference(represented(x_bf), represented(w_bf), state_want, out_want,
+                                  profile);
+
+    auto d_x = upload(x_bf);
+    auto d_w = upload(w_bf);
+    auto d_state = upload(conv_state);
+    test::GuardedDeviceBuffer d_out(out_want.size() * sizeof(__nv_bfloat16));
+    {
+        Tensor x(const_cast<void*>(d_x.data()), DType::BF16,
+                 {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(d_inner)});
+        Tensor w(const_cast<void*>(d_w.data()), DType::BF16,
+                 {static_cast<std::int32_t>(taps), static_cast<std::int32_t>(d_inner)});
+        Tensor st(const_cast<void*>(d_state.data()), DType::FP32,
+                  {static_cast<std::int32_t>(taps - 1), static_cast<std::int32_t>(d_inner)});
+        Tensor ot(const_cast<void*>(d_out.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(d_inner)});
+        glm5_kda_conv(x, w, st, ot, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("conv[" + label + "]", represented(download<__nv_bfloat16>(d_out)), out_want, 2e-2f);
+    check_close("conv_state[" + label + "]", download<float>(d_state), state_want, 1e-5f);
+
+    // ---- decode step: feed the last token's conv output as q/k/v ----
+    std::vector<float> q(d_inner), k(d_inner), v(d_inner), g2(d_inner), o_norm_w(dk),
+        state0(Reference::kda_state_values(profile));
+    for (std::uint32_t i = 0; i < d_inner; ++i) {
+        q[i] = out_want[(tokens - 1) * d_inner + i];
+        k[i] = out_want[(tokens - 1) * d_inner + i];
+        v[i] = out_want[(tokens - 1) * d_inner + i];
+        g2[i] = source(i * 11 + 7) / 4;
+    }
+    for (std::uint32_t i = 0; i < dk; ++i) { o_norm_w[i] = 1.0f + source(i) / 8; }
+    for (std::size_t i = 0; i < state0.size(); ++i) { state0[i] = source(static_cast<std::uint32_t>(i)) / 5; }
+    std::vector<float> beta_last(heads);
+    for (std::uint32_t h = 0; h < heads; ++h) { beta_last[h] = beta_want[(tokens - 1) * heads + h]; }
+    std::vector<float> gate_last(gate_want.end() - d_inner, gate_want.end());
+
+    std::vector<float> step_out(d_inner), step_state = state0,
+        scratch(Reference::kda_scan_scratch_values(profile, 1));
+    Reference::kda_gated_delta_reference(q, k, v, gate_last, beta_last, step_state, step_out,
+                                         scratch, profile);
+    std::vector<float> gated(d_inner);
+    Reference::kda_out_gate_reference(step_out, g2, o_norm_w, gated, profile);
+
+    auto d_q = upload(round_trip(q));
+    auto d_k = upload(round_trip(k));
+    auto d_v = upload(round_trip(v));
+    auto d_g2 = upload(round_trip(g2));
+    auto d_onw = upload(o_norm_w);
+    auto d_glast = upload(gate_last);
+    auto d_blast = upload(beta_last);
+    auto dstep_state = upload(state0);
+    test::GuardedDeviceBuffer d_step_out(d_inner * sizeof(__nv_bfloat16));
+    {
+        Tensor qt(const_cast<void*>(d_q.data()), DType::BF16, {static_cast<std::int32_t>(d_inner)});
+        Tensor kt(const_cast<void*>(d_k.data()), DType::BF16, {static_cast<std::int32_t>(d_inner)});
+        Tensor vt(const_cast<void*>(d_v.data()), DType::BF16, {static_cast<std::int32_t>(d_inner)});
+        Tensor gt(const_cast<void*>(d_glast.data()), DType::FP32, {static_cast<std::int32_t>(d_inner)});
+        Tensor bt(const_cast<void*>(d_blast.data()), DType::FP32, {static_cast<std::int32_t>(heads)});
+        Tensor g2t(const_cast<void*>(d_g2.data()), DType::BF16, {static_cast<std::int32_t>(d_inner)});
+        Tensor wt(const_cast<void*>(d_onw.data()), DType::FP32, {static_cast<std::int32_t>(dk)});
+        Tensor st(const_cast<void*>(dstep_state.data()), DType::FP32,
+                  {static_cast<std::int32_t>(dk), static_cast<std::int32_t>(dk), static_cast<std::int32_t>(heads)});
+        Tensor ot(const_cast<void*>(d_step_out.data()), DType::BF16, {static_cast<std::int32_t>(d_inner)});
+        glm5_kda_decode_step(qt, kt, vt, gt, bt, g2t, wt, st, ot, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("decode_state[" + label + "]", download<float>(dstep_state), step_state, 2e-3f);
+    check_close("decode_out[" + label + "]", represented(download<__nv_bfloat16>(d_step_out)),
+                gated, 2e-2f);
+}
+
+int run() {
+    run_case(2, 4, 4, 3);      // small probe, sub-warp head
+    run_case(3, 8, 4, 5);      // multi-warp reduction path
+    run_case(64, 128, 4, 2);   // the audited GLM-5.3-Flash profile
+    if (failures == 0) {
+        std::puts("GLM5 KDA gating/conv/decode-step kernels match the host reference on device");
+        return 0;
+    }
+    std::fprintf(stderr, "%d numeric failures\n", failures);
+    return 1;
+}
+
+} // namespace
+
+int main() {
+    try {
+        return run();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "FATAL: %s\n", error.what());
+        return 1;
+    } catch (...) {
+        std::fprintf(stderr, "FATAL: unknown exception\n");
+        return 1;
+    }
+}
diff --git a/tests/ops/test_glm5_kda_chunk.cu b/tests/ops/test_glm5_kda_chunk.cu
new file mode 100644
index 0000000..a7dd68c
--- /dev/null
+++ b/tests/ops/test_glm5_kda_chunk.cu
@@ -0,0 +1,170 @@
+// GLM-5.3-Flash KDA chunked prefill kernel against the host chunk reference
+// (models/glm5/reference/kda_chunk_reference), on the real device. Two
+// geometries: a small one pinning the algorithm shape and a wider one with
+// multiple chunks to exercise the serial state carry between chunks. The
+// reference chain (chunk reference == token-recurrent reference) was verified
+// separately; this test pins kernel == chunk reference.
+#include "ninfer/ops/glm5_kda.h"
+#include "models/glm5/reference/kda_chunk_reference.h"
+
+#include "core/device.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace ninfer;
+using namespace ninfer::ops;
+namespace Reference = ninfer::models::glm5::reference;
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 19u) - 9) / 8.0f;
+}
+
+std::vector<__nv_bfloat16> round_trip(const std::vector<float>& values) {
+    std::vector<__nv_bfloat16> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) out[i] = __float2bfloat16(values[i]);
+    return out;
+}
+
+std::vector<float> represented(const std::vector<__nv_bfloat16>& values) {
+    std::vector<float> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) out[i] = __bfloat162float(values[i]);
+    return out;
+}
+
+int failures = 0;
+
+// Upload/download helpers over the guarded buffer's byte-level API.
+test::GuardedDeviceBuffer upload_bytes(const void* data, std::size_t bytes) {
+    test::GuardedDeviceBuffer buffer(bytes);
+    buffer.copy_from_host(data, bytes);
+    return buffer;
+}
+template <typename T> test::GuardedDeviceBuffer upload_bytes(const std::vector<T>& values) {
+    return upload_bytes(values.data(), values.size() * sizeof(T));
+}
+template <typename T> std::vector<T> download_bytes(const test::GuardedDeviceBuffer& buffer) {
+    std::vector<T> out(buffer.bytes() / sizeof(T));
+    buffer.copy_to_host(out.data(), out.size() * sizeof(T));
+    return out;
+}
+std::vector<float> download_bf16(const test::GuardedDeviceBuffer& buffer) {
+    return represented(download_bytes<__nv_bfloat16>(buffer));
+}
+
+void check_close(const std::string& what, const std::vector<float>& got,
+                 const std::vector<float>& want, float tolerance) {
+    if (got.size() != want.size()) {
+        std::printf("FAIL %s: size %zu vs %zu\n", what.c_str(), got.size(), want.size());
+        ++failures;
+        return;
+    }
+    double worst = 0.0;
+    for (std::size_t i = 0; i < want.size(); ++i) {
+        const double error = std::abs(static_cast<double>(got[i]) - want[i]);
+        const double bound = tolerance * std::max(1.0, std::abs(static_cast<double>(want[i])));
+        if (error > worst) worst = error / std::max(1.0, std::abs(static_cast<double>(want[i])));
+        if (error > bound) {
+            std::printf("FAIL %s [%zu]: got %.6f want %.6f\n", what.c_str(), i, got[i], want[i]);
+            ++failures;
+            return;
+        }
+    }
+    std::printf("ok %s (worst relative %.2e)\n", what.c_str(), worst);
+}
+
+void chunk_case(const std::string& label, std::uint32_t heads, std::uint32_t dk,
+                std::uint32_t chunk, std::uint32_t tokens, bool zero_gate = false) {
+    const std::uint32_t d_inner = heads * dk;
+    const Reference::KdaProfile profile{heads, dk, 4, -5.0f};
+
+    std::vector<float> q(d_inner * tokens), k(d_inner * tokens), v(d_inner * tokens),
+        gate(d_inner * tokens), beta(heads * tokens);
+    for (std::uint32_t i = 0; i < d_inner * tokens; ++i) {
+        q[i] = source(i * 7 + 1);
+        k[i] = source(i * 5 + 3);
+        v[i] = source(i * 3 + 7);
+        // The zero-gate extreme (decay == 1, no attenuation) is the case
+        // where any substitution/norm error accumulates unbounded.
+        gate[i] = zero_gate ? 0.0f
+            : -1.0f - 6.0f * ((i * 2654435761u) % 1000u) / 1000.0f;  // log space
+    }
+    for (std::uint32_t i = 0; i < heads * tokens; ++i)
+        beta[i] = 0.25f + 0.5f * ((i * 40503u) % 1000u) / 1000.0f;
+
+    std::vector<float> state(Reference::kda_state_values(profile));
+    for (std::size_t i = 0; i < state.size(); ++i) state[i] = source(static_cast<std::uint32_t>(i));
+
+    // Host reference on the represented BF16 values (the kernel's inputs).
+    const auto q_bf = round_trip(q), k_bf = round_trip(k), v_bf = round_trip(v);
+    const auto q_rep = represented(q_bf), k_rep = represented(k_bf), v_rep = represented(v_bf);
+    const std::vector<float> state_initial = state;
+    std::vector<float> out_want(q_rep.size());
+    std::vector<float> scratch(Reference::kda_chunk_scratch_values(profile, tokens, chunk));
+    Reference::kda_chunk_reference(q_rep, k_rep, v_rep, gate, beta, state, out_want,
+                                   scratch, profile, chunk);
+
+    // Device run.
+    const auto q_dev = round_trip(q_rep), k_dev = round_trip(k_rep), v_dev = round_trip(v_rep);
+    test::GuardedDeviceBuffer d_q = upload_bytes(q_dev), d_k = upload_bytes(k_dev),
+        d_v = upload_bytes(v_dev), d_gate = upload_bytes(gate), d_beta = upload_bytes(beta),
+        d_state = upload_bytes(state_initial);
+    test::GuardedDeviceBuffer d_out(q_dev.size() * sizeof(__nv_bfloat16));
+
+    const Tensor tq{d_q.data(), DType::BF16, {static_cast<std::int32_t>(d_inner),
+                                            static_cast<std::int32_t>(tokens)}};
+    const Tensor tk{d_k.data(), DType::BF16, {static_cast<std::int32_t>(d_inner),
+                                            static_cast<std::int32_t>(tokens)}};
+    const Tensor tv{d_v.data(), DType::BF16, {static_cast<std::int32_t>(d_inner),
+                                            static_cast<std::int32_t>(tokens)}};
+    const Tensor tgate{d_gate.data(), DType::FP32, {static_cast<std::int32_t>(d_inner),
+                                                  static_cast<std::int32_t>(tokens)}};
+    const Tensor tbeta{d_beta.data(), DType::FP32, {static_cast<std::int32_t>(heads),
+                                                  static_cast<std::int32_t>(tokens)}};
+    Tensor tstate{d_state.data(), DType::FP32, {static_cast<std::int32_t>(dk),
+                                              static_cast<std::int32_t>(dk),
+                                              static_cast<std::int32_t>(heads)}};
+    Tensor tout{d_out.data(), DType::BF16, {static_cast<std::int32_t>(d_inner),
+                                          static_cast<std::int32_t>(tokens)}};
+
+    {   // Upload self-check: what comes back from d_q before the kernel?
+        const auto echoed = download_bytes<__nv_bfloat16>(d_q);
+    }
+    glm5_kda_chunk(tq, tk, tv, tgate, tbeta, tstate, tout, chunk, 0);
+    CUDA_CHECK(cudaStreamSynchronize(0));
+
+    check_close(label + ".out", download_bf16(d_out), out_want, 5e-3f);
+    check_close(label + ".state", download_bytes<float>(d_state), state, 5e-3f);
+}
+
+} // namespace
+
+int main() {
+    try {
+        chunk_case("zerogate 2x16 c8 t24", 2, 16, 8, 24, true);
+        chunk_case("small 2x16 c8 t24", 2, 16, 8, 24);
+        chunk_case("wide 4x64 c32 t96", 4, 64, 32, 96);
+        chunk_case("prod 2x128 c28 t56", 2, 128, 28, 56);
+        chunk_case("wide64 64x128 c28 t56", 64, 128, 28, 56);
+        if (failures == 0) {
+            std::puts("glm5 kda chunk kernel matches the host chunk reference");
+            return 0;
+        }
+        std::printf("%d failures\n", failures);
+        return 1;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "%s\n", e.what());
