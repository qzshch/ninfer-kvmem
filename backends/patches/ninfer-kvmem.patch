+    l1.hc_ffn_base = execution::bf16_weight(d_hcbase[3].data(), 24, 1);
+    l1.hc_ffn_scale = execution::bf16_weight(d_hcscale[3].data(), 3, 1);
+    l1.attn_norm = execution::bf16_weight(d_anorm[1].data(), H, 1);
+    l1.ffn_norm = execution::bf16_weight(d_fnorm[1].data(), H, 1);
+    l1.dsa.attn_norm = l1.attn_norm;
+    l1.dsa.q_a = execution::bf16_weight(d_qa.data(), QL, H);
+    l1.dsa.q_a_norm = execution::bf16_weight(d_qan.data(), QL, 1);
+    l1.dsa.q_b = execution::bf16_weight(d_qb.data(), AH * AD, QL);
+    l1.dsa.kv_a = execution::bf16_weight(d_kva.data(), KL, H);
+    l1.dsa.kv_a_norm = execution::bf16_weight(d_kvan.data(), KL, 1);
+    l1.dsa.wk_b = execution::bf16_weight(d_wkb.data(), AD * KL * AH, 1);
+    l1.dsa.wv_b = execution::bf16_weight(d_wvb.data(), KL * VH * AH, 1);
+    l1.dsa.wo = execution::bf16_weight(d_dwo.data(), H, AH * VH);
+    l1.dsa.indexer_q_b = execution::bf16_weight(d_iqb.data(), IH * ID, QL);
+    l1.dsa.indexer_k = execution::bf16_weight(d_ik.data(), ID, H);
+    l1.dsa.indexer_k_norm_w = execution::bf16_weight(d_iknw.data(), ID, 1);
+    l1.dsa.indexer_k_norm_b = execution::bf16_weight(d_iknb.data(), ID, 1);
+    l1.dsa.indexer_gate = execution::bf16_weight(d_ig.data(), ID, H);
+    l1.dsa.indexer_proj = execution::bf16_weight(d_ip.data(), IH, H);
+    l1.dense_mlp.ffn_norm = l1.ffn_norm;
+    l1.dense_mlp.gate = execution::bf16_weight(d_dgate.data(), FFN_D, H);
+    l1.dense_mlp.up = execution::bf16_weight(d_dup.data(), FFN_D, H);
+    l1.dense_mlp.down = execution::bf16_weight(d_ddown.data(), H, FFN_D);
+
+    execution::Glm5StepConfig config{};
+    config.hidden = H;
+    config.kda_heads = HK; config.kda_head_dim = HD;
+    config.heads = AH; config.head_dim = AD;
+    config.q_lora = QL; config.kv_lora = KL; config.v_head = VH;
+    config.index_heads = IH; config.index_dim = ID; config.kpool = KP; config.top_k = TK;
+    config.ffn_dense = FFN_D; config.ffn_moe = FFN_M;
+    config.experts = EXP; config.num_experts_per_tok = TOPK;
+    config.vocab_size = VOCAB;
+    config.rms_eps = 1e-5f; config.gate_lower_bound = -5.0f;
+    config.swiglu_limit = 10.0f; config.routed_scaling_factor = 2.5f;
+    config.layer_is_dsa = {false, true};
+    config.layer_mlp_dense = {false, true};
+
+    auto make_state = [&](execution::Glm5DecodeState& state,
+                          std::vector<test::GuardedDeviceBuffer>& buffers) {
+        state.kda_conv_q.resize(1); state.kda_conv_k.resize(1);
+        state.kda_conv_v.resize(1); state.kda_matrix.resize(1);
+        state.dsa_latents.resize(1); state.dsa_ik_plane.resize(1);
+        state.dsa_ig_plane.resize(1); state.dsa_pooled.resize(1); state.dsa_cells.resize(1);
+        buffers.emplace_back(3 * DI * 4); buffers.emplace_back(3 * DI * 4);
+        buffers.emplace_back(3 * DI * 4); buffers.emplace_back(HK * HD * HD * 4);
+        buffers.emplace_back(CACHE * KL * 2); buffers.emplace_back(CACHE * ID * 2);
+        buffers.emplace_back(CACHE * ID * 2); buffers.emplace_back(CACHE * ID);
+        buffers.emplace_back(TK + KP - 1);
+        for (auto& buffer : buffers) buffer.fill(0);
+        state.kda_conv_q[0] = Tensor(buffers[0].data(), DType::FP32, {3, static_cast<std::int32_t>(DI)});
+        state.kda_conv_k[0] = Tensor(buffers[1].data(), DType::FP32, {3, static_cast<std::int32_t>(DI)});
+        state.kda_conv_v[0] = Tensor(buffers[2].data(), DType::FP32, {3, static_cast<std::int32_t>(DI)});
+        state.kda_matrix[0] = Tensor(buffers[3].data(), DType::FP32,
+                                     {static_cast<std::int32_t>(HD), static_cast<std::int32_t>(HD),
+                                      static_cast<std::int32_t>(HK)});
+        state.dsa_latents[0] = Tensor(buffers[4].data(), DType::BF16,
+                                      {static_cast<std::int32_t>(CACHE), static_cast<std::int32_t>(KL)});
+        state.dsa_ik_plane[0] = Tensor(buffers[5].data(), DType::BF16,
+                                       {static_cast<std::int32_t>(CACHE), static_cast<std::int32_t>(ID)});
+        state.dsa_ig_plane[0] = Tensor(buffers[6].data(), DType::BF16,
+                                       {static_cast<std::int32_t>(CACHE), static_cast<std::int32_t>(ID)});
+        state.dsa_pooled[0] = Tensor(buffers[7].data(), DType::FP32,
+                                     {static_cast<std::int32_t>(CACHE / KP), static_cast<std::int32_t>(ID)});
+        state.dsa_cells[0] = Tensor(buffers[8].data(), DType::I32, {static_cast<std::int32_t>(TK + KP - 1)});
+    };
+
+    execution::Glm5DecodeState state_a{}, state_b{};
+    std::vector<test::GuardedDeviceBuffer> buffers_a, buffers_b;
+    make_state(state_a, buffers_a);
+    make_state(state_b, buffers_b);
+
+    // Path A: T sequential decode tokens.
+    test::GuardedDeviceBuffer d_logits_a(VOCAB * 2);
+    test::GuardedDeviceBuffer d_hidden_a(H * 2);
+    Tensor logits_a(d_logits_a.data(), DType::BF16, {static_cast<std::int32_t>(VOCAB)});
+    Tensor hidden_a(d_hidden_a.data(), DType::BF16, {static_cast<std::int32_t>(H)});
+    const std::size_t scratch_decode =
+        execution::glm5_decode_step_scratch_bytes(config, T - 1) + execution::glm5_embed_scratch_bytes(H) + 256;
+    std::vector<std::uint8_t> scratch_a(scratch_decode);
+    void* d_scratch_a = nullptr;
+    CUDA_CHECK(cudaMalloc(&d_scratch_a, scratch_decode));
+    for (std::uint32_t t = 0; t < T; ++t) {
+        execution::glm5_decode_token(mw, state_a, config, TOKENS[t], t, logits_a,
+                                     d_scratch_a, 0);
+    }
+    CUDA_CHECK(cudaStreamSynchronize(0));
+
+    // Path B: one chunked prefill call (2 chunks of 4).
+    std::vector<std::int32_t> ids(T);
+    for (std::uint32_t t = 0; t < T; ++t) ids[t] = static_cast<std::int32_t>(TOKENS[t]);
+    auto d_ids = upload(ids);
+    Tensor ids_t(d_ids.data(), DType::I32, {static_cast<std::int32_t>(T)});
+    test::GuardedDeviceBuffer d_logits_b(VOCAB * 2);
+    test::GuardedDeviceBuffer d_hidden_b(H * 2);
+    Tensor logits_b(d_logits_b.data(), DType::BF16, {static_cast<std::int32_t>(VOCAB)});
+    Tensor hidden_b(d_hidden_b.data(), DType::BF16, {static_cast<std::int32_t>(H)});
+    const std::size_t scratch_chunked =
+        execution::glm5_prefill_chunked_scratch_bytes(config, T, 0);
+    void* d_scratch_b = nullptr;
+    CUDA_CHECK(cudaMalloc(&d_scratch_b, scratch_chunked));
+    execution::glm5_prefill_chunked(mw, state_b, config, ids_t, 0, CHUNK, hidden_b, logits_b,
+                                    d_scratch_b, 0);
+    CUDA_CHECK(cudaStreamSynchronize(0));
+
+    // Compare: logits, both states' persistent planes.
+    // End-to-end tolerance note: the BLOCK-level cross-check (same inputs)
+    // pins the batched executors tightly (5e-2 out / 5e-3 state, in
+    // test_kda_block). Here the two paths differ from the first linear
+    // (batched vs single-column tiles round their BF16 outputs one ulp
+    // apart), and the mHC chain amplifies that through both layers. The
+    // first layer's state stays tight (kda matrix 5e-2); the second layer's
+    // DSA planes and the logits compare at the twice-propagated band, the
+    // same 2.5e-1 the logits need.
+    check_close("logits", represented(download<__nv_bfloat16>(d_logits_b)),
+                represented(download<__nv_bfloat16>(d_logits_a)), 2e-1f);
+    check_close("kda matrix", download<float>(buffers_b[3]), download<float>(buffers_a[3]), 5e-2f);
+    check_close("kda conv q", download<float>(buffers_b[0]), download<float>(buffers_a[0]), 3e-2f);
+    check_close("dsa latents", represented(download<__nv_bfloat16>(buffers_b[4])),
+                represented(download<__nv_bfloat16>(buffers_a[4])), 2.5e-1f);
+    check_close("dsa ik", represented(download<__nv_bfloat16>(buffers_b[5])),
+                represented(download<__nv_bfloat16>(buffers_a[5])), 2.5e-1f);
+    check_close("dsa ig", represented(download<__nv_bfloat16>(buffers_b[6])),
+                represented(download<__nv_bfloat16>(buffers_a[6])), 2.5e-1f);
+
+    CUDA_CHECK(cudaFree(d_scratch_a));
+    CUDA_CHECK(cudaFree(d_scratch_b));
+    (void)scratch_a; (void)hidden_a;
+    return failures;
+}
+
+} // namespace
+
+int main() {
+    try {
+        const int failed = run();
+        if (failed == 0) {
+            std::puts("glm5 chunked prefill matches the per-token decode path");
+            return 0;
+        }
+        std::printf("%d failures\n", failed);
+        return 1;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "%s\n", e.what());
+        return 1;
+    }
+}
diff --git a/tests/models/glm5/test_state.cpp b/tests/models/glm5/test_state.cpp
new file mode 100644
index 0000000..4948578
--- /dev/null
+++ b/tests/models/glm5/test_state.cpp
@@ -0,0 +1,96 @@
+// Glm5StateLayout against the audited GLM-5.3-Flash geometry and the capacity
+// plan's numbers (FP32 KDA state, BF16 caches, 262144 logical positions).
+#include "models/glm5/config.h"
+#include "models/glm5/state.h"
+
+#include <cmath>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <string>
+
+using namespace ninfer::models::glm5;
+using ninfer::artifact::Json;
+
+namespace {
+
+void require(bool condition, const std::string& message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+constexpr std::uint64_t kGib = 1ull << 30;
+
+TextConfig fixture_config() {
+    std::ifstream file(std::string(NINFER_SOURCE_DIR) + "/tests/fixtures/glm5/text_config.json");
+    require(file.good(), "fixture missing");
+    return parse_text_config(Json::parse(file));
+}
+
+void audited_layout() {
+    const TextConfig config = fixture_config();
+    const Glm5StateLayout layout(config);
+    require(layout.kda_blocks() == 34 && layout.dsa_blocks() == 11, "block split");
+
+    // KDA FP32 matrix state: 34 blocks x 64 x 128 x 128 floats = 136 MiB.
+    require(layout.kda_matrix_floats() == 34ull * 64 * 128 * 128, "kda matrix floats");
+    require(layout.kda_matrix_floats() * 4 == 142606336ull, "kda matrix FP32 bytes");
+
+    // Three conv planes of 3 taps over 8192 channels per KDA block.
+    require(layout.kda_conv_values() == 34ull * 3 * 3 * 8192, "kda conv values");
+
+    // MLA latent: the only attention cache, 11 * 512 per position (NoPE).
+    require(layout.mla_latent_values_per_position() == 11ull * 512, "mla latent values");
+    const std::uint64_t positions = 262144;
+    const double latent_gib =
+        double(layout.mla_latent_values_per_position() * positions) * 2.0 / kGib;
+    require(std::abs(latent_gib - 2.75) < 1e-9, "mla latent GiB at 262144 (BF16, capacity plan)");
+
+    // Indexer packed rows [128k|128g|1v] per position and pooled keys per pool.
+    require(layout.indexer_packed_values_per_position() == 11ull * 257, "indexer packed row");
+    const double packed_gib =
+        double(layout.indexer_packed_values_per_position() * positions) * 2.0 / kGib;
+    require(packed_gib > 1.30 && packed_gib < 1.40, "indexer packed GiB at 262144 (BF16)");
+    require(layout.completed_pools(positions) == 65536, "completed pools");
+    const double pools_gib =
+        double(layout.indexer_pool_key_values_per_pool() * layout.completed_pools(positions)) *
+        2.0 / kGib;
+    require(std::abs(pools_gib - 11.0 * 65536 * 128 * 2.0 / kGib) < 1e-9, "pooled key bytes");
+
+    require(layout.mhc_stream_values() == 4ull * 4096, "mHC residual streams");
+}
+
+void layer_counts_follow_the_config() {
+    // The layout derives its counts from the config's own layer list; a
+    // differently balanced but covering split is a different (hypothetical)
+    // model, not a layout error.
+    TextConfig config = fixture_config();
+    config.layer_types[3] = MixerKind::Kda;
+    const Glm5StateLayout rebalanced(config);
+    require(rebalanced.kda_blocks() == 35 && rebalanced.dsa_blocks() == 10,
+            "counts follow layer_types");
+
+    // A list that stops covering every block refuses.
+    TextConfig dropped = fixture_config();
+    dropped.layer_types.pop_back();
+    bool refused = false;
+    try {
+        (void)Glm5StateLayout(dropped);
+    } catch (const std::invalid_argument&) {
+        refused = true;
+    }
+    require(refused, "non-covering layer list must refuse");
+}
+
+} // namespace
+
+int main() {
+    try {
+        audited_layout();
+        layer_counts_follow_the_config();
+        std::puts("GLM5 state layout matches the audited geometry and capacity plan");
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
