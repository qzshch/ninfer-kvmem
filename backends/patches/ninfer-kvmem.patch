+     CONTENT "$<TARGET_FILE:ninfer-gaudi2-fp8-tile>")
+
+add_executable(ninfer-gaudi2-block-fp8-test block_fp8_test.cpp)
+target_link_libraries(ninfer-gaudi2-block-fp8-test PRIVATE ninfer_gaudi2_block_fp8)
+add_test(NAME ninfer-gaudi2-block-fp8 COMMAND ninfer-gaudi2-block-fp8-test)
+
+find_package(Python3 3.11 COMPONENTS Interpreter REQUIRED)
+add_test(NAME ninfer-gaudi2-fp8-tile-files
+  COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/test_fp8_tile_files.py"
+          "$<TARGET_FILE:ninfer-gaudi2-fp8-tile>")
+
+# The offline executable compiles the real adapter source but resolves the C API
+# with a strict asynchronous test double. These includes/defines are PRIVATE to
+# this target; no fake SDK can be selected as a product fallback.
+add_executable(ninfer-gaudi2-runtime-lifecycle-test
+  runtime.cpp tests/runtime_lifecycle_test.cpp tests/fake_synapse/fake_synapse.cpp
+  tests/fake_synapse/fake_gemm.cpp)
+target_compile_features(ninfer-gaudi2-runtime-lifecycle-test PRIVATE cxx_std_20)
+target_compile_definitions(ninfer-gaudi2-runtime-lifecycle-test PRIVATE NINFER_GAUDI2_RUNTIME_TEST_FAKE=1)
+target_include_directories(ninfer-gaudi2-runtime-lifecycle-test PRIVATE
+  "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/fake_synapse")
+add_test(NAME ninfer-gaudi2-runtime-lifecycle COMMAND ninfer-gaudi2-runtime-lifecycle-test)
+
+add_executable(ninfer-gaudi2-bf16-gemm-test runtime.cpp
+  ../../ops/gaudi2/bf16_gemm.cpp tests/bf16_gemm_test.cpp
