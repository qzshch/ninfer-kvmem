+            execution::kda_block_prefill_scratch_bytes(hidden, heads, head_dim, BT));
+        {
+            Tensor batch_t(d_hidden_a.data(), DType::BF16,
+                           {static_cast<std::int32_t>(hidden), static_cast<std::int32_t>(BT)});
+            Tensor dt_t(const_cast<void*>(d_dt.data()), DType::BF16, {static_cast<std::int32_t>(d_inner)});
+            Tensor alog_t(const_cast<void*>(d_alog.data()), DType::FP32, {static_cast<std::int32_t>(heads)});
+            Tensor onw_t(const_cast<void*>(d_onw.data()), DType::FP32, {static_cast<std::int32_t>(head_dim)});
+            Tensor cqs(d_cq_b.data(), DType::FP32, {3, static_cast<std::int32_t>(d_inner)});
+            Tensor cks(d_ck_b.data(), DType::FP32, {3, static_cast<std::int32_t>(d_inner)});
+            Tensor cvs(d_cv_b.data(), DType::FP32, {3, static_cast<std::int32_t>(d_inner)});
+            Tensor ms(d_ms_b.data(), DType::FP32,
+                      {static_cast<std::int32_t>(head_dim), static_cast<std::int32_t>(head_dim),
+                       static_cast<std::int32_t>(heads)});
+            Tensor out_t(d_out_b.data(), DType::BF16,
+                         {static_cast<std::int32_t>(hidden), static_cast<std::int32_t>(BT)});
+            execution::kda_block_prefill(w, batch_t, dt_t, alog_t, onw_t, cqs, cks, cvs, ms,
+                                         -5.0f, heads, head_dim, 1e-5f, BCH, out_t,
+                                         d_scratch_b.data(), nullptr);
+            CUDA_CHECK(cudaStreamSynchronize(nullptr));
+        }
+
+        const auto out_a = represented(download<__nv_bfloat16>(d_out_a));
+        const auto out_b = represented(download<__nv_bfloat16>(d_out_b));
+        // Tolerance band by geometry: the small 2x8 probe pins the batched
+        // chain tightly; at 64x128 the batched-vs-single-column GEMM tile
+        // differences (one-ulp per projection output) ride the decay gate's
+        // exp() and the chunk recurrence across 8192-wide planes, so the
+        // block OUTPUT drifts further than the state (the direct kernel
+        // test at this exact geometry stays at 8.5e-5 - the anchor).
+        const double band = hidden >= 4096 ? 0.15 : 0.05;
+        for (std::size_t i = 0; i < out_a.size(); ++i) {
+            if (std::abs(static_cast<double>(out_b[i]) - out_a[i]) >
+                band * std::max(1.0, static_cast<double>(std::abs(out_a[i])))) {
+                if (failures < 10) {
+                    std::fprintf(stderr, "batch-block[%s][%zu]: %.6g vs %.6g\n", label.c_str(), i,
+                                 out_b[i], out_a[i]);
+                }
+                ++failures;
+            }
+        }
+        const auto state_a = download<float>(d_ms_a);
+        const auto state_b = download<float>(d_ms_b);
+        for (std::size_t i = 0; i < state_a.size(); ++i) {
+            if (std::abs(static_cast<double>(state_b[i]) - state_a[i]) >
+                5e-3 * std::max(1.0, static_cast<double>(std::abs(state_a[i])))) {
+                if (failures < 10) {
+                    std::fprintf(stderr, "batch-state[%s][%zu]: %.6g vs %.6g\n", label.c_str(), i,
+                                 state_b[i], state_a[i]);
+                }
+                ++failures;
+            }
+        }
+    }
+
+}
+
+int run() {
+    run_case(64, 2, 8);           // small probe
+    run_case(4096, 64, 128);      // the audited hidden width
+    if (failures == 0) {
+        std::puts("GLM5 KDA block decode matches the chained host oracle on device");
+        return 0;
+    }
+    std::fprintf(stderr, "%d numeric failures\n", failures);
+    return 1;
+}
+
+} // namespace
+
+int main() {
+    try {
+        return run();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "FATAL: %s\n", error.what());
+        return 1;
+    } catch (...) {
+        std::fprintf(stderr, "FATAL: unknown exception\n");
+        return 1;
+    }
+}
