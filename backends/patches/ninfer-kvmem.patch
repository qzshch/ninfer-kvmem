diff --git a/src/models/qwen3_5/frontend/tool_open_token.h b/src/models/qwen3_5/frontend/tool_open_token.h
new file mode 100644
index 0000000..da7d1f8
--- /dev/null
+++ b/src/models/qwen3_5/frontend/tool_open_token.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include "ninfer/types.h"
+
+#include <cstddef>
+#include <optional>
+#include <string_view>
+
+namespace ninfer::models::qwen3_5::frontend {
+
+// The vocabulary id whose decoded text is exactly `text`, when that id is unique.
+// Zero matches and more than one match both return empty: a missing or ambiguous
+// spelling is left to the model instead of guessing which id to forbid.
+template <typename Lookup>
+std::optional<TokenId> unique_exact_token(std::size_t vocab_size, Lookup&& decoded_bytes,
+                                          std::string_view text) {
+    std::optional<TokenId> found;
+    for (std::size_t id = 0; id < vocab_size; ++id) {
+        if (decoded_bytes(id) != text) { continue; }
+        if (found) { return {}; }
+        found = static_cast<TokenId>(id);
+    }
+    return found;
+}
+
+} // namespace ninfer::models::qwen3_5::frontend
diff --git a/src/models/qwen3_5/program/planning/prefill_service_work.h b/src/models/qwen3_5/program/planning/prefill_service_work.h
new file mode 100644
index 0000000..ca6192f
--- /dev/null
+++ b/src/models/qwen3_5/program/planning/prefill_service_work.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// The initial proposal must leave room for the sampled Begin token and correction.
+[[nodiscard]] inline std::uint32_t initial_mtp_prefill_extent(
+    std::uint32_t draft_window, std::uint32_t output_tokens,
+    std::uint32_t capacity, std::uint32_t prompt_tokens) noexcept {
+    return std::min({draft_window, output_tokens > 1 ? output_tokens - 2 : 0U,
+                     capacity > prompt_tokens ? capacity - prompt_tokens - 1 : 0U});
+}
+
+// Count worker-visible prefill steps, not internal forward calls. KVMem resumes on
+// the canonical chunk grid; its last step also leaves room in R for the MTP lead.
+// Capture-separated intervals use the same grid. An empty suffix is accounted for
+// by the caller's single Begin step.
+[[nodiscard]] inline std::uint64_t prefill_service_units(
+    std::uint32_t begin, std::uint32_t end, std::uint32_t chunk,
+    std::uint32_t window_reserve = 0, std::uint32_t mtp_extent = 0) noexcept {
+    if (begin >= end) return 0;
+    if (window_reserve == 0) return 1ULL + (end - begin - 1ULL) / chunk;
+    const std::uint32_t last_begin = std::max(begin, ((end - 1U) / chunk) * chunk);
+    const std::uint32_t lead = mtp_extent == 0 ? 0U : mtp_extent - 1U;
+    const std::uint32_t final_limit = window_reserve - lead;
+    return 1ULL + (end - 1U) / chunk - begin / chunk +
+           (end - last_begin - 1ULL) / final_limit;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/bounded_checkpoint_buffer_pool.h b/src/models/qwen3_5/program/storage/bounded_checkpoint_buffer_pool.h
new file mode 100644
index 0000000..8c2df7d
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/bounded_checkpoint_buffer_pool.h
@@ -0,0 +1,117 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// A free-list bound, not a limit on live checkpoints. A lease must remain alive
+// until every CPU/GPU transfer using it completes; the pool invents no fence.
+// Only the last shared reference returns a buffer, and every buffer has exactly
+// the fixed image size of its owning Program. Prewarming is explicit and runs
+// before the Program is exposed to requests.
+template <class Buffer>
+class BoundedCheckpointBufferPool final
+    : public std::enable_shared_from_this<BoundedCheckpointBufferPool<Buffer>> {
+public:
+    struct Statistics {
+        std::uint64_t hits = 0, misses = 0, returns = 0, retired = 0;
+        std::size_t cached = 0, cached_bytes = 0, high_water_cached_bytes = 0;
+        bool closed = false;
+    };
+
+    BoundedCheckpointBufferPool(std::size_t capacity, std::size_t image_bytes)
+        : capacity_(capacity), image_bytes_(image_bytes) {
+        if (image_bytes == 0 || (capacity && image_bytes > std::numeric_limits<std::size_t>::max()/capacity))
+            throw std::invalid_argument("checkpoint free-list capacity overflow or empty image");
+        free_.reserve(capacity);
+    }
+
+    std::shared_ptr<Buffer> acquire(std::size_t bytes) {
+        if (bytes != image_bytes_) throw std::invalid_argument("checkpoint free-list image layout changed");
+        auto owner = this->shared_from_this();
+        std::unique_ptr<Buffer> value;
+        {
+            std::lock_guard lock(mutex_);
+            if (!free_.empty()) {
+                value = std::move(free_.back());
+                free_.pop_back();
+                ++statistics_.hits;
+            } else {
+                ++statistics_.misses;
+            }
+        }
+        if (!value) value = std::make_unique<Buffer>(image_bytes_);
+        // If shared_ptr's control-block allocation throws, it invokes this
+        // deleter; the buffer is still returned or retired without a leak.
+        return std::shared_ptr<Buffer>(value.release(), [owner = std::move(owner)](Buffer* pointer) noexcept {
+            owner->release(std::unique_ptr<Buffer>(pointer));
+        });
+    }
+
+    // All leases are held together so no prewarmed image can be reacquired
+    // during preparation. Touch is explicit because allocation alone need not
+    // fault every page in. Call only before the Program is exposed to requests.
+    template <class Touch>
+    void prewarm(std::size_t count, Touch&& touch) {
+        if (count > capacity_) throw std::invalid_argument("checkpoint prewarm exceeds cache capacity");
+        std::vector<std::shared_ptr<Buffer>> held;
+        held.reserve(count);
+        for (std::size_t i=0;i<count;++i) {
+            held.push_back(acquire(image_bytes_));
+            touch(*held.back());
+        }
+    }
+
+    void close() noexcept {
+        std::vector<std::unique_ptr<Buffer>> retired;
+        {
+            std::lock_guard lock(mutex_);
+            statistics_.closed = true;
+            statistics_.retired += free_.size();
+            retired.swap(free_);
+        }
+        // Potentially expensive pin destruction occurs outside the mutex.
+        // Leases still held by callers remain valid; later returns cannot cache.
+    }
+
+    Statistics statistics() const {
+        std::lock_guard lock(mutex_);
+        auto result = statistics_;
+        result.cached = free_.size();
+        result.cached_bytes = free_.size()*image_bytes_;
+        return result;
+    }
+
+private:
+    void release(std::unique_ptr<Buffer> value) noexcept {
+        try {
+            std::lock_guard lock(mutex_);
+            ++statistics_.returns;
+            if (!statistics_.closed && free_.size() < capacity_) {
+                free_.push_back(std::move(value)); // capacity reserved before any lease is issued.
+                const auto bytes = free_.size()*image_bytes_;
+                if (bytes > statistics_.high_water_cached_bytes)
+                    statistics_.high_water_cached_bytes = bytes;
+                return;
+            }
+            ++statistics_.retired;
+        } catch (...) {
+            // A deleter cannot throw into checkpoint/history destruction. The
+            // still-owned buffer is retired normally outside the lock instead.
+        }
+    }
+
+    const std::size_t capacity_, image_bytes_;
+    mutable std::mutex mutex_;
+    std::vector<std::unique_ptr<Buffer>> free_;
+    Statistics statistics_;
+};
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/checkpoint_buffer_pool.h b/src/models/qwen3_5/program/storage/checkpoint_buffer_pool.h
new file mode 100644
index 0000000..6113fca
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_buffer_pool.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include "models/qwen3_5/program/storage/bounded_checkpoint_buffer_pool.h"
+
+#include <charconv>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string_view>
+
+namespace ninfer::models::qwen3_5::detail {
+
+inline std::size_t checkpoint_buffer_pool_capacity() {
+    const char* value=std::getenv("NINFER_EXPERIMENT_CHECKPOINT_POOL");
+    if (value==nullptr) return 0;
+    std::string_view text(value);
+    unsigned capacity=0;
+    const auto parsed=std::from_chars(text.data(),text.data()+text.size(),capacity);
+    if (parsed.ec!=std::errc{} || parsed.ptr!=text.data()+text.size() || capacity>4)
+        throw std::invalid_argument("checkpoint buffer free-list requires a capacity in 0..4");
+    return capacity;
+}
+
+template <class Buffer>
+class CheckpointBufferPool {
+    using Pool=BoundedCheckpointBufferPool<Buffer>;
+public:
+    CheckpointBufferPool(std::size_t capacity,std::size_t image_bytes,bool prewarm=false)
+        : pool_(std::make_shared<Pool>(capacity,image_bytes)), resident_(prewarm) {
+        if (prewarm) pool_->prewarm(capacity,[](auto& image) { std::memset(image.data(),0,image.size()); });
+        std::fprintf(stderr,"CHECKPOINT_POOL capacity=%zu image_bytes=%zu maximum_cached_bytes=%zu prewarm=%zu\n",
+                     capacity,image_bytes,capacity*image_bytes,prewarm ? capacity : 0);
+    }
+    std::shared_ptr<Buffer> acquire(std::size_t bytes) { return pool_->acquire(bytes); }
+    int reconstruction_scratch_mode(int configured) const noexcept {
+        // Resident mode covers the backup even when the old experiment is off.
+        // Explicit pooled/retained modes keep their existing ownership behavior.
+        return resident_ && configured == 0 ? 1 : configured;
+    }
+    std::size_t idle_bytes() const { return pool_->statistics().cached_bytes; }
+    void close() noexcept {
+        const auto stats=pool_->statistics();
+        std::fprintf(stderr,"CHECKPOINT_POOL_CLOSE hits=%llu misses=%llu cached=%zu cached_bytes=%zu high_water_cached_bytes=%zu\n",
+                     static_cast<unsigned long long>(stats.hits),static_cast<unsigned long long>(stats.misses),
+                     stats.cached,stats.cached_bytes,stats.high_water_cached_bytes);
+        pool_->close();
+    }
+private:
+    std::shared_ptr<Pool> pool_;
+    const bool resident_;
+};
+
+// Catalog images are counted by their owners. An idle image cannot also be
+// leased, and the independently retained reconstruction backup is never a
+// catalog image. Count its allocation once, regardless of shared aliases.
+template <class Buffer>
+std::size_t checkpoint_auxiliary_host_bytes(const CheckpointBufferPool<Buffer>* pool,
+                                           const std::shared_ptr<Buffer>& scratch) {
+    return (pool ? pool->idle_bytes() : 0) + (scratch ? scratch->size() : 0);
+}
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/checkpoint_residency.h b/src/models/qwen3_5/program/storage/checkpoint_residency.h
new file mode 100644
index 0000000..44e39d2
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_residency.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstddef>
+#include <limits>
+#include <stdexcept>
+#include <string_view>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Parse once at startup. Null and "0" preserve the existing allocation path.
+inline bool checkpoint_resident_enabled(const char* value) {
+    if (!value || std::string_view(value) == "0") return false;
+    if (std::string_view(value) == "1") return true;
+    throw std::invalid_argument("NINFER_KVMEM_CHECKPOINT_RESIDENT must be 0 or 1");
+}
+
+// Catalog aliases share images. Only a replacement capture and the single
+// outstanding idle-I/O owner can hold images beyond those catalogs. Scratch
+// leases are explicit so callers account for their actual simultaneous lifetime.
+inline std::size_t checkpoint_resident_capacity(std::size_t active,
+                                                std::size_t retained,
+                                                std::size_t kinds,
+                                                std::size_t scratch) {
+    constexpr auto limit = std::numeric_limits<std::size_t>::max();
+    if (!active || !kinds) throw std::invalid_argument("empty checkpoint resident geometry");
+    if (retained > limit - active || scratch > limit - 2)
+        throw std::overflow_error("checkpoint resident capacity overflow");
+    const auto transient = 2 + scratch;
+    const auto windows = active + retained;
+    if (windows > (limit - transient) / kinds)
+        throw std::overflow_error("checkpoint resident capacity overflow");
+    return windows * kinds + transient;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/host_trace.h b/src/models/qwen3_5/program/storage/host_trace.h
new file mode 100644
index 0000000..d2588a5
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/host_trace.h
@@ -0,0 +1,88 @@
+#pragma once
+
+// Diagnostic-only: enable identically in both comparison arms. No CUDA call or data mutation.
+#include "core/nvtx.h"
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#if defined(__linux__)
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+#endif
+
+namespace ninfer::models::qwen3_5::detail {
+class HostTrace {
+public:
+    static bool enabled() noexcept {
+        static const bool result = [] {
+            const auto* value = std::getenv("NINFER_KVMEM_HOST_TRACE");
+            return value && value[0] == '1';
+        }();
+        return result;
+    }
+    HostTrace(const char* phase, std::uint64_t session, std::uint32_t lane,
+              std::uint32_t frontier, std::uint64_t bytes = 0) noexcept
+        : active_(enabled()), phase_(phase), session_(session), lane_(lane), frontier_(frontier), bytes_(bytes) {
+        if (!active_) return;
+        nvtxEventAttributes_t event{};
+        event.version = NVTX_VERSION;
+        event.size = NVTX_EVENT_ATTRIB_STRUCT_SIZE;
+        event.category = static_cast<std::uint32_t>(nvtx::Category::Control);
+        event.messageType = NVTX_MESSAGE_TYPE_ASCII;
+        event.message.ascii = phase_;
+        event.payloadType = NVTX_PAYLOAD_TYPE_UNSIGNED_INT64;
+        event.payload.ullValue = bytes_;
+        nvtxDomainRangePushEx(nvtx::domain(), &event);
+#if defined(__linux__)
+        getrusage(RUSAGE_THREAD, &before_);
+#endif
+        started_ = now();
+    }
+    ~HostTrace() noexcept {
+        if (!active_) return;
+        const auto ended = now();
+        long minor = 0, major = 0, tid = 0;
+#if defined(__linux__)
+        rusage after{};
+        getrusage(RUSAGE_THREAD, &after);
+        minor = after.ru_minflt - before_.ru_minflt;
+        major = after.ru_majflt - before_.ru_majflt;
+        tid = syscall(SYS_gettid);
+#endif
+        nvtxDomainRangePop(nvtx::domain());
+        std::fprintf(stderr,
+            "KVMEM_HOST_TRACE {\"phase\":\"%s\",\"session\":%llu,\"lane\":%u,\"frontier\":%u,"
+            "\"bytes\":%llu,\"start_raw_ns\":%llu,\"end_raw_ns\":%llu,"
+            "\"elapsed_ns\":%llu,\"minor_faults\":%ld,\"major_faults\":%ld,\"tid\":%ld}\n",
+            phase_, static_cast<unsigned long long>(session_), lane_, frontier_,
+            static_cast<unsigned long long>(bytes_), static_cast<unsigned long long>(started_),
+            static_cast<unsigned long long>(ended), static_cast<unsigned long long>(ended - started_),
+            minor, major, tid);
+    }
+    std::uint64_t start_raw_ns() const noexcept { return started_; }
+    HostTrace(const HostTrace&) = delete;
+    HostTrace& operator=(const HostTrace&) = delete;
+private:
+    static std::uint64_t now() noexcept {
+#if defined(__linux__)
+        timespec stamp{};
+        clock_gettime(CLOCK_MONOTONIC_RAW, &stamp);
+        return std::uint64_t(stamp.tv_sec) * 1000000000ULL + stamp.tv_nsec;
+#else
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+    }
+    bool active_;
+    const char* phase_;
+    std::uint64_t session_, started_ = 0;
+    std::uint32_t lane_, frontier_;
+    std::uint64_t bytes_;
+#if defined(__linux__)
+    rusage before_{};
+#endif
+};
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/kvmem_transfer_trace.h b/src/models/qwen3_5/program/storage/kvmem_transfer_trace.h
new file mode 100644
index 0000000..17052b7
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/kvmem_transfer_trace.h
@@ -0,0 +1,135 @@
+#pragma once
+
+#include "core/paged_kv_cache.h"
+#include "core/host_kv_arena.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Opt-in transfer diagnostics. All event reads follow the caller's existing batch fence.
+// Event spans include stream idle time during host submission; they are not copy-engine busy
+// time. Across ranks report the longest span per batch, rather than adding concurrent spans.
+class KvmemTransferTrace {
+    using Clock = std::chrono::steady_clock;
+    struct RankTimer {
+        int device;
+        cudaStream_t stream;
+        cudaEvent_t start = nullptr, stop = nullptr;
+        RankTimer(int device, cudaStream_t stream) : device(device), stream(stream) {
+            const DeviceBinding bind(device);
+            CUDA_CHECK(cudaEventCreate(&start));
+            const auto status = cudaEventCreate(&stop);
+            if (status != cudaSuccess) {
+                (void)cudaEventDestroy(start);
+                CUDA_CHECK(status);
+            }
+        }
+        ~RankTimer() {
+            int previous = device;
+            (void)cudaGetDevice(&previous);
+            (void)cudaSetDevice(device);
+            (void)cudaEventDestroy(stop);
+            (void)cudaEventDestroy(start);
+            (void)cudaSetDevice(previous);
+        }
+    };
+public:
+    KvmemTransferTrace(const DeviceContext& device, RankStreams streams,
+                       const char* direction, std::size_t pages, std::size_t staging_bytes,
+                       bool asynchronous)
+        : enabled_(enabled()), direction_(direction), pages_(pages), staging_bytes_(staging_bytes),
+          asynchronous_(asynchronous) {
+        if (!enabled_) return;
+        started_ = last_ = Clock::now();
+        for (std::size_t rank = 0; rank < device.size(); ++rank) {
+            timers_.push_back(std::make_unique<RankTimer>(device.rank(rank).device, streams[rank]));
+        }
+    }
+    void add_copy(const DeviceKVPagePool& pool, std::span<const DeviceKVPageHandle> pages,
+                   std::span<const std::byte* const> records,
+                   const HostKVPageLayout& layout,
+                   std::span<const std::uint32_t> groups = {}) {
+        if (!enabled_) return;
+        const auto stats = pool.host_record_copy_stats(pages, records, groups, layout);
+        runs_ += stats.runs;
+        copies_ += stats.copies;
+        payload_bytes_ += stats.payload_bytes;
+    }
+    void host_done() { checkpoint(host_us_); }
+    void prepare_done() { checkpoint(prepare_us_); }
+    void begin_copy() {
+        if (!enabled_) return;
+        prepare_done();
+        for (const auto& timer : timers_) {
+            const DeviceBinding bind(timer->device);
+            CUDA_CHECK(cudaEventRecord(timer->start, timer->stream));
+        }
+    }
+    void end_copy() {
+        if (!enabled_) return;
+        for (const auto& timer : timers_) {
+            const DeviceBinding bind(timer->device);
+            CUDA_CHECK(cudaEventRecord(timer->stop, timer->stream));
+        }
+        checkpoint(submit_us_);
+    }
+    void batch_complete() {
+        if (!enabled_) return;
+        checkpoint(wait_us_);
+        float longest = 0;
+        for (const auto& timer : timers_) {
+            const DeviceBinding bind(timer->device);
+            float ms = 0;
+            CUDA_CHECK(cudaEventElapsedTime(&ms, timer->start, timer->stop));
+            longest = std::max(longest, ms);
+        }
+        gpu_span_ms_ += longest;
+        ++batches_;
+        prepare_done();
+    }
+    void finish() {
+        if (!enabled_) return;
+        prepare_done();
+        const auto total = std::chrono::duration_cast<std::chrono::microseconds>(last_ - started_).count();
+        std::fprintf(stderr,
+            "KVMEM_TRANSFER direction=%s async=%d pages=%zu batches=%llu pool_runs=%llu "
+            "copy_calls=%llu payload_bytes=%llu staging_bytes=%zu prepare_us=%lld host_us=%lld "
+            "submit_us=%lld wait_us=%lld gpu_span_ms=%.3f total_us=%lld\n",
+            direction_, int(asynchronous_), pages_, static_cast<unsigned long long>(batches_),
+            static_cast<unsigned long long>(runs_), static_cast<unsigned long long>(copies_),
+            static_cast<unsigned long long>(payload_bytes_), staging_bytes_, prepare_us_, host_us_,
+            submit_us_, wait_us_, gpu_span_ms_, static_cast<long long>(total));
+    }
+private:
+    static bool enabled() {
+        static const bool value = [] {
+            const char* flag = std::getenv("KVMEM_TRANSFER_TRACE");
+            return flag && std::strcmp(flag, "1") == 0;
+        }();
+        return value;
+    }
+    void checkpoint(long long& accumulated) {
+        if (!enabled_) return;
+        const auto now = Clock::now();
+        accumulated += std::chrono::duration_cast<std::chrono::microseconds>(now - last_).count();
+        last_ = now;
+    }
+    bool enabled_;
+    const char* direction_;
+    std::size_t pages_, staging_bytes_;
+    bool asynchronous_;
+    Clock::time_point started_{}, last_{};
+    std::vector<std::unique_ptr<RankTimer>> timers_;
+    std::uint64_t batches_ = 0, runs_ = 0, copies_ = 0, payload_bytes_ = 0;
+    long long prepare_us_ = 0, host_us_ = 0, submit_us_ = 0, wait_us_ = 0;
+    double gpu_span_ms_ = 0;
+};
+
