+void mhc_lifecycle() {
+    constexpr std::uint32_t H = 32, T = 1, W4 = H * 4;
+    {
+        Device device;
+        auto stream = device.create_stream();
+        MhcGatesShape shape{H, T};
+
+        MhcGates gates(device, shape, 1e-6f, 1e-6f, 4, 4096);
+        MhcCollapse collapse(device, shape, 4096);
+        MhcPost post(device, shape, 4096);
