+"""GLM-5.3-Flash (Glm5NextForConditionalGeneration) adapter: the mathematical text config.
+
+The architecture: 45 blocks of Kimi Delta Attention (KDA) linear mixers and 11 DeepSeek-style
+sparse-attention (DSA) mixers - NoPE-only MLA over a k-pool indexer's selection - every block
+half read from and written into a four-stream mHC residual; three dense FFN blocks then 42
+sigmoid-routed 288-expert MoE blocks; one MTP block is recorded but not executed by the first
+generation. The converter normalises the checkpoint's config into the text config that
+src/models/glm5/config.cpp parses strictly. Weight import (the llama.cpp GGUF tensor blocks)
+is a separate step and is not implemented yet.
+"""
+
+from __future__ import annotations
+
+from math import isfinite
+import struct
+
+from .config_fields import _f32, _fixed, _positive
+
+_ARCHITECTURES = ("Glm5NextForConditionalGeneration",)
+
+
+def _nonnegative(value, name):
+    if type(value) is not int or value < 0:
+        raise ValueError(f"{name}: expected a nonnegative integer")
+    return value
+
+
+def _negative_f32(value, name):
+    if type(value) not in (float, int):
+        raise ValueError(f"{name}: expected a real value")
+    try:
+        result = struct.unpack("<f", struct.pack("<f", value))[0]
+    except (OverflowError, struct.error) as error:
+        raise ValueError(f"{name}: not representable as F32") from error
+    if not isfinite(result) or result >= 0:
+        raise ValueError(f"{name}: the KDA gate lower bound is negative (a log-space floor)")
+    return result
+
+
+def _layers(raw, count):
+    layers = raw.get("layer_types")
+    if (
+        not isinstance(layers, list)
+        or len(layers) != count
+        or any(k not in ("linear_attention", "deepseek_sparse_attention") for k in layers)
+    ):
+        raise ValueError("text.layer_types must describe every block")
+    kda = raw.get("linear_attn_config", {}).get("kda_layers")
+    full = raw.get("linear_attn_config", {}).get("full_attn_layers")
+    if isinstance(kda, list) and isinstance(full, list):
+        derived = ["linear_attention"] * count
+        for index in full:
+            if type(index) is not int or not 0 <= index < count:
+                raise ValueError("text.linear_attn_config.full_attn_layers is out of range")
+            derived[index] = "deepseek_sparse_attention"
+        if derived != layers or sorted(kda) != [
+            i for i, k in enumerate(derived) if k == "linear_attention"
+        ]:
+            raise ValueError("text.linear_attn_config layer lists disagree with layer_types")
+    return list(layers)
+
+
+def text_config(source: dict) -> dict:
+    architectures = source.get("architectures")
+    if (
+        not isinstance(architectures, list)
+        or len(architectures) != 1
+        or architectures[0] not in _ARCHITECTURES
+    ):
+        raise ValueError(f"unsupported GLM5 architecture {architectures!r}")
+    raw = source.get("text_config", source)
+    _fixed(raw, "model_type", "glm5_next_text", "text")
+    _fixed(raw, "hidden_act", "silu", "text")
+    _fixed(raw, "attention_bias", False, "text")
+    _fixed(raw, "mla_use_nope", True, "text")
+    _fixed(raw, "mhc", True, "text")
+    _fixed(raw, "scoring_func", "sigmoid", "text")
+    _fixed(raw, "topk_method", "noaux_tc", "text")
+    _fixed(raw, "moe_router_dtype", "float32", "text")
+    _fixed(raw, "n_group", 1, "text")
+    _fixed(raw, "topk_group", 1, "text")
+    # NoPE model: the indexer rope flags exist in the checkpoint but nothing applies them.
+    _fixed(raw, "indexer_rope_interleave", True, "text")
+    _fixed(raw, "index_share_for_mtp_iteration", True, "text")
+    _fixed(raw, "index_kpool_always_select_tail", True, "text")
+    _fixed(raw, "index_kpool_compress", True, "text")
+
+    result = {
+        "architectures": ["Glm5NextForCausalLM"],
+        "model_type": "glm5_next_text",
+        # The fixed flags the strict parser requires verbatim.
+        "attention_bias": False,
+        "mla_use_nope": True,
+        "mhc": True,
+        "scoring_func": "sigmoid",
+        "topk_method": "noaux_tc",
+        "moe_router_dtype": "float32",
+        "n_group": 1,
+        "topk_group": 1,
+        "index_kpool_always_select_tail": True,
+        "index_kpool_compress": True,
+    }
+    for key in (
+        "hidden_size",
+        "vocab_size",
+        "num_hidden_layers",
+        "max_position_embeddings",
+        "num_attention_heads",
+        "num_key_value_heads",
+        "qk_nope_head_dim",
+        "v_head_dim",
+        "q_lora_rank",
+        "kv_lora_rank",
+        "index_n_heads",
+        "index_head_dim",
+        "index_kpool",
+        "n_routed_experts",
+        "num_experts_per_tok",
+        "moe_intermediate_size",
+        "n_shared_experts",
+        "hc_mult",
+        "hc_sinkhorn_iters",
+        "first_k_dense_replace",
+        "intermediate_size",
+    ):
+        result[key] = _positive(raw.get(key), "text." + key)
+    for key in ("qk_rope_head_dim", "num_nextn_predict_layers"):
+        result[key] = _nonnegative(raw.get(key), "text." + key)
+
+    tied = raw.get("tie_word_embeddings", False)
+    if type(tied) is not bool:
+        raise ValueError("text.tie_word_embeddings must be boolean")
+    result["tie_word_embeddings"] = tied
+    result["rms_norm_eps"] = _f32(raw.get("rms_norm_eps"), "text.rms_norm_eps")
+    result["swiglu_limit"] = _f32(raw.get("swiglu_limit"), "text.swiglu_limit")
+    result["hc_eps"] = _f32(raw.get("hc_eps"), "text.hc_eps")
+    result["routed_scaling_factor"] = _f32(raw.get("routed_scaling_factor"),
+                                                "text.routed_scaling_factor")
+    dropout = raw.get("attention_dropout", 0.0)
+    if type(dropout) not in (float, int) or float(dropout) != 0.0:
+        raise ValueError("text.attention_dropout: inference requires zero")
+    result["attention_dropout"] = 0.0
+
+    eos = raw.get("eos_token_id")
+    if type(eos) is int:
+        eos = [eos]
+    if not isinstance(eos, list) or not eos or any(type(v) is not int for v in eos):
+        raise ValueError("text.eos_token_id must be one id or a non-empty list")
+    if any(v >= result["vocab_size"] for v in eos):
+        raise ValueError("text.eos_token_id exceeds the vocabulary")
+    result["eos_token_id"] = list(eos)
+
+    result["layer_types"] = _layers(raw, result["num_hidden_layers"])
+    if result["qk_rope_head_dim"] != 0:
+        raise ValueError("text.qk_rope_head_dim: GLM5 in this engine is NoPE-only")
+
+    linear = raw.get("linear_attn_config")
+    if not isinstance(linear, dict):
+        raise ValueError("text.linear_attn_config must be an object")
+    result["linear_attn_config"] = {
+        "num_heads": _positive(linear.get("num_heads"), "linear_attn_config.num_heads"),
+        "head_dim": _positive(linear.get("head_dim"), "linear_attn_config.head_dim"),
+        "short_conv_kernel_size": _positive(linear.get("short_conv_kernel_size"),
+                                            "linear_attn_config.short_conv_kernel_size"),
+        "gate_lower_bound": _negative_f32(linear.get("gate_lower_bound"),
+                                          "linear_attn_config.gate_lower_bound"),
+    }
+    result["index_top_k"] = _positive(raw.get("index_topk"), "text.index_topk")
+    if result["index_top_k"] % result["index_kpool"]:
+        raise ValueError("text.index_topk must be a whole number of pools")
+    if result["num_experts_per_tok"] > result["n_routed_experts"]:
+        raise ValueError("selected experts exceed expert count")
+    if result["first_k_dense_replace"] > result["num_hidden_layers"]:
+        raise ValueError("text.first_k_dense_replace exceeds the block count")
+    norm = raw.get("norm_topk_prob")
+    if type(norm) is not bool:
+        raise ValueError("text.norm_topk_prob must be boolean")
+    result["norm_topk_prob"] = norm
+    return result
