+    auto d_kvan = upload(round_trip(kv_a_n));
+    auto d_wkb = upload(round_trip(wk_b)), d_wvb = upload(round_trip(wv_b));
+    auto d_dwo = upload(round_trip(dsa_wo));
+    auto d_iqb = upload(round_trip(idx_q_b)), d_ik = upload(round_trip(idx_k));
+    auto d_iknw = upload(round_trip(idx_k_nw)), d_iknb = upload(round_trip(idx_k_nb));
+    auto d_ig = upload(round_trip(idx_gate)), d_ip = upload(round_trip(idx_proj));
+    auto d_ape = upload(ape);
+    auto d_dgate = upload(round_trip(d_gate)), d_dup = upload(round_trip(d_up));
