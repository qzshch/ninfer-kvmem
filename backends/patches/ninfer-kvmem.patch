+// ---------------------------------------------------------------------------
+// KDA decay gate
+
+KdaGate::KdaGate(const Device& device, KdaGateShape shape, float lower_bound,
+                 std::size_t max_workspace_bytes)
+    : shape_(shape), lower_bound_(lower_bound) {
+    if (!shape.d_inner || !shape.heads || !shape.head_dim || shape.d_inner != shape.heads * shape.head_dim) {
+        throw std::invalid_argument("KdaGate: d_inner must equal heads * head_dim");
+    }
+    if (lower_bound >= 0) throw std::invalid_argument("KdaGate: lower_bound must be negative");
+
+    synGraphHandle graph = create_graph();
+    std::vector<synTensor> created;
+    std::vector<synSectionHandle> sections;
+    try {
+        synTensor a = create_bf16_tensor(graph, "a", {shape.d_inner, shape.tokens}, sections);
+        synTensor a_log = create_f32_tensor(graph, "a_log", {shape.heads}, sections);
+        synTensor gate = create_f32_tensor(graph, "gate", {shape.d_inner, shape.tokens}, sections);
+        created = {a, a_log, gate};
+        struct { float lower_bound; std::int32_t head_dim; } params;
+        params.lower_bound = lower_bound;
+        params.head_dim = static_cast<std::int32_t>(shape.head_dim);
+        const synTensor inputs[] = {a, a_log};
+        const synTensor outputs[] = {gate};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 2, 1, &params, sizeof(params),
+                                "glm5_kda_gate_bf16", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "KdaGate node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_kda_gate", max_workspace_bytes);
+        const char* names[] = {"a", "a_log", "gate"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute KdaGate::launch(Stream& stream, DeviceBuffer& a, DeviceBuffer& a_log,
+                        DeviceBuffer& gate) {
+    if (a.size() != static_cast<std::uint64_t>(shape_.d_inner) * shape_.tokens * 2 ||
+        a_log.size() != shape_.heads * 4 ||
+        gate.size() != static_cast<std::uint64_t>(shape_.d_inner) * shape_.tokens * 4) {
+        throw std::invalid_argument("KdaGate launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &a, {shape_.d_inner, shape_.tokens}},
+        {tensor_ids_[1], &a_log, {shape_.heads, 1}},
+        {tensor_ids_[2], &gate, {shape_.d_inner, shape_.tokens}},
+    };
+    return stream.launch(recipe_, bindings);
+}
+
+// ---------------------------------------------------------------------------
+// KDA delta recurrence scan
+
+KdaScan::KdaScan(const Device& device, KdaScanShape shape,
+                 std::size_t max_workspace_bytes)
+    : shape_(shape) {
+    if (!shape.heads || !shape.head_dim || shape.head_dim > 128) {
+        throw std::invalid_argument("KdaScan: head_dim must be in [1, 128]");
+    }
+
+    synGraphHandle graph = create_graph();
+    std::vector<synTensor> created;
+    std::vector<synSectionHandle> sections;
+    try {
+        const auto d_inner = shape.heads * shape.head_dim;
+        const auto state_floats = static_cast<std::uint64_t>(shape.heads) * shape.head_dim * shape.head_dim;
+        synTensor q = create_bf16_tensor(graph, "q", {d_inner}, sections);
+        synTensor k = create_bf16_tensor(graph, "k", {d_inner}, sections);
+        synTensor v = create_bf16_tensor(graph, "v", {d_inner}, sections);
+        synTensor gate = create_f32_tensor(graph, "gate", {d_inner}, sections);
+        synTensor beta = create_f32_tensor(graph, "beta", {shape.heads}, sections);
+        synTensor state = create_f32_tensor(graph, "state",
+                                            {static_cast<std::uint32_t>(state_floats)}, sections);
+        synTensor out = create_bf16_tensor(graph, "out", {d_inner}, sections);
+        created = {q, k, v, gate, beta, state, out};
+        struct { std::int32_t head_dim; } params = {static_cast<std::int32_t>(shape.head_dim)};
+        const synTensor inputs[] = {q, k, v, gate, beta, state};
+        const synTensor outputs[] = {state, out};
+        synNodeId node = 0;
+        if (synNodeCreateWithId(graph, inputs, outputs, 6, 2, &params, sizeof(params),
+                                "glm5_kda_scan_f32", nullptr, &node, nullptr, nullptr) != synSuccess) {
+            throw SynapseError(synFail, "KdaScan node creation");
+        }
+        (void)synNodeSetRoundingMode(graph, node, synRoundToNearest);
+        recipe_ = device.compile(graph, "glm5_kda_scan", max_workspace_bytes);
+        const char* names[] = {"q", "k", "v", "gate", "beta", "state", "out"};
+        recipe_.tensor_ids(names, tensor_ids_);
+    } catch (...) {
+        destroy_graph_safe(graph, created, sections);
+        throw;
+    }
+    destroy_graph_safe(graph, created, sections);
+}
+
+Compute KdaScan::launch(Stream& stream, DeviceBuffer& q, DeviceBuffer& k,
+                        DeviceBuffer& v, DeviceBuffer& gate, DeviceBuffer& beta,
+                        DeviceBuffer& state, DeviceBuffer& out) {
+    const auto d_inner = static_cast<std::uint64_t>(shape_.heads) * shape_.head_dim;
+    const auto state_floats = static_cast<std::uint64_t>(shape_.heads) * shape_.head_dim * shape_.head_dim;
+    if (q.size() != d_inner * 2 || k.size() != d_inner * 2 || v.size() != d_inner * 2 ||
+        gate.size() != d_inner * 4 || beta.size() != shape_.heads * 4 ||
+        state.size() != state_floats * 4 || out.size() != d_inner * 2) {
+        throw std::invalid_argument("KdaScan launch: buffer size mismatch");
+    }
+    RecipeBinding bindings[] = {
+        {tensor_ids_[0], &q, {static_cast<std::uint32_t>(d_inner), 1}},
+        {tensor_ids_[1], &k, {static_cast<std::uint32_t>(d_inner), 1}},
+        {tensor_ids_[2], &v, {static_cast<std::uint32_t>(d_inner), 1}},
+        {tensor_ids_[3], &gate, {static_cast<std::uint32_t>(d_inner), 1}},
+        {tensor_ids_[4], &beta, {shape_.heads, 1}},
+        {tensor_ids_[5], &state, {static_cast<std::uint32_t>(state_floats), 1}},
+        {tensor_ids_[6], &out, {static_cast<std::uint32_t>(d_inner), 1}},
+    };
+    return stream.launch(recipe_, bindings);
+}
+
+
+// ---------------------------------------------------------------------------
+// mHC gates
+
+MhcGates::MhcGates(const Device& device, MhcGatesShape shape, float rms_eps,
+                   float hc_eps, std::uint32_t sinkhorn_iters,
+                   std::size_t max_workspace_bytes)
+    : shape_(shape), rms_eps_(rms_eps), hc_eps_(hc_eps),
+      sinkhorn_iters_(sinkhorn_iters) {
+    if (!shape.hidden || !shape.tokens) {
+        throw std::invalid_argument("MhcGates: hidden and tokens must be positive");
+    }
+    if (!(rms_eps > 0) || !(hc_eps > 0)) {
+        throw std::invalid_argument("MhcGates: epsilons must be positive");
+    }
+    if (!sinkhorn_iters) {
+        throw std::invalid_argument("MhcGates: sinkhorn_iters must be >= 1");
+    }
+
