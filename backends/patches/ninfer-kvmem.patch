+        const std::vector<std::function<void(ninfer::EngineOptions&)>> invalid{
+            [](auto& o) { o.max_concurrency = 2; },
+            [](auto& o) { o.max_concurrency = 9;
+                         o.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(2304); },
