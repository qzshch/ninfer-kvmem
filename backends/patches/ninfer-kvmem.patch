index 0000000000000000000000000000000000000000..04c94621abdfbccbb4522960988af4f90748eb9d
--- /dev/null
+++ b/src/models/glm5/reference/kda_reference.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kKdaReferenceProfile = "glm53_kda_fp32";
+
+// GLM-5.3-Flash's audited linear-attention geometry: 34 KDA layers, 64 heads of
+// 128, causal short conv of 4 taps and the -5.0 safe gate lower bound
+// (glm53-config evidence, 2026-10-23 header audit).
+struct KdaProfile {
+    uint32_t heads;
+    uint32_t head_dim;
+    uint32_t d_conv;
+    float gate_lower_bound;
+};
+inline constexpr KdaProfile kGlm53KdaProfile{64, 128, 4, -5.0f};
+
+// Bounded scratch requirement of kda_gated_delta_reference, in floats: one full
+// state image for the validate-then-commit state update.
+[[nodiscard]] constexpr size_t kda_state_values(const KdaProfile& profile) {
+    return size_t(profile.heads) * profile.head_dim * profile.head_dim;
+}
+
+// Total scratch of kda_gated_delta_reference: the state image followed by one
+// output image, both committed only after the whole scan validates.
+[[nodiscard]] constexpr size_t kda_scan_scratch_values(const KdaProfile& profile, size_t tokens) {
+    return kda_state_values(profile) + tokens * size_t(profile.heads) * profile.head_dim;
+}
+
+// Causal per-channel short conv followed by SiLU. x is [tokens][d_inner] with
+// d_inner = heads*head_dim, weights [d_inner][d_conv], conv_state [d_conv-1][d_inner]
+// oldest tap first. Each out element is published once it is finite; conv_state
+// is advanced to the last d_conv-1 columns of [conv_state | x] only after every
+// element succeeded. No projections, activation gating or HPU dispatch.
+void kda_conv_reference(std::span<const float> x, std::span<const float> weights,
+                        std::span<float> conv_state, std::span<float> out, const KdaProfile&);
+
+// Safe-path decay gate in LOG space: out[t][h*head_dim+i] =
+// gate_lower_bound * sigmoid(exp(a_log[h]) * g[t][h*head_dim+i]), i.e. values in
+// (gate_lower_bound, 0] that the scan exponentiates. g is the already-summed
+// f_b(f_a(x)) + dt_bias plane; A_log is per head. FP32 sigmoid and exp, no
+// softplus fallback: GLM-5.3-Flash fixes the safe path.
+void kda_decay_gate_reference(std::span<const float> g, std::span<const float> a_log,
+                              std::span<float> out, const KdaProfile&);
+
+// Gated delta rule scan over tokens. q/k/v are post-conv SiLU [tokens][d_inner];
+// q and k get FLA l2 norm (eps 1e-6 inside the sqrt) and q additionally the
+// head_dim^-0.5 scale, both in FP32, matching the fused kernel's in-kernel path.
+// gate is the kda_decay_gate_reference output (log space, decay applied as
+// exp(gate) on the KEY axis); beta is ALREADY sigmoided [tokens][heads].
+// state is [heads][head_dim key][head_dim value], row = key axis; scratch must
+// hold kda_scan_scratch_values(profile, tokens) floats (one state image then
+// one output image) and must not alias any plane. out is [tokens][d_inner];
+// out and state change together, only after the whole scan validates (a
+// non-finite intermediate rejects the call leaving both untouched). This is
+// the recurrent algorithm only; chunk prefill is a separate future module.
+void kda_gated_delta_reference(std::span<const float> q, std::span<const float> k,
+                               std::span<const float> v, std::span<const float> gate,
+                               std::span<const float> beta, std::span<float> state,
+                               std::span<float> out, std::span<float> scratch, const KdaProfile&);
+
+// Output gate: per token and head, o is RMS-normalized over head_dim (eps 1e-6,
+// FP32), multiplied by norm_w and by sigmoid(g2), writing [tokens][d_inner].
+// o and out may alias: publication happens only after all values validate.
+void kda_out_gate_reference(std::span<const float> o, std::span<const float> g2,
+                            std::span<const float> norm_w, std::span<float> out,
+                            const KdaProfile&);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/mhc_reference.cpp b/src/models/glm5/reference/mhc_reference.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fc8141455608c3e447382781b900af71c48e4db7
--- /dev/null
+++ b/src/models/glm5/reference/mhc_reference.cpp
@@ -0,0 +1,216 @@
+#include "models/glm5/reference/mhc_reference.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+constexpr uint32_t kGlmHc = 4;
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "GLM mHC reference requires IEEE-754 binary32");
+
+float sigmoid(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("mHC reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+
+size_t token_count(std::span<const float> plane, size_t per_token, const char* what) {
+    if (per_token == 0 || plane.size() % per_token != 0)
+        throw std::invalid_argument(what);
+    return plane.size() / per_token;
+}
+}  // namespace
+
+void mhc_pre_reference(std::span<const float> streams, std::span<const float> fn,
+                       std::span<const float> base, std::span<const float> scale,
+                       std::span<float> pre, std::span<float> post, std::span<float> comb,
+                       std::span<float> collapsed, const MhcProfile& profile, uint32_t hidden) {
+    if (profile.hc != kGlmHc)
+        throw std::invalid_argument("mHC reference pins the audited 4-stream geometry");
+    if (profile.hc == 0 || hidden == 0 || profile.sinkhorn_iters == 0)
+        throw std::invalid_argument("mHC profile is degenerate");
+    if (!std::isfinite(profile.rms_eps) || profile.rms_eps < 0 ||
+        !std::isfinite(profile.hc_eps) || profile.hc_eps < 0)
+        throw std::invalid_argument("mHC profile epsilons must be finite and nonnegative");
+    const size_t hc = profile.hc;
+    const size_t stream_values = checked_mul(hc, hidden);
+    const size_t mix_values = checked_mul(2 + hc, hc);
+    const size_t tokens = token_count(streams, stream_values,
+                                      "mHC streams are not whole flattened token planes");
+    if (fn.size() != checked_mul(mix_values, stream_values) || base.size() != mix_values ||
+        scale.size() != 3)
+        throw std::invalid_argument("mHC parameters do not match the profile");
+    if (pre.size() != checked_mul(tokens, hc) || post.size() != pre.size() ||
+        comb.size() != checked_mul(tokens, checked_mul(hc, hc)) ||
+        collapsed.size() != checked_mul(tokens, hidden))
+        throw std::invalid_argument("mHC weight plane sizes do not match the token count");
+    if (tokens == 0) throw std::invalid_argument("mHC requires at least one token");
+    demand_finite(streams, "mHC streams must be finite");
+    demand_finite(fn, "mHC fn must be finite");
+    demand_finite(base, "mHC base must be finite");
+    demand_finite(scale, "mHC scale must be finite");
+
+    for (size_t t = 0; t < tokens; ++t) {
+        const float* row = streams.data() + t * stream_values;
+        float mean_square = 0;
+        for (size_t i = 0; i < stream_values; ++i) mean_square += row[i] * row[i];
+        const float inverse = 1.0f / std::sqrt(mean_square / static_cast<float>(stream_values) +
+                                               profile.rms_eps);
+
+        // Mix projection on the normalized plane, left-to-right accumulation.
+        static_assert((2 + kGlmHc) * kGlmHc == 24);
+        float mix_row[24];
+        for (size_t m = 0; m < mix_values; ++m) {
+            const float* weights = fn.data() + m * stream_values;
+            float acc = 0;
+            for (size_t i = 0; i < stream_values; ++i) acc = std::fma(weights[i], row[i], acc);
+            mix_row[m] = acc * inverse;
+        }
+        for (size_t m = 0; m < mix_values; ++m)
+            if (!std::isfinite(mix_row[m])) throw std::overflow_error("mHC mix overflowed");
+
+        float* pre_t = pre.data() + t * hc;
+        float* post_t = post.data() + t * hc;
+        for (size_t n = 0; n < hc; ++n) {
+            const float pre_logit = mix_row[n] * scale[0] + base[n];
+            const float post_logit = mix_row[hc + n] * scale[1] + base[hc + n];
+            pre_t[n] = sigmoid(pre_logit) + profile.hc_eps;
+            post_t[n] = 2.0f * sigmoid(post_logit);
+        }
+
+        // comb[src][dst], flat checkpoint layout comb[dst + hc*src]; softmax
+        // over dst per src row, +eps, then the pinned Sinkhorn order.
+        float* comb_t = comb.data() + t * hc * hc;
+        for (size_t src = 0; src < hc; ++src) {
+            float logits[4], maximum = 0;
+            for (size_t dst = 0; dst < hc; ++dst) {
+                const size_t flat = 2 * hc + dst + hc * src;
+                logits[dst] = mix_row[flat] * scale[2] + base[flat];
+                if (dst == 0 || logits[dst] > maximum) maximum = logits[dst];
+            }
+            float denominator = 0;
+            float exps[4];
+            for (size_t dst = 0; dst < hc; ++dst) {
+                exps[dst] = std::exp(logits[dst] - maximum);
+                denominator += exps[dst];
+            }
+            for (size_t dst = 0; dst < hc; ++dst)
+                comb_t[src * hc + dst] = exps[dst] / denominator + profile.hc_eps;
+        }
+        auto column_normalize = [&]() {   // each dst sums to 1 over src
+            for (size_t dst = 0; dst < hc; ++dst) {
+                float sum = 0;
+                for (size_t src = 0; src < hc; ++src) sum += comb_t[src * hc + dst];
+                const float inverse_sum = 1.0f / (sum + profile.hc_eps);
+                for (size_t src = 0; src < hc; ++src)
+                    comb_t[src * hc + dst] *= inverse_sum;
+            }
+        };
+        auto row_normalize = [&]() {      // each src sums to 1 over dst
+            for (size_t src = 0; src < hc; ++src) {
+                float sum = 0;
+                for (size_t dst = 0; dst < hc; ++dst) sum += comb_t[src * hc + dst];
+                const float inverse_sum = 1.0f / (sum + profile.hc_eps);
+                for (size_t dst = 0; dst < hc; ++dst)
+                    comb_t[src * hc + dst] *= inverse_sum;
+            }
+        };
+        column_normalize();
+        for (uint32_t round = 1; round < profile.sinkhorn_iters; ++round) {
+            row_normalize();
+            column_normalize();
+        }
+
+        float* collapsed_t = collapsed.data() + t * hidden;
+        for (size_t d = 0; d < hidden; ++d) {
+            float acc = 0;
+            for (size_t n = 0; n < hc; ++n) acc = std::fma(pre_t[n], row[n * hidden + d], acc);
+            collapsed_t[d] = acc;
+        }
+        for (size_t n = 0; n < hc; ++n)
+            if (!std::isfinite(pre_t[n]) || !std::isfinite(post_t[n]))
+                throw std::overflow_error("mHC gate overflowed");
+        for (size_t i = 0; i < hc * hc; ++i)
+            if (!std::isfinite(comb_t[i])) throw std::overflow_error("mHC comb overflowed");
+        for (size_t d = 0; d < hidden; ++d)
+            if (!std::isfinite(collapsed_t[d])) throw std::overflow_error("mHC collapse overflowed");
+    }
+}
+
+void mhc_post_reference(std::span<const float> block, std::span<const float> residual,
+                        std::span<const float> post, std::span<const float> comb,
+                        std::span<float> out, const MhcProfile& profile, uint32_t hidden) {
+    const size_t hc = profile.hc;
+    const size_t stream_values = checked_mul(hc, hidden);
+    const size_t tokens = token_count(residual, stream_values,
+                                      "mHC residual is not whole flattened token planes");
+    if (block.size() != checked_mul(tokens, hidden) || post.size() != checked_mul(tokens, hc) ||
+        comb.size() != checked_mul(tokens, checked_mul(hc, hc)) || out.size() != residual.size())
+        throw std::invalid_argument("mHC post plane sizes do not match the token count");
+    if (tokens == 0) throw std::invalid_argument("mHC requires at least one token");
+    demand_finite(block, "mHC block output must be finite");
+    demand_finite(residual, "mHC residual must be finite");
+    demand_finite(post, "mHC post must be finite");
+    demand_finite(comb, "mHC comb must be finite");
+
+    // Per token: compute the whole output row, validate, then publish, so that
+    // an out aliasing residual never mixes old and new stream values.
+    std::vector<float> staged;
+    staged.resize(stream_values);
+    for (size_t t = 0; t < tokens; ++t) {
+        const float* block_t = block.data() + t * hidden;
+        const float* residual_t = residual.data() + t * stream_values;
+        const float* post_t = post.data() + t * hc;
+        const float* comb_t = comb.data() + t * hc * hc;
+        for (size_t dst = 0; dst < hc; ++dst) {
+            for (size_t d = 0; d < hidden; ++d) {
+                float mix = 0;
+                for (size_t src = 0; src < hc; ++src)
+                    mix = std::fma(comb_t[src * hc + dst], residual_t[src * hidden + d], mix);
+                staged[dst * hidden + d] = std::fma(post_t[dst], block_t[d], mix);
+            }
+        }
+        for (size_t i = 0; i < stream_values; ++i)
+            if (!std::isfinite(staged[i])) throw std::overflow_error("mHC post overflowed");
+        float* out_t = out.data() + t * stream_values;
+        for (size_t i = 0; i < stream_values; ++i) out_t[i] = staged[i];
+    }
+}
+
+void mhc_head_reference(std::span<const float> streams, std::span<float> out,
+                        const MhcProfile& profile, uint32_t hidden) {
+    const size_t hc = profile.hc;
+    const size_t stream_values = checked_mul(hc, hidden);
+    const size_t tokens = token_count(streams, stream_values,
+                                      "mHC streams are not whole flattened token planes");
+    if (out.size() != checked_mul(tokens, hidden))
+        throw std::invalid_argument("mHC head output size mismatch");
+    if (tokens == 0) throw std::invalid_argument("mHC requires at least one token");
+    demand_finite(streams, "mHC streams must be finite");
+    const float inverse_count = 1.0f / static_cast<float>(hc);
+    for (size_t t = 0; t < tokens; ++t) {
+        const float* row = streams.data() + t * stream_values;
+        float* out_t = out.data() + t * hidden;
+        // hidden-major accumulation keeps an out alias safe: element d reads
+        // only the d-th column of every stream.
+        for (size_t d = 0; d < hidden; ++d) {
+            float acc = 0;
+            for (size_t n = 0; n < hc; ++n) acc += row[n * hidden + d];
+            const float mean = acc * inverse_count;
+            if (!std::isfinite(mean)) throw std::overflow_error("mHC head overflowed");
+            out_t[d] = mean;
+        }
+    }
+}
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/mhc_reference.h b/src/models/glm5/reference/mhc_reference.h
new file mode 100644
index 0000000000000000000000000000000000000000..99753425cd97486a346e53fb292e6ce3877feae0
--- /dev/null
+++ b/src/models/glm5/reference/mhc_reference.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kMhcReferenceProfile = "glm53_mhc_fp32";
+
+// GLM-5.3-Flash's audited mHC geometry: 4 hyper-connection streams, 20 Sinkhorn
+// iterations, epsilon 1e-6 on every gate/denominator and the unweighted RMS
+// norm over the flattened streams (eps 1e-5). hc is pinned to 4 by both
+// production references; the parameterization only keeps test sizes honest.
+struct MhcProfile {
+    uint32_t hc;
+    float rms_eps;
+    float hc_eps;
+    uint32_t sinkhorn_iters;
+};
+inline constexpr MhcProfile kGlm53MhcProfile{4, 1e-5f, 1e-6f, 20};
+
+// Size of one token's flattened stream plane / mix vector for a profile.
+[[nodiscard]] constexpr size_t mhc_stream_values(const MhcProfile& p, uint32_t hidden) {
+    return size_t(p.hc) * hidden;
+}
+[[nodiscard]] constexpr size_t mhc_mix_values(const MhcProfile& p) {
+    return (2 + p.hc) * p.hc;  // pre | post | comb, in this flat order
+}
+
+// Weight generation for one mHC site (attn or ffn; parameters are per-site).
+// streams is [tokens][hc*hidden] FP32; fn is [mix_values][hc*hidden] row-major,
+// base [mix_values] and scale exactly [pre, post, comb]. All arithmetic FP32:
+// the flattened streams get the UNWEIGHTED RMS norm (eps inside the sqrt), the
+// mix projection is a plain left-to-right FP32 dot, pre = sigmoid+scaled by
+// pre_scale + base then +hc_eps, post = 2*sigmoid(...), and comb is built from
+// the flat layout comb[dst + hc*src] as a softmax over dst (each src row)
+// followed by Sinkhorn: one column normalization (sum over src, +hc_eps), then
+// sinkhorn_iters-1 rounds of {row over dst, column over src}, each +hc_eps.
+//
+// pre/post/comb are [tokens][hc]/[tokens][hc]/[tokens][hc*hc] in that same
+// comb[src,dst] order; collapsed is [tokens][hidden] = sum_n pre[n]*streams[n]
+// rounded from the FP32 accumulation. Inputs must be finite (validated); each
+// token's planes publish once all of its values validate, so an adversarial
+// overflow leaves only earlier tokens written.
+void mhc_pre_reference(std::span<const float> streams, std::span<const float> fn,
+                       std::span<const float> base, std::span<const float> scale,
+                       std::span<float> pre, std::span<float> post, std::span<float> comb,
+                       std::span<float> collapsed, const MhcProfile&, uint32_t hidden);
+
+// Stream update after the block: out[dst] = post[dst]*block_output +
+// sum_src comb[src,dst] * residual[src]. block is [tokens][hidden]; residual
+// and out are [tokens][hc*hidden] FP32 and may alias each other (publication
+// is per token after the whole token validates). pre/post/comb come from
+// mhc_pre_reference on that same residual.
+void mhc_post_reference(std::span<const float> block, std::span<const float> residual,
+                        std::span<const float> post, std::span<const float> comb,
+                        std::span<float> out, const MhcProfile&, uint32_t hidden);
+
+// Final head: the UNWEIGHTED mean of the streams, [tokens][hc*hidden] ->
+// [tokens][hidden]. out may alias the input.
+void mhc_head_reference(std::span<const float> streams, std::span<float> out,
+                        const MhcProfile&, uint32_t hidden);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/state.h b/src/models/glm5/state.h
new file mode 100644
index 0000000000000000000000000000000000000000..62f6fe9d6666ca19934cd56d55910a04f122c5d8
--- /dev/null
+++ b/src/models/glm5/state.h
@@ -0,0 +1,76 @@
+#pragma once
+
+// Per-sequence persistent state layout of GLM-5.3-Flash, derived from the
+// parsed text config and cross-checked against the audited capacity plan:
+// KDA carries an FP32 matrix state plus three causal-conv planes per block;
+// each DSA block caches ONLY the compressed MLA latent (NoPE) plus the
+// indexer's packed [key|gate|valid] row and one pooled key per completed
+// 4-token pool. The layout counts values; bytes come from the caller's dtype.
+
+#include "models/glm5/config.h"
+
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::models::glm5 {
+
+class Glm5StateLayout {
+public:
+    explicit Glm5StateLayout(const TextConfig& config) : config_(config) {
+        kda_blocks_ = 0;
+        dsa_blocks_ = 0;
+        for (const auto kind : config.layer_types) {
+            kda_blocks_ += kind == MixerKind::Kda;
+            dsa_blocks_ += kind == MixerKind::Dsa;
+        }
+        if ((kda_blocks_ + dsa_blocks_) != config.num_hidden_layers) {
+            throw std::invalid_argument("GLM5 state: layer types do not cover every block");
+        }
+    }
+
+    // ---- per-sequence, position-independent state ----
+    // FP32 gated-delta matrix S, [heads][head_dim key][head_dim value] per KDA block.
+    [[nodiscard]] std::uint64_t kda_matrix_floats() const {
+        return std::uint64_t(kda_blocks_) * config_.linear_num_heads * config_.linear_head_dim *
+               config_.linear_head_dim;
+    }
+    // Three causal conv planes (q/k/v), (kernel-1) taps over the KDA inner width.
+    [[nodiscard]] std::uint64_t kda_conv_values() const {
+        return std::uint64_t(kda_blocks_) * 3 * (config_.linear_conv_kernel - 1) *
+               config_.linear_inner_width();
+    }
+
+    // ---- per-sequence, per-logical-position state ----
+    // The MLA latent is the ONLY attention cache: NoPE means no rope component.
+    [[nodiscard]] std::uint64_t mla_latent_values_per_position() const {
+        return std::uint64_t(dsa_blocks_) * config_.kv_lora_rank;
+    }
+    // The indexer's packed row [key | gate | valid] per DSA block.
+    [[nodiscard]] std::uint64_t indexer_packed_values_per_position() const {
+        return std::uint64_t(dsa_blocks_) * (2 * config_.index_head_dim + 1);
+    }
+
+    // ---- per-sequence, per-completed-pool state ----
+    [[nodiscard]] std::uint64_t indexer_pool_key_values_per_pool() const {
+        return std::uint64_t(dsa_blocks_) * config_.index_head_dim;
+    }
+    [[nodiscard]] std::uint64_t completed_pools(std::uint64_t positions) const {
+        return positions / config_.index_kpool;
+    }
+
+    // The decode step's working set for one block boundary (single token):
+    // the mHC residual streams are the model's running hidden state.
+    [[nodiscard]] std::uint64_t mhc_stream_values() const {
+        return std::uint64_t(config_.hc_mult) * config_.hidden_size;
+    }
+
+    [[nodiscard]] std::uint32_t kda_blocks() const noexcept { return kda_blocks_; }
+    [[nodiscard]] std::uint32_t dsa_blocks() const noexcept { return dsa_blocks_; }
+
+private:
+    TextConfig config_;
+    std::uint32_t kda_blocks_ = 0;
+    std::uint32_t dsa_blocks_ = 0;
+};
+
+} // namespace ninfer::models::glm5
diff --git a/src/models/qwen3_5/execution/attention.cpp b/src/models/qwen3_5/execution/attention.cpp
index 4533e7c6345451fd3d82a3ee2e64e4191368a47c..eee43ae316526e28cb872865caac8ce086cdc47b 100644
--- a/src/models/qwen3_5/execution/attention.cpp
+++ b/src/models/qwen3_5/execution/attention.cpp
@@ -5,6 +5,7 @@
