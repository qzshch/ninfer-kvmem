diff --git a/src/ops/kernel/glm5_dsa.cuh b/src/ops/kernel/glm5_dsa.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..6a23a17a7e90232b929b23cd3810d119653ac901
--- /dev/null
+++ b/src/ops/kernel/glm5_dsa.cuh
@@ -0,0 +1,243 @@
+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash DSA kernels: per-element pool compression, ReLU head scoring,
+// ranked selection with the incomplete tail, and the absorbed sparse attention. Math follows
+// models/glm5/reference/dsa_reference (audited semantics: per-key-dim softmax, rank ties by
+// lower pool index, -1 slots excluded from softmax and context, 256^-0.5 model constant).
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_dsa_detail {
+
+constexpr int kThreads = 256;
+constexpr float kNegInf = -3.0e38f;
+
+__global__ void pool_kernel(const __nv_bfloat16* __restrict__ ik, const __nv_bfloat16* __restrict__ ig,
+                            const float* __restrict__ ape, std::int32_t dim, std::int32_t kpool,
+                            std::int32_t pools, float* __restrict__ pooled) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t p = static_cast<std::int32_t>(index / dim);
+    const std::int32_t e = static_cast<std::int32_t>(index % dim);
+    if (p >= pools) { return; }
+    float logits[8], exps[8], maximum = 0.0f;
+    for (std::int32_t m = 0; m < kpool; ++m) {
+        logits[m] = __bfloat162float(ig[static_cast<std::int64_t>(p * kpool + m) * dim + e]) +
+                    ape[m * dim + e];
+        if (m == 0 || logits[m] > maximum) { maximum = logits[m]; }
+    }
+    float denominator = 0.0f;
+    for (std::int32_t m = 0; m < kpool; ++m) {
+        exps[m] = expf(logits[m] - maximum);
+        denominator += exps[m];
+    }
+    const float inverse = 1.0f / denominator;
+    float acc = 0.0f;
+    for (std::int32_t m = 0; m < kpool; ++m) {
+        acc = fmaf(exps[m] * inverse, __bfloat162float(ik[static_cast<std::int64_t>(p * kpool + m) * dim + e]), acc);
+    }
+    pooled[index] = acc;
+}
+
+// One thread per (pool); every head's ReLU dot walks the key dim.
+__global__ void score_kernel(const __nv_bfloat16* __restrict__ iq, const float* __restrict__ pooled,
+                             const float* __restrict__ weights, std::int32_t dim,
+                             std::int32_t heads, std::int32_t pools, float* __restrict__ score) {
+    const std::int32_t p = static_cast<std::int32_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (p >= pools) { return; }
+    const float* key = pooled + static_cast<std::int64_t>(p) * dim;
+    float acc = 0.0f;
+    for (std::int32_t h = 0; h < heads; ++h) {
+        const __nv_bfloat16* q = iq + static_cast<std::int64_t>(h) * dim;
+        float dot = 0.0f;
+        for (std::int32_t e = 0; e < dim; ++e) {
+            dot = fmaf(__bfloat162float(q[e]), key[e], dot);
+        }
+        acc = fmaf(fmaxf(dot, 0.0f), weights[h], acc);
+    }
+    score[p] = acc;
+}
+
+// One block: iterative block argmax over the visible pools, min(top_pools, n_vis) rounds.
+// Ties break by lower pool index because the scan keeps the first strict maximum.
+__global__ void select_kernel(const float* __restrict__ score, std::int32_t pools,
+                              std::uint32_t position, std::int32_t kpool, std::int32_t top_pools,
+                              std::int32_t select_tail, std::int32_t width, std::int32_t* __restrict__ cells) {
+    extern __shared__ float s_score[];   // [pools]
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const std::int32_t visible = static_cast<std::int32_t>((position + 1) / kpool);
+    const std::int32_t n_vis = min(visible, pools);
+    for (std::int32_t p = tid; p < pools; p += blockDim.x) {
+        s_score[p] = p < n_vis ? score[p] : kNegInf;
+    }
+    __syncthreads();
+    for (std::int32_t s = tid; s < width; s += blockDim.x) { cells[s] = -1; }
+    __syncthreads();
+
+    const std::int32_t picks = min(top_pools, n_vis);
+    for (std::int32_t rank = 0; rank < picks; ++rank) {
+        // Block argmax: each thread scans its stride, stage the winning (value, index).
+        float best_value = kNegInf;
+        std::int32_t best_index = 0;
+        for (std::int32_t p = tid; p < n_vis; p += blockDim.x) {
+            if (s_score[p] > best_value) {
+                best_value = s_score[p];
+                best_index = p;
+            }
+        }
+        // Reduce through shared memory: lanes stage then thread 0 folds. Values are finite
+        // scores or kNegInf for already-picked entries, so a plain max keeps determinism;
+        // equal values resolve to the SMALLER index by construction below.
+        __shared__ float s_val[kThreads];
+        __shared__ std::int32_t s_idx[kThreads];
+        s_val[tid] = best_value;
+        s_idx[tid] = best_index;
+        __syncthreads();
+        if (tid == 0) {
+            float value = kNegInf;
+            std::int32_t index = 0x7fffffff;
+            for (std::int32_t i = 0; i < blockDim.x; ++i) {
+                if (s_val[i] > value || (s_val[i] == value && s_idx[i] < index)) {
+                    value = s_val[i];
+                    index = s_idx[i];
+                }
+            }
+            // Smaller index wins ties: replace the winner's score so the next round moves on.
+            s_val[0] = value;
+            s_idx[0] = index;
+        }
+        __syncthreads();
+        const std::int32_t winner = s_idx[0];
+        __syncthreads();
+        if (tid == 0) { s_score[winner] = kNegInf; }
+        for (std::int32_t m = tid; m < kpool; m += blockDim.x) {
+            cells[rank * kpool + m] = winner * kpool + m;
+        }
+        __syncthreads();
+    }
+    if (select_tail) {
+        const std::int32_t tail_base = top_pools * kpool;
+        for (std::int32_t m = tid; m + 1 < kpool; m += blockDim.x) {
+            const std::int32_t cell = n_vis * kpool + m;
+            cells[tail_base + m] = cell <= static_cast<std::int32_t>(position) ? cell : -1;
+        }
+    }
+}
+
+// One block per head: scores over the selection row, softmax excluding -1, context
+// accumulation in shared memory, then the absorbed W_V_B per head.
+__global__ void attention_kernel(const __nv_bfloat16* __restrict__ q_abs,
+                                 const __nv_bfloat16* __restrict__ latents,
+                                 const std::int32_t* __restrict__ cells,
+                                 const __nv_bfloat16* __restrict__ wv_b, std::int32_t width,
+                                 std::int32_t lora, std::int32_t v_head, std::int32_t qk_nope,
+                                 __nv_bfloat16* __restrict__ out) {
+    const std::int32_t h = static_cast<std::int32_t>(blockIdx.x);
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const __nv_bfloat16* q = q_abs + static_cast<std::int64_t>(h) * lora;
+    const float scale = rsqrtf(static_cast<float>(qk_nope));
+
+    extern __shared__ float s_prob[];   // [width]
+    float* s_ctx = s_prob + width;      // [lora]
+    __shared__ float s_fold[kThreads];
+
+    bool any = false;
+    float maximum = 0.0f;
+    for (std::int32_t s = tid; s < width; s += kThreads) {
+        const std::int32_t cell = cells[s];
+        if (cell < 0) { s_prob[s] = kNegInf; continue; }
+        const __nv_bfloat16* latent = latents + static_cast<std::int64_t>(cell) * lora;
+        float dot = 0.0f;
+        for (std::int32_t e = 0; e < lora; ++e) {
+            dot = fmaf(__bfloat162float(q[e]), __bfloat162float(latent[e]), dot);
+        }
+        const float value = dot * scale;
+        s_prob[s] = value;
+        if (!any || value > maximum) { maximum = value; any = true; }
+    }
+    __syncthreads();
+    s_fold[tid] = any ? maximum : kNegInf;
+    __syncthreads();
+    if (tid == 0) {
+        float value = kNegInf;
+        for (std::int32_t i = 0; i < kThreads; ++i) { value = fmaxf(value, s_fold[i]); }
+        s_prob[width + lora] = value;   // park the max past the context plane
+    }
+    __syncthreads();
+    const float top = s_prob[width + lora];
+
+    float part = 0.0f;
+    for (std::int32_t s = tid; s < width; s += kThreads) {
+        if (cells[s] < 0) { continue; }
+        const float value = expf(s_prob[s] - top);
+        s_prob[s] = value;
+        part += value;
+    }
+    __syncthreads();
+    s_fold[tid] = part;
+    __syncthreads();
+    if (tid == 0) {
+        float value = 0.0f;
+        for (std::int32_t i = 0; i < kThreads; ++i) { value += s_fold[i]; }
+        s_prob[width + lora] = value > 0.0f ? value : 1.0f;
+    }
+    __syncthreads();
+    const float inverse = 1.0f / s_prob[width + lora];
+
+    // ctx[e] = sum over valid slots of prob_s * latent[s][e].
+    for (std::int32_t e = tid; e < lora; e += kThreads) {
+        float acc = 0.0f;
+        for (std::int32_t s = 0; s < width; ++s) {
+            if (cells[s] < 0) { continue; }
+            acc = fmaf(s_prob[s] * inverse,
+                       __bfloat162float(latents[static_cast<std::int64_t>(cells[s]) * lora + e]),
+                       acc);
+        }
+        s_ctx[e] = acc;
+    }
+    __syncthreads();
+
+    // out[h, v] = sum_c wv_b[c + lora*v + lora*v_head*h] * ctx[c].
+    const __nv_bfloat16* column = wv_b + static_cast<std::int64_t>(lora) * v_head * h;
+    for (std::int32_t v = tid; v < v_head; v += kThreads) {
+        const __nv_bfloat16* weights = column + static_cast<std::int64_t>(lora) * v;
+        float acc = 0.0f;
+        for (std::int32_t c = 0; c < lora; ++c) {
+            acc = fmaf(__bfloat162float(weights[c]), s_ctx[c], acc);
+        }
+        out[static_cast<std::int64_t>(h) * v_head + v] = __float2bfloat16(acc);
+    }
+}
+
+
+// q_abs[h, e] = sum_d q[h, d] * wk_b[d + nope*e + nope*lora*h]: absorb W_K_B into the query.
+// GGUF wk_b is {nope, lora, heads} (ne0 = the nope input dim fastest).
+__global__ void absorb_kernel(const __nv_bfloat16* __restrict__ q,
+                              const __nv_bfloat16* __restrict__ wk_b, std::int32_t nope,
+                              std::int32_t lora, std::int32_t heads, float* __restrict__ q_abs) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t h = static_cast<std::int32_t>(index / lora);
+    const std::int32_t e = static_cast<std::int32_t>(index % lora);
+    if (h >= heads) { return; }
+    const __nv_bfloat16* head_w = wk_b + static_cast<std::int64_t>(nope) * lora * h;
+    float acc = 0.0f;
+    for (std::int32_t d = 0; d < nope; ++d) {
+        acc = fmaf(__bfloat162float(q[static_cast<std::int64_t>(h) * nope + d]),
+                   __bfloat162float(head_w[static_cast<std::int64_t>(d) + static_cast<std::int64_t>(nope) * e]),
+                   acc);
+    }
+    q_abs[index] = acc;
+}
+
+// out = values * factor over a plane.
+__global__ void scale_kernel(const float* __restrict__ values, float factor,
+                             std::int64_t elements, float* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    out[index] = values[index] * factor;
+}
+
+} // namespace glm5_dsa_detail
+} // namespace ninfer::ops
