+        return bf16(v);
+    };
+
+    std::vector<float> emb(VOCAB * H), lm_head_w = plane(VOCAB, H, 31), out_norm = gamma(H, 32);
+    for (std::size_t i = 0; i < emb.size(); ++i) {
