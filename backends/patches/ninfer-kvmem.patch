+++ b/src/core/gaudi2/tpc/glue/README.md
@@ -0,0 +1,58 @@
+# GLM-5.3-Flash TPC kernel library glue (SynapseAI GC channel)
+
+This directory is the bridge that turns the TPC-C kernels in `../kernels/`
+into loadable SynapseAI custom kernels: the GC (Graph Compiler) calls into a
+host shared library at graph-build time to fetch each kernel's ELF, its index
+space, access patterns, and scalar parameters. The layout follows Intel's
+Habana_Custom_Kernel template (BSD-3):
+
+```
+glue/
+  include/            # vendored SDK headers (gc_interface.h etc.) - see below
+  src/glm5_tpc_glue.cpp   # one glue class per kernel GUID
+  entry_points.cpp    # GetKernelGuids / InstantiateTpcKernel exports
+  build_glue.sh       # offline build: tpc-clang -> objcopy blob -> .so
+```
+
+## Channel
+
+- **Old interface** (`GetKernelNames` / `GetGcDefinitions`): the glue class
+  validates tensor count/dtypes, defines the index-space geometry and the
+  per-dimension affine access patterns `f(i) = a*i + b` that map index space
+  to tensor elements, packs the scalar params struct, and memcpy's the
+  kernel ELF (embedded via `objcopy -I binary`) into the descriptor.
+- **New interface** (`tpc_kernel_lib_interface.h`): `GetKernelGuids` /
+  `InstantiateTpcKernel` wrap the same definitions.
+
+Both land in one `libglm5_tpc.so`; `synInitialize`-time loading of that
+library (via `LD_PRELOAD` or the SynapseAI kernel-lib registry) makes the
+GUIDs below resolvable by `synNodeCreateWithId`.
+
+## GUIDs and index spaces (production shapes)
+
+| GUID | Kernel | Index space | Mapping |
+|---|---|---|---|
+| `glm5_rmsnorm_bf16` | rmsnorm | {D/128 (rounded), T} | all-simd dim0, token dim1 |
+| `glm5_kda_gate_bf16` | kda gate | {D/128, T} | as rmsnorm; scalars lb, head_dim |
+
+The remaining fourteen kernels follow the same two patterns (FCD-split row
+kernels) or the head/selection shapes documented in `../kernels/README.md`;
+each gets its glue class as it is brought up on hardware.
+
+## Offline build (WSL, no Gaudi2 required)
+
+```
+bash build_glue.sh
+```
+
+compiles every kernel with `tpc-clang -march=gaudi2`, wraps each ELF with
+`objcopy -I binary` (the `_binary__..._start/end` symbols), and links the
+glue + entry points into `libglm5_tpc.so`. The .so needs a SynapseAI
+runtime to actually load (graph build invokes it); offline we verify the
+exports and the ELF blob sizes.
+
+## Vendored headers
+
+`gc_interface.h` and `tpc_kernel_lib_interface.h` come from the
+`habanatools` package (Habana vault, BSD-3 licensed SDK tools). They are
+API surface, not runtime code.
diff --git a/src/core/gaudi2/tpc/glue/build_glue.sh b/src/core/gaudi2/tpc/glue/build_glue.sh
new file mode 100644
index 0000000..7a28aa2
--- /dev/null
+++ b/src/core/gaudi2/tpc/glue/build_glue.sh
@@ -0,0 +1,43 @@
+#!/bin/bash
+# Offline build of the GLM TPC kernel library: compile ALL sixteen kernels
+# with tpc-clang, objcopy-wrap each ELF into an x86 linkable blob, and link
+# the glue + entry points into libglm5_tpc.so. No Gaudi2 device required -
+# the .so only needs SynapseAI at graph-build time.
+set -eu
+HERE="$(cd "$(dirname "$0")" && pwd)"
+OUT="${1:-/tmp/glm5-tpc-glue}"
+GC="${TPC_CLANG:-$HOME/tpc-sdk/extract/opt/habanalabs/bin/tpc-clang}"
+rm -rf "$OUT" && mkdir -p "$OUT"
+
+KERNELS="rmsnorm_bf16 clamp_swiglu_bf16 kda_gate_bf16 kda_scan_f32 \
+mhc_gates_bf16 mhc_collapse_bf16 mhc_post_bf16 mhc_head_bf16 \
+moe_route_bf16 moe_combine_bf16 dsa_pool_bf16 dsa_score_f32 \
+dsa_select_f32 dsa_attention_f32 dsa_absorb_bf16 dsa_scale_f32"
+
+# objcopy derives blob symbols from the input file path; run it on a bare
+# filename inside the out dir so they land at
+# _binary_glm5_<k>_gaudi2_o_start/_end (matching the glue externs).
+cd "$OUT"
+BLOBS=()
+for k in $KERNELS; do
+    "$GC" -march=gaudi2 -c "$HERE/../kernels/glm5_${k}_gaudi2.c" \
+        -o "glm5_${k}_gaudi2.o"
+    objcopy -I binary -O elf64-x86-64 -B i386:x86-64 \
+        "glm5_${k}_gaudi2.o" "_glm5_${k}_gaudi2.o"
+    BLOBS+=("_glm5_${k}_gaudi2.o")
+done
+
+g++ -std=c++17 -shared -fPIC -Wl,-z,noexecstack \
+    -I"$HERE/include" \
+    "$HERE/src/glm5_tpc_glue.cpp" \
+    "$HERE/src/glm5_tpc_glue_special.cpp" \
+    "$HERE/entry_points.cpp" \
+    "${BLOBS[@]}" \
+    -o "$OUT/libglm5_tpc.so"
+
+# Offline verification: the GC entry points export and every blob resolves.
+nm -D "$OUT/libglm5_tpc.so" | grep -E 'GetKernelNames|GetGcDefinitions|GetKernelGuids'
+if nm "$OUT/libglm5_tpc.so" | grep -q ' U _binary'; then
+    echo "unresolved blob symbols" >&2; exit 1
+fi
+echo "== libglm5_tpc.so built ($(echo $KERNELS | wc -w) kernels embedded) =="
diff --git a/src/core/gaudi2/tpc/glue/entry_points.cpp b/src/core/gaudi2/tpc/glue/entry_points.cpp
new file mode 100644
index 0000000..aeeb110
--- /dev/null
+++ b/src/core/gaudi2/tpc/glue/entry_points.cpp
@@ -0,0 +1,152 @@
+// GLM-5.3-Flash TPC kernel library entry points. The GC queries these
+// exports when the shared library is registered. The FCD-row family is
+// table-driven (glm5_tpc_glue.cpp); the head/selection family glue lives
+// in glm5_tpc_glue_special.cpp. Adding a kernel = one table row (or one
+// definitions function) and one entry appended here.
+
+#include "gc_interface.h"
+#include "tpc_kernel_lib_interface.h"
+
+#include <cstdint>
+#include <cstring>
+
+extern "C" {
+// Table-driven FCD-row family (glm5_tpc_glue.cpp).
+gcapi::GlueCodeReturn_t glm5_fcd_row_definitions(
+    unsigned, gcapi::HabanaKernelParams_t*, gcapi::HabanaKernelInstantiation_t*,
+    const void*, unsigned);
+unsigned glm5_glue_kernel_count();
+const char* glm5_glue_kernel_name(unsigned);
+
+// Head/selection family (glm5_tpc_glue_special.cpp).
+gcapi::GlueCodeReturn_t glm5_kda_scan_get_gc_definitions(gcapi::HabanaKernelParams_t*,
+    gcapi::HabanaKernelInstantiation_t*, const void*, unsigned);
+gcapi::GlueCodeReturn_t glm5_dsa_absorb_get_gc_definitions(gcapi::HabanaKernelParams_t*,
+    gcapi::HabanaKernelInstantiation_t*, const void*, unsigned);
+gcapi::GlueCodeReturn_t glm5_dsa_score_get_gc_definitions(gcapi::HabanaKernelParams_t*,
+    gcapi::HabanaKernelInstantiation_t*, const void*, unsigned);
+gcapi::GlueCodeReturn_t glm5_dsa_select_get_gc_definitions(gcapi::HabanaKernelParams_t*,
+    gcapi::HabanaKernelInstantiation_t*, const void*, unsigned);
+gcapi::GlueCodeReturn_t glm5_dsa_attention_get_gc_definitions(gcapi::HabanaKernelParams_t*,
+    gcapi::HabanaKernelInstantiation_t*, const void*, unsigned);
+gcapi::GlueCodeReturn_t glm5_moe_route_get_gc_definitions(gcapi::HabanaKernelParams_t*,
+    gcapi::HabanaKernelInstantiation_t*, const void*, unsigned);
+}
+
+namespace {
+
+using DefinitionsFn = gcapi::GlueCodeReturn_t (*)(gcapi::HabanaKernelParams_t*,
+                                                  gcapi::HabanaKernelInstantiation_t*,
+                                                  const void*, unsigned);
+
+struct Entry {
+    const char* name;
+    DefinitionsFn definitions;  // null for table-driven FCD-row kernels
+    unsigned table_index;      // index into glm5_fcd_row_definitions
+};
+
+// Plain function table (no lambdas - some compilers reject the conversion
+// inside braced initializers). The FCD-row rows carry their table index and
+// a null fn; the six special kernels carry their direct fn.
+struct Table {
+    Entry list[32];
+    unsigned count;
+    Table() : count(0) {
+        for (unsigned i = 0; i < glm5_glue_kernel_count(); ++i) {
+            list[count] = Entry{glm5_glue_kernel_name(i), nullptr, i};
+            ++count;
+        }
+        const Entry special[] = {
+            {"glm5_kda_scan_f32", &glm5_kda_scan_get_gc_definitions, 0},
+            {"glm5_dsa_absorb_bf16", &glm5_dsa_absorb_get_gc_definitions, 0},
+            {"glm5_dsa_score_f32", &glm5_dsa_score_get_gc_definitions, 0},
+            {"glm5_dsa_select_f32", &glm5_dsa_select_get_gc_definitions, 0},
+            {"glm5_dsa_attention_f32", &glm5_dsa_attention_get_gc_definitions, 0},
+            {"glm5_moe_route_bf16", &glm5_moe_route_get_gc_definitions, 0},
+        };
+        for (const auto& e : special) list[count++] = e;
+    }
+};
+
+const Table& registry() {
+    static const Table table;
+    return table;
+}
+
+gcapi::GlueCodeReturn_t dispatch(const Entry& entry, gcapi::HabanaKernelParams_t* in,
+                                 gcapi::HabanaKernelInstantiation_t* out,
+                                 const void* user_params, unsigned params_size) {
+    return entry.definitions != nullptr
+        ? entry.definitions(in, out, user_params, params_size)
+        : glm5_fcd_row_definitions(entry.table_index, in, out, user_params,
+                                   params_size);
+}
+
+} // namespace
+
+extern "C" {
+
+// Old-style GC entry: name list + per-name definitions.
+gcapi::GlueCodeReturn_t GetKernelNames(_OUT_ char** names, unsigned* kernel_count,
+                                        gcapi::DeviceId_t device_id) {
+    if (device_id != gcapi::DEVICE_ID_GAUDI2) {
+        return gcapi::GLUE_NODE_NOT_FOUND;
+    }
+    const Table& table = registry();
+    if (names != nullptr) {
+        for (unsigned i = 0; i < table.count; ++i) {
+            std::strncpy(names[i], table.list[i].name, gcapi::MAX_NODE_NAME - 1);
+            names[i][gcapi::MAX_NODE_NAME - 1] = '\0';
+        }
+    }
+    if (kernel_count != nullptr) *kernel_count = table.count;
+    return gcapi::GLUE_SUCCESS;
+}
+
+gcapi::GlueCodeReturn_t GetGcDefinitions(_IN_ const char* name,
+                                         _IN_ gcapi::DeviceId_t device_id,
+                                         _IN_ const gcapi::UserParams_t user_params,
+                                         _IN_ unsigned params_size,
+                                         _IN_ gcapi::HabanaKernelParams_t* in_defs,
+                                         _OUT_ gcapi::HabanaKernelInstantiation_t* out_defs) {
+    if (device_id != gcapi::DEVICE_ID_GAUDI2) {
+        return gcapi::GLUE_NODE_NOT_FOUND;
+    }
+    const Table& table = registry();
+    for (unsigned i = 0; i < table.count; ++i) {
+        if (std::strcmp(name, table.list[i].name) == 0) {
+            return dispatch(table.list[i], in_defs, out_defs, user_params,
+                            params_size);
+        }
+    }
+    return gcapi::GLUE_NODE_NOT_FOUND;
+}
+
+// New-style kernel-library entry: GUID registration.
+tpc_lib_api::GlueCodeReturn GetKernelGuids(_IN_ tpc_lib_api::DeviceId device_id,
+                                            _INOUT_ std::uint32_t* kernel_count,
+                                            _OUT_ tpc_lib_api::GuidInfo* guids) {
+    namespace api = tpc_lib_api;
+    if (device_id != api::DEVICE_ID_GAUDI2) {
+        return api::GLUE_NODE_NOT_FOUND;
+    }
+    if (kernel_count == nullptr) return api::GLUE_FAILED;
+    const Table& table = registry();
+    const auto count = static_cast<std::uint32_t>(table.count);
+    if (*kernel_count == 0) {
+        *kernel_count = count;
+        return api::GLUE_SUCCESS;
+    }
+    if (*kernel_count < count || guids == nullptr) {
+        *kernel_count = count;
+        return api::GLUE_UNSUPPORTED_LAYER_CONFIGURATION;
+    }
+    for (std::uint32_t i = 0; i < count; ++i) {
+        std::memset(&guids[i], 0, sizeof(api::GuidInfo));
+        std::strncpy(guids[i].name, table.list[i].name, api::MAX_NODE_NAME - 1);
+    }
+    *kernel_count = count;
+    return api::GLUE_SUCCESS;
+}
+
+} // extern "C"
