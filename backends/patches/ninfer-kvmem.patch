+#pragma once
+// Test-only C declarations. Never a fallback SDK or runtime implementation.
+#ifndef NINFER_GAUDI2_RUNTIME_TEST_FAKE
+#error "The fake SynapseAI header is restricted to the offline lifecycle test target"
+#endif
+#include <cstdint>
+using synDeviceId = std::uint32_t;
+enum synStatus { synSuccess = 0, synFail = 1, synBusy = 22 };
+enum synDeviceType { synDeviceGaudi = 0, synDeviceGaudi2 = 1 };
+enum synDmaDir { HOST_TO_DRAM = 0, DRAM_TO_HOST = 1 };
+struct FakeSynStream;
+struct FakeSynEvent;
+using synStreamHandle = FakeSynStream*;
+using synEventHandle = FakeSynEvent*;
+struct FakeSynGraph;
+struct FakeSynTensor;
+struct FakeSynSection;
+struct FakeSynRecipe;
