+        dbg.k_conv = &t_dbg_k_conv;
+        static Tensor t_dbg_v_conv(const_cast<void*>(d_dbg_vc.data()), DType::BF16, {1, static_cast<std::int32_t>(d_inner)});
+        dbg.v_conv = &t_dbg_v_conv;
+        static Tensor t_dbg_gate(const_cast<void*>(d_dbg_gate.data()), DType::FP32, {1, static_cast<std::int32_t>(d_inner)});
+        dbg.gate = &t_dbg_gate;
+        static Tensor t_dbg_beta(const_cast<void*>(d_dbg_beta.data()), DType::FP32, {1, static_cast<std::int32_t>(heads)});
+        dbg.beta = &t_dbg_beta;
+        static Tensor t_dbg_prefill_out(const_cast<void*>(d_dbg_prefill.data()), DType::BF16, {static_cast<std::int32_t>(d_inner), 1});
