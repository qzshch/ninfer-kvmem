+from __future__ import annotations
+
+from copy import deepcopy
+import json
+from pathlib import Path
+import struct
+
+import pytest
+
+from tools.convert.glm5 import text_config
+
+_FIXTURES = Path(__file__).resolve().parents[1] / "fixtures" / "glm5"
+
+
+def _checkpoint():
+    return json.loads((_FIXTURES / "config.json").read_text())
+
+
+def _f32(value):
+    # The converter stores FP32-rounded reals; the artifact fixture keeps the checkpoint's
+    # decimal spelling. Round the expected side the same way before comparing.
+    return struct.unpack("<f", struct.pack("<f", value))[0]
+
+
+def test_text_config_matches_the_artifact_fixture():
+    # The C++ parser's test reads the same artifact fixture, so the two stay in step.
+    expected = json.loads((_FIXTURES / "text_config.json").read_text())
+    actual = text_config(_checkpoint())
+    assert actual.keys() == expected.keys()
+    for key, want in expected.items():
+        got = actual[key]
+        if isinstance(want, float):
+            assert got == _f32(want), key
+        else:
+            assert got == want, key
+
+
+def test_layer_lists_cross_check_against_layer_types():
+    config = text_config(_checkpoint())
+    assert config["layer_types"].count("deepseek_sparse_attention") == 11
+    assert config["layer_types"].count("linear_attention") == 34
+    # A full_attn_layers entry disagreeing with layer_types refuses.
+    source = deepcopy(_checkpoint())
+    text = source["text_config"]
+    text["layer_types"][3] = "linear_attention"
+    with pytest.raises(ValueError, match="disagree"):
+        text_config(source)
+
+
+@pytest.mark.parametrize(
+    "edit, message",
+    [
+        (lambda t: t.update(mla_use_nope=False), "mla_use_nope"),
+        (lambda t: t.update(scoring_func="softmax"), "scoring_func"),
+        (lambda t: t.update(mhc=False), "mhc"),
+        (lambda t: t.update(qk_rope_head_dim=64), "NoPE-only"),
+        (lambda t: t.update(index_topk=2050), "whole number of pools"),
+        (lambda t: t.update(num_experts_per_tok=289), "expert count"),
+        (lambda t: t.update(first_k_dense_replace=46), "block count"),
+        (lambda t: t.update(eos_token_id=[999999]), "vocabulary"),
+        (lambda t: t["layer_types"].pop(), "every block"),
+        (lambda t: t["linear_attn_config"].update(gate_lower_bound=1.0), "lower bound"),
+        (lambda t: t.update(indexer_rope_interleave=False), "indexer_rope_interleave"),
+    ],
+)
+def test_text_config_refuses(edit, message):
+    source = deepcopy(_checkpoint())
+    edit(source["text_config"])
+    with pytest.raises(ValueError, match=message):
+        text_config(source)
+
+
+def test_single_eos_id_is_normalized_to_a_list():
+    source = deepcopy(_checkpoint())
+    source["text_config"]["eos_token_id"] = 154820
+    config = text_config(source)
+    assert config["eos_token_id"] == [154820]
+
+
+def test_unsupported_architecture_refuses():
+    source = deepcopy(_checkpoint())
+    source["architectures"] = ["Glm5NextMoeForConditionalGeneration"]
