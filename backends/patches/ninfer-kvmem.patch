@@ -0,0 +1,601 @@
+// The GLM-5.3-Flash full decode step (mHC residual loop across a mixed layer stack)
+// against a host oracle that chains the same per-block references. Two blocks at a small
+// geometry: a KDA+MoE block then a DSA+dense block, covering both mixers and both MLPs.
+#include "models/glm5/execution/model.h"
+#include "models/glm5/reference/kda_reference.h"
+#include "models/glm5/reference/dsa_reference.h"
+#include "models/glm5/reference/mhc_reference.h"
+
+#include "core/device.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
+#include <string>
+#include <vector>
+#include "core/device.h"
+
+namespace {
+
+using namespace ninfer;
+namespace execution = ninfer::models::glm5::execution;
+namespace Ref = ninfer::models::glm5::reference;
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 17u) - 8) / 8.0f;
+}
+std::vector<__nv_bfloat16> round_trip(const std::vector<float>& v) {
+    std::vector<__nv_bfloat16> o(v.size());
+    for (std::size_t i = 0; i < v.size(); ++i) { o[i] = __float2bfloat16(v[i]); }
+    return o;
+}
+std::vector<float> represented(const std::vector<__nv_bfloat16>& v) {
+    std::vector<float> o(v.size());
+    for (std::size_t i = 0; i < v.size(); ++i) { o[i] = __bfloat162float(v[i]); }
+    return o;
+}
+std::vector<float> bf16(const std::vector<float>& v) { return represented(round_trip(v)); }
+
+test::GuardedDeviceBuffer upload(const void* d, std::size_t b) {
+    test::GuardedDeviceBuffer buf(b); buf.copy_from_host(d, b); return buf;
+}
+template <typename T> test::GuardedDeviceBuffer upload(const std::vector<T>& v) {
+    return upload(v.data(), v.size() * sizeof(T));
+}
+template <typename T> std::vector<T> download(const test::GuardedDeviceBuffer& b) {
+    std::vector<T> o(b.bytes() / sizeof(T));
+    b.copy_to_host(o.data(), o.size() * sizeof(T));
+    return o;
+}
+
+int failures = 0;
+
+// Host mHC reference wrappers on bf16-represented values.
+void host_mhc_pre(const std::vector<float>& streams, const std::vector<float>& fn,
+                  const std::vector<float>& base, const std::vector<float>& scale,
+                  std::vector<float>& pre, std::vector<float>& post,
+                  std::vector<float>& comb, std::vector<float>& collapsed,
+                  const Ref::MhcProfile& profile, std::uint32_t hidden) {
+    Ref::mhc_pre_reference(bf16(streams), bf16(fn), base, scale, pre, post, comb, collapsed,
+                           profile, hidden);
+    // The reference computes in FP32; the device kernel outputs pre/post/comb as FP32
+    // and collapsed as BF16. Round collapsed.
+    for (auto& v : collapsed) { v = bf16({v})[0]; }
+}
+
+void host_mhc_post(const std::vector<float>& block, const std::vector<float>& residual,
+                   const std::vector<float>& post, const std::vector<float>& comb,
+                   std::vector<float>& out, const Ref::MhcProfile& profile,
+                   std::uint32_t hidden) {
+    const auto block_bf = bf16(block);
+    const auto residual_bf = bf16(residual);
+    for (std::size_t i = 0; i < block_bf.size(); ++i) {
+    }
+    Ref::mhc_post_reference(block_bf, residual_bf, post, comb, out, profile, hidden);
+    for (auto& v : out) { v = bf16({v})[0]; }
+}
+
+int run() {
+    // Geometry: small enough for the oracle to be fast, exercising both mixer types.
+    constexpr std::uint32_t H = 64, HK = 2, HD = 8;    // hidden, kda heads, head dim
+    constexpr std::uint32_t DI = HK * HD;               // kda inner
+    constexpr std::uint32_t AH = 2, AD = 16;            // attention heads, head dim (=qk_nope)
+    constexpr std::uint32_t QL = 24, KL = 32, VH = 16;  // q_lora, kv_lora, v_head
+    constexpr std::uint32_t IH = 3, ID = 12, KP = 4, TK = 8;
+    constexpr std::uint32_t FFN_D = 32, FFN_M = 48, EXP = 8, TOPK = 2;
+    constexpr std::uint32_t VOCAB = 128;
+    constexpr std::uint32_t LAYERS = 2;
+    constexpr std::uint32_t CACHE = 8;   // DSA cache positions
+
+    const Ref::MhcProfile mhc_profile{4, 1e-5f, 1e-6f, 20};
+
+    auto plane = [&](std::uint32_t rows, std::uint32_t cols, std::uint32_t seed) -> std::vector<float> {
+        const std::size_t n = static_cast<std::size_t>(rows) * cols;
+        std::vector<float> v(n);
+        for (std::size_t i = 0; i < n; ++i) { v[i] = source(static_cast<std::uint32_t>(i) * 3 + seed) / 16.0f; }
+        return bf16(v);
+    };
+    auto gamma = [&](std::uint32_t n, std::uint32_t seed) {
+        std::vector<float> v(n);
+        for (std::uint32_t i = 0; i < n; ++i) { v[i] = 1.0f + source(i + seed) / 8; }
+        return bf16(v);
+    };
+
+    // All weights. Layer 0: KDA + MoE. Layer 1: DSA + dense.
+    std::vector<float> emb(VOCAB * H), lm_head_w(VOCAB * H), out_norm(H);
+    for (auto& v : emb) { v = source(static_cast<std::uint32_t>(&v - emb.data()) * 3 + 1) / 16; }
+    emb = bf16(emb); lm_head_w = plane(VOCAB, H, 31); out_norm = gamma(H, 32);
+
+    // Per-layer: mHC sites, norms, and the mixer/MLP weights.
+    std::vector<std::vector<float>> hc_fn(2 * LAYERS), hc_base(2 * LAYERS),
+        hc_scale(2 * LAYERS);
+    std::vector<std::vector<float>> attn_norm(LAYERS), ffn_norm(LAYERS);
+    for (std::uint32_t l = 0; l < LAYERS; ++l) {
+        hc_fn[2 * l] = plane(24, 4 * H, 40 + 2 * l);
+        hc_base[2 * l] = plane(24, 1, 41 + 2 * l);
+        hc_scale[2 * l] = {0.7f, 0.5f, 0.9f};
+        hc_fn[2 * l + 1] = plane(24, 4 * H, 42 + 2 * l);
+        hc_base[2 * l + 1] = plane(24, 1, 43 + 2 * l);
+        hc_scale[2 * l + 1] = {0.6f, 0.4f, 0.8f};
+        attn_norm[l] = gamma(H, 50 + l);
+        ffn_norm[l] = gamma(H, 52 + l);
+    }
+    // KDA weights (layer 0).
+    std::vector<float> wq(plane(DI, H, 60)), wk(plane(DI, H, 61)), wv(plane(DI, H, 62)),
+        conv_q(plane(4 * DI, 1, 63)), conv_k(plane(4 * DI, 1, 64)), conv_v(plane(4 * DI, 1, 65)),
+        f_a(plane(HD, H, 66)), f_b(plane(DI, HD, 67)), beta_w(plane(HK, H, 68)),
+        g_a(plane(HD, H, 69)), g_b(plane(DI, HD, 70)), kda_wo(plane(H, DI, 71));
+    std::vector<float> dt_bias(DI), a_log(HK), o_norm(HD);
+    for (std::uint32_t i = 0; i < DI; ++i) { dt_bias[i] = source(i * 3 + 1) / 8; }
+    for (std::uint32_t h = 0; h < HK; ++h) { a_log[h] = -0.5f + 0.25f * h; }
+    for (std::uint32_t i = 0; i < HD; ++i) { o_norm[i] = 1.0f + source(i) / 8; }
+    dt_bias = bf16(dt_bias);
+
+    // DSA weights (layer 1).
+    std::vector<float> q_a(plane(QL, H, 80)), q_a_n(gamma(QL, 81)),
+        q_b(plane(AH * AD, QL, 82)), kv_a(plane(KL, H, 83)), kv_a_n(gamma(KL, 84)),
+        wk_b(plane(AD * KL * AH, 1, 85)), wv_b(plane(KL * VH * AH, 1, 86)),
+        dsa_wo(plane(H, AH * VH, 87)),
+        idx_q_b(plane(IH * ID, QL, 88)), idx_k(plane(ID, H, 89)),
+        idx_k_nw(gamma(ID, 90)), idx_k_nb(plane(ID, 1, 91)),
+        idx_gate(plane(ID, H, 92)), idx_proj(plane(IH, H, 93));
+    std::vector<float> ape(KP * ID);
+    for (std::size_t i = 0; i < ape.size(); ++i) { ape[i] = source(static_cast<std::uint32_t>(i) * 5 + 7) / 4; }
+
+    // Dense MLP (layer 1).
+    std::vector<float> d_gate(plane(FFN_D, H, 100)), d_up(plane(FFN_D, H, 101)),
+        d_down(plane(H, FFN_D, 102));
+    // MoE (layer 0).
+    std::vector<float> m_router(plane(EXP, H, 110)),
+        m_gate(static_cast<std::size_t>(EXP) * FFN_M * H), m_up(m_gate.size()),
+        m_down(static_cast<std::size_t>(EXP) * H * FFN_M),
+        m_gsh(plane(FFN_M, H, 111)), m_ush(plane(FFN_M, H, 112)), m_dsh(plane(H, FFN_M, 113));
+    for (std::uint32_t e = 0; e < EXP; ++e) {
+        for (std::size_t i = 0; i < static_cast<std::size_t>(FFN_M) * H; ++i) {
+            m_gate[static_cast<std::size_t>(e) * FFN_M * H + i] =
+                source(static_cast<std::uint32_t>(i) * 3 + e * 7 + 114) / 16;
+            m_up[static_cast<std::size_t>(e) * FFN_M * H + i] =
+                source(static_cast<std::uint32_t>(i) * 5 + e * 3 + 115) / 16;
+        }
+        for (std::size_t i = 0; i < static_cast<std::size_t>(H) * FFN_M; ++i) {
+            m_down[static_cast<std::size_t>(e) * H * FFN_M + i] =
+                source(static_cast<std::uint32_t>(i) * 7 + e * 11 + 116) / 16;
+        }
+    }
+    m_gate = bf16(m_gate); m_up = bf16(m_up); m_down = bf16(m_down);
+    std::vector<float> m_bias(EXP, 0.0f); m_bias[5] = 4.0f;
+
+    // Token: the embedding row.
+    std::vector<float> token_h(H);
+    for (std::uint32_t i = 0; i < H; ++i) { token_h[i] = source(i * 5 + 2) / 4; }
+    token_h = bf16(token_h);
+
+    // ---- HOST ORACLE: the full decode step ----
+    // (This is the same chain the device runs, verified block by block above; here
+    // it runs end to end so the CHAINING is what gets checked.)
+    std::vector<float> residual(4 * H);
+    for (std::uint32_t n = 0; n < 4; ++n) {
+        for (std::uint32_t i = 0; i < H; ++i) { residual[n * H + i] = token_h[i]; }
+    }
+    auto run_layer = [&](std::uint32_t l, bool is_dsa, bool is_dense,
+                         const std::vector<float>& kda_scalars_dt,
+                         const std::vector<float>& kda_a_log, const std::vector<float>& kda_onw) {
+        std::vector<float> pre(4), post(4), comb(16), collapsed(H), block_out(H);
+        // attention half
+        host_mhc_pre(residual, hc_fn[2 * l], hc_base[2 * l], hc_scale[2 * l], pre, post, comb,
+                     collapsed, mhc_profile, H);
+        std::vector<float> x(H);
+        {
+            const auto& nw = attn_norm[l];
+            double sq = 0;
+            for (std::uint32_t i = 0; i < H; ++i) { sq += (double)collapsed[i] * collapsed[i]; }
+            const double inv = 1.0 / std::sqrt(sq / H + 1e-5);
+            for (std::uint32_t i = 0; i < H; ++i) { x[i] = static_cast<float>(nw[i] * collapsed[i] * inv); }
+            x = bf16(x);
+        }
+        if (!is_dsa) {
+            // KDA mixer oracle (simplified from the block test).
+            const Ref::KdaProfile kp{HK, HD, 4, -5.0f};
+            std::vector<float> q_raw(DI), k_raw(DI), v_raw(DI), qc(DI), kc(DI), vc(DI),
+                gate(DI), beta(HK), g2(DI), scan_out(DI),
+                mat(Ref::kda_state_values(kp), 0.0f),
+                scratch(Ref::kda_scan_scratch_values(kp, 1));
+            // (The KDA oracle is the same chain the block test verified; here we use a
+            // simplified version that just computes the mixer output from x.)
+            for (std::uint32_t i = 0; i < DI; ++i) { q_raw[i] = 0; k_raw[i] = 0; v_raw[i] = 0; }
+            // Just do the projections.
+            for (std::uint32_t r = 0; r < DI; ++r) {
+                double a = 0, b = 0, c = 0;
+                for (std::uint32_t cc = 0; cc < H; ++cc) {
+                    a += wq[r * H + cc] * x[cc]; b += wk[r * H + cc] * x[cc]; c += wv[r * H + cc] * x[cc];
+                }
+                q_raw[r] = bf16({static_cast<float>(a)})[0];
+                k_raw[r] = bf16({static_cast<float>(b)})[0];
+                v_raw[r] = bf16({static_cast<float>(c)})[0];
+            }
+            // conv + silu (identity state, no history)
+            auto conv1 = [&](const std::vector<float>& raw, const std::vector<float>& cw,
+                             std::vector<float>& out) {
+                for (std::uint32_t ch = 0; ch < DI; ++ch) {
+                    double acc = cw[ch * 4 + 3] * raw[ch];  // taps 0..2 from zero state
+                    out[ch] = bf16({static_cast<float>(acc / (1.0 + std::exp(-acc)))})[0];
+                }
+            };
+            conv1(q_raw, conv_q, qc); conv1(k_raw, conv_k, kc); conv1(v_raw, conv_v, vc);
+            // gate
+            std::vector<float> fa(HD), fb(DI), beta_raw(HK);
+            for (std::uint32_t r = 0; r < HD; ++r) {
+                double a = 0;
+                for (std::uint32_t cc = 0; cc < H; ++cc) { a += f_a[r * H + cc] * x[cc]; }
+                fa[r] = bf16({static_cast<float>(a)})[0];
+            }
+            for (std::uint32_t r = 0; r < DI; ++r) {
+                double a = 0;
+                for (std::uint32_t cc = 0; cc < HD; ++cc) { a += f_b[r * HD + cc] * fa[cc]; }
+                fb[r] = bf16({static_cast<float>(a) + kda_scalars_dt[r]})[0];
+            }
+            for (std::uint32_t r = 0; r < HK; ++r) {
+                double a = 0;
+                for (std::uint32_t cc = 0; cc < H; ++cc) { a += beta_w[r * H + cc] * x[cc]; }
+                beta_raw[r] = bf16({static_cast<float>(a)})[0];
+            }
+            Ref::kda_decay_gate_reference(fb, kda_a_log, gate, kp);
+            for (std::uint32_t h = 0; h < HK; ++h) {
+                beta[h] = static_cast<float>(1.0 / (1.0 + std::exp(-(double)beta_raw[h])));
