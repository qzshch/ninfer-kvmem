--- /dev/null
+++ b/src/core/gaudi2/tests/fake_synapse/fake_gemm.cpp
@@ -0,0 +1,189 @@
+// Private offline graph/queue simulator. Never compiled into the native runtime.
+#include "synapse_api.h"
+#include "control.h"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cmath>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+struct FakeSynSection { synGraphHandle graph; bool persistent = false; };
+struct FakeSynTensor {
+    synGraphHandle graph; std::string name; synTensorGeometry geometry{};
+    synDataType dtype{}; synSectionHandle section = nullptr;
+    bool typed = false, permutation_fixed = false, linked = false, external = true;
+};
+struct FakeSynGraph {
+    std::vector<synTensor> tensors;
+    std::array<synTensor, 3> operands{};
+    bool node = false, rounded = false;
+};
+struct FakeSynRecipe {
+    std::array<std::uint64_t, 3> ids{47, 11, 803}; // deliberately neither positional nor monotonic
+    std::array<synTensorGeometry, 3> geometry{};
+    std::uint64_t workspace;
+    std::size_t pending = 0;
+};
+namespace {
+std::set<synGraphHandle> graphs;
+std::set<synTensor> tensors;
+std::set<synSectionHandle> sections;
+std::set<synRecipeHandle> recipes;
+std::uint64_t workspace_size = 4096;
+std::size_t gemms = 0;
+void demand(bool value) { if (!value) throw std::runtime_error("offline GEMM graph/launch contract failed"); }
+bool fail(const char* name) { return fake_synapse::consume_failure(name); }
+float decode(std::uint16_t word) { return std::bit_cast<float>(static_cast<std::uint32_t>(word) << 16); }
+std::uint16_t round_bf16(float value) {
+    auto bits = std::bit_cast<std::uint32_t>(value);
+    bits += 0x7fffu + ((bits >> 16) & 1u); return static_cast<std::uint16_t>(bits >> 16);
+}
+}
+namespace fake_synapse {
+void assert_graph_clean() { demand(graphs.empty() && tensors.empty() && sections.empty() && recipes.empty()); }
+void set_workspace_bytes(std::uint64_t bytes) { workspace_size = bytes; }
+std::size_t completed_gemms() { return gemms; }
+}
+extern "C" {
+synStatus synGraphCreate(synGraphHandle* graph, synDeviceType type) {
+    if (fail("synGraphCreate")) return synFail;
+    demand(type == synDeviceGaudi2); *graph = new FakeSynGraph; graphs.insert(*graph); return synSuccess;
+}
+synStatus synGraphDestroy(synGraphHandle graph) {
+    demand(graphs.erase(graph) == 1);
+    for (const auto tensor : graph->tensors) {
+        demand(tensor->linked && !tensor->external && tensors.erase(tensor) == 1); delete tensor;
+    }
+    delete graph; return synSuccess;
+}
+synStatus synTensorHandleCreate(synTensor* tensor, synGraphHandle graph, synTensorType type, const char* name) {
+    if (fail("synTensorHandleCreate")) return synFail;
+    demand(graphs.contains(graph) && type == DATA_TENSOR && name);
+    *tensor = new FakeSynTensor{graph, name}; graph->tensors.push_back(*tensor); tensors.insert(*tensor); return synSuccess;
+}
+synStatus synTensorSetGeometry(synTensor tensor, const synTensorGeometry* geometry, synGeometryType type) {
+    if (fail("synTensorSetGeometry")) return synFail;
+    demand(tensors.contains(tensor) && geometry && type == synGeometrySizes && geometry->dims == 2);
+    demand(geometry->sizes[0] && geometry->sizes[1]);
+    tensor->geometry = *geometry; return synSuccess;
+}
+synStatus synTensorSetDeviceDataType(synTensor tensor, synDataType type) {
+    if (fail("synTensorSetDeviceDataType")) return synFail;
+    demand(tensors.contains(tensor) && type == syn_type_bf16); tensor->dtype = type; tensor->typed = true; return synSuccess;
+}
+synStatus synTensorSetAllowPermutation(synTensor tensor, bool allow) {
+    if (fail("synTensorSetAllowPermutation")) return synFail;
+    demand(tensors.contains(tensor) && !allow); tensor->permutation_fixed = true; return synSuccess;
+}
+synStatus synTensorDestroy(synTensor tensor) {
+    demand(tensors.contains(tensor) && tensor->external); tensor->external = false;
+    if (!tensor->linked) {
+        auto& owned = tensor->graph->tensors; owned.erase(std::find(owned.begin(), owned.end(), tensor));
+        tensors.erase(tensor); delete tensor;
+    }
+    return synSuccess;
+}
+synStatus synSectionCreate(synSectionHandle* section, std::uint64_t descriptor, synGraphHandle graph) {
+    if (fail("synSectionCreate")) return synFail;
+    demand(graphs.contains(graph) && descriptor == 0); *section = new FakeSynSection{graph}; sections.insert(*section); return synSuccess;
+}
+synStatus synSectionSetPersistent(synSectionHandle section, bool persistent) {
+    if (fail("synSectionSetPersistent")) return synFail;
+    demand(sections.contains(section) && persistent); section->persistent = true; return synSuccess;
+}
+synStatus synTensorAssignToSection(synTensor tensor, synSectionHandle section, std::uint64_t offset) {
+    if (fail("synTensorAssignToSection")) return synFail;
+    demand(tensors.contains(tensor) && sections.contains(section) && offset == 0 && tensor->graph == section->graph);
+    tensor->section = section; return synSuccess;
+}
+synStatus synSectionDestroy(synSectionHandle section) {
+    demand(sections.erase(section) == 1); delete section; return synSuccess;
+}
+synStatus synNodeCreateWithId(synGraphHandle graph, const synTensor* inputs, const synTensor* outputs,
+                             std::uint32_t input_count, std::uint32_t output_count, const void* parameters,
+                             unsigned bytes, const char* guid, const char*, synNodeId* node,
+                             const char** input_layouts, const char** output_layouts) {
+    if (fail("synNodeCreateWithId")) return synFail;
+    demand(graphs.contains(graph) && !graph->node && input_count == 2 && output_count == 1);
+    demand(parameters && bytes == sizeof(synGEMMParams) && std::string(guid) == "gemm" && !input_layouts && !output_layouts);
+    const auto& p = *static_cast<const synGEMMParams*>(parameters); demand(!p.transpose_a && p.transpose_b);
+    graph->operands = {inputs[0], inputs[1], outputs[0]};
+    const std::array<std::string, 3> expected{"A", "W", "Y"};
+    for (std::size_t i = 0; i < 3; ++i) {
+        auto tensor = graph->operands[i]; demand(tensors.contains(tensor) && tensor->graph == graph && tensor->name == expected[i]);
+        tensor->linked = true;
+    }
+    graph->node = true; *node = 119; return synSuccess;
+}
+synStatus synNodeSetRoundingMode(synGraphHandle graph, synNodeId node, synRoundingMode mode) {
+    if (fail("synNodeSetRoundingMode")) return synFail;
+    demand(graphs.contains(graph) && graph->node && node == 119 && mode == synRoundToNearest);
+    graph->rounded = true; return synSuccess;
+}
+synStatus synGraphCompile(synRecipeHandle* recipe, synGraphHandle graph, const char* name, const char* log) {
+    if (fail("synGraphCompile")) return synFail;
+    demand(graphs.contains(graph) && graph->node && graph->rounded && name && !log);
+    std::array<synTensorGeometry, 3> geometry;
+    for (std::size_t i = 0; i < 3; ++i) {
+        const auto tensor = graph->operands[i];
+        demand(tensor->typed && tensor->permutation_fixed && tensor->section && tensor->section->persistent);
+        geometry[i] = tensor->geometry;
+    }
+    demand(geometry[0].sizes[0] == geometry[1].sizes[0] && geometry[0].sizes[1] == geometry[2].sizes[1] &&
+           geometry[1].sizes[1] == geometry[2].sizes[0]);
+    *recipe = new FakeSynRecipe{{47, 11, 803}, geometry, workspace_size}; recipes.insert(*recipe); return synSuccess;
+}
+synStatus synRecipeDestroy(synRecipeHandle recipe) {
+    demand(recipes.contains(recipe) && !recipe->pending); recipes.erase(recipe); delete recipe; return synSuccess;
+}
+synStatus synWorkspaceGetSize(std::uint64_t* bytes, synRecipeHandle recipe) {
+    if (fail("synWorkspaceGetSize")) return synFail;
+    demand(recipes.contains(recipe)); *bytes = recipe->workspace; return synSuccess;
+}
+synStatus synTensorRetrieveIds(synRecipeHandle recipe, const char** names, std::uint64_t* ids, std::uint32_t count) {
+    if (fail("synTensorRetrieveIds")) return synFail;
+    demand(recipes.contains(recipe) && count == 3);
+    const std::array<std::string, 3> expected{"A", "W", "Y"};
+    for (std::size_t i = 0; i < count; ++i) { demand(names[i] == expected[i]); ids[i] = recipe->ids[i]; }
+    return synSuccess;
+}
+synStatus synLaunchWithExternalEventsExt(synStreamHandle stream, const synLaunchTensorInfoExt* infos,
+                                        std::uint32_t count, std::uint64_t workspace, synRecipeHandle recipe,
+                                        synEventHandle* external, std::uint32_t events, std::uint32_t flags) {
+    demand(recipes.contains(recipe) && count == 3 && !external && !events && !flags);
+    std::array<std::uint64_t, 4> addresses{};
+    std::array<bool, 3> seen{};
+    for (std::size_t j = 0; j < count; ++j) {
+        auto found = std::find(recipe->ids.begin(), recipe->ids.end(), infos[j].tensorId);
+        demand(found != recipe->ids.end()); const auto i = static_cast<std::size_t>(found - recipe->ids.begin());
+        demand(!seen[i] && !infos[j].tensorName && infos[j].tensorType == DATA_TENSOR); seen[i] = true;
+        const auto& g = recipe->geometry[i];
+        demand(infos[j].tensorSize[0] == g.sizes[0] && infos[j].tensorSize[1] == g.sizes[1]);
+        const auto bytes = g.sizes[0] * g.sizes[1] * 2;
+        demand(fake_synapse::valid_range(infos[j].pTensorAddress, bytes)); addresses[i] = infos[j].pTensorAddress;
+    }
+    demand(recipe->workspace ? fake_synapse::valid_range(workspace, recipe->workspace) : workspace == 0);
+    addresses[3] = workspace; ++recipe->pending;
+    fake_synapse::enqueue(stream, [recipe, addresses] {
+        demand(recipes.contains(recipe));
+        const auto k = recipe->geometry[0].sizes[0], m = recipe->geometry[0].sizes[1], n = recipe->geometry[1].sizes[1];
+        const auto* a = reinterpret_cast<const std::uint16_t*>(addresses[0]);
+        const auto* w = reinterpret_cast<const std::uint16_t*>(addresses[1]);
+        auto* y = reinterpret_cast<std::uint16_t*>(addresses[2]);
+        for (std::uint64_t row = 0; row < m; ++row) for (std::uint64_t column = 0; column < n; ++column) {
+            float sum = 0;
+            for (std::uint64_t inner = 0; inner < k; ++inner)
+                sum = std::fma(decode(a[row * k + inner]), decode(w[column * k + inner]), sum);
+            y[row * n + column] = round_bf16(sum);
+        }
+        --recipe->pending; ++gemms;
+    }, addresses);
+    // Like the DMA fake, deliberately admit work before reporting an injected error.
+    return fail("synLaunchWithExternalEventsExt") ? synFail : synSuccess;
+}
+}
diff --git a/src/core/gaudi2/tests/fake_synapse/fake_synapse.cpp b/src/core/gaudi2/tests/fake_synapse/fake_synapse.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..37c2498a268533aa9ea53fe1f42597fcee1367b4
--- /dev/null
+++ b/src/core/gaudi2/tests/fake_synapse/fake_synapse.cpp
@@ -0,0 +1,142 @@
+#include "synapse_api.h"
+#include "control.h"
+
+#include <cstring>
+#include <deque>
+#include <limits>
+#include <map>
+#include <memory>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <variant>
+#include <vector>
+
+struct Copy { std::uint64_t source, destination, bytes; };
+struct Kernel { std::function<void()> action; std::vector<std::uint64_t> references; };
+struct FakeSynStream { std::deque<std::variant<Copy, Kernel>> pending; std::size_t completed = 0; };
+struct FakeSynEvent { FakeSynStream* stream = nullptr; std::size_t target = 0; };
+namespace {
+std::string failure;
+std::size_t failure_skips = 0;
+bool initialized = false, acquired = false;
+std::map<std::uint64_t, std::unique_ptr<std::byte[]>> device_memory, host_memory;
+std::map<std::uint64_t, std::size_t> sizes;
+std::set<FakeSynStream*> streams;
+std::set<FakeSynEvent*> events;
+std::size_t copies = 0;
+bool fail(const char* operation) {
+    if (failure != operation) return false;
+    if (failure_skips) { --failure_skips; return false; }
+    failure.clear(); return true;
+}
+void demand(bool value) { if (!value) throw std::runtime_error("offline SynapseAI lifecycle invariant failed"); }
+bool valid_pointer(std::uint64_t pointer, std::uint64_t bytes) {
+    for (const auto& [base, size] : sizes)
+        if (pointer >= base && pointer - base <= size && bytes <= size - (pointer - base)) return true;
+    return false;
+}
+void drain(FakeSynStream* stream, std::size_t count) {
+    while (stream->completed < count) {
+        demand(!stream->pending.empty());
+        auto work = std::move(stream->pending.front()); stream->pending.pop_front();
+        if (auto* copy = std::get_if<Copy>(&work)) {
+            demand(valid_pointer(copy->source, copy->bytes) && valid_pointer(copy->destination, copy->bytes));
+            std::memcpy(reinterpret_cast<void*>(copy->destination), reinterpret_cast<const void*>(copy->source), copy->bytes);
+            ++copies;
+        } else std::get<Kernel>(work).action();
+        ++stream->completed;
+    }
+}
+void no_pending_reference(std::uint64_t pointer) {
+    const auto size = sizes.at(pointer);
+    for (const auto stream : streams) for (const auto& work : stream->pending) {
+        const auto unreferenced = [&](std::uint64_t p) { demand(!(p >= pointer && p - pointer < size)); };
+        if (const auto* copy = std::get_if<Copy>(&work)) { unreferenced(copy->source); unreferenced(copy->destination); }
+        else for (const auto p : std::get<Kernel>(work).references) unreferenced(p);
+    }
+}
+synStatus allocate(std::uint64_t bytes, std::uint64_t* address,
+                   std::map<std::uint64_t, std::unique_ptr<std::byte[]>>& allocations) {
+    demand(acquired && bytes > 0);
+    auto data = std::make_unique<std::byte[]>(static_cast<std::size_t>(bytes));
+    *address = reinterpret_cast<std::uint64_t>(data.get());
+    sizes[*address] = static_cast<std::size_t>(bytes); allocations.emplace(*address, std::move(data));
+    return synSuccess;
+}
+}
+namespace fake_synapse {
+void fail_next(std::string_view operation) { failure = operation; failure_skips = 0; }
+void fail_after(std::string_view operation, std::size_t successes) { failure = operation; failure_skips = successes; }
+void clear_failure() { failure.clear(); }
+void assert_clean() { demand(!initialized && !acquired && device_memory.empty() && host_memory.empty() && streams.empty() && events.empty() && sizes.empty()); assert_graph_clean(); }
+std::size_t live_allocations() { return sizes.size(); }
+std::size_t completed_copies() { return copies; }
+bool consume_failure(const char* operation) { return fail(operation); }
+void enqueue(synStreamHandle stream, std::function<void()> action, std::span<const std::uint64_t> references) {
+    stream->pending.emplace_back(Kernel{std::move(action), {references.begin(), references.end()}});
+}
+bool valid_range(std::uint64_t pointer, std::uint64_t bytes) { return valid_pointer(pointer, bytes); }
+}
+extern "C" {
+synStatus synInitialize() { if (fail("synInitialize")) return synFail; demand(!initialized); initialized = true; return synSuccess; }
+synStatus synDestroy() { demand(initialized && !acquired); initialized = false; return synSuccess; }
+synStatus synDeviceAcquireByDeviceType(synDeviceId* id, synDeviceType type) {
+    if (fail("synDeviceAcquireByDeviceType")) return synFail;
+    demand(initialized && !acquired && type == synDeviceGaudi2); acquired = true; *id = 7; return synSuccess;
+}
+synStatus synDeviceRelease(synDeviceId id) { demand(acquired && id == 7 && sizes.empty() && streams.empty() && events.empty()); fake_synapse::assert_graph_clean(); acquired = false; return synSuccess; }
+synStatus synDeviceGetMemoryInfo(synDeviceId, std::uint64_t* free, std::uint64_t* total) {
+    if (fail("synDeviceGetMemoryInfo")) return synFail;
+    *total = 96ull << 30; *free = 95ull << 30; return synSuccess;
+}
+synStatus synDeviceMalloc(synDeviceId, std::uint64_t bytes, std::uint64_t, std::uint32_t, std::uint64_t* address) {
+    if (fail("synDeviceMalloc")) return synFail; return allocate(bytes, address, device_memory);
+}
+synStatus synDeviceFree(synDeviceId, std::uint64_t address, std::uint32_t) {
+    no_pending_reference(address); demand(device_memory.erase(address) == 1); sizes.erase(address); return synSuccess;
+}
+synStatus synHostMalloc(synDeviceId, std::uint64_t bytes, std::uint32_t, void** address) {
+    if (fail("synHostMalloc")) return synFail;
+    std::uint64_t raw = 0; const auto result = allocate(bytes, &raw, host_memory); *address = reinterpret_cast<void*>(raw); return result;
+}
+synStatus synHostFree(synDeviceId, const void* address, std::uint32_t) {
+    const auto raw = reinterpret_cast<std::uint64_t>(address); no_pending_reference(raw);
+    demand(host_memory.erase(raw) == 1); sizes.erase(raw); return synSuccess;
+}
+synStatus synStreamCreateGeneric(synStreamHandle* stream, synDeviceId, std::uint32_t) {
+    if (fail("synStreamCreateGeneric")) return synFail;
+    *stream = new FakeSynStream; streams.insert(*stream); return synSuccess;
+}
+synStatus synStreamDestroy(synStreamHandle stream) { demand(stream->pending.empty() && streams.erase(stream) == 1); delete stream; return synSuccess; }
+synStatus synStreamSynchronize(synStreamHandle stream) {
+    if (fail("synStreamSynchronize")) return synFail;
+    drain(stream, stream->completed + stream->pending.size()); return synSuccess;
+}
+synStatus synEventCreate(synEventHandle* event, synDeviceId, std::uint32_t) {
+    if (fail("synEventCreate")) return synFail;
+    *event = new FakeSynEvent; events.insert(*event); return synSuccess;
+}
+synStatus synEventDestroy(synEventHandle event) { demand(events.erase(event) == 1); delete event; return synSuccess; }
+synStatus synEventRecord(synEventHandle event, synStreamHandle stream) {
+    if (fail("synEventRecord")) return synFail;
+    event->stream = stream; event->target = stream->completed + stream->pending.size(); return synSuccess;
+}
+synStatus synEventQuery(synEventHandle event) {
+    if (fail("synEventQuery")) return synFail;
+    demand(event->stream); return event->stream->completed >= event->target ? synSuccess : synBusy;
+}
+synStatus synEventSynchronize(synEventHandle event) {
+    if (fail("synEventSynchronize")) return synFail;
+    demand(event->stream); drain(event->stream, event->target); return synSuccess;
+}
+synStatus synMemCopyAsync(synStreamHandle stream, std::uint64_t source, std::uint64_t bytes,
+                          std::uint64_t destination, synDmaDir direction) {
+    demand(direction == HOST_TO_DRAM || direction == DRAM_TO_HOST);
+    demand(valid_pointer(source, bytes) && valid_pointer(destination, bytes));
+    // Deliberately enqueue before injected failure: the adapter must drain an
+    // ambiguous failed submit, not assume no work reached the device.
+    stream->pending.emplace_back(Copy{source, destination, bytes});
+    return fail("synMemCopyAsync") ? synFail : synSuccess;
+}
+}
