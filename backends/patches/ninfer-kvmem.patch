@@ -0,0 +1,286 @@
+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash KDA kernels: safe-path gating, the causal short conv with SiLU,
+// and the single-token recurrent decode step. All arithmetic FP32; inputs are BF16 where the
+// engine's tensor flow carries them. The math follows models/glm5/reference (the audited GLM-5.3
+// semantics cross-checked against FLA, llama.cpp and Maya). This is the decode path: clarity
+// over throughput, one token at a time.
+
+#include "ops/common/warp.cuh"
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_kda_detail {
+
+constexpr int kDecodeBlock = 256;   // one head per block, dk <= 256
+constexpr int kElementThreads = 256;
+
+__device__ __forceinline__ float sigmoid_f(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+// gate[t, c] = lower_bound * sigmoid(exp(A_log[c / dk]) * a[t, c]) over the [d_inner, T] plane.
+__global__ void decay_gate_kernel(const __nv_bfloat16* __restrict__ a,
+                                  const float* __restrict__ a_log, float lower_bound,
+                                  std::int32_t d_inner, std::int32_t dk, std::int64_t elements,
+                                  float* __restrict__ gate) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    const std::int32_t channel = static_cast<std::int32_t>(index % d_inner);
+    const float rate = expf(a_log[channel / dk]);
+    gate[index] = lower_bound * sigmoid_f(rate * __bfloat162float(a[index]));
+}
+
+__global__ void beta_kernel(const __nv_bfloat16* __restrict__ b, std::int64_t elements,
+                            float* __restrict__ beta) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    beta[index] = sigmoid_f(__bfloat162float(b[index]));
+}
+
+// out[t, c] = silu(sum_tap w[c*K + tap] * window(t - (K-1) + tap, c)); one thread per (t, c).
+__global__ void conv_kernel(const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ w,
+                            const float* __restrict__ conv_state, std::int32_t d_inner,
+                            std::int32_t taps, std::int32_t tokens,
+                            __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const std::int32_t channel = static_cast<std::int32_t>(index % d_inner);
+    const std::int32_t t = static_cast<std::int32_t>(index / d_inner);
+    if (t >= tokens) { return; }
+    const std::int32_t history = taps - 1;
+    float acc = 0.0f;
+    for (std::int32_t tap = 0; tap < taps; ++tap) {
+        const std::int64_t s = static_cast<std::int64_t>(t) - history + tap;
+        const float sample = s >= 0 ? __bfloat162float(x[s * d_inner + channel])
+                                    : conv_state[(s + history) * d_inner + channel];
+        acc = fmaf(__bfloat162float(w[channel * taps + tap]), sample, acc);
+    }
+    out[index] = __float2bfloat16(acc * sigmoid_f(acc));
+}
+
+// conv_state := last `taps-1` columns of [conv_state | x]; staged per channel so overlapping
+// reads never see partially updated rows (T shorter than the history still reaches back).
+__global__ void conv_slide_kernel(const __nv_bfloat16* __restrict__ x,
+                                  const float* __restrict__ conv_state, std::int32_t d_inner,
+                                  std::int32_t taps, std::int32_t tokens,
+                                  float* __restrict__ state_out) {
+    const std::int32_t channel = static_cast<std::int32_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (channel >= d_inner) { return; }
+    const std::int32_t history = taps - 1;
+    float staged[8];
+    for (std::int32_t j = 0; j < history; ++j) {
+        const std::int64_t s = static_cast<std::int64_t>(tokens) - history + j;
+        staged[j] = s >= 0 ? __bfloat162float(x[s * d_inner + channel])
+                           : conv_state[(s + history) * d_inner + channel];
+    }
+    for (std::int32_t j = 0; j < history; ++j) { state_out[j * d_inner + channel] = staged[j]; }
+}
+
+// One head per block; the head slice never leaves registers/shared memory. Reductions stage
+// through shared memory and reduce on one thread: the decode path is one token, correctness
+// and clarity over latency.
+__global__ void decode_step_kernel(const __nv_bfloat16* __restrict__ q,
+                                   const __nv_bfloat16* __restrict__ k,
+                                   const __nv_bfloat16* __restrict__ v,
+                                   const float* __restrict__ gate, const float* __restrict__ beta,
+                                   const __nv_bfloat16* __restrict__ g2,
+                                   const float* __restrict__ o_norm_w, float* __restrict__ state,
+                                   __nv_bfloat16* __restrict__ out, std::int32_t dk) {
+    const std::int32_t h = static_cast<std::int32_t>(blockIdx.x);
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const bool live = tid < dk;
+    const std::int64_t base = static_cast<std::int64_t>(h) * dk;
+
+    __shared__ float s_stage[kDecodeBlock];
+    __shared__ float s_qh[kDecodeBlock], s_kh[kDecodeBlock];
+    __shared__ float s_u[kDecodeBlock], s_delta[kDecodeBlock], s_o[kDecodeBlock];
+    __shared__ float s_scalar;
+
+    const float qv = live ? __bfloat162float(q[base + tid]) : 0.0f;
+    const float kv = live ? __bfloat162float(k[base + tid]) : 0.0f;
+    s_stage[tid] = qv * qv;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 1e-6f;   // eps inside the sqrt, matching the host reference accumulation
+        for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+        s_scalar = rsqrtf(acc);
+    }
+    __syncthreads();
+    const float q_inv = s_scalar * rsqrtf(static_cast<float>(dk));   // dk^-0.5 folded in
+
+    s_stage[tid] = kv * kv;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 1e-6f;
+        for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+        s_scalar = rsqrtf(acc);
+    }
+    __syncthreads();
+
+    if (live) {
+        s_qh[tid] = qv * q_inv;
+        s_kh[tid] = kv * s_scalar;
+    }
+    __syncthreads();
+
+    float* S = state + static_cast<std::int64_t>(h) * dk * dk;   // row = key axis
+    if (live) {
+        const float decay = expf(gate[base + tid]);
+        for (std::int32_t j = 0; j < dk; ++j) {
+            S[static_cast<std::int64_t>(tid) * dk + j] *= decay;
+        }
+    }
+    __syncthreads();
+
+    if (live) {
+        float u = 0.0f;
+        for (std::int32_t i = 0; i < dk; ++i) {
+            u = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_kh[i], u);
+        }
+        s_u[tid] = u;
+    }
+    __syncthreads();
+    if (live) { s_delta[tid] = beta[h] * (__bfloat162float(v[base + tid]) - s_u[tid]); }
+    __syncthreads();
+    if (live) {
+        for (std::int32_t j = 0; j < dk; ++j) {
+            float& cell = S[static_cast<std::int64_t>(tid) * dk + j];
+            cell = fmaf(s_kh[tid], s_delta[j], cell);
+        }
+    }
+    __syncthreads();
+
+    if (live) {
+        float o = 0.0f;
+        for (std::int32_t i = 0; i < dk; ++i) {
+            o = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_qh[i], o);
+        }
+        s_o[tid] = o;
+    }
+    __syncthreads();
+
+    s_stage[tid] = live ? s_o[tid] * s_o[tid] : 0.0f;
+    __syncthreads();
+    if (tid == 0) {
+        float acc = 0.0f;
+        for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+        s_scalar = rsqrtf(acc / static_cast<float>(dk) + 1e-6f);
+    }
+    __syncthreads();
+    if (live) {
+        out[base + tid] = __float2bfloat16(
+            s_o[tid] * s_scalar * o_norm_w[tid] * sigmoid_f(__bfloat162float(g2[base + tid])));
+    }
+}
+
+
+
+// T tokens in a loop over the decode-step phases; the head slice stays in shared memory
+// across tokens so only the state matrix itself moves through global memory. The token
+// plane is [T, d_inner] row-major (head h at h*dk), matching the conv output layout.
+__global__ void prefill_kernel(const __nv_bfloat16* __restrict__ q,
+                               const __nv_bfloat16* __restrict__ k,
+                               const __nv_bfloat16* __restrict__ v,
+                               const float* __restrict__ gate, const float* __restrict__ beta,
+                               const __nv_bfloat16* __restrict__ g2,
+                               const float* __restrict__ o_norm_w, float* __restrict__ state,
+                               __nv_bfloat16* __restrict__ out, std::int32_t dk,
+                               std::int32_t d_inner, std::int32_t heads, std::int32_t tokens) {
+    const std::int32_t h = static_cast<std::int32_t>(blockIdx.x);
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    const bool live = tid < dk;
+    const std::int64_t base = static_cast<std::int64_t>(h) * dk;
+    float* S = state + static_cast<std::int64_t>(h) * dk * dk;
+
+    __shared__ float s_stage[kDecodeBlock];
+    __shared__ float s_qh[kDecodeBlock], s_kh[kDecodeBlock];
+    __shared__ float s_u[kDecodeBlock], s_delta[kDecodeBlock], s_o[kDecodeBlock];
+    __shared__ float s_scalar;
+
+    for (std::int32_t t = 0; t < tokens; ++t) {
+        const std::int64_t offset = static_cast<std::int64_t>(t) * d_inner;
+        const __nv_bfloat16* qt = q + offset + base;
+        const __nv_bfloat16* kt = k + offset + base;
+        const __nv_bfloat16* vt = v + offset + base;
+        const float* gt = gate + offset + base;
+        const __nv_bfloat16* g2t = g2 + offset + base;
+
+        const float qv = live ? __bfloat162float(qt[tid]) : 0.0f;
+        const float kv = live ? __bfloat162float(kt[tid]) : 0.0f;
+        s_stage[tid] = qv * qv;
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 1e-6f;
+            for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+            s_scalar = rsqrtf(acc);
+        }
+        __syncthreads();
+        const float q_inv = s_scalar * rsqrtf(static_cast<float>(dk));
+        s_stage[tid] = kv * kv;
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 1e-6f;
+            for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+            s_scalar = rsqrtf(acc);
+        }
+        __syncthreads();
+        if (live) {
+            s_qh[tid] = qv * q_inv;
+            s_kh[tid] = kv * s_scalar;
+        }
+        __syncthreads();
+
+        if (live) {
+            const float decay = expf(gt[tid]);
+            for (std::int32_t j = 0; j < dk; ++j) {
+                S[static_cast<std::int64_t>(tid) * dk + j] *= decay;
+            }
+        }
+        __syncthreads();
+        if (live) {
+            float u = 0.0f;
+            for (std::int32_t i = 0; i < dk; ++i) {
+                u = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_kh[i], u);
+            }
+            s_u[tid] = u;
+        }
+        __syncthreads();
+        if (live) {
+            s_delta[tid] =
+                beta[static_cast<std::int64_t>(t) * heads + h] * (__bfloat162float(vt[tid]) - s_u[tid]);
+        }
+        __syncthreads();
+        if (live) {
+            for (std::int32_t j = 0; j < dk; ++j) {
+                float& cell = S[static_cast<std::int64_t>(tid) * dk + j];
+                cell = fmaf(s_kh[tid], s_delta[j], cell);
+            }
+        }
+        __syncthreads();
+        if (live) {
+            float o = 0.0f;
+            for (std::int32_t i = 0; i < dk; ++i) {
+                o = fmaf(S[static_cast<std::int64_t>(i) * dk + tid], s_qh[i], o);
+            }
+            s_o[tid] = o;
+        }
+        __syncthreads();
+        s_stage[tid] = live ? s_o[tid] * s_o[tid] : 0.0f;
+        __syncthreads();
+        if (tid == 0) {
+            float acc = 0.0f;
+            for (std::int32_t i = 0; i < dk; ++i) { acc += s_stage[i]; }
+            s_scalar = rsqrtf(acc / static_cast<float>(dk) + 1e-6f);
+        }
+        __syncthreads();
+        if (live) {
+            out[offset + base + tid] = __float2bfloat16(
+                s_o[tid] * s_scalar * o_norm_w[tid] * sigmoid_f(__bfloat162float(g2t[tid])));
+        }
+        __syncthreads();
+    }
+}
+
