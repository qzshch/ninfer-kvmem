diff --git a/src/core/gaudi2/block_fp8.cpp b/src/core/gaudi2/block_fp8.cpp
new file mode 100644
index 0000000..5c38dda
--- /dev/null
+++ b/src/core/gaudi2/block_fp8.cpp
@@ -0,0 +1,110 @@
+#include "block_fp8.h"
+
+#include <bit>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+namespace {
+std::size_t multiply(std::size_t a, std::size_t b) {
+    if (a && b > std::numeric_limits<std::size_t>::max() / a)
+        throw std::overflow_error("block-FP8 size overflow");
+    return a * b;
+}
+std::size_t blocks(std::size_t extent) {
+    if (!extent) throw std::invalid_argument("block-FP8 matrix dimensions must be positive");
+    return extent / 128 + (extent % 128 != 0);
+}
+std::size_t covered_blocks(std::size_t start, std::size_t count) {
+    return (start + count - 1) / 128 - start / 128 + 1;
+}
+} // namespace
+
+float decode_e4m3fn(std::uint8_t code) noexcept {
+    const auto sign = static_cast<std::uint32_t>(code & 0x80) << 24;
+    const auto exponent = (code >> 3) & 0x0f;
+    const auto mantissa = code & 7;
+    if (exponent == 15 && mantissa == 7)
+        return std::bit_cast<float>(sign | 0x7fc00000u);
+    if (exponent)
+        return std::bit_cast<float>(sign | ((exponent + 120u) << 23) | (mantissa << 20));
+    if (!mantissa) return std::bit_cast<float>(sign);
+    const unsigned top = mantissa >= 4 ? 2 : mantissa >= 2 ? 1 : 0;
+    return std::bit_cast<float>(sign | ((118u + top) << 23) |
+                               ((static_cast<unsigned>(mantissa) << (23 - top)) & 0x7fffff));
+}
+
+std::uint16_t bf16_round_nearest_even(float value) noexcept {
+    auto bits = std::bit_cast<std::uint32_t>(value);
+    if ((bits & 0x7fffffffu) > 0x7f800000u)
+        return static_cast<std::uint16_t>((bits >> 16) | 0x40); // quiet NaN remains a NaN
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return static_cast<std::uint16_t>(bits >> 16);
+}
+
+std::size_t BlockFp8Matrix::code_bytes() const {
+    (void)scale_rows(); (void)scale_columns();
+    return multiply(rows, columns);
+}
+std::size_t BlockFp8Matrix::scale_rows() const { return blocks(rows); }
+std::size_t BlockFp8Matrix::scale_columns() const { return blocks(columns); }
+std::size_t BlockFp8Matrix::scale_bytes() const {
+    return multiply(multiply(scale_rows(), scale_columns()), sizeof(float));
+}
+
+void BlockFp8Tile::validate() const {
+    (void)matrix.code_bytes(); (void)matrix.scale_bytes();
+    if (!rows || !columns || row >= matrix.rows || column >= matrix.columns ||
+        rows > matrix.rows - row || columns > matrix.columns - column)
+        throw std::invalid_argument("block-FP8 tile is empty or outside matrix");
+    (void)multiply(rows, columns);
+}
+std::size_t BlockFp8Tile::elements() const { validate(); return multiply(rows, columns); }
+std::size_t BlockFp8Tile::scale_rows() const { validate(); return covered_blocks(row, rows); }
+std::size_t BlockFp8Tile::scale_columns() const { validate(); return covered_blocks(column, columns); }
+std::size_t BlockFp8Tile::scale_elements() const { return multiply(scale_rows(), scale_columns()); }
+std::size_t BlockFp8Tile::host_bytes() const {
+    const auto data = multiply(elements(), 3); // codes + BF16 result
+    const auto scales = multiply(scale_elements(), sizeof(float));
+    if (data > std::numeric_limits<std::size_t>::max() - scales)
+        throw std::overflow_error("block-FP8 tile storage overflow");
+    return data + scales;
+}
+
+void decode_block_fp8_tile(const BlockFp8Tile& tile,
+                           std::span<const std::uint8_t> codes,
+                           std::span<const float> scales,
+                           std::span<std::uint16_t> output) {
+    if (codes.size() != tile.elements() || output.size() != codes.size() ||
+        scales.size() != tile.scale_elements())
+        throw std::invalid_argument("block-FP8 tile plane length mismatch");
+    const auto overlaps_output = [&](const auto& input) {
+        const auto begin = reinterpret_cast<std::uintptr_t>(input.data());
+        const auto end = reinterpret_cast<std::uintptr_t>(input.data() + input.size());
+        const auto out_begin = reinterpret_cast<std::uintptr_t>(output.data());
+        const auto out_end = reinterpret_cast<std::uintptr_t>(output.data() + output.size());
+        return begin < out_end && out_begin < end;
+    };
+    if (overlaps_output(codes) || overlaps_output(scales))
+        throw std::invalid_argument("block-FP8 output must not overlap input planes");
+    for (const auto scale : scales)
+        if (!std::isfinite(scale) || scale < 0)
+            throw std::invalid_argument("block-FP8 scales must be finite and nonnegative");
+    const auto scale_columns = tile.scale_columns();
+    const auto value_at = [&](std::size_t i) {
+        if ((codes[i] & 0x7f) == 0x7f)
+            throw std::invalid_argument("block-FP8 weight codes must be finite");
+        const auto r = (tile.row + i / tile.columns) / 128 - tile.row / 128;
+        const auto c = (tile.column + i % tile.columns) / 128 - tile.column / 128;
+        const float value = decode_e4m3fn(codes[i]) * scales[r * scale_columns + c];
+        const auto bf16 = bf16_round_nearest_even(value);
+        if (!std::isfinite(value) || (bf16 & 0x7f80) == 0x7f80)
+            throw std::invalid_argument("block-FP8 decoded value overflows BF16");
+        return bf16;
+    };
+    for (std::size_t i = 0; i < codes.size(); ++i) (void)value_at(i);
+    for (std::size_t i = 0; i < codes.size(); ++i) output[i] = value_at(i);
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/block_fp8.h b/src/core/gaudi2/block_fp8.h
new file mode 100644
index 0000000..e090a38
--- /dev/null
+++ b/src/core/gaudi2/block_fp8.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::gaudi2 {
+
+// HF F8_E4M3 / torch.float8_e4m3fn, including signed zero, subnormals and 448.
+// This is not Gaudi2's native E4M3 encoding/range. No native-FP8 reinterpretation is valid.
+[[nodiscard]] float decode_e4m3fn(std::uint8_t code) noexcept;
+[[nodiscard]] std::uint16_t bf16_round_nearest_even(float value) noexcept;
+
+struct BlockFp8Matrix {
+    std::size_t rows;
+    std::size_t columns;
+
+    [[nodiscard]] std::size_t code_bytes() const;
+    [[nodiscard]] std::size_t scale_rows() const;
+    [[nodiscard]] std::size_t scale_columns() const;
+    [[nodiscard]] std::size_t scale_bytes() const;
+};
+
+// All input/output planes below are compact row-major tiles, not full matrices.
+// Scales cover every intersected 128x128 block, starting at floor(row/128), floor(column/128).
+struct BlockFp8Tile {
+    BlockFp8Matrix matrix;
+    std::size_t row;
+    std::size_t column;
+    std::size_t rows;
+    std::size_t columns;
+
+    void validate() const;
+    [[nodiscard]] std::size_t elements() const;
+    [[nodiscard]] std::size_t scale_rows() const;
+    [[nodiscard]] std::size_t scale_columns() const;
+    [[nodiscard]] std::size_t scale_elements() const;
+    [[nodiscard]] std::size_t host_bytes() const;
+};
+
+// Caller owns bounded, disjoint storage. Validates all inputs/results before modifying output.
+// HF weight_scale_inv words are multiplicative dequantization scales; no reciprocal is taken.
+// Output is BF16 words for W8A16 preparation, not an FP8-MME/W8A8 representation.
+void decode_block_fp8_tile(const BlockFp8Tile& tile,
+                           std::span<const std::uint8_t> codes,
+                           std::span<const float> scales,
+                           std::span<std::uint16_t> output);
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/block_fp8_test.cpp b/src/core/gaudi2/block_fp8_test.cpp
new file mode 100644
index 0000000..2a7f3a8
--- /dev/null
+++ b/src/core/gaudi2/block_fp8_test.cpp
@@ -0,0 +1,97 @@
+#include "block_fp8.h"
+
+#include <array>
+#include <bit>
+#include <cmath>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+using namespace ninfer::gaudi2;
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+template<class F> void rejects(F&& f) {
+    try { f(); } catch (const std::invalid_argument&) { return; }
+    throw std::runtime_error("invalid input accepted");
+}
+// Independent rational formula, evaluated in FP64. All finite E4M3FN values are exact in FP32.
+double oracle(unsigned code) {
+    const int e = (code / 8) % 16, m = code % 8;
+    const double magnitude = e ? std::ldexp(1.0 + m / 8.0, e - 7) : std::ldexp(m, -9);
+    return code & 128 ? -magnitude : magnitude;
+}
+void codecs() {
+    for (unsigned c = 0; c < 256; ++c) {
+        const auto actual = decode_e4m3fn(static_cast<std::uint8_t>(c));
+        if ((c & 127) == 127) require(std::isnan(actual), "NaN code");
+        else {
+            require(static_cast<double>(actual) == oracle(c), "FP8 exact decode");
+            require(std::signbit(actual) == static_cast<bool>(c & 128), "FP8 sign");
+        }
+    }
+    require(decode_e4m3fn(0x7e) == 448, "FN range must retain 448");
+    require(bf16_round_nearest_even(std::bit_cast<float>(0x3f808000u)) == 0x3f80, "even tie");
+    require(bf16_round_nearest_even(std::bit_cast<float>(0x3f818000u)) == 0x3f82, "odd tie");
+    require(bf16_round_nearest_even(std::bit_cast<float>(0x80000000u)) == 0x8000, "negative zero");
+    require(bf16_round_nearest_even(std::bit_cast<float>(0x00008000u)) == 0, "subnormal even tie");
+    require(bf16_round_nearest_even(std::bit_cast<float>(0x00018000u)) == 2, "subnormal odd tie");
+    require((bf16_round_nearest_even(std::bit_cast<float>(0x7f800001u)) & 0x7f) != 0, "NaN preservation");
+}
+void tiles() {
+    const BlockFp8Tile tile{{257, 259}, 127, 126, 130, 133};
+    std::vector<std::uint8_t> codes(tile.elements());
+    std::vector<float> scales(tile.scale_elements());
+    std::vector<std::uint16_t> result(tile.elements());
+    for (std::size_t i = 0; i < codes.size(); ++i) codes[i] = static_cast<std::uint8_t>(i % 127);
+    for (std::size_t i = 0; i < scales.size(); ++i) scales[i] = std::ldexp(1.0f, static_cast<int>(i) - 4);
+    decode_block_fp8_tile(tile, codes, scales, result);
+    for (std::size_t i = 0; i < codes.size(); ++i) {
+        const auto r = (tile.row + i / tile.columns) / 128;
+        const auto c = (tile.column + i % tile.columns) / 128;
+        const double exact = oracle(codes[i]) * scales[r * 3 + c];
+        // Power-of-two scaled FP8 values are exactly BF16; compare FP64 value after independent word expansion.
+        require(static_cast<double>(std::bit_cast<float>(static_cast<std::uint32_t>(result[i]) << 16)) == exact,
+                "unaligned tile block-scale addressing");
+    }
+    const auto original = result;
+    codes.back() = 0x7f;
+    rejects([&] { decode_block_fp8_tile(tile, codes, scales, result); });
+    require(result == original, "invalid code must not partially overwrite destination");
+    codes.back() = 0x7e;
+    for (float bad : {-1.0f, std::numeric_limits<float>::infinity(), std::numeric_limits<float>::quiet_NaN()}) {
+        scales.back() = bad;
+        rejects([&] { decode_block_fp8_tile(tile, codes, scales, result); });
+    }
+    scales.back() = std::numeric_limits<float>::max();
+    rejects([&] { decode_block_fp8_tile(tile, codes, scales, result); });
+    require(result == original, "invalid result must preserve destination");
+    rejects([&] { decode_block_fp8_tile(tile, codes, std::span(scales).first(1), result); });
+    std::array<std::uint8_t, 1> one{0x38};
+    std::array<float, 1> scale{std::numeric_limits<float>::max()};
+    std::array<std::uint16_t, 1> out{0x1234};
+    const BlockFp8Tile scalar{{1, 1}, 0, 0, 1, 1};
+    rejects([&] { decode_block_fp8_tile(scalar, one, scale, out); });
+    require(out[0] == 0x1234, "finite FP32 rounding to BF16 infinity must be rejected");
+    scale[0] = 0; one[0] = 0x81;
+    decode_block_fp8_tile(scalar, one, scale, out);
+    require(out[0] == 0x8000, "zero scale retains negative sign");
+    const auto aliased = std::span(reinterpret_cast<const std::uint8_t*>(out.data()), 1);
+    rejects([&] { decode_block_fp8_tile(scalar, aliased, scale, out); });
+    rejects([] { BlockFp8Tile{{257, 259}, 257, 0, 1, 1}.validate(); });
+    rejects([] { BlockFp8Tile{{257, 259}, 1, 1, 0, 1}.validate(); });
+    const BlockFp8Tile qwen_ffn{{17408, 5120}, 128, 256, 128, 128};
+    require(qwen_ffn.matrix.code_bytes() == 89128960, "real Qwen FFN shape");
+    require(qwen_ffn.host_bytes() == 49156, "tile allocation must not scale with matrix dimensions");
+    try {
+        (void)BlockFp8Matrix{std::numeric_limits<std::size_t>::max(), 2}.code_bytes();
+        throw std::runtime_error("size overflow accepted");
+    } catch (const std::overflow_error&) {}
+}
+} // namespace
+int main() {
+    try { codecs(); tiles(); std::cout << "all block-FP8 exact/state/range checks passed\n"; }
+    catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
diff --git a/src/core/gaudi2/fp8_tile_main.cpp b/src/core/gaudi2/fp8_tile_main.cpp
new file mode 100644
index 0000000..adb77ed
--- /dev/null
+++ b/src/core/gaudi2/fp8_tile_main.cpp
@@ -0,0 +1,107 @@
+#include "block_fp8.h"
+
+#include <bit>
+#include <charconv>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string_view>
+#include <vector>
+
+namespace {
+std::size_t number(std::string_view text) {
+    std::size_t value = 0;
+    const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+    if (error != std::errc{} || end != text.data() + text.size() || text.empty())
+        throw std::invalid_argument("dimensions/offsets must be unsigned decimal integers");
+    return value;
+}
+void check_plane(const std::filesystem::path& path, std::size_t bytes,
+                 std::size_t offset, bool embedded) {
+    const auto size = std::filesystem::file_size(path);
+    if (offset > size || bytes > size - offset || (!embedded && bytes != size))
+        throw std::invalid_argument("input file size/range does not match the declared plane");
+    if (size > static_cast<std::uintmax_t>(std::numeric_limits<std::streamoff>::max()))
+        throw std::invalid_argument("input file exceeds stream offset range");
+}
+void read_at(std::ifstream& input, std::size_t offset, char* data, std::size_t bytes) {
+    input.seekg(static_cast<std::streamoff>(offset));
+    input.read(data, static_cast<std::streamsize>(bytes));
+    if (!input) throw std::runtime_error("short input read");
+}
+bool same_file(const std::filesystem::path& a, const std::filesystem::path& b) {
+    return std::filesystem::absolute(a).lexically_normal() ==
+               std::filesystem::absolute(b).lexically_normal() ||
+           (std::filesystem::exists(b) && std::filesystem::equivalent(a, b));
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    using namespace ninfer::gaudi2;
+    if (argc == 2 && std::string_view(argv[1]) == "--help") {
+        std::cout << "ninfer-gaudi2-fp8-tile CODES_FILE SCALES_FILE N K ROW COL ROWS COLS OUTPUT\n"
+                     "  [--codes-offset BYTES] [--scales-offset BYTES] [--max-host-tile-bytes BYTES]\n"
+                     "F8_E4M3FN row-major codes, F32-LE 128x128 dequantization multipliers.\n"
+                     "Offsets address planes inside checkpoint files; without an offset, an exact raw plane is required.\n"
+                     "Writes compact BF16-LE W8A16 tile. Host preparation only; no HPU inference.\n";
+        return 0;
+    }
+    try {
+        static_assert(std::endian::native == std::endian::little,
+                      "Gaudi2 preparation requires a little-endian host");
+        if (argc < 10 || (argc - 10) % 2)
+            throw std::invalid_argument("invalid arguments; use --help");
+        const BlockFp8Tile tile{{number(argv[3]), number(argv[4])}, number(argv[5]),
+                               number(argv[6]), number(argv[7]), number(argv[8])};
+        tile.validate();
+        std::size_t code_offset = 0, scale_offset = 0, max_host_bytes = 64u * 1024u * 1024u;
+        bool embedded_codes = false, embedded_scales = false, explicit_limit = false;
+        for (int i = 10; i < argc; i += 2) {
+            const std::string_view option = argv[i];
+            if (option == "--codes-offset" && !embedded_codes) {
+                embedded_codes = true; code_offset = number(argv[i + 1]);
+            } else if (option == "--scales-offset" && !embedded_scales) {
+                embedded_scales = true; scale_offset = number(argv[i + 1]);
+            } else if (option == "--max-host-tile-bytes" && !explicit_limit) {
+                explicit_limit = true; max_host_bytes = number(argv[i + 1]);
+            } else throw std::invalid_argument("unknown or duplicate option");
+        }
+        check_plane(argv[1], tile.matrix.code_bytes(), code_offset, embedded_codes);
+        check_plane(argv[2], tile.matrix.scale_bytes(), scale_offset, embedded_scales);
+        if (same_file(argv[1], argv[9]) || same_file(argv[2], argv[9]))
+            throw std::invalid_argument("output must not overwrite an input file");
+        // Precisely one codes tile, one scales tile and one BF16 output tile. No full-matrix copy.
+        const auto host_bytes = tile.host_bytes();
+        if (host_bytes > max_host_bytes)
+            throw std::invalid_argument("tile exceeds --max-host-tile-bytes (default 64 MiB)");
+        std::vector<std::uint8_t> codes(tile.elements());
+        std::vector<float> scales(tile.scale_elements());
+        std::vector<std::uint16_t> output(tile.elements());
+        std::ifstream code_file(argv[1], std::ios::binary), scale_file(argv[2], std::ios::binary);
+        if (!code_file || !scale_file) throw std::runtime_error("cannot open input file");
+        for (std::size_t r = 0; r < tile.rows; ++r)
+            read_at(code_file, code_offset + (tile.row + r) * tile.matrix.columns + tile.column,
+                    reinterpret_cast<char*>(codes.data() + r * tile.columns), tile.columns);
+        const auto scale_columns = tile.scale_columns();
+        for (std::size_t r = 0; r < tile.scale_rows(); ++r)
+            read_at(scale_file, scale_offset + ((tile.row / 128 + r) * tile.matrix.scale_columns() +
+                        tile.column / 128) * sizeof(float),
+                    reinterpret_cast<char*>(scales.data() + r * scale_columns), scale_columns * sizeof(float));
+        decode_block_fp8_tile(tile, codes, scales, output);
+        std::ofstream result(argv[9], std::ios::binary | std::ios::trunc);
+        if (!result) throw std::runtime_error("cannot open output file");
+        result.write(reinterpret_cast<const char*>(output.data()),
+                     static_cast<std::streamsize>(output.size() * sizeof(std::uint16_t)));
+        result.close();
+        if (!result) throw std::runtime_error("cannot write output file");
+        std::cout << "{\"profile\":\"hf-e4m3fn-block128-f32-to-bf16-rne-w8a16\","
+                  << "\"rows\":" << tile.rows << ",\"columns\":" << tile.columns
+                  << ",\"host_tile_buffer_bytes\":" << host_bytes << "}\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "Gaudi2 block-FP8 preparation failed: " << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/src/core/gaudi2/gguf_loader_hpu.cpp b/src/core/gaudi2/gguf_loader_hpu.cpp
new file mode 100644
index 0000000..9b99993
--- /dev/null
+++ b/src/core/gaudi2/gguf_loader_hpu.cpp
@@ -0,0 +1,49 @@
+// GLM-5.3-Flash GGUF loader, Gaudi2 HPU backend. The tensor walk is the
+// shared detail::load_gguf_walk (gguf_loader.cpp); this file supplies the
+// HPU uploader - pinned staging + DMA through the runtime adapter's
+// Device/Stream - so every weight plane lands in HBM exactly once, inside
+// the caller's Glm5HpuWeightPlanes registry (gap 4: no file-static
+// residency, no returned raw-address buffer set; the registry owns the
+// DeviceBuffers and the block executors bind them by payload address).
+
+#include "models/glm5/execution/gguf_loader.h"
+#include "core/gaudi2/runtime.h"
+#include "core/gaudi2/glm5_hpu_weights.h"
+
+#include <stdexcept>
+
+namespace ninfer::models::glm5::execution {
+namespace {
+
+struct WalkContext {
+    gaudi2::Device* device = nullptr;
+    gaudi2::Stream* stream = nullptr;
+    gaudi2::Glm5HpuWeightPlanes* planes = nullptr;
+};
+
+void* upload_thunk(const void* host, std::size_t bytes, void* context) {
+    auto* ctx = static_cast<WalkContext*>(context);
+    return const_cast<void*>(
+        ctx->planes->upload(*ctx->device, *ctx->stream, host, bytes));
+}
+
+} // namespace
+
+void load_gguf_weights_hpu(const std::string& path, Glm5ModelWeights& weights,
+                           const Glm5StepConfig& config,
+                           ninfer::gaudi2::Device& device,
+                           ninfer::gaudi2::Stream& stream,
+                           ninfer::gaudi2::Glm5HpuWeightPlanes& planes) {
+    GgufFile gguf(path);
+    WalkContext context{&device, &stream, &planes};
+    // The walk's GgufWeightBuffers return value is the CUDA path's
+    // free-list; on this path the registry owns every plane.
+    (void)detail::load_gguf_walk(
+        gguf, weights, config,
+        [&context](const void* host, std::size_t bytes) -> void* {
+            return const_cast<void*>(
+                context.planes->upload(*context.device, *context.stream, host, bytes));
+        });
+}
+
+} // namespace ninfer::models::glm5::execution
diff --git a/src/core/gaudi2/glm5_hpu_block.cpp b/src/core/gaudi2/glm5_hpu_block.cpp
new file mode 100644
index 0000000..d909c17
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_block.cpp
@@ -0,0 +1,399 @@
+#include "core/gaudi2/glm5_hpu_block.h"
+#include "ops/gaudi2/bf16_gemm.h"
+
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+namespace {
+
+float bf16_word_to_float(std::uint16_t word) {
+    std::uint32_t bits = static_cast<std::uint32_t>(word) << 16;
+    float result;
+    std::memcpy(&result, &bits, 4);
+    return result;
+}
+
+std::uint16_t float_to_bf16_word(float value) {
+    std::uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return static_cast<std::uint16_t>(bits >> 16);
+}
+
+float sigmoid(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+
+// Transposes a row-major [rows, cols] BF16 host matrix into [cols, rows]
+// (Bf16Gemm expects W as [N, K] where the GEMM computes Y = A[M,K] * W[N,K]^T;
+// our host weights are [out_features, in_features] = [N, K], which matches).
+std::vector<std::uint16_t> no_transpose(std::span<const std::uint16_t> w) {
+    return {w.begin(), w.end()};
+}
+
+} // namespace
+
+Glm5KdaHpuWeights glm5_kda_hpu_upload_weights(
+    const Device& device,
+    std::span<const std::uint16_t> attn_norm,
+    std::span<const std::uint16_t> wq_t, std::span<const std::uint16_t> wk_t,
+    std::span<const std::uint16_t> wv_t,
+    std::span<const std::uint16_t> f_a_t, std::span<const std::uint16_t> f_b_t,
+    std::span<const std::uint16_t> beta_t,
+    std::span<const std::uint16_t> g_a_t, std::span<const std::uint16_t> g_b_t,
+    std::span<const std::uint16_t> wo_t,
+    std::span<const float> dt_bias, std::span<const float> a_log,
+    std::span<const float> o_norm_w,
+    std::span<const std::uint16_t> conv_q, std::span<const std::uint16_t> conv_k,
+    std::span<const std::uint16_t> conv_v) {
+    Glm5KdaHpuWeights w;
+    auto upload = [&](std::span<const std::uint16_t> data) {
+        PinnedBuffer host = device.allocate_host(data.size() * 2);
+        std::memcpy(host.bytes().data(), data.data(), data.size() * 2);
+        DeviceBuffer dev = device.allocate_device(data.size() * 2);
+        Stream stream = device.create_stream();
+        auto transfer = stream.upload(dev, host, host.size());
+        transfer.wait();
+        return dev;
+    };
+    w.attn_norm = upload(attn_norm);
+    w.wq = upload(wq_t);
+    w.wk = upload(wk_t);
+    w.wv = upload(wv_t);
+    w.f_a = upload(f_a_t);
+    w.f_b = upload(f_b_t);
+    w.beta = upload(beta_t);
+    w.g_a = upload(g_a_t);
+    w.g_b = upload(g_b_t);
+    w.wo = upload(wo_t);
+    w.dt_bias.assign(dt_bias.begin(), dt_bias.end());
+    w.a_log.assign(a_log.begin(), a_log.end());
+    w.o_norm_w.assign(o_norm_w.begin(), o_norm_w.end());
+    // Conv weights stay host-side: the conv runs on host between GEMMs.
+    auto unpack = [](std::span<const std::uint16_t> packed) {
+        std::vector<float> out(packed.size());
+        for (std::size_t i = 0; i < packed.size(); ++i) {
+            out[i] = bf16_word_to_float(packed[i]);
+        }
+        return out;
+    };
+    w.conv_q = unpack(conv_q);
+    w.conv_k = unpack(conv_k);
+    w.conv_v = unpack(conv_v);
+    return w;
+}
+
+Glm5KdaHpuState glm5_kda_hpu_init_state(const Device& device,
+                                          const Glm5KdaHpuConfig& config) {
+    Glm5KdaHpuState state;
+    const std::size_t d_inner = config.heads * config.head_dim;
+    const std::size_t conv_state = (config.d_conv - 1) * d_inner * 4;
+    const std::size_t matrix_state =
+        static_cast<std::size_t>(config.heads) * config.head_dim * config.head_dim * 4;
+    state.conv_q = device.allocate_device(std::max(conv_state, std::size_t{1}));
+    state.conv_k = device.allocate_device(std::max(conv_state, std::size_t{1}));
+    state.conv_v = device.allocate_device(std::max(conv_state, std::size_t{1}));
+    state.matrix = device.allocate_device(std::max(matrix_state, std::size_t{1}));
+    // The recurrence reads these planes before their first write (the decay
+    // applies to the carried state), so a fresh sequence must start from
+    // zero, not allocator garbage. Pinned staging is zero-allocated; the
+    // upload channel works on both the fake and the real runtime.
+    auto zero_fill = [&device](DeviceBuffer& buffer, std::size_t bytes) {
+        PinnedBuffer zeros = device.allocate_host(bytes);
+        // Explicitly clear the staging plane: the real host allocator does
+        // not zero its buffers, and the fake one happening to must not mask
+        // an uninitialized upload.
+        std::memset(zeros.bytes().data(), 0, bytes);
+        auto stream = device.create_stream();
+        auto transfer = stream.upload(buffer, zeros, bytes);
+        transfer.wait();
+    };
+    zero_fill(state.conv_q, conv_state);
+    zero_fill(state.conv_k, conv_state);
+    zero_fill(state.conv_v, conv_state);
+    zero_fill(state.matrix, matrix_state);
+    return state;
+}
+
+std::size_t glm5_kda_hpu_scratch_bytes(const Glm5KdaHpuConfig& config) {
+    const std::size_t d_inner = config.heads * config.head_dim;
+    const std::size_t head_dim = config.head_dim;
+    const std::size_t hidden = config.hidden;
+    // Pinned host staging for: input, normed, q/k/v raw, q/k/v conv, gate_pre,
+    // beta_logits, g2, prefill_out, block_out, FP32 gate/beta/state planes.
+    return (hidden * 2) * 2 + (d_inner * 2) * 7 + (head_dim * 2) * 2 +
+           (config.heads * 2) + d_inner * 4 + config.heads * 4 +
+           d_inner * d_inner * config.heads * 4 + 1024;
+}
+
+Glm5KdaHpuProjections::Glm5KdaHpuProjections(const Device& device,
+                                               const Glm5KdaHpuConfig& config,
+                                               std::size_t max_workspace_bytes)
+    // Bf16Gemm computes Y[1,N] = A[1,K] * W[N,K]^T and the block weights are
+    // stored [out, in] = [N, K], so every projection binds directly.
+    : wq{device, Bf16GemmShape{1, config.heads * config.head_dim, config.hidden}, max_workspace_bytes},
+      wk{device, Bf16GemmShape{1, config.heads * config.head_dim, config.hidden}, max_workspace_bytes},
+      wv{device, Bf16GemmShape{1, config.heads * config.head_dim, config.hidden}, max_workspace_bytes},
+      f_a{device, Bf16GemmShape{1, config.head_dim, config.hidden}, max_workspace_bytes},
+      g_a{device, Bf16GemmShape{1, config.head_dim, config.hidden}, max_workspace_bytes},
+      f_b{device, Bf16GemmShape{1, config.heads * config.head_dim, config.head_dim}, max_workspace_bytes},
+      g_b{device, Bf16GemmShape{1, config.heads * config.head_dim, config.head_dim}, max_workspace_bytes},
+      beta{device, Bf16GemmShape{1, config.heads, config.hidden}, max_workspace_bytes},
+      wo{device, Bf16GemmShape{1, config.hidden, config.heads * config.head_dim}, max_workspace_bytes} {}
+
+Glm5KdaHpuProjections glm5_kda_hpu_make_projections(const Device& device,
+                                                    const Glm5KdaHpuConfig& config,
+                                                    std::size_t max_workspace_bytes) {
+    return Glm5KdaHpuProjections{device, config, max_workspace_bytes};
+}
+
+std::vector<std::uint16_t> glm5_kda_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5KdaHpuProjections& projections,
+    const Glm5KdaHpuWeights& w, Glm5KdaHpuState& state,
+    const Glm5KdaHpuConfig& config,
+    std::span<const std::uint16_t> hidden_in) {
+
+    const std::uint32_t hidden = config.hidden;
+    const std::uint32_t heads = config.heads;
+    const std::uint32_t head_dim = config.head_dim;
+    const std::uint32_t d_inner = heads * head_dim;
+    const std::uint32_t d_conv = config.d_conv;
+    if (hidden_in.size() != hidden) {
+        throw std::invalid_argument("glm5_kda_hpu_decode_step: hidden_in size mismatch");
+    }
+
+    // ---- Stage 1: RMSNorm on host ----
+    std::vector<float> x(hidden);
+    {
+        std::vector<float> norm_w(hidden);
+        // Download the norm weight from device.
+        PinnedBuffer host_w = device.allocate_host(hidden * 2);
+        auto dl = stream.download(host_w, const_cast<DeviceBuffer&>(w.attn_norm), hidden * 2);
+        dl.wait();
+        std::memcpy(norm_w.data(), host_w.bytes().data(), hidden * 2);
+        // norm_w is BF16 words; convert.
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            // reinterpret the BF16 word as a float via bit shift
+            const auto word = static_cast<std::uint16_t>(norm_w.data()[i]);
+            // Actually we downloaded raw bytes; need to convert properly.
+            (void)word;  // handled below
+        }
+        // Re-download as uint16 words.
+        std::vector<std::uint16_t> norm_w_bf16(hidden);
+        std::memcpy(norm_w_bf16.data(), host_w.bytes().data(), hidden * 2);
+
+        float mean_square = 0;
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            const float v = bf16_word_to_float(hidden_in[i]);
+            mean_square += v * v;
+        }
+        const float inverse = 1.0f / std::sqrt(mean_square / hidden + config.rms_eps);
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            const float v = bf16_word_to_float(hidden_in[i]);
+            const float gamma = bf16_word_to_float(norm_w_bf16[i]);
+            x[i] = v * inverse * gamma;  // stays FP32; Bf16Gemm input will be BF16
+        }
+    }
+
+    // ---- Stage 2: every projection on the MME ----
+    // device_project: upload the FP32 operand rounded to BF16, run this
+    // projection's static recipe against its pre-uploaded weight plane,
+    // download the BF16 result widened to FP32.
+    auto device_project = [&](Bf16Gemm& gemm, const DeviceBuffer& weight,
+                              const std::vector<float>& input,
+                              std::uint32_t in_cols) {
+        const std::uint32_t out_rows = static_cast<std::uint32_t>(gemm.shape().n);
+        PinnedBuffer host_in = device.allocate_host(in_cols * 2);
+        for (std::uint32_t i = 0; i < in_cols; ++i) {
+            const auto word = float_to_bf16_word(input[i]);
+            std::memcpy(host_in.bytes().data() + i * 2, &word, 2);
+        }
+        PinnedBuffer host_out = device.allocate_host(out_rows * 2);
+        DeviceBuffer dev_in = device.allocate_device(in_cols * 2);
+        DeviceBuffer dev_out = device.allocate_device(out_rows * 2);
+        auto up = stream.upload(dev_in, host_in, in_cols * 2);
+        up.wait();
+        auto compute = gemm.launch(stream, dev_in, const_cast<DeviceBuffer&>(weight), dev_out);
+        compute.wait();
+        auto down = stream.download(host_out, dev_out, out_rows * 2);
+        down.wait();
+        std::vector<float> result(out_rows);
+        const auto* words = reinterpret_cast<const std::uint16_t*>(host_out.bytes().data());
+        for (std::uint32_t r = 0; r < out_rows; ++r) {
+            result[r] = bf16_word_to_float(words[r]);
+        }
+        return result;
+    };
+
+    std::vector<float> q_raw = device_project(projections.wq, w.wq, x, hidden);
+    std::vector<float> k_raw = device_project(projections.wk, w.wk, x, hidden);
+    std::vector<float> v_raw = device_project(projections.wv, w.wv, x, hidden);
+
+    // ---- Stage 3: Conv + SiLU on host ----
+    auto conv_silu = [&](std::vector<float>& raw, const std::vector<float>& conv_w,
+                         DeviceBuffer& conv_state) {
+        // Download current conv state.
+        const std::uint32_t hist = d_conv - 1;
+        PinnedBuffer host_state = device.allocate_host(hist * d_inner * 4);
+        auto dl = stream.download(host_state, conv_state, hist * d_inner * 4);
+        dl.wait();
+        std::vector<float> state_vals(hist * d_inner);
+        std::memcpy(state_vals.data(), host_state.bytes().data(), hist * d_inner * 4);
+
+        std::vector<float> out(d_inner);
+        for (std::uint32_t c = 0; c < d_inner; ++c) {
+            float acc = 0;
+            for (std::uint32_t tap = 0; tap < d_conv; ++tap) {
+                const int s = static_cast<int>(0) - static_cast<int>(hist) + static_cast<int>(tap);
+                const float sample = s >= 0 ? raw[c] : state_vals[(s + hist) * d_inner + c];
+                acc += conv_w[c * d_conv + tap] * sample;
+            }
+            out[c] = acc * sigmoid(acc);  // SiLU
+        }
+
+        // Update conv state (slide).
+        std::vector<float> new_state(hist * d_inner);
+        for (std::uint32_t j = 0; j < hist; ++j) {
+            const int s = static_cast<int>(1) - static_cast<int>(hist) + static_cast<int>(j);
+            for (std::uint32_t c = 0; c < d_inner; ++c) {
+                new_state[j * d_inner + c] =
+                    s >= 0 ? raw[c] : state_vals[(s + hist) * d_inner + c];
+            }
+        }
+        PinnedBuffer host_new = device.allocate_host(hist * d_inner * 4);
+        std::memcpy(host_new.bytes().data(), new_state.data(), hist * d_inner * 4);
+        auto up = stream.upload(conv_state, host_new, hist * d_inner * 4);
+        up.wait();
+        return out;
+    };
+
+    std::vector<float> qc = conv_silu(q_raw, w.conv_q, state.conv_q);
+    std::vector<float> kc = conv_silu(k_raw, w.conv_k, state.conv_k);
+    std::vector<float> vc = conv_silu(v_raw, w.conv_v, state.conv_v);
+
+    // ---- Stage 4: gate chain projections on the MME, gates on host ----
+    const std::vector<float> f_a_out = device_project(projections.f_a, w.f_a, x, hidden);
+    std::vector<float> gate_pre(d_inner);
+    {
+        const std::vector<float> f_b_out = device_project(projections.f_b, w.f_b, f_a_out, head_dim);
+        for (std::uint32_t r = 0; r < d_inner; ++r) {
+            gate_pre[r] = f_b_out[r] + w.dt_bias[r];
+        }
+    }
+    std::vector<float> gate(d_inner);
+    for (std::uint32_t i = 0; i < d_inner; ++i) {
+        const std::uint32_t h = i / head_dim;
+        const float rate = std::exp(w.a_log[h]);
+        gate[i] = config.gate_lower_bound * sigmoid(rate * gate_pre[i]);
+    }
+    std::vector<float> beta(heads);
+    {
+        const std::vector<float> beta_logits = device_project(projections.beta, w.beta, x, hidden);
+        for (std::uint32_t r = 0; r < heads; ++r) {
+            beta[r] = sigmoid(beta_logits[r]);
+        }
+    }
+
+    // ---- Stage 5: KDA recurrence on host ----
+    std::vector<float> scan_out(d_inner);
+    {
+        // Download the matrix state.
+        const std::size_t matrix_floats =
+            static_cast<std::size_t>(heads) * head_dim * head_dim;
+        PinnedBuffer host_matrix = device.allocate_host(matrix_floats * 4);
+        auto dl = stream.download(host_matrix, state.matrix, matrix_floats * 4);
+        dl.wait();
+        std::vector<float> S(matrix_floats);
+        std::memcpy(S.data(), host_matrix.bytes().data(), matrix_floats * 4);
+
+        // Per head: l2norm q/k, decay, delta rule, output.
+        const float scale = 1.0f / std::sqrt(static_cast<float>(head_dim));
+        const float l2_eps = 1e-6f;
+        for (std::uint32_t h = 0; h < heads; ++h) {
+            const float* qt = &qc[h * head_dim];
+            const float* kt = &kc[h * head_dim];
+            const float* vt = &vc[h * head_dim];
+            const float* gt = &gate[h * head_dim];
+            const float b = beta[h];
+            float* Sh = &S[static_cast<std::size_t>(h) * head_dim * head_dim];
+
+            float qs = l2_eps, ks = l2_eps;
+            for (std::uint32_t i = 0; i < head_dim; ++i) {
+                qs += qt[i] * qt[i];
+                ks += kt[i] * kt[i];
+            }
+            const float qi = 1.0f / std::sqrt(qs);
+            const float ki = 1.0f / std::sqrt(ks);
+            std::vector<float> qh(head_dim), kh(head_dim);
+            for (std::uint32_t i = 0; i < head_dim; ++i) {
+                qh[i] = qt[i] * qi * scale;
+                kh[i] = kt[i] * ki;
+            }
+            for (std::uint32_t i = 0; i < head_dim; ++i) {
+                const float decay = std::exp(gt[i]);
+                for (std::uint32_t j = 0; j < head_dim; ++j) {
+                    Sh[static_cast<std::size_t>(i) * head_dim + j] *= decay;
+                }
+            }
+            std::vector<float> u(head_dim), delta(head_dim);
+            for (std::uint32_t j = 0; j < head_dim; ++j) {
+                float acc = 0;
+                for (std::uint32_t i = 0; i < head_dim; ++i) {
+                    acc += Sh[static_cast<std::size_t>(i) * head_dim + j] * kh[i];
+                }
+                u[j] = acc;
+            }
+            for (std::uint32_t j = 0; j < head_dim; ++j) {
+                delta[j] = b * (vt[j] - u[j]);
+            }
+            for (std::uint32_t i = 0; i < head_dim; ++i) {
+                for (std::uint32_t j = 0; j < head_dim; ++j) {
+                    Sh[static_cast<std::size_t>(i) * head_dim + j] += kh[i] * delta[j];
+                }
+            }
+            for (std::uint32_t j = 0; j < head_dim; ++j) {
+                float acc = 0;
+                for (std::uint32_t i = 0; i < head_dim; ++i) {
+                    acc += Sh[static_cast<std::size_t>(i) * head_dim + j] * qh[i];
+                }
+                scan_out[h * head_dim + j] = acc;
+            }
+        }
+
+        // Upload the updated matrix state.
+        PinnedBuffer host_new_matrix = device.allocate_host(matrix_floats * 4);
+        std::memcpy(host_new_matrix.bytes().data(), S.data(), matrix_floats * 4);
+        auto up = stream.upload(state.matrix, host_new_matrix, matrix_floats * 4);
+        up.wait();
+    }
+
+    // ---- Stage 6: output-gate projections on the MME, gating on host ----
+    const std::vector<float> g_a_out = device_project(projections.g_a, w.g_a, x, hidden);
+    const std::vector<float> g2 = device_project(projections.g_b, w.g_b, g_a_out, head_dim);
+    std::vector<float> gated(d_inner);
+    for (std::uint32_t h = 0; h < heads; ++h) {
+        float mean = 0;
+        for (std::uint32_t i = 0; i < head_dim; ++i) {
+            const float v = scan_out[h * head_dim + i];
+            mean += v * v;
+        }
+        mean /= head_dim;
+        const float inverse = 1.0f / std::sqrt(mean + 1e-6f);
+        for (std::uint32_t i = 0; i < head_dim; ++i) {
+            const std::uint32_t idx = h * head_dim + i;
+            gated[idx] = scan_out[idx] * inverse * w.o_norm_w[i] * sigmoid(g2[idx]);
+        }
+    }
+
+    // ---- Stage 7: wo projection on the MME ----
+    const std::vector<float> block_out = device_project(projections.wo, w.wo, gated, d_inner);
+
+    // Round to BF16.
+    std::vector<std::uint16_t> result(hidden);
+    for (std::uint32_t i = 0; i < hidden; ++i) {
+        result[i] = float_to_bf16_word(block_out[i]);
+    }
+    return result;
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_block.h b/src/core/gaudi2/glm5_hpu_block.h
new file mode 100644
index 0000000..97e46a1
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_block.h
@@ -0,0 +1,104 @@
+#pragma once
+// GLM-5.3-Flash block execution on the Gaudi2 SynapseAI runtime adapter.
+//
+// This is the first HPU execution path for GLM: every matrix projection runs on the
+// MME through the closed Bf16Gemm recipe, with host-side elementwise work between
+// launches. All weight and activation traffic crosses PCIe; this is a correctness
+// baseline for the resource/ownership model, not a throughput path. Fully-device-
+// resident elementwise compositions (multi-node TPC graphs) are the follow-up.
+//
+// The math is identical to the CUDA executor (src/models/glm5/execution/block.cpp);
+// the fake_synapse lifecycle tests and the existing Bf16Gemm oracle cover the device
+// contract.
+
+#include "core/gaudi2/runtime.h"
+#include "ops/gaudi2/bf16_gemm.h"
+#include "core/gaudi2/block_fp8.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+// One KDA block's weight planes, pre-uploaded to device memory.
+struct Glm5KdaHpuWeights {
+    DeviceBuffer attn_norm;         // BF16 [hidden]
+    DeviceBuffer wq, wk, wv;       // BF16 [d_inner, hidden] (transposed for Bf16Gemm: [hidden, d_inner])
+    DeviceBuffer f_a;              // BF16 [head_dim, hidden] (transposed)
+    DeviceBuffer f_b;              // BF16 [d_inner, head_dim] (transposed)
+    DeviceBuffer beta;             // BF16 [heads, hidden] (transposed)
+    DeviceBuffer g_a;              // BF16 [head_dim, hidden] (transposed)
+    DeviceBuffer g_b;              // BF16 [d_inner, head_dim] (transposed)
+    DeviceBuffer wo;               // BF16 [hidden, d_inner] (transposed)
+    // Host-resident FP32 scalars (small; host math between GEMMs).
+    std::vector<float> dt_bias;    // [d_inner]
+    std::vector<float> a_log;      // [heads]
+    std::vector<float> o_norm_w;   // [head_dim]
+    std::vector<float> conv_q, conv_k, conv_v;  // [d_conv * d_inner] GGUF taps-fastest
+};
+
+// Per-sequence persistent state on the device.
+struct Glm5KdaHpuState {
+    DeviceBuffer conv_q, conv_k, conv_v;  // FP32 [d_conv-1, d_inner]
+    DeviceBuffer matrix;                  // FP32 [heads, head_dim, head_dim]
+};
+
+struct Glm5KdaHpuConfig {
+    std::uint32_t hidden, heads, head_dim, d_conv;
+    float rms_eps, gate_lower_bound;
+};
+
+// Uploads weight planes from host BF16 data (row-major [N, K] already transposed
+// to Bf16Gemm's expected [K, rows] layout). Each `w*_t` is the transposed weight.
+[[nodiscard]] Glm5KdaHpuWeights glm5_kda_hpu_upload_weights(
+    const Device& device,
+    std::span<const std::uint16_t> attn_norm,
+    std::span<const std::uint16_t> wq_t, std::span<const std::uint16_t> wk_t,
+    std::span<const std::uint16_t> wv_t,
+    std::span<const std::uint16_t> f_a_t, std::span<const std::uint16_t> f_b_t,
+    std::span<const std::uint16_t> beta_t,
+    std::span<const std::uint16_t> g_a_t, std::span<const std::uint16_t> g_b_t,
+    std::span<const std::uint16_t> wo_t,
+    std::span<const float> dt_bias, std::span<const float> a_log,
+    std::span<const float> o_norm_w,
+    std::span<const std::uint16_t> conv_q, std::span<const std::uint16_t> conv_k,
+    std::span<const std::uint16_t> conv_v);
+
+[[nodiscard]] Glm5KdaHpuState glm5_kda_hpu_init_state(
+    const Device& device, const Glm5KdaHpuConfig& config);
+
+// One single-token decode through the KDA block: RMSNorm (host) -> three
+// projections (MME) -> conv+SiLU (host) -> gate (host) -> delta recurrence
+// (host) -> output gate (host) -> wo (MME). Returns the block output
+// [hidden] BF16 words. All device traffic uses the runtime's DMA leases.
+// One static Bf16Gemm recipe per distinct projection shape: every matrix
+// multiply in the block runs on the MME (the early host-GEMV bridge is
+// gone). Recipes compile once per block instance.
+struct Glm5KdaHpuProjections {
+    Bf16Gemm wq, wk, wv;        // [1, d_inner, hidden]
+    Bf16Gemm f_a, g_a;          // [1, head_dim, hidden]
+    Bf16Gemm f_b, g_b;          // [1, d_inner, head_dim]
+    Bf16Gemm beta;              // [1, heads, hidden]
+    Bf16Gemm wo;                // [1, hidden, d_inner]
+
+    Glm5KdaHpuProjections(const Device& device, const Glm5KdaHpuConfig& config,
+                          std::size_t max_workspace_bytes);
+};
+
+[[nodiscard]] Glm5KdaHpuProjections glm5_kda_hpu_make_projections(
+    const Device& device, const Glm5KdaHpuConfig& config,
+    std::size_t max_workspace_bytes = 4096);
+
+[[nodiscard]] std::vector<std::uint16_t> glm5_kda_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5KdaHpuProjections& projections,
+    const Glm5KdaHpuWeights& w, Glm5KdaHpuState& state,
+    const Glm5KdaHpuConfig& config,
+    std::span<const std::uint16_t> hidden_in);
+
+// Scratch (pinned host) needed for one decode step.
+[[nodiscard]] std::size_t glm5_kda_hpu_scratch_bytes(
+    const Glm5KdaHpuConfig& config);
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_dsa.cpp b/src/core/gaudi2/glm5_hpu_dsa.cpp
new file mode 100644
index 0000000..0991837
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_dsa.cpp
@@ -0,0 +1,425 @@
+// GLM-5.3-Flash DSA block on the Gaudi2 runtime adapter. The math mirrors the
+// CUDA dsa_block_decode (block.cpp) with the same BF16 rounding boundaries;
+// the eight matrix projections run on the MME, everything else on the host.
+#include "core/gaudi2/glm5_hpu_dsa.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+namespace {
+
+float bf16_word_to_float(std::uint16_t word) {
+    const std::uint32_t wide = static_cast<std::uint32_t>(word) << 16;
+    float value;
+    std::memcpy(&value, &wide, 4);
+    return value;
+}
+
+std::uint16_t float_to_bf16_word(float value) {
+    std::uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return static_cast<std::uint16_t>(bits >> 16);
+}
+
+constexpr float kNegInf = -3.0e38f;
+
+std::vector<float> widen_bf16_payload(const void* payload, std::size_t elements) {
+    const auto* words = reinterpret_cast<const std::uint16_t*>(payload);
+    std::vector<float> out(elements);
+    for (std::size_t i = 0; i < elements; ++i) out[i] = bf16_word_to_float(words[i]);
+    return out;
+}
+
+} // namespace
+
+Glm5DsaHpuProjections::Glm5DsaHpuProjections(const Device& device,
+                                             const Glm5DsaHpuConfig& config,
+                                             std::size_t max_workspace_bytes)
+    : q_a{device, Bf16GemmShape{1, config.q_lora, config.hidden}, max_workspace_bytes},
+      q_b{device, Bf16GemmShape{1, config.heads * config.head_dim, config.q_lora},
+          max_workspace_bytes},
+      kv_a{device, Bf16GemmShape{1, config.kv_lora, config.hidden}, max_workspace_bytes},
+      iq_b{device,
+           Bf16GemmShape{1, config.index_heads * config.index_dim, config.q_lora},
+           max_workspace_bytes},
+      ik{device, Bf16GemmShape{1, config.index_dim, config.hidden}, max_workspace_bytes},
+      ig{device, Bf16GemmShape{1, config.index_dim, config.hidden}, max_workspace_bytes},
+      iproj{device, Bf16GemmShape{1, config.index_heads, config.hidden}, max_workspace_bytes},
+      wo{device, Bf16GemmShape{1, config.hidden, config.heads * config.v_head},
+         max_workspace_bytes} {}
+
+Glm5DsaHpuState glm5_dsa_hpu_init_state(const Device& device,
+                                        const Glm5DsaHpuConfig& config) {
+    Glm5DsaHpuState state;
+    // The history planes only ever expose rows [0, position]; every row is
+    // written before any read, so no zero-fill is needed (unlike the KDA
+    // recurrence whose carried state IS read before its first write).
+    state.latents = device.allocate_device(
+        static_cast<std::size_t>(config.max_positions) * config.kv_lora * 2);
+    state.ik_plane = device.allocate_device(
+        static_cast<std::size_t>(config.max_positions) * config.index_dim * 2);
+    state.ig_plane = device.allocate_device(
+        static_cast<std::size_t>(config.max_positions) * config.index_dim * 2);
+    return state;
+}
+
+std::size_t glm5_dsa_hpu_scratch_bytes(const Glm5DsaHpuConfig& config,
+                                       std::uint32_t position) {
+    const std::uint64_t hidden = config.hidden;
+    const std::uint64_t tokens = static_cast<std::uint64_t>(position) + 1;
+    const std::uint64_t completed = tokens / config.kpool;
+    const std::uint64_t width =
+        static_cast<std::uint64_t>(config.top_k / config.kpool) * config.kpool +
+        (config.kpool - 1);
+    return static_cast<std::size_t>(
+        hidden * 2 +                                        // normed input staging
+        static_cast<std::uint64_t>(config.heads) * config.head_dim * 2 +
+        static_cast<std::uint64_t>(config.heads) * config.kv_lora * 2 +
+        tokens * config.kv_lora * 2 +                       // latent history download
+        tokens * config.index_dim * 2 * 2 +                 // ik/ig history download
+        completed * config.index_dim * 4 +                  // pooled plane
+        completed * 4 +                                     // scores
+        width * 4 +                                         // cells
+        static_cast<std::uint64_t>(config.heads) * config.v_head * 2 +
+        4096);
+}
+
+std::vector<std::uint16_t> glm5_dsa_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5DsaHpuProjections& projections,
+    const Glm5DsaHpuWeights& w, Glm5DsaHpuState& state, const Glm5DsaHpuConfig& config,
+    std::span<const std::uint16_t> hidden_in, std::uint32_t position) {
+    const std::uint32_t hidden = config.hidden;
+    const std::uint32_t heads = config.heads;
+    const std::uint32_t nope = config.head_dim;
+    const std::uint32_t lora = config.kv_lora;
+    const std::uint32_t v_head = config.v_head;
+    const std::uint32_t ih = config.index_heads;
+    const std::uint32_t id = config.index_dim;
+    const std::uint32_t kpool = config.kpool;
+    if (hidden_in.size() != hidden) {
+        throw std::invalid_argument("glm5_dsa_hpu_decode_step: hidden_in size mismatch");
+    }
+    if (position >= config.max_positions) {
+        throw std::invalid_argument("glm5_dsa_hpu_decode_step: position exceeds plane capacity");
+    }
+
+    auto device_project = [&](Bf16Gemm& gemm, const DeviceBuffer& weight,
+                              const std::vector<float>& input,
+                              std::uint32_t in_cols) {
+        const std::uint32_t out_rows = static_cast<std::uint32_t>(gemm.shape().n);
+        PinnedBuffer host_in = device.allocate_host(in_cols * 2);
+        for (std::uint32_t i = 0; i < in_cols; ++i) {
+            const auto word = float_to_bf16_word(input[i]);
+            std::memcpy(host_in.bytes().data() + i * 2, &word, 2);
+        }
+        PinnedBuffer host_out = device.allocate_host(out_rows * 2);
+        DeviceBuffer dev_in = device.allocate_device(in_cols * 2);
+        DeviceBuffer dev_out = device.allocate_device(out_rows * 2);
+        auto up = stream.upload(dev_in, host_in, in_cols * 2);
+        up.wait();
+        auto compute = gemm.launch(stream, dev_in, const_cast<DeviceBuffer&>(weight), dev_out);
+        compute.wait();
+        auto down = stream.download(host_out, dev_out, out_rows * 2);
+        down.wait();
+        std::vector<float> result(out_rows);
+        const auto* words = reinterpret_cast<const std::uint16_t*>(host_out.bytes().data());
+        for (std::uint32_t r = 0; r < out_rows; ++r) {
+            result[r] = bf16_word_to_float(words[r]);
+        }
+        return result;
+    };
+    auto append_row = [&](DeviceBuffer& plane, const std::vector<float>& row,
+                          std::uint32_t row_elements) {
+        PinnedBuffer host = device.allocate_host(row_elements * 2);
+        for (std::uint32_t i = 0; i < row_elements; ++i) {
+            const auto word = float_to_bf16_word(row[i]);
+            std::memcpy(host.bytes().data() + i * 2, &word, 2);
+        }
+        const std::size_t offset = static_cast<std::size_t>(position) * row_elements * 2;
+        auto up = stream.upload(plane, host, row_elements * 2, offset);
+        up.wait();
+    };
+    auto download_rows = [&](const DeviceBuffer& plane, std::uint32_t rows,
+                             std::uint32_t row_elements) {
+        PinnedBuffer host = device.allocate_host(static_cast<std::size_t>(rows) * row_elements * 2);
+        auto down = stream.download(host, const_cast<DeviceBuffer&>(plane),
+                                    static_cast<std::size_t>(rows) * row_elements * 2);
+        down.wait();
+        return host;
+    };
+
+    // ---- Stage 1: RMSNorm on host ----
+    std::vector<float> x(hidden);
+    {
+        PinnedBuffer host_w = device.allocate_host(hidden * 2);
+        auto dl = stream.download(host_w, const_cast<DeviceBuffer&>(w.attn_norm), hidden * 2);
+        dl.wait();
+        const auto* words = reinterpret_cast<const std::uint16_t*>(host_w.bytes().data());
+        float square = 0;
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            const float v = bf16_word_to_float(hidden_in[i]);
+            square += v * v;
+        }
+        const float inverse =
+            1.0f / std::sqrt(square / hidden + config.rms_eps);
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            x[i] = bf16_word_to_float(hidden_in[i]) * inverse * bf16_word_to_float(words[i]);
+        }
+    }
+
+    // ---- Stage 2: q side projections (MME) + lora norms (host) ----
+    const std::vector<float> q_latent = device_project(projections.q_a, w.q_a, x, hidden);
+    std::vector<float> qn(config.q_lora);
+    {
+        float square = 0;
+        for (std::uint32_t i = 0; i < config.q_lora; ++i) square += q_latent[i] * q_latent[i];
+        const float inverse =
+            1.0f / std::sqrt(square / config.q_lora + config.rms_eps);
+        for (std::uint32_t i = 0; i < config.q_lora; ++i) {
+            // The CUDA path rounds the normed latent to BF16 before q_b; keep
+            // the FP32 value in flight and round at the MME input instead
+            // (device_project rounds) - same represented values.
+            qn[i] = q_latent[i] * inverse * w.q_a_norm[i];
+        }
+    }
+    const std::vector<float> q_heads =
+        device_project(projections.q_b, w.q_b, qn, config.q_lora);
+
+    // ---- Stage 3: kv side projection + latent row append ----
+    const std::vector<float> latent_raw = device_project(projections.kv_a, w.kv_a, x, hidden);
+    std::vector<float> latent(lora);
+    {
+        float square = 0;
+        for (std::uint32_t i = 0; i < lora; ++i) square += latent_raw[i] * latent_raw[i];
+        const float inverse = 1.0f / std::sqrt(square / lora + config.rms_eps);
+        for (std::uint32_t i = 0; i < lora; ++i) {
+            latent[i] = latent_raw[i] * inverse * w.kv_a_norm[i];
+        }
+    }
+    append_row(state.latents, latent, lora);
+
+    // ---- Stage 4: indexer projections (MME) + LayerNorm (host) + appends ----
+    const std::vector<float> iq = device_project(projections.iq_b, w.iq_b, qn, config.q_lora);
+    const std::vector<float> ik_raw = device_project(projections.ik, w.ik, x, hidden);
+    std::vector<float> ik_normed(id);
+    {
+        // LayerNorm over the key dim (eps 1e-6, the audited indexer constant).
+        double mean = 0;
+        for (std::uint32_t e = 0; e < id; ++e) mean += ik_raw[e];
+        mean /= id;
+        double variance = 0;
+        for (std::uint32_t e = 0; e < id; ++e) {
+            const double d = ik_raw[e] - mean;
+            variance += d * d;
+        }
+        variance /= id;
+        const float denom = static_cast<float>(1.0 / std::sqrt(variance + 1e-6));
+        const float mu = static_cast<float>(mean);
+        for (std::uint32_t e = 0; e < id; ++e) {
+            ik_normed[e] = (ik_raw[e] - mu) * denom * w.ik_ln_w[e] + w.ik_ln_b[e];
+        }
+    }
+    const std::vector<float> ig = device_project(projections.ig, w.ig, x, hidden);
+    append_row(state.ik_plane, ik_normed, id);
+    append_row(state.ig_plane, ig, id);
+
+    // ---- Stage 5: re-pool every completed pool over the device planes ----
+    const std::uint32_t tokens = position + 1;
+    const std::uint32_t completed = tokens / kpool;
+    std::vector<float> pooled;
+    if (completed > 0) {
+        auto ik_host = download_rows(state.ik_plane, completed * kpool, id);
+        auto ig_host = download_rows(state.ig_plane, completed * kpool, id);
+        const auto* ik_words =
+            reinterpret_cast<const std::uint16_t*>(ik_host.bytes().data());
+        const auto* ig_words =
+            reinterpret_cast<const std::uint16_t*>(ig_host.bytes().data());
+        pooled.assign(static_cast<std::size_t>(completed) * id, 0.0f);
+        for (std::uint32_t p = 0; p < completed; ++p) {
+            for (std::uint32_t e = 0; e < id; ++e) {
+                float logits[8];
+                float maximum = kNegInf;
+                for (std::uint32_t m = 0; m < kpool; ++m) {
+                    logits[m] =
+                        bf16_word_to_float(
+                            ig_words[static_cast<std::size_t>(p * kpool + m) * id + e]) +
+                        w.ape[m * id + e];
+                    if (m == 0 || logits[m] > maximum) maximum = logits[m];
+                }
+                float denominator = 0;
+                for (std::uint32_t m = 0; m < kpool; ++m) {
+                    logits[m] = std::exp(logits[m] - maximum);
+                    denominator += logits[m];
+                }
+                const float inverse = 1.0f / denominator;
+                float acc = 0;
+                for (std::uint32_t m = 0; m < kpool; ++m) {
+                    acc += logits[m] * inverse *
+                           bf16_word_to_float(
+                               ik_words[static_cast<std::size_t>(p * kpool + m) * id + e]);
+                }
+                pooled[p * id + e] = acc;
+            }
+        }
+    }
+
+    // ---- Stage 6: head weights (MME) + the 1/sqrt(dim*heads) scale ----
+    const std::vector<float> weights_raw =
+        device_project(projections.iproj, w.iproj, x, hidden);
+    std::vector<float> weights(ih);
+    {
+        const float scale =
+            std::sqrt(1.0f / (static_cast<float>(id) * ih));
+        for (std::uint32_t h = 0; h < ih; ++h) weights[h] = weights_raw[h] * scale;
+    }
+
+    // ---- Stage 7: score + select on host ----
+    const std::uint32_t top_pools = config.top_k / kpool;
+    const std::uint32_t width = top_pools * kpool + (kpool - 1);
+    std::vector<std::int32_t> cells(width, -1);
+    const std::uint32_t n_vis = completed;  // (position+1)/kpool == completed
+    if (completed > 0) {
+        std::vector<float> score(completed, 0.0f);
+        for (std::uint32_t p = 0; p < completed; ++p) {
+            float acc = 0;
+            for (std::uint32_t h = 0; h < ih; ++h) {
+                float dot = 0;
+                for (std::uint32_t e = 0; e < id; ++e) {
+                    dot += iq[h * id + e] * pooled[p * id + e];
+                }
+                acc += std::max(dot, 0.0f) * weights[h];
+            }
+            score[p] = acc;
+        }
+        // Stable descending selection: ties resolve to the lower pool index
+        // (the CUDA block argmax keeps the first strict maximum).
+        const std::uint32_t picks = std::min(top_pools, n_vis);
+        std::vector<bool> taken(completed, false);
+        for (std::uint32_t rank = 0; rank < picks; ++rank) {
+            std::uint32_t winner = 0;
+            float best = kNegInf;
+            for (std::uint32_t p = 0; p < completed; ++p) {
+                if (taken[p]) continue;
+                if (score[p] > best) {
+                    best = score[p];
+                    winner = p;
+                }
+            }
+            taken[winner] = true;
+            for (std::uint32_t m = 0; m < kpool; ++m) {
+                cells[rank * kpool + m] =
+                    static_cast<std::int32_t>(winner * kpool + m);
+            }
+        }
+        // The incomplete tail (cells n_vis*kpool .. position) fills after the
+        // selected pools; the query's own row is included (it sees itself).
+        for (std::uint32_t m = 0; m + 1 < kpool; ++m) {
+            const std::int32_t cell =
+                static_cast<std::int32_t>(n_vis * kpool + m);
+            cells[top_pools * kpool + m] =
+                cell <= static_cast<std::int32_t>(position) ? cell : -1;
+        }
+    } else {
+        // No completed pool: the selection row is tail-only.
+        for (std::uint32_t m = 0; m + 1 < kpool; ++m) {
+            const std::int32_t cell = static_cast<std::int32_t>(m);
+            cells[top_pools * kpool + m] =
+                cell <= static_cast<std::int32_t>(position) ? cell : -1;
+        }
+    }
+
+    // ---- Stage 8: absorb + attention on host ----
+    // q_abs[h, e] = sum_d q[h, d] * wk_b[d + nope*e + nope*lora*h] in FP32,
+    // rounded to BF16 before the attention (the CUDA host bridge contract).
+    std::vector<float> q_abs(static_cast<std::size_t>(heads) * lora);
+    for (std::uint32_t h = 0; h < heads; ++h) {
+        for (std::uint32_t e = 0; e < lora; ++e) {
+            float acc = 0;
+            for (std::uint32_t d = 0; d < nope; ++d) {
+                acc += q_heads[h * nope + d] *
+                       w.wk_b[static_cast<std::size_t>(d) + nope * e +
+                              static_cast<std::size_t>(nope) * lora * h];
+            }
+            q_abs[h * lora + e] = acc;
+        }
+    }
+    std::vector<float> q_abs_bf(static_cast<std::size_t>(heads) * lora);
+    for (std::size_t i = 0; i < q_abs.size(); ++i) {
+        q_abs_bf[i] = bf16_word_to_float(float_to_bf16_word(q_abs[i]));
+    }
+
+    auto latents_host = download_rows(state.latents, tokens, lora);
+    const auto* latent_words =
+        reinterpret_cast<const std::uint16_t*>(latents_host.bytes().data());
+    const float attn_scale = 1.0f / std::sqrt(static_cast<float>(nope));
+    std::vector<float> attn_out(static_cast<std::size_t>(heads) * v_head);
+    for (std::uint32_t h = 0; h < heads; ++h) {
+        // Scores over the selection row; softmax excludes -1 slots.
+        std::vector<float> logits(width, kNegInf);
+        bool any = false;
+        float maximum = 0.0f;
+        for (std::uint32_t s = 0; s < width; ++s) {
+            if (cells[s] < 0) continue;
+            const auto* row =
+                latent_words + static_cast<std::size_t>(cells[s]) * lora;
+            float dot = 0;
+            for (std::uint32_t e = 0; e < lora; ++e) {
+                dot += q_abs_bf[h * lora + e] * bf16_word_to_float(row[e]);
+            }
+            const float value = dot * attn_scale;
+            logits[s] = value;
+            if (!any || value > maximum) {
+                maximum = value;
+                any = true;
+            }
+        }
+        std::vector<float> prob(width, 0.0f);
+        float denominator = 0;
+        if (any) {
+            for (std::uint32_t s = 0; s < width; ++s) {
+                if (cells[s] < 0) continue;
+                prob[s] = std::exp(logits[s] - maximum);
+                denominator += prob[s];
+            }
+        } else {
+            denominator = 1.0f;  // the CUDA kernel guards sum>0 the same way
+        }
+        const float inverse = 1.0f / denominator;
+        // ctx[e] over valid slots, then out[h, v] = sum_c wv_b[c + lora*v +
+        // lora*v_head*h] * ctx[c].
+        std::vector<float> ctx(lora, 0.0f);
+        for (std::uint32_t s = 0; s < width; ++s) {
+            if (cells[s] < 0) continue;
+            const auto* row =
+                latent_words + static_cast<std::size_t>(cells[s]) * lora;
+            for (std::uint32_t e = 0; e < lora; ++e) {
+                ctx[e] += prob[s] * inverse * bf16_word_to_float(row[e]);
+            }
+        }
+        for (std::uint32_t v = 0; v < v_head; ++v) {
+            float acc = 0;
+            for (std::uint32_t c = 0; c < lora; ++c) {
+                acc += w.wv_b[static_cast<std::size_t>(c) + lora * v +
+                              static_cast<std::size_t>(lora) * v_head * h] *
+                       ctx[c];
+            }
+            attn_out[h * v_head + v] = acc;
+        }
+    }
+
+    // ---- Stage 9: wo projection on the MME ----
+    const std::vector<float> block_out =
+        device_project(projections.wo, w.wo, attn_out, heads * v_head);
+    std::vector<std::uint16_t> result(hidden);
+    for (std::uint32_t i = 0; i < hidden; ++i) {
+        result[i] = float_to_bf16_word(block_out[i]);
+    }
+    return result;
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_dsa.h b/src/core/gaudi2/glm5_hpu_dsa.h
new file mode 100644
index 0000000..54b22d7
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_dsa.h
@@ -0,0 +1,95 @@
+#pragma once
+// GLM-5.3-Flash DSA mixer block (NoPE MLA + k-pool indexer) on the Gaudi2
+// SynapseAI runtime adapter. Same contract as glm5_hpu_block.h: every matrix
+// projection rides the MME through closed Bf16Gemm recipes, the selection
+// chain and the absorbed attention run on the host between launches, and all
+// the elementwise math mirrors the CUDA executor (src/models/glm5/execution/
+// block.cpp) including its BF16 rounding boundaries.
+//
+// Persistent state (latents / indexer planes) lives in HBM; each decode step
+// appends the token's row and re-pools every completed pool over the device
+// plane, exactly like the CUDA decode path.
+
+#include "core/gaudi2/runtime.h"
+#include "ops/gaudi2/bf16_gemm.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+struct Glm5DsaHpuConfig {
+    std::uint32_t hidden;
+    std::uint32_t heads, head_dim;            // head_dim = qk_nope
+    std::uint32_t q_lora, kv_lora, v_head;
+    std::uint32_t index_heads, index_dim, kpool, top_k;
+    std::uint32_t max_positions;              // capacity of the history planes
+    float rms_eps;
+};
+
+// HBM-resident history: this token's latent row and indexer rows are appended
+// each step; the selection chain reads them back.
+struct Glm5DsaHpuState {
+    DeviceBuffer latents;   // BF16 [max_positions * kv_lora]
+    DeviceBuffer ik_plane;  // BF16 [max_positions * index_dim]
+    DeviceBuffer ig_plane;  // BF16 [max_positions * index_dim]
+};
+
+// Device-resident projection planes plus the host-side operands of the host
+// math (absorb weights, LayerNorm parameters, ape, norm gammas).
+struct Glm5DsaHpuWeights {
+    DeviceBuffer attn_norm;   // BF16 [hidden]
+    DeviceBuffer q_a;         // BF16 [q_lora, hidden]
+    DeviceBuffer q_b;         // BF16 [heads*head_dim, q_lora]
+    DeviceBuffer kv_a;        // BF16 [kv_lora, hidden]
+    DeviceBuffer iq_b;        // BF16 [index_heads*index_dim, q_lora]
+    DeviceBuffer ik;          // BF16 [index_dim, hidden]
+    DeviceBuffer ig;          // BF16 [index_dim, hidden]
+    DeviceBuffer iproj;       // BF16 [index_heads, hidden]
+    DeviceBuffer wo;          // BF16 [hidden, heads*v_head]
+    // Host-resident planes (small; host math between GEMMs).
+    std::vector<float> q_a_norm;   // BF16-represented gamma [q_lora]
+    std::vector<float> kv_a_norm;  // BF16-represented gamma [kv_lora]
+    std::vector<float> wk_b;       // GGUF {head_dim, kv_lora, heads}, BF16 values
+    std::vector<float> wv_b;       // GGUF {kv_lora, v_head, heads}, BF16 values
+    std::vector<float> ik_ln_w;    // LayerNorm gamma [index_dim], BF16 values
+    std::vector<float> ik_ln_b;    // LayerNorm beta [index_dim], BF16 values
+    std::vector<float> ape;        // FP32 [kpool * index_dim]
+};
+
+// One static Bf16Gemm recipe per projection shape; the expert-free DSA chain
+// needs nine distinct GEMMs (q_a, q_b, kv_a, iq_b, ik, ig, iproj, wo).
+struct Glm5DsaHpuProjections {
+    Bf16Gemm q_a;    // [1, q_lora, hidden]
+    Bf16Gemm q_b;    // [1, heads*head_dim, q_lora]
+    Bf16Gemm kv_a;   // [1, kv_lora, hidden]
+    Bf16Gemm iq_b;   // [1, index_heads*index_dim, q_lora]
+    Bf16Gemm ik;     // [1, index_dim, hidden]
+    Bf16Gemm ig;     // [1, index_dim, hidden]
+    Bf16Gemm iproj;  // [1, index_heads, hidden]
+    Bf16Gemm wo;     // [1, hidden, heads*v_head]
+
+    Glm5DsaHpuProjections(const Device& device, const Glm5DsaHpuConfig& config,
+                          std::size_t max_workspace_bytes = 4096);
+};
+
+[[nodiscard]] Glm5DsaHpuState glm5_dsa_hpu_init_state(const Device& device,
+                                                      const Glm5DsaHpuConfig& config);
+
+// One token through the DSA block: RMSNorm (host) -> q_a/norm/q_b (MME) ->
+// absorb (host) -> kv_a/norm + latent row append -> indexer projections
+// (MME) + LayerNorm (host) + row appends -> re-pool (host over the device
+// plane) -> head weights (MME + host scale) -> score/select/attend (host) ->
+// wo (MME). Returns the block output [hidden] BF16 words.
+[[nodiscard]] std::vector<std::uint16_t> glm5_dsa_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5DsaHpuProjections& projections,
+    const Glm5DsaHpuWeights& w, Glm5DsaHpuState& state, const Glm5DsaHpuConfig& config,
+    std::span<const std::uint16_t> hidden_in, std::uint32_t position);
+
+// Scratch (pinned host) needed for one decode step at `position`.
+[[nodiscard]] std::size_t glm5_dsa_hpu_scratch_bytes(const Glm5DsaHpuConfig& config,
+                                                     std::uint32_t position);
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_mlp.cpp b/src/core/gaudi2/glm5_hpu_mlp.cpp
new file mode 100644
index 0000000..9ac8133
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_mlp.cpp
@@ -0,0 +1,223 @@
+// GLM-5.3-Flash FFN half on the Gaudi2 runtime adapter. The math mirrors the
+// CUDA dense_mlp_decode / moe_block_decode: projections on the MME, the
+// clamped SwiGLU / noaux_tc router / combine on the host between launches.
+#include "core/gaudi2/glm5_hpu_mlp.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+namespace {
+
+float bf16_word_to_float(std::uint16_t word) {
+    const std::uint32_t wide = static_cast<std::uint32_t>(word) << 16;
+    float value;
+    std::memcpy(&value, &wide, 4);
+    return value;
+}
+
+std::uint16_t float_to_bf16_word(float value) {
+    std::uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return static_cast<std::uint16_t>(bits >> 16);
+}
+
+float sigmoid(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+
+// The audited clamped SwiGLU: gate upper-clamped only, up clamped both sides,
+// evaluated FP32 with a BF16 output boundary (the CUDA kernel contract).
+float swiglu(float gate, float up, float limit) {
+    const float g = std::min(gate, limit);
+    const float u = std::max(-limit, std::min(up, limit));
+    return g * sigmoid(g) * u;
+}
+
+} // namespace
+
+Glm5MlpHpuProjections::Glm5MlpHpuProjections(const Device& device,
+                                             const Glm5MlpHpuConfig& config,
+                                             std::size_t max_workspace_bytes)
+    : gate{device, Bf16GemmShape{1, config.ffn, config.hidden}, max_workspace_bytes},
+      up{device, Bf16GemmShape{1, config.ffn, config.hidden}, max_workspace_bytes},
+      down{device, Bf16GemmShape{1, config.hidden, config.ffn}, max_workspace_bytes},
+      router{device, Bf16GemmShape{1, std::max(config.experts, 1u), config.hidden},
+             max_workspace_bytes},
+      shared_gate{device, Bf16GemmShape{1, config.ffn, config.hidden}, max_workspace_bytes},
+      shared_up{device, Bf16GemmShape{1, config.ffn, config.hidden}, max_workspace_bytes},
+      shared_down{device, Bf16GemmShape{1, config.hidden, config.ffn},
+                  max_workspace_bytes} {}
+
+std::size_t glm5_mlp_hpu_scratch_bytes(const Glm5MlpHpuConfig& config) {
+    const std::uint64_t h = config.hidden;
+    const std::uint64_t f = config.ffn;
+    std::uint64_t bytes = h * 2 + h * 2 + f * 2 * 3 + 16 * 1024;
+    if (config.is_moe()) {
+        bytes += static_cast<std::uint64_t>(config.experts) * 2 +
+                 static_cast<std::uint64_t>(config.top_k) * (h * 2 + 4 + 4) +
+                 static_cast<std::uint64_t>(config.top_k) * 4;
+    }
+    return static_cast<std::size_t>(bytes);
+}
+
+std::vector<std::uint16_t> glm5_mlp_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5MlpHpuProjections& projections,
+    const Glm5MlpHpuWeights& w, const Glm5MlpHpuConfig& config,
+    std::span<const std::uint16_t> hidden_in) {
+    const std::uint32_t hidden = config.hidden;
+    const std::uint32_t ffn = config.ffn;
+    if (hidden_in.size() != hidden) {
+        throw std::invalid_argument("glm5_mlp_hpu_decode_step: hidden_in size mismatch");
+    }
+
+    auto device_project = [&](Bf16Gemm& gemm, const DeviceBuffer& weight,
+                              std::uint64_t weight_offset,
+                              const std::vector<float>& input,
+                              std::uint32_t in_cols) {
+        const std::uint32_t out_rows = static_cast<std::uint32_t>(gemm.shape().n);
+        PinnedBuffer host_in = device.allocate_host(in_cols * 2);
+        for (std::uint32_t i = 0; i < in_cols; ++i) {
+            const auto word = float_to_bf16_word(input[i]);
+            std::memcpy(host_in.bytes().data() + i * 2, &word, 2);
+        }
+        PinnedBuffer host_out = device.allocate_host(out_rows * 2);
+        DeviceBuffer dev_in = device.allocate_device(in_cols * 2);
+        DeviceBuffer dev_out = device.allocate_device(out_rows * 2);
+        auto up = stream.upload(dev_in, host_in, in_cols * 2);
+        up.wait();
+        auto compute = gemm.launch(stream, dev_in, const_cast<DeviceBuffer&>(weight),
+                                   dev_out, weight_offset);
+        compute.wait();
+        auto down = stream.download(host_out, dev_out, out_rows * 2);
+        down.wait();
+        std::vector<float> result(out_rows);
+        const auto* words = reinterpret_cast<const std::uint16_t*>(host_out.bytes().data());
+        for (std::uint32_t r = 0; r < out_rows; ++r) {
+            result[r] = bf16_word_to_float(words[r]);
+        }
+        return result;
+    };
+    // The dense SwiGLU chain: gate/up on the MME, activation on the host, down
+    // on the MME. Routed experts bind their row blocks by offset; the shared
+    // expert binds its own planes at offset 0.
+    auto swiglu_expert = [&](Bf16Gemm& gate_gemm, Bf16Gemm& up_gemm, Bf16Gemm& down_gemm,
+                             const DeviceBuffer& gate_w, const DeviceBuffer& up_w,
+                             const DeviceBuffer& down_w,
+                             std::uint64_t gate_off, std::uint64_t up_off,
+                             std::uint64_t down_off,
+                             const std::vector<float>& normed) {
+        const std::vector<float> g =
+            device_project(gate_gemm, gate_w, gate_off, normed, hidden);
+        const std::vector<float> u =
+            device_project(up_gemm, up_w, up_off, normed, hidden);
+        std::vector<float> activated(ffn);
+        for (std::uint32_t i = 0; i < ffn; ++i) {
+            activated[i] = bf16_word_to_float(
+                float_to_bf16_word(swiglu(g[i], u[i], config.swiglu_limit)));
+        }
+        return device_project(down_gemm, down_w, down_off, activated, ffn);
+    };
+
+    // ---- Stage 1: RMSNorm on host ----
+    std::vector<float> normed(hidden);
+    {
+        PinnedBuffer host_w = device.allocate_host(hidden * 2);
+        auto dl = stream.download(host_w, const_cast<DeviceBuffer&>(w.ffn_norm), hidden * 2);
+        dl.wait();
+        const auto* words = reinterpret_cast<const std::uint16_t*>(host_w.bytes().data());
+        float square = 0;
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            const float v = bf16_word_to_float(hidden_in[i]);
+            square += v * v;
+        }
+        const float inverse = 1.0f / std::sqrt(square / hidden + config.rms_eps);
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            normed[i] = bf16_word_to_float(hidden_in[i]) * inverse *
+                        bf16_word_to_float(words[i]);
+        }
+    }
+
+    if (!config.is_moe()) {
+        // ---- Dense path ----
+        const std::vector<float> block_out =
+            swiglu_expert(projections.gate, projections.up, projections.down,
+                          w.gate, w.up, w.down, 0, 0, 0, normed);
+        std::vector<std::uint16_t> result(hidden);
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            result[i] = float_to_bf16_word(block_out[i]);
+        }
+        return result;
+    }
+
+    // ---- MoE path ----
+    const std::uint32_t experts = config.experts;
+    const std::uint32_t top_k = config.top_k;
+
+    // Router on the MME (BF16 logits), the noaux_tc selection on the host:
+    // score = sigmoid(logit); ranks by score + bias with ties to the lower
+    // expert; the ORIGINAL scores are normalized and scaled.
+    const std::vector<float> logits = device_project(
+        projections.router, w.router, 0, normed, hidden);
+    std::vector<float> score(experts);
+    for (std::uint32_t e = 0; e < experts; ++e) score[e] = sigmoid(logits[e]);
+    std::vector<float> weights(top_k, 0.0f);
+    std::vector<std::uint32_t> selected(top_k, 0x7fffffffu);
+    {
+        std::vector<float> ranking(experts);
+        for (std::uint32_t e = 0; e < experts; ++e) ranking[e] = score[e] + w.router_bias[e];
+        std::vector<bool> taken(experts, false);
+        for (std::uint32_t rank = 0; rank < top_k; ++rank) {
+            std::uint32_t winner = 0;
+            float best = -3.0e38f;
+            for (std::uint32_t e = 0; e < experts; ++e) {
+                if (taken[e]) continue;
+                if (ranking[e] > best) {
+                    best = ranking[e];
+                    winner = e;
+                }
+            }
+            taken[winner] = true;
+            selected[rank] = winner;
+            weights[rank] = score[winner];
+        }
+        float sum = 0;
+        for (std::uint32_t i = 0; i < top_k; ++i) sum += weights[i];
+        const float inverse = config.routed_scaling_factor / (sum + 1e-20f);
+        for (std::uint32_t i = 0; i < top_k; ++i) weights[i] *= inverse;
+    }
+
+    // Selected experts sequentially through the shared recipes.
+    std::vector<std::vector<float>> stacked(top_k);
+    for (std::uint32_t slot = 0; slot < top_k; ++slot) {
+        const std::uint32_t expert = selected[slot];
+        if (expert >= experts) {
+            stacked[slot].assign(hidden, 0.0f);
+            continue;
+        }
+        stacked[slot] = swiglu_expert(projections.gate, projections.up, projections.down,
+                                      w.gate_exps_plane, w.up_exps_plane,
+                                      w.down_exps_plane,
+                                      w.expert_gate_offset[expert],
+                                      w.expert_up_offset[expert],
+                                      w.expert_down_offset[expert], normed);
+    }
+
+    // Shared expert (unweighted) plus the weighted routed combine.
+    const std::vector<float> shared = swiglu_expert(
+        projections.shared_gate, projections.shared_up, projections.shared_down,
+        w.gate, w.up, w.down, 0, 0, 0, normed);
+    std::vector<std::uint16_t> result(hidden);
+    for (std::uint32_t i = 0; i < hidden; ++i) {
+        float acc = shared[i];
+        for (std::uint32_t slot = 0; slot < top_k; ++slot) {
+            acc += weights[slot] * stacked[slot][i];
+        }
+        result[i] = float_to_bf16_word(acc);
+    }
+    return result;
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_mlp.h b/src/core/gaudi2/glm5_hpu_mlp.h
new file mode 100644
index 0000000..680021a
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_mlp.h
@@ -0,0 +1,75 @@
+#pragma once
+// GLM-5.3-Flash FFN half (dense MLP and MoE blocks) on the Gaudi2 SynapseAI
+// runtime adapter. Same contract as the other HPU block executors: matrix
+// projections on the MME through closed Bf16Gemm recipes, the clamped
+// SwiGLU / router / combine math on the host between launches, mirroring the
+// CUDA executors (src/models/glm5/execution/block.cpp) with the same BF16
+// rounding boundaries.
+//
+// MoE weight residency: every expert's gate/up/down row block is uploaded as
+// its own DeviceBuffer at bind time (the same total bytes as the stacked
+// plane, but bindable per expert - Bf16Gemm binds whole buffers, and slicing
+// the plane would need per-launch staging copies of every selected expert).
+
+#include "core/gaudi2/runtime.h"
+#include "ops/gaudi2/bf16_gemm.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+struct Glm5MlpHpuConfig {
+    std::uint32_t hidden;
+    std::uint32_t ffn;              // per-expert / dense intermediate width
+    std::uint32_t experts = 0;      // 0 => dense block
+    std::uint32_t top_k = 0;
+    float rms_eps;
+    float swiglu_limit;
+    float routed_scaling_factor = 1.0f;
+
+    [[nodiscard]] bool is_moe() const noexcept { return experts > 0; }
+};
+
+struct Glm5MlpHpuWeights {
+    DeviceBuffer ffn_norm;          // BF16 [hidden]
+    // Dense (and the MoE router / shared expert) planes.
+    DeviceBuffer gate, up, down;    // dense: [ffn, hidden] / [ffn, hidden] / [hidden, ffn]
+    DeviceBuffer router;            // MoE: BF16 [experts, hidden]
+    // Routed experts bind their row blocks of the stacked planes by byte
+    // offset (review S4): no per-expert copies, the planes hold HBM once
+    // through load AND steady state.
+    DeviceBuffer gate_exps_plane, up_exps_plane, down_exps_plane;
+    std::vector<std::uint64_t> expert_gate_offset;  // [experts] bytes into gate_exps_plane
+    std::vector<std::uint64_t> expert_up_offset;    // [experts] bytes into up_exps_plane
+    std::vector<std::uint64_t> expert_down_offset;  // [experts] bytes into down_exps_plane
+    // Host-resident router correction bias, FP32 [experts] (noaux_tc).
+    std::vector<float> router_bias;
+};
+
+// Dense and MoE share the recipe set: the routed experts reuse the dense
+// shapes (every expert row block is [ffn, hidden] / [hidden, ffn]).
+struct Glm5MlpHpuProjections {
+    Bf16Gemm gate, up;      // [1, ffn, hidden]
+    Bf16Gemm down;          // [1, hidden, ffn]
+    Bf16Gemm router;        // [1, experts, hidden] (unused when dense)
+    Bf16Gemm shared_gate, shared_up;   // [1, ffn, hidden] (MoE shared expert)
+    Bf16Gemm shared_down;              // [1, hidden, ffn]
+
+    Glm5MlpHpuProjections(const Device& device, const Glm5MlpHpuConfig& config,
+                          std::size_t max_workspace_bytes = 4096);
+};
+
+// One token through the FFN half: RMSNorm (host) -> the dense or routed
+// SwiGLU chain -> the block output [hidden] BF16 words.
+[[nodiscard]] std::vector<std::uint16_t> glm5_mlp_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5MlpHpuProjections& projections,
+    const Glm5MlpHpuWeights& w, const Glm5MlpHpuConfig& config,
+    std::span<const std::uint16_t> hidden_in);
+
+// Scratch (pinned host) needed for one decode step.
+[[nodiscard]] std::size_t glm5_mlp_hpu_scratch_bytes(const Glm5MlpHpuConfig& config);
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_model.cpp b/src/core/gaudi2/glm5_hpu_model.cpp
new file mode 100644
index 0000000..5cabd12
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_model.cpp
@@ -0,0 +1,528 @@
+// GLM-5.3-Flash full-model HPU executor. The math mirrors the CUDA
+// decode_step; projections run on the MME via per-shape Bf16Gemm sets, and
+// the elementwise chains use the same audited host formulas. Both mixer kinds
+// (KDA, DSA) and both FFN kinds (dense, MoE) dispatch to their block
+// executors; every layer runs its attention half then its FFN half through
+// the mHC residual, exactly like the CUDA assembly.
+//
+// Weight traffic: every projection plane was uploaded exactly once by the
+// loader into the Glm5HpuWeightPlanes registry; this executor binds those
+// resident DeviceBuffers (no re-upload, no host alias reads of device
+// addresses). Host-math operands were DMA-downloaded once at bind time; the
+// embedding gather is a one-row DMA read per step.
+#include "core/gaudi2/glm5_hpu_model.h"
+
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+namespace {
+
+float bf16_word_to_float(std::uint16_t word) {
+    const std::uint32_t wide = static_cast<std::uint32_t>(word) << 16;
+    float value;
+    std::memcpy(&value, &wide, 4);
+    return value;
+}
+
+std::uint16_t float_to_bf16_word(float value) {
+    std::uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return static_cast<std::uint16_t>(bits >> 16);
+}
+
+float sigmoid(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+
+// The mHC site computation for one token (the audited math: 24 mixes,
+// pre/post gates, 20-round Sinkhorn comb, collapsed). All operands are the
+// bind-time host caches.
+struct MhcSite {
+    std::vector<float> pre, post, comb, collapsed;
+};
+
+MhcSite mhc_site(const std::vector<float>& residual,
+                 const std::vector<std::uint16_t>& fn_words,
+                 const std::vector<float>& base, const std::vector<float>& scale,
+                 std::uint32_t hidden, float rms_eps) {
+    constexpr std::uint32_t hc = 4;
+    const std::uint32_t plane = hc * hidden;
+    const float hc_eps = 1e-6f;
+
+    double square = 0;
+    for (std::uint32_t i = 0; i < plane; ++i) {
+        square += static_cast<double>(residual[i]) * residual[i];
+    }
+    const float inv = static_cast<float>(1.0 / std::sqrt(square / plane + rms_eps));
+
+    std::vector<float> mixes(24);
+    for (std::uint32_t lane = 0; lane < 24; ++lane) {
+        double dot = 0;
+        for (std::uint32_t i = 0; i < plane; ++i) {
+            dot += static_cast<double>(bf16_word_to_float(
+                       fn_words[static_cast<std::size_t>(lane) * plane + i])) *
+                   residual[i] * inv;
+        }
+        mixes[lane] = static_cast<float>(dot);
+    }
+
+    MhcSite site;
+    site.pre.resize(4);
+    site.post.resize(4);
+    for (std::uint32_t n = 0; n < 4; ++n) {
+        site.pre[n] = sigmoid(mixes[n] * scale[0] + base[n]) + hc_eps;
+        site.post[n] = sigmoid(mixes[4 + n] * scale[1] + base[4 + n]) * 2.0f;
+    }
+
+    site.comb.assign(16, 0.0f);
+    for (std::uint32_t s = 0; s < 4; ++s) {
+        float max_v = -3.402823466e+38f;
+        for (std::uint32_t d = 0; d < 4; ++d) {
+            const float raw = mixes[8 + d + 4 * s] * scale[2] + base[8 + d + 4 * s];
+            site.comb[s * 4 + d] = raw;
+            max_v = std::max(max_v, raw);
+        }
+        float sum = 0;
+        for (std::uint32_t d = 0; d < 4; ++d) {
+            site.comb[s * 4 + d] = std::exp(site.comb[s * 4 + d] - max_v);
+            sum += site.comb[s * 4 + d];
+        }
+        for (std::uint32_t d = 0; d < 4; ++d) site.comb[s * 4 + d] /= sum + hc_eps;
+    }
+    for (std::uint32_t iter = 0; iter < 20; ++iter) {
+        if (iter > 0) {
+            for (std::uint32_t s = 0; s < 4; ++s) {
+                float sum = 0;
+                for (std::uint32_t d = 0; d < 4; ++d) sum += site.comb[s * 4 + d];
+                for (std::uint32_t d = 0; d < 4; ++d) {
+                    site.comb[s * 4 + d] /= sum + hc_eps;
+                }
+            }
+        }
+        for (std::uint32_t d = 0; d < 4; ++d) {
+            float sum = 0;
+            for (std::uint32_t s = 0; s < 4; ++s) sum += site.comb[s * 4 + d];
+            for (std::uint32_t s = 0; s < 4; ++s) {
+                site.comb[s * 4 + d] /= sum + hc_eps;
+            }
+        }
+    }
+
+    site.collapsed.assign(hidden, 0.0f);
+    for (std::uint32_t n = 0; n < hc; ++n) {
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            site.collapsed[i] += site.pre[n] * residual[n * hidden + i];
+        }
+    }
+    return site;
+}
+
+void mhc_post(const MhcSite& site, const std::vector<float>& block,
+              std::vector<float>& residual, std::uint32_t hidden) {
+    constexpr std::uint32_t hc = 4;
+    const std::vector<float> saved = residual;
+    for (std::uint32_t dst = 0; dst < hc; ++dst) {
+        for (std::uint32_t i = 0; i < hidden; ++i) {
+            float acc = site.post[dst] * block[i];
+            for (std::uint32_t src = 0; src < hc; ++src) {
+                acc += site.comb[src * 4 + dst] * saved[src * hidden + i];
+            }
+            residual[dst * hidden + i] = acc;
+        }
+    }
+}
+
+} // namespace
+
+Glm5HpuModel::Glm5HpuModel(const Device& device,
+                           const models::glm5::execution::Glm5StepConfig& config,
+                           std::size_t max_workspace_bytes, std::uint32_t positions)
+    : lm_head(device, Bf16GemmShape{1, config.vocab_size, config.hidden},
+              max_workspace_bytes),
+      hidden(config.hidden), layers(static_cast<std::uint32_t>(config.layer_is_dsa.size())),
+      kda_heads(config.kda_heads), kda_head_dim(config.kda_head_dim),
+      max_positions(positions) {
+    const std::uint32_t d_inner = config.kda_heads * config.kda_head_dim;
+
+    for (std::uint32_t layer = 0; layer < layers; ++layer) {
+        if (!config.layer_is_dsa[layer]) {
+            Glm5KdaHpuConfig block_config{config.hidden, config.kda_heads,
+                                          config.kda_head_dim, 4,
+                                          config.rms_eps, config.gate_lower_bound};
+            kda_projections.push_back(
+                Glm5KdaHpuProjections(device, block_config, max_workspace_bytes));
+            kda_layer_indices.push_back(layer);
+
+            auto zero = [&](std::size_t bytes) {
+                PinnedBuffer z = device.allocate_host(bytes);
+                std::memset(z.bytes().data(), 0, bytes);
+                DeviceBuffer d = device.allocate_device(bytes);
+                auto t = device.create_stream().upload(d, z, bytes);
+                t.wait();
+                return d;
+            };
+            Glm5KdaHpuState state;
+            state.conv_q = zero(3 * static_cast<std::size_t>(d_inner) * 4);
+            state.conv_k = zero(3 * static_cast<std::size_t>(d_inner) * 4);
+            state.conv_v = zero(3 * static_cast<std::size_t>(d_inner) * 4);
+            state.matrix = zero(static_cast<std::size_t>(config.kda_heads) *
+                                config.kda_head_dim * config.kda_head_dim * 4);
+            kda_state.push_back(std::move(state));
+        } else {
+            Glm5DsaHpuConfig block_config{};
+            block_config.hidden = config.hidden;
+            block_config.heads = config.heads;
+            block_config.head_dim = config.head_dim;
+            block_config.q_lora = config.q_lora;
+            block_config.kv_lora = config.kv_lora;
+            block_config.v_head = config.v_head;
+            block_config.index_heads = config.index_heads;
+            block_config.index_dim = config.index_dim;
+            block_config.kpool = config.kpool;
+            block_config.top_k = config.top_k;
+            block_config.max_positions = max_positions;
+            block_config.rms_eps = config.rms_eps;
+            dsa_projections.push_back(
+                Glm5DsaHpuProjections(device, block_config, max_workspace_bytes));
+            dsa_layer_indices.push_back(layer);
+            dsa_state.push_back(glm5_dsa_hpu_init_state(device, block_config));
+        }
+
+        Glm5MlpHpuConfig mlp_config{};
+        mlp_config.hidden = config.hidden;
+        mlp_config.rms_eps = config.rms_eps;
+        mlp_config.swiglu_limit = config.swiglu_limit;
+        if (config.layer_mlp_dense[layer]) {
+            mlp_config.ffn = config.ffn_dense;
+        } else {
+            mlp_config.ffn = config.ffn_moe;
+            mlp_config.experts = config.experts;
+            mlp_config.top_k = config.num_experts_per_tok;
+            mlp_config.routed_scaling_factor = config.routed_scaling_factor;
+        }
+        mlp_projections.push_back(
+            Glm5MlpHpuProjections(device, mlp_config, max_workspace_bytes));
+    }
+}
+
+void Glm5HpuModel::upload_weights(
+    const Device& device, Stream& stream, Glm5HpuWeightPlanes& weight_planes,
+    const models::glm5::execution::Glm5ModelWeights& weights,
+    const models::glm5::execution::Glm5StepConfig& config) {
+    planes = &weight_planes;
+    auto bind = [&](const ninfer::Weight& w) { return &weight_planes.bind(w.payload); };
+    auto download_f32 = [&](const void* payload, std::size_t elements) {
+        auto raw = weight_planes.download(device, stream, payload, elements * 4);
+        std::vector<float> out(elements);
+        std::memcpy(out.data(), raw.data(), elements * 4);
+        return out;
+    };
+
+    // ---- Head caches: mHC planes, final norm gamma, lm_head plane ----
+    hc_attn_fn_words.resize(layers);
+    hc_ffn_fn_words.resize(layers);
+    hc_attn_base.resize(layers);
+    hc_attn_scale.resize(layers);
+    hc_ffn_base.resize(layers);
+    hc_ffn_scale.resize(layers);
+    for (std::uint32_t layer = 0; layer < layers; ++layer) {
+        const auto& lw = weights.layers[layer];
+        hc_attn_fn_words[layer] = weight_planes.download_bf16_words(
+            device, stream, lw.hc_attn_fn.payload,
+            static_cast<std::size_t>(24) * 4 * config.hidden);
+        hc_ffn_fn_words[layer] = weight_planes.download_bf16_words(
+            device, stream, lw.hc_ffn_fn.payload,
+            static_cast<std::size_t>(24) * 4 * config.hidden);
+        hc_attn_base[layer] = download_f32(lw.hc_attn_base.payload, 24);
+        hc_attn_scale[layer] = download_f32(lw.hc_attn_scale.payload, 3);
+        hc_ffn_base[layer] = download_f32(lw.hc_ffn_base.payload, 24);
+        hc_ffn_scale[layer] = download_f32(lw.hc_ffn_scale.payload, 3);
+    }
+    output_norm_words = weight_planes.download_bf16_words(
+        device, stream, weights.output_norm.payload, config.hidden);
+    lm_head_plane = bind(weights.lm_head);
+
+    // ---- Per-layer mixer weights ----
+    const std::uint32_t di = config.kda_heads * config.kda_head_dim;
+    std::size_t kda_idx = 0, dsa_idx = 0;
+    for (std::uint32_t layer = 0; layer < layers; ++layer) {
+        if (!config.layer_is_dsa[layer]) {
+            const auto& kw = weights.layers[layer].kda;
+            Glm5KdaHpuWeights hw;
+            hw.attn_norm = *bind(kw.attn_norm);
+            hw.wq = *bind(kw.wq);
+            hw.wk = *bind(kw.wk);
+            hw.wv = *bind(kw.wv);
+            hw.f_a = *bind(kw.f_a);
+            hw.f_b = *bind(kw.f_b);
+            hw.beta = *bind(kw.beta);
+            hw.g_a = *bind(kw.g_a);
+            hw.g_b = *bind(kw.g_b);
+            hw.wo = *bind(kw.wo);
+
+            const auto& scalars = weights.kda_scalars[kda_idx];
+            // dt_bias is the GGUF's BF16 plane (the walk binds it through a
+            // BF16 view); a_log/o_norm_w are FP32 planes.
+            hw.dt_bias = weight_planes.download_bf16(device, stream,
+                                                     scalars.dt_bias, di);
+            hw.a_log = download_f32(scalars.a_log, config.kda_heads);
+            hw.o_norm_w = download_f32(scalars.o_norm_w, config.kda_head_dim);
+            hw.conv_q = weight_planes.download_bf16(device, stream,
+                                                    kw.conv_q.payload, 4 * di);
+            hw.conv_k = weight_planes.download_bf16(device, stream,
+                                                    kw.conv_k.payload, 4 * di);
+            hw.conv_v = weight_planes.download_bf16(device, stream,
+                                                    kw.conv_v.payload, 4 * di);
+            kda_weights.push_back(std::move(hw));
+            ++kda_idx;
+        } else {
+            const auto& dw = weights.layers[layer].dsa;
+            const std::uint32_t heads = config.heads;
+            const std::uint32_t nope = config.head_dim;
+            const std::uint32_t lora = config.kv_lora;
+            const std::uint32_t v_head = config.v_head;
+            const std::uint32_t id = config.index_dim;
+            Glm5DsaHpuWeights hw;
+            hw.attn_norm = *bind(dw.attn_norm);
+            hw.q_a = *bind(dw.q_a);
+            hw.q_b = *bind(dw.q_b);
+            hw.kv_a = *bind(dw.kv_a);
+            hw.iq_b = *bind(dw.indexer_q_b);
+            hw.ik = *bind(dw.indexer_k);
+            hw.ig = *bind(dw.indexer_gate);
+            hw.iproj = *bind(dw.indexer_proj);
+            hw.wo = *bind(dw.wo);
+            hw.q_a_norm = weight_planes.download_bf16(device, stream,
+                                                      dw.q_a_norm.payload,
+                                                      config.q_lora);
+            hw.kv_a_norm = weight_planes.download_bf16(device, stream,
+                                                       dw.kv_a_norm.payload, lora);
+            hw.wk_b = weight_planes.download_bf16(
+                device, stream, dw.wk_b.payload,
+                static_cast<std::size_t>(nope) * lora * heads);
+            hw.wv_b = weight_planes.download_bf16(
+                device, stream, dw.wv_b.payload,
+                static_cast<std::size_t>(lora) * v_head * heads);
+            hw.ik_ln_w = weight_planes.download_bf16(device, stream,
+                                                     dw.indexer_k_norm_w.payload, id);
+            hw.ik_ln_b = weight_planes.download_bf16(device, stream,
+                                                     dw.indexer_k_norm_b.payload, id);
+            hw.ape = download_f32(weights.dsa_ape[dsa_idx],
+                                  static_cast<std::size_t>(config.kpool) * id);
+            dsa_weights.push_back(std::move(hw));
+            ++dsa_idx;
+        }
+    }
+
+    // ---- Per-layer FFN weights ----
+    for (std::uint32_t layer = 0; layer < layers; ++layer) {
+        Glm5MlpHpuWeights hw;
+        if (config.layer_mlp_dense[layer]) {
+            const auto& mw = weights.layers[layer].dense_mlp;
+            hw.ffn_norm = *bind(mw.ffn_norm);
+            hw.gate = *bind(mw.gate);
+            hw.up = *bind(mw.up);
+            hw.down = *bind(mw.down);
+        } else {
+            const auto& mw = weights.layers[layer].moe;
+            hw.ffn_norm = *bind(mw.ffn_norm);
+            hw.router = *bind(mw.router);
+            hw.gate = *bind(mw.gate_shexp);
+            hw.up = *bind(mw.up_shexp);
+            hw.down = *bind(mw.down_shexp);
+            // Routed experts bind their row blocks of the stacked planes
+            // by byte offset (review S4): the loader's planes are the ONLY
+            // copy - no slice re-uploads, no init-time duplicate, nothing
+            // to release.
+            const std::uint32_t ffn = config.ffn_moe;
+            const std::uint32_t experts = config.experts;
+            const std::uint64_t gate_block =
+                static_cast<std::uint64_t>(ffn) * config.hidden * 2;
+            const std::uint64_t down_block =
+                static_cast<std::uint64_t>(config.hidden) * ffn * 2;
+            hw.gate_exps_plane = *bind(mw.gate_exps);
+            hw.up_exps_plane = *bind(mw.up_exps);
+            hw.down_exps_plane = *bind(mw.down_exps);
+            hw.expert_gate_offset.resize(experts);
+            hw.expert_up_offset.resize(experts);
+            hw.expert_down_offset.resize(experts);
+            for (std::uint32_t e = 0; e < experts; ++e) {
+                hw.expert_gate_offset[e] = e * gate_block;
+                hw.expert_up_offset[e] = e * gate_block;
+                hw.expert_down_offset[e] = e * down_block;
+            }
+            hw.router_bias = download_f32(weights.layers[layer].moe_router_bias,
+                                          config.experts);
+        }
+        mlp_weights.push_back(std::move(hw));
+    }
+}
+
+std::size_t glm5_hpu_model_scratch_bytes(
+    const models::glm5::execution::Glm5StepConfig& config) {
+    const std::uint64_t h = config.hidden;
+    return static_cast<std::size_t>(
+        h * 2 * 4 * 2 + h * 2 * 2 + h * 2 +
+        24 * 4 * 2 + 16 * 4 + h * 2 + config.vocab_size * 2 + 16 * 1024);
+}
+
+std::vector<std::uint16_t> glm5_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5HpuModel& model,
+    const models::glm5::execution::Glm5ModelWeights& weights,
+    const models::glm5::execution::Glm5StepConfig& config,
+    std::uint32_t token_id, std::uint32_t position) {
+    const std::uint32_t h = config.hidden;
+    constexpr std::uint32_t hc = 4;
+    if (model.planes == nullptr || model.lm_head_plane == nullptr) {
+        throw std::runtime_error(
+            "glm5_hpu_decode_step: upload_weights was not called");
+    }
+
+    // ---- Embedding row: a one-row DMA read out of the resident table ----
+    std::vector<float> residual(hc * h, 0.0f);
+    {
+        DeviceBuffer& table = model.planes->bind(weights.token_embd.payload);
+        PinnedBuffer row = device.allocate_host(h * 2);
+        auto down = stream.download(row, table, h * 2, 0,
+                                    static_cast<std::size_t>(token_id) * h * 2);
+        down.wait();
+        const auto* words = reinterpret_cast<const std::uint16_t*>(row.bytes().data());
+        for (std::uint32_t n = 0; n < hc; ++n) {
+            for (std::uint32_t i = 0; i < h; ++i) {
+                residual[n * h + i] = bf16_word_to_float(words[i]);
+            }
+        }
+    }
+
+    // ---- Layer loop: attention half + FFN half per layer ----
+    std::size_t kda_index = 0, dsa_index = 0;
+    for (std::uint32_t layer = 0; layer < model.layers; ++layer) {
+        {
+            const MhcSite site = mhc_site(residual, model.hc_attn_fn_words[layer],
+                                          model.hc_attn_base[layer],
+                                          model.hc_attn_scale[layer], h,
+                                          config.rms_eps);
+            std::vector<std::uint16_t> hidden_bf(h);
+            for (std::uint32_t i = 0; i < h; ++i) {
+                hidden_bf[i] = float_to_bf16_word(site.collapsed[i]);
+            }
+
+            std::vector<std::uint16_t> block_out_bf;
+            if (!config.layer_is_dsa[layer]) {
+                Glm5KdaHpuConfig block_config{config.hidden, config.kda_heads,
+                                              config.kda_head_dim, 4,
+                                              config.rms_eps, config.gate_lower_bound};
+                block_out_bf = glm5_kda_hpu_decode_step(
+                    device, stream, model.kda_projections[kda_index],
+                    model.kda_weights[kda_index], model.kda_state[kda_index],
+                    block_config, hidden_bf);
+                ++kda_index;
+            } else {
+                Glm5DsaHpuConfig block_config{};
+                block_config.hidden = config.hidden;
+                block_config.heads = config.heads;
+                block_config.head_dim = config.head_dim;
+                block_config.q_lora = config.q_lora;
+                block_config.kv_lora = config.kv_lora;
+                block_config.v_head = config.v_head;
+                block_config.index_heads = config.index_heads;
+                block_config.index_dim = config.index_dim;
+                block_config.kpool = config.kpool;
+                block_config.top_k = config.top_k;
+                block_config.max_positions = model.max_positions;
+                block_config.rms_eps = config.rms_eps;
+                block_out_bf = glm5_dsa_hpu_decode_step(
+                    device, stream, model.dsa_projections[dsa_index],
+                    model.dsa_weights[dsa_index], model.dsa_state[dsa_index],
+                    block_config, hidden_bf, position);
+                ++dsa_index;
+            }
+
+            std::vector<float> block_out(h);
+            for (std::uint32_t i = 0; i < h; ++i) {
+                block_out[i] = bf16_word_to_float(block_out_bf[i]);
+            }
+            mhc_post(site, block_out, residual, h);
+        }
+
+        {
+            const MhcSite site = mhc_site(residual, model.hc_ffn_fn_words[layer],
+                                          model.hc_ffn_base[layer],
+                                          model.hc_ffn_scale[layer], h,
+                                          config.rms_eps);
+            std::vector<std::uint16_t> hidden_bf(h);
+            for (std::uint32_t i = 0; i < h; ++i) {
+                hidden_bf[i] = float_to_bf16_word(site.collapsed[i]);
+            }
+
+            Glm5MlpHpuConfig mlp_config{};
+            mlp_config.hidden = config.hidden;
+            mlp_config.rms_eps = config.rms_eps;
+            mlp_config.swiglu_limit = config.swiglu_limit;
+            if (config.layer_mlp_dense[layer]) {
+                mlp_config.ffn = config.ffn_dense;
+            } else {
+                mlp_config.ffn = config.ffn_moe;
+                mlp_config.experts = config.experts;
+                mlp_config.top_k = config.num_experts_per_tok;
+                mlp_config.routed_scaling_factor = config.routed_scaling_factor;
+            }
+            const std::vector<std::uint16_t> mlp_out_bf = glm5_mlp_hpu_decode_step(
+                device, stream, model.mlp_projections[layer], model.mlp_weights[layer],
+                mlp_config, hidden_bf);
+
+            std::vector<float> mlp_out(h);
+            for (std::uint32_t i = 0; i < h; ++i) {
+                mlp_out[i] = bf16_word_to_float(mlp_out_bf[i]);
+            }
+            mhc_post(site, mlp_out, residual, h);
+        }
+    }
+
+    // ---- Head mean → output norm → lm_head on the MME ----
+    std::vector<float> head_mean(h, 0.0f);
+    for (std::uint32_t n = 0; n < hc; ++n) {
+        for (std::uint32_t i = 0; i < h; ++i) {
+            head_mean[i] += residual[n * h + i] * 0.25f;
+        }
+    }
+    std::vector<float> normed(h);
+    {
+        double sq = 0;
+        for (std::uint32_t i = 0; i < h; ++i) {
+            sq += static_cast<double>(head_mean[i]) * head_mean[i];
+        }
+        const float inv = static_cast<float>(1.0 / std::sqrt(sq / h + config.rms_eps));
+        for (std::uint32_t i = 0; i < h; ++i) {
+            normed[i] = head_mean[i] * inv *
+                        bf16_word_to_float(model.output_norm_words[i]);
+        }
+    }
+
+    // lm_head on the MME against the plane bound at upload time.
+    {
+        const auto out_rows = static_cast<std::uint32_t>(model.lm_head.shape().n);
+        PinnedBuffer host_in = device.allocate_host(h * 2);
+        for (std::uint32_t i = 0; i < h; ++i) {
+            const auto word = float_to_bf16_word(normed[i]);
+            std::memcpy(host_in.bytes().data() + i * 2, &word, 2);
+        }
+        PinnedBuffer host_out = device.allocate_host(out_rows * 2);
+        DeviceBuffer dev_in = device.allocate_device(h * 2);
+        DeviceBuffer dev_out = device.allocate_device(out_rows * 2);
+        auto up = stream.upload(dev_in, host_in, h * 2);
+        up.wait();
+        auto compute = model.lm_head.launch(stream, dev_in, *model.lm_head_plane,
+                                            dev_out);
+        compute.wait();
+        auto down = stream.download(host_out, dev_out, out_rows * 2);
+        down.wait();
+
+        std::vector<std::uint16_t> result(out_rows);
+        std::memcpy(result.data(), host_out.bytes().data(), out_rows * 2);
+        return result;
+    }
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_model.h b/src/core/gaudi2/glm5_hpu_model.h
new file mode 100644
index 0000000..3a1fa0e
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_model.h
@@ -0,0 +1,101 @@
+#pragma once
+// GLM-5.3-Flash full-model HPU executor: the mHC residual chain + per-block
+// dispatch (KDA and DSA mixers, dense/MoE MLPs, every projection on the MME)
+// + the final head/norm/lm_head. This is the correctness-first HPU path:
+// every GEMM is on the MME, the elementwise chains use the same audited host
+// math as the CUDA reference, and the TPC bridges take over as the
+// kernel-lib runtime loading (gap 1's libglm5_tpc.so) comes online.
+//
+// State ownership: the model owns its HBM-resident per-layer state (the KDA
+// recurrence planes and the DSA history planes). The Glm5DecodeState the
+// CUDA path uses carries Tensor-typed planes; unifying the two types is gap
+// 4's next step - until then the HPU model manages its own state, initialized
+// at construction and carried across decode steps.
+
+#include "core/gaudi2/runtime.h"
+#include "core/gaudi2/glm5_hpu_block.h"
+#include "core/gaudi2/glm5_hpu_dsa.h"
+#include "core/gaudi2/glm5_hpu_mlp.h"
+#include "core/gaudi2/glm5_hpu_weights.h"
+#include "models/glm5/execution/model.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+// One model instance's HPU resources.
+struct Glm5HpuModel {
+    // Per-KDA-layer projection sets (each holds 9 static Bf16Gemm recipes).
+    std::vector<Glm5KdaHpuProjections> kda_projections;
+    std::vector<std::uint32_t> kda_layer_indices;
+
+    // HBM-resident KDA state, one per KDA layer (zero-initialized at
+    // construction; carried across decode steps).
+    std::vector<Glm5KdaHpuState> kda_state;
+
+    // HBM-resident KDA weight planes, one set per KDA layer (uploaded at
+    // construction from the model's Weight payloads; the block executor
+    // reads DeviceBuffers).
+    std::vector<Glm5KdaHpuWeights> kda_weights;
+
+    // Per-DSA-layer projection sets, state and weight planes (the history
+    // planes hold max_positions rows; positions beyond that are rejected).
+    std::vector<Glm5DsaHpuProjections> dsa_projections;
+    std::vector<std::uint32_t> dsa_layer_indices;
+    std::vector<Glm5DsaHpuState> dsa_state;
+    std::vector<Glm5DsaHpuWeights> dsa_weights;
+    std::uint32_t max_positions;
+
+    // Per-layer FFN half (dense or MoE; both share the projection kinds).
+    std::vector<Glm5MlpHpuProjections> mlp_projections;
+    std::vector<Glm5MlpHpuWeights> mlp_weights;
+
+    // The lm_head projection [1, vocab, hidden].
+    Bf16Gemm lm_head;
+    // The lm_head's resident weight plane (bound once, launched per step;
+    // before this the executor re-uploaded the whole plane every step).
+    DeviceBuffer* lm_head_plane = nullptr;
+
+    // Host-side operand caches downloaded once at bind time: the mHC weight
+    // planes and gammas the host math consumes every step, the final norm
+    // gamma, and the embedding gather through a per-row DMA read.
+    Glm5HpuWeightPlanes* planes = nullptr;
+    std::vector<std::vector<std::uint16_t>> hc_attn_fn_words, hc_ffn_fn_words;
+    std::vector<std::vector<float>> hc_attn_base, hc_attn_scale;
+    std::vector<std::vector<float>> hc_ffn_base, hc_ffn_scale;
+    std::vector<std::uint16_t> output_norm_words;
+
+    // Model geometry (from the step config).
+    std::uint32_t hidden, layers, kda_heads, kda_head_dim;
+
+    Glm5HpuModel(const Device& device, const models::glm5::execution::Glm5StepConfig& config,
+                 std::size_t max_workspace_bytes = 4096,
+                 std::uint32_t max_positions = 4096);
+
+    // Binds every weight plane from the loader's residency registry: the
+    // projection planes bind their DeviceBuffers directly (uploaded exactly
+    // once by the loader), and the host-math operands (mHC planes, norm
+    // gammas, KDA scalars, DSA absorb/LayerNorm/ape, MoE router bias) come
+    // back through DMA downloads. Call once after load_gguf_weights_hpu.
+    void upload_weights(const Device& device, Stream& stream,
+                        Glm5HpuWeightPlanes& weight_planes,
+                        const models::glm5::execution::Glm5ModelWeights& weights,
+                        const models::glm5::execution::Glm5StepConfig& config);
+};
+
+// One full decode step: token_id → embedding → the mHC residual chain across
+// every block (mixer + FFN halves) → the head mean → the output norm → the
+// lm_head → logits [vocab, 1] BF16. Returns the logits as host BF16 words.
+[[nodiscard]] std::vector<std::uint16_t> glm5_hpu_decode_step(
+    const Device& device, Stream& stream, Glm5HpuModel& model,
+    const models::glm5::execution::Glm5ModelWeights& weights,
+    const models::glm5::execution::Glm5StepConfig& config,
+    std::uint32_t token_id, std::uint32_t position);
+
+// Scratch requirement (host staging for the residual chain and projections).
+[[nodiscard]] std::size_t glm5_hpu_model_scratch_bytes(
+    const models::glm5::execution::Glm5StepConfig& config);
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_session.cpp b/src/core/gaudi2/glm5_hpu_session.cpp
new file mode 100644
index 0000000..71ec29d
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_session.cpp
@@ -0,0 +1,83 @@
+// GLM-5.3-Flash HPU session: GGUF open → once-uploaded residency → model
+// executor → per-request decode loop.
+#include "core/gaudi2/glm5_hpu_session.h"
+
+#include "models/glm5/execution/gguf_loader.h"
+
+#include <cstring>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+
+Glm5HpuSession::Glm5HpuSession(const Device& device, const std::string& gguf_path,
+                               models::glm5::execution::Glm5StepConfig config,
+                               const Glm5HpuSessionOptions& options)
+    : config_(std::move(config)), options_(options), device_(device),
+      stream_(device.create_stream()) {
+    if (config_.layer_is_dsa.size() != config_.layer_mlp_dense.size() ||
+        config_.layer_is_dsa.empty()) {
+        throw std::invalid_argument(
+            "Glm5HpuSession: config must describe every layer's kinds");
+    }
+    models::glm5::execution::load_gguf_weights_hpu(gguf_path, weights_, config_,
+                                                   device_, stream_, planes_);
+    model_ = std::make_unique<Glm5HpuModel>(device, config_,
+                                            options_.max_workspace_bytes,
+                                            options_.max_positions);
+    model_->upload_weights(device_, stream_, planes_, weights_, config_);
+}
+
+void Glm5HpuSession::begin_request() {
+    // The KDA recurrence reads its carried state before the first write, so
+    // a fresh request re-zeros those planes. The DSA history planes only
+    // expose written rows (positions bound the reads), so no reset there.
+    auto zero = [&](DeviceBuffer& plane, std::size_t bytes) {
+        PinnedBuffer zeros = device_.allocate_host(bytes);
+        std::memset(zeros.bytes().data(), 0, bytes);
+        auto transfer = stream_.upload(plane, zeros, bytes);
+        transfer.wait();
+    };
+    const std::size_t conv_state =
+        3 * static_cast<std::size_t>(config_.kda_heads) * config_.kda_head_dim * 4;
+    const std::size_t matrix_state = static_cast<std::size_t>(config_.kda_heads) *
+                                     config_.kda_head_dim * config_.kda_head_dim * 4;
+    for (auto& state : model_->kda_state) {
+        zero(state.conv_q, conv_state);
+        zero(state.conv_k, conv_state);
+        zero(state.conv_v, conv_state);
+        zero(state.matrix, matrix_state);
+    }
+}
+
+std::vector<std::uint16_t> Glm5HpuSession::decode(const Device& device, Stream& stream,
+                                                  std::uint32_t token_id,
+                                                  std::uint32_t position) {
+    return glm5_hpu_decode_step(device, stream, *model_, weights_, config_,
+                                token_id, position);
+}
+
+std::uint32_t Glm5HpuSession::sample_greedy(
+    const std::vector<std::uint16_t>& logits) const {
+    if (logits.empty()) {
+        throw std::invalid_argument("sample_greedy: empty logits");
+    }
+    auto widen = [](std::uint16_t word) {
+        const std::uint32_t bits = static_cast<std::uint32_t>(word) << 16;
+        float value;
+        std::memcpy(&value, &bits, 4);
+        return value;
+    };
+    std::uint32_t best = 0;
+    float best_value = widen(logits[0]);
+    for (std::size_t i = 1; i < logits.size(); ++i) {
+        const float value = widen(logits[i]);
+        // Strictly greater: ties keep the lower token id.
+        if (value > best_value) {
+            best_value = value;
+            best = static_cast<std::uint32_t>(i);
+        }
+    }
+    return best;
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_session.h b/src/core/gaudi2/glm5_hpu_session.h
new file mode 100644
index 0000000..d278cd4
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_session.h
@@ -0,0 +1,75 @@
+#pragma once
+// GLM-5.3-Flash HPU session: the engine-facing entry that assembles the gap
+// pieces into one object - GGUF load (once-uploaded HBM residency), step
+// config, the model executor with its per-layer projections and state, and
+// the per-request lifecycle. This is the gap-4 "product integration slice":
+// serve/CLI can open a session per loaded model and run decode loops against
+// it without touching CUDA-side types (the session owns every DeviceBuffer;
+// the CUDA path's Glm5DecodeState carries its own Tensor planes behind the
+// same request semantics).
+
+#include "core/gaudi2/runtime.h"
+#include "core/gaudi2/glm5_hpu_model.h"
+#include "core/gaudi2/glm5_hpu_weights.h"
+#include "models/glm5/execution/model.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+struct Glm5HpuSessionOptions {
+    std::uint32_t max_positions = 4096;   // DSA history plane capacity
+    std::size_t max_workspace_bytes = 4096;
+};
+
+class Glm5HpuSession {
+public:
+    // Opens a GGUF file and builds the whole execution stack: the weight
+    // residency (uploaded exactly once), the per-layer projection recipes,
+    // and the zero-initialized persistent state. `config` carries the model
+    // geometry and layer kinds (from the HF config parse or the caller).
+    Glm5HpuSession(const Device& device, const std::string& gguf_path,
+                   models::glm5::execution::Glm5StepConfig config,
+                   const Glm5HpuSessionOptions& options = {});
+    ~Glm5HpuSession() = default;
+    Glm5HpuSession(const Glm5HpuSession&) = delete;
+    Glm5HpuSession& operator=(const Glm5HpuSession&) = delete;
+
+    // Resets the per-request state: every KDA recurrence plane goes back to
+    // zero (the recurrence reads before its first write); the DSA history
+    // planes need no reset (positions only expose written rows).
+    void begin_request();
+
+    // One decode step: token at `position` → logits [vocab] BF16 words.
+    [[nodiscard]] std::vector<std::uint16_t> decode(const Device& device,
+                                                    Stream& stream,
+                                                    std::uint32_t token_id,
+                                                    std::uint32_t position);
+
+    // Greedy argmax over the last decode's logits (BF16-representable
+    // comparison; ties resolve to the lower token id, matching the
+    // engine's sampling convention).
+    [[nodiscard]] std::uint32_t sample_greedy(const std::vector<std::uint16_t>& logits) const;
+
+    [[nodiscard]] const models::glm5::execution::Glm5StepConfig& config() const noexcept {
+        return config_;
+    }
+    [[nodiscard]] std::size_t resident_weight_bytes() const noexcept {
+        return planes_.resident_bytes();
+    }
+
+private:
+    models::glm5::execution::Glm5StepConfig config_;
+    Glm5HpuSessionOptions options_;
+    Device device_;
+    Glm5HpuWeightPlanes planes_;
+    models::glm5::execution::Glm5ModelWeights weights_;
+    std::unique_ptr<Glm5HpuModel> model_;
+    Stream stream_;
+};
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_weights.cpp b/src/core/gaudi2/glm5_hpu_weights.cpp
new file mode 100644
index 0000000..014641c
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_weights.cpp
@@ -0,0 +1,83 @@
+// Glm5HpuWeightPlanes: the once-uploaded HBM residency behind the GLM5 HPU
+// path. Payload addresses are the join key between the loader's Weight
+// binding and the block executors' DeviceBuffer operands.
+#include "core/gaudi2/glm5_hpu_weights.h"
+
+#include <memory>
+
+#include <cstring>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+
+const void* Glm5HpuWeightPlanes::upload(const Device& device, Stream& stream,
+                                        const void* host, std::size_t bytes) {
+    PinnedBuffer staging = device.allocate_host(bytes);
+    std::memcpy(staging.bytes().data(), host, bytes);
+    DeviceBuffer destination = device.allocate_device(bytes);
+    auto transfer = stream.upload(destination, staging, bytes);
+    transfer.wait();
+    const auto address = destination.address();
+    entries_.push_back(Entry{address, std::make_unique<DeviceBuffer>(std::move(destination))});
+    bytes_ += bytes;
+    return reinterpret_cast<const void*>(address);
+}
+
+bool Glm5HpuWeightPlanes::release(const void* payload) {
+    const auto address = reinterpret_cast<std::uint64_t>(payload);
+    for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+        if (it->address == address) {
+            bytes_ -= it->buffer->size();
+            entries_.erase(it);
+            return true;
+        }
+    }
+    return false;
+}
+
+DeviceBuffer& Glm5HpuWeightPlanes::bind(const void* payload) {
+    const auto address = reinterpret_cast<std::uint64_t>(payload);
+    for (auto& entry : entries_) {
+        if (entry.address == address) return *entry.buffer;
+    }
+    throw std::invalid_argument(
+        "Glm5HpuWeightPlanes: payload address is not a resident plane");
+}
+
+std::vector<std::byte> Glm5HpuWeightPlanes::download(const Device& device,
+                                                     Stream& stream,
+                                                     const void* payload,
+                                                     std::size_t bytes,
+                                                     std::size_t source_offset) {
+    DeviceBuffer& plane = bind(payload);
+    PinnedBuffer staging = device.allocate_host(bytes);
+    auto transfer = stream.download(staging, plane, bytes, 0, source_offset);
+    transfer.wait();
+    return std::vector<std::byte>(staging.bytes().begin(),
+                                  staging.bytes().begin() + bytes);
+}
+
+std::vector<std::uint16_t> Glm5HpuWeightPlanes::download_bf16_words(
+    const Device& device, Stream& stream, const void* payload,
+    std::size_t elements) {
+    std::vector<std::byte> raw = download(device, stream, payload, elements * 2);
+    std::vector<std::uint16_t> out(elements);
+    std::memcpy(out.data(), raw.data(), elements * 2);
+    return out;
+}
+
+std::vector<float> Glm5HpuWeightPlanes::download_bf16(const Device& device,
+                                                      Stream& stream,
+                                                      const void* payload,
+                                                      std::size_t elements) {
+    std::vector<std::byte> raw = download(device, stream, payload, elements * 2);
+    std::vector<float> out(elements);
+    const auto* words = reinterpret_cast<const std::uint16_t*>(raw.data());
+    for (std::size_t i = 0; i < elements; ++i) {
+        const std::uint32_t wide = static_cast<std::uint32_t>(words[i]) << 16;
+        std::memcpy(&out[i], &wide, 4);
+    }
+    return out;
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/glm5_hpu_weights.h b/src/core/gaudi2/glm5_hpu_weights.h
new file mode 100644
index 0000000..561dbf6
--- /dev/null
+++ b/src/core/gaudi2/glm5_hpu_weights.h
@@ -0,0 +1,78 @@
+#pragma once
+// Session-owned HBM weight residency for the GLM5 HPU path (gap 4's
+// Tensor/DeviceBuffer unification slice).
+//
+// Before this, the GGUF HPU loader parked its DeviceBuffers in a file-static
+// global and the model executor copied weight payloads through raw device
+// addresses with host memcpy - valid only where the runtime maps device
+// memory into the host (the fake double), a real-machine hazard. Now every
+// plane is uploaded exactly once into this registry, keyed by its device
+// payload address: block executors bind the resident DeviceBuffer directly,
+// and the small FP32/BF16 scalar planes come back through a real DMA
+// download instead of a host alias read.
+
+#include "core/gaudi2/runtime.h"
+
+#include <cstddef>
+#include <memory>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+class Glm5HpuWeightPlanes {
+public:
+    Glm5HpuWeightPlanes() = default;
+    ~Glm5HpuWeightPlanes() = default;
+    Glm5HpuWeightPlanes(const Glm5HpuWeightPlanes&) = delete;
+    Glm5HpuWeightPlanes& operator=(const Glm5HpuWeightPlanes&) = delete;
+    Glm5HpuWeightPlanes(Glm5HpuWeightPlanes&&) noexcept = default;
+    Glm5HpuWeightPlanes& operator=(Glm5HpuWeightPlanes&&) noexcept = default;
+
+    // Stages one host plane into HBM and returns its device payload address.
+    [[nodiscard]] const void* upload(const Device& device, Stream& stream,
+                                     const void* host, std::size_t bytes);
+
+    // Binds a previously uploaded plane by its payload address (the same
+    // address a Weight carries). Throws when unknown: raw-address host
+    // reads are not a fallback path.
+    [[nodiscard]] DeviceBuffer& bind(const void* payload);
+
+    // Downloads `bytes` from a resident plane through the DMA channel
+    // (optionally starting at a byte offset inside the plane).
+    [[nodiscard]] std::vector<std::byte> download(const Device& device, Stream& stream,
+                                                  const void* payload, std::size_t bytes,
+                                                  std::size_t source_offset = 0);
+
+    // Downloads a resident plane as raw BF16 words.
+    [[nodiscard]] std::vector<std::uint16_t> download_bf16_words(
+        const Device& device, Stream& stream, const void* payload,
+        std::size_t elements);
+
+    // Downloads a resident plane as BF16 words widened to FP32.
+    [[nodiscard]] std::vector<float> download_bf16(const Device& device, Stream& stream,
+                                                   const void* payload,
+                                                   std::size_t elements);
+
+    // Drops one resident plane (its HBM allocation frees with the entry).
+    // Returns false when the payload is unknown. Used after derived planes
+    // (per-expert slices) fully replace a stacked source.
+    bool release(const void* payload);
+
+    [[nodiscard]] std::size_t size() const noexcept { return entries_.size(); }
+    [[nodiscard]] std::uint64_t resident_bytes() const noexcept { return bytes_; }
+
+private:
+    struct Entry {
+        std::uint64_t address;
+        // Heap-indirected: a mid-deque erase shifts later entries, and the
+        // moved-from DeviceBuffer would null the stable pointers bind()
+        // handed out. The heap object never moves.
+        std::unique_ptr<DeviceBuffer> buffer;
+    };
+    std::deque<Entry> entries_;
+    std::uint64_t bytes_ = 0;
+};
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/kernel_library.cpp b/src/core/gaudi2/kernel_library.cpp
new file mode 100644
index 0000000..b665c20
--- /dev/null
+++ b/src/core/gaudi2/kernel_library.cpp
@@ -0,0 +1,127 @@
+// TPC kernel-library loader: the OS-level load of a gc glue shared object
+// plus the GUID handshake. See kernel_library.h.
+#include "core/gaudi2/kernel_library.h"
+
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <utility>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+namespace ninfer::gaudi2 {
+namespace {
+
+constexpr tpc_lib_api::DeviceId kGaudi2LibDeviceId = tpc_lib_api::DEVICE_ID_GAUDI2;
+constexpr gcapi::DeviceId_t kGaudi2GcDeviceId = gcapi::DEVICE_ID_GAUDI2;
+
+#if defined(_WIN32)
+void* open_module(const char* path) { return LoadLibraryA(path); }
+void* module_symbol(void* handle, const char* name) {
+    return reinterpret_cast<void*>(GetProcAddress(static_cast<HMODULE>(handle), name));
+}
+void close_module(void* handle) { FreeLibrary(static_cast<HMODULE>(handle)); }
+std::string loader_error() { return "LoadLibraryA failed"; }
+#else
+void* open_module(const char* path) { return dlopen(path, RTLD_NOW | RTLD_LOCAL); }
+void* module_symbol(void* handle, const char* name) { return dlsym(handle, name); }
+void close_module(void* handle) { dlclose(handle); }
+std::string loader_error() {
+    const char* text = dlerror();
+    return text != nullptr ? text : "dlopen failed";
+}
+#endif
+
+} // namespace
+
+KernelLibrary::KernelLibrary(const char* library_path) : path_(library_path) {
+    module_ = open_module(library_path);
+    if (module_ == nullptr) {
+        throw std::runtime_error("kernel_library: cannot load " + path_ + ": " +
+                                 loader_error());
+    }
+    get_kernel_guids_ = reinterpret_cast<tpc_lib_api::pfnGetKernelGuids>(
+        module_symbol(module_, "GetKernelGuids"));
+    get_gc_definitions_ =
+        reinterpret_cast<decltype(get_gc_definitions_)>(module_symbol(module_, "GetGcDefinitions"));
+    if (get_kernel_guids_ == nullptr || get_gc_definitions_ == nullptr) {
+        close_module(module_);
+        module_ = nullptr;
+        throw std::runtime_error(
+            "kernel_library: " + path_ +
+            " does not export the kernel-library entry points");
+    }
+
+    // GUID enumeration: size query first, then the filled array.
+    std::uint32_t count = 0;
+    if (get_kernel_guids_(kGaudi2LibDeviceId, &count, nullptr) !=
+            tpc_lib_api::GLUE_SUCCESS ||
+        count == 0) {
+        close_module(module_);
+        module_ = nullptr;
+        throw std::runtime_error("kernel_library: " + path_ + " reports no kernels");
+    }
+    std::vector<tpc_lib_api::GuidInfo> guids(count);
+    if (get_kernel_guids_(kGaudi2LibDeviceId, &count, guids.data()) !=
+        tpc_lib_api::GLUE_SUCCESS) {
+        close_module(module_);
+        module_ = nullptr;
+        throw std::runtime_error("kernel_library: " + path_ +
+                                 " failed to fill its GUID list");
+    }
+    names_.reserve(count);
+    for (std::uint32_t k = 0; k < count; ++k) {
+        guids[k].name[tpc_lib_api::MAX_NODE_NAME - 1] = '\0';
+        names_.emplace_back(guids[k].name);
+    }
+}
+
+KernelLibrary::~KernelLibrary() {
+    if (module_ != nullptr) close_module(module_);
+}
+
+KernelLibrary::KernelLibrary(KernelLibrary&& other) noexcept
+    : module_(other.module_), get_kernel_guids_(other.get_kernel_guids_),
+      get_gc_definitions_(other.get_gc_definitions_), names_(std::move(other.names_)),
+      path_(std::move(other.path_)) {
+    other.module_ = nullptr;
+    other.get_kernel_guids_ = nullptr;
+    other.get_gc_definitions_ = nullptr;
+}
+
+KernelLibrary& KernelLibrary::operator=(KernelLibrary&& other) noexcept {
+    if (this != &other) {
+        // Close the old module only; the members stay alive so the moved-in
+        // values assign into constructed objects (destroy-then-assign would
+        // leave names_/path_ destroyed - UB, review R6).
+        if (module_ != nullptr) close_module(module_);
+        module_ = other.module_;
+        get_kernel_guids_ = other.get_kernel_guids_;
+        get_gc_definitions_ = other.get_gc_definitions_;
+        names_ = std::move(other.names_);
+        path_ = std::move(other.path_);
+        other.module_ = nullptr;
+        other.get_kernel_guids_ = nullptr;
+        other.get_gc_definitions_ = nullptr;
+    }
+    return *this;
+}
+
+unsigned KernelLibrary::definitions(
+    const char* kernel_name, gcapi::HabanaKernelParams_t* params,
+    gcapi::HabanaKernelInstantiation_t* instance, const unsigned* scalar_words,
+    unsigned scalar_word_count) const {
+    return get_gc_definitions_(kernel_name, kGaudi2GcDeviceId,
+                               static_cast<const void*>(scalar_words),
+                               scalar_word_count * sizeof(unsigned), params,
+                               instance);
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/kernel_library.h b/src/core/gaudi2/kernel_library.h
new file mode 100644
index 0000000..e56c03b
--- /dev/null
+++ b/src/core/gaudi2/kernel_library.h
@@ -0,0 +1,64 @@
+#pragma once
+// TPC kernel-library loading for the Gaudi2 runtime adapter (gap 1: the
+// bridge between the gc glue shared objects - like libglm5_tpc.so built by
+// tpc/glue - and the runtime that launches custom-kernel nodes).
+//
+// The loader binds the kernel-library contract the graph compiler defines
+// (tpc/glue/include/tpc_kernel_lib_interface.h, gc_interface.h): GetKernelGuids
+// reports the library's GUIDs; GetGcDefinitions returns one kernel's
+// instantiation descriptor (index space, access patterns, ELF blob, scalar
+// params) when driven with well-formed tensor parameters. This class owns
+// the OS-level load and the entry-point binding, enumerates the GUIDs, and
+// forwards definition queries - so an engine session holds the same handle
+// the graph compiler would, and the glue's side of the contract is proven
+// in-process before real hardware repeats it.
+
+#include "tpc/glue/include/gc_interface.h"
+#include "tpc/glue/include/tpc_kernel_lib_interface.h"
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+class KernelLibrary {
+public:
+    // Loads the shared object, resolves GetKernelGuids/GetGcDefinitions, and
+    // enumerates the kernels the library reports for Gaudi2. Throws
+    // std::runtime_error on any failure; nothing stays loaded.
+    explicit KernelLibrary(const char* library_path);
+    ~KernelLibrary();
+    KernelLibrary(const KernelLibrary&) = delete;
+    KernelLibrary& operator=(const KernelLibrary&) = delete;
+    KernelLibrary(KernelLibrary&&) noexcept;
+    KernelLibrary& operator=(KernelLibrary&&) noexcept;
+
+    // The GUID names this library exports (the instantiation descriptor
+    // itself comes from definitions(), driven with per-kernel geometry).
+    [[nodiscard]] const std::vector<std::string>& kernel_names() const noexcept {
+        return names_;
+    }
+    [[nodiscard]] const std::string& path() const noexcept { return path_; }
+
+    // Forwards one GetGcDefinitions query (the caller supplies the tensor
+    // descriptors and the node's scalar parameter block, exactly like the
+    // graph compiler would). Returns the glue status; `instance` carries
+    // the result on success. `scalar_words` is the parameter block in
+    // 32-bit words; empty for parameterless kernels.
+    [[nodiscard]] unsigned definitions(
+        const char* kernel_name, gcapi::HabanaKernelParams_t* params,
+        gcapi::HabanaKernelInstantiation_t* instance,
+        const unsigned* scalar_words = nullptr, unsigned scalar_word_count = 0) const;
+
+private:
+    void* module_ = nullptr;  // HMODULE on Windows, void* from dlopen elsewhere
+    tpc_lib_api::pfnGetKernelGuids get_kernel_guids_ = nullptr;
+    gcapi::GlueCodeReturn_t (*get_gc_definitions_)(
+        const char*, gcapi::DeviceId_t, const void*, unsigned,
+        gcapi::HabanaKernelParams_t*, gcapi::HabanaKernelInstantiation_t*) = nullptr;
+    std::vector<std::string> names_;
+    std::string path_;
+};
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/paged_kv_hpu.cpp b/src/core/gaudi2/paged_kv_hpu.cpp
new file mode 100644
index 0000000..b95d91f
--- /dev/null
+++ b/src/core/gaudi2/paged_kv_hpu.cpp
@@ -0,0 +1,130 @@
+// PagedKvHpuPool: HBM-resident paged KV storage with the KVMem window's
+// page geometry. See paged_kv_hpu.h.
+#include "core/gaudi2/paged_kv_hpu.h"
+
+#include <cstring>
+#include <stdexcept>
+#include <utility>
+
+namespace ninfer::gaudi2 {
+
+PagedKvHpuPool::PagedKvHpuPool(const Device& device, std::uint32_t heads,
+                               std::uint32_t head_dim, std::uint32_t pages)
+    : heads_(heads), head_dim_(head_dim), pages_(pages) {
+    if (heads == 0 || head_dim == 0 || pages == 0) {
+        throw std::invalid_argument("PagedKvHpuPool: geometry must be positive");
+    }
+    row_bytes_ = heads * head_dim * 2;
+    page_stride_bytes_ = kKvmemPageTokens * row_bytes_;
+    key_pages_.reserve(pages);
+    value_pages_.reserve(pages);
+    for (std::uint32_t p = 0; p < pages; ++p) {
+        key_pages_.push_back(device.allocate_device(page_stride_bytes_));
+        value_pages_.push_back(device.allocate_device(page_stride_bytes_));
+    }
+}
+
+std::uint32_t PagedKvHpuPool::valid_columns(std::uint32_t page) const noexcept {
+    // kvmem_window.cpp's valid_columns: min(page_tokens, frontier - page*64).
+    const std::uint64_t remaining = frontier_ - std::uint64_t{page} * kKvmemPageTokens;
+    return static_cast<std::uint32_t>(
+        std::min<std::uint64_t>(kKvmemPageTokens, remaining));
+}
+
+DeviceBuffer& PagedKvHpuPool::key_page(std::uint32_t page) const {
+    return const_cast<DeviceBuffer&>(key_pages_[page]);
+}
+DeviceBuffer& PagedKvHpuPool::value_page(std::uint32_t page) const {
+    return const_cast<DeviceBuffer&>(value_pages_[page]);
+}
+
+void PagedKvHpuPool::append(const Device& device, Stream& stream,
+                            const std::vector<std::uint16_t>& key_row,
+                            const std::vector<std::uint16_t>& value_row,
+                            std::uint32_t position) {
+    (void)device;
+    if (position != frontier_) {
+        throw std::invalid_argument("PagedKvHpuPool: appends must follow the frontier");
+    }
+    if (position >= pages_ * kKvmemPageTokens) {
+        throw std::out_of_range("PagedKvHpuPool: append beyond the pool capacity");
+    }
+    if (key_row.size() != heads_ * head_dim_ || value_row.size() != heads_ * head_dim_) {
+        throw std::invalid_argument("PagedKvHpuPool: row width mismatch");
+    }
+    const std::uint32_t page = position / kKvmemPageTokens;
+    const std::uint32_t column = position % kKvmemPageTokens;
+    const std::size_t offset = static_cast<std::size_t>(column) * row_bytes_;
+    auto put = [&](DeviceBuffer& plane, const std::vector<std::uint16_t>& row) {
+        PinnedBuffer staging = device.allocate_host(row_bytes_);
+        std::memcpy(staging.bytes().data(), row.data(), row_bytes_);
+        auto transfer = stream.upload(plane, staging, row_bytes_, offset);
+        transfer.wait();
+    };
+    put(key_pages_[page], key_row);
+    put(value_pages_[page], value_row);
+    ++frontier_;
+}
+
+void PagedKvHpuPool::truncate(std::uint32_t position) {
+    if (position > frontier_) {
+        throw std::invalid_argument("PagedKvHpuPool: cannot truncate forward");
+    }
+    // Page-granular semantics: the trailing (possibly partial) page is
+    // logically empty after the cut; its leading columns remain readable
+    // only through a later append overwriting them. The frontier moves.
+    frontier_ = position;
+}
+
+std::pair<std::vector<float>, std::vector<float>> PagedKvHpuPool::gather(
+    const Device& device, Stream& stream, std::uint32_t position) const {
+    if (position >= frontier_) {
+        throw std::invalid_argument("PagedKvHpuPool: gather beyond the frontier");
+    }
+    const std::uint32_t tokens = position + 1;
+    const std::size_t row_elements = static_cast<std::size_t>(heads_) * head_dim_;
+    std::vector<float> keys(tokens * row_elements), values(tokens * row_elements);
+
+    auto widen = [&](const std::vector<std::byte>& raw, float* destination) {
+        const auto* words = reinterpret_cast<const std::uint16_t*>(raw.data());
+        for (std::size_t i = 0; i < raw.size() / 2; ++i) {
+            const std::uint32_t wide = static_cast<std::uint32_t>(words[i]) << 16;
+            std::memcpy(destination + i, &wide, 4);
+        }
+    };
+    const std::uint32_t full_pages = tokens / kKvmemPageTokens;
+    const std::uint32_t tail_columns = tokens % kKvmemPageTokens;
+    for (std::uint32_t p = 0; p < full_pages; ++p) {
+        PinnedBuffer staging = device.allocate_host(page_stride_bytes_);
+        auto down = stream.download(staging, key_page(p), page_stride_bytes_);
+        down.wait();
+        widen(std::vector<std::byte>(staging.bytes().begin(), staging.bytes().end()),
+              keys.data() + static_cast<std::size_t>(p) * kKvmemPageTokens *
+                                row_elements);
+        PinnedBuffer staging_v = device.allocate_host(page_stride_bytes_);
+        auto down_v = stream.download(staging_v, value_page(p), page_stride_bytes_);
+        down_v.wait();
+        widen(std::vector<std::byte>(staging_v.bytes().begin(), staging_v.bytes().end()),
+              values.data() + static_cast<std::size_t>(p) * kKvmemPageTokens *
+                                  row_elements);
+    }
+    if (tail_columns > 0) {
+        const std::uint32_t p = full_pages;
+        const std::size_t bytes = static_cast<std::size_t>(tail_columns) * row_bytes_;
+        PinnedBuffer staging = device.allocate_host(bytes);
+        auto down = stream.download(staging, key_page(p), bytes);
+        down.wait();
+        widen(std::vector<std::byte>(staging.bytes().begin(), staging.bytes().end()),
+              keys.data() + static_cast<std::size_t>(p) * kKvmemPageTokens *
+                                row_elements);
+        PinnedBuffer staging_v = device.allocate_host(bytes);
+        auto down_v = stream.download(staging_v, value_page(p), bytes);
+        down_v.wait();
+        widen(std::vector<std::byte>(staging_v.bytes().begin(), staging_v.bytes().end()),
+              values.data() + static_cast<std::size_t>(p) * kKvmemPageTokens *
+                                  row_elements);
+    }
+    return {std::move(keys), std::move(values)};
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/paged_kv_hpu.h b/src/core/gaudi2/paged_kv_hpu.h
new file mode 100644
index 0000000..ae432cb
--- /dev/null
+++ b/src/core/gaudi2/paged_kv_hpu.h
@@ -0,0 +1,72 @@
+#pragma once
+// Paged KV cache pool on the Gaudi2 runtime adapter - the HPU foundation for
+// the KVMem window semantics (gap 5). The page geometry mirrors the CUDA
+// program's KVMem bridge (kvmem_window.cpp): 64-token pages, per-page valid
+// column counts, and history truncation at page granularity. The pool owns
+// its HBM pages; decode appends rows and the attention reader gathers over
+// the valid prefix through DMA.
+//
+// This is the storage layer only: paging OUT to host/disk tiers (the KVMem
+// MemoryBackend contract) stays on the CUDA program until the HPU path
+// grows its own window scheduler.
+
+#include "core/gaudi2/runtime.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+// The KVMem window's fixed page width (kvmem_window.cpp's page_tokens).
+inline constexpr std::uint32_t kKvmemPageTokens = 64;
+
+class PagedKvHpuPool {
+public:
+    // One page plane set: keys and values for [page_tokens, heads * head_dim]
+    // each (BF16). `pages` bounds the pool capacity (max_context =
+    // pages * page_tokens).
+    PagedKvHpuPool(const Device& device, std::uint32_t heads, std::uint32_t head_dim,
+                   std::uint32_t pages);
+    ~PagedKvHpuPool() = default;
+    PagedKvHpuPool(const PagedKvHpuPool&) = delete;
+    PagedKvHpuPool& operator=(const PagedKvHpuPool&) = delete;
+
+    // Appends one token's key/value rows at `position` (must equal the
+    // current frontier). Rows are BF16 words [heads * head_dim] each.
+    void append(const Device& device, Stream& stream,
+                const std::vector<std::uint16_t>& key_row,
+                const std::vector<std::uint16_t>& value_row, std::uint32_t position);
+
+    // Truncates history so the next append lands at `position` (the KVMem
+    // window's page-granular eviction: whole pages drop, a partial page
+    // keeps its leading columns).
+    void truncate(std::uint32_t position);
+
+    // Gathers the valid prefix [0, position+1) into host FP32 planes
+    // [tokens, heads*head_dim] (keys and values) through one DMA per page
+    // span - the attention reader's input.
+    [[nodiscard]] std::pair<std::vector<float>, std::vector<float>> gather(
+        const Device& device, Stream& stream, std::uint32_t position) const;
+
+    [[nodiscard]] std::uint32_t frontier() const noexcept { return frontier_; }
+    [[nodiscard]] std::uint32_t page_count() const noexcept { return pages_; }
+    [[nodiscard]] std::uint32_t heads() const noexcept { return heads_; }
+    [[nodiscard]] std::uint32_t head_dim() const noexcept { return head_dim_; }
+    [[nodiscard]] std::uint32_t page_stride_bytes() const noexcept {
+        return page_stride_bytes_;
+    }
+
+private:
+    [[nodiscard]] std::uint32_t valid_columns(std::uint32_t page) const noexcept;
+    DeviceBuffer& key_page(std::uint32_t page) const;
+    DeviceBuffer& value_page(std::uint32_t page) const;
+
+    std::vector<DeviceBuffer> key_pages_, value_pages_;
+    std::uint32_t heads_, head_dim_, pages_;
+    std::uint32_t row_bytes_ = 0;        // one token's row, bytes
+    std::uint32_t page_stride_bytes_ = 0;  // one page's plane, bytes
+    std::uint32_t frontier_ = 0;
+};
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/qwen_hpu.cpp b/src/core/gaudi2/qwen_hpu.cpp
new file mode 100644
index 0000000..d0cd882
--- /dev/null
+++ b/src/core/gaudi2/qwen_hpu.cpp
@@ -0,0 +1,309 @@
+// Qwen GDN recurrence and paged KV attention on the Gaudi2 runtime adapter.
+// See qwen_hpu.h for the contracts.
+#include "core/gaudi2/qwen_hpu.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::gaudi2 {
+namespace {
+
+float bf16_word_to_float(std::uint16_t word) {
+    const std::uint32_t wide = static_cast<std::uint32_t>(word) << 16;
+    float value;
+    std::memcpy(&value, &wide, 4);
+    return value;
+}
+
+std::uint16_t float_to_bf16_word(float value) {
+    std::uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return static_cast<std::uint16_t>(bits >> 16);
+}
+
+} // namespace
+
+QwenGdnHpuState::QwenGdnHpuState(const Device& device, const QwenGdnHpuConfig& config) {
+    if (config.head_dim == 0 || config.qk_heads == 0 || config.value_heads == 0 ||
+        config.value_heads < config.qk_heads ||
+        config.value_heads % config.qk_heads != 0) {
+        throw std::invalid_argument("QwenGdnHpuState: invalid head geometry");
+    }
+    floats_ = static_cast<std::size_t>(config.value_heads) * config.head_dim *
+              config.head_dim;
+    matrix_ = device.allocate_device(floats_ * 4);
+    auto stream = device.create_stream();
+    reset(device, stream);
+}
+
+void QwenGdnHpuState::reset(const Device& device, Stream& stream) {
+    PinnedBuffer zeros = device.allocate_host(floats_ * 4);
+    std::memset(zeros.bytes().data(), 0, floats_ * 4);
+    auto transfer = stream.upload(matrix_, zeros, floats_ * 4);
+    transfer.wait();
+}
+
+std::vector<std::uint16_t> qwen_gdn_hpu_step(
+    const Device& device, Stream& stream, QwenGdnHpuState& state,
+    const QwenGdnHpuConfig& config, std::span<const std::uint16_t> q,
+    std::span<const std::uint16_t> k, std::span<const std::uint16_t> v,
+    std::span<const float> g, std::span<const float> beta) {
+    const std::uint32_t d = config.head_dim;
+    const std::uint32_t hq = config.qk_heads, hv = config.value_heads;
+    if (q.size() != hq * d || k.size() != hq * d || v.size() != hv * d ||
+        g.size() != hv || beta.size() != hv) {
+        throw std::invalid_argument("qwen_gdn_hpu_step: operand width mismatch");
+    }
+
+    // Download the carried state, run the audited recurrence per value head,
+    // publish the state back.
+    PinnedBuffer host_state = device.allocate_host(state.matrix_floats() * 4);
+    auto down = stream.download(host_state, state.matrix(), state.matrix_floats() * 4);
+    down.wait();
+    std::vector<float> S(state.matrix_floats());
+    std::memcpy(S.data(), host_state.bytes().data(), state.matrix_floats() * 4);
+
+    const std::uint32_t group = hv / hq;
+    const float scale = 1.0f / std::sqrt(static_cast<float>(d));
+    const float l2_eps = 1e-6f;
+    std::vector<float> out(hv * d);
+
+    for (std::uint32_t h = 0; h < hv; ++h) {
+        const std::uint32_t qh = h / group;  // the contract's qh = floor(h/G)
+        float* Sh = S.data() + static_cast<std::size_t>(h) * d * d;
+
+        // Per-row L2 normalization (x / sqrt(sum(x^2) + 1e-6)) of the raw
+        // BF16 q/k rows.
+        const std::uint16_t* q_row = q.data() + static_cast<std::size_t>(qh) * d;
+        const std::uint16_t* k_row = k.data() + static_cast<std::size_t>(qh) * d;
+        std::vector<float> qn(d), kn(d);
+        if (config.normalize_qk) {
+            float qs = l2_eps, ks = l2_eps;
+            for (std::uint32_t i = 0; i < d; ++i) {
+                const float qv = bf16_word_to_float(q_row[i]);
+                const float kv = bf16_word_to_float(k_row[i]);
+                qs += qv * qv;
+                ks += kv * kv;
+            }
+            const float qi = 1.0f / std::sqrt(qs);
+            const float ki = 1.0f / std::sqrt(ks);
+            for (std::uint32_t i = 0; i < d; ++i) {
+                qn[i] = bf16_word_to_float(q_row[i]) * qi;
+                kn[i] = bf16_word_to_float(k_row[i]) * ki;
+            }
+        } else {
+            for (std::uint32_t i = 0; i < d; ++i) {
+                qn[i] = bf16_word_to_float(q_row[i]);
+                kn[i] = bf16_word_to_float(k_row[i]);
+            }
+        }
+
+        const float alpha = std::exp(g[h]);
+        const std::uint16_t* v_row = v.data() + static_cast<std::size_t>(h) * d;
+
+        // Row-major S: u = alpha * (S k) row dots; delta = beta * (v - u);
+        // S = alpha * S + outer(delta, k); out = scale * (S q) row dots.
+        // Every access indexes S[i*d + j] with i the row - the update's
+        // outer(delta, k) direction and the two mat-vec reads must agree.
+        std::vector<float> u(d, 0.0f);
+        for (std::uint32_t i = 0; i < d; ++i) {
+            float acc = 0;
+            for (std::uint32_t j = 0; j < d; ++j) {
+                acc += Sh[static_cast<std::size_t>(i) * d + j] * kn[j];
+            }
+            u[i] = alpha * acc;
+        }
+        std::vector<float> delta(d);
+        for (std::uint32_t i = 0; i < d; ++i) {
+            delta[i] = beta[h] * (bf16_word_to_float(v_row[i]) - u[i]);
+        }
+        for (std::uint32_t i = 0; i < d; ++i) {
+            for (std::uint32_t j = 0; j < d; ++j) {
+                Sh[static_cast<std::size_t>(i) * d + j] =
+                    alpha * Sh[static_cast<std::size_t>(i) * d + j] +
+                    delta[i] * kn[j];
+            }
+        }
+        for (std::uint32_t i = 0; i < d; ++i) {
+            float acc = 0;
+            for (std::uint32_t j = 0; j < d; ++j) {
+                acc += Sh[static_cast<std::size_t>(i) * d + j] * qn[j];
+            }
+            out[h * d + i] = scale * acc;
+        }
+    }
+
+    PinnedBuffer host_new = device.allocate_host(state.matrix_floats() * 4);
+    std::memcpy(host_new.bytes().data(), S.data(), state.matrix_floats() * 4);
+    auto up = stream.upload(state.matrix(), host_new, state.matrix_floats() * 4);
+    up.wait();
+
+    std::vector<std::uint16_t> result(hv * d);
+    for (std::uint32_t i = 0; i < hv * d; ++i) {
+        result[i] = float_to_bf16_word(out[i]);
+    }
+    return result;
+}
+
+// ---- Paged KV attention ----
+
+QwenAttnHpuProjections::QwenAttnHpuProjections(const Device& device,
+                                               const QwenAttnHpuConfig& config,
+                                               std::size_t max_workspace_bytes)
+    : wq{device, Bf16GemmShape{1, config.heads * config.head_dim, config.hidden},
+         max_workspace_bytes},
+      wk{device, Bf16GemmShape{1, config.heads * config.head_dim, config.hidden},
+         max_workspace_bytes},
+      wv{device, Bf16GemmShape{1, config.heads * config.head_dim, config.hidden},
+         max_workspace_bytes},
+      wo{device, Bf16GemmShape{1, config.hidden, config.heads * config.head_dim},
+         max_workspace_bytes} {}
+
+std::vector<std::uint16_t> qwen_attn_hpu_decode(
+    const Device& device, Stream& stream, QwenAttnHpuProjections& projections,
+    const QwenAttnHpuWeights& w, PagedKvHpuPool& pool,
+    const QwenAttnHpuConfig& config, std::span<const std::uint16_t> hidden_in,
+    std::uint32_t position) {
+    const std::uint32_t h = config.hidden;
+    const std::uint32_t heads = config.heads;
+    const std::uint32_t d = config.head_dim;
+    if (hidden_in.size() != h) {
+        throw std::invalid_argument("qwen_attn_hpu_decode: hidden_in size mismatch");
+    }
+    if (pool.heads() != heads || pool.head_dim() != d) {
+        throw std::invalid_argument("qwen_attn_hpu_decode: pool geometry mismatch");
+    }
+
+    auto device_project = [&](Bf16Gemm& gemm, const DeviceBuffer& weight,
+                              const std::vector<float>& input,
+                              std::uint32_t in_cols) {
+        const std::uint32_t out_rows = static_cast<std::uint32_t>(gemm.shape().n);
+        PinnedBuffer host_in = device.allocate_host(in_cols * 2);
+        for (std::uint32_t i = 0; i < in_cols; ++i) {
+            const auto word = float_to_bf16_word(input[i]);
+            std::memcpy(host_in.bytes().data() + i * 2, &word, 2);
+        }
+        PinnedBuffer host_out = device.allocate_host(out_rows * 2);
+        DeviceBuffer dev_in = device.allocate_device(in_cols * 2);
+        DeviceBuffer dev_out = device.allocate_device(out_rows * 2);
+        auto up = stream.upload(dev_in, host_in, in_cols * 2);
+        up.wait();
+        auto compute = gemm.launch(stream, dev_in, const_cast<DeviceBuffer&>(weight), dev_out);
+        compute.wait();
+        auto down = stream.download(host_out, dev_out, out_rows * 2);
+        down.wait();
+        std::vector<float> result(out_rows);
+        const auto* words = reinterpret_cast<const std::uint16_t*>(host_out.bytes().data());
+        for (std::uint32_t r = 0; r < out_rows; ++r) {
+            result[r] = bf16_word_to_float(words[r]);
+        }
+        return result;
+    };
+
+    // RMSNorm.
+    std::vector<float> x(h);
+    {
+        PinnedBuffer host_w = device.allocate_host(h * 2);
+        auto dl = stream.download(host_w, const_cast<DeviceBuffer&>(w.norm), h * 2);
+        dl.wait();
+        const auto* words = reinterpret_cast<const std::uint16_t*>(host_w.bytes().data());
+        float square = 0;
+        for (std::uint32_t i = 0; i < h; ++i) {
+            const float value = bf16_word_to_float(hidden_in[i]);
+            square += value * value;
+        }
+        const float inverse = 1.0f / std::sqrt(square / h + config.rms_eps);
+        for (std::uint32_t i = 0; i < h; ++i) {
+            x[i] = bf16_word_to_float(hidden_in[i]) * inverse *
+                   bf16_word_to_float(words[i]);
+        }
+    }
+
+    std::vector<float> q_raw = device_project(projections.wq, w.wq, x, h);
+    std::vector<float> k_raw = device_project(projections.wk, w.wk, x, h);
+    std::vector<float> v_raw = device_project(projections.wv, w.wv, x, h);
+
+    // RoPE on this position's q and k (interleaved halves, the standard
+    // rotate-half form over the full head_dim with theta).
+    auto apply_rope = [&](std::vector<float>& rows) {
+        const float inv_theta_scale = 1.0f / config.rope_theta;
+        for (std::uint32_t head = 0; head < heads; ++head) {
+            float* row = rows.data() + head * d;
+            for (std::uint32_t i = 0; i < d / 2; ++i) {
+                const float freq = std::pow(inv_theta_scale,
+                                            2.0f * i / static_cast<float>(d));
+                const float angle = freq * static_cast<float>(position);
+                const float cos_a = std::cos(angle);
+                const float sin_a = std::sin(angle);
+                const float x0 = row[i];
+                const float x1 = row[i + d / 2];
+                row[i] = x0 * cos_a - x1 * sin_a;
+                row[i + d / 2] = x0 * sin_a + x1 * cos_a;
+            }
+        }
+    };
+    apply_rope(q_raw);
+    apply_rope(k_raw);
+
+    // Append the rotated rows into the pool, then gather the valid prefix.
+    auto to_words = [&](const std::vector<float>& rows) {
+        std::vector<std::uint16_t> words(rows.size());
+        for (std::size_t i = 0; i < rows.size(); ++i) {
+            words[i] = float_to_bf16_word(rows[i]);
+        }
+        return words;
+    };
+    pool.append(device, stream, to_words(k_raw), to_words(v_raw), position);
+    const auto [keys, values] = pool.gather(device, stream, position);
+    const std::uint32_t tokens = position + 1;
+
+    // Softmax attention per head over the gathered prefix.
+    std::vector<float> attn_out(static_cast<std::size_t>(heads) * d);
+    const float scale = 1.0f / std::sqrt(static_cast<float>(d));
+    for (std::uint32_t head = 0; head < heads; ++head) {
+        const float* q_row = q_raw.data() + head * d;
+        std::vector<float> logits(tokens);
+        float maximum = -std::numeric_limits<float>::infinity();
+        for (std::uint32_t t = 0; t < tokens; ++t) {
+            const float* k_row = keys.data() +
+                                 static_cast<std::size_t>(t) * heads * d + head * d;
+            float dot = 0;
+            for (std::uint32_t i = 0; i < d; ++i) {
+                dot += q_row[i] * k_row[i];
+            }
+            logits[t] = dot * scale;
+            maximum = std::max(maximum, logits[t]);
+        }
+        float denominator = 0;
+        for (std::uint32_t t = 0; t < tokens; ++t) {
+            logits[t] = std::exp(logits[t] - maximum);
+            denominator += logits[t];
+        }
+        const float inverse = 1.0f / denominator;
+        float* out_row = attn_out.data() + head * d;
+        for (std::uint32_t i = 0; i < d; ++i) out_row[i] = 0;
+        for (std::uint32_t t = 0; t < tokens; ++t) {
+            const float weight = logits[t] * inverse;
+            const float* v_row = values.data() +
+                                 static_cast<std::size_t>(t) * heads * d + head * d;
+            for (std::uint32_t i = 0; i < d; ++i) {
+                out_row[i] += weight * v_row[i];
+            }
+        }
+    }
+
+    // Output projection on the MME.
+    const std::vector<float> block_out =
+        device_project(projections.wo, w.wo, attn_out, heads * d);
+    std::vector<std::uint16_t> result(h);
+    for (std::uint32_t i = 0; i < h; ++i) {
+        result[i] = float_to_bf16_word(block_out[i]);
+    }
+    return result;
+}
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/qwen_hpu.h b/src/core/gaudi2/qwen_hpu.h
new file mode 100644
index 0000000..fa7238e
--- /dev/null
+++ b/src/core/gaudi2/qwen_hpu.h
@@ -0,0 +1,89 @@
+#pragma once
+// Qwen GDN recurrence and full KV attention decode on the Gaudi2 runtime
+// adapter (gap 5). Both pieces follow the house pattern: matrix projections
+// ride the MME through closed Bf16Gemm recipes, the elementwise/recurrent
+// math runs on the host between launches.
+//
+// qwen_gdn_hpu_step implements the gated delta rule exactly as the engine's
+// audited contract states it (include/ninfer/ops/gated_delta_net.h):
+//   alpha = exp(g[h]); delta = beta * (v - alpha * S k); S = alpha S +
+//   outer(delta, k); out = scale * S q, with per-row L2 normalization of q/k
+// (eps 1e-6) and scale = 1/sqrt(head_dim). The state stays FP32 in HBM.
+//
+// qwen_attn_hpu_decode is standard grouped multi-head attention over the
+// paged KV pool (uniform head count, no GQA on this slice): q/k/v/o on the
+// MME, RoPE and the softmax attention on the host over gathered pages.
+
+#include "core/gaudi2/runtime.h"
+#include "core/gaudi2/paged_kv_hpu.h"
+#include "ops/gaudi2/bf16_gemm.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+
+struct QwenGdnHpuConfig {
+    std::uint32_t head_dim = 128;   // the contract's fixed state width
+    std::uint32_t qk_heads = 0;
+    std::uint32_t value_heads = 0;  // >= qk_heads, divisible by it
+    bool normalize_qk = true;
+};
+
+// One GDN decode step's persistent state: S[head_dim, head_dim] FP32 per
+// value head, HBM-resident, carried across steps.
+class QwenGdnHpuState {
+public:
+    QwenGdnHpuState(const Device& device, const QwenGdnHpuConfig& config);
+    // Re-zeroes every head's matrix (a fresh sequence's starting point).
+    void reset(const Device& device, Stream& stream);
+    [[nodiscard]] DeviceBuffer& matrix() noexcept { return matrix_; }
+    [[nodiscard]] const DeviceBuffer& matrix() const noexcept { return matrix_; }
+    [[nodiscard]] std::size_t matrix_floats() const noexcept { return floats_; }
+
+private:
+    DeviceBuffer matrix_;
+    std::size_t floats_ = 0;
+};
+
+// One token's GDN recurrence. `q`/`k` are [qk_heads * head_dim] BF16 words,
+// `v` [value_heads * head_dim], `g`/`beta` FP32 per value head (g in log
+// space). Returns out [value_heads * head_dim] BF16 words. The math is the
+// gated_delta_net contract verbatim (G = value_heads/qk_heads grouping).
+[[nodiscard]] std::vector<std::uint16_t> qwen_gdn_hpu_step(
+    const Device& device, Stream& stream, QwenGdnHpuState& state,
+    const QwenGdnHpuConfig& config, std::span<const std::uint16_t> q,
+    std::span<const std::uint16_t> k, std::span<const std::uint16_t> v,
+    std::span<const float> g, std::span<const float> beta);
+
+// ---- Full KV attention over the paged pool ----
+
+struct QwenAttnHpuConfig {
+    std::uint32_t hidden, heads, head_dim;
+    float rms_eps;
+    float rope_theta = 1000000.0f;
+};
+
+struct QwenAttnHpuWeights {
+    DeviceBuffer norm;     // BF16 [hidden]
+    DeviceBuffer wq, wk, wv, wo;  // [heads*head_dim, hidden] x3, [hidden, heads*head_dim]
+};
+
+struct QwenAttnHpuProjections {
+    Bf16Gemm wq, wk, wv, wo;
+    QwenAttnHpuProjections(const Device& device, const QwenAttnHpuConfig& config,
+                           std::size_t max_workspace_bytes = 4096);
+};
+
+// One decode step: RMSNorm (host) -> q/k/v (MME) -> RoPE on the appended
+// position (host) -> the token's rows into the pool -> softmax attention
+// over the gathered prefix (host) -> o (MME). Returns [hidden] BF16 words.
+[[nodiscard]] std::vector<std::uint16_t> qwen_attn_hpu_decode(
+    const Device& device, Stream& stream, QwenAttnHpuProjections& projections,
+    const QwenAttnHpuWeights& w, PagedKvHpuPool& pool,
+    const QwenAttnHpuConfig& config, std::span<const std::uint16_t> hidden_in,
+    std::uint32_t position);
+
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/runtime.cpp b/src/core/gaudi2/runtime.cpp
new file mode 100644
index 0000000..ee8614a
--- /dev/null
+++ b/src/core/gaudi2/runtime.cpp
@@ -0,0 +1,290 @@
+#include "runtime.h"
+
+#include <atomic>
+#include <exception>
+#include <limits>
+#include <utility>
+#include <vector>
+
+namespace ninfer::gaudi2 {
+namespace {
+std::atomic_flag session_owned = ATOMIC_FLAG_INIT;
+void check(synStatus status, const char* operation) {
+    if (status != synSuccess) throw SynapseError(status, operation);
+}
+void cleanup(synStatus status) noexcept {
+    // A failed fence cannot justify freeing memory still reachable by DMA. A
+    // native teardown failure is fatal rather than silently releasing/reusing it.
+    if (status != synSuccess) std::terminate();
+}
+void range(std::size_t size, std::size_t offset, std::size_t bytes) {
+    if (!bytes || offset > size || bytes > size - offset)
+        throw std::invalid_argument("Gaudi2 DMA range is empty or outside allocation");
+}
+} // namespace
+
+SynapseError::SynapseError(synStatus status, const char* operation)
+    : std::runtime_error(std::string(operation) + " failed (SynapseAI status " +
+                         std::to_string(static_cast<int>(status)) + ")"), status_(status) {}
+
+namespace detail {
+struct DeviceState {
+    synDeviceId id = 0;
+    DeviceState() {
+        if (session_owned.test_and_set())
+            throw std::logic_error("a native Gaudi2 SynapseAI session already exists");
+        bool initialized = false;
+        try {
+            check(synInitialize(), "synInitialize"); initialized = true;
+            check(synDeviceAcquireByDeviceType(&id, synDeviceGaudi2), "synDeviceAcquireByDeviceType(Gaudi2)");
+        } catch (...) {
+            if (initialized) cleanup(synDestroy());
+            session_owned.clear();
+            throw;
+        }
+    }
+    ~DeviceState() {
+        cleanup(synDeviceRelease(id));
+        cleanup(synDestroy());
+        session_owned.clear();
+    }
+};
+struct DeviceStorage {
+    std::shared_ptr<DeviceState> device;
+    std::uint64_t address = 0;
+    std::size_t size;
+    bool leased = false;
+    DeviceStorage(std::shared_ptr<DeviceState> d, std::size_t n) : device(std::move(d)), size(n) {
+        check(synDeviceMalloc(device->id, size, 0, 0, &address), "synDeviceMalloc");
+    }
+    ~DeviceStorage() { cleanup(synDeviceFree(device->id, address, 0)); }
+};
+struct HostStorage {
+    std::shared_ptr<DeviceState> device;
+    void* address = nullptr;
+    std::size_t size;
+    bool leased = false;
+    HostStorage(std::shared_ptr<DeviceState> d, std::size_t n) : device(std::move(d)), size(n) {
+        check(synHostMalloc(device->id, size, 0, &address), "synHostMalloc");
+    }
+    ~HostStorage() { cleanup(synHostFree(device->id, address, 0)); }
+};
+struct StreamState {
+    std::shared_ptr<DeviceState> device;
+    synStreamHandle handle = nullptr;
+    explicit StreamState(std::shared_ptr<DeviceState> d) : device(std::move(d)) {
+        check(synStreamCreateGeneric(&handle, device->id, 0), "synStreamCreateGeneric");
+    }
+    ~StreamState() {
+        cleanup(synStreamSynchronize(handle));
+        cleanup(synStreamDestroy(handle));
+    }
+};
+struct TransferState {
+    std::shared_ptr<StreamState> stream;
+    std::shared_ptr<DeviceStorage> device;
+    std::shared_ptr<HostStorage> host;
+    synEventHandle event = nullptr;
+    bool leased = false, submitted = false, recorded = false, completed = false;
+    TransferState(std::shared_ptr<StreamState> s, std::shared_ptr<DeviceStorage> d,
+                  std::shared_ptr<HostStorage> h) : stream(std::move(s)), device(std::move(d)), host(std::move(h)) {
+        check(synEventCreate(&event, stream->device->id, 0), "synEventCreate");
+    }
+    void release() noexcept { if (leased) { device->leased = false; host->leased = false; leased = false; } }
+    void wait() {
+        if (!completed && submitted) {
+            check(recorded ? synEventSynchronize(event) : synStreamSynchronize(stream->handle),
+                  recorded ? "synEventSynchronize" : "synStreamSynchronize(after submit failure)");
+        }
+        completed = true;
+        release();
+    }
+    ~TransferState() {
+        if (!completed && submitted)
+            cleanup(recorded ? synEventSynchronize(event) : synStreamSynchronize(stream->handle));
+        release();
+        cleanup(synEventDestroy(event));
+    }
+};
+struct RecipeState {
+    std::shared_ptr<DeviceState> device;
+    synRecipeHandle handle = nullptr;
+    std::shared_ptr<DeviceStorage> workspace;
+    bool leased = false;
+    RecipeState(std::shared_ptr<DeviceState> d, synGraphHandle graph, const char* name,
+                std::size_t max_workspace_bytes) : device(std::move(d)) {
+        check(synGraphCompile(&handle, graph, name, nullptr), "synGraphCompile");
+        try {
+            std::uint64_t bytes = 0;
+            check(synWorkspaceGetSize(&bytes, handle), "synWorkspaceGetSize");
+            if (bytes > max_workspace_bytes || bytes > std::numeric_limits<std::size_t>::max())
+                throw std::length_error("Gaudi2 recipe workspace exceeds its explicit budget");
+            if (bytes) workspace = std::make_shared<DeviceStorage>(device, static_cast<std::size_t>(bytes));
+        } catch (...) { cleanup(synRecipeDestroy(handle)); throw; }
+    }
+    ~RecipeState() { cleanup(synRecipeDestroy(handle)); }
+};
+struct ComputeState {
+    std::shared_ptr<StreamState> stream;
+    std::shared_ptr<RecipeState> recipe;
+    std::vector<std::shared_ptr<DeviceStorage>> buffers;
+    std::vector<synLaunchTensorInfoExt> bindings;
+    synEventHandle event = nullptr;
+    bool leased = false, submitted = false, recorded = false, completed = false;
+    ComputeState(std::shared_ptr<StreamState> s, std::shared_ptr<RecipeState> r)
+        : stream(std::move(s)), recipe(std::move(r)) {
+        check(synEventCreate(&event, stream->device->id, 0), "synEventCreate(compute)");
+    }
+    void release() noexcept {
+        if (!leased) return;
+        for (const auto& buffer : buffers) buffer->leased = false;
+        if (recipe->workspace) recipe->workspace->leased = false;
+        recipe->leased = false; leased = false;
+    }
+    void wait() {
+        if (!completed && submitted)
+            check(recorded ? synEventSynchronize(event) : synStreamSynchronize(stream->handle),
+                  recorded ? "synEventSynchronize(compute)" : "synStreamSynchronize(after launch failure)");
+        completed = true; release();
+    }
+    ~ComputeState() {
+        if (!completed && submitted)
+            cleanup(recorded ? synEventSynchronize(event) : synStreamSynchronize(stream->handle));
+        release(); cleanup(synEventDestroy(event));
+    }
+};
+} // namespace detail
+
+Device::Device() : state_(std::make_shared<detail::DeviceState>()) {}
+DeviceBuffer Device::allocate_device(std::size_t bytes) const {
+    if (!bytes) throw std::invalid_argument("Gaudi2 device allocation must be positive");
+    return DeviceBuffer(std::make_shared<detail::DeviceStorage>(state_, bytes));
+}
+PinnedBuffer Device::allocate_host(std::size_t bytes) const {
+    if (!bytes) throw std::invalid_argument("Gaudi2 pinned allocation must be positive");
+    return PinnedBuffer(std::make_shared<detail::HostStorage>(state_, bytes));
+}
+Stream Device::create_stream() const { return Stream(std::make_shared<detail::StreamState>(state_)); }
+MemoryInfo Device::memory_info() const {
+    MemoryInfo info{};
+    check(synDeviceGetMemoryInfo(state_->id, &info.free_bytes, &info.total_bytes), "synDeviceGetMemoryInfo");
+    return info;
+}
+Recipe Device::compile(synGraphHandle graph, const char* name, std::size_t max_workspace_bytes) const {
+    if (!graph || !name || !*name) throw std::invalid_argument("Gaudi2 compile requires graph and recipe name");
+    return Recipe(std::make_shared<detail::RecipeState>(state_, graph, name, max_workspace_bytes));
+}
+std::size_t Recipe::workspace_bytes() const noexcept {
+    return state_ && state_->workspace ? state_->workspace->size : 0;
+}
+void Recipe::tensor_ids(std::span<const char*> names, std::span<std::uint64_t> ids) const {
+    if (!state_ || names.empty() || names.size() != ids.size() || names.size() > std::numeric_limits<std::uint32_t>::max())
+        throw std::invalid_argument("Gaudi2 tensor id query has invalid recipe or planes");
+    check(synTensorRetrieveIds(state_->handle, names.data(), ids.data(), static_cast<std::uint32_t>(names.size())),
+          "synTensorRetrieveIds");
+}
+std::size_t DeviceBuffer::size() const noexcept { return state_ ? state_->size : 0; }
+std::uint64_t DeviceBuffer::address() const {
+    if (!state_ || state_->leased) throw std::logic_error("Gaudi2 device buffer is empty or leased by queued work");
+    return state_->address;
+}
+std::size_t PinnedBuffer::size() const noexcept { return state_ ? state_->size : 0; }
+std::span<std::byte> PinnedBuffer::bytes() {
+    if (!state_ || state_->leased) throw std::logic_error("Gaudi2 pinned buffer is empty or leased by DMA");
+    return {static_cast<std::byte*>(state_->address), state_->size};
+}
+synStreamHandle Stream::native_handle() const {
+    if (!state_) throw std::logic_error("Gaudi2 stream is empty");
+    return state_->handle;
+}
+void Stream::synchronize() { check(synStreamSynchronize(native_handle()), "synStreamSynchronize"); }
+Transfer Stream::copy(DeviceBuffer& device, PinnedBuffer& host, bool upload, std::size_t bytes,
+                      std::size_t device_offset, std::size_t host_offset) {
+    (void)native_handle();
+    if (!device.state_ || !host.state_ || device.state_->device != state_->device ||
+        host.state_->device != state_->device)
+        throw std::invalid_argument("Gaudi2 DMA resources do not belong to this device");
+    range(device.size(), device_offset, bytes); range(host.size(), host_offset, bytes);
+    if (device.state_->leased || host.state_->leased)
+        throw std::logic_error("Gaudi2 DMA buffer cannot be reused before its fence completes");
+    auto transfer = std::make_unique<detail::TransferState>(state_, device.state_, host.state_);
+    transfer->leased = true; device.state_->leased = true; host.state_->leased = true;
+    const auto d = device.state_->address + device_offset;
+    const auto h = reinterpret_cast<std::uint64_t>(host.state_->address) + host_offset;
+    transfer->submitted = true; // Even a failed submission is drained before releasing either buffer.
+    check(synMemCopyAsync(state_->handle, upload ? h : d, bytes, upload ? d : h,
+                          upload ? HOST_TO_DRAM : DRAM_TO_HOST), "synMemCopyAsync");
+    check(synEventRecord(transfer->event, state_->handle), "synEventRecord");
+    transfer->recorded = true;
+    return Transfer(std::move(transfer));
+}
+Transfer Stream::upload(DeviceBuffer& destination, PinnedBuffer& source, std::size_t bytes,
+                        std::size_t destination_offset, std::size_t source_offset) {
+    return copy(destination, source, true, bytes, destination_offset, source_offset);
+}
+Transfer Stream::download(PinnedBuffer& destination, DeviceBuffer& source, std::size_t bytes,
+                          std::size_t destination_offset, std::size_t source_offset) {
+    return copy(source, destination, false, bytes, source_offset, destination_offset);
+}
+Compute Stream::launch(Recipe& recipe, std::span<const RecipeBinding> bindings) {
+    (void)native_handle();
+    if (!recipe.state_ || recipe.state_->device != state_->device || bindings.empty() ||
+        bindings.size() > std::numeric_limits<std::uint32_t>::max())
+        throw std::invalid_argument("Gaudi2 recipe/bindings do not belong to this device");
+    if (recipe.state_->leased) throw std::logic_error("Gaudi2 recipe/workspace still has an in-flight launch");
+    auto execution = std::make_unique<detail::ComputeState>(state_, recipe.state_);
+    execution->buffers.reserve(bindings.size()); execution->bindings.reserve(bindings.size());
+    for (const auto& binding : bindings) {
+        if (!binding.buffer || !binding.buffer->state_ || binding.buffer->state_->device != state_->device ||
+            !binding.sizes[0] || !binding.sizes[1])
+            throw std::invalid_argument("Gaudi2 recipe binding has an empty/foreign buffer or shape");
+        if (binding.buffer->state_->leased) throw std::logic_error("Gaudi2 compute operand is already leased");
+        const std::uint64_t address = binding.buffer->state_->address + binding.address_offset;
+        for (const auto& previous : execution->bindings)
+            if (previous.tensorId == binding.tensor_id || previous.pTensorAddress == address)
+                throw std::invalid_argument("Gaudi2 recipe bindings alias an id or device allocation");
+        synLaunchTensorInfoExt info{};
+        info.tensorId = binding.tensor_id; info.pTensorAddress = address;
+        info.tensorType = DATA_TENSOR; info.tensorSize[0] = binding.sizes[0]; info.tensorSize[1] = binding.sizes[1];
+        execution->bindings.push_back(info); execution->buffers.push_back(binding.buffer->state_);
+    }
+    execution->leased = true; recipe.state_->leased = true;
+    for (const auto& buffer : execution->buffers) buffer->leased = true;
+    if (recipe.state_->workspace) recipe.state_->workspace->leased = true;
+    execution->submitted = true;
+    check(synLaunchWithExternalEventsExt(state_->handle, execution->bindings.data(),
+          static_cast<std::uint32_t>(execution->bindings.size()),
+          recipe.state_->workspace ? recipe.state_->workspace->address : 0,
+          recipe.state_->handle, nullptr, 0, 0), "synLaunchWithExternalEventsExt");
+    check(synEventRecord(execution->event, state_->handle), "synEventRecord(compute)");
+    execution->recorded = true;
+    return Compute(std::move(execution));
+}
+Transfer::Transfer() = default;
+Transfer::Transfer(std::unique_ptr<detail::TransferState> state) : state_(std::move(state)) {}
+Transfer::~Transfer() = default;
+Transfer::Transfer(Transfer&&) noexcept = default;
+Transfer& Transfer::operator=(Transfer&&) noexcept = default;
+void Transfer::wait() { if (state_) state_->wait(); }
+bool Transfer::ready() {
+    if (!state_ || state_->completed) return true;
+    const auto status = synEventQuery(state_->event);
+    if (status == synBusy) return false;
+    check(status, "synEventQuery");
+    state_->completed = true; state_->release();
+    return true;
+}
+Compute::Compute() = default;
+Compute::Compute(std::unique_ptr<detail::ComputeState> state) : state_(std::move(state)) {}
+Compute::~Compute() = default;
+Compute::Compute(Compute&&) noexcept = default;
+Compute& Compute::operator=(Compute&&) noexcept = default;
+void Compute::wait() { if (state_) state_->wait(); }
+bool Compute::ready() {
+    if (!state_ || state_->completed) return true;
+    const auto status = synEventQuery(state_->event);
+    if (status == synBusy) return false;
+    check(status, "synEventQuery(compute)");
+    state_->completed = true; state_->release(); return true;
+}
+} // namespace ninfer::gaudi2
diff --git a/src/core/gaudi2/runtime.h b/src/core/gaudi2/runtime.h
new file mode 100644
index 0000000..574aa80
--- /dev/null
+++ b/src/core/gaudi2/runtime.h
@@ -0,0 +1,183 @@
+#pragma once
+
+#include <synapse_api.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <array>
+#include <memory>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <utility>
+
+namespace ninfer::gaudi2 {
+class SynapseError : public std::runtime_error {
+public:
+    SynapseError(synStatus status, const char* operation);
+    [[nodiscard]] synStatus status() const noexcept { return status_; }
+private:
+    synStatus status_;
+};
+
+namespace tpc {
+class RmsNorm; class ClampSwiglu; class KdaGate; class KdaScan;
+class MhcGates; class MhcCollapse; class MhcPost; class MhcHead;
+class MoeRoute; class MoeCombine;
+class DsaPool; class DsaScore; class DsaSelect; class DsaAttention;
+class DsaAbsorb; class DsaScale;
+}
+
+namespace detail { struct DeviceState; struct DeviceStorage; struct HostStorage;
+                   struct StreamState; struct TransferState; struct RecipeState; struct ComputeState; }
+class Stream;
+class Transfer;
+class Recipe;
+class Compute;
+class Bf16Gemm;
+
+class DeviceBuffer {
+public:
+    DeviceBuffer() = default;
+    [[nodiscard]] std::size_t size() const noexcept;
+    // Accessors reject pending DMA/compute leases. Returned addresses/spans must
+    // not be used after submitting queued work until its completion is observed.
+    [[nodiscard]] std::uint64_t address() const;
+private:
+    friend class Device; friend class Stream;
+    explicit DeviceBuffer(std::shared_ptr<detail::DeviceStorage> state) : state_(std::move(state)) {}
+    std::shared_ptr<detail::DeviceStorage> state_;
+};
+
+class PinnedBuffer {
+public:
+    PinnedBuffer() = default;
+    [[nodiscard]] std::size_t size() const noexcept;
+    [[nodiscard]] std::span<std::byte> bytes();
+private:
+    friend class Device; friend class Stream;
+    explicit PinnedBuffer(std::shared_ptr<detail::HostStorage> state) : state_(std::move(state)) {}
+    std::shared_ptr<detail::HostStorage> state_;
+};
+
+class Transfer {
+public:
+    Transfer();
+    ~Transfer();
+    Transfer(Transfer&&) noexcept;
+    Transfer& operator=(Transfer&&) noexcept;
+    Transfer(const Transfer&) = delete;
+    Transfer& operator=(const Transfer&) = delete;
+    // A successful event completion releases the leases. Destruction also waits;
+    // dropping the user's buffers/context before a transfer is therefore safe.
+    void wait();
+    [[nodiscard]] bool ready();
+private:
+    friend class Stream;
+    explicit Transfer(std::unique_ptr<detail::TransferState> state);
+    std::unique_ptr<detail::TransferState> state_;
+};
+
+// Physical, compiled SynapseAI recipe with bounded, recipe-owned device workspace.
+class Recipe {
+public:
+    Recipe() = default;
+    [[nodiscard]] std::size_t workspace_bytes() const noexcept;
+    void tensor_ids(std::span<const char*> names, std::span<std::uint64_t> ids) const;
+private:
+    friend class Device; friend class Stream;
+    explicit Recipe(std::shared_ptr<detail::RecipeState> state) : state_(std::move(state)) {}
+    std::shared_ptr<detail::RecipeState> state_;
+};
+
+struct RecipeBinding {
+    std::uint64_t tensor_id;
+    DeviceBuffer* buffer;
+    std::array<std::uint64_t, 2> sizes; // FCD first, matching the fixed graph geometry.
+    // Byte offset into the bound allocation (sub-plane operands, e.g. a
+    // routed expert's row block inside its stacked plane); 0 binds the
+    // whole buffer. The allocation itself stays the lease/ownership unit.
+    std::uint64_t address_offset = 0;
+};
+
+class Compute {
+public:
+    Compute();
+    ~Compute();
+    Compute(Compute&&) noexcept;
+    Compute& operator=(Compute&&) noexcept;
+    Compute(const Compute&) = delete;
+    Compute& operator=(const Compute&) = delete;
+    void wait();
+    [[nodiscard]] bool ready();
+private:
+    friend class Stream;
+    explicit Compute(std::unique_ptr<detail::ComputeState> state);
+    std::unique_ptr<detail::ComputeState> state_;
+};
+
+class Stream {
+public:
+    Stream() = default;
+    void synchronize();
+    [[nodiscard]] synStreamHandle native_handle() const;
+    // External recipe/compute submissions through this handle must retain their
+    // own buffers and fences; Transfer owns only the operands of its DMA copy.
+    [[nodiscard]] Transfer upload(DeviceBuffer& destination, PinnedBuffer& source,
+                                  std::size_t bytes, std::size_t destination_offset = 0,
+                                  std::size_t source_offset = 0);
+    [[nodiscard]] Transfer download(PinnedBuffer& destination, DeviceBuffer& source,
+                                    std::size_t bytes, std::size_t destination_offset = 0,
+                                    std::size_t source_offset = 0);
+private:
+    friend class Device; friend class Bf16Gemm;
+    // TPC kernel bridges in core/gaudi2/tpc/ launch through the same private
+    // path as Bf16Gemm: closed operators that validate their own bindings.
+    friend class tpc::RmsNorm;
+    friend class tpc::ClampSwiglu;
+    friend class tpc::KdaGate;
+    friend class tpc::KdaScan;
+    friend class tpc::MhcGates;
+    friend class tpc::MhcCollapse;
+    friend class tpc::MhcPost;
+    friend class tpc::MhcHead;
+    friend class tpc::MoeRoute;
+    friend class tpc::MoeCombine;
+    friend class tpc::DsaPool;
+    friend class tpc::DsaScore;
+    friend class tpc::DsaSelect;
+    friend class tpc::DsaAttention;
+    friend class tpc::DsaAbsorb;
+    friend class tpc::DsaScale;
+    // Only the closed Op may bind its validated static geometry. This is not an
+    // unchecked public tensor/graph execution interface.
+    [[nodiscard]] Compute launch(Recipe& recipe, std::span<const RecipeBinding> bindings);
+    explicit Stream(std::shared_ptr<detail::StreamState> state) : state_(std::move(state)) {}
+    [[nodiscard]] Transfer copy(DeviceBuffer&, PinnedBuffer&, bool upload, std::size_t,
+                                std::size_t device_offset, std::size_t host_offset);
+    std::shared_ptr<detail::StreamState> state_;
+};
+
+struct MemoryInfo { std::uint64_t free_bytes; std::uint64_t total_bytes; };
+
+// One standalone native SynapseAI owner per process. It must not coexist with an
+// independently initialized PyTorch/SynapseAI session. Resources retain ownership.
+// Calls on these objects are serialized by the owning runner thread; they are not
+// a concurrent allocator or general multi-device runtime.
+class Device {
+public:
+    Device();
+    Device(const Device&) = default;
+    Device& operator=(const Device&) = default;
+    Device(Device&&) = delete;
+    Device& operator=(Device&&) = delete;
+    [[nodiscard]] DeviceBuffer allocate_device(std::size_t bytes) const;
+    [[nodiscard]] PinnedBuffer allocate_host(std::size_t bytes) const;
+    [[nodiscard]] Stream create_stream() const;
+    [[nodiscard]] MemoryInfo memory_info() const;
+    [[nodiscard]] Recipe compile(synGraphHandle graph, const char* name,
+                                  std::size_t max_workspace_bytes) const;
+private:
+    std::shared_ptr<detail::DeviceState> state_;
+};
+} // namespace ninfer::gaudi2
