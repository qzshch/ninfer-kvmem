diff --git a/tests/ops/test_glm5_mhc.cu b/tests/ops/test_glm5_mhc.cu
new file mode 100644
index 0000000..faae966
--- /dev/null
+++ b/tests/ops/test_glm5_mhc.cu
@@ -0,0 +1,189 @@
+// GLM-5.3-Flash mHC ops against the ported host reference (models/glm5/reference), on the
+// device. A small hidden pins the semantics including the Sinkhorn iteration count; the
+// audited 16384-wide profile runs one full pre/post/head chain.
+#include "ninfer/ops/glm5_mhc.h"
+#include "models/glm5/reference/mhc_reference.h"
+
+#include "core/device.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace ninfer;
+using namespace ninfer::ops;
+namespace Reference = ninfer::models::glm5::reference;
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 17u) - 8) / 8.0f;
+}
+
+std::vector<__nv_bfloat16> round_trip(const std::vector<float>& values) {
+    std::vector<__nv_bfloat16> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __float2bfloat16(values[i]); }
+    return out;
+}
+std::vector<float> represented(const std::vector<__nv_bfloat16>& values) {
+    std::vector<float> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __bfloat162float(values[i]); }
+    return out;
+}
+
+test::GuardedDeviceBuffer upload(const void* data, std::size_t bytes) {
+    test::GuardedDeviceBuffer buffer(bytes);
+    buffer.copy_from_host(data, bytes);
+    return buffer;
+}
+template <typename T> test::GuardedDeviceBuffer upload(const std::vector<T>& values) {
+    return upload(values.data(), values.size() * sizeof(T));
+}
+template <typename T> std::vector<T> download(const test::GuardedDeviceBuffer& buffer) {
+    std::vector<T> out(buffer.bytes() / sizeof(T));
+    buffer.copy_to_host(out.data(), out.size() * sizeof(T));
+    return out;
+}
+
+int failures = 0;
+
+void check_close(const std::string& what, const std::vector<float>& got,
+                 const std::vector<float>& want, float tolerance) {
+    if (got.size() != want.size()) {
+        std::fprintf(stderr, "%s: size %zu vs %zu\n", what.c_str(), got.size(), want.size());
+        ++failures;
+        return;
+    }
+    for (std::size_t i = 0; i < got.size(); ++i) {
+        const float error = std::abs(got[i] - want[i]);
+        const float scale = std::max(1.0f, std::abs(want[i]));
+        if (error > tolerance * scale) {
+            if (failures < 10) {
+                std::fprintf(stderr, "%s[%zu]: %.7g vs %.7g\n", what.c_str(), i, got[i], want[i]);
+            }
+            ++failures;
+        }
+    }
+}
+
+void run_case(std::uint32_t hidden, std::uint32_t tokens) {
+    const Reference::MhcProfile profile{4, 1e-5f, 1e-6f, 20};
+    const std::uint32_t hc = 4, lanes = 24, plane = hc * hidden;
+    const std::string label = "h" + std::to_string(hidden);
+
+    std::vector<float> streams(tokens * plane), fn(lanes * plane), base(lanes),
+        scale{0.7f, 0.5f, 0.9f}, block(tokens * hidden);
+    for (std::size_t i = 0; i < streams.size(); ++i) {
+        streams[i] = source(static_cast<std::uint32_t>(i) * 3 + 1) / 4;
+    }
+    for (std::size_t i = 0; i < fn.size(); ++i) { fn[i] = source(static_cast<std::uint32_t>(i) + 2) / 16; }
+    for (std::size_t i = 0; i < base.size(); ++i) { base[i] = source(static_cast<std::uint32_t>(i) * 5 + 3) / 8; }
+    for (std::size_t i = 0; i < block.size(); ++i) { block[i] = source(static_cast<std::uint32_t>(i) * 7 + 2) / 3; }
+
+    // Host reference on the represented (rounded) inputs.
+    std::vector<float> pre_want(tokens * hc), post_want(tokens * hc), comb_want(tokens * hc * hc),
+        collapsed_want(tokens * hidden);
+    Reference::mhc_pre_reference(represented(round_trip(streams)), represented(round_trip(fn)),
+                                 base, scale, pre_want, post_want, comb_want, collapsed_want,
+                                 profile, hidden);
+
+    auto d_streams = upload(round_trip(streams));
+    auto d_fn = upload(round_trip(fn));
+    auto d_base = upload(base);
+    auto d_scale = upload(scale);
+    test::GuardedDeviceBuffer d_pre(pre_want.size() * sizeof(float));
+    test::GuardedDeviceBuffer d_post(post_want.size() * sizeof(float));
+    test::GuardedDeviceBuffer d_comb(comb_want.size() * sizeof(float));
+    test::GuardedDeviceBuffer d_collapsed(collapsed_want.size() * sizeof(__nv_bfloat16));
+    {
+        Tensor st(const_cast<void*>(d_streams.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(plane)});
+        Tensor ft(const_cast<void*>(d_fn.data()), DType::BF16,
+                  {static_cast<std::int32_t>(lanes), static_cast<std::int32_t>(plane)});
+        Tensor bt(const_cast<void*>(d_base.data()), DType::FP32, {static_cast<std::int32_t>(lanes)});
+        Tensor sc(const_cast<void*>(d_scale.data()), DType::FP32, {3});
+        Tensor pt(const_cast<void*>(d_pre.data()), DType::FP32,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hc)});
+        Tensor pot(const_cast<void*>(d_post.data()), DType::FP32,
+                   {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hc)});
+        Tensor ct(const_cast<void*>(d_comb.data()), DType::FP32,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hc), static_cast<std::int32_t>(hc)});
+        Tensor co(const_cast<void*>(d_collapsed.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hidden)});
+        glm5_mhc_pre(st, ft, bt, sc, 1e-5f, 1e-6f, 20, pt, pot, ct, co, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("pre[" + label + "]", download<float>(d_pre), pre_want, 2e-4f);
+    check_close("post[" + label + "]", download<float>(d_post), post_want, 2e-4f);
+    check_close("comb[" + label + "]", download<float>(d_comb), comb_want, 2e-3f);
+    check_close("collapsed[" + label + "]", represented(download<__nv_bfloat16>(d_collapsed)),
+                collapsed_want, 2e-2f);
+
+    // Post + head.
+    std::vector<float> post_out_want(tokens * plane);
+    Reference::mhc_post_reference(block, represented(round_trip(streams)), post_want, comb_want,
+                                  post_out_want, profile, hidden);
+    std::vector<float> head_want(tokens * hidden);
+    Reference::mhc_head_reference(post_out_want, head_want, profile, hidden);
+
+    auto d_block = upload(round_trip(block));
+    auto d_post_in = upload(post_want);
+    auto d_comb_in = upload(comb_want);
+    auto d_residual = upload(round_trip(streams));
+    test::GuardedDeviceBuffer d_streams_out(tokens * plane * sizeof(__nv_bfloat16));
+    test::GuardedDeviceBuffer d_head(tokens * hidden * sizeof(__nv_bfloat16));
+    {
+        Tensor bt(const_cast<void*>(d_block.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hidden)});
+        Tensor rt(const_cast<void*>(d_residual.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(plane)});
+        Tensor pt(const_cast<void*>(d_post_in.data()), DType::FP32,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hc)});
+        Tensor ct(const_cast<void*>(d_comb_in.data()), DType::FP32,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hc), static_cast<std::int32_t>(hc)});
+        Tensor ot(const_cast<void*>(d_streams_out.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(plane)});
+        glm5_mhc_post(bt, rt, pt, ct, ot, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+        Tensor ht(const_cast<void*>(d_head.data()), DType::BF16,
+                  {static_cast<std::int32_t>(tokens), static_cast<std::int32_t>(hidden)});
+        glm5_mhc_head(ot, ht, nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    check_close("post[" + label + "]", represented(download<__nv_bfloat16>(d_streams_out)),
+                post_out_want, 2e-2f);
+    check_close("head[" + label + "]", represented(download<__nv_bfloat16>(d_head)), head_want,
+                2e-2f);
+}
+
+int run() {
+    run_case(32, 3);        // small probe
+    run_case(4096, 2);      // the audited hidden width
+    if (failures == 0) {
+        std::puts("GLM5 mHC pre/post/head kernels match the host reference on device");
+        return 0;
+    }
+    std::fprintf(stderr, "%d numeric failures\n", failures);
+    return 1;
+}
+
+} // namespace
+
+int main() {
+    try {
+        return run();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "FATAL: %s\n", error.what());
+        return 1;
+    } catch (...) {
+        std::fprintf(stderr, "FATAL: unknown exception\n");
+        return 1;
+    }
+}
