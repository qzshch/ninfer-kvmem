+#pragma once
+
+// ninfer::ops - GLM-5.3-Flash MLP kernels: the clamped SwiGLU, the sigmoid/noaux_tc router
+// and the expert combination. Math follows models/glm5/reference (expert_forward and
+// routing_reference semantics: gate upper-clamped only, up clamped both sides; the router's
+// correction bias participates ONLY in selection).
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+namespace glm5_mlp_detail {
+
+constexpr int kThreads = 256;
+
+__device__ __forceinline__ float sigmoid_f(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+__global__ void swiglu_kernel(const __nv_bfloat16* __restrict__ gate,
+                              const __nv_bfloat16* __restrict__ up, float limit,
+                              std::int64_t elements, __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    const float g = __bfloat162float(gate[index]);
+    const float u = __bfloat162float(up[index]);
+    const float clamped_gate = fminf(g, limit);
+    const float clamped_up = fminf(fmaxf(u, -limit), limit);
+    out[index] = __float2bfloat16(clamped_gate * sigmoid_f(clamped_gate) * clamped_up);
+}
+
+// One block: iterative argmax over score+bias, top_k rounds (ties by lower index), then the
+// normalized original scores of the selected experts.
+__global__ void route_kernel(const __nv_bfloat16* __restrict__ logits,
+                             const float* __restrict__ correction_bias, std::int32_t experts,
+                             std::int32_t top_k, float scaling, float* __restrict__ weights,
+                             std::int32_t* __restrict__ indices) {
+    extern __shared__ float s_score[];   // [experts]
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    for (std::int32_t e = tid; e < experts; e += blockDim.x) {
+        s_score[e] = sigmoid_f(__bfloat162float(logits[e])) + correction_bias[e];
+    }
+    __syncthreads();
+    __shared__ float s_val[kThreads];
+    __shared__ std::int32_t s_idx[kThreads];
+    __shared__ float s_sum;
+    if (tid == 0) { s_sum = 0.0f; }
+    const std::int32_t picks = min(top_k, experts);
+    for (std::int32_t rank = 0; rank < picks; ++rank) {
+        float best_value = -3.0e38f;
+        std::int32_t best_index = 0x7fffffff;
+        for (std::int32_t e = tid; e < experts; e += blockDim.x) {
+            if (s_score[e] > best_value) {
+                best_value = s_score[e];
+                best_index = e;
+            }
+        }
+        s_val[tid] = best_value;
+        s_idx[tid] = best_index;
+        __syncthreads();
+        if (tid == 0) {
+            float value = -3.0e38f;
+            std::int32_t index = 0x7fffffff;
+            for (std::int32_t i = 0; i < kThreads; ++i) {
+                if (s_val[i] > value || (s_val[i] == value && s_idx[i] < index)) {
+                    value = s_val[i];
+                    index = s_idx[i];
+                }
+            }
+            s_idx[0] = index;
+            s_val[0] = value;
+        }
+        __syncthreads();
+        const std::int32_t winner = s_idx[0];
+        __syncthreads();
+        // Recover the ORIGINAL sigmoid score of the winner (bias removed) for the weights.
+        if (tid == 0) {
+            const float original = s_score[winner] - correction_bias[winner];
+            indices[rank] = winner;
+            weights[rank] = original;
+            s_sum += original;
+            s_score[winner] = -3.0e38f;
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        const float inverse = scaling / (s_sum + 1e-20f);
+        for (std::int32_t i = 0; i < picks; ++i) { weights[i] *= inverse; }
+    }
+}
+
+// One thread per output element.
+__global__ void combine_kernel(const __nv_bfloat16* __restrict__ experts,
+                               const float* __restrict__ weights,
+                               const __nv_bfloat16* __restrict__ shared, std::int32_t hidden,
+                               std::int32_t top_k, std::int64_t elements,
+                               __nv_bfloat16* __restrict__ out) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    float acc = __bfloat162float(shared[index]);
+    for (std::int32_t i = 0; i < top_k; ++i) {
+        acc = fmaf(weights[i], __bfloat162float(experts[static_cast<std::int64_t>(i) * hidden + index]), acc);
+    }
+    out[index] = __float2bfloat16(acc);
+}
+
+} // namespace glm5_mlp_detail
+} // namespace ninfer::ops
