diff --git a/src/models/glm5/reference/dsa_reference.cpp b/src/models/glm5/reference/dsa_reference.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d86410c0ee0bc76ea71c5634804effe88c5c4f18
--- /dev/null
+++ b/src/models/glm5/reference/dsa_reference.cpp
@@ -0,0 +1,227 @@
+#include "models/glm5/reference/dsa_reference.h"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "GLM DSA reference requires IEEE-754 binary32");
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("DSA reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+
+size_t token_count(std::span<const float> plane, size_t per_token, const char* what) {
+    if (per_token == 0 || plane.size() % per_token != 0)
+        throw std::invalid_argument(what);
+    return plane.size() / per_token;
+}
+}  // namespace
+
+void dsa_pool_reference(std::span<const float> keys, std::span<const float> gates,
+                        std::span<const float> ape, std::span<float> pooled,
+                        const DsaIndexerProfile& profile) {
+    const size_t dim = profile.head_dim;
+    const size_t kpool = profile.kpool;
+    if (dim == 0 || kpool == 0 || profile.top_k == 0 || profile.top_k % kpool)
+        throw std::invalid_argument("DSA indexer profile is degenerate");
+    const size_t tokens = token_count(keys, dim, "DSA keys are not whole token planes");
+    if (gates.size() != keys.size() || ape.size() != checked_mul(kpool, dim))
+        throw std::invalid_argument("DSA pool gate/ape plane mismatch");
+    if (tokens == 0 || tokens % kpool)
+        throw std::invalid_argument("DSA pooling requires tokens to be a positive multiple of kpool");
+    const size_t pools = tokens / kpool;
+    if (pooled.size() != checked_mul(pools, dim))
+        throw std::invalid_argument("DSA pooled plane does not match the pool count");
+    demand_finite(keys, "DSA keys must be finite");
+    demand_finite(gates, "DSA gates must be finite");
+    demand_finite(ape, "DSA ape must be finite");
+
+    for (size_t p = 0; p < pools; ++p)
+        for (size_t e = 0; e < dim; ++e) {
+            float logits[8], maximum = 0;
+            if (kpool > 8) throw std::invalid_argument("DSA pooling pins kpool at 8 members or fewer");
+            for (size_t m = 0; m < kpool; ++m) {
+                logits[m] = gates[(p * kpool + m) * dim + e] + ape[m * dim + e];
+                if (m == 0 || logits[m] > maximum) maximum = logits[m];
+            }
+            float denominator = 0, exps[8];
+            for (size_t m = 0; m < kpool; ++m) {
+                exps[m] = std::exp(logits[m] - maximum);
+                denominator += exps[m];
+            }
+            const float inverse = 1.0f / denominator;
+            float acc = 0;
+            for (size_t m = 0; m < kpool; ++m)
+                acc = std::fma(exps[m] * inverse, keys[(p * kpool + m) * dim + e], acc);
+            if (!std::isfinite(acc)) throw std::overflow_error("DSA pooling overflowed");
+            pooled[p * dim + e] = acc;
+        }
+}
+
+void dsa_score_reference(std::span<const float> iq, std::span<const float> weights,
+                         std::span<const float> pooled, std::span<float> scores,
+                         const DsaIndexerProfile& profile) {
+    const size_t heads = profile.heads;
+    const size_t dim = profile.head_dim;
+    const size_t head_plane = checked_mul(heads, dim);
+    const size_t tokens = token_count(iq, head_plane, "DSA iq is not whole token planes");
+    const size_t pools = token_count(pooled, dim, "DSA pooled is not whole pool planes");
+    if (weights.size() != checked_mul(tokens, heads))
+        throw std::invalid_argument("DSA weights must hold one value per token and head");
+    if (scores.size() != checked_mul(tokens, pools))
+        throw std::invalid_argument("DSA score plane does not match tokens x pools");
+    if (tokens == 0) throw std::invalid_argument("DSA scoring requires at least one token");
+    demand_finite(iq, "DSA iq must be finite");
+    demand_finite(weights, "DSA weights must be finite");
+    demand_finite(pooled, "DSA pooled must be finite");
+
+    const float dot_scale = 1.0f / std::sqrt(static_cast<float>(dim));
+    const float head_scale = 1.0f / std::sqrt(static_cast<float>(heads));
+    for (size_t t = 0; t < tokens; ++t)
+        for (size_t p = 0; p < pools; ++p) {
+            float acc = 0;
+            for (size_t h = 0; h < heads; ++h) {
+                const float* q = iq.data() + t * head_plane + h * dim;
+                const float* key = pooled.data() + p * dim;
+                float dot = 0;
+                for (size_t e = 0; e < dim; ++e) dot = std::fma(q[e], key[e], dot);
+                acc = std::fma(std::fmax(dot * dot_scale, 0.0f),
+                               weights[t * heads + h] * head_scale, acc);
+            }
+            if (!std::isfinite(acc)) throw std::overflow_error("DSA scoring overflowed");
+            scores[t * pools + p] = acc;
+        }
+}
+
+void dsa_select_reference(std::span<const float> scores, std::span<const uint32_t> pos,
+                          std::span<int32_t> cells, const DsaIndexerProfile& profile) {
+    const size_t kpool = profile.kpool;
+    const size_t tokens = pos.size();
+    const size_t top_pools = dsa_top_pools(profile);
+    const size_t width = dsa_selection_width(profile);
+    if (tokens == 0) throw std::invalid_argument("DSA selection requires at least one token");
+    if (scores.size() % tokens != 0)
+        throw std::invalid_argument("DSA score plane does not match the position count");
+    const size_t pools = scores.size() / tokens;
+    if (cells.size() != checked_mul(tokens, width))
+        throw std::invalid_argument("DSA cell plane does not match the selection width");
+    if (pools == 0) throw std::invalid_argument("DSA selection requires at least one scored pool");
+    demand_finite(scores, "DSA scores must be finite");
+    for (const auto position : pos)
+        if ((position + 1) / kpool > pools)
+            throw std::invalid_argument("DSA position sees more pools than were scored");
+
+    // 2051 is the production width; a generous bound keeps narrower probe
+    // profiles testable without dynamic allocation.
+    constexpr size_t kMaxSelectionWidth = 4096;
+    if (width > kMaxSelectionWidth)
+        throw std::invalid_argument("DSA selection width exceeds the staging bound");
+    for (size_t t = 0; t < tokens; ++t) {
+        const size_t visible = (pos[t] + 1) / kpool;
+        int32_t row[kMaxSelectionWidth];
+        for (size_t s = 0; s < width; ++s) row[s] = -1;
+
+        for (size_t p = 0; p < visible; ++p) {
+            const float value = scores[t * pools + p];
+            size_t rank = 0;
+            for (size_t q = 0; q < visible; ++q) {
+                const float other = scores[t * pools + q];
+                if (other > value) ++rank;
+                else if (q < p && other == value) ++rank;
+            }
+            if (rank < top_pools)
+                for (size_t m = 0; m < kpool; ++m) row[rank * kpool + m] = static_cast<int32_t>(p * kpool + m);
+        }
+        if (profile.select_tail)
+            for (size_t m = 0; m + 1 < kpool; ++m) {
+                const size_t cell = visible * kpool + m;
+                if (cell <= pos[t]) row[top_pools * kpool + m] = static_cast<int32_t>(cell);
+            }
+        for (size_t s = 0; s < width; ++s) cells[t * width + s] = row[s];
+    }
+}
+
+void dsa_attention_reference(std::span<const float> q_abs, std::span<const float> latents,
+                             std::span<const int32_t> cells, std::span<const float> wv_b,
+                             std::span<float> out, const DsaIndexerProfile& indexer,
+                             const DsaMlaProfile& mla, size_t cache_tokens) {
+    const size_t lora = mla.kv_lora;
+    const size_t heads = mla.heads;
+    const size_t v_head = mla.v_head;
+    const size_t head_plane = checked_mul(lora, heads);
+    const size_t tokens = token_count(q_abs, head_plane, "DSA q_abs is not whole token planes");
+    const size_t width = dsa_selection_width(indexer);
+    if (cells.size() != checked_mul(tokens, width))
+        throw std::invalid_argument("DSA cells do not match tokens x selection width");
+    if (latents.size() != checked_mul(cache_tokens, lora))
+        throw std::invalid_argument("DSA latents do not match the cache token count");
+    if (wv_b.size() != checked_mul(checked_mul(lora, v_head), heads))
+        throw std::invalid_argument("DSA wv_b does not match the GGUF geometry");
+    if (out.size() != checked_mul(tokens, checked_mul(heads, v_head)))
+        throw std::invalid_argument("DSA output does not match tokens x heads x v_head");
+    if (tokens == 0 || cache_tokens == 0)
+        throw std::invalid_argument("DSA attention requires tokens and cache");
+    demand_finite(q_abs, "DSA q_abs must be finite");
+    demand_finite(latents, "DSA latents must be finite");
+    demand_finite(wv_b, "DSA wv_b must be finite");
+    for (const auto cell : cells)
+        if (cell < -1 || cell >= static_cast<int64_t>(cache_tokens))
+            throw std::invalid_argument("DSA cell is outside the cache");
+
+    const float scale = 1.0f / std::sqrt(static_cast<float>(mla.qk_nope));
+    std::vector<float> probabilities(width), context(lora), staged(heads * v_head);
+    for (size_t t = 0; t < tokens; ++t) {
+        const int32_t* row = cells.data() + t * width;
+        for (size_t s = 0; s < width; ++s) probabilities[s] = 0.0f;
+        for (size_t h = 0; h < heads; ++h) {
+            const float* q = q_abs.data() + t * head_plane + h * lora;
+            float maximum = 0;
+            bool any = false;
+            for (size_t s = 0; s < width; ++s) {
+                if (row[s] < 0) continue;
+                const float* latent = latents.data() + static_cast<size_t>(row[s]) * lora;
+                float dot = 0;
+                for (size_t e = 0; e < lora; ++e) dot = std::fma(q[e], latent[e], dot);
+                probabilities[s] = dot * scale;
+                if (!any || probabilities[s] > maximum) { maximum = probabilities[s]; any = true; }
+            }
+            if (!any) throw std::invalid_argument("DSA attention row has no valid cell");
+            float denominator = 0;
+            for (size_t s = 0; s < width; ++s)
+                if (row[s] >= 0) {
+                    probabilities[s] = std::exp(probabilities[s] - maximum);
+                    denominator += probabilities[s];
+                }
+            const float inverse = 1.0f / denominator;
+            for (size_t e = 0; e < lora; ++e) context[e] = 0.0f;
+            for (size_t s = 0; s < width; ++s)
+                if (row[s] >= 0) {
+                    const float* latent = latents.data() + static_cast<size_t>(row[s]) * lora;
+                    const float weight = probabilities[s] * inverse;
+                    for (size_t e = 0; e < lora; ++e) context[e] = std::fma(weight, latent[e], context[e]);
+                }
+            // out[t][h][v] = sum_c wv_b[c + lora*v + lora*v_head*h] * context[c]
+            for (size_t v = 0; v < v_head; ++v) {
+                const float* column = wv_b.data() + static_cast<size_t>(lora * v + lora * v_head * h);
+                float acc = 0;
+                for (size_t c = 0; c < lora; ++c) acc = std::fma(column[c], context[c], acc);
+                if (!std::isfinite(acc)) throw std::overflow_error("DSA attention overflowed");
+                staged[h * v_head + v] = acc;
+            }
+        }
+        for (size_t i = 0; i < staged.size(); ++i) out[t * heads * v_head + i] = staged[i];
+    }
+}
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/dsa_reference.h b/src/models/glm5/reference/dsa_reference.h
new file mode 100644
index 0000000000000000000000000000000000000000..c9a3fac9dd5c6e4e9d62118eb98c8464f32b3226
--- /dev/null
+++ b/src/models/glm5/reference/dsa_reference.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kDsaReferenceProfile = "glm53_dsa_fp32";
+
+// GLM-5.3-Flash's audited DSA indexer geometry: 32 index heads of 128, pools
+// of 4 tokens, a 2048-token selection budget (512 pools) plus the mandatory
+// 3-slot incomplete tail, giving the fixed 2051-wide selection rows.
+struct DsaIndexerProfile {
+    uint32_t heads;
+    uint32_t head_dim;
+    uint32_t kpool;
+    uint32_t top_k;
+    bool select_tail;
+};
+inline constexpr DsaIndexerProfile kGlm53DsaIndexerProfile{32, 128, 4, 2048, true};
+
+[[nodiscard]] constexpr uint32_t dsa_top_pools(const DsaIndexerProfile& p) {
+    return p.top_k / p.kpool;  // 2048/4 = 512
+}
+[[nodiscard]] constexpr size_t dsa_selection_width(const DsaIndexerProfile& p) {
+    return p.select_tail ? size_t(p.top_k) + p.kpool - 1 : size_t(p.top_k);
+}
+
+// Pool compression over COMPLETE pools: pool p covers tokens [p*kpool,
+// p*kpool+kpool). pooled[p][e] = sum_m softmax_m(gates[p*kpool+m][e] +
+// ape[m][e]) * keys[p*kpool+m][e] where the softmax runs SEPARATELY PER
+// KEY-DIM ELEMENT over the pool members - the parity-pinned quirk; a whole-row
+// softmax is the natural wrong reading. Stable max-subtracted softmax in FP32.
+// tokens must be a positive multiple of kpool (the caller keeps the tail);
+// ape is [kpool][head_dim]. Everything validates before any output is written.
+void dsa_pool_reference(std::span<const float> keys, std::span<const float> gates,
+                        std::span<const float> ape, std::span<float> pooled,
+                        const DsaIndexerProfile&);
+
+// index_scores[t][p] = sum_h relu(iq[t][h] . pooled[p] * head_dim^-0.5) *
+// (weights[t][h] * heads^-0.5), all FP32. The two scale factors follow the
+// transformers placement (inside the ReLU / on the head weights); llama.cpp
+// and Maya pre-multiply 1/sqrt(head_dim*heads) onto the weights instead,
+// which is the same product in exact arithmetic and differs only in rounding.
+// iq is [tokens][heads][head_dim], weights [tokens][heads].
+void dsa_score_reference(std::span<const float> iq, std::span<const float> weights,
+                         std::span<const float> pooled, std::span<float> scores,
+                         const DsaIndexerProfile&);
+
+// Selection for one sequence of aligned pools: token t at GLOBAL position
+// pos[t] sees the first n_vis = (pos[t]+1)/kpool completed pools (pool p is
+// visible iff its last member p*kpool+kpool-1 <= pos[t]; the tail includes the
+// query token itself). Visible pools are ranked stable-descending with exact
+// ties broken by lower pool index; the pool at rank r occupies slots
+// [r*kpool, r*kpool+kpool) with its member cells in position order (slot
+// order IS score order). The incomplete tail (cells n_vis*kpool .. pos[t])
+// then fills [top_pools*kpool, ...) in position order when select_tail.
+// Every unused slot is -1. Output rows have the fixed dsa_selection_width.
+// pools is the completed-pool count of scores' second axis; n_vis must stay
+// <= pools. scores/pos/cells inputs must be finite/valid; cells publish per
+// token after the whole row validates.
+void dsa_select_reference(std::span<const float> scores, std::span<const uint32_t> pos,
+                          std::span<int32_t> cells, const DsaIndexerProfile&);
+
+// GLM-5.3-Flash's audited absorbed-MLA geometry: 512 latent, 64 heads, 256
+// nope score dim (also the softmax scale base) and 256 value dim. NoPE only.
+struct DsaMlaProfile {
+    uint32_t kv_lora;
+    uint32_t heads;
+    uint32_t qk_nope;
+    uint32_t v_head;
+};
+inline constexpr DsaMlaProfile kGlm53DsaMlaProfile{512, 64, 256, 256};
+
+// Absorbed sparse attention over one layer's selection rows.
+// q_abs is [tokens][heads][kv_lora] (queries already absorbed through
+// W_K_B: q_abs = W_K_B_h^T q_h), latents [cache][kv_lora] (the only cached
+// per-token state; no per-head K/V exists), cells [tokens][selection_width]
+// with -1 padding from dsa_select_reference, and wv_b the GGUF tensor
+// {kv_lora, v_head, heads}: wv_b[c + kv_lora*v + kv_lora*v_head*h].
+// Per token and head: score_s = (q_abs . latent_{cells[s]}) * qk_nope^-0.5
+// (the model constant 256^-0.5, NOT kv_lora^-0.5); softmax EXCLUDES the -1
+// slots entirely (numerically the graph's -inf additive mask); ctx accumulates
+// only over valid slots; out[t][h][v] = sum_c wv_b[c,v,h] * ctx[c]. Output
+// is [tokens][heads][v_head]. Inputs validate first; out publishes per token
+// once the whole token's values are finite.
+void dsa_attention_reference(std::span<const float> q_abs, std::span<const float> latents,
+                             std::span<const int32_t> cells, std::span<const float> wv_b,
+                             std::span<float> out, const DsaIndexerProfile&,
+                             const DsaMlaProfile&, size_t cache_tokens);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/kda_chunk_reference.cpp b/src/models/glm5/reference/kda_chunk_reference.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2b0d5316c51d250984616037e4a51483dc8c1fb0
--- /dev/null
+++ b/src/models/glm5/reference/kda_chunk_reference.cpp
@@ -0,0 +1,189 @@
+#include "models/glm5/reference/kda_chunk_reference.h"
+
+#include <array>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+constexpr float kL2Eps = 1e-6f;
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("KDA chunk reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+}  // namespace
+
+void kda_chunk_reference(std::span<const float> q, std::span<const float> k,
+                         std::span<const float> v, std::span<const float> gate,
+                         std::span<const float> beta, std::span<float> state,
+                         std::span<float> out, std::span<float> scratch, const KdaProfile& profile,
+                         uint32_t chunk) {
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t dk = profile.head_dim;
+    const size_t state_values = kda_state_values(profile);
+    if (d_inner == 0 || q.size() % d_inner != 0)
+        throw std::invalid_argument("KDA chunk query is not a whole token plane");
+    const size_t tokens = q.size() / d_inner;
+    if (chunk == 0 || chunk > kKdaMaxChunk || tokens % chunk != 0)
+        throw std::invalid_argument("KDA chunk requires tokens to be a positive multiple of chunk");
+    if (k.size() != q.size() || v.size() != q.size() || gate.size() != q.size())
+        throw std::invalid_argument("KDA chunk k/v/gate planes must match the query plane");
+    if (beta.size() != checked_mul(tokens, profile.heads))
+        throw std::invalid_argument("KDA chunk beta must hold one value per token and head");
+    if (state.size() != state_values)
+        throw std::invalid_argument("KDA chunk state does not match the profile");
+    if (out.size() != q.size()) throw std::invalid_argument("KDA chunk output size mismatch");
+    if (scratch.size() != kda_chunk_scratch_values(profile, tokens, chunk))
+        throw std::invalid_argument("KDA chunk scratch does not match the requirement");
+    if (tokens == 0) throw std::invalid_argument("KDA chunk requires at least one token");
+    for (const auto* plane : {&q, &k, &v, &gate, &beta})
+        demand_finite(*plane, "KDA chunk inputs must be finite");
+    demand_finite(state, "KDA chunk state must be finite");
+
+    const size_t c = chunk;
+    const float scale = 1.0f / std::sqrt(static_cast<float>(dk));
+    float* work = scratch.data();                        // state image ...
+    float* staged = work + state_values;                 // ... then output image ...
+    float* plane = staged + out.size();                  // ... then the per-head work plane
+    float* gsum = plane;                                 // [c][dk]
+    float* q_normed = gsum + c * dk;                     // [c][dk], scaled by head_dim^-0.5
+    float* k_normed = q_normed + c * dk;                 // [c][dk]
+    float* t_matrix = k_normed + c * dk;                 // [c][c]
+    float* w_rows = t_matrix + c * c;                    // [c][dk]
+    float* u_rows = w_rows + c * dk;                     // [c][dk]
+    float* v_fixed = u_rows + c * dk;                    // [c][dk]
+    float* staging = v_fixed + c * dk;                   // [c] substitution deltas / Aqk row
+
+    for (size_t i = 0; i < state_values; ++i) work[i] = state[i];
+    const size_t chunks = tokens / c;
+
+    for (size_t chunk_index = 0; chunk_index < chunks; ++chunk_index)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const size_t base = chunk_index * c * d_inner + size_t(head) * dk;
+            const size_t beta_base = chunk_index * c * profile.heads + head;  // + row*heads reaches row token
+
+            for (size_t row = 0; row < c; ++row)
+                for (size_t d = 0; d < dk; ++d) {
+                    const float value = gate[base + row * d_inner + d];
+                    gsum[row * dk + d] = value + (row ? gsum[(row - 1) * dk + d] : 0.0f);
+                }
+            for (size_t row = 0; row < c; ++row) {
+                float q_square = kL2Eps, k_square = kL2Eps;
+                for (size_t d = 0; d < dk; ++d) {
+                    const float qv = q[base + row * d_inner + d];
+                    const float kv = k[base + row * d_inner + d];
+                    q_square = std::fma(qv, qv, q_square);
+                    k_square = std::fma(kv, kv, k_square);
+                }
+                const float q_inv = 1.0f / std::sqrt(q_square);
+                const float k_inv = 1.0f / std::sqrt(k_square);
+                for (size_t d = 0; d < dk; ++d) {
+                    q_normed[row * dk + d] = (q[base + row * d_inner + d] * q_inv) * scale;
+                    k_normed[row * dk + d] = k[base + row * d_inner + d] * k_inv;
+                }
+            }
+
+            // Decayed key Gram from differences only. Entries are
+            // [row = later token i][col = earlier token j], j < i, with the
+            // exponent gsum[i] - gsum[j] <= 0 (gsum is non-increasing), so no
+            // positive exponent is ever computed. The LATER token's beta
+            // scales the Gram row; exact forward substitution then produces
+            // (I+L)^-1 - I on the strict lower triangle.
+            for (size_t i = 0; i < c; ++i)
+                for (size_t j = 0; j < c; ++j) t_matrix[i * c + j] = 0.0f;
+            for (size_t i = 1; i < c; ++i)
+                for (size_t j = 0; j < i; ++j) {
+                    float acc = 0;
+                    for (size_t d = 0; d < dk; ++d)
+                        acc = std::fma(k_normed[i * dk + d] *
+                                           std::exp(gsum[i * dk + d] - gsum[j * dk + d]),
+                                       k_normed[j * dk + d], acc);
+                    t_matrix[i * c + j] = -beta[beta_base + i * profile.heads] * acc;
+                }
+            for (size_t i = 1; i < c; ++i) {
+                for (size_t j = 0; j < i; ++j) {
+                    float acc = 0;
+                    for (size_t m = 0; m < i; ++m) acc += t_matrix[i * c + m] * t_matrix[m * c + j];
+                    staging[j] = acc;
+                }
+                for (size_t j = 0; j < i; ++j) t_matrix[i * c + j] += staging[j];
+            }
+            // u = (T+I) @ (beta_key * v), w = (T+I) @ (beta_key * e^gsum * k):
+            // the diagonal of (T+I) is beta of the own token, the strict-lower
+            // columns carry the EARLIER (column) token's beta.
+            for (size_t row = 0; row < c; ++row)
+                for (size_t d = 0; d < dk; ++d) {
+                    const float b_diag = beta[beta_base + row * profile.heads];
+                    float w_acc = b_diag * k_normed[row * dk + d] * std::exp(gsum[row * dk + d]);
+                    float u_acc = b_diag * v[base + row * d_inner + d];
+                    for (size_t col = 0; col < row; ++col) {
+                        const float t = t_matrix[row * c + col] * beta[beta_base + col * profile.heads];
+                        w_acc = std::fma(t, k_normed[col * dk + d] * std::exp(gsum[col * dk + d]), w_acc);
+                        u_acc = std::fma(t, v[base + col * d_inner + d], u_acc);
+                    }
+                    w_rows[row * dk + d] = w_acc;
+                    u_rows[row * dk + d] = u_acc;
+                }
+
+            float* S = work + size_t(head) * dk * dk;
+            for (size_t row = 0; row < c; ++row) {
+                for (size_t d = 0; d < dk; ++d) {
+                    float acc = 0;
+                    for (size_t kd = 0; kd < dk; ++kd)
+                        acc = std::fma(w_rows[row * dk + kd], S[kd * dk + d], acc);
+                    v_fixed[row * dk + d] = u_rows[row * dk + d] - acc;
+                }
+                // Aqk row with diagonal kept, differences only.
+                for (size_t col = 0; col <= row; ++col) {
+                    float gram = 0;
+                    for (size_t d = 0; d < dk; ++d)
+                        gram = std::fma(q_normed[row * dk + d] *
+                                            std::exp(gsum[row * dk + d] - gsum[col * dk + d]),
+                                        k_normed[col * dk + d], gram);
+                    staging[col] = gram;
+                }
+                float* o_row = staged + base + row * d_inner;
+                for (size_t d = 0; d < dk; ++d) {
+                    float acc = 0;
+                    for (size_t kd = 0; kd < dk; ++kd)
+                        acc = std::fma(q_normed[row * dk + kd] * std::exp(gsum[row * dk + kd]),
+                                       S[kd * dk + d], acc);
+                    for (size_t col = 0; col <= row; ++col)
+                        acc = std::fma(staging[col], v_fixed[col * dk + d], acc);
+                    o_row[d] = acc;
+                }
+            }
+            // State: rows decay by the chunk's last cumsum, then the rank-c
+            // update with decay-shifted keys and the corrected values.
+            for (size_t kd = 0; kd < dk; ++kd) {
+                const float decay = std::exp(gsum[(c - 1) * dk + kd]);
+                for (size_t d = 0; d < dk; ++d) S[kd * dk + d] *= decay;
+            }
+            for (size_t kd = 0; kd < dk; ++kd)
+                for (size_t d = 0; d < dk; ++d) {
+                    float acc = 0;
+                    for (size_t row = 0; row < c; ++row)
+                        acc = std::fma(k_normed[row * dk + kd] *
+                                           std::exp(gsum[(c - 1) * dk + kd] - gsum[row * dk + kd]),
+                                       v_fixed[row * dk + d], acc);
+                    S[kd * dk + d] += acc;
+                }
+        }
+
+    for (size_t i = 0; i < state_values; ++i)
+        if (!std::isfinite(work[i])) throw std::overflow_error("KDA chunk state overflowed");
+    for (size_t i = 0; i < out.size(); ++i)
+        if (!std::isfinite(staged[i])) throw std::overflow_error("KDA chunk output overflowed");
+    for (size_t i = 0; i < state_values; ++i) state[i] = work[i];
+    for (size_t i = 0; i < out.size(); ++i) out[i] = staged[i];
+}
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/kda_chunk_reference.h b/src/models/glm5/reference/kda_chunk_reference.h
new file mode 100644
index 0000000000000000000000000000000000000000..1ef3c14a31b2ca3ca4f6950f2191a07b91e49e19
--- /dev/null
+++ b/src/models/glm5/reference/kda_chunk_reference.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "models/glm5/reference/kda_reference.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::glm5::reference {
+
+inline constexpr const char* kKdaChunkReferenceProfile = "glm53_kda_chunk_fp32";
+
+// Production chunk width of the reference stack (FLA/abotsis default).
+inline constexpr uint32_t kGlm53KdaChunk = 64;
+// Staging bound: 64 production, 256 keeps accidental wider profiles testable.
+inline constexpr uint32_t kKdaMaxChunk = 256;
+
+// Total scratch of kda_chunk_reference in floats: the staged state image and
+// output image (validate-then-commit, same contract as the recurrent scan)
+// plus one reusable per-head work plane of chunk*(chunk + 6*head_dim + 1)
+// values (rebased cumsum, normalized q/k, T, u, w, corrected values - six
+// chunk x head_dim planes - plus the forward-substitution/Aqk staging row).
+[[nodiscard]] constexpr size_t kda_chunk_scratch_values(const KdaProfile& profile,
+                                                         size_t tokens, uint32_t chunk) {
+    const size_t per_head = size_t(chunk) * (chunk + 6 * size_t(profile.head_dim) + 1);
+    return kda_scan_scratch_values(profile, tokens) + per_head;
+}
+
+// Chunked prefill over whole chunks: the FLA naive chunk algorithm with the
+// audited GLM-5.3 semantics. Inputs match kda_gated_delta_reference exactly
+// (q/k/v post-conv SiLU planes, gate in log space from the decay-gate
+// reference, already-sigmoided beta); tokens must be a multiple of chunk (the
+// caller pads tails with g=0/q=k=v=beta=0 rows, which contribute nothing).
+// q/k get the in-kernel l2 norm (eps 1e-6) and q the head_dim^-0.5 scale.
+//
+// Per chunk and head: a per-chunk rebased cumsum of the log gate; the decayed
+// key Gram taken from DIFFERENCES exp(gsum[c]-gsum[i]) (never the factored
+// product form, which overflows for long chunks); the unit-diagonal strict
+// lower system solved by exact forward substitution (no Neumann iteration);
+// beta of the earlier token scales the Gram rows and beta of the own token
+// scales the v/w operands; Aqk keeps its diagonal; the state affine update
+// carries the chunk recurrence. All arithmetic FP32 with /fp:strict.
+//
+// state and out commit together only after every value validates, exactly like
+// the recurrent scan; scratch must hold kda_chunk_scratch_values and must not
+// alias any plane. This is the reference chunk algorithm only: no varlen
+// packing, no HPU execution, no performance claim.
+void kda_chunk_reference(std::span<const float> q, std::span<const float> k,
+                         std::span<const float> v, std::span<const float> gate,
+                         std::span<const float> beta, std::span<float> state,
+                         std::span<float> out, std::span<float> scratch, const KdaProfile&,
+                         uint32_t chunk);
+
+}  // namespace ninfer::models::glm5::reference
diff --git a/src/models/glm5/reference/kda_reference.cpp b/src/models/glm5/reference/kda_reference.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d998a03d2e9ab5e139f1a8d2c936eae06811a318
--- /dev/null
+++ b/src/models/glm5/reference/kda_reference.cpp
@@ -0,0 +1,219 @@
+#include "models/glm5/reference/kda_reference.h"
+
+#include <array>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::glm5::reference {
+namespace {
+constexpr float kL2Eps = 1e-6f;   // transformers l2norm/glm kernels add eps inside the sqrt
+constexpr float kNormEps = 1e-6f; // Glm5NextTextRMSNormGated default eps
+// Per-head staging bound: the reference head slice is 128 floats; twice that
+// keeps an accidental 256-dim profile testable instead of silently corrupt.
+constexpr size_t kMaxHeadDim = 256;
+
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "GLM KDA reference requires IEEE-754 binary32");
+
+float sigmoid(float x) { return 1.0f / (1.0f + std::exp(-x)); }
+
+size_t checked_mul(size_t a, size_t b) {
+    if (a && b > std::numeric_limits<size_t>::max() / a)
+        throw std::overflow_error("KDA reference size overflow");
+    return a * b;
+}
+
+void demand_finite(std::span<const float> plane, const char* what) {
+    for (const float value : plane)
+        if (!std::isfinite(value)) throw std::invalid_argument(what);
+}
+
+size_t token_count(std::span<const float> plane, size_t d_inner, const char* what) {
+    if (d_inner == 0 || plane.size() % d_inner != 0)
+        throw std::invalid_argument(what);
+    return plane.size() / d_inner;
+}
+}  // namespace
+
+void kda_conv_reference(std::span<const float> x, std::span<const float> weights,
+                        std::span<float> conv_state, std::span<float> out, const KdaProfile& profile) {
+    if (profile.d_conv < 2) throw std::invalid_argument("KDA conv requires at least two taps");
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t hist = profile.d_conv - 1;
+    const size_t tokens = token_count(x, d_inner, "KDA conv input is not a whole token plane");
+    if (weights.size() != checked_mul(d_inner, profile.d_conv))
+        throw std::invalid_argument("KDA conv weights do not match the profile");
+    if (conv_state.size() != checked_mul(hist, d_inner))
+        throw std::invalid_argument("KDA conv state does not match the profile");
+    if (out.size() != x.size()) throw std::invalid_argument("KDA conv output size mismatch");
+    if (tokens == 0) throw std::invalid_argument("KDA conv requires at least one token");
+    demand_finite(x, "KDA conv input must be finite");
+    demand_finite(weights, "KDA conv weights must be finite");
+    demand_finite(conv_state, "KDA conv state must be finite");
+
+    // The virtual window [state | x]: sample s maps to state row s+hist for s<0
+    // and to x[s] otherwise. Each output element is published as soon as it is
+    // finite; the state is only advanced after every element succeeded.
+    const auto sample = [&](long long s, size_t channel) -> float {
+        return s >= 0 ? x[static_cast<size_t>(s) * d_inner + channel]
+                      : conv_state[static_cast<size_t>(s + static_cast<long long>(hist)) * d_inner + channel];
+    };
+    for (size_t t = 0; t < tokens; ++t)
+        for (size_t channel = 0; channel < d_inner; ++channel) {
+            float acc = 0;
+            for (size_t tap = 0; tap < profile.d_conv; ++tap) {
+                const float w = weights[channel * profile.d_conv + tap];
+                acc = std::fma(w, sample(static_cast<long long>(t) - static_cast<long long>(hist) +
+                                         static_cast<long long>(tap), channel), acc);
+            }
+            if (!std::isfinite(acc)) throw std::overflow_error("KDA conv tap sum overflowed");
+            const float silu = acc * sigmoid(acc);
+            if (!std::isfinite(silu)) throw std::overflow_error("KDA conv SiLU overflowed");
+            out[t * d_inner + channel] = silu;
+        }
+    for (size_t channel = 0; channel < d_inner; ++channel) {
+        // Stage first: with tokens < hist the new state still reads old rows
+        // that earlier writes of this loop would already have replaced.
+        std::array<float, 64> replacement{};
+        if (hist > replacement.size()) throw std::invalid_argument("KDA conv history exceeds the staging bound");
+        for (size_t tap = 0; tap < hist; ++tap) {
+            const long long s = static_cast<long long>(tokens) - static_cast<long long>(hist) +
+                                static_cast<long long>(tap);
+            replacement[tap] = sample(s, channel);
+        }
+        for (size_t tap = 0; tap < hist; ++tap) conv_state[tap * d_inner + channel] = replacement[tap];
+    }
+}
+
+void kda_decay_gate_reference(std::span<const float> g, std::span<const float> a_log,
+                              std::span<float> out, const KdaProfile& profile) {
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t tokens = token_count(g, d_inner, "KDA gate input is not a whole token plane");
+    if (a_log.size() != profile.heads)
+        throw std::invalid_argument("KDA gate requires one A_log per head");
+    if (out.size() != g.size()) throw std::invalid_argument("KDA gate output size mismatch");
+    if (!std::isfinite(profile.gate_lower_bound) || profile.gate_lower_bound >= 0)
+        throw std::invalid_argument("KDA safe gate lower bound must be finite and negative");
+    demand_finite(g, "KDA gate input must be finite");
+    demand_finite(a_log, "KDA gate A_log must be finite");
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const float decay_rate = std::exp(a_log[head]);
+            for (uint32_t i = 0; i < profile.head_dim; ++i) {
+                const size_t index = t * d_inner + size_t(head) * profile.head_dim + i;
+                out[index] = profile.gate_lower_bound * sigmoid(decay_rate * g[index]);
+            }
+        }
+    // The safe-path result lies in (lower_bound, 0] by construction; the loop
+    // above cannot produce a non-finite value from finite inputs because sigmoid
+    // saturates to 0 or 1 and lower_bound is finite.
+}
+
+void kda_gated_delta_reference(std::span<const float> q, std::span<const float> k,
+                               std::span<const float> v, std::span<const float> gate,
+                               std::span<const float> beta, std::span<float> state,
+                               std::span<float> out, std::span<float> scratch, const KdaProfile& profile) {
+    const size_t d_inner = checked_mul(profile.heads, profile.head_dim);
+    const size_t dk = profile.head_dim;
+    const size_t state_values = kda_state_values(profile);
+    const size_t tokens = token_count(q, d_inner, "KDA scan query is not a whole token plane");
+    if (k.size() != q.size() || v.size() != q.size() || gate.size() != q.size())
+        throw std::invalid_argument("KDA scan k/v/gate planes must match the query plane");
+    if (beta.size() != checked_mul(tokens, profile.heads))
+        throw std::invalid_argument("KDA scan beta must hold one value per token and head");
+    if (state.size() != state_values)
+        throw std::invalid_argument("KDA scan state does not match the profile");
+    if (out.size() != q.size()) throw std::invalid_argument("KDA scan output size mismatch");
+    if (scratch.size() != state_values + out.size())
+        throw std::invalid_argument("KDA scan scratch must hold one state and one output image");
+    if (tokens == 0) throw std::invalid_argument("KDA scan requires at least one token");
+    for (const auto* plane : {&q, &k, &v, &gate, &beta}) demand_finite(*plane, "KDA scan inputs must be finite");
+    demand_finite(state, "KDA scan state must be finite");
+
+    const float scale = 1.0f / std::sqrt(static_cast<float>(dk));
+    float* work = scratch.data();                       // state image, then output image
+    float* staged = scratch.data() + state_values;
+    for (size_t i = 0; i < state_values; ++i) work[i] = state[i];
+
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const float* qt = q.data() + t * d_inner + size_t(head) * dk;
+            const float* kt = k.data() + t * d_inner + size_t(head) * dk;
+            const float* vt = v.data() + t * d_inner + size_t(head) * dk;
+            const float* gt = gate.data() + t * d_inner + size_t(head) * dk;
+            const float b = beta[t * profile.heads + head];
+            float* S = work + size_t(head) * dk * dk;   // row = key axis
+
+            float q_norm = kL2Eps, k_norm = kL2Eps;     // eps inside the sqrt keeps a zero vector finite
+            for (size_t i = 0; i < dk; ++i) {
+                q_norm = std::fma(qt[i], qt[i], q_norm);
+                k_norm = std::fma(kt[i], kt[i], k_norm);
+            }
+            q_norm = std::sqrt(q_norm); k_norm = std::sqrt(k_norm);
+            if (dk > kMaxHeadDim) throw std::invalid_argument("KDA scan head_dim exceeds the staging bound");
+            std::array<float, kMaxHeadDim> qh{}, kh{};
+            for (size_t i = 0; i < dk; ++i) {
+                qh[i] = (qt[i] / q_norm) * scale;
+                kh[i] = kt[i] / k_norm;
+            }
+            for (size_t i = 0; i < dk; ++i) {           // decay applies to the key axis
+                const float decay = std::exp(gt[i]);
+                for (size_t j = 0; j < dk; ++j) S[i * dk + j] *= decay;
+            }
+            std::array<float, kMaxHeadDim> u{}, delta{};
+            for (size_t j = 0; j < dk; ++j) {
+                float acc = 0;
+                for (size_t i = 0; i < dk; ++i) acc = std::fma(S[i * dk + j], kh[i], acc);
+                u[j] = acc;
+            }
+            for (size_t j = 0; j < dk; ++j) delta[j] = b * (vt[j] - u[j]);
+            for (size_t i = 0; i < dk; ++i)
+                for (size_t j = 0; j < dk; ++j) S[i * dk + j] = std::fma(kh[i], delta[j], S[i * dk + j]);
+            float* ot = staged + t * d_inner + size_t(head) * dk;
+            for (size_t j = 0; j < dk; ++j) {
+                float acc = 0;
+                for (size_t i = 0; i < dk; ++i) acc = std::fma(S[i * dk + j], qh[i], acc);
+                ot[j] = acc;
+            }
+            for (size_t i = 0; i < dk * dk; ++i)
+                if (!std::isfinite(S[i])) throw std::overflow_error("KDA scan state overflowed");
+            for (size_t j = 0; j < dk; ++j)
+                if (!std::isfinite(ot[j])) throw std::overflow_error("KDA scan output overflowed");
+        }
+    for (size_t i = 0; i < state_values; ++i) state[i] = work[i];
+    for (size_t i = 0; i < out.size(); ++i) out[i] = staged[i];
+}
+
+void kda_out_gate_reference(std::span<const float> o, std::span<const float> g2,
+                            std::span<const float> norm_w, std::span<float> out,
+                            const KdaProfile& profile) {
+    const size_t dk = profile.head_dim;
+    const size_t d_inner = checked_mul(profile.heads, dk);
+    const size_t tokens = token_count(o, d_inner, "KDA out-gate input is not a whole token plane");
+    if (g2.size() != o.size()) throw std::invalid_argument("KDA out-gate gate plane mismatch");
+    if (norm_w.size() != dk) throw std::invalid_argument("KDA out-gate weight must hold head_dim values");
+    if (out.size() != o.size()) throw std::invalid_argument("KDA out-gate output size mismatch");
+    demand_finite(o, "KDA out-gate input must be finite");
+    demand_finite(g2, "KDA out-gate gate must be finite");
+    demand_finite(norm_w, "KDA out-gate weight must be finite");
+
+    // Publication is per element after it validates; o and out may alias, and
+    // each output element only reads its own head slice, so an alias is safe.
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t head = 0; head < profile.heads; ++head) {
+            const float* ot = o.data() + t * d_inner + size_t(head) * dk;
+            const float* gt = g2.data() + t * d_inner + size_t(head) * dk;
+            float mean = 0;
+            for (size_t i = 0; i < dk; ++i) mean = std::fma(ot[i], ot[i], mean);
+            mean /= static_cast<float>(dk);
+            const float inv = 1.0f / std::sqrt(mean + kNormEps);
+            for (size_t i = 0; i < dk; ++i) {
+                const float value = ot[i] * inv * norm_w[i] * sigmoid(gt[i]);
+                if (!std::isfinite(value)) throw std::overflow_error("KDA out-gate overflowed");
+                out[t * d_inner + size_t(head) * dk + i] = value;
+            }
+        }
+}
+
+}  // namespace ninfer::models::glm5::reference
