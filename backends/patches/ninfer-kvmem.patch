+// Engine must settle the whole unit through synchronized failure recovery.
+class CoupledExecutionFailure final : public std::exception {
+public:
+    CoupledExecutionFailure(LaneId prefill, std::span<const std::uint32_t> decodes, std::exception_ptr cause) noexcept
+        : size_(decodes.size()+1), cause_(std::move(cause)) {
+        lanes_[0]=prefill;
+        for(std::size_t i=0;i<decodes.size();++i) lanes_[i+1]=LaneId{decodes[i]};
+    }
+    [[nodiscard]] const char* what() const noexcept override {
+        return "coupled Prefill/Decode execution failed";
+    }
+    [[nodiscard]] std::span<const LaneId> lanes() const noexcept { return {lanes_.data(),size_}; }
+    [[nodiscard]] const std::exception_ptr& cause() const noexcept { return cause_; }
+private:
+    std::array<LaneId, 3> lanes_{};
+    std::size_t size_;
+    std::exception_ptr cause_;
+};
