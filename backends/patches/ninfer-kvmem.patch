+        DeviceBuffer d_pre = device.allocate_device(4 * T * 4);
+        DeviceBuffer d_block = device.allocate_device(H * T * 2);
+        DeviceBuffer d_comb = device.allocate_device(16 * T * 4);
+        DeviceBuffer d_postg = device.allocate_device(4 * T * 4);
+        DeviceBuffer d_collapsed = device.allocate_device(H * T * 2);
+        DeviceBuffer d_residual = device.allocate_device(W4 * T * 2);
+        DeviceBuffer d_updated = device.allocate_device(W4 * T * 2);
+        DeviceBuffer d_head = device.allocate_device(H * T * 2);
+
+        auto up1 = stream.upload(d_streams, h_streams, h_streams.size()); up1.wait();
+        auto up2 = stream.upload(d_mixes, h_mixes, h_mixes.size()); up2.wait();
+        auto up3 = stream.upload(d_base, h_base, h_base.size()); up3.wait();
+        auto up4 = stream.upload(d_scale, h_scale, h_scale.size()); up4.wait();
+        auto up5 = stream.upload(d_block, h_block, h_block.size()); up5.wait();
+        auto up6 = stream.upload(d_residual, h_streams, h_streams.size()); up6.wait();
