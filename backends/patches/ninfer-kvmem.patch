index 0000000000000000000000000000000000000000..4424e68c34e5c9eb4951a4d453ad17024f690072
--- /dev/null
+++ b/src/models/qwen3_5/execution/joint_batch.h
@@ -0,0 +1,146 @@
+#pragma once
+#include "core/arena.h"
+#include "core/device.h"
+#include "core/decode_graph.h"
+#include <vector>
+#include <cstdio>
+#include <span>
+#include <stdexcept>
+#include <cstring>
+#include "core/nvtx.h"
+#include "runtime/contract/timing.h"
+#include <functional>
+#include <array>
