diff --git a/src/ops/glm5_prefill/glm5_prefill.cu b/src/ops/glm5_prefill/glm5_prefill.cu
new file mode 100644
index 0000000..084f022
--- /dev/null
+++ b/src/ops/glm5_prefill/glm5_prefill.cu
@@ -0,0 +1,81 @@
+// GLM-5.3-Flash batched-prefill helper kernels (layout bridge).
+#include "ninfer/ops/glm5_prefill.h"
+
+#include "core/device.h"
+
+#include <cuda_bf16.h>
+
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+
+constexpr int kTile = 32;
+
+__global__ void transpose_bf16_kernel(const __nv_bfloat16* __restrict__ in,
+                                      __nv_bfloat16* __restrict__ out, int a, int b) {
+    // in is [A, B] (FCD = A); out is [B, A].
+    __shared__ __nv_bfloat16 tile[kTile][kTile + 1];
+    const int bx = blockIdx.x, by = blockIdx.y;
+    const int tx = threadIdx.x, ty = threadIdx.y;
+    const int in_col = bx * kTile + tx;   // along B
+    const int in_row = by * kTile + ty;   // along A
+    if (in_col < b && in_row < a) {
+        tile[ty][tx] = in[static_cast<std::int64_t>(in_col) * a + in_row];
+    }
+    __syncthreads();
+    const int out_col = by * kTile + tx;  // along A
+    const int out_row = bx * kTile + ty;  // along B
+    if (out_col < a && out_row < b) {
+        out[static_cast<std::int64_t>(out_col) * b + out_row] = tile[tx][ty];
+    }
+}
+
+} // namespace
+
+void glm5_transpose_bf16(const Tensor& in, Tensor& out, cudaStream_t stream) {
+    const std::int32_t a = in.ne[0], b = in.ne[1];
+    if (a <= 0 || b <= 0 || in.dtype != DType::BF16 || !in.is_contiguous()) {
+        throw std::invalid_argument("glm5_transpose_bf16: in must be contiguous BF16 [A, B]");
+    }
+    if (out.dtype != DType::BF16 || out.ne[0] != b || out.ne[1] != a || !out.is_contiguous()) {
+        throw std::invalid_argument("glm5_transpose_bf16: out must be contiguous BF16 [B, A]");
+    }
+    const dim3 grid((b + kTile - 1) / kTile, (a + kTile - 1) / kTile);
+    transpose_bf16_kernel<<<grid, dim3(kTile, kTile), 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(in.data), static_cast<__nv_bfloat16*>(out.data),
+        a, b);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+namespace {
+
+__global__ void cast_scale_kernel(const __nv_bfloat16* __restrict__ src, float factor,
+                                  std::int64_t elements, float* __restrict__ dst) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= elements) { return; }
+    dst[index] = __bfloat162float(src[index]) * factor;
+}
+
+} // namespace
+
+void glm5_cast_bf16_to_f32_scaled(const Tensor& src, float factor, Tensor& dst,
+                                  cudaStream_t stream) {
+    if (src.dtype != DType::BF16 || dst.dtype != DType::FP32 || !src.is_contiguous() ||
+        !dst.is_contiguous()) {
+        throw std::invalid_argument(
+            "glm5_cast_bf16_to_f32_scaled: contiguous BF16 in, FP32 out required");
+    }
+    const std::int64_t elements = src.numel();
+    if (dst.numel() != elements || elements <= 0) {
+        throw std::invalid_argument("glm5_cast_bf16_to_f32_scaled: shape mismatch");
+    }
+    const auto blocks = static_cast<unsigned int>(
+        (elements + 255) / 256);
+    cast_scale_kernel<<<blocks, 256, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(src.data), factor, elements,
+        static_cast<float*>(dst.data));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops
