+#define CHECK(expression) do { if (!(expression)) throw std::runtime_error("check failed: " #expression); } while (false)
+using namespace ninfer::models::glm5::reference;
+
+namespace {
+
+// Deterministic fixture: exact values in binary32 keep oracle tolerances tight.
+float source(uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 19u) - 9) / 4.0f;
+}
+
+// ---------------------------------------------------------------------------
+// Independent long-double oracle assembled from the FLA naive formulation
+// (S *= exp(g); S += (beta*k) outer (v - S^T k); o = S^T q with q pre-scaled),
+// deliberately written in a different association order than the C++ loop.
+struct ScanOracle {
+    long double sq(long double v) const { return v * v; }
+    long double l2(const float* x) const {
+        long double sum = 1e-6L;
+        for (uint32_t i = 0; i < profile.head_dim; ++i) sum += sq(x[i]);
+        return std::sqrt(sum);
+    }
+    explicit ScanOracle(KdaProfile p) : profile(p) {}
+
+    void token(const float* q, const float* k, const float* v, const float* g, long double beta,
+               std::vector<long double>& S, float* o) const {
+        const uint32_t dk = profile.head_dim;
+        const long double scale = 1.0L / std::sqrt(static_cast<long double>(dk));
+        std::vector<long double> qh(dk), kh(dk);
+        for (uint32_t i = 0; i < dk; ++i) {
+            qh[i] = q[i] / l2(q) * scale;
+            kh[i] = k[i] / l2(k);
+        }
+        std::vector<long double> decay(dk);
+        for (uint32_t i = 0; i < dk; ++i) decay[i] = std::exp(static_cast<long double>(g[i]));
+        // S is [key][value]; FLA writes S = S*exp(g) then the rank-one update.
+        for (uint32_t i = 0; i < dk; ++i)
+            for (uint32_t j = 0; j < dk; ++j) S[static_cast<size_t>(i) * dk + j] *= decay[i];
+        for (uint32_t j = 0; j < dk; ++j) {
+            long double u = 0;
+            for (uint32_t i = 0; i < dk; ++i) u += kh[i] * S[static_cast<size_t>(i) * dk + j];
+            const long double delta = beta * (v[j] - u);
+            for (uint32_t i = 0; i < dk; ++i) S[static_cast<size_t>(i) * dk + j] += kh[i] * delta;
+        }
+        for (uint32_t j = 0; j < dk; ++j) {
+            long double out = 0;
+            for (uint32_t i = 0; i < dk; ++i) out += qh[i] * S[static_cast<size_t>(i) * dk + j];
+            o[j] = static_cast<float>(out);
+        }
+    }
+
+    KdaProfile profile;
+};
+
+void compare(const std::vector<float>& actual, const std::vector<long double>& expected,
+             long double tolerance, const char* what) {
+    CHECK(actual.size() == expected.size());
+    for (size_t i = 0; i < actual.size(); ++i) {
+        const long double reference = expected[i] == 0 ? 0 : expected[i];
+        const long double error = std::abs(static_cast<long double>(actual[i]) - reference);
+        CHECK(error <= tolerance * std::max<long double>(1, std::abs(reference)));
+        if (!(error <= tolerance * std::max<long double>(1, std::abs(reference))))
+            std::fprintf(stderr, "%s[%zu]=%e vs %Le\n", what, i, actual[i], reference);
+    }
+}
+
+// ---------------------------------------------------------------------------
+void conv_oracle_and_continuity() {
+    const KdaProfile profile{3, 4, 4, -5.0f};
+    const size_t d_inner = profile.heads * profile.head_dim;
+    const size_t hist = profile.d_conv - 1;
+
+    std::vector<float> weights(d_inner * profile.d_conv);
+    for (size_t i = 0; i < weights.size(); ++i) weights[i] = source(static_cast<uint32_t>(i) + 1);
+    std::vector<float> state(hist * d_inner);
+    for (size_t i = 0; i < state.size(); ++i) state[i] = source(static_cast<uint32_t>(i) * 3 + 5) / 2;
+
+    for (const size_t tokens : {size_t{1}, size_t{2}, size_t{5}}) {
+        std::vector<float> x(tokens * d_inner);
+        for (size_t i = 0; i < x.size(); ++i) x[i] = source(static_cast<uint32_t>(i) + 7);
+
+        std::vector<float> one_out(tokens * d_inner, -1e30f), one_state = state;
+        kda_conv_reference(x, weights, one_state, one_out, profile);
+
+        // Independent oracle over the virtual [state | x] window.
+        std::vector<float> expected(tokens * d_inner);
+        for (size_t t = 0; t < tokens; ++t)
+            for (size_t c = 0; c < d_inner; ++c) {
+                long double acc = 0;
+                for (uint32_t tap = 0; tap < profile.d_conv; ++tap) {
+                    const long long s = static_cast<long long>(t) - static_cast<long long>(hist) + tap;
+                    const long double sample = s >= 0 ? x[static_cast<size_t>(s) * d_inner + c]
+                                                      : state[static_cast<size_t>(s + static_cast<long long>(hist)) * d_inner + c];
+                    acc += weights[c * profile.d_conv + tap] * sample;
+                }
+                const long double silu = acc / (1.0L + std::exp(-acc));
+                expected[t * d_inner + c] = static_cast<float>(silu);
+            }
+        compare(one_out, std::vector<long double>(expected.begin(), expected.end()), 3e-6L, "conv out");
+
+        // One-shot must equal token-by-token, bit for bit, including the state.
+        std::vector<float> split_out, split_state = state;
+        for (size_t t = 0; t < tokens; ++t) {
+            std::vector<float> token(d_inner), out(d_inner);
+            for (size_t c = 0; c < d_inner; ++c) token[c] = x[t * d_inner + c];
+            kda_conv_reference(token, weights, split_state, out, profile);
+            split_out.insert(split_out.end(), out.begin(), out.end());
+        }
+        CHECK(one_out == split_out);
+        CHECK(one_state == split_state);
+    }
+}
+
+// ---------------------------------------------------------------------------
+void gate_matches_kernel_formula() {
+    const KdaProfile profile{2, 3, 4, -5.0f};
+    const size_t d_inner = profile.heads * profile.head_dim;
+    const size_t tokens = 2;
+    std::vector<float> g(tokens * d_inner), a_log(profile.heads), out(tokens * d_inner);
+    for (size_t i = 0; i < g.size(); ++i) g[i] = source(static_cast<uint32_t>(i) + 3);
+    a_log[0] = -0.5f; a_log[1] = 0.25f;
+    kda_decay_gate_reference(g, a_log, out, profile);
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t h = 0; h < profile.heads; ++h) {
+            const long double rate = std::exp(static_cast<long double>(a_log[h]));
+            for (uint32_t i = 0; i < profile.head_dim; ++i) {
+                const size_t index = t * d_inner + size_t(h) * profile.head_dim + i;
+                const long double expected = profile.gate_lower_bound /
+                    (1.0L + std::exp(-rate * g[index]));
+                CHECK(std::abs(static_cast<long double>(out[index]) - expected) < 1e-6L);
+                CHECK(out[index] < 0 && out[index] > profile.gate_lower_bound);
+            }
+        }
+}
+
+// ---------------------------------------------------------------------------
+void scan_oracle_split_and_state_contract() {
+    const KdaProfile profile{2, 4, 4, -5.0f};
+    const size_t d_inner = profile.heads * profile.head_dim;
+    const size_t state_values = kda_state_values(profile);
+    const size_t tokens = 5;
+
+    std::vector<float> q(tokens * d_inner), k(tokens * d_inner), v(tokens * d_inner),
+        gate(tokens * d_inner), beta(tokens * profile.heads);
+    for (size_t i = 0; i < tokens * d_inner; ++i) {
+        q[i] = source(static_cast<uint32_t>(i) * 2 + 1);
+        k[i] = source(static_cast<uint32_t>(i) * 2 + 2);
+        v[i] = source(static_cast<uint32_t>(i) * 2 + 3) / 2;
+        gate[i] = source(static_cast<uint32_t>(i) * 2 + 4) / 3;
+    }
+    for (size_t i = 0; i < beta.size(); ++i) beta[i] = 0.25f + 0.5f * (static_cast<float>(i % 3) / 3.0f);
+
+    std::vector<float> state(state_values), out(tokens * d_inner, -1e30f),
+        scratch(kda_scan_scratch_values(profile, tokens));
+    for (size_t i = 0; i < state.size(); ++i) state[i] = source(static_cast<uint32_t>(i)) / 5;
+    const std::vector<float> initial_state = state;
+
+    kda_gated_delta_reference(q, k, v, gate, beta, state, out, scratch, profile);
+
+    // Independent oracle per head, straight from the FLA naive recurrence.
+    const ScanOracle oracle(profile);
+    std::vector<float> expected(tokens * d_inner);
+    for (uint32_t h = 0; h < profile.heads; ++h) {
+        std::vector<long double> S(state_values);
+        for (size_t i = 0; i < state_values; ++i) S[i] = initial_state[h * profile.head_dim * profile.head_dim + i];
+        for (size_t t = 0; t < tokens; ++t) {
+            const size_t base = t * d_inner + size_t(h) * profile.head_dim;
+            oracle.token(&q[base], &k[base], &v[base], &gate[base], beta[t * profile.heads + h], S,
+                         &expected[base]);
+        }
+    }
+    compare(out, std::vector<long double>(expected.begin(), expected.end()), 2e-5L, "scan out");
+    // 20^2 accumulations over 5 tokens stay far from FP32 limits, but the state
+    // must equal running the oracle's FP32 rounding, checked via the split run.
+
+    // Token-by-token must reproduce the one-shot run bit for bit, including state.
+    std::vector<float> split_state = initial_state, split_out;
+    std::vector<float> one(q.begin(), q.begin() + d_inner), onek(k.begin(), k.begin() + d_inner),
+        onev(v.begin(), v.begin() + d_inner), oneg(gate.begin(), gate.begin() + d_inner);
+    std::vector<float> token_scratch(kda_scan_scratch_values(profile, 1)), token_out(d_inner);
+    for (size_t t = 0; t < tokens; ++t) {
+        for (size_t c = 0; c < d_inner; ++c) {
+            one[c] = q[t * d_inner + c]; onek[c] = k[t * d_inner + c];
+            onev[c] = v[t * d_inner + c]; oneg[c] = gate[t * d_inner + c];
+        }
+        std::vector<float> token_beta(beta.begin() + t * profile.heads,
+                                      beta.begin() + (t + 1) * profile.heads);
+        kda_gated_delta_reference(one, onek, onev, oneg, token_beta, split_state, token_out,
+                                  token_scratch, profile);
+        split_out.insert(split_out.end(), token_out.begin(), token_out.end());
+    }
+    CHECK(out == split_out);
+    CHECK(state == split_state);
+
+    // Fresh state stays zero-preserving: q=k=v=0 must leave the state untouched
+    // apart from decay and write o = decayed state times zero query... instead
+    // assert the practical invariant: zero inputs leave o finite and state decayed.
+    std::vector<float> zeros(tokens * d_inner, 0), zero_beta(tokens * profile.heads, 0),
+        zero_state = initial_state, zero_out(tokens * d_inner, -1e30f);
+    kda_gated_delta_reference(zeros, zeros, zeros, gate, zero_beta, zero_state, zero_out, scratch, profile);
+    CHECK(zero_out == std::vector<float>(tokens * d_inner, 0));  // q=0 => o=0 exactly
+}
+
+// ---------------------------------------------------------------------------
+void scan_failure_keeps_planes() {
+    const KdaProfile profile{1, 2, 4, -5.0f};
+    const size_t d_inner = profile.heads * profile.head_dim;
+    std::vector<float> q(d_inner, 1), k(d_inner, 1), v(d_inner, 1), gate(d_inner, -1),
+        beta(profile.heads, 0.5f), state(kda_state_values(profile), 0),
+        out(d_inner, -7), scratch(kda_scan_scratch_values(profile, 1));
+    // Non-finite input is rejected before anything is modified. A finite huge
+    // magnitude is NOT rejected at the gate: the l2 norm maps it toward zero,
+    // matching the FP32 kernel behaviour.
+    const auto nan = std::numeric_limits<float>::quiet_NaN();
+    q[0] = nan;
+    try {
+        kda_gated_delta_reference(q, k, v, gate, beta, state, out, scratch, profile);
+        throw std::runtime_error("NaN scan input accepted");
+    } catch (const std::invalid_argument&) {
+    }
+    q[0] = std::numeric_limits<float>::max();
+    k[1] = std::numeric_limits<float>::max();
+    kda_gated_delta_reference(q, k, v, gate, beta, state, out, scratch, profile);
+    CHECK(state == std::vector<float>(kda_state_values(profile), 0));  // k normalizes away
+    q[0] = 1; k[1] = 1;
+    // Arithmetic overflow: an out-of-range (still finite) beta multiplies the
+    // delta rule past binary32 range mid-scan; both planes must stay untouched.
+    // Unit-normalized q/k with in-range beta alone cannot overflow a dk=2 head
+    // (outputs stay below 0.71*FLT_MAX), so the guard is what stands between a
+    // caller-side sigmoid bug and a silently corrupt state.
+    CHECK(out != std::vector<float>(d_inner, -7));  // the run above published
+    std::fill(out.begin(), out.end(), -7.0f);
+    v[0] = std::numeric_limits<float>::max(); v[1] = std::numeric_limits<float>::max();
+    beta[0] = 4;
+    try {
+        kda_gated_delta_reference(q, k, v, gate, beta, state, out, scratch, profile);
+        throw std::runtime_error("overflowing scan accepted");
+    } catch (const std::overflow_error&) {
+    }
+    CHECK(out == std::vector<float>(d_inner, -7));
+    CHECK(state == std::vector<float>(kda_state_values(profile), 0));
+}
+
+// ---------------------------------------------------------------------------
+void out_gate_oracle_and_alias() {
+    const KdaProfile profile{2, 3, 4, -5.0f};
+    const size_t d_inner = profile.heads * profile.head_dim;
+    const size_t tokens = 3;
+    std::vector<float> o(tokens * d_inner), g2(tokens * d_inner), norm_w(profile.head_dim);
+    for (size_t i = 0; i < o.size(); ++i) o[i] = source(static_cast<uint32_t>(i) + 11) / 3;
+    for (size_t i = 0; i < g2.size(); ++i) g2[i] = source(static_cast<uint32_t>(i) + 13) / 2;
+    for (size_t i = 0; i < norm_w.size(); ++i) norm_w[i] = 1 + source(static_cast<uint32_t>(i)) / 9;
+
+    const std::vector<float> input = o;
+    kda_out_gate_reference(o, g2, norm_w, o, profile);  // in-place alias must work
+    for (size_t t = 0; t < tokens; ++t)
+        for (uint32_t h = 0; h < profile.heads; ++h) {
+            const size_t base = t * d_inner + size_t(h) * profile.head_dim;
+            long double mean = 0;
+            for (uint32_t i = 0; i < profile.head_dim; ++i)
+                mean += static_cast<long double>(input[base + i]) * input[base + i];
+            mean /= profile.head_dim;
+            const long double inv = 1.0L / std::sqrt(mean + 1e-6L);
+            for (uint32_t i = 0; i < profile.head_dim; ++i) {
+                const long double expected = input[base + i] * inv * norm_w[i] /
+                    (1.0L + std::exp(-static_cast<long double>(g2[base + i])));
+                CHECK(std::abs(static_cast<long double>(o[base + i]) - expected) < 1e-5L);
+            }
+        }
+}
+
+// ---------------------------------------------------------------------------
+void glm53_dimensions_smoke() {
+    // The real 64x128 profile at small T: bit-level split continuity plus the
+    // audited constant set, without a long-double oracle over the full geometry.
+    CHECK(kGlm53KdaProfile.heads == 64 && kGlm53KdaProfile.head_dim == 128);
+    CHECK(kGlm53KdaProfile.d_conv == 4 && kGlm53KdaProfile.gate_lower_bound == -5.0f);
+    const KdaProfile profile = kGlm53KdaProfile;
+    const size_t d_inner = size_t(profile.heads) * profile.head_dim;
+    const size_t tokens = 4;
+    std::vector<float> q(tokens * d_inner), k(tokens * d_inner), v(tokens * d_inner),
+        gate(tokens * d_inner), beta(tokens * profile.heads), state(kda_state_values(profile)),
+        out(tokens * d_inner), scratch(kda_scan_scratch_values(profile, tokens));
+    for (size_t i = 0; i < tokens * d_inner; ++i) {
+        q[i] = source(static_cast<uint32_t>(i));
+        k[i] = source(static_cast<uint32_t>(i) + 1);
+        v[i] = source(static_cast<uint32_t>(i) + 2);
+        gate[i] = source(static_cast<uint32_t>(i) + 3) / 4;
+    }
+    for (size_t i = 0; i < beta.size(); ++i) beta[i] = 0.5f;
+    kda_gated_delta_reference(q, k, v, gate, beta, state, out, scratch, profile);
+    std::vector<float> split_state(kda_state_values(profile)),
+        split_out, token_scratch(kda_scan_scratch_values(profile, 1));
+    for (size_t t = 0; t < tokens; ++t) {
+        std::vector<float> token_out(d_inner);
+        kda_gated_delta_reference(std::span(q).subspan(t * d_inner, d_inner),
+                                  std::span(k).subspan(t * d_inner, d_inner),
+                                  std::span(v).subspan(t * d_inner, d_inner),
+                                  std::span(gate).subspan(t * d_inner, d_inner),
+                                  std::span(beta).subspan(t * profile.heads, profile.heads),
+                                  split_state, token_out, token_scratch, profile);
+        split_out.insert(split_out.end(), token_out.begin(), token_out.end());
+    }
+    CHECK(out == split_out);
+    CHECK(state == split_state);
+}
+
+// ---------------------------------------------------------------------------
+template<class F> void rejects(F action) {
+    try { action(); } catch (const std::invalid_argument&) { return; }
+    throw std::runtime_error("invalid KDA reference input accepted");
+}
+
+void invalid_inputs() {
+    const KdaProfile profile{2, 3, 4, -5.0f};
+    const size_t d_inner = profile.heads * profile.head_dim;
+    std::vector<float> plane(d_inner), weights(d_inner * profile.d_conv),
+        conv_state((profile.d_conv - 1) * d_inner), out(d_inner);
+    rejects([&] { (void)kda_conv_reference(std::span(plane).first(d_inner - 1), weights, conv_state, out, profile); });
+    rejects([&] { (void)kda_conv_reference(plane, std::span(weights).first(weights.size() - 1), conv_state, out, profile); });
+    rejects([&] { (void)kda_conv_reference(plane, weights, std::span(conv_state).first(conv_state.size() - 1), out, profile); });
+    const auto bad = std::numeric_limits<float>::quiet_NaN();
+    std::vector<float> poisoned = plane; poisoned[0] = bad;
+    rejects([&] { (void)kda_conv_reference(poisoned, weights, conv_state, out, profile); });
+
+    std::vector<float> g(d_inner), a_log(profile.heads), gate_out(d_inner);
+    rejects([&] { (void)kda_decay_gate_reference(g, std::span(a_log).first(1), gate_out, profile); });
+    std::vector<float> poisoned_log = a_log; poisoned_log[0] = std::numeric_limits<float>::infinity();
+    rejects([&] { (void)kda_decay_gate_reference(g, poisoned_log, gate_out, profile); });
+
+    std::vector<float> state(kda_state_values(profile)), beta(profile.heads),
+        scratch(kda_scan_scratch_values(profile, 1));
+    rejects([&] { (void)kda_gated_delta_reference(std::span(plane).first(d_inner - 1), plane, plane, plane,
+                                                  beta, state, out, scratch, profile); });
+    rejects([&] { (void)kda_gated_delta_reference(plane, plane, plane, plane, std::span(beta).first(1),
+                                                  state, out, scratch, profile); });
+    rejects([&] { (void)kda_gated_delta_reference(plane, plane, plane, plane, beta,
+                                                  std::span(state).first(state.size() - 1), out, scratch, profile); });
+    rejects([&] { (void)kda_gated_delta_reference(plane, plane, plane, plane, beta, state, out,
+                                                  std::span(scratch).first(scratch.size() - 1), profile); });
+    std::vector<float> poisoned_gate = plane; poisoned_gate[1] = bad;
+    rejects([&] { (void)kda_gated_delta_reference(plane, plane, plane, poisoned_gate, beta, state, out,
+                                                  scratch, profile); });
+
+    std::vector<float> norm_w(profile.head_dim);
+    rejects([&] { (void)kda_out_gate_reference(plane, std::span(plane).first(d_inner - 1), norm_w, out, profile); });
+    rejects([&] { (void)kda_out_gate_reference(plane, plane, std::span(norm_w).first(1), out, profile); });
+    std::vector<float> poisoned_o = plane; poisoned_o[2] = bad;
+    rejects([&] { (void)kda_out_gate_reference(poisoned_o, plane, norm_w, out, profile); });
+}
+
+}  // namespace
+
+int main() {
+    try {
+        conv_oracle_and_continuity();
+        gate_matches_kernel_formula();
+        scan_oracle_split_and_state_contract();
+        scan_failure_keeps_planes();
+        out_gate_oracle_and_alias();
+        glm53_dimensions_smoke();
+        invalid_inputs();
+        std::puts("GLM KDA conv/gate/delta/out-gate references match independent oracles");
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "%s\n", e.what()); return 1;
+    }
+}
diff --git a/tests/models/glm5/mhc_reference_test.cpp b/tests/models/glm5/mhc_reference_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b4d2d34201dbcf2d4b5f51ae7d56e8cde5523aa8
--- /dev/null
+++ b/tests/models/glm5/mhc_reference_test.cpp
@@ -0,0 +1,282 @@
+#include "models/glm5/reference/mhc_reference.h"
+
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+#define CHECK(expression) do { if (!(expression)) throw std::runtime_error("check failed: " #expression); } while (false)
+using namespace ninfer::models::glm5::reference;
+
+namespace {
+
+float source(uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 17u) - 8) / 8.0f;
+}
+
+template<class F> void rejects(F action) {
+    try { action(); } catch (const std::invalid_argument&) { return; }
+    throw std::runtime_error("invalid mHC input accepted");
+}
+
+struct Fixture {
+    MhcProfile profile = kGlm53MhcProfile;
+    uint32_t hidden = 12;
+    size_t tokens = 3, hc, stream_values, mix_values;
+    std::vector<float> streams, fn, base, scale;
+    explicit Fixture(uint32_t h = 12, size_t t = 3) : hidden(h), tokens(t) {
+        hc = profile.hc;
+        stream_values = hc * hidden;
+        mix_values = (2 + hc) * hc;
+        streams.resize(tokens * stream_values);
+        fn.resize(mix_values * stream_values);
+        base.resize(mix_values);
+        scale = {0.7f, 0.5f, 0.9f};
+        for (size_t i = 0; i < streams.size(); ++i) streams[i] = source(static_cast<uint32_t>(i) + 5) / 4;
+        for (size_t i = 0; i < fn.size(); ++i) fn[i] = source(static_cast<uint32_t>(i) * 3 + 1) / 16;
+        for (size_t i = 0; i < base.size(); ++i) base[i] = source(static_cast<uint32_t>(i) * 5 + 3) / 8;
+    }
+};
+
+// Independent long-double oracle, re-derived from the transformers module:
+// unweighted RMS norm over the flattened streams, sigmoid/2x-sigmoid gates,
+// softmax over dst per src row from the flat comb[dst + hc*src] layout, the
+// pinned Sinkhorn order, and the layer update. Written in a different
+// association order than the C++ loops.
+struct Oracle {
+    const Fixture& f;
+    long double sigmoid(long double x) const { return 1.0L / (1.0L + std::exp(-x)); }
+
+    void weights(size_t t, std::vector<long double>& pre, std::vector<long double>& post,
+                 std::vector<long double>& comb) const {
+        const size_t hc = f.hc, sv = f.stream_values;
+        long double square_sum = 0;
+        for (size_t i = 0; i < sv; ++i) {
+            const long double v = f.streams[t * sv + i];
+            square_sum += v * v;
+        }
+        const long double inv = 1.0L / std::sqrt(square_sum / static_cast<long double>(sv) + f.profile.rms_eps);
+        std::vector<long double> mixes(f.mix_values);
+        for (size_t m = 0; m < f.mix_values; ++m)
+            for (size_t i = 0; i < sv; ++i)
+                mixes[m] += static_cast<long double>(f.fn[m * sv + i]) * f.streams[t * sv + i];
+        for (auto& m : mixes) m *= inv;
+
+        pre.resize(hc); post.resize(hc); comb.assign(hc * hc, 0);
+        for (size_t n = 0; n < hc; ++n) {
+            pre[n] = sigmoid(mixes[n] * f.scale[0] + f.base[n]) + f.profile.hc_eps;
+            post[n] = 2.0L * sigmoid(mixes[hc + n] * f.scale[1] + f.base[hc + n]);
+        }
+        for (size_t src = 0; src < hc; ++src) {
+            long double denominator = 0;
+            std::vector<long double> exps(hc);
+            for (size_t dst = 0; dst < hc; ++dst) {
+                const size_t flat = 2 * hc + dst + hc * src;
+                exps[dst] = std::exp((mixes[flat] * f.scale[2] + f.base[flat]) -
+                                     (mixes[2 * hc + 0 + hc * src] * f.scale[2] + f.base[2 * hc + 0 + hc * src]));
+                denominator += exps[dst];
+            }
+            for (size_t dst = 0; dst < hc; ++dst)
+                comb[src * hc + dst] = exps[dst] / denominator + f.profile.hc_eps;
+        }
+        auto col = [&]() {
+            for (size_t dst = 0; dst < hc; ++dst) {
+                long double sum = 0;
+                for (size_t src = 0; src < hc; ++src) sum += comb[src * hc + dst];
+                const long double inv_sum = 1.0L / (sum + f.profile.hc_eps);
+                for (size_t src = 0; src < hc; ++src) comb[src * hc + dst] *= inv_sum;
+            }
+        };
+        auto row = [&]() {
+            for (size_t src = 0; src < hc; ++src) {
+                long double sum = 0;
+                for (size_t dst = 0; dst < hc; ++dst) sum += comb[src * hc + dst];
+                const long double inv_sum = 1.0L / (sum + f.profile.hc_eps);
+                for (size_t dst = 0; dst < hc; ++dst) comb[src * hc + dst] *= inv_sum;
+            }
+        };
+        col();
+        for (uint32_t r = 1; r < f.profile.sinkhorn_iters; ++r) { row(); col(); }
+    }
+};
+
+void compare(float got, long double want, long double tolerance, const char* what) {
+    const long double error = std::abs(static_cast<long double>(got) - want);
+    if (!(error <= tolerance * std::max<long double>(1, std::abs(want))))
+        std::fprintf(stderr, "%s: got %.9g want %.9Le\n", what, got, want);
+    CHECK(error <= tolerance * std::max<long double>(1, std::abs(want)));
+}
+
+void pre_matches_oracle_and_invariants() {
+    const Fixture f;
+    const Oracle oracle{f};
+    const size_t hc = f.hc;
+    std::vector<float> pre(f.tokens * hc), post(f.tokens * hc), comb(f.tokens * hc * hc),
+        collapsed(f.tokens * f.hidden);
+    mhc_pre_reference(f.streams, f.fn, f.base, f.scale, pre, post, comb, collapsed, f.profile, f.hidden);
+
+    for (size_t t = 0; t < f.tokens; ++t) {
+        std::vector<long double> pre_o, post_o, comb_o;
+        oracle.weights(t, pre_o, post_o, comb_o);
+        long double pre_sum = 0;
+        for (size_t n = 0; n < hc; ++n) {
+            compare(pre[t * hc + n], pre_o[n], 2e-6L, "pre");
+            compare(post[t * hc + n], post_o[n], 2e-6L, "post");
+            pre_sum += pre_o[n];
+        }
+        CHECK(pre_sum < static_cast<long double>(hc) * 2 + 1);  // sigmoid+eps, NOT softmax
+        CHECK(pre_sum > 1e-6L);
+        for (size_t i = 0; i < hc * hc; ++i) compare(comb[t * hc * hc + i], comb_o[i], 2e-6L, "comb");
+        // Sinkhorn target: columns (fixed dst over src) sum to 1 up to the eps slack.
+        for (size_t dst = 0; dst < hc; ++dst) {
+            float column = 0, row = 0;
+            for (size_t src = 0; src < hc; ++src) column += comb[t * hc * hc + src * hc + dst];
+            for (size_t d = 0; d < hc; ++d) row += comb[t * hc * hc + dst * hc + d];
+            CHECK(std::abs(column - 1.0f) < 1e-4f);
+            CHECK(std::abs(row - 1.0f) < 2e-3f);  // rows only approximately (eps + last-op asymmetry)
+        }
+        for (size_t d = 0; d < f.hidden; ++d) {
+            long double acc = 0;
+            for (size_t n = 0; n < hc; ++n)
+                acc += pre_o[n] * f.streams[t * f.stream_values + n * f.hidden + d];
+            compare(collapsed[t * f.hidden + d], acc, 2e-5L, "collapsed");
+        }
+    }
+}
+
+// The flat comb layout comb[dst + hc*src] is the easiest thing to transpose
+// silently; a probe with one large src-specific logit pins it: that src row's
+// softmax concentrates on the dst with the large base.
+void comb_flat_layout_probe() {
+    Fixture f(8, 1);
+    // Make base[2hc + dst + hc*src] strongly favor (src=2, dst=1).
+    for (size_t i = 0; i < f.base.size(); ++i) f.base[i] = -4;
+    const size_t hot = 2 * f.hc + 1 + f.hc * 2;
+    f.base[hot] = +8;
+    std::vector<float> pre(f.hc), post(f.hc), comb(f.hc * f.hc), collapsed(f.hidden);
+    mhc_pre_reference(f.streams, f.fn, f.base, f.scale, pre, post, comb, collapsed, f.profile, f.hidden);
+    // Before Sinkhorn the src=2 row is ~one-hot on dst=1; Sinkhorn's first
+    // move is a column normalization, so that row stays the row closest to a
+    // one-hot on dst=1 across all src rows.
+    size_t argmax = 0;
+    float entropy_best = 1e30f;
+    for (size_t src = 0; src < f.hc; ++src) {
+        float entropy = 0;
+        for (size_t dst = 0; dst < f.hc; ++dst) entropy -= comb[src * f.hc + dst] * std::log(comb[src * f.hc + dst]);
+        if (entropy < entropy_best) { entropy_best = entropy; argmax = src; }
+    }
+    CHECK(argmax == 2);
+    CHECK(comb[2 * f.hc + 1] > 0.9f);
+}
+
+void post_and_head_and_layer_chain() {
+    const Fixture f;
+    const Oracle oracle{f};
+    const size_t hc = f.hc;
+    std::vector<float> pre(f.tokens * hc), post(f.tokens * hc), comb(f.tokens * hc * hc),
+        collapsed(f.tokens * f.hidden);
+    mhc_pre_reference(f.streams, f.fn, f.base, f.scale, pre, post, comb, collapsed, f.profile, f.hidden);
+
+    // A deterministic stand-in block output.
+    std::vector<float> block(f.tokens * f.hidden);
+    for (size_t i = 0; i < block.size(); ++i) block[i] = source(static_cast<uint32_t>(i) * 7 + 2) / 3;
+
+    std::vector<float> out(f.tokens * f.stream_values, -1e30f);
+    mhc_post_reference(block, f.streams, post, comb, out, f.profile, f.hidden);
+    for (size_t t = 0; t < f.tokens; ++t) {
+        std::vector<long double> pre_o, post_o, comb_o;
+        oracle.weights(t, pre_o, post_o, comb_o);
+        for (size_t dst = 0; dst < hc; ++dst)
+            for (size_t d = 0; d < f.hidden; ++d) {
+                long double mix = 0;
+                for (size_t src = 0; src < hc; ++src)
+                    mix += comb_o[src * hc + dst] * f.streams[t * f.stream_values + src * f.hidden + d];
+                const long double expected = post_o[dst] * block[t * f.hidden + d] + mix;
+                compare(out[t * f.stream_values + dst * f.hidden + d], expected, 2e-5L, "post");
+            }
+    }
+
+    // Head: unweighted mean; in-place alias (output = prefix view of the same
+    // buffer) must work because each element's reads precede its write.
+    std::vector<float> streams_copy = f.streams;
+    mhc_head_reference(streams_copy, std::span(streams_copy).first(f.tokens * f.hidden),
+                       f.profile, f.hidden);
+    for (size_t t = 0; t < f.tokens; ++t)
+        for (size_t d = 0; d < f.hidden; ++d) {
+            const float expected = (f.streams[t * f.stream_values + 0 * f.hidden + d] +
+                                    f.streams[t * f.stream_values + 1 * f.hidden + d] +
+                                    f.streams[t * f.stream_values + 2 * f.hidden + d] +
+                                    f.streams[t * f.stream_values + 3 * f.hidden + d]) / 4.0f;
+            CHECK(streams_copy[t * f.hidden + d] == expected);
+        }
+}
+
+void sinkhorn_iteration_count_matters() {
+    // iters=1 (single column normalization) vs 20 must differ on a general
+    // input, pinning that the reference actually iterates.
+    Fixture f(8, 1);
+    std::vector<float> pre1(f.hc), post1(f.hc), comb1(f.hc * f.hc), col1(f.hidden);
+    MhcProfile one = f.profile; one.sinkhorn_iters = 1;
+    mhc_pre_reference(f.streams, f.fn, f.base, f.scale, pre1, post1, comb1, col1, one, f.hidden);
+    std::vector<float> pre20(f.hc), post20(f.hc), comb20(f.hc * f.hc), col20(f.hidden);
+    mhc_pre_reference(f.streams, f.fn, f.base, f.scale, pre20, post20, comb20, col20, f.profile, f.hidden);
+    CHECK(pre1 == pre20 && post1 == post20);   // gates do not depend on iterations
+    bool comb_differs = false;
+    for (size_t i = 0; i < f.hc * f.hc; ++i) comb_differs = comb_differs || comb1[i] != comb20[i];
+    CHECK(comb_differs);
+    float column_error = 0;
+    for (size_t dst = 0; dst < f.hc; ++dst) {
+        float sum = 0;
+        for (size_t src = 0; src < f.hc; ++src) sum += comb1[src * f.hc + dst];
+        column_error = std::max(column_error, std::abs(sum - 1.0f));
+    }
+    CHECK(column_error < 1e-4f);  // iters=1 already fixes columns exactly once
+}
+
+void glm53_smoke_and_invalid() {
+    // Real mix width: fn is 24x16384; geometry constants checked separately.
+    CHECK(mhc_mix_values(kGlm53MhcProfile) == 24);
+    CHECK(mhc_stream_values(kGlm53MhcProfile, 4096) == 16384);
+    CHECK(kGlm53MhcProfile.sinkhorn_iters == 20 && kGlm53MhcProfile.hc_eps == 1e-6f);
+    CHECK(kGlm53MhcProfile.rms_eps == 1e-5f);
+
+    const Fixture g;
+    std::vector<float> pre(g.hc), post(g.hc), comb(g.hc * g.hc), col(g.hidden);
+    rejects([&] { (void)mhc_pre_reference(std::span(g.streams).first(g.streams.size() - 1), g.fn,
+                                          g.base, g.scale, pre, post, comb, col, g.profile, g.hidden); });
+    rejects([&] { (void)mhc_pre_reference(g.streams, std::span(g.fn).first(g.fn.size() - 1),
+                                          g.base, g.scale, pre, post, comb, col, g.profile, g.hidden); });
+    rejects([&] { (void)mhc_pre_reference(g.streams, g.fn, g.base, std::span(g.scale).first(2),
+                                          pre, post, comb, col, g.profile, g.hidden); });
+    rejects([&] { (void)mhc_pre_reference(g.streams, g.fn, g.base, g.scale, std::span(pre).first(3),
+                                          post, comb, col, g.profile, g.hidden); });
+    MhcProfile broken = g.profile; broken.hc = 5;
+    rejects([&] { (void)mhc_pre_reference(g.streams, g.fn, g.base, g.scale, pre, post, comb, col,
+                                          broken, g.hidden); });
+    auto poisoned = g.streams;
+    poisoned[3] = std::numeric_limits<float>::quiet_NaN();
+    rejects([&] { (void)mhc_pre_reference(poisoned, g.fn, g.base, g.scale, pre, post, comb, col,
+                                          g.profile, g.hidden); });
+    std::vector<float> block(g.hidden), out(g.stream_values);
+    rejects([&] { (void)mhc_post_reference(std::span(block).first(g.hidden - 1), g.streams,
+                                           post, comb, out, g.profile, g.hidden); });
+    rejects([&] { (void)mhc_head_reference(g.streams, std::span(out).first(4), g.profile, g.hidden); });
+}
+
+}  // namespace
+
+int main() {
+    try {
+        pre_matches_oracle_and_invariants();
+        comb_flat_layout_probe();
+        post_and_head_and_layer_chain();
+        sinkhorn_iteration_count_matters();
+        glm53_smoke_and_invalid();
+        std::puts("GLM mHC pre/post/head references match independent oracles");
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "%s\n", e.what()); return 1;
+    }
+}
diff --git a/tests/models/glm5/test_config.cpp b/tests/models/glm5/test_config.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0eff353ca47f749dcdf0b498430d8173cf26b8a9
--- /dev/null
+++ b/tests/models/glm5/test_config.cpp
@@ -0,0 +1,141 @@
+// parse_text_config on the GLM-5.3-Flash text config (tests/fixtures/glm5/
+// text_config.json, generated from the audited glm53-config evidence of
+// 2026-10-23) and its refusals: the audited geometry passes unchanged, and
+// every shape this engine does not implement is rejected by name.
+#include "models/glm5/config.h"
+
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace ninfer::models::glm5;
+using ninfer::artifact::Json;
+
+namespace {
+
+void require(bool condition, const std::string& message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+Json fixture() {
+    std::ifstream file(std::string(NINFER_SOURCE_DIR) + "/tests/fixtures/glm5/text_config.json");
+    require(file.good(), "fixture missing");
+    return Json::parse(file);
+}
+
+void expect_refusal(const std::function<void(Json&)>& edit, const std::string& label) {
+    Json config = fixture();
+    edit(config);
+    bool refused = false;
+    try {
+        (void)parse_text_config(config);
+    } catch (const ninfer::artifact::ArtifactError&) { refused = true; }
+    require(refused, "not refused: " + label);
+}
+
+void audited_geometry() {
+    const TextConfig config = parse_text_config(fixture());
+    require(config.num_hidden_layers == 45 && config.layer_types.size() == 45, "45 blocks");
+    std::size_t kda = 0, dsa = 0;
+    for (std::size_t i = 0; i < config.layer_types.size(); ++i) {
+        const bool sparse = config.layer_types[i] == MixerKind::Dsa;
+        require(sparse == (i % 4 == 3), "DSA every fourth block");
+        kda += !sparse;
+        dsa += sparse;
+    }
+    require(kda == 34 && dsa == 11, "34 KDA + 11 DSA");
+    require(config.hidden_size == 4096 && config.vocab_size == 154880, "hidden/vocab");
+    require(config.max_position_embeddings == 1048576, "1M positions");
+    require(!config.tie_word_embeddings && config.rms_norm_eps == 1e-5f, "norm/untied");
+    require(config.eos_token_ids.size() == 3 && config.eos_token_ids[0] == 154820, "eos list");
+
+    require(config.first_k_dense_replace == 3, "3 leading dense blocks");
+    require(config.mlp_is_sparse(0) == false && config.mlp_is_sparse(2) == false, "dense lead");
+    require(config.mlp_is_sparse(3) && config.mlp_is_sparse(44), "sparse rest");
+    require(config.intermediate_size == 12288 && config.swiglu_limit == 10.0f, "dense FFN");
+
+    require(config.linear_num_heads == 64 && config.linear_head_dim == 128, "KDA heads");
+    require(config.linear_conv_kernel == 4, "4-tap conv");
+    require(config.linear_gate_lower_bound == -5.0f, "gate lower bound");
+    require(config.linear_inner_width() == 8192, "KDA inner width");
+
+    require(config.num_attention_heads == 64 && config.num_key_value_heads == 64, "MLA heads");
+    require(config.qk_nope_head_dim == 256 && config.qk_rope_head_dim == 0, "NoPE only");
+    require(config.v_head_dim == 256 && config.q_lora_rank == 1536 && config.kv_lora_rank == 512,
+            "MLA latents");
+    require(!config.attention_bias, "no attention bias");
+
+    require(config.index_n_heads == 32 && config.index_head_dim == 128, "indexer heads");
+    require(config.index_kpool == 4 && config.index_top_k == 2048, "kpool/topk");
+    require(config.index_top_pools() == 512 && config.index_selection_width() == 2051,
+            "selection shape");
+    require(config.index_select_tail, "tail always selected");
+
+    require(config.hc_mult == 4 && config.hc_sinkhorn_iters == 20 && config.hc_eps == 1e-6f,
+            "mHC");
+    require(config.num_experts == 288 && config.num_experts_per_tok == 8, "experts");
+    require(config.moe_intermediate_size == 2048 && config.num_shared_experts == 1, "MoE FFN");
+    require(config.routed_scaling_factor == 2.5f && config.norm_topk_prob, "router");
+    require(config.num_nextn_predict_layers == 1, "one MTP layer recorded");
+}
+
+void refusals() {
+    expect_refusal([](Json& c) { c["model_type"] = "glm5_text"; }, "model type");
+    expect_refusal([](Json& c) { c["architectures"] = Json::array({"Glm5ForCausalLM"}); },
+                   "architecture");
+    expect_refusal([](Json& c) { c["layer_types"] = Json::array({"linear_attention"}); },
+                   "layer count mismatch");
+    expect_refusal([](Json& c) { c["layer_types"][3] = "full_attention"; }, "unknown layer type");
+    expect_refusal([](Json& c) { c["qk_rope_head_dim"] = 64; }, "rope component");
+    expect_refusal([](Json& c) { c["mla_use_nope"] = false; }, "mla nope off");
+    expect_refusal([](Json& c) { c["attention_bias"] = true; }, "attention bias");
+    expect_refusal([](Json& c) { c["num_attention_heads"] = 32; }, "GQA heads");
+    expect_refusal([](Json& c) { c["index_kpool"] = 8; }, "kpool");
+    expect_refusal([](Json& c) { c["index_top_k"] = 2050; }, "topk not whole pools");
+    expect_refusal([](Json& c) { c["index_kpool_always_select_tail"] = false; }, "tail off");
+    expect_refusal([](Json& c) { c["index_kpool_compress"] = false; }, "compress off");
+    expect_refusal([](Json& c) { c["mhc"] = false; }, "mhc off");
+    expect_refusal([](Json& c) { c["hc_mult"] = 6; }, "hc mult");
+    expect_refusal([](Json& c) { c["scoring_func"] = "softmax"; }, "router scoring");
+    expect_refusal([](Json& c) { c["topk_method"] = "greedy"; }, "topk method");
+    expect_refusal([](Json& c) { c["n_group"] = 8; }, "expert groups");
+    expect_refusal([](Json& c) { c["norm_topk_prob"] = false; }, "unnormalized weights");
+    expect_refusal([](Json& c) { c["moe_router_dtype"] = "bfloat16"; }, "router dtype");
+    expect_refusal([](Json& c) { c["attention_dropout"] = 0.1; }, "dropout");
+    expect_refusal([](Json& c) { c["linear_attn_config"]["gate_lower_bound"] = 5.0; },
+                   "positive gate bound");
+    expect_refusal([](Json& c) { c["linear_attn_config"]["short_conv_kernel_size"] = 3; },
+                   "conv width");
+    expect_refusal([](Json& c) { c["eos_token_id"] = 999999999; }, "eos beyond vocab");
+    expect_refusal([](Json& c) { c["num_experts_per_tok"] = 289; }, "topk beyond experts");
+    expect_refusal([](Json& c) { c["routed_scaling_factor"] = -1.0; }, "negative scaling");
+    expect_refusal([](Json& c) { c["first_k_dense_replace"] = 46; }, "dense lead beyond blocks");
+    expect_refusal([](Json& c) { c["swiglu_limit"] = 0.0; }, "zero swiglu limit");
+    // A missing required member refuses before any default can apply.
+    expect_refusal([](Json& c) { c.erase("kv_lora_rank"); }, "missing kv_lora_rank");
+}
+
+void eos_single_value_form() {
+    Json config = fixture();
+    config["eos_token_id"] = 154820;
+    const auto parsed = parse_text_config(config);
+    require(parsed.eos_token_ids.size() == 1 && parsed.eos_token_ids[0] == 154820,
+            "single eos accepted");
+}
+
+} // namespace
+
+int main() {
+    try {
+        audited_geometry();
+        refusals();
+        eos_single_value_form();
+        std::puts("GLM5 text config parses the audited GLM-5.3-Flash geometry strictly");
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/models/glm5/test_kda_block.cpp b/tests/models/glm5/test_kda_block.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4c0ef269c5a09161b08d3e0e3622ce76f251cb17
--- /dev/null
+++ b/tests/models/glm5/test_kda_block.cpp
@@ -0,0 +1,342 @@
+// The GLM-5.3-Flash KDA block decode assembly against the host reference: the projections
+// run as FP64 GEMV oracles, the mixer pieces call models/glm5/reference, and the whole
+// chain is compared on the device at the audited 64x128 geometry and a small probe.
+#include "models/glm5/execution/block.h"
+#include "models/glm5/reference/kda_reference.h"
+
+#include "core/device.h"
+#include "ninfer/ops/linear.h"
+#include "ninfer/ops/rmsnorm.h"
+#include "ops/op_tester.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <exception>
+#include <string>
+#include <algorithm>
+#include <vector>
+
+namespace {
+
+using namespace ninfer;
+namespace execution = ninfer::models::glm5::execution;
+using execution::KdaBlockWeights;
+namespace Reference = ninfer::models::glm5::reference;
+
+float source(std::uint32_t i) {
+    return static_cast<float>(static_cast<int>(i % 17u) - 8) / 8.0f;
+}
+
+std::vector<__nv_bfloat16> round_trip(const std::vector<float>& values) {
+    std::vector<__nv_bfloat16> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __float2bfloat16(values[i]); }
+    return out;
+}
+std::vector<float> represented(const std::vector<__nv_bfloat16>& values) {
+    std::vector<float> out(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) { out[i] = __bfloat162float(values[i]); }
+    return out;
+}
+
+test::GuardedDeviceBuffer upload(const void* data, std::size_t bytes) {
+    test::GuardedDeviceBuffer buffer(bytes);
+    buffer.copy_from_host(data, bytes);
+    return buffer;
+}
+template <typename T> test::GuardedDeviceBuffer upload(const std::vector<T>& values) {
+    return upload(values.data(), values.size() * sizeof(T));
+}
+template <typename T> std::vector<T> download(const test::GuardedDeviceBuffer& buffer) {
+    std::vector<T> out(buffer.bytes() / sizeof(T));
+    buffer.copy_to_host(out.data(), out.size() * sizeof(T));
+    return out;
+}
+
+// Host GEMV oracle: y = W @ x with W row-major [rows, cols] in long double.
+std::vector<double> gemv(const std::vector<float>& w, std::uint32_t rows, std::uint32_t cols,
+                         const std::vector<float>& x) {
+    std::vector<double> y(rows, 0.0);
+    for (std::uint32_t r = 0; r < rows; ++r) {
+        for (std::uint32_t c = 0; c < cols; ++c) { y[r] += w[r * cols + c] * x[c]; }
+    }
+    return y;
+}
+
+int failures = 0;
+
+void run_case(std::uint32_t hidden, std::uint32_t heads, std::uint32_t head_dim) {
+    const std::uint32_t d_inner = heads * head_dim;
+    const Reference::KdaProfile profile{heads, head_dim, 4, -5.0f};
+    const std::string label = "h" + std::to_string(hidden) + "/d" + std::to_string(d_inner);
+
+    // Weights: every plane deterministic, scaled small enough that chains stay finite.
+    auto plane = [&](std::uint32_t rows, std::uint32_t cols, std::uint32_t seed) {
+        std::vector<float> raw(rows * cols);
+        for (std::size_t i = 0; i < raw.size(); ++i) {
+            raw[i] = source(static_cast<std::uint32_t>(i) * 3 + seed) / 16.0f;
+        }
+        return represented(round_trip(raw));
+    };
+    std::vector<float> norm_w(hidden), wq(plane(d_inner, hidden, 1)), wk(plane(d_inner, hidden, 2)),
+        wv(plane(d_inner, hidden, 3)), conv_q(plane(4 * d_inner, 1, 4)),
+        conv_k(plane(4 * d_inner, 1, 5)), conv_v(plane(4 * d_inner, 1, 6)),
+        f_a(plane(head_dim, hidden, 7)), f_b(plane(d_inner, head_dim, 8)),
+        beta_w(plane(heads, hidden, 9)), g_a(plane(head_dim, hidden, 10)),
+        g_b(plane(d_inner, head_dim, 11)), wo(plane(hidden, d_inner, 12));
+    for (std::uint32_t i = 0; i < hidden; ++i) { norm_w[i] = 1.0f + source(i) / 8; }
+    for (auto& value : conv_q) { value /= 4.0f; }
+    for (auto& value : conv_k) { value /= 4.0f; }
+    for (auto& value : conv_v) { value /= 4.0f; }
+    std::vector<float> dt_bias(d_inner), a_log(heads), o_norm_w(head_dim),
+        conv_state0((4 - 1) * d_inner), matrix_state0(Reference::kda_state_values(profile));
+    for (std::uint32_t i = 0; i < d_inner; ++i) { dt_bias[i] = source(i * 3 + 1) / 8; }
+    for (std::uint32_t h = 0; h < heads; ++h) { a_log[h] = -0.5f + 0.25f * h; }
+    for (std::uint32_t i = 0; i < head_dim; ++i) { o_norm_w[i] = 1.0f + source(i) / 8; }
+    for (std::size_t i = 0; i < conv_state0.size(); ++i) { conv_state0[i] = source(static_cast<std::uint32_t>(i) + 5) / 3; }
+    for (std::size_t i = 0; i < matrix_state0.size(); ++i) { matrix_state0[i] = source(static_cast<std::uint32_t>(i)) / 5; }
+    std::vector<float> hidden_in = represented(round_trip([&] {
+        std::vector<float> values(hidden);
+        for (std::uint32_t i = 0; i < hidden; ++i) { values[i] = source(i * 5 + 2) / 4; }
+        return values;
+    }()));
+
+    // ---- host oracle chain ----
+    std::vector<float> x(hidden);
+    {
+        double square = 0;
+        for (std::uint32_t i = 0; i < hidden; ++i) { square += hidden_in[i] * hidden_in[i]; }
+        const double inverse = 1.0 / std::sqrt(square / hidden + 1e-5);
+        for (std::uint32_t i = 0; i < hidden; ++i) { x[i] = static_cast<float>(norm_w[i] * hidden_in[i] * inverse); }
+    }
+    // The device rounds every projection output to BF16 before the next stage reads it;
+    // the oracle must round at the same boundaries or its gate (log space!) errors get
+    // exponentiated into ~7% state differences that are representation, not wiring.
+    auto projected = [&](const std::vector<float>& w, std::uint32_t rows, std::uint32_t cols,
+                         const std::vector<float>& input) {
+        std::vector<float> y(rows);
+        const auto acc = gemv(w, rows, cols, input);
+        for (std::uint32_t r = 0; r < rows; ++r) { y[r] = static_cast<float>(acc[r]); }
+        return represented(round_trip(y));
+    };
+    const std::vector<float> x_bf = represented(round_trip(x));
+    std::vector<float> q_raw = projected(wq, d_inner, hidden, x_bf),
+                       k_raw = projected(wk, d_inner, hidden, x_bf),
+                       v_raw = projected(wv, d_inner, hidden, x_bf),
+                       fa = projected(f_a, head_dim, hidden, x_bf),
+                       beta_raw = projected(beta_w, heads, hidden, x_bf),
+                       ga = projected(g_a, head_dim, hidden, x_bf);
+    std::vector<float> fb(d_inner);
+    {
+        const auto acc = gemv(f_b, d_inner, head_dim, fa);
+        std::vector<float> raw(d_inner);
+        for (std::uint32_t i = 0; i < d_inner; ++i) {
+            raw[i] = static_cast<float>(acc[i]) + represented(round_trip(dt_bias))[i];
+        }
+        fb = represented(round_trip(raw));
+    }
+    std::vector<float> g2(d_inner);
+    {
+        const auto acc = gemv(g_b, d_inner, head_dim, ga);
+        std::vector<float> raw(d_inner);
+        for (std::uint32_t i = 0; i < d_inner; ++i) { raw[i] = static_cast<float>(acc[i]); }
+        g2 = represented(round_trip(raw));
+    }
+    // convs (weights arrive row-major rows-major [d_inner,4]; the GGUF layout is
+    // w[c*4 + tap], identical to rows=d_inner cols=4 row-major).
+    std::vector<float> qc(d_inner), kc(d_inner), vc(d_inner);
+    auto conv1 = [&](const std::vector<float>& raw, const std::vector<float>& cw,
+                     std::vector<float>& out) {
+        for (std::uint32_t c = 0; c < d_inner; ++c) {
+            double acc = cw[c * 4 + 0] * conv_state0[0 * d_inner + c] +
+                         cw[c * 4 + 1] * conv_state0[1 * d_inner + c] +
+                         cw[c * 4 + 2] * conv_state0[2 * d_inner + c] + cw[c * 4 + 3] * raw[c];
+            const double silu = acc / (1.0 + std::exp(-acc));
+            out[c] = static_cast<float>(silu);
+        }
+    };
+    conv1(q_raw, conv_q, qc); qc = represented(round_trip(qc));
+    conv1(k_raw, conv_k, kc); kc = represented(round_trip(kc));
+    conv1(v_raw, conv_v, vc); vc = represented(round_trip(vc));
+    std::vector<float> gate_log(d_inner), beta_f(heads);
+    Reference::kda_decay_gate_reference(fb, a_log, gate_log, profile);
+    for (std::uint32_t h = 0; h < heads; ++h) {
+        beta_f[h] = static_cast<float>(1.0 / (1.0 + std::exp(-static_cast<double>(beta_raw[h]))));
+    }
+    std::vector<float> scan_out(d_inner), matrix_state = matrix_state0,
+        scratch(Reference::kda_scan_scratch_values(profile, 1));
+    Reference::kda_gated_delta_reference(qc, kc, vc, gate_log, beta_f, matrix_state, scan_out,
+                                         scratch, profile);
+    std::vector<float> gated(d_inner);
+    Reference::kda_out_gate_reference(scan_out, g2, o_norm_w, gated, profile);
+    std::vector<double> want(hidden);
+    {
+        const auto acc = gemv(wo, hidden, d_inner, gated);
+        for (std::uint32_t i = 0; i < hidden; ++i) { want[i] = acc[i]; }
+    }
+
+    // ---- device run ----
+    auto d_norm = upload(round_trip(norm_w));
+    auto d_wq = upload(round_trip(wq));
+    auto d_wk = upload(round_trip(wk));
+    auto d_wv = upload(round_trip(wv));
+    auto d_cq = upload(round_trip(conv_q));
+    auto d_ck = upload(round_trip(conv_k));
+    auto d_cv = upload(round_trip(conv_v));
+    auto d_fa = upload(round_trip(f_a));
+    auto d_fb = upload(round_trip(f_b));
+    auto d_beta = upload(round_trip(beta_w));
+    auto d_ga = upload(round_trip(g_a));
+    auto d_gb = upload(round_trip(g_b));
+    auto d_wo = upload(round_trip(wo));
+    auto d_dt = upload(round_trip(dt_bias));
+    auto d_alog = upload(a_log);
+    auto d_onw = upload(o_norm_w);
+    auto d_hidden = upload(round_trip(hidden_in));
+    auto d_conv_q = upload(conv_state0);
+    auto d_conv_k = upload(conv_state0);
+    auto d_conv_v = upload(conv_state0);
+    auto d_matrix = upload(matrix_state0);
+    const std::size_t scratch_bytes = execution::kda_block_scratch_bytes(hidden, heads, head_dim);
+    test::GuardedDeviceBuffer d_scratch(scratch_bytes);
+    test::GuardedDeviceBuffer d_out(hidden * sizeof(__nv_bfloat16));
+    const bool debug = hidden >= 4096;
+    test::GuardedDeviceBuffer d_dbg_normed(hidden * 2), d_dbg_qc(d_inner * 2), d_dbg_kc(d_inner * 2),
+        d_dbg_vc(d_inner * 2), d_dbg_gate(static_cast<std::size_t>(d_inner) * 4),
+        d_dbg_beta(heads * 4), d_dbg_prefill(d_inner * 2),
+        d_dbg_gpre(d_inner * 2), d_dbg_blog(heads * 2);
+    execution::KdaBlockDebug dbg{};
+    if (debug) {
+        static Tensor t_dbg_normed(const_cast<void*>(d_dbg_normed.data()), DType::BF16, {static_cast<std::int32_t>(hidden), 1});
+        dbg.normed = &t_dbg_normed;
+        static Tensor t_dbg_q_conv(const_cast<void*>(d_dbg_qc.data()), DType::BF16, {1, static_cast<std::int32_t>(d_inner)});
+        dbg.q_conv = &t_dbg_q_conv;
+        static Tensor t_dbg_k_conv(const_cast<void*>(d_dbg_kc.data()), DType::BF16, {1, static_cast<std::int32_t>(d_inner)});
+        dbg.k_conv = &t_dbg_k_conv;
+        static Tensor t_dbg_v_conv(const_cast<void*>(d_dbg_vc.data()), DType::BF16, {1, static_cast<std::int32_t>(d_inner)});
+        dbg.v_conv = &t_dbg_v_conv;
+        static Tensor t_dbg_gate(const_cast<void*>(d_dbg_gate.data()), DType::FP32, {1, static_cast<std::int32_t>(d_inner)});
+        dbg.gate = &t_dbg_gate;
+        static Tensor t_dbg_beta(const_cast<void*>(d_dbg_beta.data()), DType::FP32, {1, static_cast<std::int32_t>(heads)});
+        dbg.beta = &t_dbg_beta;
+        static Tensor t_dbg_prefill_out(const_cast<void*>(d_dbg_prefill.data()), DType::BF16, {static_cast<std::int32_t>(d_inner), 1});
+        dbg.prefill_out = &t_dbg_prefill_out;
+
+        static Tensor t_dbg_gpre(const_cast<void*>(d_dbg_gpre.data()), DType::BF16, {1, static_cast<std::int32_t>(d_inner)});
+        dbg.gate_pre = &t_dbg_gpre;
+        static Tensor t_dbg_blog(const_cast<void*>(d_dbg_blog.data()), DType::BF16, {1, static_cast<std::int32_t>(heads)});
+        dbg.beta_logits = &t_dbg_blog;
+    }
+
+    KdaBlockWeights w{};
+    w.attn_norm = execution::bf16_weight(d_norm.data(), hidden, 1);
+    w.wq = execution::bf16_weight(d_wq.data(), d_inner, hidden);
+    w.wk = execution::bf16_weight(d_wk.data(), d_inner, hidden);
+    w.wv = execution::bf16_weight(d_wv.data(), d_inner, hidden);
+    w.conv_q = execution::bf16_weight(d_cq.data(), 4 * d_inner, 1);
+    w.conv_k = execution::bf16_weight(d_ck.data(), 4 * d_inner, 1);
+    w.conv_v = execution::bf16_weight(d_cv.data(), 4 * d_inner, 1);
+    w.f_a = execution::bf16_weight(d_fa.data(), head_dim, hidden);
+    w.f_b = execution::bf16_weight(d_fb.data(), d_inner, head_dim);
+    w.beta = execution::bf16_weight(d_beta.data(), heads, hidden);
+    w.g_a = execution::bf16_weight(d_ga.data(), head_dim, hidden);
+    w.g_b = execution::bf16_weight(d_gb.data(), d_inner, head_dim);
+    w.wo = execution::bf16_weight(d_wo.data(), hidden, d_inner);
+
+    {
+        Tensor hidden_t(const_cast<void*>(d_hidden.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+        Tensor dt_t(const_cast<void*>(d_dt.data()), DType::BF16, {static_cast<std::int32_t>(d_inner)});
+        Tensor alog_t(const_cast<void*>(d_alog.data()), DType::FP32, {static_cast<std::int32_t>(heads)});
+        Tensor onw_t(const_cast<void*>(d_onw.data()), DType::FP32, {static_cast<std::int32_t>(head_dim)});
+        Tensor cqs(const_cast<void*>(d_conv_q.data()), DType::FP32, {3, static_cast<std::int32_t>(d_inner)});
+        Tensor cks(const_cast<void*>(d_conv_k.data()), DType::FP32, {3, static_cast<std::int32_t>(d_inner)});
+        Tensor cvs(const_cast<void*>(d_conv_v.data()), DType::FP32, {3, static_cast<std::int32_t>(d_inner)});
+        Tensor ms(const_cast<void*>(d_matrix.data()), DType::FP32,
+                  {static_cast<std::int32_t>(head_dim), static_cast<std::int32_t>(head_dim), static_cast<std::int32_t>(heads)});
+        Tensor out_t(const_cast<void*>(d_out.data()), DType::BF16, {static_cast<std::int32_t>(hidden)});
+        execution::kda_block_decode(w, hidden_t, dt_t, alog_t, onw_t, cqs, cks, cvs, ms, -5.0f,
+                                    heads, head_dim, 1e-5f, out_t, d_scratch.data(), nullptr,
+                                    debug ? &dbg : nullptr);
+        CUDA_CHECK(cudaStreamSynchronize(nullptr));
+    }
+    if (debug) {
+        auto worst_of = [](const std::vector<float>& got, const std::vector<float>& want) {
+            double worst = 0;
+            for (std::size_t i = 0; i < want.size(); ++i) {
+                worst = std::max(worst, std::abs((double)got[i] - want[i]));
+            }
+            return worst;
+        };
+        const auto hd32 = static_cast<std::int32_t>(head_dim);
+        const auto di32 = static_cast<std::int32_t>(d_inner);
+        std::printf("[dbg:%s] normed %.4f qc %.4f kc %.4f vc %.4f gate %.4f beta %.4f gated %.4f\n",
+                    label.c_str(),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_normed)), x),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_qc)), qc),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_kc)), kc),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_vc)), vc),
+                    worst_of(download<float>(d_dbg_gate), gate_log),
+                    worst_of(download<float>(d_dbg_beta), beta_f),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_gpre)), fb),
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_blog)), beta_raw),
+
+                    worst_of(represented(download<__nv_bfloat16>(d_dbg_prefill)), gated));
+        std::printf("  first: gpre dev %.4f host %.4f | blog dev %.4f host %.4f | fb0-3 %+.3f %+.3f %+.3f %+.3f\n",
+                    represented(download<__nv_bfloat16>(d_dbg_gpre))[0], fb[0],
+                    represented(download<__nv_bfloat16>(d_dbg_blog))[0], beta_raw[0],
+                    fb[0], fb[1], fb[2], fb[3]);
+        (void)hd32; (void)di32;
+    }
+
+    // ---- device run ----
+
+    const auto got = represented(download<__nv_bfloat16>(d_out));
+    const auto state_got = download<float>(d_matrix);
+    for (std::uint32_t i = 0; i < hidden; ++i) {
+        if (std::abs(static_cast<double>(got[i]) - want[i]) > 0.06 * std::max(1.0, static_cast<double>(std::abs(want[i])))) {
+            if (failures < 10) {
+                std::fprintf(stderr, "block[%s][%u]: %.6g vs %.6g\n", label.c_str(), i, got[i],
+                             want[i]);
+            }
+            ++failures;
+        }
+    }
+    for (std::size_t i = 0; i < state_got.size(); ++i) {
+        if (std::abs(static_cast<double>(state_got[i]) - matrix_state[i]) >
+            5e-3 * std::max(1.0, static_cast<double>(std::abs(matrix_state[i])))) {
+            if (failures < 10) {
+                std::fprintf(stderr, "state[%s][%zu]: %.6g vs %.6g\n", label.c_str(), i,
+                             state_got[i], matrix_state[i]);
+            }
+            ++failures;
+        }
+    }
+}
+
+int run() {
+    run_case(64, 2, 8);           // small probe
+    run_case(4096, 64, 128);      // the audited hidden width
+    if (failures == 0) {
+        std::puts("GLM5 KDA block decode matches the chained host oracle on device");
+        return 0;
+    }
+    std::fprintf(stderr, "%d numeric failures\n", failures);
+    return 1;
+}
+
+} // namespace
+
+int main() {
+    try {
+        return run();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "FATAL: %s\n", error.what());
+        return 1;
+    } catch (...) {
+        std::fprintf(stderr, "FATAL: unknown exception\n");
+        return 1;
+    }
+}
